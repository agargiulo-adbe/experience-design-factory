---
/**
 * Chi vuole una risposta — la pagina del referente della banca con le domande
 * che hanno lasciato un'email. Spec 2026-11-20-contatto-facoltativo-design.md.
 *
 * È SEPARATA DAL RIEPILOGO di proposito: il riepilogo (e il suo PDF) sale ai
 * vertici della banca e non porta mai un indirizzo; questa la vede solo chi
 * ha il link dei contatti (`?t=<contatti_token>`, distinto da quello del
 * riepilogo). Il contenuto non è nel bundle: arriva dalla RPC `get_contatti`
 * (0042), che restituisce solo le domande con l'email, non escluse e più
 * giovani di 90 giorni. Niente PDF, niente indicizzazione.
 */
import { FUNZIONI, LIVELLI } from '../../utils/contributi';
interface Props {
  titolo: string;
  /** a chi è rivolta la pagina e che cosa ci si fa */
  sottotitolo: string;
  piede: string;
}
const { titolo, sottotitolo, piede } = Astro.props;
const URL_DB = (import.meta.env.PUBLIC_SUPABASE_URL ?? '').replace(/\/$/, '');
const CHIAVE = import.meta.env.PUBLIC_SUPABASE_ANON_KEY ?? '';
const ETICHETTE = Object.fromEntries([...FUNZIONI, ...LIVELLI].map((x) => [x.k, x.l]));
---
<main class="cp" data-cp data-url={URL_DB} data-chiave={CHIAVE} data-etichette={JSON.stringify(ETICHETTE)}>
  <header class="cp-testa">
    <p class="cp-occ">Solo per voi</p>
    <h1 class="cp-t">{titolo}</h1>
    <p class="cp-sub">{sottotitolo}</p>
  </header>
  <p class="cp-msg" data-cp-msg>Caricamento…</p>
  <p class="cp-num" data-cp-num hidden></p>
  <ol class="cp-voci" data-cp-voci></ol>
  <footer class="cp-piede"><p>{piede}</p></footer>
</main>

<script>
  type Voce = { ts: string; sezione: string; testo: string; funzione: string | null; livello: string | null; contatto: string };
  function el(tag: string, cls: string, testo?: string): HTMLElement {
    const e = document.createElement(tag);
    if (cls) e.className = cls;
    if (testo !== undefined) e.textContent = testo;
    return e;
  }
  async function carica() {
    const root = document.querySelector<HTMLElement>('[data-cp]');
    if (!root) return;
    const msg = root.querySelector<HTMLElement>('[data-cp-msg]')!;
    const token = new URLSearchParams(location.search).get('t') ?? '';
    if (!/^[0-9a-f-]{36}$/i.test(token)) { msg.textContent = 'Questa pagina si apre solo con il link personale che vi abbiamo mandato.'; return; }
    let r: { voci: Voce[] } | null = null;
    try {
      const res = await fetch(`${root.dataset.url}/rest/v1/rpc/get_contatti`, {
        method: 'POST', credentials: 'omit', referrerPolicy: 'no-referrer',
        headers: { apikey: root.dataset.chiave!, Authorization: `Bearer ${root.dataset.chiave}`, 'Content-Type': 'application/json' },
        body: JSON.stringify({ p_token: token }),
      });
      if (res.ok) r = await res.json();
    } catch { /* sotto */ }
    if (!r) { msg.textContent = 'Il link non è valido, o la pagina non è più disponibile. Scriveteci e ve ne mandiamo uno nuovo.'; return; }
    if (!r.voci.length) { msg.textContent = 'Per ora nessuno ha lasciato un’email. Le domande senza email restano anonime e arrivano nel riepilogo, se chi le ha scritte l’ha permesso.'; return; }
    msg.hidden = true;
    const ETI: Record<string, string> = JSON.parse(root.dataset.etichette ?? '{}');
    const num = root.querySelector<HTMLElement>('[data-cp-num]')!;
    num.hidden = false;
    // Si contano le domande, non le persone: la stessa email può tornare due volte.
    num.textContent = r.voci.length === 1 ? 'Una domanda aspetta una risposta.' : `${r.voci.length} domande aspettano una risposta.`;
    const ol = root.querySelector<HTMLElement>('[data-cp-voci]')!;
    r.voci.forEach((v) => {
      const li = el('li', 'cp-voce');
      const chi = el('p', 'cp-chi');
      const a = el('a', 'cp-mail', v.contatto) as HTMLAnchorElement;
      a.href = `mailto:${encodeURIComponent(v.contatto).replace('%40', '@')}`;
      chi.append(a);
      const ruolo = [v.funzione ? ETI[v.funzione] ?? v.funzione : '', v.livello ? (ETI[v.livello] ?? v.livello).toLowerCase() : ''].filter(Boolean).join(', ');
      if (ruolo) chi.append(el('span', 'cp-ruolo', ` · ${ruolo}`));
      li.append(chi);
      li.append(el('p', 'cp-testo', v.testo));
      const d = new Date(v.ts).toLocaleDateString('it-IT', { day: 'numeric', month: 'long' });
      li.append(el('p', 'cp-meta', `${d} · sulla parte: ${v.sezione}`));
      ol.append(li);
    });
  }
  carica();
</script>

<style is:global>
  .cp {
    max-width: 44rem; margin: 0 auto; padding: clamp(2rem, 6vw, 4.5rem) 1rem 3rem;
    font-family: var(--font-body, system-ui); color: var(--ink-primary, CanvasText); font-size: 1.0625rem; line-height: 1.6;
  }
  .cp-occ { text-transform: uppercase; letter-spacing: 0.14em; font-size: 0.85rem; color: var(--ink-secondary, inherit); margin: 0 0 0.75rem; }
  .cp-t { font-family: var(--font-display, inherit); font-size: clamp(1.9rem, 5vw, 2.6rem); line-height: 1.12; margin: 0 0 0.75rem; text-wrap: balance; }
  .cp-sub { margin: 0 0 2rem; color: var(--ink-secondary, inherit); }
  .cp-msg { padding: 1.25rem 0; }
  .cp-num { font-family: var(--font-display, inherit); font-size: clamp(1.3rem, 3.2vw, 1.6rem); margin: 0 0 1.75rem; padding-bottom: 1rem; border-bottom: 1px solid var(--line-subtle, currentColor); }
  .cp-voci { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.75rem; }
  .cp-voce { padding-left: 1rem; border-left: 1px solid var(--line-default, currentColor); }
  .cp-chi { margin: 0 0 0.3rem; font-weight: 700; overflow-wrap: anywhere; }
  .cp-mail { color: var(--ink-accent, inherit); text-underline-offset: 0.18em; }
  .cp-ruolo { font-weight: 400; color: var(--ink-secondary, inherit); }
  .cp-testo { margin: 0; white-space: pre-line; }
  .cp-meta { margin: 0.5rem 0 0; font-size: 0.9rem; color: var(--ink-tertiary, inherit); }
  .cp-piede { margin-top: 3rem; padding-top: 1.25rem; border-top: 1px solid var(--line-subtle, currentColor); font-size: 0.95rem; color: var(--ink-tertiary, inherit); }
  .cp-piede p { margin: 0; }
  @media print { .cp { display: none; } }
</style>
