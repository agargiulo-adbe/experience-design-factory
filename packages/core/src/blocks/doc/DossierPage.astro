      width: 15rem; flex-shrink: 0;
      padding: 2.5rem 0 2rem var(--_gut);
      max-height: calc(100dvh - var(--_bar-h) - 3rem); overflow-y: auto;
    }
    .dw-toc--rail .dw-toc-a { font-size: 0.82rem; min-height: 2.25rem; padding: 0.35rem 0; }
  }

  .dw-main {
    flex: 1; min-width: 0;
    max-width: var(--_col);
    padding: clamp(1.5rem, 4vw, 2.5rem) var(--_gut) 4rem;
    display: flex; flex-direction: column;
  }

  .dw-state { min-height: 50vh; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 1.2rem; text-align: center; }
  .dw-state-msg { font-size: 1rem; line-height: 1.6; color: var(--_ink-soft); max-width: 32rem; }
  .dw-btn {
    display: inline-flex; align-items: center; min-height: 2.75rem; padding: 0 1.2rem;
    font-size: 0.88rem; font-weight: 700; color: var(--_on-fill); background: var(--_fill);
    border-radius: 6px; text-decoration: none;
  }

  /* ── Copertina ───────────────────────────────────────────────────────── */
  .dw-cover { padding-bottom: 0.4rem; }
  .dw-cover-h {
    font-family: var(--_font-display); font-weight: 800; letter-spacing: -0.02em;
    font-size: clamp(1.4rem, 5vw, 2.1rem); line-height: 1.15; color: var(--_ink-strong);
    text-wrap: balance;
  }
  .dw-cover-meta {
    margin-top: 0.7rem; font-size: 0.78rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--_accent);
  }
  .dw-cover-note {
    margin-top: 1rem; padding: 0.9rem 1rem;
    border: 1px solid var(--_line); border-left: 3px solid var(--_warn); border-radius: 0 8px 8px 0;
    background: var(--_surface);
    font-size: 0.9rem; line-height: 1.6; color: var(--_ink-soft);
  }

  /* ── Sezioni ─────────────────────────────────────────────────────────── */
  .dw-section { border-top: 1px solid var(--_line); padding-top: 1.6rem; margin-top: 2.2rem; scroll-margin-top: calc(var(--_bar-h) + 1rem); }
  .dw-section:focus { outline: none; }
  .dw-h {
    display: flex; align-items: baseline; gap: 0.7rem;
    font-family: var(--_font-display); font-weight: 700; letter-spacing: -0.015em;
    font-size: clamp(1.3rem, 3.6vw, 1.7rem); line-height: 1.25; color: var(--_ink-strong);
    margin-bottom: 1rem; text-wrap: balance;
  }
  .dw-h-num { flex-shrink: 0; font-family: var(--_font-body); font-size: 0.78rem; font-weight: 700; letter-spacing: 0.1em; color: var(--_accent); }
  .dw-note { font-size: 0.95rem; line-height: 1.6; color: var(--_ink-soft); overflow-wrap: anywhere; }
  .dw-note + * { margin-top: 1.1rem; }
  .dw-note--foot {
    margin-top: 1.1rem; padding-top: 0.9rem; border-top: 1px dashed var(--_line);
    font-size: 0.9rem;
  }
  .dw-note strong { color: var(--_ink-strong); font-weight: 600; }
  .dw-note em { color: var(--_alt); font-style: normal; }

  /* ── Elenchi ─────────────────────────────────────────────────────────── */
  .dw-list { list-style: none; display: flex; flex-direction: column; gap: 0.75rem; margin: 0; padding: 0; }
  .dw-list + * { margin-top: 1.1rem; }
  .dw-li { position: relative; padding-left: 1.05rem; font-size: 1rem; line-height: 1.6; color: var(--_ink); overflow-wrap: anywhere; }
  .dw-li::before { content: ''; position: absolute; left: 0; top: 0.6em; width: 6px; height: 6px; border-radius: 50%; background: var(--_accent); }
  .dw-list--tight .dw-li { font-size: 0.93rem; line-height: 1.55; }
  .dw-li strong { color: var(--_ink-strong); font-weight: 600; }
  .dw-li em { color: var(--_alt); font-style: normal; }

  /* `code`: nei dossier tecnici si citano nomi di variabili, suite e parametri.
     Prima venivano escapati e il lettore vedeva i tag alla lettera. */
  .dw-code {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.88em; padding: 0.08em 0.32em; border-radius: 4px;
    background: var(--_surface-2); color: var(--_ink-strong);
    overflow-wrap: anywhere;
  }

  .dw-chip {
    display: inline-flex; align-items: center; margin-right: 0.45rem;
    padding: 0.16rem 0.5rem; border-radius: 999px;
    font-size: 0.65rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--_on-fill); background: var(--_fill); vertical-align: middle;
  }
  .dw-chip--warn { background: var(--_warn); color: var(--_on-warn); }
  .dw-chip--comp { background: #c8321e; color: #fff; }
  .dw-chip--go { background: transparent; color: var(--_accent); border: 1px solid var(--_accent); }
  .dw-chip--mute { background: transparent; color: var(--_ink-faint); border: 1px solid var(--_line); }

  /* ── Cronologia ──────────────────────────────────────────────────────── */
  .dw-timeline { display: flex; flex-direction: column; }
  .dw-tl-row { display: grid; grid-template-columns: 6.5rem 1fr; gap: 1rem; padding: 0.7rem 0; border-top: 1px solid var(--_line); }
  .dw-tl-row:first-child { border-top: 0; padding-top: 0; }
  .dw-tl-year { font-family: var(--_font-display); font-weight: 700; font-size: 0.88rem; color: var(--_accent); }
  .dw-tl-text { font-size: 0.95rem; line-height: 1.6; color: var(--_ink); }
  @media (max-width: 600px) {
    .dw-tl-row { grid-template-columns: 1fr; gap: 0.25rem; }
    .dw-tl-year { font-size: 0.8rem; letter-spacing: 0.06em; text-transform: uppercase; }
  }

  /* ── Numeri: due per riga anche sul telefono, non quattro schede in fila
     una sotto l'altra alte duecento pixel l'una. ────────────────────────── */
  .dw-stats { display: grid; gap: 0.6rem; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  @media (min-width: 860px) { .dw-stats { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .dw-stat { min-width: 0; overflow-wrap: anywhere; border: 1px solid var(--_line); border-radius: 10px; padding: 0.85rem 0.9rem; background: var(--_surface); }
  .dw-stat-v { font-family: var(--_font-display); font-weight: 800; font-size: clamp(1.25rem, 5vw, 1.5rem); line-height: 1.1; letter-spacing: -0.02em; color: var(--_accent); }
  .dw-stat-l { margin-top: 0.3rem; font-size: 0.85rem; line-height: 1.35; color: var(--_ink-strong); font-weight: 600; }
  .dw-stat-s { margin-top: 0.25rem; font-size: 0.76rem; line-height: 1.4; color: var(--_ink-soft); }

  /* ── Schede persona ──────────────────────────────────────────────────── */
  .dw-grid { display: grid; gap: 0.8rem; grid-template-columns: 1fr; }
  @media (min-width: 760px) { .dw-grid { grid-template-columns: 1fr 1fr; } }
  .dw-card { min-width: 0; overflow-wrap: anywhere; border: 1px solid var(--_line); border-radius: 10px; padding: 1rem 1.05rem; background: var(--_surface); }
  .dw-card-name { font-family: var(--_font-display); font-weight: 700; font-size: 1.02rem; color: var(--_ink-strong); }
  .dw-card-role { margin-top: 0.2rem; font-size: 0.85rem; line-height: 1.45; color: var(--_alt); }
  .dw-card-note { margin-top: 0.55rem; font-size: 0.92rem; line-height: 1.55; color: var(--_ink); }
  .dw-card-link { display: inline-block; margin-top: 0.6rem; font-size: 0.8rem; font-weight: 700; color: var(--_accent); text-decoration: none; }

  /* ── Righe chiave/valore ─────────────────────────────────────────────── */
  .dw-rows { display: flex; flex-direction: column; }
  .dw-row { display: grid; grid-template-columns: 12rem 1fr; gap: 1.1rem; padding: 0.85rem 0; border-top: 1px solid var(--_line); align-items: start; }
  .dw-row:first-child { border-top: 0; padding-top: 0; }
  .dw-row-k { font-family: var(--_font-display); font-weight: 700; font-size: 0.97rem; line-height: 1.35; color: var(--_ink-strong); }
  .dw-row-sub { margin-top: 0.15rem; font-size: 0.78rem; line-height: 1.4; color: var(--_alt); }
  .dw-row-v { min-width: 0; overflow-wrap: anywhere; font-size: 0.95rem; line-height: 1.6; color: var(--_ink); }
  .dw-row-v strong { color: var(--_ink-strong); }
  .dw-row-v em { color: var(--_alt); font-style: normal; }
  @media (max-width: 760px) {
    .dw-row { grid-template-columns: 1fr; gap: 0.35rem; }
    .dw-row-l { border-left: 2px solid var(--_accent); padding-left: 0.6rem; }
  }

  /* ── Idee ────────────────────────────────────────────────────────────── */
  .dw-ideas { display: grid; gap: 0.9rem; grid-template-columns: 1fr; }
  @media (min-width: 900px) { .dw-ideas { grid-template-columns: 1fr 1fr; } }
  .dw-idea { min-width: 0; overflow-wrap: anywhere; border: 1px solid var(--_line); border-radius: 12px; padding: 1.1rem 1.15rem; background: var(--_surface); display: flex; flex-direction: column; gap: 0.55rem; }
