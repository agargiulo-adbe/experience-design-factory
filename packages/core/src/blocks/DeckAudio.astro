---
/**
 * DeckAudio — un letto sonoro sotto il deck, che cambia livello con la slide.
 *
 * COME SI COMPORTA, e perché così:
 *
 * · **Parte spento.** Non è una scelta estetica: il browser blocca comunque
 *   l'audio finché non c'è un gesto dell'utente, quindi «acceso di default»
 *   non esiste davvero — esiste «acceso al primo clic», che per chi riceve il
 *   link in ufficio è musica a sorpresa. Il comando è visibile e la scelta si
 *   ricorda (`localStorage`), così chi presenta lo accende una volta sola.
 *
 * · **Il livello segue la slide.** Copertina e chiusura sono le due slide dove
 *   non si parla: lì il suono può salire. Su tutte le altre resta un velo, che
 *   si sente solo quando smette. Una slide dichiara `data-audio="loud"`; tutte
 *   le altre stanno al livello basso senza dover dichiarare niente.
 *
 * · **Le transizioni sono dissolvenze**, mai salti: un cambio di volume netto
 *   si sente come un errore tecnico.
 *
 * · **Si ferma quando la scheda non è in primo piano.** Un deck lasciato aperto
 *   in una scheda dietro non deve suonare mentre si parla d'altro.
 *
 * · **Sopravvive al cambio di capitolo.** La navigazione fra capitoli è SPA
 *   (ClientRouter): senza `transition:persist` l'elemento verrebbe ricreato e
 *   la musica ripartirebbe da capo a ogni capitolo.
 *
 * L'audio è un ASSET LICENZIATO come tutti gli altri: la provenienza (fonte,
 * id, licenza) va dichiarata dall'app che lo monta, non inventata qui.
 */
interface Props {
  /** URL della traccia, già ricucita sul giro. Sta sul Release `media`. */
  src: string;
  /** Volume sulle slide che dichiarano `data-audio="loud"`. */
  loud?: number;
  /** Volume su tutte le altre. */
  soft?: number;
  /** Etichette del comando (bilingui). */
  labels?: { it: string; en: string };
  class?: string;
}
const {
  src,
  loud = 0.5,
  soft = 0.12,
  labels = { it: 'Audio', en: 'Audio' },
  class: className,
} = Astro.props as Props;
---
<div
  class:list={['edf-audio', className]}
  transition:persist="edf-audio"
  data-edf-audio
  data-loud={String(loud)}
  data-soft={String(soft)}
>
  <audio data-edf-audio-el loop preload="none" src={src}></audio>
  <button
    type="button"
    class="edf-audio-btn"
    data-edf-audio-toggle
    aria-pressed="false"
  >
    <svg class="edf-audio-ico" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
      <path class="edf-audio-spk" d="M3.5 6h2L8.5 3.5v9L5.5 10h-2z" fill="currentColor"/>
      <path class="edf-audio-on" d="M10.8 5.6a3.4 3.4 0 010 4.8M12.8 3.6a6.2 6.2 0 010 8.8"
            stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
      <path class="edf-audio-off" d="M11 6l4 4M15 6l-4 4"
            stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
    </svg>
    <span class="edf-audio-label">
      <span data-lang-it>{labels.it}</span><span data-lang-en>{labels.en}</span>
    </span>
  </button>
</div>

<style is:global>
  .edf-audio {
    position: fixed;
    right: var(--edf-audio-right, 1.5rem);
    bottom: var(--edf-audio-bottom, 4.25rem);
    z-index: 40;
    transition: opacity 300ms cubic-bezier(0.25, 0.1, 0.25, 1);
  }
  .edf-audio-btn {
    display: inline-flex; align-items: center; gap: 0.45rem;
    padding: 0.4rem 0.7rem;
    border: 1px solid var(--edf-audio-line, rgba(255, 255, 255, 0.28));
    border-radius: 999px;
    background: var(--edf-audio-bg, rgba(0, 0, 0, 0.34));
    color: var(--edf-audio-ink, rgba(255, 255, 255, 0.92));
    font: inherit;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    cursor: pointer;
    backdrop-filter: blur(6px);
    transition: opacity 200ms ease, border-color 200ms ease;
  }
  .edf-audio-btn:hover { border-color: var(--edf-audio-line-hover, rgba(255, 255, 255, 0.5)); }
  .edf-audio-btn:focus-visible {
    outline: 2px solid var(--edf-audio-focus, #ffffff);
    outline-offset: 3px;
  }
  /* Chiuso = la crocetta; aperto = le onde. Una sola icona, due stati. */
  .edf-audio-btn .edf-audio-on { display: none; }
  .edf-audio-btn[aria-pressed='true'] .edf-audio-on { display: inline; }
  .edf-audio-btn[aria-pressed='true'] .edf-audio-off { display: none; }
  .edf-audio-btn[aria-pressed='true'] { opacity: 1; }
  .edf-audio-btn[aria-pressed='false'] { opacity: 0.62; }

  /* Su fondo chiaro il comando si ribalta: una pillola nera su bianco è un buco.
     Lo stato arriva dal deck (`data-on-dark`) ricopiato qui dal runtime: un
     selettore fratello si romperebbe al primo cambio di ordine nel layout. */
  .edf-audio[data-on-light] .edf-audio-btn {
    border-color: rgba(0, 0, 0, 0.2);
    background: rgba(255, 255, 255, 0.8);
    color: rgba(0, 0, 0, 0.78);
  }

  /* Mentre si legge un dettaglio aperto, il contorno arretra (vedi HowItWorks). */
  html[data-hiw-open] .edf-audio { opacity: 0; pointer-events: none; }

  /* Su telefono resta solo l'icona: la parola non serve e ruba spazio. */
  @media (max-width: 640px) {
    .edf-audio { --edf-audio-bottom: 3.5rem; --edf-audio-right: 0.75rem; }
    .edf-audio-label { display: none; }
  }
  @media (min-width: 2000px) {
    .edf-audio-btn { font-size: 0.7rem; padding: 0.5rem 0.9rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .edf-audio, .edf-audio-btn { transition: none; }
  }
</style>

<script>
  /**
   * Il runtime vive su `document`, non sull'elemento: con `transition:persist`
   * il nodo sopravvive agli swap del ClientRouter, e ricablarlo a ogni swap
   * creerebbe più listener sullo stesso bottone.
   */
  interface AudioState {
    on: boolean;
    target: number;
    raf: number | null;
  }

  const KEY = 'edf:audio-on';

  function wireDeckAudio() {
    const root = document.querySelector<HTMLElement>('[data-edf-audio]');
    const el = root?.querySelector<HTMLAudioElement>('[data-edf-audio-el]');
    const btn = root?.querySelector<HTMLButtonElement>('[data-edf-audio-toggle]');
    if (!root || !el || !btn) return;

    const w = window as unknown as { __edfAudio?: AudioState };
    const first = !w.__edfAudio;
    const state: AudioState = w.__edfAudio ?? { on: false, target: 0, raf: null };
    w.__edfAudio = state;

    const levels = () => ({
      loud: parseFloat(root.dataset.loud || '0.5'),
      soft: parseFloat(root.dataset.soft || '0.12'),
    });

    /** Dissolvenza, mai un salto: un volume che scatta si sente come un guasto. */
    function fadeTo(v: number, ms = 1200) {
      state.target = v;
      if (state.raf) cancelAnimationFrame(state.raf);
      const from = el!.volume;
      const t0 = performance.now();
      const step = (t: number) => {
        /* `k` va clampato ANCHE in basso: il timestamp del primo rAF può essere
           di pochi millisecondi PRECEDENTE a `performance.now()` preso un attimo
           prima (è l'istante di inizio frame), e un `k` negativo produceva un
           volume negativo. Il setter lancia, l'eccezione usciva dal ciclo e la
           dissolvenza restava ferma a zero: l'audio non partiva mai. */
        const k = Math.max(0, Math.min(1, (t - t0) / ms));
        el!.volume = Math.max(0, Math.min(1, from + (v - from) * k));
        if (k < 1) state.raf = requestAnimationFrame(step);
        else {
          state.raf = null;
          if (v === 0 && !state.on) el!.pause();
        }
      };
      state.raf = requestAnimationFrame(step);
    }

    /** Il livello della slide attiva: `data-audio="loud"` sale, tutto il resto no. */
    function levelForActiveSlide(): number {
      const slides = Array.from(document.querySelectorAll<HTMLElement>('[data-slide]'));
      const deck = (window as unknown as { __edfDeck?: { index: number } }).__edfDeck;
      const active = deck && slides[deck.index] ? slides[deck.index] : slides[0];
      const { loud, soft } = levels();
      return active?.dataset.audio === 'loud' ? loud : soft;
    }

    /** Ricopia la dominante della slide attiva, per ribaltare l'inchiostro. */
    function syncTone() {
      const deckEl = document.querySelector('[data-deck]');
      if (!deckEl) return;
      if (deckEl.hasAttribute('data-on-dark')) delete root!.dataset.onLight;
      else root!.dataset.onLight = 'true';
    }

    function setOn(on: boolean, persist = true) {
      state.on = on;
      btn!.setAttribute('aria-pressed', String(on));
      if (persist) { try { localStorage.setItem(KEY, on ? '1' : '0'); } catch { /* private mode */ } }
      if (on) {
        el!.volume = 0;
        void el!.play().catch(() => { /* il browser può rifiutare: resta spento */ });
        fadeTo(levelForActiveSlide(), 1500);
      } else {
        fadeTo(0, 700);
      }
    }

    if (first) {
      btn.addEventListener('click', (e) => { e.stopPropagation(); setOn(!state.on); });
      /* Il livello segue la slide. `deck:change` lo emette il controller del deck. */
      document.addEventListener('deck:change', () => {
        syncTone();
        if (state.on) fadeTo(levelForActiveSlide(), 1200);
      });
      /* Scheda dietro: si tace. Un deck dimenticato in una scheda non deve suonare. */
      document.addEventListener('visibilitychange', () => {
        if (!state.on) return;
        if (document.hidden) fadeTo(0, 400);
        else { void el.play().catch(() => {}); fadeTo(levelForActiveSlide(), 900); }
      });
    }

    /* La preferenza si ricorda, ma NON fa partire nulla da sola: serve comunque
       un gesto, e il browser lo pretende. Si ripristina solo lo stato del
       comando, così chi torna lo trova com'era e gli basta un clic. */
    try {
      const saved = localStorage.getItem(KEY);
      if (saved === '1' && !state.on) btn.setAttribute('aria-pressed', 'false');
    } catch { /* private mode */ }

    btn.setAttribute('aria-pressed', String(state.on));
    syncTone();
  }

  wireDeckAudio();
  document.addEventListener('astro:after-swap', wireDeckAudio);
</script>
