---
/**
 * DeckAudio — un letto sonoro sotto il deck, che cambia livello con la slide.
 *
 * COME SI COMPORTA, e perché così:
 *
 * · **Parte spento.** Non è una scelta estetica: il browser blocca comunque
 *   l'audio finché non c'è un gesto dell'utente, quindi «acceso di default»
 *   non esiste davvero — esiste «acceso al primo clic», che per chi riceve il
 *   link in ufficio è musica a sorpresa. Il comando è visibile e la scelta si
 *   ricorda (`localStorage`), così chi presenta lo accende una volta sola.
 *
 * · **Il livello segue la slide.** Copertina e chiusura sono le due slide dove
 *   non si parla: lì il suono può salire. Su tutte le altre resta un velo, che
 *   si sente solo quando smette. Una slide dichiara `data-audio="loud"`; tutte
 *   le altre stanno al livello basso senza dover dichiarare niente.
 *
 * · **Le transizioni sono dissolvenze**, mai salti: un cambio di volume netto
 *   si sente come un errore tecnico.
 *
 * · **Il cursore è un guadagno generale**, non un volume assoluto: moltiplica i
 *   livelli per slide invece di sostituirli, così la dinamica decisa in pagina
 *   (copertina forte, velo altrove) sopravvive a qualunque posizione del
 *   cursore. Compare solo ad audio acceso, e la posizione si ricorda.
 *
 * · **Si ferma quando la scheda non è in primo piano.** Un deck lasciato aperto
 *   in una scheda dietro non deve suonare mentre si parla d'altro.
 *
 * · **Sopravvive al cambio di capitolo.** La navigazione fra capitoli è SPA
 *   (ClientRouter): senza `transition:persist` l'elemento verrebbe ricreato e
 *   la musica ripartirebbe da capo a ogni capitolo.
 *
 * L'audio è un ASSET LICENZIATO come tutti gli altri: la provenienza (fonte,
 * id, licenza) va dichiarata dall'app che lo monta, non inventata qui.
 */
interface Props {
  /** URL della traccia, già ricucita sul giro. Sta sul Release `media`. */
  src: string;
  /** Volume sulle slide che dichiarano `data-audio="loud"`. */
  loud?: number;
  /** Volume su tutte le altre. */
  soft?: number;
  /** Etichette del comando (bilingui). */
  labels?: { it: string; en: string };
  class?: string;
}
const {
  src,
  loud = 0.5,
  soft = 0.12,
  labels = { it: 'Audio', en: 'Audio' },
  class: className,
} = Astro.props as Props;
---
<div
  class:list={['edf-audio', className]}
  transition:persist="edf-audio"
  data-edf-audio
  data-loud={String(loud)}
  data-soft={String(soft)}
>
  <audio data-edf-audio-el loop preload="none" src={src}></audio>
  <div class="edf-audio-control" data-edf-audio-control>
  <button
    type="button"
    class="edf-audio-btn deck-btn"
    data-edf-audio-toggle
    aria-pressed="false"
  >
    <svg class="edf-audio-ico" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
      <path class="edf-audio-spk" d="M3.5 6h2L8.5 3.5v9L5.5 10h-2z" fill="currentColor"/>
      <path class="edf-audio-on" d="M10.8 5.6a3.4 3.4 0 010 4.8M12.8 3.6a6.2 6.2 0 010 8.8"
            stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
      <path class="edf-audio-off" d="M11 6l4 4M15 6l-4 4"
            stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
    </svg>
    <span class="edf-audio-label">
      <span data-lang-it>{labels.it}</span><span data-lang-en>{labels.en}</span>
    </span>
  </button>

  {/* Il livello è un GUADAGNO GENERALE, non un volume assoluto: moltiplica i
      livelli per slide, così la dinamica (copertina forte, velo altrove) resta
      quella decisa in pagina invece di essere schiacciata dal cursore.
      Compare quando l'audio è acceso: un cursore che non governa niente è
      peggio di un cursore assente. */}
  <label class="edf-audio-level" data-edf-audio-level>
    <span class="edf-audio-sr">
      <span data-lang-it>Livello audio</span><span data-lang-en>Audio level</span>
    </span>
    <input
      type="range"
      min="20"
      max="150"
      step="10"
      value="100"
      data-edf-audio-range
      aria-label={labels.it === labels.en ? `${labels.it} — livello` : 'Livello audio'}
    />
  </label>
  </div>
</div>

<style is:global>
  /* Il nodo che resta nel layout (con `transition:persist`) porta solo
     l'elemento <audio>: non si vede e non occupa spazio. Il COMANDO viene
     spostato a runtime dentro la barra del deck, accanto a frecce, contatore e
     schermo intero — è lì che chi presenta cerca i comandi, e così eredita
     anche la sparizione automatica del chrome. */
  .edf-audio { position: absolute; width: 0; height: 0; overflow: visible; }
  .edf-audio-control {
    display: inline-flex; align-items: center; gap: 0.6rem;
    pointer-events: auto;
    transition: opacity 300ms cubic-bezier(0.25, 0.1, 0.25, 1);
  }
  /* Il bottone prende la stessa forma degli altri comandi (`.deck-btn`): nella
     barra, una pillola accanto a tre cerchi sarebbe un corpo estraneo. */
  .edf-audio-btn {
    display: inline-flex; align-items: center; justify-content: center;
    cursor: pointer;
    font: inherit;
  }
  .edf-audio-label { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; }
  /* Chiuso = la crocetta; aperto = le onde. Una sola icona, due stati. */
  .edf-audio-btn .edf-audio-on { display: none; }
  .edf-audio-btn[aria-pressed='true'] .edf-audio-on { display: inline; }
  .edf-audio-btn[aria-pressed='true'] .edf-audio-off { display: none; }
  .edf-audio-btn[aria-pressed='false'] { opacity: 0.7; }

  /* Su fondo chiaro il comando si ribalta: una pillola nera su bianco è un buco.
     Lo stato arriva dal deck (`data-on-dark`) ricopiato qui dal runtime: un
     selettore fratello si romperebbe al primo cambio di ordine nel layout. */
  .edf-audio[data-on-light] .edf-audio-btn {
    border-color: rgba(0, 0, 0, 0.2);
    background: rgba(255, 255, 255, 0.8);
    color: rgba(0, 0, 0, 0.78);
  }

  /* Il cursore del livello: c'è solo ad audio acceso.
     Niente animazione di LARGHEZZA — animare width fa ricalcolare il layout a
     ogni fotogramma, e questa barra sta sopra una slide proiettata, dove lo
     scatto si vede. Quando è spento il cursore non occupa spazio (`display:
     none`), quindi la barra resta centrata sui suoi quattro comandi; quando si
     accende entra con una dissolvenza e uno scivolo, che sono composite-only.
     La barra si riallarga in un colpo solo: è la conseguenza di un gesto
     esplicito, non un'animazione mancata. */
  .edf-audio-level { display: none; align-items: center; }
  .edf-audio-control[data-on] .edf-audio-level {
    display: flex;
    animation: edf-audio-level-in 220ms cubic-bezier(0.25, 0.1, 0.25, 1) both;
  }
  @keyframes edf-audio-level-in {
    from { opacity: 0; transform: translateX(-0.5rem); }
    to   { opacity: 1; transform: none; }
  }
  .edf-audio-sr {
    position: absolute; width: 1px; height: 1px; overflow: hidden;
    clip: rect(0, 0, 0, 0); white-space: nowrap;
  }
  .edf-audio-level input[type='range'] {
    width: 6.5rem; height: 1.5rem; margin: 0;
    appearance: none; background: transparent; cursor: pointer;
  }
  .edf-audio-level input[type='range']::-webkit-slider-runnable-track {
    height: 3px; border-radius: 999px;
    background: var(--edf-audio-track, rgba(255, 255, 255, 0.3));
  }
  .edf-audio-level input[type='range']::-moz-range-track {
    height: 3px; border-radius: 999px;
    background: var(--edf-audio-track, rgba(255, 255, 255, 0.3));
  }
  .edf-audio-level input[type='range']::-webkit-slider-thumb {
    appearance: none; width: 0.85rem; height: 0.85rem; margin-top: -0.35rem;
    border-radius: 50%; border: 0;
    background: var(--edf-audio-thumb, rgba(255, 255, 255, 0.95));
  }
  .edf-audio-level input[type='range']::-moz-range-thumb {
    width: 0.85rem; height: 0.85rem; border: 0; border-radius: 50%;
    background: var(--edf-audio-thumb, rgba(255, 255, 255, 0.95));
  }
  .edf-audio-level input[type='range']:focus-visible {
    outline: 2px solid var(--edf-audio-focus, #ffffff); outline-offset: 3px; border-radius: 999px;
  }
  .edf-audio-control[data-on-light] { --edf-audio-track: rgba(0, 0, 0, 0.22); --edf-audio-thumb: rgba(0, 0, 0, 0.72); }

  /* Mentre si legge un dettaglio aperto, il contorno arretra (vedi HowItWorks). */
  html[data-hiw-open] .edf-audio-control { opacity: 0; pointer-events: none; }

  /* Su telefono resta solo l'icona: la parola non serve e ruba spazio. */
  @media (max-width: 640px) {
    /* Su telefono il cursore è un bersaglio troppo fine: resta l'interruttore. */
    .edf-audio-control[data-on] .edf-audio-level { display: none; }
    .edf-audio-control { gap: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .edf-audio-control { transition: none; }
    .edf-audio-control[data-on] .edf-audio-level { animation: none; }
  }
</style>

<script>
  /**
   * Il runtime vive su `document`, non sull'elemento: con `transition:persist`
   * il nodo sopravvive agli swap del ClientRouter, e ricablarlo a ogni swap
   * creerebbe più listener sullo stesso bottone.
   */
  interface AudioState {
    on: boolean;
    target: number;
    raf: number | null;
  }

  const KEY = 'edf:audio-on';
  const GAIN_KEY = 'edf:audio-gain';

  function wireDeckAudio() {
    const root = document.querySelector<HTMLElement>('[data-edf-audio]');
    const el = root?.querySelector<HTMLAudioElement>('[data-edf-audio-el]');
    const btn = document.querySelector<HTMLButtonElement>('[data-edf-audio-toggle]');
    if (!root || !el || !btn) return;

    const w = window as unknown as { __edfAudio?: AudioState };
    const first = !w.__edfAudio;
    const state: AudioState = w.__edfAudio ?? { on: false, target: 0, raf: null };
    w.__edfAudio = state;

    const control = root.querySelector<HTMLElement>('[data-edf-audio-control]')
      ?? document.querySelector<HTMLElement>('[data-edf-audio-control]');
    const range = control?.querySelector<HTMLInputElement>('[data-edf-audio-range]')
      ?? document.querySelector<HTMLInputElement>('[data-edf-audio-range]');

    /**
     * Il comando si trasferisce nella barra del deck, in coda agli altri.
     * Va rifatto a ogni swap del ClientRouter: il nodo con <audio> sopravvive
     * (`transition:persist`), la barra del deck no — viene ricostruita, e il
     * comando resterebbe orfano nella pagina vecchia.
     */
    function dock() {
      const bar = document.querySelector('[data-deck-controls]');
      if (!bar || !control || control.parentElement === bar) return;
      bar.appendChild(control);
    }

    /**
     * Prima dello swap il comando TORNA dentro il nodo persistente. Senza
     * questo passaggio muore con la pagina vecchia — è stato spostato fuori da
     * ciò che `transition:persist` protegge — e dopo il primo cambio capitolo
     * l'audio resta acceso ma senza comandi per spegnerlo.
     */
    function undock() {
      if (control && root && control.parentElement !== root) root.appendChild(control);
    }

    /** Guadagno generale scelto da chi presenta: moltiplica, non sostituisce. */
    function gain(): number {
      const v = range ? parseFloat(range.value) : 100;
      return Number.isFinite(v) ? v / 100 : 1;
    }

    const levels = () => ({
      loud: parseFloat(root.dataset.loud || '0.5'),
      soft: parseFloat(root.dataset.soft || '0.12'),
    });

    /** Dissolvenza, mai un salto: un volume che scatta si sente come un guasto. */
    function fadeTo(v: number, ms = 1200) {
      state.target = v;
      if (state.raf) cancelAnimationFrame(state.raf);
      const from = el!.volume;
      const t0 = performance.now();
      const step = (t: number) => {
        /* `k` va clampato ANCHE in basso: il timestamp del primo rAF può essere
           di pochi millisecondi PRECEDENTE a `performance.now()` preso un attimo
           prima (è l'istante di inizio frame), e un `k` negativo produceva un
           volume negativo. Il setter lancia, l'eccezione usciva dal ciclo e la
           dissolvenza restava ferma a zero: l'audio non partiva mai. */
        const k = Math.max(0, Math.min(1, (t - t0) / ms));
        el!.volume = Math.max(0, Math.min(1, from + (v - from) * k));
        if (k < 1) state.raf = requestAnimationFrame(step);
        else {
          state.raf = null;
          if (v === 0 && !state.on) el!.pause();
        }
      };
      state.raf = requestAnimationFrame(step);
    }

    /** Il livello della slide attiva: `data-audio="loud"` sale, tutto il resto no. */
    function levelForActiveSlide(): number {
      const slides = Array.from(document.querySelectorAll<HTMLElement>('[data-slide]'));
      const deck = (window as unknown as { __edfDeck?: { index: number } }).__edfDeck;
      const active = deck && slides[deck.index] ? slides[deck.index] : slides[0];
      const { loud, soft } = levels();
      const base = active?.dataset.audio === 'loud' ? loud : soft;
      /* Il tetto a 1 è del mezzo, non una scelta: `HTMLMediaElement.volume` non
         va oltre. Con il guadagno al massimo la copertina ci arriva vicino. */
      return Math.min(1, base * gain());
    }

    /** Ricopia la dominante della slide attiva, per ribaltare l'inchiostro. */
    function syncTone() {
      const deckEl = document.querySelector('[data-deck]');
      if (!deckEl) return;
      if (deckEl.hasAttribute('data-on-dark')) delete control!.dataset.onLight;
      else control!.dataset.onLight = 'true';
    }

    function setOn(on: boolean, persist = true) {
      state.on = on;
      btn!.setAttribute('aria-pressed', String(on));
      if (on) control!.dataset.on = ''; else delete control!.dataset.on;
      if (persist) { try { localStorage.setItem(KEY, on ? '1' : '0'); } catch { /* private mode */ } }
      if (on) {
        el!.volume = 0;
        void el!.play().catch(() => { /* il browser può rifiutare: resta spento */ });
        fadeTo(levelForActiveSlide(), 1500);
      } else {
        fadeTo(0, 700);
      }
    }

    if (first) {
      btn.addEventListener('click', (e) => { e.stopPropagation(); setOn(!state.on); });
      /* Il livello segue la slide. `deck:change` lo emette il controller del deck. */
      document.addEventListener('deck:change', () => {
        syncTone();
        if (state.on) fadeTo(levelForActiveSlide(), 1200);
      });
      /* Il cursore agisce SUBITO (chi lo muove sta ascoltando), quindi una
         dissolvenza corta: 1,2 s qui sembrerebbe un comando che non risponde. */
      range?.addEventListener('input', () => {
        try { localStorage.setItem(GAIN_KEY, range.value); } catch { /* private mode */ }
        if (state.on) fadeTo(levelForActiveSlide(), 160);
      });
      /* Le frecce del deck e quelle del cursore sono le stesse: mentre il
         cursore ha il fuoco, la navigazione non deve rubargliele. */
      range?.addEventListener('keydown', (e) => e.stopPropagation());
      range?.addEventListener('click', (e) => e.stopPropagation());
      document.addEventListener('astro:before-swap', undock);
      /* Scheda dietro: si tace. Un deck dimenticato in una scheda non deve suonare. */
      document.addEventListener('visibilitychange', () => {
        if (!state.on) return;
        if (document.hidden) fadeTo(0, 400);
        else { void el.play().catch(() => {}); fadeTo(levelForActiveSlide(), 900); }
      });
    }

    /* La preferenza si ricorda, ma NON fa partire nulla da sola: serve comunque
       un gesto, e il browser lo pretende. Si ripristina solo lo stato del
       comando, così chi torna lo trova com'era e gli basta un clic. */
    try {
      const saved = localStorage.getItem(KEY);
      if (saved === '1' && !state.on) btn.setAttribute('aria-pressed', 'false');
      const savedGain = localStorage.getItem(GAIN_KEY);
      if (savedGain && range) range.value = savedGain;
    } catch { /* private mode */ }

    dock();
    btn.setAttribute('aria-pressed', String(state.on));
    if (state.on) control!.dataset.on = ''; else delete control!.dataset.on;
    syncTone();
  }

  wireDeckAudio();
  document.addEventListener('astro:after-swap', wireDeckAudio);
</script>
