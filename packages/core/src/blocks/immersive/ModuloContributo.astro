---
/**
 * Il modulo dei contributi — versione B («Da costruire insieme») dell'edizione
 * da distribuire. Spec 2026-11-19, «Revisione del 19 nov sera».
 *
 * ANONIMO PER COSTRUZIONE: sezione, testo, funzione e livello facoltativi, una
 * sola casella («nel riepilogo per la banca») spenta. Niente nome, niente
 * contatto, niente cookie o memoria nel browser. Prima del clic su «Invia» non
 * parte nessuna chiamata di rete.
 *
 * Come si apre:
 *  - con `pulsante`, il componente posa «Fateci una domanda» nella barra dei
 *    comandi del deck (fuori dalle slide, quindi fuori da audit:deck) e
 *    precompila la sezione con «capitolo · titolo della slide attiva». Il
 *    pulsante resta visibile anche quando il resto della barra si dissolve
 *    (`.deck-idle`), e si spegne sulle slide dove una domanda non ha oggetto:
 *    copertine, firme di chiusura, `[data-senza-domanda]` (`SENZA_DOMANDA`).
 *    Si spegne con `visibility`, non con `display`: la barra è centrata, e
 *    togliere il pulsante farebbe saltare le frecce a ogni copertina;
 *  - qualunque elemento `[data-contributo-apri]` lo apre, con la sezione di
 *    `data-sezione` e la funzione di `data-funzione` se ci sono (le card per
 *    funzione, `CardFunzioni.astro`).
 * Il pulsante nasce da JS: gli stili che lo toccano stanno in `is:global`
 * (memoria astro-scoped-css-runtime-dom).
 */
import { FUNZIONI, LIVELLI, LIMITI } from '../../utils/contributi';
interface Props {
  /** riga di `riepiloghi` (es. `intesa-storia-insieme`) */
  progetto: string;
  /** il titolo del capitolo della pagina, per precompilare la sezione */
  capitolo?: string;
  /** posa «Fateci una domanda» nella barra del deck */
  pulsante?: boolean;
}
const { progetto, capitolo = '', pulsante = false } = Astro.props;
const URL_DB = (import.meta.env.PUBLIC_SUPABASE_URL ?? '').replace(/\/$/, '');
const CHIAVE = import.meta.env.PUBLIC_SUPABASE_ANON_KEY ?? '';
---
<dialog
  class="edf-mc"
  data-edf-contributo
  data-progetto={progetto}
  data-capitolo={capitolo}
  data-pulsante={pulsante ? '' : undefined}
  data-url={URL_DB}
  data-chiave={CHIAVE}
  aria-labelledby="edf-mc-t"
>
  <form method="dialog" class="edf-mc-f" novalidate data-edf-mc-form>
    <div class="edf-mc-testa">
      <h2 id="edf-mc-t" class="edf-mc-t">Scriveteci una domanda o uno spunto</h2>
      <button type="button" class="edf-mc-x" data-edf-mc-chiudi aria-label="Chiudi">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke-linecap="round"/></svg>
      </button>
    </div>
    <p class="edf-mc-l">Il modulo è anonimo: non chiede nome né contatto. Per una risposta personale scriveteci per email o su WhatsApp, da «Parliamone».</p>

    <div data-edf-mc-campi>
      <label class="edf-mc-c">
        <span class="edf-mc-e">Su quale parte</span>
        <input type="text" name="sezione" maxlength={LIMITI.sezione} autocomplete="off" />
      </label>
      <label class="edf-mc-c">
        <span class="edf-mc-e">La domanda o lo spunto</span>
        <textarea name="testo" rows="4" maxlength={LIMITI.testo} required></textarea>
      </label>
      <div class="edf-mc-due">
        <label class="edf-mc-c">
          <span class="edf-mc-e">Funzione <span class="edf-mc-fac">facoltativa</span></span>
          <span class="edf-mc-sel"><select name="funzione">
            <option value="">Preferisco non dirlo</option>
            {FUNZIONI.map((f) => <option value={f.k}>{f.l}</option>)}
          </select></span>
        </label>
        <label class="edf-mc-c">
          <span class="edf-mc-e">Livello <span class="edf-mc-fac">facoltativo</span></span>
          <span class="edf-mc-sel"><select name="livello">
            <option value="">Preferisco non dirlo</option>
            {LIVELLI.map((l) => <option value={l.k}>{l.l}</option>)}
          </select></span>
        </label>
      </div>
      <label class="edf-mc-ok">
        <input type="checkbox" name="ok" />
        <span>Potete usarlo nel riepilogo per la banca. <span class="edf-mc-fac">Il riepilogo mette insieme domande e spunti per funzione, senza nomi; il livello compare solo nei totali.</span></span>
      </label>
      <p class="edf-mc-err" data-edf-mc-err role="alert" hidden></p>
      <div class="edf-mc-az">
        <button type="button" class="edf-mc-b edf-mc-b--2" data-edf-mc-chiudi>Annulla</button>
        <button type="submit" class="edf-mc-b" data-edf-mc-invia>Invia</button>
      </div>
    </div>

    <div class="edf-mc-fatto" data-edf-mc-fatto hidden>
      <p class="edf-mc-t2">Ricevuto, grazie.</p>
      <p class="edf-mc-l">Lo leggiamo noi, nel team Adobe dell'account. Se volete una risposta diretta, scriveteci per email o su WhatsApp.</p>
      <div class="edf-mc-az">
        <button type="button" class="edf-mc-b edf-mc-b--2" data-edf-mc-altro>Scrivine un altro</button>
        <button type="button" class="edf-mc-b" data-edf-mc-chiudi>Chiudi</button>
      </div>
    </div>
  </form>
</dialog>

<script>
  import { rigaContributo, sezioneDa } from '../../utils/contributi';

  const dlg = () => document.querySelector<HTMLDialogElement>('dialog[data-edf-contributo]');

  // Un titolo bilingue (<T en it>) porta le due lingue nel DOM: si toglie quella
  // che non è attiva. Non si usa innerText, che dipende da che cosa è visibile in
  // quell'istante: con l'animazione d'ingresso ancora in corso restituisce «».
  function testoNellaLingua(el: HTMLElement): string {
    const lingua = document.documentElement.dataset.lang ?? document.documentElement.lang ?? 'it';
    const c = el.cloneNode(true) as HTMLElement;
    c.querySelectorAll<HTMLElement>('*').forEach((x) => {
      const altra = Object.keys(x.dataset).some((k) => /^lang[A-Z][a-z]$/.test(k) && k.slice(4).toLowerCase() !== lingua);
      if (altra) x.remove();
    });
    return c.textContent ?? '';
  }

  function sezioneAttiva(d: HTMLDialogElement): string {
    const cap = d.dataset.capitolo ?? '';
    const s = document.querySelector<HTMLElement>('[data-deck] [data-slide]:not([aria-hidden])');
    const h = s?.querySelector<HTMLElement>('h1, h2, h3');
    return sezioneDa(cap, h ? testoNellaLingua(h) : '');
  }

  function apri(sezione?: string, funzione?: string) {
    const d = dlg();
    if (!d) return;
    const f = d.querySelector<HTMLFormElement>('[data-edf-mc-form]')!;
    stato(d, 'campi');
    (f.elements.namedItem('sezione') as HTMLInputElement).value = sezione ?? sezioneAttiva(d);
    // Da una card per funzione la funzione arriva già scelta (si può cambiare).
    if (funzione) (f.elements.namedItem('funzione') as HTMLSelectElement).value = funzione;
    d.showModal();
    (f.elements.namedItem('testo') as HTMLTextAreaElement).focus();
  }

  function stato(d: HTMLDialogElement, s: 'campi' | 'fatto') {
    d.querySelector<HTMLElement>('[data-edf-mc-campi]')!.hidden = s !== 'campi';
    d.querySelector<HTMLElement>('[data-edf-mc-fatto]')!.hidden = s !== 'fatto';
    errore(d, '');
  }

  function errore(d: HTMLDialogElement, msg: string) {
    const e = d.querySelector<HTMLElement>('[data-edf-mc-err]')!;
    e.textContent = msg;
    e.hidden = !msg;
  }

  async function invia(d: HTMLDialogElement) {
    const f = d.querySelector<HTMLFormElement>('[data-edf-mc-form]')!;
    const v = (n: string) => (f.elements.namedItem(n) as HTMLInputElement).value;
    const esito = rigaContributo(d.dataset.progetto ?? '', {
      sezione: v('sezione'), testo: v('testo'), funzione: v('funzione'), livello: v('livello'),
      okRiepilogo: (f.elements.namedItem('ok') as HTMLInputElement).checked,
    });
    if (!esito.ok) { errore(d, esito.errore); return; }
    const url = d.dataset.url, chiave = d.dataset.chiave;
    if (!url || !chiave) { errore(d, 'Il modulo non è collegato. Scriveteci per email, da «Parliamone».'); return; }
    const b = d.querySelector<HTMLButtonElement>('[data-edf-mc-invia]')!;
    b.disabled = true;
    try {
      const r = await fetch(`${url}/rest/v1/contributi`, {
        method: 'POST', credentials: 'omit', referrerPolicy: 'no-referrer',
        headers: { apikey: chiave, Authorization: `Bearer ${chiave}`, 'Content-Type': 'application/json', Prefer: 'return=minimal' },
        body: JSON.stringify(esito.riga),
      });
      if (!r.ok) throw new Error(String(r.status));
      // Il reset svuota anche la sezione: «Scrivine un altro» la ritrova da qui.
      d.dataset.ultimaSezione = v('sezione');
      f.reset();
      stato(d, 'fatto');
    } catch {
      errore(d, 'Non è partito. Riprovate fra poco, o scriveteci per email da «Parliamone».');
    } finally {
      b.disabled = false;
    }
  }

  function posaPulsante() {
    const d = dlg();
    if (!d || !('pulsante' in d.dataset)) return;
    const barra = document.querySelector<HTMLElement>('[data-deck] [data-deck-controls]');
    if (!barra || barra.querySelector('.edf-mc-chiedi')) return;
    const b = document.createElement('button');
    b.type = 'button';
    b.className = 'deck-btn edf-mc-chiedi';
    b.setAttribute('data-contributo-apri', '');
    b.setAttribute('aria-label', 'Fateci una domanda su questa parte: il modulo è anonimo');
    b.innerHTML = '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 5.5h16v10.5H10l-4.5 3.5V16H4z" stroke-linejoin="round"/><path d="M8.5 9.5h7M8.5 12.5h4.5" stroke-linecap="round"/></svg><span class="edf-mc-chiedi-l">Fateci una domanda</span>';
    barra.appendChild(b);
    seguiSlide(b);
  }

  // Le slide dove una domanda non ha oggetto: la copertina di ogni capitolo, la
  // firma di chiusura, e quelle che lo dichiarano.
  const SENZA_DOMANDA = '#slide-cover, #slide-firma, [data-senza-domanda]';

  function seguiSlide(b: HTMLButtonElement) {
    const aggiorna = () => {
      const s = document.querySelector<HTMLElement>('[data-deck] [data-slide]:not([aria-hidden])');
      const spento = !s || s.matches(SENZA_DOMANDA);
      if (b.hasAttribute('data-spento') === spento) return;
      b.toggleAttribute('data-spento', spento);
      b.tabIndex = spento ? -1 : 0;
    };
    aggiorna();
    // Il deck cambia slide togliendo aria-hidden a quella attiva: si ascolta
    // quello, e SOLO sulle slide. ⚠️ Osservare tutto il sottoalbero reagendo
    // anche al pulsante, che cambia i propri attributi, è un ciclo infinito.
    const deck = document.querySelector('[data-deck]');
    if (deck) new MutationObserver((m) => {
      if (m.some((x) => (x.target as Element).hasAttribute?.('data-slide'))) aggiorna();
    }).observe(deck, { subtree: true, attributes: true, attributeFilter: ['aria-hidden'] });
  }

  function collega() {
    const d = dlg();
    if (!d || d.dataset.collegato) return;
    d.dataset.collegato = '1';
    // Dentro il modulo la tastiera è del modulo: senza, lo spazio e le frecce
    // nel testo farebbero avanzare il deck (che ascolta su window).
    d.addEventListener('keydown', (e) => { if (e.key !== 'Escape') e.stopPropagation(); });
    d.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      if (t === d || t.closest('[data-edf-mc-chiudi]')) d.close();
      if (t.closest('[data-edf-mc-altro]')) {
        stato(d, 'campi');
        (d.querySelector('[name="sezione"]') as HTMLInputElement).value = d.dataset.ultimaSezione ?? '';
        (d.querySelector('[name="testo"]') as HTMLTextAreaElement).focus();
      }
    });
    d.querySelector('[data-edf-mc-form]')!.addEventListener('submit', (e) => { e.preventDefault(); invia(d); });
    posaPulsante();
  }

  document.addEventListener('click', (e) => {
    const a = (e.target as HTMLElement).closest<HTMLElement>('[data-contributo-apri]');
    if (!a) return;
    e.preventDefault();
    apri(a.dataset.sezione, a.dataset.funzione);
  });
  collega();
  document.addEventListener('astro:page-load', collega);
</script>

<style is:global>
  .edf-mc {
    /* Il reset di Tailwind azzera il margine di <dialog>: lo si rimette al centro. */
    position: fixed; inset: 0; margin: auto; height: fit-content;
    width: min(40rem, calc(100vw - 2rem));
    max-height: calc(100dvh - 2rem);
    padding: 0;
    border: 1px solid var(--line-default, currentColor);
    border-radius: 14px;
    background: var(--surface-primary, Canvas);
    color: var(--ink-primary, CanvasText);
    font-family: var(--font-body, system-ui);
    overflow: auto;
  }
  .edf-mc::backdrop { background: color-mix(in srgb, var(--surface-inverse, CanvasText) 62%, transparent); }
  .edf-mc-f { padding: clamp(1.25rem, 3vw, 2rem); padding-bottom: 0; display: grid; gap: 1rem; }
  .edf-mc-testa { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; }
  .edf-mc-t { font-family: var(--font-display, inherit); font-size: clamp(1.35rem, 2vw, 1.6rem); line-height: 1.2; margin: 0; }
  .edf-mc-t2 { font-family: var(--font-display, inherit); font-size: 1.4rem; margin: 0; }
  .edf-mc-l { margin: 0; font-size: 1rem; line-height: 1.5; color: var(--ink-secondary, inherit); }
  .edf-mc-x { background: none; border: 0; color: inherit; padding: 0.6rem; margin: -0.6rem -0.6rem 0 0; cursor: pointer; min-width: 44px; min-height: 44px; }
  [data-edf-mc-campi] { display: grid; gap: 1rem; }
  .edf-mc-c { display: grid; gap: 0.35rem; }
  .edf-mc-e { font-size: 0.95rem; font-weight: 600; }
  .edf-mc-fac { font-weight: 400; color: var(--ink-tertiary, inherit); }
  .edf-mc ::selection { background: color-mix(in srgb, var(--accent-primary, Highlight) 28%, transparent); }
  .edf-mc input[type='text'], .edf-mc textarea, .edf-mc select {
    font: inherit; font-size: 1rem; color: inherit;
    background: var(--surface-secondary, transparent);
    border: 1px solid var(--line-default, currentColor);
    border-radius: 8px; padding: 0.65rem 0.75rem; min-height: 44px; width: 100%;
  }
  .edf-mc input[type='text'], .edf-mc textarea { caret-color: var(--accent-primary, auto); }
  .edf-mc textarea { resize: vertical; min-height: 6.5rem; line-height: 1.5; }
  /* La tendina: freccia nostra, con il suo margine. Quella di sistema stava a
     ridosso del bordo e cambiava da un browser all'altro. */
  .edf-mc-sel { position: relative; display: block; }
  .edf-mc .edf-mc-sel select { appearance: none; -webkit-appearance: none; padding-right: 2.75rem; cursor: pointer; text-overflow: ellipsis; }
  .edf-mc-sel::after {
    content: ''; position: absolute; right: 1.1rem; top: 50%; width: 0.55rem; height: 0.55rem; pointer-events: none;
    border-right: 1.8px solid currentColor; border-bottom: 1.8px solid currentColor;
    transform: translateY(-70%) rotate(45deg); opacity: 0.7;
  }
  .edf-mc :focus-visible { outline: 2px solid var(--accent-primary, Highlight); outline-offset: 2px; }
  .edf-mc-due { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); }
  .edf-mc-ok { display: grid; grid-template-columns: auto 1fr; gap: 0.6rem; align-items: start; font-size: 0.95rem; line-height: 1.45; }
  .edf-mc-ok input { width: 1.25rem; height: 1.25rem; margin-top: 0.1rem; accent-color: var(--accent-primary, auto); }
  .edf-mc-ok .edf-mc-fac { display: block; margin-top: 0.2rem; }
  .edf-mc-err { margin: 0; color: var(--ink-accent, inherit); font-weight: 600; }
  /* I pulsanti restano a vista anche su uno schermo basso: la barra si incolla
     in fondo al modulo, che è lui a scorrere. */
  .edf-mc-az {
    display: flex; justify-content: flex-end; gap: 0.75rem; flex-wrap: wrap;
    position: sticky; bottom: 0; z-index: 1;
    margin: 0 calc(-1 * clamp(1.25rem, 3vw, 2rem));
    padding: 0.9rem clamp(1.25rem, 3vw, 2rem) clamp(1.25rem, 3vw, 2rem);
    background: var(--surface-primary, Canvas);
    border-top: 1px solid var(--line-subtle, transparent);
  }
  [data-edf-mc-fatto] { display: grid; gap: 1rem; }
  [data-edf-mc-fatto][hidden] { display: none; }
  .edf-mc-b {
    font: inherit; font-weight: 600; cursor: pointer; min-height: 44px; padding: 0.6rem 1.3rem; border-radius: 999px;
    background: var(--accent-primary, CanvasText); color: var(--color-on-accent, Canvas); border: 1px solid transparent;
  }
  .edf-mc-b--2 { background: transparent; color: inherit; border-color: var(--line-strong, currentColor); }
  .edf-mc-b:disabled { opacity: 0.55; cursor: progress; }

  /* «Fateci una domanda» nella barra del deck. È l'unico comando della barra
     che resta quando il resto si dissolve: chi legge da solo non deve cercarlo.
     Pieno nel colore d'accento, ma piccolo e fermo: niente pulsazioni. */
  /* Due attributi in più nel selettore: i temi scuri delle app riscrivono
     `[data-deck][data-on-dark] .deck-btn`, e lo spegnerebbero nel grigio della barra. */
  [data-deck] [data-deck-controls] .deck-btn.edf-mc-chiedi {
    width: auto; gap: 0.55rem; padding: 0 1.1rem 0 0.95rem; border-radius: 999px;
    display: inline-flex; align-items: center; margin-left: 0.25rem;
    background: var(--accent-primary, CanvasText); color: var(--color-on-accent, Canvas);
    border: 1px solid transparent; opacity: 1;
    box-shadow: 0 6px 18px -8px color-mix(in srgb, var(--surface-inverse, #000) 70%, transparent);
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.3s ease, visibility 0.3s, filter 0.2s ease;
  }
  [data-deck] [data-deck-controls] .deck-btn.edf-mc-chiedi:hover {
    color: var(--color-on-accent, Canvas); border-color: transparent; filter: brightness(1.1); transform: translateY(-1px);
  }
  [data-deck] [data-deck-controls] .deck-btn.edf-mc-chiedi:focus-visible { outline: 2px solid var(--color-on-accent, Canvas); outline-offset: 3px; }
  [data-deck] [data-deck-controls] .deck-btn.edf-mc-chiedi[data-spento] { visibility: hidden; opacity: 0; transform: translateY(4px); }
  /* L'icona non si stringe: in un pulsante flex con l'etichetta lunga finiva a 6 px. */
  [data-deck] .deck-btn.edf-mc-chiedi svg { flex: none; width: 20px; height: 20px; }
  .edf-mc-chiedi-l { font-size: 0.95rem; font-weight: 600; letter-spacing: 0.01em; white-space: nowrap; }
  /* Barra a riposo: si dissolve tutto tranne la domanda. */
  [data-deck].deck-idle .deck-chrome:has(.edf-mc-chiedi) { opacity: 1; }
  [data-deck] [data-deck-controls]:has(.edf-mc-chiedi) > :not(.edf-mc-chiedi) { transition: opacity 0.3s ease; }
  /* `!important` perché il deck scrive l'opacità della freccia indietro in linea. */
  [data-deck].deck-idle:not(.deck-first-visit) [data-deck-controls]:has(.edf-mc-chiedi) > :not(.edf-mc-chiedi) { opacity: 0 !important; }
  @media (max-width: 899px) {
    .edf-mc-chiedi-l { display: none; }
    [data-deck] [data-deck-controls] .deck-btn.edf-mc-chiedi { padding: 0; width: 2.75rem; justify-content: center; }
  }
  @media (prefers-reduced-motion: reduce) { [data-deck] [data-deck-controls] .deck-btn.edf-mc-chiedi { transition: none; } }
  @media print { .edf-mc, .edf-mc-chiedi { display: none !important; } }
</style>
