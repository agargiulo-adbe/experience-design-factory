---
/**
 * DeckTelemetry — il deck misura se stesso, in modo anonimo.
 * Montato UNA volta nel BaseLayout dell'app che opta. Ascolta `deck:change`,
 * misura quanto una slide è rimasta attiva e scrive una riga per attivazione
 * su Supabase (`deck_events`, anon insert-only). Niente cookie, niente dati
 * personali: session id casuale per scheda in sessionStorage.
 * Si spegne con `?telemetry=0` o `localStorage['edf:telemetry']='off'`;
 * `?telemetry=mock` non scrive (serve all'audit e alle prove).
 */
interface Props { project: string; url: string; anonKey: string }
const { project, url, anonKey } = Astro.props as Props;
---
<div data-edf-telemetry data-project={project} data-url={url} data-key={anonKey} hidden aria-hidden="true"></div>

<script>
  import { buildEvent, makeSessionId, trackingMode } from './telemetry';

  const el = document.querySelector<HTMLElement>('[data-edf-telemetry]');
  const w = window as Window & { __edfTelemetryBound?: boolean };
  if (el && !w.__edfTelemetryBound) {
    w.__edfTelemetryBound = true;
    const project = el.dataset.project || '';
    const endpoint = (el.dataset.url || '').replace(/\/$/, '') + '/rest/v1/deck_events';
    const key = el.dataset.key || '';
    let stored: string | null = null;
    try { stored = localStorage.getItem('edf:telemetry'); } catch { /* storage bloccato */ }
    const mode = trackingMode(location.search, stored);

    let sessionId = '';
    try { sessionId = sessionStorage.getItem('edf:telemetry:sid') || ''; } catch { /* ignore */ }
    if (!sessionId) { sessionId = makeSessionId(); try { sessionStorage.setItem('edf:telemetry:sid', sessionId); } catch { /* ignore */ } }

    let current: { id: string; index: number; since: number; pathname: string } | null = null;

    // On the first full load the deck has already booted (window.__edfDeck) and fired its
    // initial `deck:change` before this script attached its listener — seed `current` from
    // the deck's own public state so the cover slide's dwell isn't silently dropped. A
    // later `deck:change` (real navigation) always overwrites `current` via the handler
    // below, so this only ever fills the gap before the first transition.
    const seed = () => {
      if (current) return;
      const d = (window as Window & { __edfDeck?: { index: number; slides: HTMLElement[] } }).__edfDeck;
      const s = d?.slides?.[d.index];
      if (d && s) current = { id: s.id || 'slide-' + d.index, index: d.index, since: performance.now(), pathname: location.pathname };
    };

    // Il taglio vive nell'URL solo finché non si cambia sezione: la navigazione SPA
    // perde il `?s=`, ma il runtime del gating lo tiene appuntato alla scheda. Senza
    // questo ripiego ogni riga dopo la prima sezione sarebbe marcata 'full'.
    const searchForCut = () => {
      if (new URLSearchParams(location.search).has('s')) return location.search;
      try {
        const pinned = sessionStorage.getItem('edf-solutions-' + project + ':link');
        if (pinned) { const ids = JSON.parse(pinned); if (Array.isArray(ids) && ids.length) return '?s=' + ids.join(','); }
      } catch { /* storage bloccato */ }
      return '';
    };

    const send = (dwellMs: number) => {
      if (!current || mode !== 'on' || !key || !endpoint.startsWith('https://')) return;
      const lang = document.documentElement.getAttribute('data-lang') || 'en';
      const ev = buildEvent({ project, pathname: current.pathname, search: searchForCut(), slideId: current.id, slideIndex: current.index, lang, sessionId, dwellMs });
      try {
        fetch(endpoint, {
          method: 'POST', keepalive: true,
          headers: { 'Content-Type': 'application/json', apikey: key, Authorization: 'Bearer ' + key, Prefer: 'return=minimal' },
          body: JSON.stringify(ev),
        }).catch(() => { /* la telemetria non deve mai rompere il deck */ });
      } catch { /* ignore */ }
    };

    // `flush`: mid-page visibility change — send and keep measuring the same slide.
    const flush = () => { if (current) { send(performance.now() - current.since); current = { ...current, since: performance.now() }; } };
    // `end`: leaving the page (SPA swap or real unload) — send and drop `current`, so a
    // stale slide from the OLD page can never be attributed to the NEW page's route.
    const end = () => { if (current) { send(performance.now() - current.since); current = null; } };

    document.addEventListener('deck:change', (e: Event) => {
      const d = (e as CustomEvent).detail as { index: number; id: string };
      if (current) send(performance.now() - current.since);
      current = { id: d.id || 'slide-' + d.index, index: d.index, since: performance.now(), pathname: location.pathname };
    });
    document.addEventListener('visibilitychange', () => { if (document.visibilityState === 'hidden') flush(); });
    window.addEventListener('pagehide', end);
    document.addEventListener('astro:before-swap', end);

    // Seed now (deck may have already booted on this full load) and again after every
    // SPA swap (astro:page-load), in case the new page's deck boots before deck:change
    // reaches this still-bound listener.
    seed();
    document.addEventListener('astro:page-load', seed);
  }
</script>
