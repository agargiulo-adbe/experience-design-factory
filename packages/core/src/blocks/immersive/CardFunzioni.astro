---
/**
 * Le card per funzione — l'edizione da distribuire (spec
 * 2026-11-20-funzioni-e-domande). Un indice filtrato, non un percorso: per ogni
 * funzione una riga e tre o quattro slide che esistono già.
 *
 * FORMA (rifatta il 20 nov 2026 con /impeccable, dopo il giudizio dell'owner sulla
 * prima versione: una pagina bianca da documentazione appoggiata sul deck, sette
 * schede uguali piene di titoli sottolineati). Ora è una SCENA del deck: a tutto
 * schermo, sul fondo delle slide; a sinistra le funzioni come voci da scegliere
 * una alla volta, a destra la funzione scelta con la sua riga in grande e il
 * PERCORSO: le tappe in fila su un filo numerato, ognuna con la MINIATURA vera
 * della slide (scripts/funzioni-miniature.ts), il capitolo e il titolo. Un solo
 * movimento: cambiando funzione il filo si ridisegna e le tappe entrano in fila.
 *
 * Colori e fondo dai token `--cf-*` dell'app (nel motore niente palette):
 *   --cf-bg --cf-ink --cf-ink-2 --cf-ink-3 --cf-accent --cf-accent-2
 *   --cf-line --cf-scelta-bg --cf-cta --cf-on-cta --cf-on-accent
 *
 * Come si apre: `[data-funzioni-apri]` (la riga in copertina) e «Per funzione»
 * nella barra dei comandi, che il componente posa da sé. Le tappe portano
 * `?f=<funzione>`: su quella pagina il pulsante prende il nome della funzione e
 * il pannello si apre su di lei, con la tappa corrente segnata. Nessuna memoria
 * nel browser, nessuna chiamata di rete. Con `conModulo` (versione B) c'è
 * «Fateci una domanda», che apre il modulo con la funzione già scelta.
 * Il pulsante della barra nasce da JS: i suoi stili stanno in `is:global`.
 */
import { FUNZIONI } from '../../utils/contributi';

export interface TappaFunzione { href: string; t: string; cap?: string; img?: string }
export interface CardFunzione { k: string; riga: string; tappe: TappaFunzione[] }
interface Props {
  funzioni: CardFunzione[];
  /** `import.meta.env.BASE_URL` dell'app */
  base: string;
  conModulo?: boolean;
}
const { funzioni, base, conModulo = false } = Astro.props;
const radice = base.replace(/\/?$/, '/');
const etichetta = (k: string) => FUNZIONI.find((f) => f.k === k)?.l ?? k;
// 'messa-a-terra/#slide-chiave' → '<base>messa-a-terra/?f=dati#slide-chiave'
const link = (h: string, k: string) => {
  const [pagina, ancora = ''] = h.split('#');
  return `${radice}${pagina}?f=${k}${ancora ? '#' + ancora : ''}`;
};
const ETICHETTE = Object.fromEntries(funzioni.map((f) => [f.k, etichetta(f.k)]));
---
<dialog class="edf-cf" data-edf-funzioni data-etichette={JSON.stringify(ETICHETTE)} aria-labelledby="edf-cf-t">
  <div class="edf-cf-in">
    <header class="edf-cf-testa">
      <div class="edf-cf-testa-t">
        <h2 id="edf-cf-t" class="edf-cf-t">Da dove partire</h2>
        <p class="edf-cf-l">Scegliete il vostro lavoro: vi portiamo alle pagine che contano. La storia intera resta a un clic.</p>
      </div>
      <button type="button" class="edf-cf-x" data-edf-cf-chiudi aria-label="Chiudi">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
      </button>
    </header>

    <div class="edf-cf-corpo">
      <div class="edf-cf-elenco" role="tablist" aria-orientation="vertical" aria-label="Funzioni">
        {funzioni.map((f, i) => (
          <button type="button" class="edf-cf-voce" role="tab" id={`edf-cf-tab-${f.k}`} aria-controls={`edf-cf-pan-${f.k}`}
                  aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-k={f.k}>
            <span class="edf-cf-voce-n">{etichetta(f.k)}</span>
          </button>
        ))}
      </div>

      {funzioni.map((f, i) => (
        <section class="edf-cf-c" role="tabpanel" id={`edf-cf-pan-${f.k}`} aria-labelledby={`edf-cf-tab-${f.k}`} data-k={f.k} hidden={i !== 0}>
          <p class="edf-cf-riga">{f.riga}</p>
          <ol class="edf-cf-percorso" style={`--n:${f.tappe.length}`}>
            {f.tappe.map((t, j) => (
              <li class="edf-cf-tappa" style={`--i:${j}`}>
                <a class="edf-cf-a" href={link(t.href, f.k)} data-tappa={t.href}>
                  <span class="edf-cf-num" aria-hidden="true">{j + 1}</span>
                  <span class="edf-cf-img">
                    {t.img && <img src={`${radice}${t.img}`} alt="" loading="lazy" decoding="async" width="640" height="372" />}
                    <span class="edf-cf-qui">Sei qui</span>
                  </span>
                  {t.cap && <span class="edf-cf-cap">{t.cap}</span>}
                  <span class="edf-cf-tt">{t.t}</span>
                </a>
              </li>
            ))}
          </ol>
          <div class="edf-cf-az">
            <a class="edf-cf-via" href={link(f.tappe[0].href, f.k)}>Inizia dalla prima tappa<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h9M8.5 4 12.5 8l-4 4" /></svg></a>
            {conModulo && (
              <button type="button" class="edf-cf-chiedi" data-contributo-apri data-funzione={f.k} data-sezione={`Per funzione · ${etichetta(f.k)}`} data-edf-cf-chiudi>Fateci una domanda</button>
            )}
          </div>
        </section>
      ))}
    </div>
  </div>
</dialog>

<script>
  const dlg = () => document.querySelector<HTMLDialogElement>('dialog[data-edf-funzioni]');
  const etichette = (d: HTMLDialogElement): Record<string, string> => JSON.parse(d.dataset.etichette ?? '{}');
  const scelta = (d: HTMLDialogElement) => {
    const f = new URLSearchParams(location.search).get('f') ?? '';
    return f in etichette(d) ? f : '';
  };
  // L'ultima funzione guardata in QUESTA pagina (solo memoria della pagina, niente storage).
  let ultima = '';

  function mostra(d: HTMLDialogElement, k: string, fuoco = false) {
    d.querySelectorAll<HTMLButtonElement>('.edf-cf-voce').forEach((b) => {
      const on = b.dataset.k === k;
      b.setAttribute('aria-selected', String(on));
      b.tabIndex = on ? 0 : -1;
      if (on && fuoco) b.focus();
    });
    d.querySelectorAll<HTMLElement>('.edf-cf-c').forEach((c) => {
      const on = c.dataset.k === k;
      c.hidden = !on;
      // Il filo e le tappe ripartono a ogni scelta: è l'unico movimento della scena.
      if (on) { c.removeAttribute('data-entra'); void c.offsetWidth; c.setAttribute('data-entra', ''); }
    });
    ultima = k;
  }

  function apri() {
    const d = dlg();
    if (!d) return;
    const qui = location.pathname.replace(/\/?$/, '/');
    const slide = document.querySelector<HTMLElement>('[data-deck] [data-slide]:not([aria-hidden])')?.id ?? '';
    d.querySelectorAll<HTMLAnchorElement>('.edf-cf-a').forEach((a) => {
      const u = new URL(a.href);
      if (u.pathname === qui && u.hash.slice(1) === slide) a.setAttribute('aria-current', 'step'); else a.removeAttribute('aria-current');
    });
    const primo = d.querySelector<HTMLElement>('.edf-cf-voce')?.dataset.k ?? '';
    d.showModal();
    mostra(d, scelta(d) || ultima || primo, true);
  }

  function posaPulsante() {
    const d = dlg();
    const barra = document.querySelector<HTMLElement>('[data-deck] [data-deck-controls]');
    if (!d || !barra || barra.querySelector('.edf-cf-btn')) return;
    const f = scelta(d);
    const b = document.createElement('button');
    b.type = 'button';
    b.className = 'deck-btn edf-cf-btn';
    b.setAttribute('data-funzioni-apri', '');
    const nome = f ? etichette(d)[f] : 'Per funzione';
    b.setAttribute('aria-label', f ? `${nome}: le tappe della vostra funzione` : 'Per funzione: da dove partire');
    b.innerHTML = '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="4" y="4" width="7" height="7" rx="1.5"/><rect x="13" y="4" width="7" height="7" rx="1.5"/><rect x="4" y="13" width="7" height="7" rx="1.5"/><rect x="13" y="13" width="7" height="7" rx="1.5"/></svg><span class="edf-cf-btn-l"></span>';
    b.querySelector('.edf-cf-btn-l')!.textContent = nome;
    if (f) b.setAttribute('data-scelta', '');
    const chiedi = barra.querySelector('.edf-mc-chiedi');
    if (chiedi) barra.insertBefore(b, chiedi); else barra.appendChild(b);
  }

  function collega() {
    const d = dlg();
    if (!d) return;
    if (!d.dataset.collegato) {
      d.dataset.collegato = '1';
      d.addEventListener('keydown', (e) => {
        // Frecce su e giù fra le funzioni, come una lista di schede; la tastiera
        // resta nel pannello, così il deck dietro non si muove.
        const voce = (e.target as HTMLElement).closest<HTMLButtonElement>('.edf-cf-voce');
        if (voce && (e.key === 'ArrowDown' || e.key === 'ArrowUp' || e.key === 'Home' || e.key === 'End')) {
          const voci = [...d.querySelectorAll<HTMLButtonElement>('.edf-cf-voce')];
          const i = voci.indexOf(voce);
          const j = e.key === 'Home' ? 0 : e.key === 'End' ? voci.length - 1 : (i + (e.key === 'ArrowDown' ? 1 : -1) + voci.length) % voci.length;
          mostra(d, voci[j].dataset.k!, true);
          e.preventDefault();
        }
        if (e.key !== 'Escape') e.stopPropagation();
      });
      d.addEventListener('click', (e) => {
        const t = e.target as HTMLElement;
        const voce = t.closest<HTMLButtonElement>('.edf-cf-voce');
        if (voce) { mostra(d, voce.dataset.k!); return; }
        if (t === d || t.closest('[data-edf-cf-chiudi]') || t.closest('.edf-cf-a, .edf-cf-via')) d.close();
      });
    }
    posaPulsante();
  }

  document.addEventListener('click', (e) => {
    const a = (e.target as HTMLElement).closest<HTMLElement>('[data-funzioni-apri]');
    if (!a) return;
    e.preventDefault();
    apri();
  });
  // In un modulo i <script> partono una volta sola: il pulsante si ripresenta a
  // ogni cambio di pagina della navigazione SPA.
  collega();
  document.addEventListener('astro:page-load', collega);
</script>

<style is:global>
  /* ── La scena: a tutto schermo, sul fondo delle slide ─────────────────── */
  .edf-cf {
    --cf-ease: cubic-bezier(0.16, 1, 0.3, 1);
    position: fixed; inset: 0; margin: 0; padding: 0; border: 0;
    width: 100vw; max-width: none; height: 100dvh; max-height: none;
    background: var(--cf-bg, Canvas); color: var(--cf-ink, CanvasText);
    font-family: var(--font-body, system-ui); overflow: auto; overscroll-behavior: contain;
  }
  .edf-cf::backdrop { background: transparent; }
  .edf-cf[open] { animation: edf-cf-apre 0.38s var(--cf-ease) both; }
  @keyframes edf-cf-apre { from { opacity: 0; } to { opacity: 1; } }
  .edf-cf ::selection { background: var(--cf-accent, Highlight); color: var(--cf-on-cta, HighlightText); }

  .edf-cf-in {
    box-sizing: border-box; min-height: 100%; width: 100%; max-width: 116rem; margin: 0 auto;
    padding: clamp(1.4rem, 3.4vh, 3.4rem) clamp(1.25rem, 5.6vw, 6rem);
    display: grid; grid-template-rows: auto 1fr; gap: clamp(1.2rem, 3.6vh, 3.2rem);
  }
  .edf-cf-testa { display: flex; align-items: flex-start; justify-content: space-between; gap: 2rem; }
  .edf-cf-t {
    margin: 0; font-family: var(--font-display, inherit); font-weight: 700;
    font-size: clamp(2rem, 3.1vw, 4.2rem); line-height: 1.04; letter-spacing: -0.02em; color: var(--cf-ink, inherit);
  }
  .edf-cf-l { margin: 0.7rem 0 0; max-width: 52ch; font-size: clamp(1.02rem, 1.1vw, 1.5rem); line-height: 1.5; color: var(--cf-ink-2, inherit); }
  .edf-cf-x {
    flex: none; width: 3rem; height: 3rem; display: grid; place-items: center; cursor: pointer;
    border-radius: 999px; background: var(--cf-scelta-bg, transparent); color: var(--cf-ink, inherit);
    border: 1px solid var(--cf-line, currentColor); transition: border-color 0.2s ease, background-color 0.2s ease;
  }
  .edf-cf-x svg { width: 1.3rem; height: 1.3rem; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; }
  .edf-cf-x:hover { border-color: var(--cf-accent, currentColor); }

  /* ── Il corpo: le funzioni a sinistra, la funzione scelta a destra ────── */
  .edf-cf-corpo { display: grid; grid-template-columns: minmax(15rem, 21rem) minmax(0, 1fr); gap: clamp(1.6rem, 4vw, 5rem); align-items: start; }
  .edf-cf-elenco { display: grid; gap: 0.15rem; padding-right: clamp(1rem, 2vw, 2.4rem); border-right: 1px solid var(--cf-line, currentColor); }
  .edf-cf-voce {
    display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; width: 100%;
    min-height: 3.1rem; padding: 0.55rem 1rem; border-radius: 10px; cursor: pointer; text-align: left;
    font: inherit; background: transparent; color: var(--cf-ink-2, inherit); border: 1px solid transparent;
    transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }
  .edf-cf-voce-n { font-size: clamp(1.05rem, 1.12vw, 1.55rem); font-weight: 600; line-height: 1.2; }
  .edf-cf-voce-q { flex: none; font-size: clamp(0.78rem, 0.78vw, 1.1rem); font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--cf-ink-3, inherit); font-variant-numeric: tabular-nums; }
  .edf-cf-voce:hover { color: var(--cf-ink, inherit); }
  .edf-cf-voce[aria-selected='true'] { background: var(--cf-scelta-bg, transparent); border-color: var(--cf-accent-2, currentColor); color: var(--cf-ink, inherit); }
  .edf-cf-voce[aria-selected='true'] .edf-cf-voce-q { color: var(--cf-accent, inherit); }

  .edf-cf-c { min-width: 0; }
  .edf-cf-riga {
    margin: 0; max-width: 34ch; font-family: var(--font-display, inherit); font-weight: 600;
    font-size: clamp(1.45rem, 2vw, 2.8rem); line-height: 1.22; letter-spacing: -0.01em; color: var(--cf-ink, inherit); text-wrap: balance;
  }

  /* ── Il percorso: un filo numerato, una miniatura per tappa ─────────────── */
  .edf-cf-percorso {
    position: relative; list-style: none; margin: clamp(1.4rem, 3.6vh, 3rem) 0 0; padding: 0;
    display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: clamp(0.9rem, 1.6vw, 2rem);
  }
  /* Il filo passa dietro i numeri, dal primo all'ultimo. */
  .edf-cf-percorso::before {
    content: ''; position: absolute; top: 1rem; left: 1rem; height: 2px; background: var(--cf-accent-2, currentColor);
    width: calc((var(--n) - 1) / 4 * (100% + clamp(0.9rem, 1.6vw, 2rem)));
    transform-origin: 0 50%;
  }
  .edf-cf-a { display: grid; gap: 0.55rem; color: inherit; text-decoration: none; border-radius: 12px; }
  .edf-cf-num {
    position: relative; z-index: 1; width: 2rem; height: 2rem; display: grid; place-items: center; border-radius: 999px;
    background: var(--cf-bg, Canvas); border: 2px solid var(--cf-accent-2, currentColor);
    font-size: 0.95rem; font-weight: 700; color: var(--cf-ink, inherit); font-variant-numeric: tabular-nums;
    transition: background-color 0.2s ease, color 0.2s ease;
  }
  .edf-cf-img {
    position: relative; display: block; margin-top: 0.35rem; aspect-ratio: 1440 / 836; overflow: hidden; border-radius: 10px;
    background: var(--cf-scelta-bg, transparent); border: 1px solid var(--cf-line, currentColor);
    box-shadow: 0 1.1rem 2.2rem -1.4rem rgb(0 0 0 / 0.75);
    transition: transform 0.35s var(--cf-ease), border-color 0.25s ease;
  }
  .edf-cf-img img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .edf-cf-qui {
    position: absolute; left: 0.6rem; top: 0.6rem; padding: 0.2rem 0.55rem; border-radius: 999px;
    background: var(--cf-cta, Highlight); color: var(--cf-on-cta, HighlightText);
    font-size: 0.78rem; font-weight: 700; letter-spacing: 0.04em; display: none;
  }
  .edf-cf-cap { font-size: clamp(0.74rem, 0.74vw, 1.05rem); font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--cf-accent, inherit); }
  .edf-cf-tt { font-size: clamp(0.98rem, 1vw, 1.4rem); font-weight: 600; line-height: 1.32; color: var(--cf-ink, inherit); text-wrap: pretty; }
  .edf-cf-a:hover .edf-cf-img, .edf-cf-a:focus-visible .edf-cf-img { transform: translateY(-4px); border-color: var(--cf-accent, currentColor); }
  .edf-cf-a:hover .edf-cf-num, .edf-cf-a:focus-visible .edf-cf-num { background: var(--cf-accent, currentColor); color: var(--cf-on-accent, Canvas); border-color: var(--cf-accent, currentColor); }
  .edf-cf-a[aria-current='step'] .edf-cf-qui { display: inline-block; }
  .edf-cf-a[aria-current='step'] .edf-cf-img { border-color: var(--cf-accent, currentColor); }
  .edf-cf-a[aria-current='step'] .edf-cf-num { background: var(--cf-accent, currentColor); color: var(--cf-on-accent, Canvas); border-color: var(--cf-accent, currentColor); }

  .edf-cf-az { display: flex; flex-wrap: wrap; align-items: center; gap: 0.8rem 1.4rem; margin-top: clamp(1.4rem, 3.4vh, 2.8rem); }
  .edf-cf-via {
    display: inline-flex; align-items: center; gap: 0.6rem; min-height: 48px; padding: 0.65rem 1.4rem 0.65rem 1.6rem; border-radius: 999px;
    background: var(--cf-cta, Highlight); color: var(--cf-on-cta, HighlightText); text-decoration: none;
    font-size: clamp(1rem, 0.95vw, 1.4rem); font-weight: 700; transition: transform 0.2s var(--cf-ease);
  }
  .edf-cf-via svg { width: 1.05em; height: 1.05em; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; transition: transform 0.22s var(--cf-ease); }
  .edf-cf-via:hover svg { transform: translateX(3px); }
  .edf-cf-chiedi {
    min-height: 48px; padding: 0.55rem 1.3rem; border-radius: 999px; cursor: pointer; font: inherit; font-weight: 600;
    font-size: clamp(0.98rem, 0.92vw, 1.35rem); background: transparent; color: var(--cf-ink, inherit); border: 1px solid var(--cf-line, currentColor);
  }
  .edf-cf-chiedi:hover { border-color: var(--cf-accent, currentColor); }
  .edf-cf :focus-visible { outline: 2px solid var(--cf-accent, Highlight); outline-offset: 3px; }

  /* ── L'unico movimento: il filo si stende, le tappe entrano in fila ─────── */
  .edf-cf-c[data-entra] .edf-cf-percorso::before { animation: edf-cf-filo 0.7s var(--cf-ease) both; }
  .edf-cf-c[data-entra] .edf-cf-tappa { animation: edf-cf-tappa 0.55s var(--cf-ease) both; animation-delay: calc(0.08s + var(--i) * 0.07s); }
  .edf-cf-c[data-entra] .edf-cf-riga { animation: edf-cf-riga 0.45s var(--cf-ease) both; }
  @keyframes edf-cf-filo { from { transform: scaleX(0); } to { transform: scaleX(1); } }
  @keyframes edf-cf-tappa { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }
  @keyframes edf-cf-riga { from { opacity: 0; } to { opacity: 1; } }

  /* ── Schermi bassi e stretti ────────────────────────────────────────────── */
  @media (max-height: 800px) {
    .edf-cf-in { padding-block: 1.2rem; gap: 1rem; }
    .edf-cf-l { margin-top: 0.4rem; }
    .edf-cf-voce { min-height: 2.75rem; padding-block: 0.4rem; }
    .edf-cf-percorso { margin-top: 1.1rem; }
    .edf-cf-az { margin-top: 1.1rem; }
  }
  @media (max-width: 960px) {
    .edf-cf-corpo { grid-template-columns: minmax(0, 1fr); }
    .edf-cf-elenco { display: flex; overflow-x: auto; gap: 0.4rem; padding: 0 0 0.8rem; border-right: 0; border-bottom: 1px solid var(--cf-line, currentColor); scrollbar-width: none; }
    .edf-cf-voce { width: auto; flex: none; }
    .edf-cf-percorso { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .edf-cf-percorso::before { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .edf-cf[open], .edf-cf-c[data-entra] .edf-cf-percorso::before, .edf-cf-c[data-entra] .edf-cf-tappa, .edf-cf-c[data-entra] .edf-cf-riga { animation: none; }
    .edf-cf-img, .edf-cf-via svg { transition: none; }
  }

  /* «Per funzione» nella barra del deck: eredita colore e auto-hide da `.deck-btn`. */
  [data-deck] .deck-btn.edf-cf-btn { width: auto; gap: 0.5rem; padding: 0 0.85rem; border-radius: 999px; display: inline-flex; align-items: center; }
  [data-deck] .deck-btn.edf-cf-btn svg { flex: none; width: 20px; height: 20px; }
  .edf-cf-btn-l { font-size: 0.95rem; white-space: nowrap; }
  @media (max-width: 899px) { .edf-cf-btn-l { display: none; } [data-deck] .deck-btn.edf-cf-btn { padding: 0; } }
  @media print { .edf-cf, .edf-cf-btn { display: none !important; } }
</style>
