# deck-audit screenshots (generated; only for failing slides)
audit/

# Tutto ciò che sta sotto docs/ è governato da **docs/.gitignore**, che è
# fail-closed: ignora tutto e riammette i soli documenti della Factory.
# Qui non si aggiungono più righe `docs/...`: prima del 12 ott 2026 erano un
# elenco a mano cliente per cliente, e ogni cliente nuovo nasceva esposto.
# Il gate è `pnpm audit:docs`.

# Local audit artifacts
.playwright-mcp/
/*.png

# Supabase CLI local temp
supabase/.temp/

# Deck audit + screenshot artifacts (local only)
apps/*/shots/
apps/*/audit/
apps/*/scripts/shots.mjs

# env varianti locali (es. .env_Isybank)
.env_*

# Clip Firefly generati: vanno sul GitHub Release `media`, mai nel repo (poster jpg sì)
apps/*/public/media/*.mp4
# Cartella di lavoro dei clip (sorgente + ricucita): nel repo non ci entra niente,
# sul Release ci va la sola clip ricucita. Il poster e il provenance stanno in
# public/media/ e sono tracciati.
apps/*/media/

# Impeccable — lo stato per-macchina non si versiona; le critique sì: la skill le
# rilegge (`/impeccable polish` ne prende i problemi prioritari) e servono da
# storico della qualità di ogni experience.
.impeccable/hook.cache.json
.impeccable/config.local.json

# Impeccable: binario del motore per piattaforma (12 MB, scaricato da `npx impeccable update`), mai nel repo
.claude/skills/impeccable/scripts/bin/
.github/skills/impeccable/scripts/bin/

# worktree temporanei dei sub-agent: non appartengono al repo
.claude/worktrees/
