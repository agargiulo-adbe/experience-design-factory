---
/**
 * Aperto — un punto che oggi non è confermato, scritto come DOMANDA.
 *
 * ⚠️ PERCHÉ UNA DOMANDA E NON UN’AFFERMAZIONE.
 * Questo documento va davanti all’IT di una banca che ha una gara aperta, e
 * tocca tre cose che oggi non sono confermate: una referenza di terzi, la
 * connettività verso la loro CDP, il modello di prezzo. Affermarle e sbagliare
 * costa la credibilità dell’intero documento — e sono cose che chi legge
 * verifica in dieci secondi, perché è il suo mestiere. Chiederle costa niente,
 * e in una riunione tecnica una domanda precisa vale più di una promessa vaga:
 * dice che abbiamo guardato davvero.
 *
 * Quindi non è un segnaposto da riempire prima della consegna: è contenuto.
 * Quello che invece va riempito prima della consegna è marcato `interno`, che
 * NON rende in pagina.
 */
import T from '@edf/core/blocks/i18n/T.astro';

interface Props {
  it: string; en: string;
  /** L’etichetta, se «Da verificare con voi» non è la cosa giusta da dire. */
  tagIt?: string; tagEn?: string;
  class?: string;
}
const { it, en, tagIt, tagEn, class: className } = Astro.props;
---
<p class:list={['bp-aperto', className]} data-substep data-side="in">
  <T as="span" class="bp-aperto-t" it={tagIt ?? 'Da verificare con voi'} en={tagEn ?? 'To check with you'} />
  <T as="span" class="bp-aperto-q" it={it} en={en} />
</p>
