---
/**
 * La copertina dell’incontro del 12 novembre.
 *
 * Due mestieri su una pagina: dire di che cosa si parla, e dire che cosa c’è
 * dentro. Nel `.pptx` il secondo lo fanno N slide «Agenda» ripetute fra un
 * capitolo e l’altro; qui l’indice sta in copertina, una volta sola, e si
 * clicca. È la forma XD, e vive nel motore.
 *
 * Il lockup co-brand `hero` sta sulla PRIMA e sull’ULTIMA slide del percorso
 * (qui e sulla slide-firma di `prossimi-passi`): regola del motore, e dove c’è
 * un hero la firma fissa si spegne da sola.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import CoBrand from '../components/CoBrand.astro';
import T from '@edf/core/blocks/i18n/T.astro';
import { href } from '@edf/core/utils/url.js';
import { EXPERIENCE_TYPES } from '@edf/core/data/experienceTypes';
import { SITE } from '../data/site';
import { CHAPTERS } from '../data/chapters';
import { CONTEGGIO } from '../data/condivisi';

const type = EXPERIENCE_TYPES[SITE.type];
const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;
const first = CHAPTERS[0];
const last = CHAPTERS[CHAPTERS.length - 1];
---
<BaseLayout title={SITE.name}>
  <div class="fixed top-0 left-0 right-0 z-50">
    <Navigation currentPath={currentPath} base={base} />
  </div>

  <DeckContainer nextHref={href(base, '/' + first.slug)} prevHref={href(base, '/' + last.slug)}>

    <Slide id="slide-cover" bg="inverse" align="left">
      <div slot="backdrop" class="xd-bg-piano"></div>

      <div class="xd-cop" data-reveal>
        <div class="xd-cop-sx">
          <CoBrand variant="hero" class="xd-cop-lockup ex-cobrand--on-dark" data-reveal />
          <T as="p" class="xd-cop-occ" it="Incontro del 12 novembre 2026, Milano" en="Meeting of 12 November 2026, Milan" data-reveal data-reveal-delay="0.06" />
          {/* ⚠️ Il titolo dice il PERIMETRO, e dice che rispettiamo l’esistente.
              È la prima obiezione di un IT con una gara aperta: «quanto mi
              costa in rifacimenti?». La risposta sta in copertina. */}
          <T as="h1" class="xd-cop-t" it="Sopra quello che avete" en="On top of what you have" data-reveal data-reveal-delay="0.1" />
          {/* ⚠️ IL CONTEGGIO VIENE DALLA FONTE UNICA, e non si riscrive qui.
              La riga diceva «e sei no» contando fra gli intoccati il
              gestionale, che è in gara, e la mappa due schermate dopo diceva
              un numero diverso. Cinque lettori su cinque hanno contato. */}
          <T as="p" class="xd-cop-l" it={CONTEGGIO.blocchi.it} en={CONTEGGIO.blocchi.en}
             data-reveal data-reveal-delay="0.16" />
          <T as="p" class="xd-cop-tipo" it={type.coverLine.it} en={type.coverLine.en} data-reveal data-reveal-delay="0.22" />
          {/* ⚠️ Riga formale chiesta da chi governa la gara e da chi la
              gestisce: un fornitore che in una stanza laterale lascia credere
              di «rispondere alla gara» crea un problema di parità di
              trattamento che poi deve spiegare il cliente. Dirlo in copertina
              costa una riga e toglie il problema dal tavolo. */}
          <T as="p" class="xd-cop-cred" data-reveal data-reveal-delay="0.25"
             it="Questo documento riguarda il perimetro marketing e non è una risposta alla richiesta d’offerta sul sistema di gestione clienti, di cui non tocca l’oggetto."
             en="This document covers the marketing scope and is not a response to the core-system tender, whose subject it does not touch." />
          {/* Il credito è un FATTO: qui nessun asset è generato, e scriverlo
              sarebbe una dichiarazione falsa. Si dice invece da dove viene lo
              schema, che è l’informazione che conta per chi legge.
              ⚠️ La riga diceva anche «nessuna immagine generata»: è vera, ed
              è stata tolta perché in quella stanza nessuno ha chiesto da
              dove vengono le immagini, e dichiararlo in copertina attira
              l'attenzione su una domanda che non si sarebbe fatta nessuno. */}
          <T as="p" class="xd-cop-cred" data-reveal data-reveal-delay="0.28"
             it="Lo schema dell’architettura è il vostro, condiviso il 26 ottobre."
             en="The architecture diagram is yours, shared on 26 October." />
        </div>

        <nav class="xd-cop-dx" data-reveal data-reveal-delay="0.2" aria-label="Il percorso">
          {/* ⚠️ QUESTA COLONNA È STATA RIBALTATA DOPO LA REVISIONE DEL 31 OTT.
              Prima annunciava «le sette risposte, più i passi» e apriva sul
              percorso intero: ventidue schermate a chi aveva chiesto sei
              slide. Quattro lettori su cinque hanno aperto il giudizio da
              lì, e il credito dell'incontro l'ha speso il referente che le
              sei slide le ha chieste. Ora la prima voce è quello che si
              proietta; il resto è dichiarato allegato, e si apre su richiesta. */}
          <T as="p" class="xd-cop-occ" it="In sala si proietta questo" en="In the room we project this" />
          <a href={href(base, '/dieci-minuti')} class="xd-cop-cap" data-principale>
            <span class="xd-cop-n">▸</span>
            <span class="xd-cop-tit"><span data-lang-it>In dieci minuti</span><span data-lang-en>In ten minutes</span></span>
          </a>
          <T as="p" class="xd-cop-l" style="font-size:clamp(0.86rem,0.72vw,1.5rem);max-width:34ch"
             it="Architettura · i moduli · la settimana di chi fa campagne · il dato · il costo · la richiesta."
             en="Architecture · the modules · a campaign manager’s week · the data · the cost · the ask." />

          <T as="p" class="xd-cop-occ" it="Il resto si apre se lo chiedete" en="The rest opens on request" />
          <ol class="xd-cop-indice" data-stagger>
            {CHAPTERS.map((c) => (
              <li>
                <a href={href(base, '/' + c.slug)} class="xd-cop-cap" data-futura>
                  <span class="xd-cop-n">{c.num}</span>
                  <span class="xd-cop-tit"><span data-lang-it>{(c.breve ?? c.title).it}</span><span data-lang-en>{(c.breve ?? c.title).en}</span></span>
                </a>
              </li>
            ))}
          </ol>
        </nav>
      </div>
    </Slide>

  </DeckContainer>
</BaseLayout>
