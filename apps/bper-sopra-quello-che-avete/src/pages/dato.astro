---
/**
 * 04 · Il dato resta dov’è.
 *
 * ⚠️ IL CAPITOLO DOVE LA VERIFICA HA CAMBIATO IL CONTENUTO.
 * La proposta di struttura del 26 ottobre diceva: «Integrazione con Oracle
 * CDP: come funziona senza duplicare il dato, es. connettori, Federated
 * Audience Composition». Trattato come ipotesi e verificato alla fonte il 31
 * ottobre 2026, l’esito è più sottile dell’ipotesi, e va detto in sala:
 *
 *   · Oracle È nell’elenco dei database supportati nella pagina delle
 *     connessioni e nelle FAQ di Federated Audience Composition;
 *   · Oracle NON compare nella pagina «Prerequisites and guardrails», che
 *     elenca sette warehouse e si ferma lì;
 *   · Oracle NON è nella tabella della CONNETTIVITÀ PRIVATA (PrivateLink e
 *     VPN site-to-site), che per una banca di norma non è un dettaglio.
 *
 * Tre pagine ufficiali che non concordano: la regola dice di riportare il
 * conflitto e chiedere, non di sceglierne una in silenzio. E c’è una domanda
 * che viene prima: lo schema nomina «CDP ORACLE» senza dire se sia un data
 * warehouse interrogabile o una CDP applicativa, e la federazione si collega
 * a un warehouse. Da quella risposta dipende tutto il resto del capitolo.
 *
 * Portare la domanda noi, al minuto giusto, vale più che scoprirla col loro
 * IT fra un mese: un vincolo dichiarato da noi è credibilità, lo stesso
 * vincolo trovato da loro è un problema.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import HowItWorks from '@edf/core/blocks/HowItWorks.astro';
import Dettaglio from '@edf/core/blocks/Dettaglio.astro';
import DettaglioVoce from '@edf/core/blocks/DettaglioVoce.astro';
import Figura from '../components/Figura.astro';
import Divisore from '../components/Divisore.astro';
import Aperto from '../components/Aperto.astro';
import Fonte from '../components/Fonte.astro';
import T from '@edf/core/blocks/i18n/T.astro';
import { href } from '@edf/core/utils/url.js';
import { CHAPTERS, prevSlug, nextSlug } from '../data/chapters';
import { fonti } from '../data/fonti';
import { ENTRA, RESTA } from '../data/architettura';

const SLUG = 'dato';
const ch = CHAPTERS.find((c) => c.slug === SLUG)!;
const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;
---
<BaseLayout title={ch.title.it}>
  <div class="fixed top-0 left-0 right-0 z-50">
    <Navigation currentPath={currentPath} base={base} />
  </div>

  <DeckContainer nextHref={href(base, nextSlug(SLUG))} prevHref={href(base, prevSlug(SLUG))}>

    <Slide id="slide-cover" bg="secondary" align="left">
      <div slot="backdrop" class="xd-div-bg" data-senza-foto></div>
      <Divisore num={ch.num} tIt={ch.title.it} tEn={ch.title.en} lIt={ch.punto.it} lEn={ch.punto.en} />
    </Slide>

    <Slide id="slide-federa" bg="inverse" align="left">
      <div slot="backdrop" class="xd-bg-piano"></div>
      <div class="xd-sl xd-sl--dark" data-reveal>
        <div class="xd-sl-head">
          <T as="p" class="xd-n" it="Il confine" en="The line" />
          {/* ⚠️ Il titolo diceva «si interroga il dato dove vive, invece di
              copiarlo» e sotto c'era la lista di quello che ENTRA: in
              proiezione il titolo si legge per primo, e tre lettori su
              cinque hanno letto una contraddizione. Il contenuto era onesto:
              si è allineata l'intestazione, non il conteggio.
              ⚠️ E i tre tempi sono tre, non uno: l'evento è in tempo reale,
              la composizione federata è PROGRAMMATA — la documentazione la
              chiama «a static composition, updated when the federated
              audience composition is executed», e non vale per le
              qualificazioni di audience — e la decisione in sessione legge
              il profilo già in piattaforma. Raccontarli come un'unica
              lettura in sessione è la frase che l'architetto dei dati di una
              banca smonta mentre parliamo. */}
          <T as="h2" class="xd-h2" it="Entra la traccia, resta la base clienti" en="The trail enters, the customer base stays" />
          <T as="p" class="xd-sub"
             it="Tre tempi diversi: l’evento è in tempo reale, la composizione dell’audience sulla vostra piattaforma dati è programmata, la decisione in sessione legge il profilo già in piattaforma."
             en="Three different timings: the event is real time, audience composition on your data platform is scheduled, the in-session decision reads the profile already in the platform." />
        </div>

        <div class="bp-due">
          <div class="bp-due-c" data-lato="poi" data-substep data-side="in">
            <T as="p" class="bp-due-k" it="Entra in piattaforma" en="Enters the platform" />
            <ul class="bp-due-l">
              {ENTRA.map((v) => <li><T as="span" it={`${v.k.it} — ${v.d.it}`} en={`${v.k.en} — ${v.d.en}`} /></li>)}
            </ul>
          </div>
          <div class="bp-due-c" data-lato="oggi" data-substep data-side="in">
            <T as="p" class="bp-due-k" it="Resta dove vive" en="Stays where it lives" />
            <ul class="bp-due-l">
              {RESTA.map((v) => <li><T as="span" it={`${v.k.it} — ${v.d.it}`} en={`${v.k.en} — ${v.d.en}`} /></li>)}
            </ul>
          </div>
        </div>

        <Aperto tagIt="Se la federazione non copre il vostro caso" tagEn="If federation does not cover your case"
                it="Gli attributi arrivano per flusso programmato, come oggi: in quello scenario un sottoinsieme viene copiato, e si dichiara quale."
                en="Attributes arrive on a scheduled feed, as today: in that scenario a subset gets copied, and we declare which." />

        <Fonte voci={fonti('facOverview', 'facConnessioni')} />
      </div>
    </Slide>

    <Slide id="slide-domande" bg="primary" align="left">
      <div slot="backdrop" class="ex-bg-paper"></div>
      <div class="xd-sl" data-reveal>
        <div class="xd-sl-head">
          <T as="p" class="xd-n" it="Prima di prometterlo" en="Before promising it" />
          <T as="h2" class="xd-h2" it="Due cose che dipendono da voi, e le diciamo adesso" en="Two things that depend on you, and we say them now" />
          <T as="p" class="xd-sub"
             it="Le abbiamo verificate sulla documentazione il 31 ottobre. Una risposta cambia la strada, l’altra cambia i tempi."
             en="We checked the documentation on 31 October. One answer changes the route, the other changes the timing." />
        </div>

        <div class="bp-aperti">
          <Aperto it="La «CDP Oracle» dello schema è una piattaforma dati interrogabile, oppure una CDP di prodotto con un suo modello chiuso? La federazione si collega a una piattaforma dati."
                  en="Is the «Oracle CDP» in the diagram a queryable data platform, or a packaged CDP with its own closed model? Federation connects to a data platform." />
          <Aperto it="Oracle è coperto dalla 11g in su, purché il database sia raggiungibile da una rete esterna. Nella tabella delle connessioni private non c’è: la raggiungibilità è compatibile con le vostre regole?"
                  en="Oracle is covered from 11g up, provided the database is reachable from an outside network. It is absent from the private-connectivity table: is that reachability compatible with your rules?" />
        </div>

        <T as="p" class="xd-chiusa"
           it="Mezza giornata con chi conosce quei sistemi chiude entrambe, e si fa prima della proposta."
           en="Half a day with the people who know those systems closes both, and it happens before the proposal." />

        <HowItWorks title="Che cosa dice la documentazione" class="ex-dett">
          <Dettaglio>
            <DettaglioVoce>
              <Figura k="federa" />
              <T slot="ancora" as="p" it="Dove la documentazione concorda" en="Where the docs agree" />
              <T slot="riga" as="p" it="Pagina delle connessioni e domande frequenti elencano Oracle fra i database federabili." en="The connections page and the FAQ both list Oracle among the federable databases." />
            </DettaglioVoce>
            <DettaglioVoce>
              <Figura k="scambio" />
              <T slot="ancora" as="p" it="Dove non concorda" en="Where they do not" />
              <T slot="riga" as="p" it="La pagina dei prerequisiti ne elenca sette, e Oracle non c’è. La pagina delle connessioni invece lo copre, dalla versione 11g in su." en="The prerequisites page lists seven, and Oracle is absent. The connections page covers it instead, from version 11g up." />
            </DettaglioVoce>
            <DettaglioVoce>
              <Figura k="fasi" />
              <T slot="ancora" as="p" it="Che cosa portiamo scritto" en="What we bring in writing" />
              <T slot="riga" as="p" it="Connettore, porta, autenticazione, indirizzi da mettere in lista bianca e chi tiene il certificato: una pagina, prima del 12." en="Connector, port, authentication, addresses to allow-list and who holds the certificate: one page, before the 12th." />
            </DettaglioVoce>
            <T slot="nota" as="p"
               it="La federazione richiede Real-Time CDP e/o Journey Optimizer, più il componente aggiuntivo dedicato, che si paga a consumo. La pagina dei prerequisiti elenca sette magazzini, e Oracle non è fra quei sette."
               en="Federation requires Real-Time CDP and/or Journey Optimizer, plus the dedicated add-on, charged on consumption. The prerequisites page lists seven warehouses, and Oracle is not among them." />
          </Dettaglio>
        </HowItWorks>

        <Fonte voci={fonti('facPrerequisiti', 'facConnessioni', 'facFaq', 'facPrivata')}
               nota="Quattro pagine ufficiali consultate il 31 ottobre 2026 — prerequisiti, database supportati, domande frequenti, connessioni private: concordano sul principio, non sull’elenco."
               notaEn="Four official pages consulted on 31 October 2026 — prerequisites, supported databases, FAQ, private connections: they agree on the principle, not on the list." />
      </div>
    </Slide>

  </DeckContainer>
</BaseLayout>
