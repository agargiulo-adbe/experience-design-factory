---
import BaseLayout from '../layouts/BaseLayout.astro';
import AdminConsole from '@edf/core/blocks/admin/AdminConsole.astro';
import { href } from '@edf/core/utils/url.js';
import { SITE } from '../data/site';

const base = import.meta.env.BASE_URL;
const SUPABASE_URL = import.meta.env.PUBLIC_SUPABASE_URL ?? '';
const SUPABASE_ANON_KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY ?? '';

interface SlideEntry { id: string; label: string; }
interface PageEntry { slug: string; label: string; slides: SlideEntry[]; }

// Ogni slide del deck, pagina per pagina: è ciò che il tab «Capitoli e slide»
// accende e spegne. Ogni <Slide id> nuova va registrata qui.
const PAGE_REGISTRY: PageEntry[] = [
  { slug: 'index', label: 'Copertina (00)', slides: [
    { id: 'slide-cover', label: 'Copertina — Sopra quello che avete' },
  ]},
  { slug: 'dieci-minuti', label: 'In dieci minuti — quello che si proietta', slides: [
    { id: 'slide-cover',     label: 'Copertina — In dieci minuti' },
    { id: 'slide-mappa',     label: 'Di nove blocchi, ne tocchiamo tre' },
    { id: 'slide-scambi',    label: 'Due prodotti escono, quattro moduli entrano' },
    { id: 'slide-settimana', label: 'Che cosa cambia in una settimana' },
    { id: 'slide-aperto',    label: 'Tre cose che chiudiamo con voi' },
    { id: 'slide-costo',     label: 'Il modello di costo' },
    { id: 'slide-firma',     label: 'La firma e l’ask' },
  ]},
  { slug: 'architettura', label: 'Dove ci innestiamo (01)', slides: [
    { id: 'slide-cover',   label: 'Cover — Dove ci innestiamo' },
    { id: 'slide-mappa',   label: 'La vostra architettura, per verso' },
    { id: 'slide-innesto', label: 'I tre punti di contatto' },
  ]},
  { slug: 'moduli', label: 'Che cosa prende il posto di che cosa (02)', slides: [
    { id: 'slide-cover',     label: 'Cover — Che cosa prende il posto di che cosa' },
    { id: 'slide-scambi',    label: 'Due prodotti escono, quattro moduli entrano' },
    { id: 'slide-settimana', label: 'Che cosa cambia in una settimana di lavoro' },
    { id: 'slide-arbitro',   label: 'Chi vince quando più proposte competono' },
  ]},
  { slug: 'dato', label: 'Che cosa entra, e che cosa resta (03)', slides: [
    { id: 'slide-cover',   label: 'Cover — Che cosa entra, e che cosa resta' },
    { id: 'slide-federa',  label: 'Entra la traccia, resta la base clienti' },
    { id: 'slide-domande', label: 'Due cose che dipendono da voi' },
  ]},
  { slug: 'referenze', label: 'Chi l’ha già fatto (04)', slides: [
    { id: 'slide-cover',  label: 'Cover — Chi l’ha già fatto' },
    { id: 'slide-onesta', label: 'Nessun nome, e il motivo' },
  ]},
  { slug: 'rotta', label: 'Come ci si arriva (05)', slides: [
    { id: 'slide-cover',   label: 'Cover — Come ci si arriva' },
    { id: 'slide-fasi',    label: 'Quattro fasi, e che cosa le chiude' },
    { id: 'slide-impegno', label: 'Che cosa manca per una stima in giornate' },
    { id: 'slide-uscita',  label: 'Come si esce — esternalizzazione e rientro' },
    { id: 'slide-chi',     label: 'Sull’integratore' },
  ]},
  { slug: 'valore', label: 'Che cosa si paga, e di che cosa (06)', slides: [
    { id: 'slide-cover',     label: 'Cover — Che cosa si paga, e di che cosa' },
    { id: 'slide-beneficio', label: 'Come si misura il beneficio' },
    { id: 'slide-driver',    label: 'I cinque driver' },
    { id: 'slide-core',      label: 'Che cosa comprende questo perimetro' },
  ]},
  { slug: 'prossimi-passi', label: 'Prossimi passi (07)', slides: [
    { id: 'slide-cover', label: 'Cover — Prossimi passi' },
    { id: 'slide-ask',   label: 'Mezza giornata, con chi conosce i sistemi' },
    { id: 'slide-firma', label: 'La firma — Adobe × BPER' },
  ]},
];

interface SolutionEntry {
  id: string; name: string; shortName: string;
  pillar: string; description: string; appearsIn: string[];
}

// Segnaposto: il deck generato non ha slide gated. Sostituire con le soluzioni
// Adobe che l’experience propone davvero (nomi verificati, vedi memoria
// adobe-product-naming-2026) e marcare le slide con `data-solution="<id>"`.
const SOLUTIONS: SolutionEntry[] = [
  { id: 'regia', name: 'Adobe Journey Optimizer', shortName: 'Journey Optimizer', pillar: 'engagement',
    description: 'La regia dei percorsi, al posto di Marketing Cloud. Decisioning è una voce di listino a sé.',
    appearsIn: ['Dove ci innestiamo', 'Che cosa prende il posto di che cosa', 'Come ci si arriva'] },
  { id: 'personalizzazione', name: 'Adobe Target', shortName: 'Target', pillar: 'engagement',
    description: 'La personalizzazione dei canali digitali, al posto di Personalization.',
    appearsIn: ['Che cosa prende il posto di che cosa'] },
  { id: 'misura', name: 'Customer Journey Analytics', shortName: 'CJA', pillar: 'dati',
    /* ⚠️ Diceva «senza spostare il dato dalla piattaforma del cliente», ed è
       falso: i dati che si usano in Customer Journey Analytics sono ingeriti
       in Experience Platform. La frase era stata corretta nelle slide e non
       qui — che è il posto da cui si copia la prossima volta. */
    description: 'La misura sul percorso intero. Gli eventi di comportamento entrano in piattaforma; gli attributi restano nella vostra.',
    appearsIn: ['Che cosa prende il posto di che cosa', 'Come ci si arriva'] },
  { id: 'federazione', name: 'Federated Audience Composition', shortName: 'Federazione', pillar: 'dati',
    description: 'Le audience composte sulla piattaforma dati del cliente: la composizione è programmata, e torna indietro come appartenenza.',
    appearsIn: ['Il dato resta dov’è'] },
];

const PILLAR_LABELS: Record<string, string> = { piattaforma: 'Piattaforma' };
const PILLAR_ORDER = ['piattaforma'];
const PILLAR_COLORS: Record<string, string> = { piattaforma: '#005157' };

const solutionGroups = PILLAR_ORDER
  .map((pillar) => ({ pillar, label: PILLAR_LABELS[pillar], color: PILLAR_COLORS[pillar], solutions: SOLUTIONS.filter((s) => s.pillar === pillar) }))
  .filter((g) => g.solutions.length > 0);

const allSolutionIds = SOLUTIONS.map((s) => s.id);
const deckHref = href(base, '/');
// I dossier interni di questa experience, se ne ha: la console è il posto dove
// chi presenta trova il deck e il documento che prepara la stanza. Quando nasce
// un `dossier.astro`, si aggiunge qui — restano gated, il link non li apre.
const DOSSIERS: { href: string; label?: string }[] = [
  // { href: href(base, '/dossier'), label: 'Dossier interno' },
];
---
<BaseLayout title={`Console — ${SITE.name} · ${SITE.client}`}>
  <AdminConsole
    projectSlug={SITE.slug}
    projectName={SITE.name}
    clientLabel={`Adobe × ${SITE.client}`}
    deckHref={deckHref}
    dossiers={DOSSIERS}
    pages={PAGE_REGISTRY}
    solutionGroups={solutionGroups}
    allSolutionIds={allSolutionIds}
    supabaseUrl={SUPABASE_URL}
    supabaseAnonKey={SUPABASE_ANON_KEY}
  />
</BaseLayout>
