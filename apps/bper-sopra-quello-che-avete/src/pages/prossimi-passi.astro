---
/**
 * 08 · Prossimi passi, e la slide-firma.
 *
 * L’ask sta in UN posto solo, ed è questo. Due versioni della richiesta sono
 * il modo più rapido di sembrare confusi davanti a un cliente.
 *
 * ⚠️ L’ULTIMA SLIDE DEL PERCORSO È UNA SLIDE-FIRMA A SÉ. La chiusura tipica è
 * già densa, e il lockup grande la fa sbordare: per contratto si divide, non
 * si comprime. Fallisce il check SOFT `i` perché il lockup è un SVG e il
 * parser non lo conta come massa di testo: è la classica slide volutamente
 * ariosa, e non si aggiusta rimpicciolendo il tipo.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import CoBrand from '../components/CoBrand.astro';
import Divisore from '../components/Divisore.astro';
import Figura from '../components/Figura.astro';
import T from '@edf/core/blocks/i18n/T.astro';
import { href } from '@edf/core/utils/url.js';
import { CHAPTERS, prevSlug } from '../data/chapters';
import { ASK } from '../data/condivisi';

const SLUG = 'prossimi-passi';
const ch = CHAPTERS.find((c) => c.slug === SLUG)!;
const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;

/* Le tre domande aperte del documento, raccolte. Sono le stesse che i
   capitoli hanno già fatto: qui tornano insieme perché è l’ask. */
const APERTE = [
  { k: { it: 'La CDP', en: 'The CDP' }, d: { it: 'Magazzino interrogabile o CDP di prodotto, e la connettività che vi serve.', en: 'Queryable warehouse or packaged CDP, and the connectivity you need.' }, f: 'federa' },
  { k: { it: 'La referenza', en: 'The reference' }, d: { it: 'Quale delle tre forme serve davvero al comitato che decide.', en: 'Which of the three kinds the deciding committee actually needs.' }, f: 'scambio' },
  { k: { it: 'Il perimetro', en: 'The scope' }, d: { it: 'I quattro dati che trasformano i driver in una cifra.', en: 'The four inputs that turn the drivers into a figure.' }, f: 'misura' },
];
---
<BaseLayout title={ch.title.it}>
  <div class="fixed top-0 left-0 right-0 z-50">
    <Navigation currentPath={currentPath} base={base} />
  </div>

  <DeckContainer nextHref={href(base, '/')} prevHref={href(base, prevSlug(SLUG))}>

    <Slide id="slide-cover" bg="secondary" align="left">
      <div slot="backdrop" class="xd-div-bg" data-senza-foto></div>
      <Divisore num={ch.num} tIt={ch.title.it} tEn={ch.title.en} lIt={ch.punto.it} lEn={ch.punto.en} />
    </Slide>

    <Slide id="slide-ask" bg="inverse" align="left">
      <div slot="backdrop" class="xd-bg-piano"></div>
      <div class="xd-sl xd-sl--dark" data-reveal>
        <div class="xd-sl-head">
          <T as="p" class="xd-n" it="Quello che chiediamo" en="What we are asking" />
          <T as="h2" class="xd-h2" it={ASK.titolo.it} en={ASK.titolo.en} />
          <T as="p" class="xd-sub"
             it="Tre domande aperte in questo documento. Si chiudono in una sessione, e dopo la proposta ha dei numeri invece di un intervallo."
             en="Three questions left open here. One session closes them, and then the proposal carries numbers instead of a range." />
        </div>

        <div class="xd-pb xd-pb--tre">
          {APERTE.map((a, i) => (
            <section class="xd-pb-i" data-substep data-side="in">
              <T as="p" class="xd-pb-k" it={`0${i + 1} · ${a.k.it}`} en={`0${i + 1} · ${a.k.en}`} />
              <Figura k={a.f} />
              <T as="p" class="xd-pb-v" it={a.d.it} en={a.d.en} />
            </section>
          ))}
        </div>

        <T as="p" class="xd-chiusa"
           it="Chi serve dalla vostra parte: chi governa la CDP, chi possiede le campagne, chi risponde del dato."
           en="Who we need on your side: whoever governs the CDP, owns the campaigns, answers for the data." />
      </div>
    </Slide>

    {/* La slide-firma: il lockup, una riga presa dal documento, il passo. */}
    <Slide id="slide-firma" bg="inverse" align="center">
      <div slot="backdrop" class="xd-bg-piano"></div>
      <div class="xd-firma" data-reveal>
        <CoBrand variant="hero" class="ex-cobrand--on-dark" data-reveal />
        <T as="p" class="xd-firma-l" it={ASK.titolo.it} en={ASK.titolo.en} data-reveal data-reveal-delay="0.1" />
        <T as="p" class="xd-firma-n" it={ASK.riga.it} en={ASK.riga.en} data-reveal data-reveal-delay="0.18" />
      </div>
    </Slide>

  </DeckContainer>
</BaseLayout>
