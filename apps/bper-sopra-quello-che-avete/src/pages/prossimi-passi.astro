---
/**
 * 08 · Prossimi passi, e la slide-firma.
 *
 * L’ask sta in UN posto solo, ed è questo. Due versioni della richiesta sono
 * il modo più rapido di sembrare confusi davanti a un cliente.
 *
 * ⚠️ L’ULTIMA SLIDE DEL PERCORSO È UNA SLIDE-FIRMA A SÉ. La chiusura tipica è
 * già densa, e il lockup grande la fa sbordare: per contratto si divide, non
 * si comprime. Fallisce il check SOFT `i` perché il lockup è un SVG e il
 * parser non lo conta come massa di testo: è la classica slide volutamente
 * ariosa, e non si aggiusta rimpicciolendo il tipo.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import CoBrand from '../components/CoBrand.astro';
import Divisore from '../components/Divisore.astro';
import Figura from '../components/Figura.astro';
import T from '@edf/core/blocks/i18n/T.astro';
import { href } from '@edf/core/utils/url.js';
import { CHAPTERS, prevSlug } from '../data/chapters';
import { ASK } from '../data/condivisi';

const SLUG = 'prossimi-passi';
const ch = CHAPTERS.find((c) => c.slug === SLUG)!;
const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;

/* Le tre domande aperte del documento, raccolte. Sono le stesse che i
   capitoli hanno già fatto: qui tornano insieme perché è l’ask. */
const APERTE = [
  { k: { it: 'La CDP', en: 'The CDP' }, d: { it: 'Piattaforma dati interrogabile o CDP di prodotto, e la connettività che vi serve.', en: 'Queryable data platform or packaged CDP, and the connectivity you need.' }, f: 'federa' },
  /* ⚠️ Diceva «quale delle tre forme»: le tre forme di referenza erano state
     tolte dal documento al primo giro, e questo punto rimandava a una slide
     che non esiste più. Le opzioni che restano sono due. */
  { k: { it: 'La referenza', en: 'The reference' }, d: { it: 'Una banca che ha spento Marketing Cloud, oppure una banca italiana già su questi moduli.', en: 'A bank that switched Marketing Cloud off, or an Italian bank already on these modules.' }, f: 'scambio' },
  { k: { it: 'Il perimetro', en: 'The scope' }, d: { it: 'I cinque dati che trasformano i driver in una cifra. Più i quattro numeri della stima in giornate.', en: 'The five inputs that turn the drivers into a figure. Plus the four numbers behind the estimate in days.' }, f: 'misura' },
];
---
<BaseLayout title={ch.title.it}>
  <div class="fixed top-0 left-0 right-0 z-50">
    <Navigation currentPath={currentPath} base={base} />
  </div>

  <DeckContainer nextHref={href(base, '/')} prevHref={href(base, prevSlug(SLUG))}>

    <Slide id="slide-cover" bg="secondary" align="left">
      <div slot="backdrop" class="xd-div-bg" data-senza-foto></div>
      <Divisore num={ch.num} tIt={ch.title.it} tEn={ch.title.en} lIt={ch.punto.it} lEn={ch.punto.en} />
    </Slide>

    <Slide id="slide-ask" bg="inverse" align="left">
      <div slot="backdrop" class="xd-bg-piano"></div>
      <div class="xd-sl xd-sl--dark" data-reveal>
        <div class="xd-sl-head">
          <T as="p" class="xd-n" it="Quello che chiediamo" en="What we are asking" />
          <T as="h2" class="xd-h2" it={ASK.titolo.it} en={ASK.titolo.en} />
          <T as="p" class="xd-sub"
             it="Tre domande aperte in questo documento. Si chiudono in una sessione, e dopo la proposta ha dei numeri invece di un intervallo."
             en="Three questions left open here. One session closes them, and then the proposal carries numbers instead of a range." />
        </div>

        <div class="xd-pb xd-pb--tre">
          {APERTE.map((a, i) => (
            <section class="xd-pb-i" data-substep data-side="in">
              <T as="p" class="xd-pb-k" it={`0${i + 1} · ${a.k.it}`} en={`0${i + 1} · ${a.k.en}`} />
              <Figura k={a.f} />
              <T as="p" class="xd-pb-v" it={a.d.it} en={a.d.en} />
            </section>
          ))}
        </div>

        {/* ⚠️ IDENTICA AL PRIMO GIRO, e cinque lettori su cinque l'hanno
            segnalata con le stesse parole: una richiesta di tempo senza una
            data proposta non è una richiesta, è un'intenzione. La slide
            elencava benissimo chi serve dalla loro parte e non diceva una
            parola su chi veniamo noi, con quale agenda e con quale esito
            scritto. Le quattro righe qui sotto sono quella risposta; i nomi
            nostri li porta chi presenta, perché questo documento è pubblico
            e in un file tracciato i nomi delle persone non si scrivono. */}
        <ul class="bp-l" data-stagger>
          <li data-substep data-side="in"><T as="span" it="Dalla vostra parte: chi governa la CDP, chi possiede le campagne, chi risponde del dato." en="On your side: whoever governs the CDP, owns the campaigns, answers for the data." /></li>
          <li data-substep data-side="in"><T as="span" it="Dalla nostra: chi conosce la piattaforma, chi conosce il canale, chi fa il prezzo. Tre persone, non una squadra." en="On ours: the person who knows the platform, the one who knows the channel, the one who prices it. Three people, not a team." /></li>
          <li data-substep data-side="in"><T as="span" it="Quattro ore: la CDP e la connettività · il perimetro e la licenza · i numeri da raccogliere · consensi, regole di contatto e le tre misure." en="Four hours: the CDP and connectivity · scope and licensing · the numbers to collect · consent, contact rules and the three measures." /></li>
          <li data-substep data-side="in"><T as="span" it="Vi proponiamo due date entro due settimane dal 12, e quello che ne esce è il perimetro scritto, non un verbale." en="We propose two dates within a fortnight of the 12th, and what comes out is the scope in writing, not minutes of a meeting." /></li>
        </ul>

        <T as="p" class="xd-chiusa"
           it="Con quel perimetro, la cifra e la stima in giornate arrivano entro la settimana dopo."
           en="With that scope, the figure and the estimate in days arrive within the following week." />
      </div>
    </Slide>

    {/* La slide-firma: il lockup, una riga presa dal documento, il passo. */}
    <Slide id="slide-firma" bg="inverse" align="center">
      <div slot="backdrop" class="xd-bg-piano"></div>
      <div class="xd-firma" data-reveal>
        <CoBrand variant="hero" class="ex-cobrand--on-dark" data-reveal />
        <T as="p" class="xd-firma-l" it={ASK.titolo.it} en={ASK.titolo.en} data-reveal data-reveal-delay="0.1" />
        <T as="p" class="xd-firma-n" it={ASK.riga.it} en={ASK.riga.en} data-reveal data-reveal-delay="0.18" />
      </div>
    </Slide>

  </DeckContainer>
</BaseLayout>
