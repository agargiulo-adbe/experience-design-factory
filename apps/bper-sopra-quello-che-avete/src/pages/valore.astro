---
/**
 * 07 · Che cosa si paga, e di che cosa.
 *
 * Il responsabile delle fabbriche digitali ha chiesto «metriche di pricing» e «core vs nice to have». Sono due
 * domande diverse e qui restano separate, perché confonderle è il modo di
 * far sembrare caro il core.
 *
 * ⚠️ NESSUNA CIFRA IN QUESTO CAPITOLO, e non è prudenza: è che una cifra
 * senza perimetro è un numero che poi si deve ritirare, davanti alle stesse
 * persone. Quello che si può dire con precisione — e che serve a un IT che
 * deve preparare un budget — sono i DRIVER: su che cosa si misura il costo,
 * e quindi quale informazione serve per avere una cifra vera.
 *
 * Esiste già una macro-stima nostra per BPER su CJA, AJO e Target, di aprile
 * 2026, fatta su un perimetro diverso. Va ripresa e riletta, non ricopiata:
 * ha sette mesi e nel frattempo il perimetro è cambiato.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import HowItWorks from '@edf/core/blocks/HowItWorks.astro';
import Dettaglio from '@edf/core/blocks/Dettaglio.astro';
import DettaglioVoce from '@edf/core/blocks/DettaglioVoce.astro';
import Figura from '../components/Figura.astro';
import Divisore from '../components/Divisore.astro';
import Aperto from '../components/Aperto.astro';
import Fonte from '../components/Fonte.astro';
import T from '@edf/core/blocks/i18n/T.astro';
import { href } from '@edf/core/utils/url.js';
import { CHAPTERS, prevSlug, nextSlug } from '../data/chapters';
import { COSTO, DRIVER } from '../data/condivisi';
import { MISURE } from '../data/architettura';
import { fonti } from '../data/fonti';

const SLUG = 'valore';
const ch = CHAPTERS.find((c) => c.slug === SLUG)!;
const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;

/* I driver vivono in `src/data/condivisi.ts`: li rende questa pagina e li
   riprende il taglio da dieci minuti, e due copie a mano divergono sempre.
   Da quattro sono diventati cinque, e tre righe su quattro sono state
   riscritte sulle descrizioni di prodotto — la personalizzazione si licenzia
   sul traffico, e quella grandezza mancava del tutto. */

---
<BaseLayout title={ch.title.it}>
  <div class="fixed top-0 left-0 right-0 z-50">
    <Navigation currentPath={currentPath} base={base} />
  </div>

  <DeckContainer nextHref={href(base, nextSlug(SLUG))} prevHref={href(base, prevSlug(SLUG))}>

    <Slide id="slide-cover" bg="secondary" align="left">
      <div slot="backdrop" class="xd-div-bg" data-senza-foto></div>
      <Divisore num={ch.num} tIt={ch.title.it} tEn={ch.title.en} lIt={ch.punto.it} lEn={ch.punto.en} />
    </Slide>

    {/* ⚠️ LA SLIDE CHE MANCAVA DA DUE GIRI, e l'assenza era strutturale: un
        capitolo intitolato «che cosa si paga, e di che cosa» che diceva solo
        di che cosa si paga. Quattro lettori su cinque l'hanno messa fra le
        condizioni — «al comitato porto un listino e non un progetto» — e la
        prima fase della rotta dichiara che senza misura il confronto con
        oggi non esiste. I valori di partenza restano in bianco: li riempiono
        loro, perché un numero di partenza inventato da noi vale zero. */}
    <Slide id="slide-beneficio" bg="primary" align="left">
      <div slot="backdrop" class="ex-bg-paper"></div>
      <div class="xd-sl" data-reveal>
        <div class="xd-sl-head">
          <T as="p" class="xd-n" it="Prima del prezzo" en="Before the price" />
          <T as="h2" class="xd-h2" it="Come si misura se è andata meglio" en="How you measure whether it went better" />
          <T as="p" class="xd-sub"
             it="Tre indicatori. Il valore di partenza lo mettete voi, il bersaglio a dodici mesi lo fissate voi, e si collegano nella prima fase: prima di spostare un invio."
             en="Three indicators. You fill in the baseline, you set the twelve-month target, and they get connected in the first phase: before a single send moves." />
        </div>

        <ul class="xd-passi" style="--cols:3" data-stagger>
          {MISURE.map((m, i) => (
            <li class="xd-passi-i" data-substep data-side="in">
              <span class="xd-passi-n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <T as="p" class="xd-passi-l" it={m.k.it} en={m.k.en} />
              <T as="p" class="xd-passi-d" it={m.oggi.it} en={m.oggi.en} />
              <T as="p" class="xd-passi-d" it={m.poi.it} en={m.poi.en} />
            </li>
          ))}
        </ul>

        <T as="p" class="xd-chiusa"
           it="Il primo dei tre è quello del vostro piano industriale. Se il confronto non si può fare, il resto di questo capitolo non serve."
           en="The first of the three is the one in your industrial plan. If the comparison cannot be made, the rest of this chapter is of no use." />
      </div>
    </Slide>

    <Slide id="slide-driver" bg="inverse" align="left">
      <div slot="backdrop" class="xd-bg-piano"></div>
      <div class="xd-sl xd-sl--dark" data-reveal>
        <div class="xd-sl-head">
          <T as="p" class="xd-n" it="I driver" en="The drivers" />
          <T as="h2" class="xd-h2" it={COSTO.titolo.it} en={COSTO.titolo.en} />
          <T as="p" class="xd-sub"
             it="Cinque grandezze, e accanto a ognuna il dato che serve da voi. Sono le grandezze con cui si fattura, lette sulle descrizioni di prodotto."
             en="Five quantities, each with the input we need from you. These are the quantities billing runs on, read from the product descriptions." />
        </div>

        {/* ⚠️ --cols:3 e non 2: con cinque driver a due colonne, a 1280×800
            l'altezza del contenuto arrivava al 167% della fascia utile e il
            titolo finiva SOPRA la safe-area (check `c`, che è HARD). Si
            cambia la griglia, non il corpo del tipo. */}
        <ul class="xd-passi" style="--cols:3" data-stagger>
          {DRIVER.map((d, i) => (
            <li class="xd-passi-i" data-substep data-side="in">
              <span class="xd-passi-n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <T as="p" class="xd-passi-l" it={d.k.it} en={d.k.en} />
              <T as="p" class="xd-passi-d" it={d.d.it} en={d.d.en} />
              <T as="p" class="xd-passi-d" it={d.s.it} en={d.s.en} />
            </li>
          ))}
        </ul>

        <T as="p" class="xd-chiusa"
           it="Nessuna delle cinque dipende da quante persone entrano nello strumento. Qualche componente accessorio si conta per utente, e dove si applica lo diciamo."
           en="None of the five depends on how many people log into the tool. A few accessory components are counted per user, and where that applies we say so." />

        <Aperto it={`${COSTO.cifra.it} Con quei cinque dati arriva in una settimana, e regge.`} en={`${COSTO.cifra.en} With those five inputs it arrives in a week, and it holds.`} />
      </div>
    </Slide>

    <Slide id="slide-core" bg="primary" align="left">
      <div slot="backdrop" class="ex-bg-paper"></div>
      <div class="xd-sl" data-reveal>
        <div class="xd-sl-head">
          <T as="p" class="xd-n" it="Che cosa comprende" en="What it covers" />
          <T as="h2" class="xd-h2" it="Quattro voci, più una che dipende da voi" en="Four lines, plus one that depends on you" />
          <T as="p" class="xd-sub"
             it="Questo perimetro non è l’oggetto della vostra gara sul gestionale. Le due cose restano separate anche nei numeri."
             en="This scope is not the subject of your core-system tender. The two stay apart in the numbers as well." />
        </div>

        {/* ⚠️ LA COLONNA «FUORI PERIMETRO» È STATA TOLTA, e l'hanno tagliata
            cinque lettori su cinque: in una stanza che discute la
            sostituzione di due prodotti, due voci che nessuno ha chiesto
            diventano il momento in cui il fornitore allarga. Chi presenta
            deve però sapere i nomi correnti, se la domanda arriva in sala:
            Adobe Brand Visibility (non più LLM Optimizer) per la visibilità
            del marchio nelle risposte generate, GenStudio per la fabbrica
            dei contenuti.
            ⚠️ E l'arbitro: il dettaglio diceva che «non si licenzia da solo».
            La descrizione di prodotto in vigore dall'8 settembre 2026 lo
            elenca come componente a sé, con la metrica dei profili
            ingaggiabili. Una condizione che costa non può stare dietro
            «Scopri come», ed è la stessa obiezione del primo giro spostata
            di capitolo. */}
        <ul class="bp-l" data-stagger>
          <li data-substep data-side="in"><T as="span" it="La regia dei percorsi, al posto di Marketing Cloud." en="Journey orchestration, in place of Marketing Cloud." /></li>
          <li data-substep data-side="in"><T as="span" it="L’arbitro fra le proposte: è un componente a sé del listino, con la stessa metrica dei profili ingaggiabili. Non raddoppia il conto, ma si licenzia." en="The arbiter between offers: a separate line item, on the same engageable-profiles metric. It does not double the bill, but it is licensed." /></li>
          <li data-substep data-side="in"><T as="span" it="La personalizzazione dei canali digitali, che si licenzia sul traffico." en="Digital-channel personalisation, licensed on traffic." /></li>
          <li data-substep data-side="in"><T as="span" it="La misura sul percorso intero, sul volume ingerito e sulla finestra di conservazione." en="Journey-wide measurement, on ingested volume and retention window." /></li>
          <li data-substep data-side="in"><T as="span" it="E se la strada federata resta: il componente di federazione, a consumo, sul pacchetto della regia. Dipende dalle due domande del capitolo sul dato." en="And if the federated route holds: the federation add-on, on consumption, on the orchestration package. It depends on the two questions in the data chapter." /></li>
        </ul>

        <T as="p" class="xd-chiusa"
           it="Quello che è fuori perimetro sta su righe d’offerta sue, e questo documento non ne porta nessuna."
           en="Whatever is out of scope sits on its own order lines, and this document carries none." />

        <HowItWorks title="Che cosa muove il conto" class="ex-dett">
          <Dettaglio>
            <DettaglioVoce>
              <Figura k="federa" />
              <T slot="ancora" as="p" it="Che cosa alza il conto" en="What raises the bill" />
              <T slot="riga" as="p" it={COSTO.alza.it} en={COSTO.alza.en} />
            </DettaglioVoce>
            <DettaglioVoce>
              <Figura k="fasi" />
              <T slot="ancora" as="p" it="Che cosa lo abbassa" en="What lowers it" />
              <T slot="riga" as="p" it={COSTO.abbassa.it} en={COSTO.abbassa.en} />
            </DettaglioVoce>
          </Dettaglio>
        </HowItWorks>

        {/* ⚠️ QUI C'ERA UNA RIGA IN CALCE che annunciava una nostra
            macro-stima di aprile 2026 su un perimetro diverso, «da rileggere
            prima di essere citata». Tre lettori su cinque l'hanno messa fra
            le condizioni del verdetto, con le stesse parole: un numero
            annunciato e non consegnato è già un numero ritirato, e sta in
            calce alla slide che dovrebbe costruire fiducia sul costo. La
            stima esiste, va riletta sul perimetro nuovo, e questo resta un
            fatto per chi presenta — non una riga in pagina. */}
        <Fonte voci={fonti('ajo', 'decisioning', 'rtcdp')} />
      </div>
    </Slide>

  </DeckContainer>
</BaseLayout>
