---
import BaseLayout from '../layouts/BaseLayout.astro';
import UniNavigation from '../components/UniNavigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import CoverHero from '@edf/core/blocks/CoverHero.astro';
import SlideBackdrop from '@edf/core/blocks/SlideBackdrop.astro';
import { href } from '@edf/core/utils/url.js';
import { mediaProps } from '../../assets.index';
import MediaSlot from '@edf/core/blocks/MediaSlot.astro';
import MediaDemoSlot from '@edf/core/blocks/immersive/MediaDemoSlot.astro';
import T from '@edf/core/blocks/i18n/T.astro';

const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;

const sources = [
  { label: { en: 'Mobile app', it: 'App mobile' }, icon: '📱', count: { en: '4M+ events/day', it: '4M+ eventi/giorno' } },
  { label: { en: 'Online banking', it: 'Online banking' }, icon: '💻', count: { en: '3M+ sessions', it: '3M+ sessioni' } },
  { label: { en: 'Branches', it: 'Filiali' }, icon: '🏛️', count: { en: '3.800 branches', it: '3.800 sportelli' } },
  { label: { en: 'Call center', it: 'Call center' }, icon: '📞', count: { en: '65K calls/day', it: '65K chiamate/g' } },
  { label: { en: 'ATM / POS', it: 'ATM / POS' }, icon: '💳', count: { en: '7.500 ATM', it: '7.500 ATM' } },
  { label: { en: 'Open Banking', it: 'Open Banking' }, icon: '🔗', count: { en: 'third-party data', it: 'dati terze parti' } },
];

const profileAttribs = [
  { label: { en: 'Unified profile', it: 'Profilo unificato' }, value: { en: 'Marco Ferretti · 38 · Brescia', it: 'Marco Ferretti · 38a · Brescia' } },
  { label: { en: 'Home mortgage propensity score', it: 'Propensity score mutuo casa' }, value: { en: '87/100 ↑', it: '87/100 ↑' } },
  { label: { en: 'Next-Best-Experience', it: 'Next-Best-Experience' }, value: { en: 'First-home mortgage 20Y · tailored offer', it: 'Mutuo prima casa 20Y · offerta personalizzata' } },
  { label: { en: 'Preferred channel', it: 'Canale preferito' }, value: { en: 'App · Wednesday morning', it: 'App · mercoledì mattina' } },
  { label: { en: 'Segment', it: 'Segmento' }, value: { en: 'High-value retail client · in-market home mortgage', it: 'Cliente retail alto-valore · in-market mutuo casa' } },
  { label: { en: 'Last event', it: 'Ultimo evento' }, value: { en: 'Searched "mutuo casa" in-app 14:23', it: 'Ricerca "mutuo casa" in-app 14:23' } },
];

const capabilities = [
  { label: { en: 'Real-time segmentation', it: 'Segmentazione real-time' }, body: { en: 'Segments that refresh the moment behavior shifts, with no wait for the overnight batch.', it: 'Segmenti che si aggiornano quando cambia il comportamento, senza attendere i batch notturni.' }, color: 'var(--accent-primary)' },
  { label: { en: 'Propensity scoring', it: 'Propensity scoring' }, body: { en: 'A propensity score for every product, recomputed live on each event.', it: 'Un punteggio di propensione per ogni prodotto, ricalcolato live a ogni evento.' }, color: 'var(--accent-secondary)' },
  { label: { en: 'Next-Best-Experience', it: 'Next-Best-Experience' }, body: { en: 'The right offer lands at the right moment, on the channel the client prefers.', it: "L'offerta giusta arriva nel momento giusto, sul canale che il cliente preferisce." }, color: 'var(--accent-primary)' },
  { label: { en: 'Privacy by design', it: 'Privacy by design' }, body: { en: 'Built-in GDPR governance: consents, European data residency and audit trail.', it: 'Governance GDPR integrata: consensi, data residency europea e audit trail.' }, color: 'var(--accent-secondary)' },
];
---
<BaseLayout
  title="Conosci ogni cliente"
  description="Real-Time CDP unifica i dati di milioni di clienti in profili azionabili in tempo reale."
  pageSolutions={['rtcdp']}
>
  <div class="fixed top-0 left-0 right-0 z-50">
    <UniNavigation currentPath={currentPath} base={base} />
  </div>

  <DeckContainer nextHref={href(base, '/acquisisci')} prevHref={href(base, '/visibilita')}>

    <!-- ── SLIDE 0: Cover ─────────────────────────────────────────── -->
    <Slide id="slide-cover" bg="secondary" align="center">
      <SlideBackdrop
        slot="backdrop"
        {...mediaProps('bg-digital-blue')}
        imageClass="opacity-20"
        scrim="bg-[var(--surface-secondary)]/80"
      />
      <span data-lang-it class="contents">
        <CoverHero
          eyebrow="02 · DATI"
          numeral="02"
          title="Conosci ogni cliente"
          lead="Milioni di clienti, con dati sparsi tra app, filiale e call center. Real-Time CDP li raccoglie in un profilo per cliente, aggiornato in millisecondi."
          size="phase"
          tone="ink"
          signature={false}
        />
      </span>
      <span data-lang-en class="contents">
        <CoverHero
          eyebrow="02 · DATA"
          numeral="02"
          title="Know every client"
          lead="Millions of clients, with data scattered across app, branch and call center. Real-Time CDP gathers it into one profile per client, refreshed in milliseconds."
          size="phase"
          tone="ink"
          signature={false}
        />
      </span>
    </Slide>

    <!-- ── SLIDE 1: Storia di Marco ─────────────────────────────── -->
    <Slide id="slide-storia-conosci" bg="secondary" align="split">
      <div class="uc-bg-soft w-full flex-1 min-h-0 grid md:grid-cols-2 gap-10 md:gap-16 items-center rounded-sm">
        <div class="flex items-center justify-center" data-reveal>
          <div class="relative overflow-hidden rounded-sm" style="width:100%; height:min(500px,65dvh);">
            <MediaSlot {...mediaProps('persona-marco')} fill objectPosition="top" />
          </div>
        </div>

        <div class="text-left">
          <div class="uc-thread mb-5" data-reveal aria-hidden="true">
            <span class="uc-node"></span>
            <span class="uc-thread-line"></span>
            <span class="uc-node uc-node--rosso"></span>
          </div>
          <T as="p" class="slide-eyebrow text-[var(--accent-primary)] mb-5" data-reveal data-reveal-delay="0.06" en="MARCO'S STORY · STEP 2 OF 10" it="STORIA DI MARCO · PASSO 2 DI 10" />
          <T
            as="h2"
            class="slide-title text-[var(--ink-primary)] mb-6"
            style="font-size: clamp(2rem, 3.8vw, 3.5rem);"
            data-reveal
            data-reveal-delay="0.1"
            en="RT-CDP: UniCredit already knew who Marco was"
            it="RT-CDP: UniCredit sapeva già chi era Marco"
          />
          <T
            as="p"
            class="text-[var(--ink-secondary)] leading-relaxed mb-6"
            style="font-size: clamp(1rem, 1.4vw, 1.25rem);"
            data-reveal
            data-reveal-delay="0.2"
            en={`Marco wasn't even logged in. From an anonymous click, in 200ms the Real-Time CDP reassembled his identity and joined 2 years of transaction history, his in-app behavior, the November branch visit and the "mutuo casa" search from 3 days ago. Propensity: 87/100. It's the same engine that serves existing clients and that, in acquisition, catches the people the bank doesn't know yet.`}
            it={`Marco non era nemmeno loggato. Dal click anonimo, in 200ms il Real-Time CDP ha ricomposto la sua identità e unito 2 anni di storico transazionale, il comportamento nell'app, la visita in filiale a novembre e la ricerca "mutuo casa" di 3 giorni fa. Propensione: 87/100. È lo stesso motore che serve i clienti storici e che, in acquisition, intercetta chi la banca ancora non conosce.`}
          />
          <div class="uc-quote" data-reveal data-reveal-delay="0.45">
            <T as="p" class="text-sm font-semibold tracking-wider uppercase text-[var(--ink-tertiary)] mb-2" en="Marco, right now" it="Marco, in questo momento" />
            <T as="p" class="uc-quote-text" en="«The system didn't see just any client: it saw Marco, with his history, his goal and a precise moment in his life.»" it="«Il sistema non ha visto un cliente qualsiasi: ha visto Marco, con la sua storia, il suo obiettivo e un momento preciso di vita.»" />
          </div>
        </div>
      </div>
    </Slide>

    <!-- ── SLIDE 2: Marco + dati frammentati ─────────────────────── -->
    <Slide id="slide-persona" bg="primary" align="split">
      <div class="uc-bg w-full flex-1 min-h-0 grid md:grid-cols-2 gap-10 md:gap-16 items-center rounded-sm">
        <div class="text-left">
          <T as="p" class="slide-eyebrow text-[var(--accent-primary)] mb-4" data-reveal en="THE PROBLEM" it="IL PROBLEMA" />
          <T
            as="h2"
            class="slide-title text-[var(--ink-primary)] mb-4"
            style="font-size: clamp(2rem, 3.9vw, 3.4rem);"
            data-reveal
            data-reveal-delay="0.1"
            en="Marco uses 6 channels.<br/>The bank has no idea."
            it="Marco usa 6 canali.<br/>La banca non lo sa."
          />
          <div class="uc-panel uc-panel--oro mb-3" data-reveal data-reveal-delay="0.2">
            <div class="uc-panel-head">
              <T as="span" class="uc-tag" en="The client" it="Il cliente" />
              <T as="span" class="uc-src" en="Client for 12 years" it="Cliente da 12 anni" />
            </div>
            <T as="p" class="text-sm font-semibold text-[var(--ink-primary)] mb-1" en="Marco Ferretti · 38 years · Brescia" it="Marco Ferretti · 38 anni · Brescia" />
            <T as="p" class="uc-panel-body" en={`UniCredit client for 12 years, a family and a house to buy. He uses the app every day and searched "mutuo casa" three times this week, but the bank never connected the dots.`} it={`Cliente UniCredit da 12 anni, una famiglia e una casa da comprare. Usa l'app tutti i giorni e ha cercato "mutuo casa" tre volte questa settimana, ma la banca non ha collegato i punti.`} />
          </div>
          <T
            as="p"
            class="text-[var(--ink-secondary)] text-sm leading-relaxed"
            data-reveal
            data-reveal-delay="0.3"
            en={`The problem isn't a shortage of data: <strong class="text-[var(--ink-primary)]">every system talks to itself</strong>. Marco's full profile doesn't exist anywhere yet.`}
            it={`Il problema non è la mancanza di dati: <strong class="text-[var(--ink-primary)]">ogni sistema parla da solo</strong>. Il profilo completo di Marco non esiste ancora in nessun posto.`}
          />
        </div>

        <div class="flex flex-col gap-3" data-reveal data-reveal-delay="0.35">
          {sources.map((s) => (
            <div class="uc-panel flex-row items-center gap-4" style="padding:0.85rem 1rem;">
              <span class="text-2xl flex-shrink-0" aria-hidden="true">{s.icon}</span>
              <div class="flex-1 min-w-0">
                <T as="p" class="text-sm font-medium text-[var(--ink-primary)]" en={s.label.en} it={s.label.it} />
                <T as="p" class="text-xs text-[var(--ink-tertiary)]" en={s.count.en} it={s.count.it} />
              </div>
              <T as="span" class="text-sm font-semibold uppercase tracking-wide flex-shrink-0" style="color: rgba(190,32,39,1); background: rgba(190,32,39,0.1); padding: 0.1rem 0.55rem; border-radius: 9999px;" en="isolated" it="isolato" />
            </div>
          ))}
          <T as="p" class="uc-src mt-1" en="Channels and volumes · illustrative scenario" it="Canali e volumi · scenario illustrativo" />
        </div>
      </div>
    </Slide>

    <!-- ── SLIDE 2: Real-Time CDP — unificazione ─────────────────── -->
    <Slide id="slide-cdp" bg="inverse" align="center">
      <SlideBackdrop
        slot="backdrop"
        {...mediaProps('bg-digital-blue')}
        imageClass="opacity-15"
        scrim="bg-[var(--surface-inverse)]/87"
      />
      <div data-demo-flex class="w-full flex items-start gap-8">
        <div class="flex-1 min-w-0 flex flex-col items-center">
          <T as="p" class="slide-eyebrow text-[var(--color-grigio-300)] mb-5" data-reveal en="ADOBE REAL-TIME CDP" it="ADOBE REAL-TIME CDP" />
          <T
            as="h2"
            class="slide-title text-[var(--ink-inverse)] mb-10"
            style="font-size: clamp(2.25rem, 4.4vw, 4rem);"
            data-reveal
            data-reveal-delay="0.1"
            en="One profile. In real time."
            it="Un profilo. In tempo reale."
          />

          <div
            class="w-full max-w-5xl mx-auto grid grid-cols-[1fr_72px_1fr] gap-4 items-center"
            data-reveal
            data-reveal-delay="0.2"
          >
            <!-- Sorgenti -->
            <div class="flex flex-col gap-2">
              {sources.map((s) => (
                <div class="flex items-center gap-3 p-3 border rounded-sm text-sm" style="background: rgba(107,114,128,0.15); border-color: rgba(107,114,128,0.25); color: var(--color-grigio-300);">
                  <span aria-hidden="true">{s.icon}</span>
                  <T en={s.label.en} it={s.label.it} />
                </div>
              ))}
            </div>

            <!-- CDP hub — il filo oro converge sull'hub rosso -->
            <div class="flex flex-col items-center gap-2">
              <div class="w-px flex-1" style="background: linear-gradient(to bottom, transparent, var(--color-oro));" aria-hidden="true"></div>
              <div class="w-14 h-14 rounded-full flex items-center justify-center text-white text-sm font-semibold text-center leading-tight px-1 flex-shrink-0" style="background: var(--color-rosso);">
                Real-Time CDP
              </div>
              <div class="w-px flex-1" style="background: linear-gradient(to bottom, var(--color-oro), transparent);" aria-hidden="true"></div>
            </div>

            <!-- Profilo unificato -->
            <div class="p-5 border rounded-sm h-full flex flex-col justify-center" style="background: rgba(190,32,39,0.1); border-color: rgba(190,32,39,0.35);">
              <T as="p" class="text-sm font-semibold uppercase tracking-widest mb-4" style="color: rgba(190,32,39,1);" en="Unified profile" it="Profilo unificato" />
              {profileAttribs.map((a) => (
                <div class="mb-3 last:mb-0">
                  <T as="span" class="block text-sm text-[var(--color-grigio-400)] uppercase tracking-wide mb-0.5" en={a.label.en} it={a.label.it} />
                  <T as="span" class="text-xs text-[var(--ink-inverse)] leading-snug" en={a.value.en} it={a.value.it} />
                </div>
              ))}
            </div>
          </div>
          <T as="p" class="mt-6 text-center text-[0.62rem] tracking-widest uppercase text-[var(--ink-inverse)]/30" en="Source: Adobe Real-Time CDP · banking sector benchmark, Forrester TEI, Adobe AEP, 2023" it="Fonte: Adobe Real-Time CDP · benchmark settore bancario, Forrester TEI, Adobe AEP, 2023" />
        </div>
        <MediaDemoSlot id="conosci-rtcdp-demo" label="RT-CDP — Unified Profile Screenshot" />
      </div>
    </Slide>

    <!-- ── SLIDE 3: RT-CDP Collaboration for Brands ─────────────── -->
    <Slide id="slide-data-collab" bg="inverse" align="center">
      <SlideBackdrop
        slot="backdrop"
        {...mediaProps('bg-digital-blue')}
        imageClass="opacity-10"
        scrim="bg-[var(--surface-inverse)]/88"
      />
      <div data-demo-flex class="w-full flex items-start gap-8">
        <div class="flex-1 min-w-0 flex flex-col items-center">
          <T as="p" class="slide-eyebrow text-[var(--color-grigio-300)] mb-5" data-reveal en="RT-CDP COLLABORATION FOR BRANDS" it="RT-CDP COLLABORATION FOR BRANDS" />
          <T
            as="h2"
            class="slide-title text-[var(--ink-inverse)] mb-5"
            style="font-size: clamp(2.25rem, 4.4vw, 4rem);"
            data-reveal
            data-reveal-delay="0.08"
            en="UniCredit's millions of profiles<br/>meet the outside world"
            it="I milioni di profili di UniCredit<br/>incontrano il mondo esterno"
          />
          <T
            as="p"
            class="text-[clamp(1.05rem,1.4vw,1.3rem)] text-[var(--color-grigio-300)] max-w-2xl mb-10"
            data-reveal
            data-reveal-delay="0.15"
            en="Privacy-safe, zero data movement. Work with publishers, retail media and partners to acquire new clients and measure impact, without ever exposing UniCredit's first-party data."
            it="Privacy-safe, zero data movement. Collabora con publisher, retail media e partner per acquisire nuovi clienti e misurare l'impatto, senza mai esporre i dati proprietari UniCredit."
          />

          <div
            class="w-full max-w-5xl mx-auto grid md:grid-cols-3 gap-5 mb-8"
            data-reveal
            data-reveal-delay="0.22"
          >
            {[
              { label: { en: 'Acquisition', it: 'Acquisizione' }, body: { en: 'Reaches prospects the bank doesn\'t know yet: lookalikes of high-value clients across partner media networks, without ever sharing RT-CDP profiles.', it: 'Raggiunge prospect che la banca ancora non conosce: lookalike dei clienti alto-valore sui media network partner, senza mai condividere i profili RT-CDP.' } },
              { label: { en: 'Enrichment', it: 'Arricchimento' }, body: { en: 'Adds behavioral signals from retail partners and open banking to complete the client profile, in line with GDPR.', it: 'Integra segnali comportamentali di partner retail e open banking per completare il profilo cliente, nel rispetto del GDPR.' } },
              { label: { en: 'Measurement', it: 'Misurazione' }, body: { en: 'Close-loop measurement: from the media network campaign to the mortgage signature, without cross-brand tracking.', it: 'Close-loop measurement: dalla campagna su media network alla firma del mutuo, senza cross-brand tracking.' } },
            ].map((item) => (
              <div class="p-5 border rounded-sm text-left" style="background: rgba(107,114,128,0.12); border-color: rgba(107,114,128,0.25);">
                <T as="p" class="text-sm font-semibold uppercase tracking-wide mb-2" style="color: rgba(201,169,110,1);" en={item.label.en} it={item.label.it} />
                <T as="p" class="text-sm text-[var(--color-grigio-300)] leading-relaxed" en={item.body.en} it={item.body.it} />
              </div>
            ))}
          </div>

          <div
            class="w-full max-w-5xl mx-auto grid md:grid-cols-4 gap-4"
            data-reveal
            data-reveal-delay="0.3"
          >
            {[
              { partner: { en: 'Retail Media Network', it: 'Retail Media Network' }, example: { en: 'Esselunga, Carrefour', it: 'Esselunga, Carrefour' } },
              { partner: { en: 'Open Banking', it: 'Open Banking' }, example: { en: 'consented PSD2/3 APIs', it: 'API PSD2/3 consensuate' } },
              { partner: { en: 'Digital Publishers', it: 'Publisher Digitali' }, example: { en: 'news, editorial, finance', it: 'news, editorial, finance' } },
              { partner: { en: 'Co-marketing', it: 'Co-marketing' }, example: { en: 'insurance partners', it: 'partner assicurativi' } },
            ].map((p) => (
              <div class="p-3 border rounded-sm text-center" style="background: rgba(107,114,128,0.08); border-color: rgba(107,114,128,0.2);">
                <T as="p" class="text-xs font-semibold text-[var(--ink-inverse)] mb-0.5" en={p.partner.en} it={p.partner.it} />
                <T as="p" class="text-xs text-[var(--color-grigio-400)]" en={p.example.en} it={p.example.it} />
              </div>
            ))}
          </div>
          <T as="p" class="mt-6 text-center text-[0.62rem] tracking-widest uppercase text-[var(--ink-inverse)]/30" en="Source: Forrester, State of Data Collaboration, 2024 · 51% of agencies and brands use or plan data collaboration with publishers and media networks" it="Fonte: Forrester, State of Data Collaboration, 2024 · 51% agenzie e brand usa o pianifica data collaboration con publisher e media network" />
        </div>
        <MediaDemoSlot id="conosci-data-collab-demo" label="RT-CDP Collaboration — Demo" />
      </div>
    </Slide>

    <!-- ── SLIDE 4: Capabilities → next-best-experience ───────────── -->
    <Slide id="slide-nba" bg="primary" align="center">
      <div class="uc-bg w-full flex-1 min-h-0 flex flex-col items-center justify-center rounded-sm">
        <T as="p" class="slide-eyebrow text-center text-[var(--accent-primary)] mb-5" data-reveal en="WHAT BECOMES POSSIBLE" it="COSA DIVENTA POSSIBILE" />
        <T
          as="h2"
          class="slide-title text-[var(--ink-primary)] mb-6"
          style="font-size: clamp(2.25rem, 4.4vw, 4rem);"
          data-reveal
          data-reveal-delay="0.1"
          en="From data to action,<br/>in milliseconds"
          it="Dal dato all'azione,<br/>in millisecondi"
        />

        <div
          class="w-full max-w-4xl mx-auto grid md:grid-cols-2 gap-5 mb-8"
          data-reveal
          data-reveal-delay="0.2"
        >
          {capabilities.map((cap, i) => (
            <div class="uc-card">
              <span class="uc-mark">{i + 1}</span>
              <T as="p" class="uc-card-title" style={`color: ${cap.color};`} en={cap.label.en} it={cap.label.it} />
              <T as="p" class="uc-card-body" en={cap.body.en} it={cap.body.it} />
            </div>
          ))}
        </div>

        <div data-reveal data-reveal-delay="0.4">
          <a
            href={href(base, '/acquisisci')}
            class="inline-flex items-center gap-3 px-10 py-5 text-[clamp(1.05rem,1.3vw,1.3rem)] font-medium tracking-wide bg-[var(--accent-primary)] text-[var(--ink-inverse)] hover:opacity-90 transition-opacity duration-300"
          >
            <T en="Acquire, digitally" it="Acquisisci digitale" />
            <svg width="20" height="20" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        </div>
      </div>
    </Slide>

  </DeckContainer>
</BaseLayout>
