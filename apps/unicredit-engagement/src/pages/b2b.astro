---
import BaseLayout from '../layouts/BaseLayout.astro';
import UniNavigation from '../components/UniNavigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import CoverHero from '@edf/core/blocks/CoverHero.astro';
import SlideBackdrop from '@edf/core/blocks/SlideBackdrop.astro';
import { href } from '@edf/core/utils/url.js';
import T from '@edf/core/blocks/i18n/T.astro';
import { mediaProps } from '../../assets.index';

const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;

const rmInsights = [
  { label: { it: 'Fatturato aziendale', en: 'Company revenue' }, value: { it: '€4.2M · crescita +11% YoY', en: '€4.2M · +11% YoY growth' }, source: 'Open Banking' },
  { label: { it: 'Flussi di cassa', en: 'Cash flows' }, value: { it: 'Stagionalità agosto–settembre', en: 'August–September seasonality' }, source: { it: 'Conto corrente business', en: 'Business current account' } },
  { label: { it: 'Propensity leasing', en: 'Leasing propensity' }, value: { it: 'Score 79/100 · flotta auto', en: 'Score 79/100 · vehicle fleet' }, source: 'AEP + CJA' },
  { label: { it: 'Evento triggering', en: 'Triggering event' }, value: { it: 'Ha visitato "/finanziamenti-aziendali" × 4', en: 'Visited "/finanziamenti-aziendali" × 4' }, source: 'CDP real-time' },
  { label: { it: 'Prossima scadenza', en: 'Next maturity' }, value: { it: 'Mutuo sede operativa: 18 mesi', en: 'Premises mortgage: 18 months' }, source: 'Core banking' },
];

const ajoB2bFeatures = [
  { label: 'Buying group orchestration', body: { it: "AJO B2B identifica tutti i decision-maker dell'azienda (CEO, CFO, RM) e orchestra touchpoint coerenti per ognuno.", en: 'AJO B2B identifies every decision-maker in the company (CEO, CFO, RM) and orchestrates consistent touchpoints for each one.' } },
  { label: 'Account-based journeys', body: { it: 'Campagne e sequenze dedicate per ogni azienda cliente, con contenuti personalizzati per settore e dimensione.', en: 'Dedicated campaigns and sequences for every client company, with content tailored to sector and size.' } },
  { label: 'RM enablement', body: { it: "Il Relationship Manager riceve suggerimenti AI in tempo reale prima di ogni interazione, con next-best-experience calcolata.", en: 'The Relationship Manager gets real-time AI suggestions before every interaction, with a calculated next-best-experience.' } },
  { label: 'Marketo integration', body: { it: 'Pipeline B2B corporate integrata con Marketo: lead scoring, nurturing, handoff automatico al team Sales Enterprise.', en: 'Corporate B2B pipeline integrated with Marketo: lead scoring, nurturing, automatic handoff to the Sales Enterprise team.' } },
];

const b2bKpis = [
  { stat: '↑', label: { it: 'deal velocity per PMI', en: 'deal velocity for SMEs' }, sub: { it: 'con account-based journeys', en: 'with account-based journeys' } },
  { stat: '↑', label: { it: 'penetrazione prodotti per azienda', en: 'product penetration per company' }, sub: { it: 'grazie al cross-sell intelligente', en: 'thanks to smart cross-sell' } },
  { stat: '↓', label: { it: 'tempo preparazione meeting RM', en: 'RM meeting prep time' }, sub: { it: 'con AI insights automatici', en: 'with automated AI insights' } },
];
---
<BaseLayout
  title="Banking per le imprese"
  description="AJO B2B e Marketo portano la personalizzazione enterprise al livello del business banking UniCredit."
  pageSolutions={['ajo-b2b', 'marketo']}
>
  <div class="fixed top-0 left-0 right-0 z-50">
    <UniNavigation currentPath={currentPath} base={base} />
  </div>

  <DeckContainer nextHref={href(base, '/motore-adobe')} prevHref={href(base, '/coworker')}>

    <!-- ── SLIDE 0: Cover ─────────────────────────────────────────── -->
    <Slide id="slide-cover" bg="secondary" align="center">
      <SlideBackdrop
        slot="backdrop"
        {...mediaProps('business-meeting')}
        imageClass="opacity-15"
        scrim="bg-[var(--surface-secondary)]/82"
      />
      <span data-lang-it class="contents">
        <CoverHero
          eyebrow="08 · B2B"
          numeral="08"
          title="Banking per le imprese"
          lead="Adriana guida la tesoreria di una PMI manifatturiera. Vuole una banca che anticipi i bisogni della sua azienda, non che aspetti la sua chiamata. Qui la relazione B2B diventa un vantaggio."
          size="phase"
          tone="ink"
          signature={false}
        />
      </span>
      <span data-lang-en class="contents">
        <CoverHero
          eyebrow="08 · B2B"
          numeral="08"
          title="Banking for businesses"
          lead="Adriana runs treasury at a manufacturing SME. She wants a bank that anticipates her company's needs, not one that waits for her call. Here the B2B relationship becomes an advantage."
          size="phase"
          tone="ink"
          signature={false}
        />
      </span>
    </Slide>

    <!-- ── SLIDE 1: Adriana + esigenze B2B ───────────────────────── -->
    <Slide id="slide-adriana" bg="primary" align="split">
      <div class="uc-b2b-bg" aria-hidden="true"></div>
      <div class="w-full flex-1 min-h-0 grid md:grid-cols-2 gap-10 md:gap-14 items-center relative">
        <div class="text-left">
          <T as="p" class="slide-eyebrow text-[var(--accent-primary)] mb-4" data-reveal it="IL CLIENTE BUSINESS" en="THE BUSINESS CLIENT" />
          <T
            as="h2"
            class="slide-title text-[var(--ink-primary)] mb-5"
            style="font-size: clamp(2.25rem, 4.4vw, 4rem);"
            data-reveal
            data-reveal-delay="0.1"
            it="Adriana cerca un partner,<br/>non solo una banca"
            en="Adriana wants a partner,<br/>not just a bank"
          />

          <div class="uc-thread mb-5" data-reveal data-reveal-delay="0.16">
            <span class="uc-node"></span>
            <span class="uc-thread-line"></span>
            <span class="uc-node uc-node--rosso"></span>
          </div>

          <div class="uc-panel uc-panel--oro mb-4" data-reveal data-reveal-delay="0.2">
            <div class="uc-panel-head">
              <span class="uc-figure">Adriana Conti</span>
              <T as="span" class="uc-tag" it="CFO · 8 anni" en="CFO · 8 years" />
            </div>
            <T as="p" class="uc-panel-body" it="CFO di una PMI manifatturiera con 45 dipendenti. Cliente UniCredit Business da 8 anni. Gestisce liquidità, finanziamenti e pagamenti internazionali. Vuole proattività: il suo RM dovrebbe anticipare i suoi bisogni, non aspettare che lei chiami." en="CFO of a manufacturing SME with 45 employees. A UniCredit Business client for 8 years. She handles liquidity, financing and international payments. She wants proactivity: her RM should anticipate her needs, not wait for her to call." />
            <T as="p" class="uc-src" it="PMI manifatturiera · 45 dipendenti" en="Manufacturing SME · 45 employees" />
          </div>

          <T as="p" class="text-[var(--ink-secondary)] leading-relaxed" style="font-size:0.98rem;" data-reveal data-reveal-delay="0.3"
            it={'Con 250.000 aziende clienti, la sfida di UniCredit è dare a ognuna il servizio su misura di un private banker, <strong class="text-[var(--ink-primary)]">in modo scalabile</strong>.'}
            en={"With 250,000 corporate clients, UniCredit's challenge is to give each one the tailored service of a private banker, <strong class=\"text-[var(--ink-primary)]\">at scale</strong>."}
          />

          <div class="uc-quote" data-reveal data-reveal-delay="0.45">
            <T as="p" class="text-xs font-semibold tracking-wider uppercase text-[var(--ink-tertiary)] mb-2" it="Adriana, in questo momento" en="Adriana, right now" />
            <T as="p" class="uc-quote-text" it="«Il suo Relationship Manager — preparato da Coworker AI — la chiama prima della scadenza del mutuo di sede: ha già pronte tre opzioni di rifinanziamento e un piano di tesoreria. Adriana non aveva ancora chiesto nulla.»" en="&laquo;Her Relationship Manager, briefed by Coworker AI, calls before the premises mortgage matures: three refinancing options and a treasury plan are already prepared. Adriana hadn't asked for anything yet.&raquo;" />
          </div>
        </div>

        <div class="uc-panel uc-panel--rosso" data-reveal data-reveal-delay="0.35">
          <T as="p" class="uc-tag mb-3" it="Profilo aziendale · AI Insights per il RM" en="Company profile · AI Insights for the RM" />
          <div class="flex flex-col gap-2">
            {rmInsights.map((ins) => (
              <div class="uc-b2b-insight">
                <div class="flex-1 min-w-0">
                  <T as="p" class="uc-b2b-insight-label" en={ins.label.en} it={ins.label.it} />
                  <T as="p" class="uc-b2b-insight-value" en={ins.value.en} it={ins.value.it} />
                </div>
                {typeof ins.source === 'string'
                  ? <span class="uc-b2b-insight-src">{ins.source}</span>
                  : <T as="span" class="uc-b2b-insight-src" en={ins.source.en} it={ins.source.it} />}
              </div>
            ))}
          </div>
        </div>
      </div>
    </Slide>

    <!-- ── SLIDE 2: AJO B2B features ─────────────────────────────── -->
    <Slide id="slide-ajo-b2b" bg="inverse" align="center">
      <SlideBackdrop
        slot="backdrop"
        {...mediaProps('bg-digital-blue')}
        imageClass="opacity-12"
        scrim="bg-[var(--surface-inverse)]/88"
      />
      <p class="slide-eyebrow text-center text-[var(--color-grigio-300)] mb-5" data-reveal>JOURNEY OPTIMIZER B2B + MARKETO</p>
      <T
        as="h2"
        class="slide-title text-[var(--ink-inverse)] mb-6"
        style="font-size: clamp(2.25rem, 4.4vw, 4rem);"
        data-reveal
        data-reveal-delay="0.1"
        it="Il consulente aumentato dall'AI"
        en="The advisor, augmented by AI"
      />

      <div class="uc-thread mb-8 max-w-5xl mx-auto w-full" data-reveal data-reveal-delay="0.16">
        <span class="uc-node uc-node--rosso"></span>
        <span class="uc-thread-line"></span>
        <span class="uc-node"></span>
      </div>

      <div
        class="w-full max-w-5xl mx-auto grid md:grid-cols-2 gap-5"
        data-reveal
        data-reveal-delay="0.2"
      >
        {ajoB2bFeatures.map((f) => (
          <div class="uc-panel uc-panel--oro text-left">
            <p class="uc-b2b-feature-label">{f.label}</p>
            <T as="p" class="uc-panel-body" style="margin-bottom:0;" en={f.body.en} it={f.body.it} />
          </div>
        ))}
      </div>

      <div class="uc-quote max-w-3xl mx-auto text-left" data-reveal data-reveal-delay="0.45">
        <T as="p" class="text-xs font-semibold tracking-wider uppercase text-[var(--color-grigio-300)] mb-2" it="Adriana, in questo momento" en="Adriana, right now" />
        <T as="p" class="uc-quote-text" style="color: var(--color-crema);" it="«AJO B2B ha mappato il buying group dell'azienda di Adriana: lei come CFO, il CEO e il responsabile acquisti. Ognuno ha ricevuto comunicazioni diverse, calibrate sul suo ruolo nella decisione.»" en="&laquo;AJO B2B has mapped the buying group at Adriana's company: her as CFO, the CEO and the head of procurement. Each received different messages, calibrated to their role in the decision.&raquo;" />
      </div>
    </Slide>

    <!-- ── SLIDE 3: KPI risultati B2B ─────────────────────────────── -->
    <Slide id="slide-kpi-b2b" bg="primary" align="center">
      <div class="uc-b2b-bg" aria-hidden="true"></div>
      <T as="p" class="slide-eyebrow text-center text-[var(--accent-primary)] mb-5 relative" data-reveal it="IMPATTO BUSINESS" en="BUSINESS IMPACT" />
      <T
        as="h2"
        class="slide-title text-[var(--ink-primary)] mb-6 relative"
        style="font-size: clamp(2.25rem, 4.4vw, 4rem);"
        data-reveal
        data-reveal-delay="0.1"
        it="Il bancario di relazione<br/>torna a fare la differenza"
        en="Relationship banking<br/>makes the difference again"
      />

      <div class="uc-thread mb-8 max-w-3xl mx-auto w-full relative" data-reveal data-reveal-delay="0.16">
        <span class="uc-node"></span>
        <span class="uc-thread-line"></span>
        <span class="uc-node uc-node--rosso"></span>
      </div>

      <div
        class="w-full max-w-3xl mx-auto grid md:grid-cols-3 gap-6 mb-10 relative"
        data-reveal
        data-reveal-delay="0.2"
      >
        {b2bKpis.map((k) => (
          <div class="uc-panel uc-panel--oro text-center" style="align-items:center;">
            <p class="uc-b2b-kpi-stat">{k.stat}</p>
            <T as="p" class="uc-b2b-kpi-label" en={k.label.en} it={k.label.it} />
            <T as="p" class="uc-b2b-kpi-sub" en={k.sub.en} it={k.sub.it} />
          </div>
        ))}
      </div>

      <div class="relative" data-reveal data-reveal-delay="0.4">
        <a
          href={href(base, '/motore-adobe')}
          class="inline-flex items-center gap-3 px-10 py-5 text-[clamp(1.05rem,1.3vw,1.3rem)] font-medium tracking-wide bg-[var(--accent-primary)] text-[var(--ink-inverse)] hover:opacity-90 transition-opacity duration-300"
        >
          <T it="Il motore Adobe" en="The Adobe engine" />
          <svg width="20" height="20" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>
      <T as="p" class="mt-6 text-center text-[0.62rem] tracking-widest uppercase opacity-30 relative" it="Fonte: Adobe Journey Optimizer B2B Edition benchmark · banking europeo, Forrester TEI, Adobe Experience Cloud, 2023" en="Source: Adobe Journey Optimizer B2B Edition benchmark · European banking, Forrester TEI, Adobe Experience Cloud, 2023" />
    </Slide>

  </DeckContainer>

<style>
  /* B2B — gold-thread depth background scoped to this page's light slides */
  .uc-b2b-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(120% 75% at 12% 0%, rgba(190,32,39,0.05), transparent 55%),
      radial-gradient(115% 85% at 90% 100%, rgba(201,169,110,0.12), transparent 55%);
  }

  /* Insight rows inside the rosso profile panel */
  .uc-b2b-insight {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 0.7rem 0.85rem;
    background: rgba(26,26,46,0.03);
    border: 1px solid rgba(26,26,46,0.1);
    border-radius: 4px;
  }
  .uc-b2b-insight-label { font-size: 0.82rem; font-weight: 600; color: var(--color-blu-notte); line-height: 1.3; }
  .uc-b2b-insight-value { font-size: 0.95rem; color: var(--color-blu-medio); line-height: 1.4; margin-top: 0.15rem; }
  .uc-b2b-insight-src {
    flex-shrink: 0;
    font-size: 0.72rem;
    letter-spacing: 0.02em;
    color: var(--color-grigio-400);
    background: rgba(201,169,110,0.12);
    border: 1px solid rgba(201,169,110,0.3);
    padding: 0.1rem 0.5rem;
    border-radius: 3px;
    margin-top: 0.1rem;
  }

  /* AJO feature label — gold accent lead-in */
  .uc-b2b-feature-label { font-size: 1.02rem; font-weight: 700; color: var(--color-blu-notte); margin-bottom: 0.5rem; }

  /* KPI stat within the oro panel */
  .uc-b2b-kpi-stat {
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--color-rosso);
    line-height: 1;
    margin-bottom: 0.6rem;
    font-size: clamp(2.25rem, 4vw, 3.5rem);
  }
  .uc-b2b-kpi-label { font-size: 0.98rem; font-weight: 600; color: var(--color-blu-notte); line-height: 1.3; margin-bottom: 0.4rem; }
  .uc-b2b-kpi-sub { font-size: 0.82rem; color: var(--color-blu-medio); line-height: 1.4; }
</style>
</BaseLayout>
