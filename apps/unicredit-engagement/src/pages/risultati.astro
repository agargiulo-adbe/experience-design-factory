---
import BaseLayout from '../layouts/BaseLayout.astro';
import UniNavigation from '../components/UniNavigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import SlideBackdrop from '@edf/core/blocks/SlideBackdrop.astro';
import { href } from '@edf/core/utils/url.js';
import T from '@edf/core/blocks/i18n/T.astro';
import UcCover from '../components/UcCover.astro';
import { mediaProps } from '../../assets.index';

const base = import.meta.env.BASE_URL;
// Clip Firefly di chiusura (GitHub Release `media`, git-ignored in locale) + poster in /public/media.
const CLOSE_VIDEO = 'https://github.com/agargiulo-adbe/experience-design-factory/releases/download/media/uc-close.mp4';
const closePoster = `${base.replace(/\/?$/, '/')}media/uc-close.poster.jpg`;
const demoOrder = [
  { n: '01', name: { en: 'Content management', it: 'Gestione contenuti' } },
  { n: '02', name: { en: 'Content optimization', it: 'Ottimizzazione contenuti' } },
  { n: '03', name: { en: 'Brand Concierge', it: 'Brand Concierge' } },
  { n: '04', name: { en: 'Performance marketing', it: 'Performance marketing' } },
  { n: '05', name: { en: 'Journey analytics', it: 'Journey analytics' } },
  { n: '06', name: { en: 'Agentic workflows', it: 'Workflow agentici' } },
];
const currentPath = Astro.url.pathname;

const topMetrics = [
  { stat: '19×', label: { en: 'lift in CDP conversions', it: 'aumento conversioni CDP' }, sub: { en: 'US Bank · personalized campaigns vs broadcast', it: 'US Bank · campagne personalizzate vs broadcast' }, data: '19' },
  { stat: '+127%', label: { en: 'new accounts opened', it: 'nuovi conti aperti' }, sub: { en: 'with AJO digital onboarding', it: 'con onboarding digitale AJO' }, data: '127' },
  { stat: '10×', label: { en: 'content production speed', it: 'velocità produzione contenuti' }, sub: { en: 'GenStudio vs. the traditional process', it: 'GenStudio vs. processo tradizionale' }, data: '10' },
];

const caseStudies = [
  {
    bank: 'US Bank',
    country: { en: 'United States', it: 'Stati Uniti' },
    challenge: { en: 'Personalize campaigns across 70M customers without growing the creative team.', it: 'Personalizzare le campagne su 70M di clienti senza ampliare il team creativo.' },
    solution: 'Adobe Real-Time CDP + Journey Optimizer + GenStudio',
    result: { en: '19× lift in conversions · –60% cost per acquisition · +2700% AI-driven traffic', it: '19× aumento conversioni · –60% costo per acquisizione · +2700% traffico AI-driven' },
    relevance: { en: 'Comparable scale, same goal: reach and relevance together.', it: 'Dimensioni comparabili, stesso obiettivo: scala e rilevanza insieme.' },
    pages: 'conosci,acquisisci,contenuti',
  },
  {
    bank: 'Itaú Unibanco',
    country: { en: 'Brazil', it: 'Brasile' },
    challenge: { en: 'Unify data on 55M customers from 12+ legacy systems into a single profile.', it: 'Unificare i dati di 55M di clienti da 12+ sistemi legacy in un profilo unico.' },
    solution: 'Adobe Experience Platform · Real-Time CDP · Customer Journey Analytics',
    result: { en: '+42% engagement on personalized campaigns · 90% shorter campaign time-to-market', it: '+42% engagement campagne personalizzate · 90% riduzione time-to-market campagne' },
    relevance: { en: 'Legacy architecture and data stack close to UniCredit.', it: 'Architettura legacy e stack dati simili a UniCredit.' },
    pages: 'conosci,analizza',
  },
  {
    bank: 'TSB Bank',
    country: 'UK',
    challenge: { en: 'Make digital touchpoints more relevant without raising the volume of messages.', it: 'Aumentare la rilevanza dei touchpoint digitali senza alzare il volume di comunicazioni.' },
    solution: 'Adobe Journey Optimizer · Adobe Target · Real-Time CDP',
    result: { en: '+31% digital NPS · –28% email opt-outs · 4× retention on at-risk customers', it: '+31% NPS digitale · –28% opt-out email · 4× retention su clienti a rischio churn' },
    relevance: { en: 'European retail banking, focused on engagement and churn.', it: 'Retail banking europeo, focus su engagement e churn.' },
    pages: 'conosci,acquisisci,coinvolgi',
  },
  {
    bank: 'Deutsche Bank',
    country: { en: 'Germany', it: 'Germania' },
    challenge: { en: 'Modernize acquisition with AI-driven SEO and cut content time-to-market.', it: "Modernizzare l'acquisizione con SEO AI-driven e ridurre il time-to-market dei contenuti." },
    solution: 'AEM Sites Edge Delivery · Real-Time CDP · Customer Journey Analytics',
    result: { en: '+45% organic traffic · –35% content production time · 3× go-to-market speed', it: '+45% traffico organico · –35% tempo produzione contenuti · 3× velocità go-to-market' },
    relevance: { en: 'Same European regulatory context and AEM Sites migration.', it: 'Stesso contesto regolatorio europeo e migrazione AEM Sites.' },
    pages: 'visibilita,conosci,analizza',
  },
  {
    bank: 'Crédit Agricole Italia',
    country: { en: 'Italy', it: 'Italia' },
    challenge: { en: 'Personalize messaging for 3M+ customers in a competitive retail and SME market.', it: 'Personalizzare le comunicazioni per 3M+ clienti in un mercato retail e PMI competitivo.' },
    solution: 'Adobe Journey Optimizer · GenStudio for Performance Marketing · Real-Time CDP',
    result: { en: '+67% email open rate · +42% digital lending conversions · –30% cost per lead', it: '+67% email open rate · +42% conversioni digital lending · –30% costo per lead' },
    relevance: { en: 'Direct competitor in Italy, same retail and SME segment.', it: 'Competitor diretto in Italia, stesso segmento retail e PMI.' },
    pages: 'acquisisci,contenuti',
  },
];

const unicreditRoi = [
  { label: { en: 'Operating costs', it: 'Costi operativi' }, value: '↓', sub: { en: 'campaign optimization + content automation', it: 'ottimizzazione campagne + automazione contenuti' } },
  { label: { en: 'Cost per acquisition', it: 'Costo per acquisition' }, value: '↓', sub: { en: 'sharper timing and targeting', it: 'timing e targeting più precisi' } },
  { label: { en: 'Customer lifetime value', it: 'Customer lifetime value' }, value: '↑', sub: { en: 'per actively digital customer', it: 'per cliente attivamente digitale' } },
  { label: { en: 'Campaign time-to-market', it: 'Time-to-market campagne' }, value: '↓', sub: { en: 'from weeks to days', it: 'da settimane a giorni' } },
];
---
<BaseLayout
  title="I risultati"
  description="19× conversioni, +127% conti digitali, 10× velocità contenuti. I benchmark banking reali con Adobe Experience Cloud."
>
  <div class="fixed top-0 left-0 right-0 z-50">
    <UniNavigation currentPath={currentPath} base={base} />
  </div>

  <DeckContainer nextHref={href(base, '/')} prevHref={href(base, '/coworker')}>

    <!-- ── SLIDE 0: Cover ─────────────────────────────────────────── -->
    <Slide id="slide-cover" bg="inverse" align="center">
      <SlideBackdrop
        slot="backdrop"
        {...mediaProps('results-growth')}
        imageClass="opacity-30"
        scrim="bg-[var(--surface-inverse)]/78"
      />
      <UcCover
        slug="risultati"
        title={{ en: 'What it earns', it: 'Quanto rende' }}
        lead={{ en: "Marco's numbers, the banks that already measure the impact, and the projection for UniCredit.", it: "I numeri di Marco, le banche che già misurano l'impatto e la proiezione per UniCredit." }}
        chips={[{ en: "Marco's journey in numbers", it: 'Il percorso di Marco in numeri' }, { en: 'Banking benchmarks', it: 'Benchmark banking' }, { en: 'UniCredit projection', it: 'Proiezione UniCredit' }]}
      />
    </Slide>

    <!-- ── SLIDE 0b: La storia di Marco — i numeri ──────── -->
    <Slide id="slide-storie-roi" bg="primary" align="center">
      <div class="ris-bg" data-slide-bg aria-hidden="true"></div>
      <T as="p" class="slide-eyebrow text-[var(--accent-primary)] mb-4" data-reveal en="ONE STORY. ONE SYSTEM." it="UNA STORIA. UN SISTEMA." />
      <T
        as="h2"
        class="slide-title text-[var(--ink-primary)] mb-8"
        style="font-size: clamp(2rem, 3.8vw, 3.5rem);"
        data-reveal
        data-reveal-delay="0.08"
        en="The real numbers behind Marco's journey"
        it="I numeri reali del percorso di Marco"
      />

      <div
        class="w-full max-w-5xl mx-auto grid md:grid-cols-2 gap-8"
        data-reveal
        data-reveal-delay="0.2"
      >
        <!-- Marco -->
        <div class="uc-panel uc-panel--rosso text-left">
          <div class="uc-panel-head">
            <T as="span" class="uc-tag" en="Marco Ferretti · Retail customer" it="Marco Ferretti · Cliente retail" />
            <T as="span" class="ris-persona-note" en="First-home mortgage" it="Mutuo prima casa" />
          </div>
          <div class="ris-rows">
            {[
              { stat: { en: "0.3s", it: "0,3s" }, label: { en: "personalized mortgage page (AEM EDS)", it: "pagina mutuo personalizzata (AEM EDS)" } },
              { stat: { en: "87/100", it: "87/100" }, label: { en: "home-mortgage propensity on first click", it: "propensity mutuo casa al primo click" } },
              { stat: { en: "1 AI touchpoint", it: "1 touchpoint AI" }, label: { en: "from ChatGPT to UniCredit", it: "da ChatGPT a UniCredit" } },
              { stat: { en: "0 queues", it: "0 code" }, label: { en: "fully digital mortgage request", it: "richiesta mutuo 100% digitale" } },
              { stat: { en: "12 years", it: "12 anni" }, label: { en: "UniCredit customer · a relationship that lasts", it: "cliente UniCredit · relazione che continua" } },
            ].map((r) => (
              <div class="ris-row">
                <T as="span" class="ris-row-fig ris-row-fig--rosso" en={r.stat.en} it={r.stat.it} />
                <T as="span" class="ris-row-label" en={r.label.en} it={r.label.it} />
              </div>
            ))}
          </div>
        </div>

        <!-- Marco — the relationship beyond the mortgage -->
        <div class="uc-panel uc-panel--oro text-left">
          <div class="uc-panel-head">
            <span class="uc-tag ris-tag--oro">Marco Ferretti · The relationship</span>
            <T as="span" class="ris-persona-note" en="Beyond the mortgage" it="Oltre il mutuo" />
          </div>
          <div class="ris-rows">
            {[
              { stat: { en: "1 profile", it: "1 profilo" }, label: { en: "app, branch and call centre finally aligned", it: "app, filiale e call center finalmente allineati" } },
              { stat: { en: "next best", it: "next best" }, label: { en: "the right offer at the right moment, not spam", it: "l'offerta giusta al momento giusto, non spam" } },
              { stat: { en: "3 products", it: "3 prodotti" }, label: { en: "mortgage, home insurance, salary account", it: "mutuo, polizza casa, conto stipendio" } },
              { stat: { en: "12 years", it: "12 anni" }, label: { en: "a customer recognised on every channel", it: "cliente riconosciuto su ogni canale" } },
              { stat: { en: "advocate", it: "promotore" }, label: { en: "recommends UniCredit to people he knows", it: "consiglia UniCredit a chi conosce" } },
            ].map((r) => (
              <div class="ris-row">
                <T as="span" class="ris-row-fig ris-row-fig--oro" en={r.stat.en} it={r.stat.it} />
                <T as="span" class="ris-row-label" en={r.label.en} it={r.label.it} />
              </div>
            ))}
          </div>
        </div>
      </div>
    </Slide>

    <!-- ── SLIDE 1: 3 metriche chiave ────────────────────────────── -->
    <Slide id="slide-metrics" bg="brand" align="center">
      <SlideBackdrop
        slot="backdrop"
        {...mediaProps('bg-digital-blue')}
        imageClass="opacity-10"
        scrim="bg-[var(--accent-primary)]/82"
      />
      <T as="p" class="slide-eyebrow text-[var(--ink-inverse)]/70 mb-8" data-reveal en="BANKING SECTOR BENCHMARKS" it="BENCHMARK SETTORE BANKING" />

      <div
        class="w-full max-w-4xl mx-auto grid md:grid-cols-3 gap-8"
        data-reveal
        data-reveal-delay="0.1"
      >
        {topMetrics.map((m) => (
          <div class="text-center">
            <p
              class="font-[family-name:var(--font-display)] font-light text-[var(--ink-inverse)] leading-none mb-3"
              style="font-size: clamp(3.5rem, 7vw, 6.5rem);"
              data-display
              data-count-up={m.data}
            >
              {m.stat}
            </p>
            <T as="p" class="text-base font-medium text-[var(--ink-inverse)] mb-1" en={m.label.en} it={m.label.it} />
            <T as="p" class="text-xs text-[var(--ink-inverse)]/60 leading-relaxed" en={m.sub.en} it={m.sub.it} />
          </div>
        ))}
      </div>
      <T as="p" class="mt-6 text-center text-[0.62rem] tracking-widest uppercase text-[var(--ink-inverse)]/30" en="Source: US Bank Adobe CDP reference case (Adobe Summit 2024) · Adobe Experience Cloud banking sector benchmark · content production benchmark" it="Fonte: US Bank Adobe CDP caso di riferimento (Adobe Summit 2024) · Adobe Experience Cloud benchmark settore bancario · benchmark produzione contenuti" />
    </Slide>

    <!-- ── SLIDE 2: Case studies ──────────────────────────────────── -->
    <Slide id="slide-cases" bg="primary" align="center">
      <div class="ris-bg" data-slide-bg aria-hidden="true"></div>
      <T as="p" class="slide-eyebrow text-[var(--accent-primary)] mb-3" data-reveal en="BANKING CASE STUDIES" it="CASE STUDY BANKING" />
      <T
        as="h2"
        class="slide-title text-[var(--ink-primary)] mb-3"
        style="font-size: clamp(1.8rem, 2.6vw, 2.85rem);"
        data-reveal
        data-reveal-delay="0.1"
        en="Who has already made the journey"
        it="Chi ha già fatto il percorso"
      />

      <div
        id="case-studies-grid"
        class="w-full max-w-6xl mx-auto flex flex-wrap justify-center gap-2.5"
        data-reveal
        data-reveal-delay="0.2"
      >
        {caseStudies.map((cs) => (
          <div class="case-study-card uc-panel uc-panel--rosso text-left md:w-[calc(33.33%-0.6rem)] !py-3" data-cs-pages={cs.pages}>
            <div class="uc-panel-head ris-case-head">
              <span class="uc-figure ris-case-bank">{cs.bank}</span>
              {typeof cs.country === 'string'
                ? <span class="ris-case-country">{cs.country}</span>
                : <T as="span" class="ris-case-country" en={cs.country.en} it={cs.country.it} />}
            </div>
            <T as="p" class="ris-case-challenge" en={cs.challenge.en} it={cs.challenge.it} />
            <T as="p" class="ris-case-result" en={cs.result.en} it={cs.result.it} />
            <T as="p" class="ris-case-relevance" en={cs.relevance.en} it={cs.relevance.it} />
          </div>
        ))}
      </div>
    </Slide>

    <!-- ── SLIDE 3: ROI proiezione UniCredit + CTA ────────────────── -->
    <Slide id="slide-roi" bg="inverse" align="center">
      <SlideBackdrop
        slot="backdrop"
        {...mediaProps('bg-digital-blue')}
        imageClass="opacity-15"
        scrim="bg-[var(--surface-inverse)]/85"
      />
      <T as="p" class="slide-eyebrow text-[var(--color-grigio-300)] mb-5" data-reveal en="UNICREDIT PROJECTION" it="PROIEZIONE UNICREDIT" />
      <T
        as="h2"
        class="slide-title text-[var(--ink-inverse)] mb-4"
        style="font-size: clamp(2rem, 3.2vw, 3rem);"
        data-reveal
        data-reveal-delay="0.1"
        en="The ROI of Engagement Unlimited"
        it="Il ROI di Engagement Unlimited"
      />

      <div
        class="w-full max-w-4xl mx-auto grid md:grid-cols-2 gap-3 mb-3"
        data-reveal
        data-reveal-delay="0.2"
      >
        {unicreditRoi.map((r) => (
          <div class="ris-roi-row">
            <p class="ris-roi-arrow">{r.value}</p>
            <div class="min-w-0">
              <T as="p" class="ris-roi-label" en={r.label.en} it={r.label.it} />
              <T as="p" class="ris-roi-sub" en={r.sub.en} it={r.sub.it} />
            </div>
          </div>
        ))}
      </div>

      <div
        class="w-full max-w-4xl mx-auto grid md:grid-cols-3 gap-3 mb-3"
        data-reveal
        data-reveal-delay="0.28"
      >
        {[
          { value: "↓", label: { en: "onboarding time", it: "tempo di onboarding" }, sub: { en: "guided by JO + AEM EDS", it: "guidato da JO + AEM EDS" } },
          { value: "↑", label: { en: "conversion rate", it: "conversion rate" }, sub: { en: "AEM EDS pages vs. legacy pages", it: "pagine AEM EDS vs. pagine legacy" } },
          { value: "↑", label: { en: "campaigns per month", it: "campagne al mese" }, sub: { en: "same team, thanks to Coworker", it: "con lo stesso team, grazie a Coworker" } },
        ].map((r) => (
          <div class="ris-roi-row">
            <p class="ris-roi-arrow ris-roi-arrow--sm">{r.value}</p>
            <div class="min-w-0">
              <T as="p" class="ris-roi-label ris-roi-label--sm" en={r.label.en} it={r.label.it} />
              <T as="p" class="ris-roi-sub ris-roi-sub--lg" en={r.sub.en} it={r.sub.it} />
            </div>
          </div>
        ))}
      </div>

      <T as="p" class="ris-roi-note" data-reveal data-reveal-delay="0.3"
        en="Projection based on banking sector benchmarks · US Bank, Itaú Unibanco, TSB, Deutsche Bank, Crédit Agricole Italia · adapted for the UniCredit retail portfolio"
        it="Proiezione basata su benchmark settore banking · US Bank, Itaú Unibanco, TSB, Deutsche Bank, Crédit Agricole Italia · adattata per il portafoglio retail UniCredit"
      />

      <div class="mt-4 flex flex-wrap gap-4 justify-center" data-reveal data-reveal-delay="0.5">
        <a
          href={href(base, '/')}
          class="inline-flex items-center gap-2 px-5 py-2 text-xs font-medium tracking-widest uppercase border border-[var(--ink-inverse)]/30 text-[var(--ink-inverse)]/50 hover:border-[var(--ink-inverse)]/60 hover:text-[var(--ink-inverse)]/80 transition-colors duration-300 rounded-sm"
        >
          <T en="Start the journey over →" it="Ricomincia il percorso →" />
        </a>
        <a
          href={href(base.replace('/unicredit-engagement', ''), '/console/unicredit-engagement')}
          class="inline-flex items-center gap-3 px-8 py-5 text-[clamp(1.05rem,1.3vw,1.3rem)] font-medium tracking-wide border border-[var(--ink-inverse)]/40 text-[var(--ink-inverse)] hover:border-[var(--ink-inverse)] transition-colors duration-300"
          data-admin-only
        >
          <T en="Configure the presentation" it="Configura la presentazione" />
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <rect x="2" y="2" width="5" height="5" rx="0.5"/>
            <rect x="9" y="2" width="5" height="5" rx="0.5"/>
            <rect x="2" y="9" width="5" height="5" rx="0.5"/>
            <rect x="9" y="9" width="5" height="5" rx="0.5"/>
          </svg>
        </a>
      </div>
    </Slide>

    <!-- ── SLIDE 4: Chiusura ──────────────────────────────────────── -->
    <Slide id="slide-close" bg="inverse" align="center">
      <Fragment slot="backdrop">
        <div class="uc-video-poster" style={`background-image: url(${closePoster});`} aria-hidden="true"></div>
        <video class="uc-video" autoplay muted loop playsinline preload="metadata" poster={closePoster} aria-hidden="true">
          <source src={CLOSE_VIDEO} type="video/mp4" />
        </video>
        <div class="uc-video-scrim" data-scrim aria-hidden="true"></div>
      </Fragment>
      <div class="w-full max-w-5xl mx-auto flex flex-col items-center text-center">
        <T as="p" class="slide-eyebrow text-center text-[var(--color-oro)] mb-5" data-reveal en="CLOSING" it="CHIUSURA" />
        <T as="h2" class="slide-title text-[var(--ink-inverse)] mb-5" style="font-size: clamp(2.4rem, 4.8vw, 4.4rem);" data-reveal data-reveal-delay="0.08"
          en="One customer. Six engines. One platform."
          it="Un cliente. Sei motori. Una piattaforma."
        />
        <T as="p" class="text-[clamp(1.1rem,1.5vw,1.45rem)] text-[var(--color-grigio-200)] max-w-3xl mb-8 leading-relaxed" data-reveal data-reveal-delay="0.15"
          en="Marco is not a fictional character: he is the customer UniCredit can serve as early as tomorrow. Everything he lived runs on Adobe Experience Platform. Now you see it live, in this order."
          it="Marco non è un personaggio di finzione: è il cliente che UniCredit può servire già da domani. Tutto quello che ha vissuto gira su Adobe Experience Platform. Adesso lo vedete dal vivo, in quest'ordine."
        />
        <ol class="uc-close-list" data-reveal data-reveal-delay="0.22">
          {demoOrder.map((d) => (
            <li class="uc-close-item"><span class="uc-close-n">{d.n}</span><T as="span" class="uc-close-name" en={d.name.en} it={d.name.it} /></li>
          ))}
        </ol>
        <p class="uc-cobrand mt-9" data-reveal data-reveal-delay="0.3"><span>UniCredit</span><span class="uc-cobrand-x">×</span><span>Adobe</span></p>
        <T as="p" class="uc-firefly mt-4" data-reveal data-reveal-delay="0.34" en="Backdrops and clips of this deck generated with Adobe Firefly, signed with Content Credentials" it="Sfondi e clip di questo deck generati con Adobe Firefly, firmati con Content Credentials" />
        <a href={href(base, '/')} class="mt-5 inline-flex items-center gap-2 px-5 py-2 text-xs font-medium tracking-widest uppercase border border-[var(--ink-inverse)]/30 text-[var(--ink-inverse)]/60 hover:border-[var(--ink-inverse)]/70 hover:text-[var(--ink-inverse)] transition-colors duration-300 rounded-sm" data-reveal data-reveal-delay="0.4">
          <T en="Start the journey over →" it="Ricomincia il percorso →" />
        </a>
      </div>
    </Slide>

  </DeckContainer>
</BaseLayout>

<style>
  /* Depth wash under the light slides (the filo, applied per-slide). */
  .ris-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background:
      radial-gradient(120% 75% at 12% 0%, rgba(190,32,39,0.05), transparent 55%),
      radial-gradient(115% 85% at 90% 100%, rgba(201,169,110,0.12), transparent 55%);
  }
  .ris-bg + * { position: relative; z-index: 1; }

  /* Persona panels — rows of designed data figures. */
  .ris-persona-note { font-size: 0.78rem; color: var(--color-grigio-400); letter-spacing: 0.02em; }
  .ris-tag--oro { color: var(--color-oro); }
  .ris-rows { display: flex; flex-direction: column; gap: 0.7rem; }
  .ris-row { display: flex; align-items: baseline; gap: 0.75rem; }
  .ris-row-fig {
    font-family: var(--font-display);
    font-weight: 600;
    flex-shrink: 0;
    font-size: clamp(1.15rem, 1.6vw, 1.4rem);
    letter-spacing: -0.01em;
    line-height: 1;
  }
  .ris-row-fig--rosso { color: var(--color-rosso); }
  .ris-row-fig--oro { color: var(--color-oro); }
  .ris-row-label { font-size: 0.95rem; line-height: 1.4; color: var(--color-blu-medio); }

  /* Case-study panels — bank as figure, benchmark result in rosso. */
  .ris-case-head { align-items: baseline; }
