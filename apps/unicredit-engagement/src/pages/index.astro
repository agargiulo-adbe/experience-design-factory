---
import BaseLayout from '../layouts/BaseLayout.astro';
import UniNavigation from '../components/UniNavigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import SlideBackdrop from '@edf/core/blocks/SlideBackdrop.astro';
import T from '@edf/core/blocks/i18n/T.astro';
import { href } from '@edf/core/utils/url.js';
import { mediaProps } from '../../assets.index';

const base = import.meta.env.BASE_URL;
// Clip Firefly della cover (GitHub Release `media`, git-ignored in locale) + poster in /public/media.
const COVER_VIDEO = 'https://github.com/agargiulo-adbe/experience-design-factory/releases/download/media/uc-cover.mp4';
const coverPoster = `${base.replace(/\/?$/, '/')}media/uc-cover.poster.jpg`;
const currentPath = Astro.url.pathname;

// Workshop cut — six chapters that open the Adobe × Accenture × UniCredit
// workshop, in the same order as the six live demos that follow.
// `solution` is optional: a chapter carrying one is hidden by the solution-gating
// runtime when that solution is off (data-nav-solution). None of the six workshop
// chapters is gated today, so the field stays absent; the type keeps typecheck honest.
const journey: Array<{
  num: string; label: { en: string; it: string }; sub: { en: string; it: string };
  href: string; solution?: string;
}> = [
  { num: '00', label: { en: 'Scenario', it: 'Scenario' }, sub: { en: 'Marco · the engine map', it: 'Marco · la mappa del motore' }, href: '/scenario' },
  { num: '01', label: { en: 'The Site', it: 'Il Sito' }, sub: { en: 'Brand Visibility · AEM Sites · AEM Agents', it: 'Brand Visibility · AEM Sites · AEM Agents' }, href: '/visibilita' },
  { num: '02', label: { en: 'Content', it: 'Contenuti' }, sub: { en: 'GenStudio · Brand Concierge', it: 'GenStudio · Brand Concierge' }, href: '/contenuti' },
  { num: '03', label: { en: 'Analyze', it: 'Analizza' }, sub: { en: 'Attribution · CJA · Marketing Campaign Analytics', it: 'Attribution · CJA · Marketing Campaign Analytics' }, href: '/analizza' },
  { num: '04', label: { en: 'Coworker', it: 'Coworker' }, sub: { en: 'CX Enterprise Coworker', it: 'CX Enterprise Coworker' }, href: '/coworker' },
  { num: '05', label: { en: 'Results', it: 'Risultati' }, sub: { en: 'ROI & business case', it: 'ROI & business case' }, href: '/risultati' },
];

const unicreditStats = [
  { value: '€5,5B+', label: { en: 'in technology, digital and data', it: 'in tecnologia, digitale e dati' }, sub: { en: 'plan investment by 2027', it: 'investimento di piano entro il 2027' } },
  { value: '€11B+', label: { en: 'net profit ambition', it: 'ambizione di utile netto' }, sub: { en: '2027 plan target', it: 'obiettivo di piano al 2027' } },
  { value: '>20%', label: { en: 'RoTE target', it: 'RoTE obiettivo' }, sub: { en: 'return on tangible equity by 2027', it: 'return on tangible equity al 2027' } },
];
---
<BaseLayout
  title="Engagement Unlimited"
  description="Come Adobe aiuta UniCredit a far diventare ogni interazione digitale una relazione più forte."
>
  <div class="fixed top-0 left-0 right-0 z-50">
    <UniNavigation currentPath={currentPath} base={base} />
  </div>

  <DeckContainer nextHref={href(base, '/scenario')}>

    <!-- ── SLIDE 0: Cover ─────────────────────────────────────────── -->
    <Slide id="slide-cover" bg="inverse" align="center">
      <Fragment slot="backdrop">
        <!-- Poster Firefly di fallback (reduced-motion nasconde il clip), poi il clip in loop, poi lo scrim. -->
        <div class="uc-video-poster" style={`background-image: url(${coverPoster});`} aria-hidden="true"></div>
        <video class="uc-video" autoplay muted loop playsinline preload="metadata" poster={coverPoster} aria-hidden="true">
          <source src={COVER_VIDEO} type="video/mp4" />
        </video>
        <div class="uc-video-scrim" data-scrim aria-hidden="true"></div>
      </Fragment>

      <div class="uc-hero mx-auto flex flex-col items-center text-center">
        <p class="uc-hero-eyebrow" data-reveal>Adobe <span class="uc-hero-x">×</span> UniCredit</p>

        <h1 class="uc-hero-title" data-reveal data-reveal-delay="0.06">Engagement Unlimited</h1>

        <T
          as="p"
          class="uc-hero-lead"
          data-reveal
          data-reveal-delay="0.12"
          en="One real customer, one platform. Every chapter is a moment that matters."
          it="Un cliente reale, una sola piattaforma. Ogni capitolo racconta un momento che conta."
        />

        <!-- IL FILO — il thread oro della relazione, con i due protagonisti come nodi -->
        <div class="uc-hero-thread" data-reveal data-reveal-delay="0.2" aria-hidden="true">
          <span class="uc-node"></span>
          <span class="uc-thread-line"></span>
          <span class="uc-node uc-node--rosso"></span>
          <span class="uc-thread-line"></span>
          <span class="uc-node"></span>
          <span class="uc-thread-line"></span>
          <span class="uc-node uc-node--rosso"></span>
          <span class="uc-thread-line"></span>
          <span class="uc-node"></span>
        </div>

        <div class="uc-hero-people" data-reveal data-reveal-delay="0.28">
          <div class="uc-person">
            <span class="uc-person-mark uc-person-mark--rosso">M</span>
            <T as="p" class="uc-person-line" en="Marco: from an AI answer to a home mortgage — and the engine behind it" it="Marco: da una risposta AI al mutuo casa — e il motore che c'è dietro" />
          </div>
        </div>

        <T
          as="p"
          class="uc-hero-note"
          data-reveal
          data-reveal-delay="0.36"
          en="Concept demo · an illustrative scenario not commissioned by UniCredit · public data cited to its sources"
          it="Demo concettuale · scenario illustrativo non commissionato da UniCredit · dati pubblici citati alle fonti"
        />
        <T
          as="p"
          class="uc-firefly mt-3"
          data-reveal
          data-reveal-delay="0.42"
          en="Visuals and motion of this deck generated with Adobe Firefly · signed with Content Credentials"
          it="Visual e movimento di questo deck generati con Adobe Firefly · firmati con Content Credentials"
        />
      </div>
    </Slide>

    <!-- ── SLIDE 1: Piano strategico UniCredit ────────────────────── -->
    <Slide id="slide-strategy" bg="primary" align="center">
      <SlideBackdrop
        slot="backdrop"
        {...mediaProps('bg-marble')}
        imageClass="opacity-25"
        scrim="bg-[var(--surface-primary)]/82"
      />
      <T as="p" class="slide-eyebrow text-center text-[var(--ink-brand-text)] mb-4" data-reveal en="THE STRATEGIC CONTEXT" it="IL CONTESTO STRATEGICO" />
      <h2
        class="slide-title text-[var(--ink-primary)] mb-5"
        style="font-size: clamp(2.25rem, 4.4vw, 4rem);"
        data-reveal
        data-reveal-delay="0.08"
      >
        UniCredit Unlocked
      </h2>
      <T
        as="p"
        class="text-[var(--ink-secondary)] leading-relaxed max-w-2xl mx-auto mb-10"
        style="font-size: clamp(1.1rem, 1.45vw, 1.4rem);"
        data-reveal
        data-reveal-delay="0.15"
        en={`With "UniCredit Unlimited" the Group commits over €5,5B to technology, digital and data by 2027. Technology and AI are how it hits its plan targets and becomes the go-to bank for digital relationships with Italian customers.`}
        it={`Con "UniCredit Unlimited" il Gruppo destina oltre €5,5B a tecnologia, digitale e dati entro il 2027. Tecnologia e AI servono a centrare gli obiettivi di piano e a diventare la banca di riferimento nella relazione digitale con i clienti italiani.`}
      />

      <div
        class="w-full max-w-4xl mx-auto grid grid-cols-3 gap-6"
        data-reveal
        data-reveal-delay="0.22"
      >
        {unicreditStats.map((m) => (
          <div class="text-center p-6 bg-[var(--surface-secondary)] border border-[var(--line-subtle)] rounded-sm">
            <p
              class="font-[family-name:var(--font-display)] font-light text-[var(--ink-brand-text)] leading-none mb-2"
              style="font-size: clamp(2.25rem, 4vw, 3.5rem);"
            >
              {m.value}
            </p>
            <T as="p" class="text-sm font-medium text-[var(--ink-primary)] mb-0.5" en={m.label.en} it={m.label.it} />
            <T as="p" class="text-xs text-[var(--ink-tertiary)]" en={m.sub.en} it={m.sub.it} />
          </div>
        ))}
      </div>
      <p class="mt-6 text-center text-[0.62rem] tracking-widest uppercase opacity-40">
        <T en="Source:" it="Fonte:" />
        <a href="https://www.unicreditgroup.eu/en/one-unicredit/articles/2026/february/unicredit-unpacked-welcome-to-unicredit-unlimited-outperforming-the-old-and-the-new.html" target="_blank" rel="noopener noreferrer" class="underline underline-offset-2 hover:opacity-100"><T en="UniCredit — UniCredit Unlimited plan (Feb 2026)" it="UniCredit — piano UniCredit Unlimited (feb 2026)" /></a>
      </p>
    </Slide>

    <!-- ── SLIDE 2: Roadmap del percorso ──────────────────────────── -->
    <Slide id="slide-journey" bg="brand" align="center">
      <SlideBackdrop
        slot="backdrop"
        {...mediaProps('bg-unlimited')}
        imageClass="opacity-12"
        scrim="uc-rosso-scrim"
      />
      <T as="p" class="slide-eyebrow text-center text-[var(--ink-inverse)]/70 mb-3" data-reveal en="THE JOURNEY" it="IL PERCORSO" />
      <h2
        class="slide-title text-[var(--ink-inverse)] mb-3"
        style="font-size: clamp(2.25rem, 4.4vw, 4rem);"
        data-reveal
        data-reveal-delay="0.08"
        data-i18n
      >
        <span data-lang-en data-edf-chapters-en>Six chapters. One story. One relationship.</span><span data-lang-it data-edf-chapters-it>Sei capitoli. Una storia. Una relazione.</span>
      </h2>
      <T
        as="p"
        class="text-[clamp(1.05rem,1.4vw,1.3rem)] text-[var(--ink-inverse)]/78 max-w-2xl mb-6"
        data-reveal
        data-reveal-delay="0.15"
        en="One platform that follows Marco from getting found by AI all the way to ROI."
        it="Una sola piattaforma che segue Marco da come viene trovato dall'AI fino al ROI."
      />

      <div
        class="w-full max-w-5xl mx-auto grid grid-cols-2 md:grid-cols-3 auto-rows-fr gap-2.5 mb-6"
        data-reveal
        data-reveal-delay="0.22"
      >
        {journey.map((step) => (
          <a
            href={href(base, step.href)}
            data-nav-solution={step.solution ?? undefined}
            data-edf-journey-card
            class="min-w-0 h-full p-4 bg-[var(--ink-inverse)]/10 border border-[var(--ink-inverse)]/20 rounded-sm text-left hover:bg-[var(--ink-inverse)]/18 transition-colors no-underline group"
          >
            <p class="text-sm font-semibold text-[var(--ink-inverse)]/55 mb-1" data-edf-cardnum>{step.num}</p>
            <T as="p" class="text-base font-semibold text-[var(--ink-inverse)] mb-0.5 group-hover:text-[var(--ink-inverse)] break-words" en={step.label.en} it={step.label.it} />
            <T as="p" class="text-sm text-[var(--ink-inverse)]/60 break-words" en={step.sub.en} it={step.sub.it} />
          </a>
        ))}
      </div>

      <div data-reveal data-reveal-delay="0.35">
        <a
          href={href(base, '/scenario')}
          class="inline-flex items-center gap-3 px-10 py-4 text-[clamp(1.05rem,1.3vw,1.3rem)] font-medium tracking-wide bg-[var(--ink-inverse)] text-[var(--ink-primary)] hover:bg-[var(--color-chiaro)] transition-colors duration-300 focus-visible:outline-2 focus-visible:outline-[var(--ink-inverse)] focus-visible:outline-offset-4"
        >
          <T en="Start the journey" it="Inizia il percorso" />
          <svg width="20" height="20" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>
    </Slide>

  </DeckContainer>

  <!--
    Dynamic chapter count: "Undici capitoli" reflects the sections actually
    active in the Admin Console (solution gating). Gates mirror the home
    roadmap cards' data-nav-solution so the number matches the visible cards.
  -->
  <script is:inline>
  (function () {
    var KEY = 'edf-solutions-unicredit-engagement';
    // Per-section gate, in section order — matches the home roadmap cards.
    // Workshop cut: six chapters, all always active.
    var GATES = [null, null, null, null, null, null];
    var WORDS = ['zero', 'una', 'due', 'tre', 'quattro', 'cinque', 'sei', 'sette', 'otto', 'nove', 'dieci', 'undici'];
    var WORDS_EN = ['zero', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight', 'nine', 'ten', 'eleven'];

    function activeIds() {
      var p = new URLSearchParams(location.search).get('s');
      if (p) return p.split(',').map(function (s) { return s.trim(); }).filter(Boolean);
      try { var st = localStorage.getItem(KEY); if (st) return JSON.parse(st); } catch (_) {}
      return null;
    }
    function count() {
      var ids = activeIds();
      if (!ids) return GATES.length; // no restriction → every section active
      var n = 0;
      GATES.forEach(function (g) {
        if (!g || g.some(function (id) { return ids.indexOf(id) !== -1; })) n++;
      });
      return n;
    }
    function label(n) {
      if (n === 1) return 'Un capitolo';
      var w = WORDS[n] || String(n);
      return w.charAt(0).toUpperCase() + w.slice(1) + ' capitoli';
    }
    function labelEn(n) {
      var w = WORDS_EN[n] || String(n);
      return w.charAt(0).toUpperCase() + w.slice(1) + (n === 1 ? ' chapter' : ' chapters');
    }
    function renumber() {
      // Renumber visible roadmap cards consecutively so a gated-off section
      // never leaves a gap in the numbering (00, 01, 02 …).
      var n = 0;
      document.querySelectorAll('[data-edf-journey-card]').forEach(function (card) {
        var hidden = card.offsetParent === null || getComputedStyle(card).display === 'none';
        if (hidden) return;
        var numEl = card.querySelector('[data-edf-cardnum]');
        if (numEl) numEl.textContent = ('0' + n).slice(-2);
        n++;
      });
    }
    function apply() {
      var n = count();
      var it = label(n) + '. Una storia. Una relazione.';
      var en = labelEn(n) + '. One story. One relationship.';
      document.querySelectorAll('[data-edf-chapters-it]').forEach(function (el) { el.textContent = it; });
      document.querySelectorAll('[data-edf-chapters-en]').forEach(function (el) { el.textContent = en; });
      renumber();
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', apply); else apply();
    document.addEventListener('astro:page-load', apply);
    window.addEventListener('storage', function (e) { if (e.key === KEY) apply(); });
  })();
  </script>

  <style>
    /* Il bianco sul rosso pieno a 18px si ferma a 4,3:1: il rosso scuro lo tiene. */
    :global(.uc-rosso-scrim) { background: rgba(176,0,20,0.88); }

    /* ── INTRO / hero — "il filo" ciano sweep sul petrolio notte ───── */
    .uc-hero {
      max-width: 58rem;
      gap: 0;
    }
    .uc-hero-eyebrow {
      font-family: var(--font-body);
      font-weight: 600;
      font-size: clamp(0.8rem, 1vw, 0.95rem);
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: rgba(245,245,245,0.72);
      margin-bottom: 1.1rem;
    }
    .uc-hero-x { color: var(--ink-accent); font-weight: 700; padding: 0 0.15em; }
    .uc-hero-title {
      font-family: var(--font-display);
      font-weight: 300;
      line-height: 1.02;
      letter-spacing: -0.02em;
      font-size: clamp(2.9rem, 6.6vw, 5.6rem);
      color: var(--color-chiaro);
      margin-bottom: 1.4rem;
      max-width: none;
      text-wrap: balance;
    }
    .uc-hero-lead {
      font-family: var(--font-display);
      font-weight: 400;
      font-size: clamp(1.2rem, 1.9vw, 1.75rem);
      line-height: 1.4;
      color: rgba(245,245,245,0.86);
      max-width: 44ch;
      margin: 0 auto;
    }
    /* the gold thread across the hero — nodes = moments of the relationship */
    .uc-hero-thread {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      width: min(30rem, 78%);
      margin: 2.1rem auto 1.9rem;
    }
    .uc-hero-thread .uc-node {
      width: 11px; height: 11px;
      box-shadow: 0 0 0 4px rgba(0,174,208,0.14);
    }
    .uc-hero-thread .uc-node--rosso {
      box-shadow: 0 0 0 4px rgba(226,0,26,0.16);
    }
    .uc-hero-thread .uc-thread-line {
      background: linear-gradient(to right, rgba(0,174,208,0.25), rgba(0,174,208,0.9));
    }
    .uc-hero-people {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 1.25rem 2.5rem;
    }
    .uc-person {
      display: flex;
      align-items: center;
      gap: 0.65rem;
    }
    .uc-person-mark {
      flex-shrink: 0;
      width: 2.05rem; height: 2.05rem;
      border-radius: 50%;
      display: inline-flex; align-items: center; justify-content: center;
      font-family: var(--font-display);
      font-weight: 600;
      font-size: 1rem;
    }
    .uc-person-mark--rosso {
      color: var(--color-chiaro);
      background: rgba(226,0,26,0.92);
      box-shadow: 0 0 0 1px rgba(226,0,26,0.5);
    }
    .uc-person-mark--oro {
      color: var(--color-inchiostro);
      background: rgba(0,174,208,0.95);
    }
    .uc-person-line {
      font-family: var(--font-display);
      font-size: clamp(0.98rem, 1.15vw, 1.12rem);
      line-height: 1.4;
      color: rgba(245,245,245,0.82);
      max-width: none;
      text-align: left;
    }
    .uc-hero-note {
      margin-top: 2.2rem;
      font-family: var(--font-body);
      font-size: clamp(0.72rem, 0.85vw, 0.8rem);
      letter-spacing: 0.14em;
      text-transform: uppercase;
      line-height: 1.6;
      color: rgba(245,245,245,0.5);
      max-width: 46ch;
      margin-inline: auto;
    }
  </style>
</BaseLayout>
