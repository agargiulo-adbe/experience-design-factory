---
import BaseLayout from '../layouts/BaseLayout.astro';
import UniNavigation from '../components/UniNavigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import SlideBackdrop from '@edf/core/blocks/SlideBackdrop.astro';
import { href } from '@edf/core/utils/url.js';
import { mediaProps } from '../../assets.index';
import MediaDemoSlot from '@edf/core/blocks/immersive/MediaDemoSlot.astro';
import T from '@edf/core/blocks/i18n/T.astro';
import UcCover from '../components/UcCover.astro';

const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;

const cxaPillars = [
  { id: 'digital', label: 'Digital Analytics', body: { it: 'Misura ogni interazione digitale, da app a web a call center, con la profondità di Adobe Analytics.', en: 'Measure every digital interaction — app, web, call center — with the depth of Adobe Analytics.' } },
  { id: 'journeys', label: 'Customer & Group Journeys', body: { it: "Vista whole-person e per buying group: il percorso del singolo cliente e quello dei gruppi (famiglie, aziende), uniti con identity stitching e attribution custom, dall'app alla filiale.", en: 'A whole-person and buying-group view: the path of each customer and of groups (families, companies), joined with identity stitching and custom attribution, from app to branch.' } },
  { id: 'marketing', label: 'Marketing Planning & ROI', body: { it: 'Marketing Campaign Analytics: attribution causale full-funnel, incrementalità di canale e budget ottimizzato in-flight — con raccomandazioni agentiche.', en: 'Marketing Campaign Analytics: full-funnel causal attribution, channel incrementality and budget optimized in-flight, with agentic recommendations.' } },
  { id: 'content', label: 'Content Intelligence', body: { it: 'Misura quale contenuto porta a risultati — per segmento, canale e momento del journey.', en: 'Measure which content drives results, by segment, channel and journey moment.' } },
];

// Slide «journey» — Marco's touchpoints as CJA stitches them, in the order the deck told them.
const journeyTouchpoints = [
  { label: 'ChatGPT', sub: { it: 'risposta AI', en: 'AI answer' } },
  { label: { it: 'Sito', en: 'Site' }, sub: { it: 'pagina mutuo · 0,3 s', en: 'mortgage page · 0.3 s' } },
  { label: 'Brand Concierge', sub: { it: 'simulazione e rata', en: 'simulation, payment' } },
  { label: 'App', sub: { it: 'sezione mutui', en: 'loans section' } },
  { label: 'Email', sub: { it: 'non aperta', en: 'not opened' } },
  { label: 'SMS', sub: { it: 'reminder mercoledì', en: 'Wednesday reminder' } },
  { label: { it: 'Appuntamento', en: 'Appointment' }, sub: { it: 'consulente, ore 14', en: 'advisor, 2 PM' } },
  { label: { it: 'Filiale', en: 'Branch' }, sub: { it: 'contratto firmato', en: 'contract signed' } },
];

const agentCapabilities = [
  {
    icon: '◉',
    title: { it: 'Parla la lingua del business', en: 'Speaks the language of the business' },
    body: { it: 'Chiedi "perché le domande di mutuo sono calate questa settimana" e ottieni la risposta con root cause analysis in minuti, non giorni.', en: 'Ask "why did mortgage applications drop this week" and get the answer, with root cause analysis, in minutes rather than days.' },
  },
  {
    icon: '◈',
    title: { it: 'Grounded in truth', en: 'Grounded in truth' },
    body: { it: 'Ogni insight è verificato sul motore analitico di Adobe: ciò che emerge è un fatto, non solo qualcosa di plausibile.', en: "Every insight is verified against Adobe's analytics engine: what surfaces is a fact, not just something plausible." },
  },
  {
    icon: '◇',
    title: { it: 'Built for trust', en: 'Built for trust' },
    body: { it: 'Gli analisti validano e collaborano sugli insight prima che arrivino al C-suite. L\'AI amplifica il team, non lo bypassa.', en: 'Analysts validate and collaborate on insights before they reach the C-suite. AI amplifies the team rather than bypassing it.' },
  },
  {
    icon: '◆',
    title: { it: 'Answers why in minutes', en: 'Answers why in minutes' },
    body: { it: 'Root Cause Analysis individua le anomalie e ne spiega le cause in automatico, su 4 milioni di clienti e in tempo reale.', en: 'Root Cause Analysis spots anomalies and explains their causes automatically, across 4 million customers in real time.' },
  },
];

const everywhereChannels = [
  { name: 'AI Assistant', sub: { it: 'Adobe nativo', en: 'Adobe native' }, color: 'var(--ink-brand-text)' },
  { name: 'Microsoft Copilot', sub: { it: 'nel workspace aziendale', en: 'in the corporate workspace' }, color: 'var(--ink-accent)' },
  { name: 'ChatGPT', sub: { it: 'accesso universale', en: 'universal access' }, color: 'var(--ink-brand-text)' },
  { name: 'Interfacce MCP', sub: { it: 'qualsiasi client AI', en: 'any AI client' }, color: 'var(--ink-accent)' },
  { name: 'Data Insights Agent', sub: { it: 'embed in ogni app', en: 'embedded in every app' }, color: 'var(--ink-brand-text)' },
];

const llmInsightsPoints = [
  { label: { it: 'Scoperta AI-driven', en: 'AI-driven discovery' }, body: { it: 'Misura quanti come Marco arrivano da ChatGPT, Gemini o Perplexity e come si comportano rispetto ai canali tradizionali.', en: 'Measure how many like Marco arrive from ChatGPT, Gemini or Perplexity, and how they behave against traditional channels.' } },
  { label: { it: 'AI Journey', en: 'AI Journey' }, body: { it: 'Traccia il percorso di chi inizia da un assistente AI esterno e completa una transazione nel digital banking: dalla mention al mutuo.', en: 'Track customers who start from an external AI assistant and complete a transaction in digital banking: from mention to mortgage.' } },
  { label: { it: 'Conversazione', en: 'Conversation' }, body: { it: 'Analizza come i clienti interagiscono con il Brand Concierge UniCredit — quali domande fanno, dove si bloccano, quante conversazioni diventano transazioni.', en: 'See how customers interact with the UniCredit Brand Concierge: what they ask, where they get stuck, how many dialogues become transactions.' } },
];

// Slide «last-touch» — pesi illustrativi dei canali sul mutuo di Marco,
// che il report ufficiale attribuisce a un solo canale (last-touch).
const channelWeights = [
  { name: { it: 'Digitale (AI · sito · app)', en: 'Digital (AI · site · app)' }, pct: 45 },
  { name: 'Contact center', pct: 30 },
  { name: { it: 'Filiale', en: 'Branch' }, pct: 25 },
];
---
<BaseLayout
  title="Adobe CX Analytics"
  description="Chi ha portato Marco al mutuo? La sua storia vista da dentro UniCredit: CJA, attribution, Data Insights Agent, LLM Insights, Marketing Campaign Analytics."
  pageSolutions={['cja']}
>
  <div class="fixed top-0 left-0 right-0 z-50">
    <UniNavigation currentPath={currentPath} base={base} />
  </div>

  <DeckContainer nextHref={href(base, '/coworker')} prevHref={href(base, '/contenuti')}>

    <!-- ── SLIDE 0: Cover ─────────────────────────────────────────── -->
    <Slide id="slide-cover" bg="inverse" align="center">
      <SlideBackdrop
        slot="backdrop"
        {...mediaProps('bg-digital-blue')}
        imageClass="opacity-30"
        scrim="bg-[var(--surface-inverse)]/78"
      />
      <UcCover
        slug="analizza"
        title={{ en: 'Who brought Marco<br/>to his mortgage?', it: 'Chi ha portato Marco<br/>al mutuo?' }}
        lead={{ en: "Marco's story seen from inside UniCredit: every step measured, and the credit going to whoever really earned it. Engine 05: journey analytics.", it: 'La storia di Marco vista da dentro UniCredit: ogni passaggio misurato, e il merito a chi lo ha davvero guadagnato. Motore 05: journey analytics.' }}
        chips={['Customer Journey Analytics', { en: 'Attribution', it: 'Attribution' }, 'Data Insights Agent', 'LLM Insights', 'Marketing Campaign Analytics']}
      />
    </Slide>

    <!-- ── SLIDE 1: Il viaggio di Marco, misurato (CJA) ──────────── -->
    <Slide id="slide-journey" bg="primary" align="center">
      <div slot="backdrop" class="uc-bg absolute inset-0" aria-hidden="true"></div>
      <div data-demo-flex class="w-full flex items-start gap-8">
        <div class="flex-1 min-w-0 text-center">
          <T as="p" class="slide-eyebrow text-center text-[var(--ink-brand-text)] mb-4" data-reveal it="CUSTOMER JOURNEY ANALYTICS · IL PERCORSO INTERO" en="CUSTOMER JOURNEY ANALYTICS · THE WHOLE JOURNEY" />
          <T as="h2"
            class="slide-title text-[var(--ink-primary)] mb-4"
            style="font-size: clamp(2rem, 4vw, 3.5rem);"
            data-reveal
            data-reveal-delay="0.08"
            it="Una persona, otto touchpoint,<br/>tre sistemi. Un solo percorso."
            en="One person, eight touchpoints,<br/>three systems. One journey."
          />
          <T as="p"
            class="text-[clamp(1rem,1.35vw,1.2rem)] text-[var(--ink-secondary)] max-w-3xl mx-auto mb-7 leading-relaxed"
            data-reveal
            data-reveal-delay="0.15"
            it="Quello che Marco ha vissuto capitolo per capitolo, CJA lo vede come un'unica sequenza: assistente AI, sito, contact center e filiale cuciti sulla stessa identità, anche dove il dato nasce offline."
            en="What Marco lived chapter by chapter, CJA sees as a single sequence: AI assistant, site, contact center and branch stitched onto the same identity, even where the data is born offline."
          />

          <ol class="uc-tl w-full max-w-6xl mx-auto mb-10" data-reveal data-reveal-delay="0.22">
            {journeyTouchpoints.map((t, i) => (
              <li class="uc-tl-step">
                <span class={`uc-tl-dot ${i === 0 || i === journeyTouchpoints.length - 1 ? 'uc-tl-dot--rosso' : ''}`} aria-hidden="true"></span>
                {typeof t.label === 'string'
                  ? <p class="uc-tl-label">{t.label}</p>
                  : <T as="p" class="uc-tl-label" it={t.label.it} en={t.label.en} />}
                <T as="p" class="uc-tl-sub" it={t.sub.it} en={t.sub.en} />
              </li>
            ))}
          </ol>

          <div class="uc-panel uc-panel--oro max-w-3xl mx-auto text-left" data-reveal data-reveal-delay="0.35">
            <div class="uc-panel-head">
              <T as="p" class="uc-tag" style="color: var(--ink-accent);" it="Dentro UniCredit · l'analista" en="Inside UniCredit · the analyst" />
              <span class="uc-node"></span>
            </div>
            <T as="p" class="uc-quote-text" style="margin-top: 0; font-size: clamp(1.05rem, 1.3vw, 1.3rem);" it={'«Per la prima volta la domanda "chi ha portato Marco al mutuo?" ha una risposta nei dati, non nell\'ultimo canale che l\'ha registrato. È da qui che parte l\'attribution.»'} en={'«For the first time the question "who brought Marco to his mortgage?" is answered by the data, not by the last channel that logged it. This is where attribution starts.»'} />
          </div>
          <T as="p" class="mt-3 text-center text-[0.72rem] tracking-widest uppercase text-[var(--ink-note)]" it="Percorso illustrativo · identity stitching e ingestion offline (filiale, contact center) in CJA" en="Illustrative journey · identity stitching and offline ingestion (branch, contact center) in CJA" />
        </div>
        <MediaDemoSlot id="analizza-cxa-demo" label="CJA — Journey / Dashboard Screenshot" />
      </div>
    </Slide>

    <!-- ── SLIDE 2: Last-touch → vista complementare (ATTRIBUTION) ─ -->
    <Slide id="slide-lasttouch" bg="secondary" align="center" data-solution="cja">
      <div slot="backdrop" class="uc-bg absolute inset-0" aria-hidden="true"></div>
      <T as="p" class="slide-eyebrow text-center text-[var(--ink-brand-text)] mb-4" data-reveal it="ATTRIBUTION · LA VISTA CHE MANCA" en="ATTRIBUTION · THE MISSING VIEW" />
      <T as="h2"
        class="slide-title text-[var(--ink-primary)] mb-3"
        style="font-size: clamp(1.9rem, 3.6vw, 3.4rem);"
        data-reveal
        data-reveal-delay="0.08"
        it="Il last-touch dice chi.<br/>Non dice come."
        en="Last-touch tells you who.<br/>Not how."
      />
      <T as="p"
        class="text-[clamp(1rem,1.35vw,1.2rem)] text-[var(--ink-secondary)] max-w-3xl mb-4 leading-relaxed"
        data-reveal
        data-reveal-delay="0.15"
        it="Il report ufficiale dà ogni vendita a un solo canale, l'ultimo che l'ha registrata: il mutuo di Marco risulta «Filiale». È il modello di governance, e resta così."
        en="The official report credits each sale to one channel, the last that logged it: Marco's mortgage reads «Branch». That is the governance model, and it stays that way."
      />

      <div class="w-full max-w-5xl mx-auto grid md:grid-cols-2 gap-4 items-stretch" data-reveal data-reveal-delay="0.22">
        <div class="uc-panel uc-panel--rosso text-left">
          <div class="uc-panel-head">
            <T as="p" class="uc-tag" it="Report ufficiale · last-touch" en="Official report · last-touch" />
          </div>
          <div class="flex items-center gap-3 mt-1">
            <T as="span" class="font-[family-name:var(--font-display)] text-[var(--ink-primary)]" style="font-size: clamp(1.4rem,2vw,1.9rem);" it="1 mutuo" en="1 mortgage" />
            <span class="text-[var(--ink-brand-text)] text-xl">→</span>
            <T as="span" class="font-semibold text-[var(--ink-primary)]" style="font-size: 1.05rem;" it="Filiale" en="Branch" />
          </div>
          <T as="p" class="uc-panel-body mt-2" style="margin-bottom: 0;" it="L'ultimo canale prende tutto il merito; ChatGPT, il sito, il concierge e l'SMS spariscono dal conto." en="The last channel takes all the credit; ChatGPT, the site, the concierge and the SMS vanish from the count." />
        </div>

        <div class="uc-panel uc-panel--oro text-left">
          <div class="uc-panel-head">
            <T as="p" class="uc-tag" style="color: var(--ink-accent);" it="Vista complementare · CJA" en="Complementary view · CJA" />
          </div>
          <div class="flex flex-col gap-2 mt-1 min-w-0">
            {channelWeights.map((c) => (
              <div class="flex items-center gap-3 min-w-0">
                {typeof c.name === 'string'
                  ? <span class="w-44 flex-shrink-0 font-medium text-[var(--ink-primary)]" style="font-size: 0.9rem;">{c.name}</span>
                  : <T as="span" class="w-44 flex-shrink-0 font-medium text-[var(--ink-primary)]" style="font-size: 0.9rem;" it={c.name.it} en={c.name.en} />}
                <div class="flex-1 min-w-0">
                  <div class="h-6 bg-[var(--accent-primary)] rounded-sm" style={`width: ${c.pct}%;`}></div>
                </div>
                <span class="flex-shrink-0 font-semibold text-[var(--ink-primary)]" style="font-family: var(--font-display); font-size: 0.95rem;">{c.pct}%</span>
              </div>
            ))}
          </div>
          <T as="p" class="uc-panel-body mt-2" style="margin-bottom: 0;" it="Lo stesso mutuo, con il peso reale di ogni canale. Senza toccare il modello ufficiale." en="The same mortgage, with the real weight of each channel. Without touching the official model." />
        </div>
      </div>

      <div class="uc-panel uc-panel--rosso max-w-3xl mx-auto text-left mt-3" data-reveal data-reveal-delay="0.35">
        <p class="uc-panel-body" style="margin-bottom: 0;">
          <T it='<span class="font-semibold text-[var(--ink-primary)]">Per UniCredit:</span> capire quanto app, filiale, contact center e agenti pesano su una vendita attribuita a uno solo, per orchestrare i lead e dare obiettivi ai team.' en='<span class="font-semibold text-[var(--ink-primary)]">For UniCredit:</span> seeing how much app, branch, contact center and agents weigh on a sale credited to just one, to orchestrate leads and set team targets.' />
        </p>
      </div>
      <T as="p" class="mt-2 text-center text-[0.75rem] tracking-widest uppercase text-[var(--ink-note)]" it="Pesi illustrativi · vista complementare, non sostitutiva del modello ufficiale" en="Illustrative weights · complementary view, not a replacement for the official model" />
    </Slide>

    <!-- ── SLIDE 3: Data Insights Agent ──────────────────────────── -->
    <Slide id="slide-agent" bg="primary" align="split">
      <div data-demo-flex class="w-full flex items-start gap-8">
        <div class="flex-1 min-w-0 grid md:grid-cols-2 gap-10 md:gap-14 items-center">
          <div class="text-left">
            <T as="p" class="slide-eyebrow text-[var(--ink-brand-text)] mb-4" data-reveal it="DATA INSIGHTS AGENT · IL PERCHÉ" en="DATA INSIGHTS AGENT · THE WHY" />
            <T as="h2"
              class="slide-title text-[var(--ink-primary)] mb-5"
              style="font-size: clamp(2rem, 4vw, 3.75rem);"
              data-reveal
              data-reveal-delay="0.08"
              it={'L\'analista AI che risponde al "perché"'}
              en={'The AI analyst that answers "why"'}
            />
            <T as="p"
              class="text-[var(--ink-secondary)] leading-relaxed mb-6"
              style="font-size: clamp(1rem, 1.35vw, 1.25rem);"
              data-reveal
              data-reveal-delay="0.15"
              it="Chiedi in linguaggio naturale e ottieni una root cause analysis in minuti, non in giorni. Verificata sul motore analitico Adobe, non generata."
              en="Ask in plain language and get a root cause analysis in minutes, not days. Verified against the Adobe analytics engine, not generated."
            />
            <div class="uc-panel uc-panel--rosso" data-reveal data-reveal-delay="0.22">
              <div class="uc-panel-head">
                <T as="p" class="uc-tag" it="Esempio UniCredit" en="UniCredit example" />
              </div>
              <T as="p" class="text-[var(--ink-primary)] italic" style="font-size: 0.98rem; line-height: 1.55;" it={'"Perché le richieste di mutuo via app sono calate del 18% questa settimana rispetto alla media?"'} en={'"Why did in-app mortgage applications drop 18% this week versus the average?"'} />
              <T as="p" class="text-[var(--ink-brand-text)] mt-2 font-medium" style="font-size: 0.9rem; line-height: 1.5;" it="→ Root Cause: step 3 del flow aumentato a 4.2s dopo deploy v2.3.1 · segmento 35–44 anni più impattato" en="→ Root Cause: flow step 3 rose to 4.2s after deploy v2.3.1 · 35–44 segment most impacted" />
            </div>
          </div>

          <div class="flex flex-col gap-3" data-reveal data-reveal-delay="0.3">
            {agentCapabilities.map((cap) => (
              <div class="uc-panel uc-panel--row items-start gap-4" style="padding: 0.8rem 1.1rem;">
                <span class="text-[var(--ink-brand-text)] text-xl flex-shrink-0 mt-0.5">{cap.icon}</span>
                <div class="min-w-0">
                  <T as="p" class="font-semibold text-[var(--ink-primary)] mb-1" style="font-size: 1rem;" it={cap.title.it} en={cap.title.en} />
                  <T as="p" class="uc-panel-body" style="margin-bottom: 0;" it={cap.body.it} en={cap.body.en} />
                </div>
              </div>
            ))}

            <div class="uc-panel uc-panel--oro mt-1" data-reveal data-reveal-delay="0.45">
              <div class="uc-panel-head">
                <T as="p" class="uc-tag" style="color: var(--ink-accent);" it="Marco, in questo momento" en="Marco, right now" />
                <span class="uc-node"></span>
              </div>
              <T as="p" class="uc-quote-text" style="margin-top: 0; font-size: clamp(1.05rem, 1.3vw, 1.3rem);" it="«Marco non aveva aperto l'email del mutuo. Il Data Insights Agent lo aveva già segnalato come at-risk e suggerito un reminder SMS per mercoledì mattina.»" en="«Marco hadn't opened the mortgage email. The Data Insights Agent had already flagged him as at-risk and suggested an SMS reminder for Wednesday morning.»" />
            </div>
          </div>
        </div>
        <MediaDemoSlot id="analizza-dia-demo" label="Data Insights Agent — Demo Video" />
      </div>
    </Slide>

    <!-- ── SLIDE 4: LLM Insights (il primo touchpoint di Marco) ──────────────────────────────────── -->
    <Slide id="slide-llm" bg="primary" align="center">
      <div slot="backdrop" class="uc-bg absolute inset-0" aria-hidden="true"></div>
      <T as="p" class="slide-eyebrow text-center text-[var(--ink-brand-text)] mb-4" data-reveal it="LLM INSIGHTS · IL PRIMO TOUCHPOINT" en="LLM INSIGHTS · THE FIRST TOUCHPOINT" />
      <T as="h2"
        class="slide-title text-[var(--ink-primary)] mb-5"
        style="font-size: clamp(2rem, 3.8vw, 3.4rem);"
        data-reveal
        data-reveal-delay="0.08"
        it="Il primo touchpoint di Marco è stato ChatGPT. Ora si misura."
        en="Marco's first touchpoint was ChatGPT. Now it gets measured."
      />
      <T as="p"
        class="text-[clamp(1rem,1.35vw,1.2rem)] text-[var(--ink-secondary)] max-w-3xl mb-7 leading-relaxed"
        data-reveal
        data-reveal-delay="0.15"
        it="Sempre più clienti iniziano il percorso finanziario da un assistente AI. LLM Insights rende misurabile quel traffico, dalla mention alla conversione, e lo mette nell'attribution accanto agli altri canali."
        en="More and more customers start their financial journey from an AI assistant. LLM Insights makes that traffic measurable, from mention to conversion, and puts it into attribution alongside every other channel."
      />

      <div
        class="w-full max-w-5xl mx-auto grid md:grid-cols-3 gap-5 mb-5"
        data-reveal
        data-reveal-delay="0.22"
      >
        {llmInsightsPoints.map((p) => (
          <div class="uc-panel uc-panel--oro text-left">
            <div class="uc-panel-head">
              <T as="p" class="uc-tag" style="color: var(--ink-accent);" it={p.label.it} en={p.label.en} />
            </div>
            <T as="p" class="uc-panel-body" style="margin-bottom: 0;" it={p.body.it} en={p.body.en} />
          </div>
        ))}
      </div>

      <div class="uc-panel uc-panel--rosso max-w-3xl mx-auto text-left" data-reveal data-reveal-delay="0.3">
        <div class="uc-panel-head">
          <T as="p" class="uc-tag" it="Il CMO, in questo momento" en="The CMO, right now" />
          <span class="uc-node uc-node--rosso"></span>
        </div>
        <T as="p" class="uc-quote-text" style="margin-top: 0; font-size: clamp(1.05rem, 1.3vw, 1.3rem);" it={'«Per la prima volta riesce a rispondere: "Qual è il ROI della nostra presenza su ChatGPT?" Un numero misurato, non una stima.»'} en={'«For the first time she can answer: "What is the ROI of our presence on ChatGPT?" A measured number, not a guess.»'} />
      </div>
    </Slide>

    <!-- ── SLIDE 5: Cost-per-click → cost-per-sale (ATTRIBUTION) ───── -->
    <Slide id="slide-costpersale" bg="primary" align="center" data-solution="cja">
      <div slot="backdrop" class="uc-bg absolute inset-0" aria-hidden="true"></div>
      <T as="p" class="slide-eyebrow text-center text-[var(--ink-brand-text)] mb-3" data-reveal it="ATTRIBUTION · DAL CLICK ALLA VENDITA" en="ATTRIBUTION · FROM CLICK TO SALE" />
      <T as="h2"
        class="slide-title text-[var(--ink-primary)] mb-3"
        style="font-size: clamp(1.9rem, 3.6vw, 3.2rem);"
        data-reveal
        data-reveal-delay="0.08"
        it="Pagare il marketing sulle vendite,<br/>non sui click."
        en="Pay marketing on sales,<br/>not on clicks."
      />
      <T as="p"
        class="text-[clamp(1rem,1.35vw,1.2rem)] text-[var(--ink-secondary)] max-w-3xl mb-4 leading-relaxed"
        data-reveal
        data-reveal-delay="0.15"
        it="Riconciliare la navigazione con il venduto vuol dire pagare la campagna che ha raggiunto Marco sul mutuo firmato, non sul click. Ma il cost-per-sale regge solo su un'attribution solida e condivisa."
        en="Reconciling browsing with sales means paying the campaign that reached Marco on the signed mortgage, not on the click. But cost-per-sale only holds up on solid, shared attribution."
      />

      <div class="w-full max-w-4xl mx-auto grid md:grid-cols-2 gap-4 mb-3" data-reveal data-reveal-delay="0.22">
        <div class="uc-panel uc-panel--oro text-left">
          <div class="uc-panel-head">
