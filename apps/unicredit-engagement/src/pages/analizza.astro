---
import BaseLayout from '../layouts/BaseLayout.astro';
import UniNavigation from '../components/UniNavigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import SlideBackdrop from '@edf/core/blocks/SlideBackdrop.astro';
import { href } from '@edf/core/utils/url.js';
import { mediaProps } from '../../assets.index';
import MediaDemoSlot from '@edf/core/blocks/immersive/MediaDemoSlot.astro';
import T from '@edf/core/blocks/i18n/T.astro';
import UcCover from '../components/UcCover.astro';

const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;

const cxaPillars = [
  { id: 'digital', label: 'Digital Analytics', body: { it: 'Misura ogni interazione digitale, da app a web a call center, con la profondità di Adobe Analytics.', en: 'Measures every digital interaction — app, web, call centre — with Adobe Analytics depth.' } },
  { id: 'journeys', label: 'Customer & Group Journeys', body: { it: 'Vista whole-person e per buying group: il percorso del singolo cliente e della famiglia, unito con identity stitching e attribution custom dalla scoperta alla vendita.', en: 'A whole-person and buying-group view: the path of each customer and their household, stitched with identity and custom attribution from discovery to sale.' } },
  { id: 'marketing', label: 'Marketing Planning & ROI', body: { it: 'Marketing Campaign Analytics: attribution causale full-funnel, incrementalità di canale e budget ottimizzato in-flight, con raccomandazioni agentiche.', en: 'Marketing Campaign Analytics: full-funnel causal attribution, channel incrementality and in-flight budget optimization with agentic recommendations.' } },
  { id: 'content', label: 'Content Intelligence', body: { it: 'Misura quale contenuto porta a risultati — per segmento, canale e momento del journey.', en: 'Shows which content actually drives results, by segment, channel and journey moment.' } },
];

// Slide «journey» — illustrative events, available only when sources and access are configured.
const journeyTouchpoints = [
  { label: 'ChatGPT', sub: { it: 'referral, se osservabile', en: 'referral, if observable' } },
  { label: { it: 'Sito', en: 'Site' }, sub: { it: 'pagina mutuo', en: 'mortgage page' } },
  { label: 'Brand Concierge', sub: { it: 'domanda sul simulatore', en: 'question about the simulator' } },
  { label: { it: 'Simulatore', en: 'Simulator' }, sub: { it: 'apertura, se misurata', en: 'opened, if measured' } },
  { label: 'App', sub: { it: 'visita alla sezione mutui', en: 'visit to mortgage section' } },
  { label: 'Email', sub: { it: 'segnalata come non aperta', en: 'reported as unopened' } },
];

const agentCapabilities = [
  {
    icon: '◉',
    title: { it: 'Parla la lingua del business', en: 'Speaks the language of the business' },
    body: { it: 'Una domanda in linguaggio naturale può avviare l’analisi di un’anomalia. Fonti, copertura e ipotesi vanno verificate prima di attribuirle una causa.', en: 'A natural-language question can start an anomaly investigation. Sources, coverage and hypotheses still need checking before assigning a cause.' },
  },
  {
    icon: '◈',
    title: { it: 'Verificare le evidenze', en: 'Check the evidence' },
    body: { it: 'Il team controlla le misure disponibili, la qualità dei dati e il contesto operativo prima di trattare un risultato come un fatto.', en: 'The team checks available measures, data quality and operating context before treating a result as fact.' },
  },
  {
    icon: '◇',
    title: { it: 'Built for trust', en: 'Built for trust' },
    body: { it: 'Gli analisti validano e collaborano sugli insight prima che arrivino al C-suite. L\'AI amplifica il team, non lo bypassa.', en: 'Analysts validate and collaborate on insights before they reach the C-suite. AI amplifies the team rather than bypassing it.' },
  },
  {
    icon: '◆',
    title: { it: 'Esplora le anomalie', en: 'Explore anomalies' },
    body: { it: 'Root Cause Analysis può aiutare a esplorare anomalie e possibili driver nei dati configurati; l’interpretazione resta da validare.', en: 'Root Cause Analysis can help explore anomalies and possible drivers in configured data; interpretation still needs validation.' },
  },
];

const everywhereChannels = [
  { name: 'AI Assistant', sub: { it: 'Adobe nativo', en: 'Adobe native' }, color: 'var(--ink-brand-text)' },
  { name: 'Microsoft Copilot', sub: { it: 'nel workspace aziendale', en: 'in the corporate workspace' }, color: 'var(--ink-accent)' },
  { name: 'ChatGPT', sub: { it: 'accesso universale', en: 'universal access' }, color: 'var(--ink-brand-text)' },
  { name: 'Interfacce MCP', sub: { it: 'qualsiasi client AI', en: 'any AI client' }, color: 'var(--ink-accent)' },
  { name: 'Data Insights Agent', sub: { it: 'embed in ogni app', en: 'embedded in every app' }, color: 'var(--ink-brand-text)' },
];

const llmInsightsPoints = [
  { label: { it: 'Scoperta AI-driven', en: 'AI-driven discovery' }, body: { it: 'Misura quanti come Marco arrivano da ChatGPT, Gemini o Perplexity e come si comportano rispetto ai canali tradizionali.', en: 'Measure how many like Marco arrive from ChatGPT, Gemini or Perplexity, and how they behave against traditional channels.' } },
  { label: { it: 'Referral AI', en: 'AI referrals' }, body: { it: 'Analizza i referral dagli assistenti AI quando sono osservabili e confrontali con gli altri ingressi, nel rispetto di consenso e copertura dei dati.', en: 'Analyze referrals from AI assistants where observable and compare them with other entry points, subject to consent and data coverage.' } },
  { label: { it: 'Conversazione', en: 'Conversation' }, body: { it: 'Analizza come i clienti interagiscono con il Brand Concierge UniCredit — quali domande fanno, dove si bloccano, quante conversazioni diventano transazioni.', en: 'See how customers interact with the UniCredit Brand Concierge: what they ask, where they get stuck, how many dialogues become transactions.' } },
];

// Slide «last-touch» — pesi illustrativi dei canali sul mutuo di Marco,
// che il report ufficiale attribuisce a un solo canale (last-touch).
const channelWeights = [
  { name: { it: 'Digitale (AI · sito · app)', en: 'Digital (AI · site · app)' }, pct: 45 },
  { name: 'Contact center', pct: 30 },
  { name: { it: 'Filiale', en: 'Branch' }, pct: 25 },
];
---
<BaseLayout
title="Attribution & journey analytics"
description="CJA e attribution possono affiancare la vista last-touch con gli eventi osservabili del percorso, se fonti, accessi e modello sono configurati."
  pageSolutions={['cja']}
>
  <div class="fixed top-0 left-0 right-0 z-50">
    <UniNavigation currentPath={currentPath} base={base} />
  </div>

  <DeckContainer nextHref={href(base, '/coworker')} prevHref={href(base, '/contenuti')}>

    <!-- ── SLIDE 0: Cover ─────────────────────────────────────────── -->
    <Slide id="slide-cover" bg="inverse" align="center">
      <SlideBackdrop
        slot="backdrop"
        {...mediaProps('bg-digital-blue')}
        imageClass="opacity-30"
        scrim="bg-[var(--surface-inverse)]/78"
      />
      <UcCover
        slug="analizza"
        title={{ en: 'What can the journey data tell us?', it: 'Cosa raccontano i dati del percorso?' }}
        lead={{ en: "Where sources, access and identity rules are configured, CJA can add a view of observed touchpoints alongside an agreed attribution model. A signal is not a conclusion or a customer decision.", it: "Con fonti, accessi e regole d’identità configurati, CJA può affiancare a un modello di attribution una vista dei touchpoint osservati. Un segnale non è una conclusione né una decisione sul cliente." }}
        chips={['Customer Journey Analytics', { en: 'Attribution', it: 'Attribution' }, 'Data Insights Agent', 'LLM Insights', 'Marketing Campaign Analytics']}
      />
    </Slide>

    <!-- ── SLIDE 1: Il viaggio di Marco, misurato (CJA) ──────────── -->
    <Slide id="slide-journey" bg="primary" align="center">
      <div slot="backdrop" class="uc-bg absolute inset-0" aria-hidden="true"></div>
      <div data-demo-flex class="w-full flex items-start gap-8">
        <div class="flex-1 min-w-0 text-center">
          <T as="p" class="slide-eyebrow text-center text-[var(--ink-brand-text)] mb-4" data-reveal it="CUSTOMER JOURNEY ANALYTICS · EVENTI OSSERVABILI" en="CUSTOMER JOURNEY ANALYTICS · OBSERVED EVENTS" />
          <T as="h2"
            class="slide-title text-[var(--ink-primary)] mb-4"
            style="font-size: clamp(2rem, 4vw, 3.5rem);"
            data-reveal
            data-reveal-delay="0.08"
            it="Sei touchpoint possibili.<br/>Un percorso da verificare."
            en="Six possible touchpoints.<br/>One journey to examine."
          />
          <T as="p"
            class="text-[clamp(1rem,1.35vw,1.2rem)] text-[var(--ink-secondary)] max-w-3xl mx-auto mb-7 leading-relaxed"
            data-reveal
            data-reveal-delay="0.15"
            it="Con fonti autorizzate e regole d’identità configurate, CJA può collegare gli eventi disponibili. Questa sequenza è illustrativa: non conferma un esito né dimostra l’intenzione di Marco."
            en="With authorized sources and identity rules configured, CJA can connect available events. This sequence is illustrative: it confirms no outcome and does not establish Marco’s intent."
          />

          <ol class="uc-tl w-full max-w-6xl mx-auto mb-10" data-reveal data-reveal-delay="0.22">
            {journeyTouchpoints.map((t, i) => (
              <li class="uc-tl-step">
                <span class={`uc-tl-dot ${i === 0 || i === journeyTouchpoints.length - 1 ? 'uc-tl-dot--rosso' : ''}`} aria-hidden="true"></span>
                {typeof t.label === 'string'
                  ? <p class="uc-tl-label">{t.label}</p>
                  : <T as="p" class="uc-tl-label" it={t.label.it} en={t.label.en} />}
                <T as="p" class="uc-tl-sub" it={t.sub.it} en={t.sub.en} />
              </li>
            ))}
          </ol>

          <div class="uc-panel uc-panel--oro max-w-3xl mx-auto text-left" data-reveal data-reveal-delay="0.35">
            <div class="uc-panel-head">
              <T as="p" class="uc-tag" style="color: var(--ink-accent);" it="Segnale · non una conclusione" en="Signal · not a conclusion" />
              <span class="uc-node"></span>
            </div>
            <T as="p" class="uc-quote-text" style="margin-top: 0; font-size: clamp(1.05rem, 1.3vw, 1.3rem);" it="Un’email non aperta non dice perché né cosa desidera il cliente. Prima di proporre un contatto, il team verifica contesto, qualità del dato e preferenze." en="An unopened email does not explain why or what the customer wants. Before proposing contact, the team checks context, data quality and preferences." />
          </div>
          <T as="p" class="mt-3 text-center text-[0.75rem] tracking-widest uppercase text-[var(--ink-note)]" it="Esempio illustrativo · tracking, fonti e collegamenti tra canali da configurare" en="Illustrative example · tracking, sources and cross-channel connections require configuration" />
        </div>
        <MediaDemoSlot id="analizza-cxa-demo" label="CJA — Journey / Dashboard Screenshot" />
      </div>
    </Slide>

    <!-- ── SLIDE 2: Last-touch → vista complementare (ATTRIBUTION) ─ -->
    <Slide id="slide-lasttouch" bg="secondary" align="center" data-solution="cja">
      <div slot="backdrop" class="uc-bg absolute inset-0" aria-hidden="true"></div>
      <T as="p" class="slide-eyebrow text-center text-[var(--ink-brand-text)] mb-4" data-reveal it="ATTRIBUTION · LA VISTA CHE MANCA" en="ATTRIBUTION · THE MISSING VIEW" />
      <T as="h2"
        class="slide-title text-[var(--ink-primary)] mb-3"
        style="font-size: clamp(1.9rem, 3.6vw, 3.4rem);"
        data-reveal
        data-reveal-delay="0.08"
        it="L’ultimo touchpoint prende il merito.<br/>Non racconta tutto il percorso."
        en="Last-touch gets the credit.<br/>It does not tell the whole story."
      />
      <T as="p"
        class="text-[clamp(1rem,1.35vw,1.2rem)] text-[var(--ink-secondary)] max-w-3xl mb-4 leading-relaxed"
        data-reveal
        data-reveal-delay="0.15"
        it="Se una vendita è registrata e il modello adottato è last-touch, il report ufficiale accredita l’ultimo canale misurato. CJA può offrire una vista complementare, se dati e metodo la supportano."
        en="If a sale is recorded and the adopted model is last-touch, the official report credits the last measured channel. CJA can offer a complementary view if the data and method support it."
      />

      <div class="w-full max-w-5xl mx-auto grid md:grid-cols-2 gap-4 items-stretch" data-reveal data-reveal-delay="0.22">
        <div class="uc-panel uc-panel--rosso text-left">
          <div class="uc-panel-head">
            <T as="p" class="uc-tag" it="Esempio · last-touch" en="Illustrative · last-touch" />
          </div>
          <div class="flex items-center gap-3 mt-1">
            <T as="span" class="font-[family-name:var(--font-display)] text-[var(--ink-primary)]" style="font-size: clamp(1.4rem,2vw,1.9rem);" it="Esito registrato" en="Recorded outcome" />
            <span class="text-[var(--ink-brand-text)] text-xl">→</span>
            <T as="span" class="font-semibold text-[var(--ink-primary)]" style="font-size: 1.05rem;" it="Filiale" en="Branch" />
          </div>
          <T as="p" class="uc-panel-body mt-2" style="margin-bottom: 0;" it="In questo esempio, gli altri touchpoint non compaiono nell’attribuzione last-touch." en="In this example, the other touchpoints do not appear in the last-touch attribution." />
        </div>

        <div class="uc-panel uc-panel--oro text-left">
          <div class="uc-panel-head">
            <T as="p" class="uc-tag" style="color: var(--ink-accent);" it="Vista complementare · CJA" en="Complementary view · CJA" />
          </div>
          <div class="flex flex-col gap-2 mt-1 min-w-0">
            {channelWeights.map((c) => (
              <div class="flex items-center gap-3 min-w-0">
                {typeof c.name === 'string'
                  ? <span class="w-44 flex-shrink-0 font-medium text-[var(--ink-primary)]" style="font-size: 0.9rem;">{c.name}</span>
                  : <T as="span" class="w-44 flex-shrink-0 font-medium text-[var(--ink-primary)]" style="font-size: 0.9rem;" it={c.name.it} en={c.name.en} />}
                <div class="flex-1 min-w-0">
                  <!-- Petrolio, non rosso: il rosso è il marchio (logo, header, CTA, errori), il
                       peso di un canale è un dato neutro. Regola di palette UniCredit. -->
                  <div class="h-6 bg-[var(--color-petrolio)] rounded-sm" style={`width: ${c.pct}%;`}></div>
                </div>
                <span class="flex-shrink-0 font-semibold text-[var(--ink-primary)]" style="font-family: var(--font-display); font-size: 0.95rem;">{c.pct}%</span>
              </div>
            ))}
          </div>
          <T as="p" class="uc-panel-body mt-2" style="margin-bottom: 0;" it="Pesi puramente illustrativi: la distribuzione effettiva dipende dai dati e dal modello concordato." en="Illustrative weights only: the actual distribution depends on available data and the agreed model." />
        </div>
      </div>

      <div class="uc-panel uc-panel--rosso max-w-3xl mx-auto text-left mt-3" data-reveal data-reveal-delay="0.35">
        <p class="uc-panel-body" style="margin-bottom: 0;">
          <T it='<span class="font-semibold text-[var(--ink-primary)]">Per UniCredit:</span> capire quanto app, filiale, contact center e agenti pesano su una vendita attribuita a uno solo, per orchestrare i lead e dare obiettivi ai team.' en='<span class="font-semibold text-[var(--ink-primary)]">For UniCredit:</span> seeing how much app, branch, contact center and agents weigh on a sale credited to just one, to orchestrate leads and set team targets.' />
        </p>
      </div>
      <T as="p" class="mt-2 text-center text-[0.75rem] tracking-widest uppercase text-[var(--ink-note)]" it="Esempio illustrativo · vista complementare, non sostitutiva del modello ufficiale" en="Illustrative example · complementary view, not a replacement for the official model" />
    </Slide>

    <!-- ── SLIDE 3: Data Insights Agent ──────────────────────────── -->
    <Slide id="slide-agent" bg="primary" align="split">
      <div data-demo-flex class="w-full flex items-start gap-8">
        <div class="flex-1 min-w-0 grid md:grid-cols-2 gap-10 md:gap-14 items-center">
          <div class="text-left">
            <T as="p" class="slide-eyebrow text-[var(--ink-brand-text)] mb-4" data-reveal it="DATA INSIGHTS AGENT · IL PERCHÉ" en="DATA INSIGHTS AGENT · THE WHY" />
            <T as="h2"
              class="slide-title text-[var(--ink-primary)] mb-5"
              style="font-size: clamp(2rem, 4vw, 3.75rem);"
              data-reveal
              data-reveal-delay="0.08"
              it={'L’analista AI che aiuta a esplorare il "perché"'}
              en={'An AI analyst to explore the "why"'}
            />
            <T as="p"
              class="text-[var(--ink-secondary)] leading-relaxed mb-6"
              style="font-size: clamp(1rem, 1.35vw, 1.25rem);"
              data-reveal
              data-reveal-delay="0.15"
              it="Una domanda in linguaggio naturale può avviare l’indagine di un’anomalia. Fonti, copertura degli eventi e contesto operativo determinano cosa si può concludere."
              en="A natural-language question can start an anomaly investigation. Sources, event coverage and operating context determine what can be concluded."
            />
            <div class="uc-panel uc-panel--rosso" data-reveal data-reveal-delay="0.22">
              <div class="uc-panel-head">
                <T as="p" class="uc-tag" it="Domanda illustrativa" en="Illustrative question" />
              </div>
                <T as="p" class="text-[var(--ink-primary)] italic" style="font-size: 1rem; line-height: 1.55;" it={'"In quale passaggio del simulatore le persone interrompono più spesso il percorso?"'} en={'"At which step of the simulator do people most often leave the process?"'} />
                <T as="p" class="text-[var(--ink-brand-text)] mt-2 font-medium" style="font-size: 0.95rem; line-height: 1.5;" it="→ Possibile punto da indagare: verificare copertura degli eventi, modifiche recenti e differenze tra segmenti prima di attribuire una causa." en="→ Possible area to investigate: check event coverage, recent changes and segment differences before assigning a cause." />
            </div>
          </div>

          <div class="flex flex-col gap-3" data-reveal data-reveal-delay="0.3">
            {agentCapabilities.map((cap) => (
              <div class="uc-panel uc-panel--row items-start gap-4" style="padding: 0.8rem 1.1rem;">
                <span class="text-[var(--ink-brand-text)] text-xl flex-shrink-0 mt-0.5">{cap.icon}</span>
                <div class="min-w-0">
                  <T as="p" class="font-semibold text-[var(--ink-primary)] mb-1" style="font-size: 1rem;" it={cap.title.it} en={cap.title.en} />
                  <T as="p" class="uc-panel-body" style="margin-bottom: 0;" it={cap.body.it} en={cap.body.en} />
                </div>
              </div>
            ))}

            <div class="uc-panel uc-panel--oro mt-1" data-reveal data-reveal-delay="0.45">
              <div class="uc-panel-head">
                <T as="p" class="uc-tag" style="color: var(--ink-accent);" it="Email non aperta · cosa non sappiamo" en="Unopened email · what we do not know" />
                <span class="uc-node"></span>
              </div>
              <T as="p" class="uc-quote-text" style="margin-top: 0; font-size: clamp(1.05rem, 1.3vw, 1.3rem);" it="Lo stato di apertura non spiega l’interesse né le preferenze di contatto. Verificare qualità del tracking e contesto prima di considerare un seguito." en="Open status does not explain interest or contact preferences. Check tracking quality and context before considering a follow-up." />
            </div>
          </div>
        </div>
        <MediaDemoSlot id="analizza-dia-demo" label="Data Insights Agent — Demo Video" />
      </div>
    </Slide>

    <!-- ── SLIDE 4: LLM Insights (il primo touchpoint di Marco) ──────────────────────────────────── -->
    <Slide id="slide-llm" bg="primary" align="center">
      <div slot="backdrop" class="uc-bg absolute inset-0" aria-hidden="true"></div>
      <T as="p" class="slide-eyebrow text-center text-[var(--ink-brand-text)] mb-4" data-reveal it="LLM INSIGHTS · REFERRAL OSSERVABILI" en="LLM INSIGHTS · OBSERVABLE REFERRALS" />
      <T as="h2"
        class="slide-title text-[var(--ink-primary)] mb-5"
        style="font-size: clamp(2rem, 3.8vw, 3.4rem);"
        data-reveal
        data-reveal-delay="0.08"
        it="Un referral AI può essere misurato, se è osservabile."
        en="An AI referral can be measured, when it is observable."
      />
      <T as="p"
        class="text-[clamp(1rem,1.35vw,1.2rem)] text-[var(--ink-secondary)] max-w-3xl mb-7 leading-relaxed"
        data-reveal
        data-reveal-delay="0.15"
        it="Quando referral e consenso lo consentono, il team può confrontare il traffico proveniente dagli assistenti con altri ingressi. Non vede per questo le conversazioni né l’intero percorso di una persona."
        en="Where referrals and consent allow, a team can compare traffic from assistants with other entry points. That does not reveal the conversations or a person’s full journey."
      />

      <div
        class="w-full max-w-5xl mx-auto grid md:grid-cols-3 gap-5 mb-5"
        data-reveal
        data-reveal-delay="0.22"
      >
        {llmInsightsPoints.map((p) => (
          <div class="uc-panel uc-panel--oro text-left">
            <div class="uc-panel-head">
              <T as="p" class="uc-tag" style="color: var(--ink-accent);" it={p.label.it} en={p.label.en} />
            </div>
            <T as="p" class="uc-panel-body" style="margin-bottom: 0;" it={p.body.it} en={p.body.en} />
          </div>
        ))}
      </div>

      <div class="uc-panel uc-panel--rosso max-w-3xl mx-auto text-left" data-reveal data-reveal-delay="0.3">
        <div class="uc-panel-head">
          <T as="p" class="uc-tag" it="Il CMO, in questo momento" en="The CMO, right now" />
          <span class="uc-node uc-node--rosso"></span>
        </div>
        <T as="p" class="uc-quote-text" style="margin-top: 0; font-size: clamp(1.05rem, 1.3vw, 1.3rem);" it="Possiamo misurare i referral dagli assistenti AI che riusciamo a osservare, senza confonderli con l’intero percorso?" en="Can we measure referrals from AI assistants where they are observable, without confusing them with the full journey?" />
      </div>
    </Slide>

    <!-- ── SLIDE 5: Cost-per-click → outcome, when measurable ─────── -->
    <Slide id="slide-costpersale" bg="primary" align="center" data-solution="cja">
      <div slot="backdrop" class="uc-bg absolute inset-0" aria-hidden="true"></div>
      <T as="p" class="slide-eyebrow text-center text-[var(--ink-brand-text)] mb-3" data-reveal it="ATTRIBUTION · DAL CLICK ALL’ESITO" en="ATTRIBUTION · FROM CLICK TO OUTCOME" />
      <T as="h2"
        class="slide-title text-[var(--ink-primary)] mb-3"
        style="font-size: clamp(1.9rem, 3.6vw, 3.2rem);"
        data-reveal
        data-reveal-delay="0.08"
        it="Collegare il marketing agli esiti<br/>richiede dati e un modello condiviso."
        en="Connecting marketing to outcomes<br/>takes data and an agreed model."
      />
      <T as="p"
        class="text-[clamp(1rem,1.35vw,1.2rem)] text-[var(--ink-secondary)] max-w-3xl mb-4 leading-relaxed"
        data-reveal
        data-reveal-delay="0.15"
        it="Nel percorso illustrativo di Marco non è registrata una vendita. Un modello cost-per-sale richiederebbe esiti acquisiti, fonti collegate e regole di attribution concordate."
        en="Marco’s illustrative journey includes no recorded sale. A cost-per-sale model would require captured outcomes, connected sources and agreed attribution rules."
      />

      <div class="w-full max-w-4xl mx-auto grid md:grid-cols-2 gap-4 mb-3" data-reveal data-reveal-delay="0.22">
        <div class="uc-panel uc-panel--oro text-left">
          <div class="uc-panel-head">
            <p class="uc-tag" style="color: var(--ink-accent);">MTA · multi-touch</p>
          </div>
