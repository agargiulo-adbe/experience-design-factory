---
import BaseLayout from '../layouts/BaseLayout.astro';
import UniNavigation from '../components/UniNavigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import CoverHero from '@edf/core/blocks/CoverHero.astro';
import SlideBackdrop from '@edf/core/blocks/SlideBackdrop.astro';
import { href } from '@edf/core/utils/url.js';
import { mediaProps } from '../../assets.index';
import MediaDemoSlot from '@edf/core/blocks/immersive/MediaDemoSlot.astro';
import T from '@edf/core/blocks/i18n/T.astro';

const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;

const cxaPillars = [
  { id: 'digital', label: 'Digital Analytics', body: { it: 'Misura ogni interazione digitale, da app a web a call center, con la profondità di Adobe Analytics.', en: 'Measure every digital interaction — app, web, call center — with the depth of Adobe Analytics.' } },
  { id: 'journeys', label: 'Customer & Group Journeys', body: { it: "Vista whole-person e per buying group: il percorso del singolo cliente e quello dei gruppi (famiglie, aziende), uniti con identity stitching e attribution custom, dall'app alla filiale.", en: 'A whole-person and buying-group view: the path of each customer and of groups (families, companies), joined with identity stitching and custom attribution, from app to branch.' } },
  { id: 'marketing', label: 'Marketing Planning & ROI', body: { it: 'Marketing Campaign Analytics: attribution causale full-funnel, incrementalità di canale e budget ottimizzato in-flight — con raccomandazioni agentiche.', en: 'Marketing Campaign Analytics: full-funnel causal attribution, channel incrementality and budget optimized in-flight, with agentic recommendations.' } },
  { id: 'content', label: 'Content Intelligence', body: { it: 'Misura quale contenuto porta a risultati — per segmento, canale e momento del journey.', en: 'Measure which content drives results, by segment, channel and journey moment.' } },
];

const agentCapabilities = [
  {
    icon: '◉',
    title: { it: 'Parla la lingua del business', en: 'Speaks the language of the business' },
    body: { it: 'Chiedi "perché le domande di mutuo sono calate questa settimana" e ottieni la risposta con root cause analysis in minuti, non giorni.', en: 'Ask "why did mortgage applications drop this week" and get the answer, with root cause analysis, in minutes rather than days.' },
  },
  {
    icon: '◈',
    title: { it: 'Grounded in truth', en: 'Grounded in truth' },
    body: { it: 'Ogni insight è verificato sul motore analitico di Adobe: ciò che emerge è un fatto, non solo qualcosa di plausibile.', en: "Every insight is verified against Adobe's analytics engine: what surfaces is a fact, not just something plausible." },
  },
  {
    icon: '◇',
    title: { it: 'Built for trust', en: 'Built for trust' },
    body: { it: 'Gli analisti validano e collaborano sugli insight prima che arrivino al C-suite. L\'AI amplifica il team, non lo bypassa.', en: 'Analysts validate and collaborate on insights before they reach the C-suite. AI amplifies the team rather than bypassing it.' },
  },
  {
    icon: '◆',
    title: { it: 'Answers why in minutes', en: 'Answers why in minutes' },
    body: { it: 'Root Cause Analysis individua le anomalie e ne spiega le cause in automatico, su 4 milioni di clienti e in tempo reale.', en: 'Root Cause Analysis spots anomalies and explains their causes automatically, across 4 million customers in real time.' },
  },
];

const everywhereChannels = [
  { name: 'AI Assistant', sub: { it: 'Adobe nativo', en: 'Adobe native' }, color: 'var(--accent-primary)' },
  { name: 'Microsoft Copilot', sub: { it: 'nel workspace aziendale', en: 'in the corporate workspace' }, color: 'var(--accent-secondary)' },
  { name: 'ChatGPT', sub: { it: 'accesso universale', en: 'universal access' }, color: 'var(--accent-primary)' },
  { name: 'Interfacce MCP', sub: { it: 'qualsiasi client AI', en: 'any AI client' }, color: 'var(--accent-secondary)' },
  { name: 'Data Insights Agent', sub: { it: 'embed in ogni app', en: 'embedded in every app' }, color: 'var(--accent-primary)' },
];

const llmInsightsPoints = [
  { label: { it: 'Conversazione', en: 'Conversation' }, body: { it: 'Analizza come i clienti interagiscono con il Brand Concierge UniCredit — quali domande fanno, dove si bloccano.', en: 'See how customers interact with the UniCredit Brand Concierge: what they ask, where they get stuck.' } },
  { label: { it: 'Scoperta AI-driven', en: 'AI-driven discovery' }, body: { it: 'Misura quanto traffico arriva da LLM (Gemini, ChatGPT) e come si comporta rispetto ai canali tradizionali.', en: 'Measure how much traffic comes from LLMs (Gemini, ChatGPT) and how it behaves against traditional channels.' } },
  { label: { it: 'AI Journey', en: 'AI Journey' }, body: { it: 'Traccia il percorso di clienti che iniziano da un assistente AI esterno e completano una transazione nel digital banking.', en: 'Track customers who start from an external AI assistant and complete a transaction in digital banking.' } },
];

const bankingUseCases = [
  {
    tag: 'Attribution',
    title: { it: 'Full-funnel attribution causale', en: 'Full-funnel causal attribution' },
    body: { it: 'Collega i dati pubblicitari ai segnali comportamentali e ottimizza il budget con AI causale Adobe, non col last-click.', en: 'Link ad data to behavioral signals and optimize budget with Adobe causal AI, not last-click.' },
    solution: 'Marketing Campaign Analytics',
  },
  {
    tag: 'Retail Banking',
    title: { it: 'Offline data ingestion', en: 'Offline data ingestion' },
    body: { it: 'Unisci i dati di filiale e call center ai journey digitali: il percorso completo del cliente, anche quando passa dall\'app allo sportello.', en: 'Merge branch and call-center data into digital journeys: the full customer path, even when it moves from app to counter.' },
    solution: 'CJA',
  },
  {
    tag: 'Churn Prevention',
    title: { it: 'Segnali precoci di abbandono', en: 'Early churn signals' },
    body: { it: 'CJA riconosce i segnali di abbandono 14-30 giorni prima; AJO attiva journey di retention personalizzate.', en: 'CJA spots churn signals 14-30 days ahead; AJO fires personalized retention journeys.' },
    solution: 'CJA + AJO',
  },
];

// Slide «last-touch» — pesi illustrativi dei canali su una singola vendita
// che il report ufficiale attribuisce a un solo canale (last-touch).
const channelWeights = [
  { name: 'App', pct: 45 },
  { name: 'Contact center', pct: 30 },
  { name: { it: 'Filiale', en: 'Branch' }, pct: 25 },
];

const funnelSteps = [
  { event: { it: 'Accesso app', en: 'App login' }, users: '4.000.000', pct: 100 },
  { event: { it: 'Sezione Prestiti', en: 'Loans section' }, users: '820.000', pct: 20.5 },
  { event: { it: 'Simulazione mutuo', en: 'Mortgage simulation' }, users: '144.000', pct: 3.6 },
  { event: { it: 'Appuntamento', en: 'Appointment' }, users: '28.000', pct: 0.7 },
  { event: { it: 'Contratto firmato', en: 'Contract signed' }, users: '9.200', pct: 0.23 },
];
---
<BaseLayout
  title="Adobe CX Analytics"
  description="Per UniCredit, l'intelligenza dati che guida ogni decisione: Data Insights Agent, LLM Insights, Marketing Campaign Analytics."
  pageSolutions={['cja']}
>
  <div class="fixed top-0 left-0 right-0 z-50">
    <UniNavigation currentPath={currentPath} base={base} />
  </div>

  <DeckContainer nextHref={href(base, '/coworker')} prevHref={href(base, '/contenuti')}>

    <!-- ── SLIDE 0: Cover ─────────────────────────────────────────── -->
    <Slide id="slide-cover" bg="inverse" align="center">
      <SlideBackdrop
        slot="backdrop"
        {...mediaProps('bg-digital-blue')}
        imageClass="opacity-18"
        scrim="bg-[var(--surface-inverse)]/84"
      />
      <span data-lang-it class="contents">
        <CoverHero
          eyebrow="06 · ADOBE CX ANALYTICS"
          numeral="06"
          title="L'intelligenza<br/>che decide"
          lead="Sapere quali canali portano davvero le vendite e agire dove lavora il team: dall'analista al CEO, dall'app a Microsoft Copilot."
          size="phase"
          tone="inverse"
          signature={false}
        />
      </span>
      <span data-lang-en class="contents">
        <CoverHero
          eyebrow="06 · ADOBE CX ANALYTICS"
          numeral="06"
          title="The intelligence<br/>that decides"
          lead="Knowing which channels really drive sales, and acting where the team works: from analyst to CEO, from the app to Microsoft Copilot."
          size="phase"
          tone="inverse"
          signature={false}
        />
      </span>
    </Slide>

    <!-- ── SLIDE 1: Annuncio Adobe CX Analytics ───────────────────── -->
    <Slide id="slide-cxa-brand" bg="brand" align="center">
      <SlideBackdrop
        slot="backdrop"
        {...mediaProps('bg-digital-blue')}
        imageClass="opacity-8"
        scrim="bg-[var(--accent-primary)]/85"
      />
      <T as="p" class="slide-eyebrow text-center text-[var(--ink-inverse)]/70 mb-2.5" data-reveal it="SUMMIT 2026 · ANNUNCIO CHIAVE" en="SUMMIT 2026 · KEY ANNOUNCEMENT" />
      <h2
        class="text-[var(--ink-inverse)] mb-2"
        style="font-size: clamp(1rem, 1.4vw, 1.3rem); font-weight: 400; letter-spacing: 0.15em; text-transform: uppercase;"
        data-reveal
        data-reveal-delay="0.05"
      >
        Announcing
      </h2>
      <p
        class="font-[family-name:var(--font-display)] font-light text-[var(--ink-inverse)] leading-none mb-4"
        style="font-size: clamp(2.6rem, 4.4vw, 4.4rem);"
        data-reveal
        data-reveal-delay="0.1"
      >
        Adobe CX Analytics
      </p>
      <T as="p"
        class="text-[clamp(1rem,1.3vw,1.2rem)] text-[var(--ink-inverse)]/80 max-w-3xl mb-5 leading-relaxed"
        data-reveal
        data-reveal-delay="0.2"
        it="La piattaforma di intelligence unificata che unisce analytics digitali, journey, marketing ROI e content intelligence su un'unica fondazione Adobe Experience Platform."
        en="The unified intelligence platform that brings digital analytics, journeys, marketing ROI and content intelligence together on a single Adobe Experience Platform foundation."
      />

      <div
        class="w-full max-w-4xl mx-auto grid grid-cols-2 gap-3"
        data-reveal
        data-reveal-delay="0.3"
      >
        {cxaPillars.map((p) => (
          <div class="uc-panel uc-panel--oro text-left">
            <div class="uc-panel-head">
              <p class="uc-tag" style="color: var(--color-oro);">{p.label}</p>
            </div>
            <T as="p" class="uc-panel-body" style="margin-bottom: 0;" it={p.body.it} en={p.body.en} />
          </div>
        ))}
      </div>
    </Slide>

    <!-- ── SLIDE 2: Last-touch → vista complementare (ATTRIBUTION) ─ -->
    <Slide id="slide-lasttouch" bg="secondary" align="center" data-solution="cja">
      <div slot="backdrop" class="uc-bg absolute inset-0" aria-hidden="true"></div>
      <T as="p" class="slide-eyebrow text-center text-[var(--accent-primary)] mb-4" data-reveal it="ATTRIBUTION · LA VISTA CHE MANCA" en="ATTRIBUTION · THE MISSING VIEW" />
      <T as="h2"
        class="slide-title text-[var(--ink-primary)] mb-4"
        style="font-size: clamp(2rem, 4vw, 3.5rem);"
        data-reveal
        data-reveal-delay="0.08"
        it="Il last-touch dice chi.<br/>Non dice come."
        en="Last-touch tells you who.<br/>Not how."
      />
      <T as="p"
        class="text-[clamp(1rem,1.35vw,1.2rem)] text-[var(--ink-secondary)] max-w-3xl mb-6 leading-relaxed"
        data-reveal
        data-reveal-delay="0.15"
        it="Il report vendite ufficiale attribuisce ogni vendita a un solo canale, l'ultimo che l'ha registrata. È il modello di governance, e resta così."
        en="The official sales report credits each sale to a single channel, the last one that logged it. That is the governance model, and it stays that way."
      />

      <div class="w-full max-w-5xl mx-auto grid md:grid-cols-2 gap-4 items-stretch" data-reveal data-reveal-delay="0.22">
        <div class="uc-panel uc-panel--rosso text-left">
          <div class="uc-panel-head">
            <T as="p" class="uc-tag" it="Report ufficiale · last-touch" en="Official report · last-touch" />
          </div>
          <div class="flex items-center gap-3 mt-1">
            <T as="span" class="font-[family-name:var(--font-display)] text-[var(--ink-primary)]" style="font-size: clamp(1.4rem,2vw,1.9rem);" it="1 prestito" en="1 loan" />
            <span class="text-[var(--accent-primary)] text-xl">→</span>
            <T as="span" class="font-semibold text-[var(--ink-primary)]" style="font-size: 1.05rem;" it="Filiale" en="Branch" />
          </div>
          <T as="p" class="uc-panel-body mt-2" style="margin-bottom: 0;" it="L'ultimo canale prende tutto il merito; gli altri spariscono dal conto." en="The last channel takes all the credit; the others vanish from the count." />
        </div>

        <div class="uc-panel uc-panel--oro text-left">
          <div class="uc-panel-head">
            <T as="p" class="uc-tag" style="color: var(--color-oro);" it="Vista complementare · CJA" en="Complementary view · CJA" />
          </div>
          <div class="flex flex-col gap-2 mt-1 min-w-0">
            {channelWeights.map((c) => (
              <div class="flex items-center gap-3 min-w-0">
                {typeof c.name === 'string'
                  ? <span class="w-28 flex-shrink-0 font-medium text-[var(--ink-primary)]" style="font-size: 0.9rem;">{c.name}</span>
                  : <T as="span" class="w-28 flex-shrink-0 font-medium text-[var(--ink-primary)]" style="font-size: 0.9rem;" it={c.name.it} en={c.name.en} />}
                <div class="flex-1 min-w-0">
                  <div class="h-6 bg-[var(--accent-primary)] rounded-sm" style={`width: ${c.pct}%;`}></div>
                </div>
                <span class="flex-shrink-0 font-semibold text-[var(--ink-primary)]" style="font-family: var(--font-display); font-size: 0.95rem;">{c.pct}%</span>
              </div>
            ))}
          </div>
          <T as="p" class="uc-panel-body mt-2" style="margin-bottom: 0;" it="Lo stesso venduto, con il peso reale di ogni canale. Senza toccare il modello ufficiale." en="The same sales, with the real weight of each channel. Without touching the official model." />
        </div>
      </div>

      <div class="uc-panel uc-panel--rosso max-w-3xl mx-auto text-left mt-4" data-reveal data-reveal-delay="0.35">
        <p class="uc-panel-body" style="margin-bottom: 0;">
          <T it='<span class="font-semibold text-[var(--ink-primary)]">Per UniCredit:</span> capire quanto app, filiale, contact center e agenti pesano su una vendita attribuita a uno solo, per orchestrare i lead e dare ai team obiettivi quantitativi.' en='<span class="font-semibold text-[var(--ink-primary)]">For UniCredit:</span> seeing how much app, branch, contact center and agents weigh on a sale credited to just one, to orchestrate leads and give teams quantitative targets.' />
        </p>
      </div>
      <T as="p" class="mt-3 text-center text-[0.62rem] tracking-widest uppercase opacity-40" it="Pesi illustrativi · vista complementare, non sostitutiva del modello ufficiale" en="Illustrative weights · complementary view, not a replacement for the official model" />
    </Slide>

    <!-- ── SLIDE 2: Data Insights Agent ──────────────────────────── -->
    <Slide id="slide-agent" bg="primary" align="split">
      <div data-demo-flex class="w-full flex items-start gap-8">
        <div class="flex-1 min-w-0 grid md:grid-cols-2 gap-10 md:gap-14 items-center">
          <div class="text-left">
            <p class="slide-eyebrow text-[var(--accent-primary)] mb-4" data-reveal>DATA INSIGHTS AGENT</p>
            <T as="h2"
              class="slide-title text-[var(--ink-primary)] mb-5"
              style="font-size: clamp(2rem, 4vw, 3.75rem);"
              data-reveal
              data-reveal-delay="0.08"
              it={'L\'analista AI che risponde al "perché"'}
              en={'The AI analyst that answers "why"'}
            />
            <T as="p"
              class="text-[var(--ink-secondary)] leading-relaxed mb-6"
              style="font-size: clamp(1rem, 1.35vw, 1.25rem);"
              data-reveal
              data-reveal-delay="0.15"
              it="Chiedi in linguaggio naturale e ottieni una root cause analysis in minuti, non in giorni. Verificata sul motore analitico Adobe, non generata."
              en="Ask in plain language and get a root cause analysis in minutes, not days. Verified against the Adobe analytics engine, not generated."
            />
            <div class="uc-panel uc-panel--rosso" data-reveal data-reveal-delay="0.22">
              <div class="uc-panel-head">
                <T as="p" class="uc-tag" it="Esempio UniCredit" en="UniCredit example" />
              </div>
              <T as="p" class="text-[var(--ink-primary)] italic" style="font-size: 0.98rem; line-height: 1.55;" it={'"Perché le richieste di mutuo via app sono calate del 18% questa settimana rispetto alla media?"'} en={'"Why did in-app mortgage applications drop 18% this week versus the average?"'} />
              <T as="p" class="text-[var(--accent-primary)] mt-2 font-medium" style="font-size: 0.9rem; line-height: 1.5;" it="→ Root Cause: step 3 del flow aumentato a 4.2s dopo deploy v2.3.1 · segmento 35–44 anni più impattato" en="→ Root Cause: flow step 3 rose to 4.2s after deploy v2.3.1 · 35–44 segment most impacted" />
            </div>
          </div>

          <div class="flex flex-col gap-3" data-reveal data-reveal-delay="0.3">
            {agentCapabilities.map((cap) => (
              <div class="uc-panel flex-row items-start gap-4" style="flex-direction: row; padding: 0.8rem 1.1rem;">
                <span class="text-[var(--accent-primary)] text-xl flex-shrink-0 mt-0.5">{cap.icon}</span>
                <div class="min-w-0">
                  <T as="p" class="font-semibold text-[var(--ink-primary)] mb-1" style="font-size: 1rem;" it={cap.title.it} en={cap.title.en} />
                  <T as="p" class="uc-panel-body" style="margin-bottom: 0;" it={cap.body.it} en={cap.body.en} />
                </div>
              </div>
            ))}

            <div class="uc-panel uc-panel--oro mt-1" data-reveal data-reveal-delay="0.45">
              <div class="uc-panel-head">
                <T as="p" class="uc-tag" style="color: var(--color-oro);" it="Marco, in questo momento" en="Marco, right now" />
                <span class="uc-node"></span>
              </div>
              <T as="p" class="uc-quote-text" style="margin-top: 0; font-size: clamp(1.05rem, 1.3vw, 1.3rem);" it="«Marco non aveva aperto l'email del mutuo. Il Data Insights Agent lo aveva già segnalato come at-risk e suggerito un reminder SMS per mercoledì mattina.»" en="«Marco hadn't opened the mortgage email. The Data Insights Agent had already flagged him as at-risk and suggested an SMS reminder for Wednesday morning.»" />
            </div>
          </div>
        </div>
        <MediaDemoSlot id="analizza-dia-demo" label="Data Insights Agent — Demo Video" />
      </div>
    </Slide>

    <!-- ── SLIDE 3: Analytics Everywhere + MCP ───────────────────── -->
    <Slide id="slide-everywhere" bg="inverse" align="center">
      <SlideBackdrop
        slot="backdrop"
        {...mediaProps('bg-data-dark')}
        imageClass="opacity-12"
        scrim="bg-[var(--surface-inverse)]/88"
      />
      <p class="slide-eyebrow text-center text-[var(--color-grigio-300)] mb-4" data-reveal>ANALYTICS EVERYWHERE</p>
      <T as="h2"
        class="slide-title text-[var(--ink-inverse)] mb-5"
        style="font-size: clamp(2.25rem, 4.4vw, 4rem);"
        data-reveal
        data-reveal-delay="0.08"
        it="L'intelligence<br/>ovunque lavori il team"
        en="Intelligence<br/>wherever the team works"
      />
      <T as="p"
        class="text-[clamp(1.05rem,1.4vw,1.3rem)] text-[var(--color-grigio-300)] max-w-2xl mb-10"
        data-reveal
        data-reveal-delay="0.15"
        it="Tramite MCP (Model Context Protocol), Adobe CX Analytics espone i dati di CJA e Adobe Analytics a qualsiasi AI assistant, senza export e senza integrazione custom."
        en="Through MCP (Model Context Protocol), Adobe CX Analytics exposes CJA and Adobe Analytics data to any AI assistant, with no export and no custom integration."
      />

      <div class="w-full max-w-3xl mx-auto uc-thread mb-6" data-reveal data-reveal-delay="0.18" aria-hidden="true">
        <span class="uc-node uc-node--rosso"></span>
        <span class="uc-thread-line"></span>
        <span class="uc-node"></span>
      </div>

      <div
        class="w-full max-w-3xl mx-auto grid grid-cols-3 md:grid-cols-5 gap-3 mb-10"
        data-reveal
        data-reveal-delay="0.22"
      >
        {everywhereChannels.map((ch, i) => (
          <div class="uc-panel text-center" style="padding: 0.85rem 0.9rem; align-items: center;">
            <p class="font-semibold text-[var(--ink-primary)] mb-0.5" style="font-size: 0.95rem;">{ch.name}</p>
            <T as="p" class="text-[var(--ink-secondary)]" style="font-size: 0.85rem;" it={ch.sub.it} en={ch.sub.en} />
          </div>
        ))}
      </div>

      <div class="uc-panel uc-panel--oro max-w-3xl mx-auto text-left" data-reveal data-reveal-delay="0.3">
        <div class="uc-panel-head">
          <T as="p" class="uc-tag" style="color: var(--color-oro);" it="Il team Digital Channels — UniCredit" en="The Digital Channels team — UniCredit" />
        </div>
        <T as="p" class="uc-panel-body" style="margin-bottom: 0;" it="Il team di Digital Channels può interrogare i dati di performance dell'app UniCredit direttamente da Microsoft Copilot nel loro workflow quotidiano — senza aprire un tool di analytics separato." en="The Digital Channels team can query UniCredit app performance data straight from Microsoft Copilot in their daily workflow, without opening a separate analytics tool." />
      </div>
    </Slide>

    <!-- ── SLIDE 4: LLM Insights ──────────────────────────────────── -->
    <Slide id="slide-llm" bg="primary" align="center">
      <div slot="backdrop" class="uc-bg absolute inset-0" aria-hidden="true"></div>
      <T as="p" class="slide-eyebrow text-center text-[var(--accent-primary)] mb-4" data-reveal it="LLM INSIGHTS · NUOVA CAPABILITY" en="LLM INSIGHTS · NEW CAPABILITY" />
      <T as="h2"
        class="slide-title text-[var(--ink-primary)] mb-5"
        style="font-size: clamp(2.25rem, 4.4vw, 4rem);"
        data-reveal
        data-reveal-delay="0.08"
        it="Misurare l'era dell'AI conversazionale"
        en="Measuring the conversational AI era"
      />
      <T as="p"
        class="text-[clamp(1.05rem,1.4vw,1.3rem)] text-[var(--ink-secondary)] max-w-2xl mb-10"
        data-reveal
        data-reveal-delay="0.15"
        it="Sempre più clienti iniziano il percorso finanziario chiedendo a Gemini o ChatGPT. Per la prima volta, LLM Insights rende misurabile quel traffico."
        en="More and more customers start their financial journey by asking Gemini or ChatGPT. For the first time, LLM Insights makes that traffic measurable."
      />

      <div
        class="w-full max-w-4xl mx-auto grid md:grid-cols-3 gap-5 mb-10"
        data-reveal
        data-reveal-delay="0.22"
      >
        {llmInsightsPoints.map((p) => (
          <div class="uc-panel uc-panel--oro text-left">
            <div class="uc-panel-head">
              <T as="p" class="uc-tag" style="color: var(--color-oro);" it={p.label.it} en={p.label.en} />
            </div>
            <T as="p" class="uc-panel-body" style="margin-bottom: 0;" it={p.body.it} en={p.body.en} />
          </div>
        ))}
      </div>

      <div class="uc-panel uc-panel--rosso max-w-3xl mx-auto text-left" data-reveal data-reveal-delay="0.3">
        <p class="uc-panel-body" style="margin-bottom: 0;">
