---
import BaseLayout from '../layouts/BaseLayout.astro';
import UniNavigation from '../components/UniNavigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import CoverHero from '@edf/core/blocks/CoverHero.astro';
import SlideBackdrop from '@edf/core/blocks/SlideBackdrop.astro';
import { href } from '@edf/core/utils/url.js';
import { mediaProps } from '../../assets.index';
import MediaDemoSlot from '@edf/core/blocks/immersive/MediaDemoSlot.astro';
import T from '@edf/core/blocks/i18n/T.astro';

const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;

const aiPlatformCapabilities = [
  { label: { en: 'Grounded in customer data', it: 'Grounded in customer data' }, body: { en: 'The AI runs on real context: customer data, approved content, brand guidelines, business processes.', it: 'L\'AI è alimentata dal contesto reale: dati cliente, contenuti approvati, brand guidelines, processi aziendali.' } },
  { label: { en: 'Enterprise-grade by design', it: 'Enterprise-grade by design' }, body: { en: 'Governance, security and compliance built in from the ground up, not bolted on later. Designed for regulated sectors like banking.', it: 'Governance, sicurezza e compliance costruite dalla base, non aggiunte dopo. Pensato per settori regolamentati come il banking.' } },
  { label: { en: '1st + 3rd party models', it: '1st + 3rd party models' }, body: { en: 'The best foundation models on the market plus Adobe\'s own models tuned for CX, analytics and creative.', it: 'I migliori modelli fondazionali di mercato + modelli proprietari Adobe specializzati per CX, analytics, creative.' } },
  { label: { en: 'Purpose-built agents', it: 'Purpose-built agents' }, body: { en: 'AI agents that scale CX operations: they orchestrate journeys, surface insight and produce content on their own.', it: 'Agenti AI che scalano le operazioni CX: orchestrano journeys, generano insight, producono contenuti — in autonomia.' } },
];

const stackLayers = [
  {
    layer: 'Brand Visibility',
    products: ['AEM Sites', 'AEM Sites Optimizer', 'AEM Assets', 'Firefly'],
    color: 'var(--accent-secondary)',
    claim: { en: 'Orchestrated digital presence: web content, agentic optimization, unified DAM, AI images under commercial license.', it: 'Presenza digitale orchestrata: contenuti web, ottimizzazione agentica, DAM unificato, immagini AI su licenza commerciale.' },
  },
  {
    layer: 'Content Supply Chain',
    products: ['GenStudio', 'Firefly', 'AEM Assets', 'Frame.io'],
    color: 'var(--accent-secondary)',
    claim: { en: 'From brief to deployment: content variants in minutes, full traceability, native review.', it: 'Dalla brief al deployment: varianti di contenuto in minuti, tracciabilità completa, review nativa.' },
  },
  {
    layer: 'Customer Engagement',
    products: ['Journey Optimizer B2C', 'Adobe Target', 'Real-Time CDP', 'Brand Concierge'],
    color: 'var(--accent-primary)',
    claim: { en: 'Real-time omnichannel orchestration (push, email, in-app, SMS, web) and conversational engagement, on a unified customer profile.', it: 'Orchestrazione omnicanale in tempo reale (push, email, in-app, SMS, web) e ingaggio conversazionale, con profilo cliente unificato.' },
  },
  {
    layer: 'Adobe CX Analytics',
    products: ['Customer Journey Analytics', 'Adobe Analytics', 'Marketing Campaign Analytics', 'Content Analytics'],
    color: 'var(--accent-primary)',
    claim: { en: 'Unified intelligence: digital + journey analytics, causal marketing ROI, content performance and LLM measurement.', it: 'Intelligence unificata: digital + journey analytics, marketing ROI causale, content performance e misura degli LLM.' },
  },
];

const dataFoundation = [
  { abbr: 'AEP', name: { en: 'Adobe Experience Platform', it: 'Adobe Experience Platform' }, sol: 'aep', claim: { en: 'The central hub: it collects, governs, unifies and activates every piece of customer data in real time across all channels.', it: 'Hub centrale: raccoglie, governa, unifica e attiva ogni dato cliente in tempo reale su tutti i canali.' } },
  { abbr: 'CDP', name: { en: 'Real-Time CDP', it: 'Real-Time CDP' }, sol: 'rtcdp', claim: { en: 'A unified customer profile refreshed in milliseconds, from app, branch, call center and online.', it: 'Profilo cliente unificato aggiornato in millisecondi, da app, filiale, call center e online.' } },
  { abbr: 'AI', name: { en: 'Adobe AI Platform', it: 'Adobe AI Platform' }, sol: null, claim: { en: 'The AI layer (Adobe and third-party agents, agent skills, tools and MCP) that runs Data Insights Agent, Brand Concierge and the coworkers.', it: 'Il layer AI (agenti Adobe e di terze parti, agent skill, tool e MCP) su cui girano Data Insights Agent, Brand Concierge e i coworker.' } },
  { abbr: 'MCP', name: { en: 'MCP interfaces', it: 'Interfacce MCP' }, sol: null, claim: { en: 'MCP interfaces to AEP and the Adobe apps — they let AI clients (Copilot, ChatGPT, Gemini, internal tools) query Adobe data.', it: 'Interfacce MCP verso AEP e le app Adobe — consentono a client AI (Copilot, ChatGPT, Gemini, tool interni) di interrogare i dati Adobe.' } },
];

const contentEngine = [
  { abbr: 'GEN', name: { en: 'GenStudio', it: 'GenStudio' }, sol: 'genstudio', claim: { en: 'Generates copy and layouts for every segment in minutes, with UniCredit brand guidelines built in and automatic compliance.', it: 'Genera copy e layout per ogni segmento in minuti, con brand guidelines UniCredit integrate e compliance automatica.' } },
  { abbr: 'FF', name: { en: 'Adobe Firefly', it: 'Adobe Firefly' }, sol: 'firefly', claim: { en: 'Images generated under commercial license: brand-safe by design, with no IP risk.', it: 'Immagini generate su licenza commerciale: brand-safe by design, senza rischi sull\'IP.' } },
  { abbr: 'DAM', name: { en: 'AEM Assets', it: 'AEM Assets' }, sol: 'aem-assets', claim: { en: 'Unified Digital Asset Management: every asset approved, versioned and delivered across all channels.', it: 'Digital Asset Management unificato: ogni asset approvato, versionato e distribuito su tutti i canali.' } },
  { abbr: 'EDS', name: { en: 'AEM Sites', it: 'AEM Sites' }, sol: 'aem-sites', claim: { en: 'Edge Delivery: the UniCredit site at 0.3s, git-based authoring, AI-driven SEO optimization.', it: 'Edge Delivery: il sito UniCredit a 0.3s, authoring git-based, ottimizzazione SEO AI-driven.' } },
];

const b2bLayer = [
  { abbr: 'AJO B2B', name: { en: 'Journey Optimizer B2B', it: 'Journey Optimizer B2B' }, sol: 'ajo-b2b', claim: { en: 'Account-based journeys and buying group orchestration for corporate banking.', it: 'Account-based journeys e buying group orchestration per il corporate banking.' } },
  { abbr: 'MKT', name: { en: 'Marketo Engage', it: 'Marketo Engage' }, sol: 'marketo', claim: { en: 'Demand generation and lead nurturing for business and enterprise segments.', it: 'Demand generation e lead nurturing per segmenti business ed enterprise.' } },
  { abbr: 'CJA B2B', name: { en: 'CJA B2B Edition', it: 'CJA B2B Edition' }, sol: 'cja', claim: { en: 'Analytics built for account-based journeys — it measures buying group engagement.', it: 'Analytics dedicato ai journey account-based — misura l\'engagement dei buying group.' } },
];

const integrationAdvantages = [
  { stat: '1', label: { en: 'unified data schema', it: 'schema dati unificato' }, body: { en: 'Every product speaks XDM. No custom mapping between solutions.', it: 'Tutti i prodotti parlano XDM. Zero mapping custom tra soluzioni.' } },
  { stat: '0', label: { en: 'integrations to build', it: 'integrazioni da costruire' }, body: { en: 'AEP is the native data hub. Every product is already connected.', it: 'AEP è il data hub nativo. Ogni prodotto è già connesso.' } },
  { stat: '∞', label: { en: 'scalability', it: 'scalabilità' }, body: { en: 'From today\'s millions of customers to 100M, on the same architecture and the same governance.', it: 'Dai milioni di clienti di oggi a 100M, con la stessa architettura e la stessa governance.' } },
];

// Mappa prodotto→soluzione: consente al runtime di gating (data-solution)
// di nascondere i singoli chip/pill nelle slide aggregate quando la relativa
// soluzione viene spenta dalla console. Prodotti senza toggle (Frame.io,
// Adobe Analytics, MCP, Adobe AI Platform) → null = sempre visibili.
const PRODUCT_SOL: Record<string, string | null> = {
  'AEM Sites': 'aem-sites', 'AEM Sites Optimizer': 'aem-sites', 'AEM Assets': 'aem-assets', 'Firefly': 'firefly',
  'GenStudio': 'genstudio', 'Frame.io': null,
  'Journey Optimizer B2C': 'ajo-b2c', 'Adobe Target': 'target', 'Real-Time CDP': 'rtcdp', 'Brand Concierge': 'brand-concierge',
  'Customer Journey Analytics': 'cja', 'Adobe Analytics': null, 'Marketing Campaign Analytics': 'mix-modeler',
  'Content Analytics': 'content-analytics', 'LLM Insights': null,
};

const foundationBand = [
  { name: { en: 'AEP', it: 'AEP' }, sol: 'aep' },
  { name: { en: 'Real-Time CDP', it: 'Real-Time CDP' }, sol: 'rtcdp' },
  { name: { en: 'Adobe AI Platform', it: 'Adobe AI Platform' }, sol: null },
  { name: { en: 'Data Insights Agent', it: 'Data Insights Agent' }, sol: 'data-insights-agent' },
  { name: { en: 'MCP interfaces', it: 'Interfacce MCP' }, sol: null },
];

const integrationPills = [
  { name: 'Real-Time CDP', sol: 'rtcdp' }, { name: 'CX Analytics', sol: 'cx-analytics' },
  { name: 'CJA', sol: 'cja' }, { name: 'Marketing Campaign Analytics', sol: 'mix-modeler' },
  { name: 'Content Analytics', sol: 'content-analytics' }, { name: 'AJO B2C', sol: 'ajo-b2c' },
  { name: 'Target', sol: 'target' }, { name: 'Brand Concierge', sol: 'brand-concierge' },
  { name: 'AEM Sites', sol: 'aem-sites' }, { name: 'AEM Sites Optimizer', sol: 'aem-sites' },
  { name: 'GenStudio', sol: 'genstudio' }, { name: 'Firefly', sol: 'firefly' },
  { name: 'AEM Assets', sol: 'aem-assets' }, { name: 'Frame.io', sol: null },
  { name: 'AJO B2B', sol: 'ajo-b2b' }, { name: 'Marketo', sol: 'marketo' },
];
---
<BaseLayout
  title="Adobe CX Enterprise — Il Motore"
  description="Il sistema nervoso della CX UniCredit: Adobe Experience Platform come fondazione e hub dati, CX Analytics come intelligence."
>
  <div class="fixed top-0 left-0 right-0 z-50">
    <UniNavigation currentPath={currentPath} base={base} />
  </div>

  <DeckContainer nextHref={href(base, '/risultati')} prevHref={href(base, '/b2b')}>

    <!-- ── SLIDE 0: Cover ─────────────────────────────────────────── -->
    <Slide id="slide-cover" bg="inverse" align="center">
      <SlideBackdrop
        slot="backdrop"
        {...mediaProps('bg-digital-blue')}
        imageClass="opacity-18"
        scrim="bg-[var(--surface-inverse)]/84"
      />
      <span data-lang-it class="contents">
        <CoverHero
          eyebrow="IL SISTEMA"
          title="Adobe CX Enterprise"
          lead="Tutto quello che Marco e Sofia hanno vissuto (il sito a 0,3 secondi, il profilo unificato, il reel ads generato in pochi minuti, il mutuo casa già su misura) nasce da qui."
          size="hero"
          tone="inverse"
          primary="UniCredit"
          secondary="Adobe"
        />
      </span>
      <span data-lang-en class="contents">
        <CoverHero
          eyebrow="THE SYSTEM"
          title="Adobe CX Enterprise"
          lead="Everything Marco and Sofia experienced (the site at 0.3 seconds, the unified profile, the reel ad generated in minutes, the home mortgage already tailored) starts right here."
          size="hero"
          tone="inverse"
          primary="UniCredit"
          secondary="Adobe"
        />
      </span>
    </Slide>

    <!-- ── SLIDE 1: Adobe AI Platform ────────────────────────────── -->
    <Slide id="slide-ai-platform" bg="inverse" align="center">
      <SlideBackdrop
        slot="backdrop"
        {...mediaProps('ai-platform')}
        imageClass="opacity-8"
        scrim="bg-[var(--surface-inverse)]/92"
      />
      <T as="p" class="slide-eyebrow text-center text-[var(--color-grigio-300)] mb-4" data-reveal en="THE FOUNDATION" it="LA FONDAZIONE" />
      <h2
        class="slide-title text-[var(--ink-inverse)] mb-3"
        style="font-size: clamp(2.25rem, 4.4vw, 4rem);"
        data-reveal
        data-reveal-delay="0.08"
      >
        Adobe Experience Platform
      </h2>
      <T
        as="p"
        class="text-[clamp(1.05rem,1.4vw,1.3rem)] text-[var(--color-grigio-300)] max-w-2xl mb-8"
        data-reveal
        data-reveal-delay="0.15"
        en="The AI behind Adobe CX Enterprise isn't generic: it's rooted in customer context, across data, content, brand and processes. Built on AEP for regulated enterprises like banking."
        it="L'AI che alimenta Adobe CX Enterprise non è generica: è radicata nel contesto del cliente, tra dati, contenuti, brand e processi. Costruita su AEP per enterprise regolamentate come il banking."
      />

      <!-- filo motif: il motore tiene i quattro capi -->
      <div class="uc-thread w-full max-w-4xl mx-auto mb-6" data-reveal data-reveal-delay="0.18" aria-hidden="true">
        <span class="uc-node uc-node--rosso"></span>
        <span class="uc-thread-line"></span>
        <span class="uc-node"></span>
        <span class="uc-thread-line"></span>
        <span class="uc-node"></span>
        <span class="uc-thread-line"></span>
        <span class="uc-node"></span>
        <span class="uc-thread-line"></span>
        <span class="uc-node uc-node--rosso"></span>
      </div>

      <div
        class="w-full max-w-4xl mx-auto grid md:grid-cols-2 gap-4"
        data-reveal
        data-reveal-delay="0.22"
      >
        {aiPlatformCapabilities.map((cap) => (
          <div class="uc-panel uc-panel--oro text-left">
            <T as="p" class="uc-tag" style="color: var(--color-oro);" en={cap.label.en} it={cap.label.it} />
            <T as="p" class="uc-panel-body" style="margin-top:0.55rem; margin-bottom:0;" en={cap.body.en} it={cap.body.it} />
          </div>
        ))}
      </div>
    </Slide>

    <!-- ── SLIDE 2: Fondazione dati (AEP + CDP + DIA + MCP) ───────── -->
    <Slide id="slide-data-foundation" bg="primary" align="center">
      <div class="uc-bg absolute inset-0 -z-10" aria-hidden="true"></div>
      <T as="p" class="slide-eyebrow text-center text-[var(--accent-primary)] mb-4" data-reveal en="DATA FOUNDATION" it="FONDAZIONE DATI" />
      <T
        as="h2"
        class="slide-title text-[var(--ink-primary)] mb-4"
        style="font-size: clamp(2.25rem, 4.4vw, 4rem);"
        data-reveal
        data-reveal-delay="0.08"
        en="One hub. Four superpowers."
        it="Un hub. Quattro superpoteri."
      />
      <T
        as="p"
        class="text-[clamp(1.05rem,1.4vw,1.3rem)] text-[var(--ink-secondary)] max-w-2xl mb-8"
        data-reveal
        data-reveal-delay="0.15"
        en="Adobe Experience Platform centralizes all UniCredit data. On this base sit the unified customer profile, AI intelligence and universal connectivity: it's the foundation under every application layer."
        it="Adobe Experience Platform centralizza tutti i dati UniCredit. Su questa base nascono il profilo cliente unificato, l'intelligence AI e la connettività universale: è la fondazione su cui poggia ogni layer applicativo."
      />

      <div
        class="w-full max-w-4xl mx-auto grid md:grid-cols-2 gap-4"
        data-reveal
        data-reveal-delay="0.22"
      >
        {dataFoundation.map((item) => (
          <div class="uc-panel uc-panel--rosso motore-node text-left" data-solution={item.sol ?? undefined}>
            <div class="motore-node-head">
              <span class="motore-abbr">{item.abbr}</span>
              <T as="p" class="motore-name" en={item.name.en} it={item.name.it} />
            </div>
            <T as="p" class="uc-panel-body" style="margin-bottom:0;" en={item.claim.en} it={item.claim.it} />
          </div>
        ))}
      </div>
    </Slide>

    <!-- ── SLIDE 3: Fondazione contenuti (gemella dei dati) ───────── -->
    <Slide id="slide-content-engine" bg="secondary" align="center">
      <div class="uc-bg-soft absolute inset-0 -z-10" aria-hidden="true"></div>
      <T as="p" class="slide-eyebrow text-center text-[var(--accent-secondary)] mb-4" data-reveal en="CONTENT FOUNDATION" it="FONDAZIONE CONTENUTI" />
      <T
        as="h2"
        class="slide-title text-[var(--ink-primary)] mb-4"
        style="font-size: clamp(2.25rem, 4.4vw, 4rem);"
        data-reveal
        data-reveal-delay="0.08"
        en="One factory. Every format."
        it="Una fabbrica. Ogni formato."
      />
      <T
        as="p"
        class="text-[clamp(1.05rem,1.4vw,1.3rem)] text-[var(--ink-secondary)] max-w-2xl mb-8"
        data-reveal
        data-reveal-delay="0.15"
        en="If data says who to talk to, content says what to show. One content supply chain — from brief to publishing, brand-safe and licensed — with brand checks built in before go-live."
        it="Se i dati dicono a chi parlare, i contenuti dicono cosa mostrare. Una content supply chain unica — dalla brief alla pubblicazione, brand-safe e su licenza — con controlli di brand integrati prima del go-live."
      />

      <div
        class="w-full max-w-4xl mx-auto grid md:grid-cols-2 gap-4"
        data-reveal
        data-reveal-delay="0.22"
      >
        {contentEngine.map((item) => (
          <div class="uc-panel uc-panel--oro motore-node text-left" data-solution={item.sol ?? undefined}>
            <div class="motore-node-head">
              <span class="motore-abbr motore-abbr--oro">{item.abbr}</span>
              <T as="p" class="motore-name" en={item.name.en} it={item.name.it} />
            </div>
            <T as="p" class="uc-panel-body" style="margin-bottom:0;" en={item.claim.en} it={item.claim.it} />
          </div>
        ))}
      </div>
    </Slide>

    <!-- ── SLIDE 4: Stack completo (4 layer) ──────────────────────── -->
    <Slide id="slide-stack" bg="secondary" align="center">
      <div class="uc-bg-soft absolute inset-0 -z-10" aria-hidden="true"></div>
      <div data-demo-flex class="w-full flex items-start gap-8">
        <div class="flex-1 min-w-0 flex flex-col items-center">
          <T as="p" class="slide-eyebrow text-[var(--accent-primary)] mb-4" data-reveal en="ADOBE CX ENTERPRISE · FULL STACK" it="ADOBE CX ENTERPRISE · STACK COMPLETO" />
          <T
            as="h2"
            class="slide-title text-[var(--ink-primary)] mb-4"
            style="font-size: clamp(2rem, 3.4vw, 3rem);"
            data-reveal
            data-reveal-delay="0.08"
            en="From every piece of data to every experience"
            it="Da ogni dato a ogni esperienza"
          />

          <div
            class="w-full max-w-5xl mx-auto flex flex-col gap-1.5 motore-stack"
            data-reveal
            data-reveal-delay="0.15"
          >
            {stackLayers.map((layer, i) => (
              <div class="motore-layer">
                <span class="motore-layer-thread" aria-hidden="true"></span>
                <div class="w-40 flex-shrink-0 text-left">
                  <p class="text-sm font-semibold uppercase tracking-wider mb-0.5" style={`color: ${layer.color};`}>Layer {i + 1}</p>
                  <p class="text-xs font-semibold text-[var(--ink-primary)]">{layer.layer}</p>
                </div>
                <div class="flex flex-wrap gap-2 flex-1">
                  {layer.products.map((p) => (
                    <span class="motore-pill" style={`border-color: ${layer.color}59; color: ${layer.color};`} data-solution={PRODUCT_SOL[p] ?? undefined}>
                      {p}
                    </span>
                  ))}
                </div>
                <T as="p" class="text-sm text-[var(--ink-secondary)] leading-relaxed flex-1 text-right max-w-xs hidden md:block" en={layer.claim.en} it={layer.claim.it} />
              </div>
            ))}

            <div class="motore-layer motore-layer--foundation">
              <span class="motore-layer-thread motore-layer-thread--oro" aria-hidden="true"></span>
              <div class="w-40 flex-shrink-0">
                <p class="text-sm font-semibold uppercase tracking-wider text-[var(--accent-secondary)] mb-0.5">Foundation</p>
                <p class="text-xs font-semibold text-[var(--ink-primary)]">Adobe Experience Platform</p>
              </div>
              <p class="foundation-band text-sm text-[var(--ink-secondary)] flex-1">
                {foundationBand.map((f) => (
                  <T as="span" class="foundation-item" data-solution={f.sol ?? undefined} en={f.name.en} it={f.name.it} />
                ))}
              </p>
            </div>
          </div>

          <div class="uc-quote mt-4 max-w-4xl mx-auto text-center" data-reveal data-reveal-delay="0.5">
            <T as="p" class="text-xs font-semibold tracking-wider uppercase text-[var(--ink-tertiary)] mb-2" en="Behind every moment for Marco and Sofia" it="Dietro ogni momento di Marco e Sofia" />
            <T as="p" class="uc-quote-text" style="margin-inline:auto;" en="“Every tap on the app, every reel ad that converted, every AI-generated brief, every home mortgage already tailored: behind it all is a single engine, Adobe Experience Platform.”" it="«Ogni tap sull'app, ogni reel ads che ha convertito, ogni brief AI-generated, ogni mutuo casa già su misura: dietro c'è un solo motore, Adobe Experience Platform.»" />
          </div>
        </div>
        <MediaDemoSlot id="motore-stack-demo" label="Adobe AI Platform — Architecture Diagram" />
      </div>
    </Slide>

    <!-- ── SLIDE 5: B2B Layer ─────────────────────────────────────── -->
    <Slide id="slide-b2b-layer" bg="inverse" align="center" data-solution="ajo-b2b">
      <SlideBackdrop
        slot="backdrop"
        {...mediaProps('bg-digital-blue')}
        imageClass="opacity-8"
        scrim="bg-[var(--surface-inverse)]/92"
      />
      <T as="p" class="slide-eyebrow text-center text-[var(--color-grigio-300)] mb-4" data-reveal en="B2B · CORPORATE BANKING" it="B2B · CORPORATE BANKING" />
      <T
        as="h2"
        class="slide-title text-[var(--ink-inverse)] mb-5"
        style="font-size: clamp(2.25rem, 4.4vw, 4rem);"
        data-reveal
        data-reveal-delay="0.08"
        en="The B2B layer:<br/>account-based intelligence"
        it="Il layer B2B:<br/>account-based intelligence"
      />
      <T
        as="p"
        class="text-[clamp(1.05rem,1.4vw,1.3rem)] text-[var(--color-grigio-300)] max-w-2xl mb-8"
        data-reveal
        data-reveal-delay="0.15"
        en="The same AEP foundations, extended to corporate banking: account-orchestrated journeys, buying group analytics, demand generation automation."
        it="Le stesse fondamenta AEP, estese al corporate banking: journey orchestrati per account, analytics dei buying group, demand generation automation."
      />

      <!-- filo motif: lo stesso motore, esteso -->
      <div class="uc-thread w-full max-w-3xl mx-auto mb-6" data-reveal data-reveal-delay="0.18" aria-hidden="true">
        <span class="uc-node"></span>
        <span class="uc-thread-line"></span>
        <span class="uc-node"></span>
        <span class="uc-thread-line"></span>
        <span class="uc-node"></span>
      </div>

      <div
        class="w-full max-w-4xl mx-auto grid md:grid-cols-3 gap-4"
        data-reveal
        data-reveal-delay="0.22"
      >
        {b2bLayer.map((item) => (
          <div class="uc-panel uc-panel--oro motore-node motore-node--b2b" data-solution={item.sol ?? undefined}>
            <span class="motore-abbr motore-abbr--oro">{item.abbr}</span>
            <T as="p" class="motore-name" style="margin-top:0.7rem;" en={item.name.en} it={item.name.it} />
            <T as="p" class="uc-panel-body" style="font-size:0.9rem; margin-bottom:0; margin-top:0.4rem;" en={item.claim.en} it={item.claim.it} />
          </div>
        ))}
      </div>
    </Slide>

    <!-- ── SLIDE 6: Vantaggio integrazione ────────────────────────── -->
    <Slide id="slide-integration" bg="brand" align="center">
      <SlideBackdrop
        slot="backdrop"
        {...mediaProps('bg-digital-blue')}
