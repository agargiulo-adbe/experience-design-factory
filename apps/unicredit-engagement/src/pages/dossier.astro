---
import BaseLayout from '../layouts/BaseLayout.astro';
import DossierPage from '@edf/core/blocks/doc/DossierPage.astro';

// ── Pagina RISERVATA (Adobe internal) ──────────────────────────────────────
// Orfana (fuori nav) + noindex. Il contenuto confidenziale NON è nel bundle
// statico: vive in Supabase (tabella restricted_docs, RLS) e si carica solo
// dopo login oppure via secret-link ?t=<uuid> (RPC get_shared_doc).
//
// Il rendering è del motore condiviso `@edf/core/blocks/doc/DossierPage.astro`.
// Qui restano lo slug, il guscio dell'app e la mappatura della palette sul
// contratto `--dw-*`. Migliorare il motore migliora tutti i dossier.
const base = import.meta.env.BASE_URL;
---
<BaseLayout
  title="Dossier Attribution — UniCredit"
  description="Adobe internal — dossier riservato (accesso ristretto)."
  noindex={true}
>
  <DossierPage
    docSlug="unicredit-attribution"
    title="Dossier Attribution — UniCredit"
    base={base}
    supabaseUrl={import.meta.env.PUBLIC_SUPABASE_URL ?? ''}
    supabaseAnon={import.meta.env.PUBLIC_SUPABASE_ANON_KEY ?? ''}
    deckHref={base}
    deckLabel="Deck →"
  />

  <style is:global>
    /* Palette UniCredit: il petrolio #007A91 è il colore di SISTEMA, il rosso
         #E2001A è il marchio (vedi global.css). Sul petrolio notte #04252D il
         ciano #00AED0 fa l'inchiostro di accento (7,3:1), il rosso resta alle
         avvertenze — dove segnala davvero qualcosa. */
    :root {
      --dw-bg: var(--color-petrolio-notte);
      --dw-tint: rgba(0, 174, 208, 0.14);
      --dw-surface: rgba(255, 255, 255, 0.05);
      --dw-surface-2: rgba(0, 174, 208, 0.14);
      --dw-line: rgba(255, 255, 255, 0.16);
      --dw-ink: #DCE7EA;
      --dw-ink-soft: #AFC3C8;
      --dw-ink-faint: #8AA2A8;
      --dw-ink-strong: #ffffff;
      --dw-accent: var(--color-ciano);
      --dw-fill: var(--color-petrolio);
      --dw-on-fill: #FFFFFF;
      --dw-warn: var(--color-rosso);
      --dw-on-warn: #FFFFFF;
      --dw-alt: #7FD4E4;
      --dw-font-display: var(--font-display);
      --dw-font-body: var(--font-body);
    }
  </style>
</BaseLayout>
