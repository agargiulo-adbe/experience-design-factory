---
import BaseLayout from '../layouts/BaseLayout.astro';
import UniNavigation from '../components/UniNavigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import SlideBackdrop from '@edf/core/blocks/SlideBackdrop.astro';
import { href } from '@edf/core/utils/url.js';
import { mediaProps } from '../../assets.index';
import { SOURCES } from '../data/sources';
import T from '@edf/core/blocks/i18n/T.astro';
import UcCover from '../components/UcCover.astro';

const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;

const friction = [
  {
    label: { it: 'Segnale', en: 'Signal' },
    body: {
      it: 'Un insight resta un report finché qualcuno non lo traduce in lavoro.',
      en: 'An insight stays a report until someone turns it into work.',
    },
  },
  {
    label: { it: 'Handoff', en: 'Handoff' },
    body: {
      it: 'Dati, decisioni, contenuti e workflow passano tra strumenti e team.',
      en: 'Data, decisions, content and workflows move between tools and teams.',
    },
  },
  {
    label: { it: 'Attivazione', en: 'Activation' },
    body: {
      it: 'Ogni passaggio richiede owner, permessi e verifiche esplicite.',
      en: 'Every handoff needs a clear owner, permissions and checks.',
    },
  },
];

const stack = [
  { name: 'CJA / Content Analytics', role: { it: 'legge percorso e contenuti', en: 'reads journeys and content' } },
  { name: 'Coworker Chat', role: { it: 'skill, connettori MCP, memoria', en: 'skills, MCP connectors, memory' } },
  { name: { it: 'Revisione umana', en: 'Human review' }, role: { it: 'plan mode e approvazione', en: 'plan mode and approval' } },
  { name: 'AJO / AEM / Target', role: { it: 'eseguono con permessi ereditati', en: 'execute under inherited permissions' } },
  { name: 'CJA / Analytics', role: { it: 'misura l’esito, audit trail', en: 'measures the outcome, audit trail' } },
];

// Skill documentate su Experience League (set 2026) che contano per il caso UniCredit.
const skillFamilies = [
  {
    app: 'Customer Journey Analytics',
    status: { it: 'disponibile', en: 'available' },
    items: [
      { it: 'Interroga la data view: metriche, confronti, funnel, forecast', en: 'Query the data view: metrics, comparisons, funnels, forecasts' },
      { it: 'Root cause: perché una metrica è cambiata', en: 'Root cause: why a metric changed' },
      { it: 'Executive summary pronta per gli stakeholder', en: 'Stakeholder-ready executive summaries' },
      { it: '«Analyze in CJA» apre il grafico in Analysis Workspace', en: '“Analyze in CJA” opens the chart in Analysis Workspace' },
    ],
  },
  {
    app: 'Journey Optimizer',
    status: { it: 'disponibile', en: 'available' },
    items: [
      { it: 'Journey Create: un journey da una richiesta in linguaggio naturale', en: 'Journey Create: a journey from a natural-language request' },
      { it: 'Journey Analyze: fallout, sovrapposizioni di pubblico e di calendario, anomalie', en: 'Journey Analyze: fallout, audience and schedule overlap, anomalies' },
      { it: 'Journey Simulation: verifica la logica prima di attivare', en: 'Journey Simulation: check the logic before activating' },
      { it: 'Channel Content Create: in disponibilità limitata', en: 'Channel Content Create: limited availability' },
    ],
  },
  {
    app: 'Real-Time CDP',
    status: { it: 'disponibile', en: 'available' },
    items: [
      { it: 'Audience da una descrizione, con stima della dimensione', en: 'Audiences from a description, with size estimate' },
      { it: 'Esplora audience e campi disponibili', en: 'Explore available audiences and fields' },
    ],
  },
  {
    app: 'AEM Sites',
    status: { it: 'in rollout', en: 'rolling out' },
    items: [
      { it: 'Aggiorna una pagina o cento pagine insieme', en: 'Update one page or a hundred at once' },
      { it: 'Controlla un contenuto sulle linee guida di brand', en: 'Check content against brand guidelines' },
    ],
  },
  {
    app: { it: 'Skill della banca', en: 'The bank’s own skills' },
    status: { it: 'in Markdown', en: 'in Markdown' },
    items: [
      { it: 'Un playbook riusabile, scritto dal team: quali dati, quali controlli, quale tono', en: 'A reusable playbook the team writes: which data, which checks, which tone' },
      { it: 'Gira sotto gli stessi permessi dell’app collegata', en: 'Runs under the same permissions as the connected app' },
    ],
  },
];

// Disponibilità pubblica al 24–28 settembre 2026 (Experience League + Adobe News).
const availability = {
  now: [
    { it: 'Coworker Chat in general availability dal 10 giugno 2026', en: 'Coworker Chat generally available since 10 June 2026' },
    { it: 'Esperienza immersiva per RTCDP, Journey Optimizer, CJA, AEM, Target, Marketo Engage, Workfront', en: 'Immersive experience for RTCDP, Journey Optimizer, CJA, AEM, Target, Marketo Engage, Workfront' },
    { it: 'Target anche dentro l’app', en: 'Target also inside the app' },
    { it: 'Coworker Gateway: un endpoint MCP per Claude, ChatGPT, Cursor', en: 'Coworker Gateway: one MCP endpoint for Claude, ChatGPT, Cursor' },
    { it: 'Adobe Marketing Agent per Microsoft 365 Copilot', en: 'Adobe Marketing Agent for Microsoft 365 Copilot' },
  ],
  announced: [
    { it: 'Coworker Projects: workspace con checkpoint di approvazione', en: 'Coworker Projects: a workspace with approval checkpoints' },
    { it: 'Coworker dentro RTCDP, Journey Optimizer, CJA, AEM, Marketo', en: 'Coworker inside RTCDP, Journey Optimizer, CJA, AEM, Marketo' },
    { it: 'Capacità agentiche AEM in rollout progressivo', en: 'AEM agentic capabilities rolling out progressively' },
    { it: 'Edizioni B2B di RTCDP, Journey Optimizer, CJA', en: 'B2B editions of RTCDP, Journey Optimizer, CJA' },
  ],
  watch: [
    { it: 'Workfront: Coworker non è oggi disponibile alle organizzazioni finance; resta AI Assistant', en: 'Workfront: Coworker is not yet available to finance organizations; AI Assistant remains' },
    { it: 'Coworker Campaigns: per piccoli team agili, oggi solo Nord America. Fuori da questo concept', en: 'Coworker Campaigns: for small agile teams, North America only today. Outside this concept' },
    { it: 'Lingua di risposta: la documentazione indica l’inglese; l’italiano va verificato in pilota', en: 'Response language: the documentation says English; Italian must be tested in the pilot' },
  ],
};

const interactionModes = [
  {
    name: { it: 'Coworker Chat', en: 'Coworker Chat' },
    kind: { it: 'Disponibile · GA 10 giugno 2026', en: 'Available · GA 10 June 2026' },
    steps: [
      { it: 'Plan mode: propone i passi e aspetta l’approvazione', en: 'Plan mode: proposes the steps and waits for approval' },
      { it: 'Skill in Markdown, connettori MCP, memoria per data view e preferenze', en: 'Skills in Markdown, MCP connectors, memory for data views and preferences' },
      { it: 'Mostra il lavoro: skill caricate, query eseguite, artefatti', en: 'Shows its work: loaded skills, queries run, artifacts' },
    ],
    outcome: { it: 'Un artefatto da verificare, poi «Analyze in CJA»', en: 'An artifact to verify, then “Analyze in CJA”' },
  },
  {
    name: { it: 'Coworker Projects', en: 'Coworker Projects' },
    kind: { it: 'Annunciato · «coming soon»', en: 'Announced · “coming soon”' },
    steps: [
      { it: 'Un workspace per un obiettivo che attraversa più team', en: 'One workspace for a goal that spans several teams' },
      { it: 'Checkpoint di approvazione e grado di autonomia per fase', en: 'Approval checkpoints and an autonomy level per stage' },
      { it: 'Revisione e approvazione dentro il progetto', en: 'Review and approval inside the project' },
    ],
    outcome: { it: 'Da valutare quando sarà disponibile', en: 'To assess once available' },
  },
];

const executionSteps = [
  {
    number: '01',
    label: { it: 'Insight', en: 'Insight' },
    body: { it: 'La skill CJA legge la data view; il segnale non è una decisione sul cliente.', en: 'The CJA skill reads the data view; the signal is not a customer decision.' },
  },
  {
    number: '02',
    label: { it: 'Bozza', en: 'Draft' },
    body: { it: 'Coworker restituisce un artefatto: sintesi, prossimi passi, fonti usate.', en: 'Coworker returns an artifact: summary, next steps, sources used.' },
  },
  {
    number: '03',
    label: { it: 'Revisione', en: 'Review' },
    body: { it: 'Plan mode e approval gate: un owner modifica, approva o ferma.', en: 'Plan mode and approval gate: an owner edits, approves or stops.' },
  },
  {
    number: '04',
    label: { it: 'Esecuzione', en: 'Execution' },
    body: { it: 'Journey Optimizer, AEM o Target via connettori MCP, con i permessi di chi chiede.', en: 'Journey Optimizer, AEM or Target via MCP connectors, under the requester’s permissions.' },
  },
  {
    number: '05',
    label: { it: 'Misura', en: 'Measurement' },
    body: { it: 'L’esito torna in CJA; l’audit trail dice chi ha approvato cosa.', en: 'The outcome returns to CJA; the audit trail says who approved what.' },
  },
];

const governanceChecks = [
  {
    title: { it: 'Permessi ereditati', en: 'Inherited permissions' },
    body: { it: 'Coworker vede solo le data view, i journey e le pagine che l’utente può già vedere nell’app. Niente accessi nuovi da inventare.', en: 'Coworker sees only the data views, journeys and pages the user can already see in the app. No new access to invent.' },
  },
  {
    title: { it: 'Approvazione prima dell’azione', en: 'Approval before action' },
    body: { it: 'Plan mode, approval gate e controlli che girano prima di ogni azione. Un owner decide; la memoria è scoperta a livello di organizzazione e di persona.', en: 'Plan mode, approval gates and checks that run before any action. An owner decides; memory is scoped at organization and personal level.' },
  },
  {
    title: { it: 'Tracciabilità', en: 'Traceability' },
    body: { it: 'Audit trail completo, transcript di ogni passaggio, dashboard di monitoraggio e crediti AI. Il team di governance vede adozione e feedback.', en: 'Full audit trail, a transcript of every step, monitoring dashboards and AI credits. The governance team sees adoption and feedback.' },
  },
];

const outcomeMeasures = [
  { it: 'Tempo dall’insight alla revisione', en: 'Time from insight to review' },
  { it: 'Tempo di approvazione', en: 'Time to approval' },
  { it: 'Handoff completati senza rilavorazione', en: 'Handoffs completed without rework' },
  { it: 'Esito misurato in analytics', en: 'Outcome measured in analytics' },
];

// Pratiche che la documentazione Adobe raccomanda per partire (analytics-chat, set 2026).
const pilotPractices = [
  { it: 'Un analista come «Coworker champion»', en: 'One analyst as the “Coworker champion”' },
  { it: 'Una libreria di prompt e skill verificati', en: 'A library of vetted prompts and skills' },
  { it: 'Plan mode acceso sui task che toccano i dati', en: 'Plan mode on for tasks that touch data' },
  { it: 'Una baseline prima di fissare obiettivi', en: 'A baseline before setting targets' },
];

const references = [
  SOURCES.adobe_cx_coworker_ga,
  SOURCES.adobe_cx_coworker_blog,
  SOURCES.el_coworker_chat,
  SOURCES.el_coworker_cja,
  SOURCES.el_coworker_ajo,
  SOURCES.el_coworker_aem,
  SOURCES.el_coworker_gateway,
];
---
<BaseLayout
  title="Coworker — dall’insight all’azione"
  description="Un modello illustrativo per collegare insight, lavoro coordinato e attivazione governata con Adobe CX Enterprise Coworker."
>
  <div class="fixed top-0 left-0 right-0 z-50">
    <UniNavigation currentPath={currentPath} base={base} />
  </div>

  <DeckContainer nextHref={href(base, '/risultati')} prevHref={href(base, '/analizza')}>
    <Slide id="slide-cover" bg="inverse" align="center">
      <SlideBackdrop
        slot="backdrop"
        {...mediaProps('bg-data-dark')}
        imageClass="opacity-30"
        scrim="bg-[var(--surface-inverse)]/78"
      />
      <UcCover
        slug="coworker"
        title={{ en: 'From insight to governed action', it: 'Dall’insight all’azione governata' }}
        lead={{
          en: 'Adobe CX Enterprise Coworker takes a team from an analytics signal to a reviewed next step: skills, plan mode and inherited permissions. Systems, approvals and people stay part of the decision.',
          it: 'Adobe CX Enterprise Coworker porta il team da un segnale analytics a un prossimo passo verificato: skill, plan mode, permessi ereditati. Sistemi, approvazioni e persone restano parte della decisione.',
        }}
        chips={[
          { en: 'Insight to action', it: 'Dall’insight all’azione' },
          { en: 'Documented skills', it: 'Skill documentate' },
          { en: 'Available today vs announced', it: 'Oggi e annunciato' },
        ]}
      />
    </Slide>

    <Slide id="slide-problem" bg="primary" align="center">
      <div class="uc-bg absolute inset-0 -z-10" slot="backdrop" aria-hidden="true"></div>
      <T as="p" class="uc-cw-preface" en="An accurate insight can still go nowhere. The handoff to someone who can act is often the missing step." it="Anche un insight corretto può restare fermo. Spesso manca il passaggio a chi può agire." />
      <T as="p" class="slide-eyebrow text-center text-[var(--ink-brand-text)] mb-4" en="WHERE WORK GETS STUCK" it="DOVE IL LAVORO SI FERMA" />
      <T
        as="h2"
        class="slide-title text-[var(--ink-primary)] mb-7"
        style="font-size: clamp(2rem, 3.5vw, 3.25rem);"
        en="The signal is only the start"
        it="Il segnale è solo l’inizio"
      />
      <div class="w-full max-w-6xl mx-auto grid md:grid-cols-3 gap-5 text-left">
        {friction.map((item, index) => (
          <div class:list={['uc-panel', index === 1 ? 'uc-panel--oro' : 'uc-panel--rosso']}>
            <T as="p" class="uc-tag mb-3" en={item.label.en} it={item.label.it} />
            <T as="p" class="uc-panel-body" style="margin-bottom: 0;" en={item.body.en} it={item.body.it} />
          </div>
        ))}
      </div>
      <T
        as="p"
        class="mt-7 text-center text-[var(--ink-secondary)] text-base leading-relaxed max-w-3xl"
        en="The opportunity is to connect the steps, not to remove the checks."
        it="L’opportunità è collegare i passaggi, non eliminare le verifiche."
      />
    </Slide>

    <Slide id="slide-stack" bg="inverse" align="center">
      <T as="p" class="uc-cw-preface uc-cw-preface--dark" en="The tools may already exist. The operating model connects the work, subject to access and configuration." it="Gli strumenti possono già esserci. Il modello operativo collega il lavoro, nel rispetto di accessi e configurazione." />
      <T as="p" class="slide-eyebrow text-center text-[var(--color-grigio-300)] mb-4" en="ONE OPERATING MODEL" it="UN MODELLO OPERATIVO" />
      <T
        as="h2"
        class="slide-title text-[var(--ink-inverse)] mb-7"
        style="font-size: clamp(2rem, 3.5vw, 3.25rem);"
        en="Coworker connects the work around the stack"
        it="Coworker collega il lavoro attorno allo stack"
      />
      <div class="w-full max-w-6xl mx-auto grid md:grid-cols-5 gap-3 text-left">
        {stack.map((item, index) => (
          <div class:list={['uc-cw-stack-step', index === 1 ? 'uc-cw-stack-step--focus' : '']}>
            <span class="uc-cw-stack-index">{String(index + 1).padStart(2, '0')}</span>
            {typeof item.name === 'string'
              ? <p class="uc-cw-stack-name">{item.name}</p>
              : <T as="p" class="uc-cw-stack-name" en={item.name.en} it={item.name.it} />}
            <T as="p" class="uc-cw-stack-role" en={item.role.en} it={item.role.it} />
          </div>
        ))}
      </div>
      <T
        as="p"
        class="uc-cw-caveat mt-6 max-w-4xl mx-auto"
        en="Illustrative architecture, not a statement of UniCredit’s installed products. Workfront is left out on purpose: Adobe’s documentation says Coworker there is not yet available to finance organizations."
        it="Architettura illustrativa, non descrive i prodotti installati in UniCredit. Workfront è fuori di proposito: la documentazione Adobe dice che lì Coworker non è ancora disponibile alle organizzazioni finance."
      />
      <nav class="uc-cw-sources mt-4" aria-label="Product references">
        <span><T en="Product references" it="Riferimenti prodotto" />:</span>
        {references.map((reference) => (
          <a href={reference.url} target="_blank" rel="noreferrer">{reference.label}</a>
        ))}
      </nav>
    </Slide>

    <Slide id="slide-chat-project" bg="secondary" align="center">
      <div class="uc-bg-soft absolute inset-0 -z-10" slot="backdrop" aria-hidden="true"></div>
      <T as="p" class="uc-cw-preface" en="A single request and a cross-team goal are different jobs. Today one module is available and one is announced: the deck says which is which." it="Una richiesta singola e un obiettivo che attraversa più team sono lavori diversi. Oggi un modulo è disponibile e uno è annunciato: il deck dice quale." />
      <T as="p" class="slide-eyebrow text-center text-[var(--ink-brand-text)] mb-4" en="TWO SCALES OF WORK" it="DUE SCALE DI LAVORO" />
      <T
        as="h2"
        class="slide-title text-[var(--ink-primary)] mb-7"
        style="font-size: clamp(2rem, 3.5vw, 3.25rem);"
        en="A question is not a project"
        it="Una domanda non è un progetto"
      />
      <div class="w-full max-w-5xl mx-auto grid md:grid-cols-2 gap-5 text-left">
        {interactionModes.map((mode, index) => (
          <section class:list={['uc-panel uc-cw-mode', index === 1 ? 'uc-panel--oro' : 'uc-panel--rosso']}>
            <div class="uc-panel-head">
              <T as="p" class="uc-card-title" en={mode.name.en} it={mode.name.it} />
              <T as="span" class="uc-tag" en={mode.kind.en} it={mode.kind.it} />
            </div>
            <ol class="uc-cw-mode-list">
              {mode.steps.map((step) => <T as="li" en={step.en} it={step.it} />)}
            </ol>
            <div class="uc-cw-mode-outcome">
              <T as="span" class="uc-tag" en="Outcome" it="Esito" />
              <T as="span" en={mode.outcome.en} it={mode.outcome.it} />
            </div>
          </section>
        ))}
      </div>
      <T
        as="p"
        class="uc-cw-caveat mt-5 max-w-4xl mx-auto text-center"
        en="Status as published by Adobe (Adobe News, 10 June 2026; Experience League, September 2026). Licences and enablement for UniCredit’s tenant are a separate check."
        it="Stato come pubblicato da Adobe (Adobe News, 10 giugno 2026; Experience League, settembre 2026). Licenze e abilitazione sul tenant UniCredit sono una verifica a parte."
      />
    </Slide>


    <Slide id="slide-skills" bg="primary" align="center">
      <div class="uc-bg absolute inset-0 -z-10" slot="backdrop" aria-hidden="true"></div>
      <T as="p" class="uc-cw-preface uc-cw-preface--dense" en="A skill is a playbook in Markdown that Coworker loads when the task calls for it. Adobe ships the common ones; the bank can write its own." it="Una skill è un playbook in Markdown che Coworker carica quando il compito lo richiede. Adobe fornisce quelle comuni; la banca può scrivere le sue." />
      <T as="p" class="slide-eyebrow text-center text-[var(--ink-brand-text)] mb-4" en="THE SKILLS THAT MATTER HERE" it="LE SKILL CHE CONTANO QUI" />
      <T
        as="h2"
        class="slide-title text-[var(--ink-primary)] mb-6"
        style="font-size: clamp(2rem, 3.5vw, 3.25rem);"
        en="What Coworker already knows how to do"
        it="Cosa Coworker sa già fare"
      />
      <div class="uc-cw-skills">
        {skillFamilies.map((family, index) => (
          <section class:list={['uc-cw-skill', index === 4 ? 'uc-cw-skill--bank' : '']}>
            <header class="uc-cw-skill-head">
              {typeof family.app === 'string'
                ? <p class="uc-cw-skill-app">{family.app}</p>
                : <T as="p" class="uc-cw-skill-app" en={family.app.en} it={family.app.it} />}
              <T as="span" class="uc-cw-skill-status" en={family.status.en} it={family.status.it} />
            </header>
            <ul class="uc-cw-skill-list">
              {family.items.map((item) => <T as="li" en={item.en} it={item.it} />)}
            </ul>
          </section>
        ))}
      </div>
      <T
        as="p"
        class="uc-cw-caveat uc-cw-caveat--dense mt-5 max-w-4xl mx-auto text-center"
        en="Skills as documented on Experience League, 24–28 September 2026. Each needs its licence and the user’s permissions in that app."
        it="Skill come documentate su Experience League, 24–28 settembre 2026. Ognuna richiede licenza e permessi dell’utente in quell’app."
      />
    </Slide>

    <Slide id="slide-availability" bg="secondary" align="center">
      <div class="uc-bg-soft absolute inset-0 -z-10" slot="backdrop" aria-hidden="true"></div>
      <T as="p" class="uc-cw-preface uc-cw-preface--dense" en="What a bank can plan on today, what Adobe has announced, and two things to watch before a pilot." it="Su cosa una banca può contare oggi, cosa Adobe ha annunciato, e due cose da guardare prima di un pilota." />
      <T as="p" class="slide-eyebrow text-center text-[var(--ink-brand-text)] mb-4" en="TODAY AND ANNOUNCED" it="OGGI E ANNUNCIATO" />
      <T
        as="h2"
        class="slide-title text-[var(--ink-primary)] mb-6"
        style="font-size: clamp(2rem, 3.5vw, 3.25rem);"
        en="Where Coworker reaches, as of September 2026"
        it="Dove arriva Coworker, a settembre 2026"
      />
      <div class="uc-cw-avail">
        <section class="uc-panel uc-panel--oro uc-cw-avail-col">
          <T as="p" class="uc-tag" en="Available today" it="Disponibile oggi" />
          <ul class="uc-cw-avail-list">
            {availability.now.map((item) => <T as="li" en={item.en} it={item.it} />)}
          </ul>
        </section>
        <section class="uc-panel uc-cw-avail-col">
          <T as="p" class="uc-tag" en="Announced by Adobe" it="Annunciato da Adobe" />
          <ul class="uc-cw-avail-list">
            {availability.announced.map((item) => <T as="li" en={item.en} it={item.it} />)}
          </ul>
        </section>
        <section class="uc-panel uc-panel--rosso uc-cw-avail-col">
          <T as="p" class="uc-tag" en="Watch before a pilot" it="Da guardare prima del pilota" />
          <ul class="uc-cw-avail-list">
            {availability.watch.map((item) => <T as="li" en={item.en} it={item.it} />)}
          </ul>
        </section>
      </div>
      <T
        as="p"
        class="uc-cw-caveat uc-cw-caveat--dense mt-5 max-w-4xl mx-auto text-center"
        en="Sources: Adobe News (10 June 2026), Coworker Chat UI guide and Workfront guide on Experience League (September 2026). Announced items carry no date and no commitment."
        it="Fonti: Adobe News (10 giugno 2026), guida UI di Coworker Chat e guida Workfront su Experience League (settembre 2026). Gli annunci non hanno data né impegno."
      />
    </Slide>

    <Slide id="slide-marco-brief" bg="primary" align="center">
      <div class="uc-bg absolute inset-0 -z-10" slot="backdrop" aria-hidden="true"></div>
      <T as="p" class="uc-cw-preface" en="A skill the bank writes, run in Coworker Chat with plan mode on: it prepares a handoff from authorized journey evidence. It does not decide for the customer." it="Una skill scritta dalla banca, eseguita in Coworker Chat con il plan mode attivo: prepara un handoff dalle evidenze autorizzate del journey. Non decide per il cliente." />
