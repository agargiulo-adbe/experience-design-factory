---
import BaseLayout from '../layouts/BaseLayout.astro';
import UniNavigation from '../components/UniNavigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import SlideBackdrop from '@edf/core/blocks/SlideBackdrop.astro';
import { href } from '@edf/core/utils/url.js';
import { mediaProps } from '../../assets.index';
import MediaSlot from '@edf/core/blocks/MediaSlot.astro';
import T from '@edf/core/blocks/i18n/T.astro';
import UcCover from '../components/UcCover.astro';

const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;

const macroTrends = [
  {
    trend: { en: 'AI Search', it: 'AI Search' },
    desc: {
      en: 'Search is moving from engines to AI assistants: Gartner expects −25% of traditional engine volume by 2026. If ChatGPT, Gemini or Perplexity skip you, the customer never sees you.',
      it: 'Le ricerche passano dai motori agli assistenti AI: Gartner stima −25% di volume sui motori tradizionali entro il 2026. Se ChatGPT, Gemini o Perplexity non ti citano, per il cliente non ci sei.',
    },
  },
  {
    trend: { en: 'Hyper-personalisation', it: 'Hyper-personalizzazione' },
    desc: {
      en: 'FinTechs tailor experiences with very little data. Banks sit on endless data but struggle to put it to work in real time.',
      it: 'Le FinTech offrono esperienze su misura con pochi dati. Le banche hanno dati infiniti ma faticano a usarli in tempo reale.',
    },
  },
  {
    trend: { en: 'Zero-latency intelligence', it: 'Zero-latency intelligence' },
    desc: {
      en: 'You cannot stop churn by looking backwards: it takes early signals and automatic action in minutes, not days.',
      it: 'Il churn non si previene guardando indietro: servono segnali precoci e azioni automatiche in pochi minuti, non in giorni.',
    },
  },
];

const gaps = [
  {
    problem: { en: 'Fragmented data', it: 'Dati frammentati' },
    desc: {
      en: 'Millions of customers, data scattered across systems that barely talk. The profile joining app, branch and call centre often stays half-built.',
      it: 'Milioni di clienti e dati sparsi tra sistemi che si parlano poco. Il profilo che mette insieme app, filiale e call center spesso resta parziale.',
    },
  },
  {
    problem: { en: 'Generic interactions', it: 'Interazioni generiche' },
    desc: {
      en: "The app answers the transaction, but has no idea where the customer stands: a child on the way, a house to buy, retirement drawing near.",
      it: "L'app risponde alla transazione, ma non sa a che punto è il cliente: un figlio che nasce, una casa da comprare, la pensione che si avvicina.",
    },
  },
  {
    problem: { en: 'Silent intelligence', it: 'Intelligence silenziosa' },
    desc: {
      en: 'The data is there, but turning it into decisions takes days, not minutes. And churn signals surface only once it is too late.',
      it: 'I dati ci sono, ma trasformarli in decisioni richiede giorni, non minuti. E i segnali di churn si notano solo quando è tardi.',
    },
  },
  {
    problem: { en: 'Slow content', it: 'Contenuti lenti' },
    desc: {
      en: "Campaigns land three weeks after the event that sparked them, when the moment has already gone.",
      it: "Le campagne arrivano tre settimane dopo l'evento che le ha ispirate, quando il momento è ormai passato.",
    },
  },
];

// La storia di Marco — sei momenti, uno per motore/capitolo, raccontati una slide ciascuno.
const marcoMoments = [
  { n: '01', of: '06', where: { en: 'The Site', it: 'Il Sito' }, short: { en: 'The Site', it: 'Il Sito' }, href: '/visibilita', bg: 'ff-story-01', mock: 'chat',
    title: { en: '9:40 PM. Marco asks ChatGPT.', it: 'Ore 21:40. Marco chiede a ChatGPT.' },
    body: { en: '"Best bank for a first-home mortgage." UniCredit is the first answer, and not by luck: its content is readable and quotable by AI assistants. He taps, and the page opens in 0.3 seconds while the other two banks are still loading.', it: '«Miglior banca per il mutuo della prima casa.» UniCredit è la prima risposta, e non per fortuna: i contenuti sono leggibili e citabili dagli assistenti AI. Tocca il link, e la pagina si apre in 0,3 secondi mentre le altre due banche stanno ancora caricando.' } },
  { n: '02', of: '06', where: { en: 'Content · GenStudio', it: 'Contenuti · GenStudio' }, short: { en: 'GenStudio', it: 'GenStudio' }, href: '/contenuti', bg: 'ff-story-genstudio', mock: 'genstudio',
    title: { en: 'Next morning, at the café: the campaign speaks his language.', it: 'Il mattino dopo, al bar: la campagna parla la sua lingua.' },
    body: { en: 'Between a coffee and the tram, a UniCredit reel ad shows up in his feed: "A mortgage that grows with your family". Not a campaign for everyone: it is the variant for families aged 35 to 45 that GenStudio wrote in minutes from one brief, on-brand, with eleven sibling versions for the other segments.', it: 'Tra un caffè e il tram, nel feed compare un reel ads UniCredit: «Il mutuo che cresce con la tua famiglia». Non è una campagna per tutti: è la variante per famiglie 35–45 che GenStudio ha scritto in minuti da un unico brief, on-brand, con undici versioni gemelle per gli altri segmenti.' } },
  { n: '03', of: '06', where: { en: 'Content · Brand Concierge', it: 'Contenuti · Brand Concierge' }, short: { en: 'Concierge', it: 'Concierge' }, href: '/contenuti', bg: 'ff-story-02', mock: 'concierge',
    title: { en: 'One question, one real answer.', it: 'Una domanda, una risposta vera.' },
    body: { en: 'He taps the ad, lands on the mortgage page and has a doubt. He types it to the Brand Concierge: "How much can I afford?" A few exchanges later he has a simulation, a monthly payment and a next step: answers grounded in approved UniCredit content, not in an FAQ.', it: 'Tocca il reel, atterra sulla pagina del mutuo e ha un dubbio. Lo scrive al Brand Concierge: «Quanto posso permettermi?». In pochi scambi ha simulazione, rata e prossimo passo: risposte ancorate ai contenuti approvati UniCredit, non a una FAQ.' } },
  { n: '04', of: '06', where: { en: 'Analyze', it: 'Analizza' }, short: { en: 'Analyze', it: 'Analizza' }, href: '/analizza', bg: 'ff-story-03', mock: 'cja',
    title: { en: 'Behind the scenes, UniCredit sees the whole path.', it: 'Dietro le quinte, UniCredit vede tutto il percorso.' },
    body: { en: 'Every step lands in the same journey: the AI answer, the ad, the site, the concierge, the app. When Marco leaves the mortgage email unopened, the Data Insights Agent flags him and suggests an SMS for Wednesday. And the credit for this sale will not stay with one channel.', it: 'Ogni passaggio finisce nello stesso percorso: la risposta AI, il reel, il sito, il concierge, l\'app. Quando Marco non apre l\'email del mutuo, il Data Insights Agent lo segnala e propone un SMS per mercoledì. E il merito di questa vendita non resterà a un solo canale.' } },
  { n: '05', of: '06', where: { en: 'Coworker', it: 'Coworker' }, short: { en: 'Coworker', it: 'Coworker' }, href: '/coworker', bg: 'ff-story-04', mock: 'coworker',
    title: { en: '2 PM. The advisor already knows everything.', it: 'Ore 14. Il consulente sa già tutto.' },
    body: { en: 'Coworker prepared the brief for the appointment: profile, propensity, the interactions of the week, an offer already shaped for him. The advisor walks in to talk with Marco, not to hunt for his data.', it: 'Il brief per l\'appuntamento l\'ha preparato Coworker: profilo, propensione, le interazioni della settimana, una proposta già su misura. Il consulente entra in stanza per parlare con Marco, non per cercare i suoi dati.' } },
  { n: '06', of: '06', where: { en: 'Results', it: 'Risultati' }, short: { en: 'Results', it: 'Risultati' }, href: '/risultati', bg: 'ff-story-05', mock: 'signed',
    title: { en: 'The keys. And a relationship that goes on.', it: 'Le chiavi. E una relazione che continua.' },
    body: { en: 'A mortgage signed with no queues, a fully digital application, one profile that app, branch and call centre read the same way. Next year the home insurance, then the salary account: the right offer at the right moment, not spam.', it: 'Mutuo firmato senza code, richiesta interamente digitale, un profilo unico che app, filiale e call center leggono allo stesso modo. Tra un anno la polizza casa, poi il conto stipendio: l\'offerta giusta al momento giusto, non spam.' } },
];

const engines = [
  { n: '01', who: 'marco', name: { en: 'Content management', it: 'Gestione contenuti' }, tools: 'AEM Sites · Edge Delivery · AEM Agents', where: { en: 'The Site', it: 'Il Sito' } },
  { n: '02', who: 'marco', name: { en: 'Content optimization', it: 'Ottimizzazione contenuti' }, tools: 'Adobe Brand Visibility · Sites Optimizer', where: { en: 'The Site', it: 'Il Sito' } },
  { n: '03', who: 'marco', name: { en: 'Brand Concierge', it: 'Brand Concierge' }, tools: { en: 'Conversational experience, grounded', it: 'Esperienza conversazionale, grounded' }, where: { en: 'Content', it: 'Contenuti' } },
  { n: '04', who: 'marco', name: { en: 'Performance marketing', it: 'Performance marketing' }, tools: 'Adobe GenStudio', where: { en: 'Content', it: 'Contenuti' } },
  { n: '05', who: 'team', name: { en: 'Journey analytics', it: 'Journey analytics' }, tools: 'CJA · Marketing Campaign Analytics', where: { en: 'Analyze', it: 'Analizza' } },
  { n: '06', who: 'team', name: { en: 'Agentic workflows', it: 'Workflow agentici' }, tools: 'Adobe CX Enterprise Coworker', where: { en: 'Coworker', it: 'Coworker' } },
];
---
<BaseLayout
  title="Il cliente del futuro è già qui"
  description="Un cliente, una piattaforma e il motore che la fa funzionare: il viaggio che UniCredit può già offrire."
>
  <div class="fixed top-0 left-0 right-0 z-50">
    <UniNavigation currentPath={currentPath} base={base} />
  </div>

  <DeckContainer nextHref={href(base, '/visibilita')} prevHref={href(base, '/')}>

    <!-- ── SLIDE 0: Cover ─────────────────────────────────────────── -->
    <Slide id="slide-cover" bg="inverse" align="center">
      <SlideBackdrop
        slot="backdrop"
        {...mediaProps('ff-scenario-cover')}
        imageClass="opacity-45"
        scrim="bg-[var(--surface-inverse)]/72"
      />
      <UcCover
        slug="scenario"
        title={{ en: 'The customer of the future is already here', it: 'Il cliente del futuro è già qui' }}
        lead={{ en: 'One customer, one platform, and the engine that makes it run: the journey UniCredit can already give.', it: 'Un cliente, una piattaforma e il motore che la fa funzionare: il viaggio che UniCredit può già offrire.' }}
        chips={[{ en: 'The context', it: 'Il contesto' }, { en: "Today's gap", it: 'Il gap attuale' }, { en: "Marco's story in six moments", it: 'La storia di Marco in sei momenti' }, { en: 'The six engines', it: 'I sei motori' }]}
      />
    </Slide>

    <!-- ── SLIDE 1: Macro trends ──────────────────────────────────── -->
    <Slide id="slide-trends" bg="primary" align="center">
      <div class="uc-bg absolute inset-0 -z-10" slot="backdrop" aria-hidden="true"></div>
      <SlideBackdrop
        slot="backdrop"
        {...mediaProps('bg-unlimited')}
        imageClass="opacity-15"
        scrim="bg-[var(--surface-primary)]/86"
      />
      <T as="p" class="slide-eyebrow text-center text-[var(--accent-primary)] mb-5" data-reveal en="THE CONTEXT" it="IL CONTESTO" />
      <T
        as="h2"
        class="slide-title text-[var(--ink-primary)] mb-8"
        style="font-size: clamp(2.25rem, 4.4vw, 4rem);"
        data-reveal
        data-reveal-delay="0.1"
        en="Banking is shifting. Again."
        it="Il banking sta cambiando. Di nuovo."
      />

      <!-- il filo: tre movimenti del mercato, cuciti dall'oro -->
      <div class="uc-thread w-full max-w-5xl mx-auto mb-6" data-reveal data-reveal-delay="0.16" aria-hidden="true">
        <span class="uc-node uc-node--rosso"></span>
        <span class="uc-thread-line"></span>
        <span class="uc-node"></span>
        <span class="uc-thread-line"></span>
        <span class="uc-node"></span>
      </div>

      <div class="w-full max-w-5xl mx-auto grid grid-cols-3 gap-6 text-left" data-reveal data-reveal-delay="0.2">
        {macroTrends.map((t, i) => (
          <div class="uc-card">
            <span class="uc-mark">{String(i + 1).padStart(2, "0")}</span>
            <T as="p" class="uc-card-title" en={t.trend.en} it={t.trend.it} />
            <T as="p" class="uc-card-body" en={t.desc.en} it={t.desc.it} />
          </div>
        ))}
      </div>
      <p class="uc-src mt-6 text-center">
        <T en="Source:" it="Fonte:" />
        <a href="https://www.gartner.com/en/newsroom/press-releases/2024-02-19-gartner-predicts-search-engine-volume-will-drop-25-percent-by-2026-due-to-ai-chatbots-and-other-virtual-agents" target="_blank" rel="noopener noreferrer" class="uc-src-link">Gartner, feb 2024</a>
        ·
        <a href="https://blog.adobe.com/en/publish/2025/03/17/adobe-analytics-traffic-to-us-retail-websites-from-generative-ai-sources-jumps-1200-percent" target="_blank" rel="noopener noreferrer" class="uc-src-link">Adobe Analytics, 2025</a>
      </p>
    </Slide>

    <!-- ── SLIDE 2: Il gap oggi ───────────────────────────────────── -->
    <Slide id="slide-gap" bg="secondary" align="center">
      <div class="uc-bg-soft absolute inset-0 -z-10" slot="backdrop" aria-hidden="true"></div>
      <T as="p" class="slide-eyebrow text-center text-[var(--accent-primary)] mb-5" data-reveal en="TODAY'S GAP" it="IL GAP ATTUALE" />
      <T
        as="h2"
        class="slide-title text-[var(--ink-primary)] mb-8"
        style="font-size: clamp(2.25rem, 4.4vw, 4rem);"
        data-reveal
        data-reveal-delay="0.1"
        en="Four problems that cost you the relationship every day"
        it="Quattro problemi che ogni giorno costano relazione"
      />
      <div class="w-full max-w-5xl mx-auto grid grid-cols-2 auto-rows-fr gap-5 text-left" data-reveal data-reveal-delay="0.2">
        {gaps.map((g, i) => (
          <div class="uc-card h-full">
            <span class="uc-mark">{String(i + 1).padStart(2, "0")}</span>
            <T as="p" class="uc-card-title" en={g.problem.en} it={g.problem.it} />
            <T as="p" class="uc-card-body" en={g.desc.en} it={g.desc.it} />
          </div>
        ))}
      </div>
      <T as="p" class="uc-src mt-6 text-center" data-reveal data-reveal-delay="0.28" en="Recurring retail banking challenges · illustrative scenario" it="Sfide ricorrenti del retail banking · scenario illustrativo" />
    </Slide>

    <!-- ── SLIDE 3: Marco Ferretti ────────────────────────────────── -->
    <Slide id="slide-marco" bg="primary" align="split">
      <div class="uc-bg absolute inset-0 -z-10" slot="backdrop" aria-hidden="true"></div>
      <SlideBackdrop
        slot="backdrop"
        {...mediaProps('banking-branch')}
        imageClass="opacity-12"
        scrim="bg-[var(--surface-primary)]/90"
      />
      <div class="w-full flex-1 min-h-0 grid md:grid-cols-2 gap-10 md:gap-16 items-center">
        <div>
          <div class="relative overflow-hidden rounded-sm" style="aspect-ratio:4/5; max-height:min(480px, 52vh);">
            <MediaSlot {...mediaProps('persona-marco')} fill objectPosition="top" />
          </div>
        </div>
        <div class="uc-panel uc-panel--rosso text-left">
          <div class="uc-panel-head">
            <T as="span" class="uc-tag" data-reveal en="Lead character 01" it="Protagonista 01" />
            <span class="uc-thread" aria-hidden="true" data-reveal data-reveal-delay="0.06">
              <span class="uc-node uc-node--rosso"></span>
              <span class="uc-node"></span>
            </span>
          </div>
          <h2
            class="text-[var(--ink-primary)] mb-1 font-[family-name:var(--font-display)]"
            style="font-size: clamp(1.8rem, 3vw, 3.25rem);"
            data-reveal
            data-reveal-delay="0.08"
          >Marco Ferretti</h2>
          <T as="p" class="uc-src mb-3" data-reveal data-reveal-delay="0.12" en="38 · UniCredit customer for 12 years · Brescia" it="38 anni · cliente UniCredit da 12 anni · Brescia" />
          <T as="p" class="uc-panel-body" data-reveal data-reveal-delay="0.2"
            en="A customer for twelve years, a family, a home to buy. He knows none of the engines you are about to see: he only lives what they do."
            it="Cliente da dodici anni, una famiglia, una casa da comprare. Non conosce nessuno dei motori che state per vedere: vive solo quello che fanno."
          />
          <div class="uc-quote" data-reveal data-reveal-delay="0.26">
            <T as="p" class="uc-quote-text" en="He just asked ChatGPT which bank to pick for his first-home mortgage. Let's follow his six moments." it="Ha appena chiesto a ChatGPT quale banca scegliere per il mutuo della prima casa. Seguiamo i suoi sei momenti." />
          </div>
          <ol class="uc-steps" aria-hidden="true" data-reveal data-reveal-delay="0.32">
            {marcoMoments.map((m) => (
              <li class="uc-steps-item"><span class="uc-steps-n">{m.n}</span><T as="span" class="uc-steps-label" en={m.short.en} it={m.short.it} /></li>
            ))}
          </ol>
        </div>
      </div>
    </Slide>

    <!-- ── STORIA DI MARCO · momento 01 ─────────────────────────────── -->
    <Slide id="slide-story-01" bg="inverse" align="split">
      <SlideBackdrop
        slot="backdrop"
        {...mediaProps(marcoMoments[0].bg)}
        imageClass="opacity-55"
        scrim="uc-story-scrim"
      />
      <div class="w-full flex-1 min-h-0 grid md:grid-cols-[1.05fr_0.95fr] gap-10 md:gap-16 items-center">
        <div class="text-left uc-story-text">
          <div class="flex items-center gap-3 mb-4" data-reveal>
            <T as="span" class="uc-story-kicker" en={`Moment ${marcoMoments[0].n} of ${marcoMoments[0].of} · ${marcoMoments[0].where.en}`} it={`Momento ${marcoMoments[0].n} di ${marcoMoments[0].of} · ${marcoMoments[0].where.it}`} />
          </div>
          <T as="h2" class="uc-story-title" data-reveal data-reveal-delay="0.08" en={marcoMoments[0].title.en} it={marcoMoments[0].title.it} />
          <T as="p" class="uc-story-body" data-reveal data-reveal-delay="0.16" en={marcoMoments[0].body.en} it={marcoMoments[0].body.it} />
          <a href={href(base, marcoMoments[0].href)} class="uc-story-link" data-reveal data-reveal-delay="0.24">
            <T en={`↳ Live in a moment · ${marcoMoments[0].where.en}`} it={`↳ Tra poco dal vivo · ${marcoMoments[0].where.it}`} />
          <T as="p" class="uc-firefly mt-6" data-reveal data-reveal-delay="0.3" en="Scene generated with Adobe Firefly · Content Credentials" it="Scena generata con Adobe Firefly · Content Credentials" />
          </a>
        </div>
        <div class="flex items-center justify-center md:justify-end" data-reveal data-reveal-delay="0.2">
            <div class="uc-mock uc-mock--dark">
              <p class="uc-mock-meta">ChatGPT · 21:40</p>
              <T as="p" class="uc-mock-query" en={'🔍 "best bank first-home mortgage italy"'} it={'🔍 "miglior banca mutuo prima casa italia"'} />
              <div class="uc-mock-answer">
                <p class="uc-mock-brand">UniCredit</p>
                <T as="p" class="uc-mock-text" en="A strong choice for a first-home mortgage: competitive rates, a dedicated advisor and a 100% digital application." it="Ottima scelta per il mutuo prima casa: tassi competitivi, consulenza dedicata e richiesta 100% digitale." />
              </div>
              <div class="uc-mock-foot">
                <span class="uc-mock-chip">unicredit.it</span>
                <T as="span" class="uc-mock-chip uc-mock-chip--rosso" en="page loaded · 0.3 s" it="pagina caricata · 0,3 s" />
              </div>
            </div>
        </div>
      </div>
    </Slide>

    <!-- ── STORIA DI MARCO · momento 02 ─────────────────────────────── -->
    <Slide id="slide-story-02" bg="inverse" align="split">
      <SlideBackdrop
        slot="backdrop"
        {...mediaProps(marcoMoments[1].bg)}
        imageClass="opacity-55"
        scrim="uc-story-scrim"
      />
      <div class="w-full flex-1 min-h-0 grid md:grid-cols-[1.05fr_0.95fr] gap-10 md:gap-16 items-center">
        <div class="text-left uc-story-text">
          <div class="flex items-center gap-3 mb-4" data-reveal>
            <T as="span" class="uc-story-kicker" en={`Moment ${marcoMoments[1].n} of ${marcoMoments[1].of} · ${marcoMoments[1].where.en}`} it={`Momento ${marcoMoments[1].n} di ${marcoMoments[1].of} · ${marcoMoments[1].where.it}`} />
          </div>
          <T as="h2" class="uc-story-title" data-reveal data-reveal-delay="0.08" en={marcoMoments[1].title.en} it={marcoMoments[1].title.it} />
          <T as="p" class="uc-story-body" data-reveal data-reveal-delay="0.16" en={marcoMoments[1].body.en} it={marcoMoments[1].body.it} />
          <a href={href(base, marcoMoments[1].href)} class="uc-story-link" data-reveal data-reveal-delay="0.24">
            <T en={`↳ Live in a moment · ${marcoMoments[1].where.en}`} it={`↳ Tra poco dal vivo · ${marcoMoments[1].where.it}`} />
          <T as="p" class="uc-firefly mt-6" data-reveal data-reveal-delay="0.3" en="Scene generated with Adobe Firefly · Content Credentials" it="Scena generata con Adobe Firefly · Content Credentials" />
          </a>
        </div>
        <div class="flex items-center justify-center md:justify-end" data-reveal data-reveal-delay="0.2">
            <div class="uc-mock">
              <p class="uc-mock-meta">GenStudio · <T en="1 brief → 12 variants" it="1 brief → 12 varianti" /></p>
              <div class="uc-mock-brief" style="border-left: 3px solid var(--color-rosso);">
                <T as="p" class="uc-mock-brief-tag" en="Families 35–45 · the reel ad Marco sees" it="Famiglie 35–45 · il reel ads che vede Marco" />
                <T as="p" class="uc-mock-h" style="margin-bottom:0.3rem;" en="A mortgage that grows with your family" it="Il mutuo che cresce con la tua famiglia" />
                <T as="p" class="uc-mock-text" en="Tone: grounded, reassuring · CTA: Work out your payment →" it="Tono: concreto, rassicurante · CTA: Calcola la rata →" />
              </div>
              <div class="uc-mock-rows">
                <div class="uc-mock-row"><T as="span" en="Graduates / freelancers" it="Neolaureati / freelance" /><span class="uc-mock-val"><T en="Your first home, within reach" it="La tua prima casa, alla tua portata" /></span></div>
                <div class="uc-mock-row"><T as="span" en="Young couples 30–40" it="Giovani coppie 30–40" /><span class="uc-mock-val"><T en="Build your nest together" it="Costruite insieme il vostro nido" /></span></div>
                <div class="uc-mock-row"><T as="span" en="Retirees 65+" it="Pensionati 65+" /><span class="uc-mock-val"><T en="Security for your children" it="Sicurezza ai tuoi figli" /></span></div>
              </div>
              <div class="uc-mock-foot">
                <T as="span" class="uc-mock-chip uc-mock-chip--rosso" en="Brand check ✓ on-brand" it="Brand check ✓ on-brand" />
                <T as="span" class="uc-mock-note" en="12 variants · minutes, not weeks" it="12 varianti · minuti, non settimane" />
              </div>
            </div>
        </div>
      </div>
    </Slide>

    <!-- ── STORIA DI MARCO · momento 03 ─────────────────────────────── -->
