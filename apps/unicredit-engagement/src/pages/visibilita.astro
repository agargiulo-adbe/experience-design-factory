---
import BaseLayout from '../layouts/BaseLayout.astro';
import UniNavigation from '../components/UniNavigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import CoverHero from '@edf/core/blocks/CoverHero.astro';
import SlideBackdrop from '@edf/core/blocks/SlideBackdrop.astro';
import { href } from '@edf/core/utils/url.js';
import { mediaProps } from '../../assets.index';
import MediaDemoSlot from '@edf/core/blocks/immersive/MediaDemoSlot.astro';
import T from '@edf/core/blocks/i18n/T.astro';

const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;

const llmStats = [
  { num: '−25%', desc: { it: 'volume atteso sui motori di ricerca tradizionali entro il 2026, sostituiti dagli assistenti AI', en: 'projected drop in traditional search volume by 2026, as AI assistants take over' }, source: 'Gartner, feb 2024', url: 'https://www.gartner.com/en/newsroom/press-releases/2024-02-19-gartner-predicts-search-engine-volume-will-drop-25-percent-by-2026-due-to-ai-chatbots-and-other-virtual-agents' },
  { num: '+1.200%', desc: { it: 'referral traffic proveniente dagli AI Assistant in un anno', en: 'growth in referral traffic from AI Assistants in a single year' }, source: 'Adobe Analytics, 2025', url: 'https://blog.adobe.com/en/publish/2025/03/17/adobe-analytics-traffic-to-us-retail-websites-from-generative-ai-sources-jumps-1200-percent' },
  { num: '−33%', desc: { it: 'bounce rate dei visitatori che arrivano dagli AI Assistant — restano più a lungo, vedono più pagine', en: 'lower bounce rate from AI Assistant visitors, who stay longer and read more pages' }, source: 'Adobe Analytics, 2025', url: 'https://blog.adobe.com/en/publish/2025/03/17/adobe-analytics-traffic-to-us-retail-websites-from-generative-ai-sources-jumps-1200-percent' },
];

const brandVisibilityPillars = [
  { title: { it: 'Visibilità AI completa', en: 'Full AI visibility' }, body: { it: 'Come UniCredit compare su 10 famiglie di LLM: ChatGPT, Perplexity, Gemini, Copilot, Google AI Mode. I log della CDN mostrano cosa leggono gli agenti, così le descrizioni sbagliate emergono subito.', en: 'How UniCredit shows up across 10 LLM families: ChatGPT, Perplexity, Gemini, Copilot, Google AI Mode. CDN logs reveal what the agents actually read, so wrong descriptions surface right away.' } },
  { title: { it: 'Intelligence guidata dalla SEO', en: 'SEO-driven intelligence' }, body: { it: 'Il query fan-out di Semrush trova dove UniCredit ha autorità SEO ma sparisce dalle risposte AI, e trasforma milioni di prompt reali in brief di contenuto già prioritizzati.', en: 'Semrush query fan-out finds where UniCredit ranks on SEO yet vanishes from AI answers, turning millions of real prompts into ready-ranked content briefs.' } },
  { title: { it: 'Ottimizzazioni su ogni superficie', en: 'Fixes on every surface' }, body: { it: 'Modifiche pubblicate in pochi minuti: all’edge della CDN per gli agenti senza toccare il CMS, oppure alla fonte per il sito. E la presenza si estende anche off-site.', en: 'Changes go live in minutes: at the CDN edge for the agents without touching the CMS, or at the source for the site. The presence reaches off-site too.' } },
  { title: { it: 'Misurazione ad anello chiuso', en: 'Closed-loop measurement' }, body: { it: 'Ogni azione è collegata a menzioni, citazioni e ricavo. Con Adobe Analytics e CJA nativi, dalla visibilità AI si arriva fino alla pipeline commerciale.', en: 'Every action ties back to mentions, citations and revenue. With native Adobe Analytics and CJA, AI visibility runs all the way to the sales pipeline.' } },
];

const edsMetrics = [
  { num: '100/100', label: { it: 'Lighthouse score', en: 'Lighthouse score' }, sub: { it: 'su tutti i dispositivi', en: 'across every device' } },
  { num: '0.3s', label: { it: 'First Contentful Paint', en: 'First Contentful Paint' }, sub: { it: 'vs. 3.2s media settore bancario', en: 'vs. 3.2s banking-sector average' } },
  { num: '↑', label: { it: 'Conversion rate', en: 'Conversion rate' }, sub: { it: 'su pagine EDS vs. pagine legacy', en: 'on EDS pages vs. legacy pages' } },
];

const optimizerPillars = [
  { title: { it: 'SEO', en: 'SEO' }, body: { it: 'Individua keyword mancanti, link rotti e metadati incompleti, insieme ad altre opportunità di ottimizzazione.', en: 'Spots missing keywords, broken links and incomplete metadata, along with other room to improve.' } },
  { title: { it: 'Contenuti e conversioni', en: 'Content and conversion' }, body: { it: 'Valuta la qualità dei contenuti, suggerisce come renderli più efficaci e valida le modifiche con test A/B.', en: 'Rates content quality, suggests how to make it sharper and validates the changes with A/B tests.' } },
  { title: { it: 'Accessibilità', en: 'Accessibility' }, body: { it: 'Verifica automatica della conformità WCAG: segnala criticità come le immagini senza testo alternativo e propone la correzione.', en: 'Automated WCAG checks: it flags issues like images with no alt text and proposes the fix.' } },
  { title: { it: 'Performance', en: 'Performance' }, body: { it: 'Monitora di continuo i Core Web Vitals e le prestazioni di pagina, indicando le aree su cui intervenire.', en: 'Continuously tracks Core Web Vitals and page speed, pointing to the areas that need work.' } },
];
---
<BaseLayout
  title="Essere trovati nell'era dell'AI"
  description="Già quando Marco lo chiede a ChatGPT, prima ancora di aprire il browser. Adobe Brand Visibility, AEM EDS, AEM Sites Optimizer."
>
  <div class="fixed top-0 left-0 right-0 z-50">
    <UniNavigation currentPath={currentPath} base={base} />
  </div>

  <DeckContainer nextHref={href(base, '/conosci')} prevHref={href(base, '/scenario')}>

    <!-- ── SLIDE 0: Cover ─────────────────────────────────────────── -->
    <Slide id="slide-cover" bg="inverse" align="center">
      <SlideBackdrop
        slot="backdrop"
        {...mediaProps('bg-digital-blue')}
        imageClass="opacity-20"
        scrim="bg-[var(--surface-inverse)]/84"
      />
      <span data-lang-it class="contents">
        <CoverHero
          eyebrow="01 · VISIBILITÀ"
          numeral="01"
          title="Essere trovati nell'era dell'AI"
          lead="Già quando Marco lo chiede a ChatGPT, prima ancora di aprire il browser."
          size="phase"
          tone="inverse"
          signature={false}
        />
      </span>
      <span data-lang-en class="contents">
        <CoverHero
          eyebrow="01 · VISIBILITY"
          numeral="01"
          title="Getting found in the age of AI"
          lead="Right when Marco asks ChatGPT, before he's even opened the browser."
          size="phase"
          tone="inverse"
          signature={false}
        />
      </span>
    </Slide>

    <!-- ── SLIDE 1: Il dato ───────────────────────────────────────── -->
    <Slide id="slide-data" bg="primary" align="center">
      <div slot="backdrop" class="uc-bg absolute inset-0" aria-hidden="true"></div>
      <div class="relative w-full max-w-6xl mx-auto">
        <T as="p" class="slide-eyebrow text-center text-[var(--accent-primary)] mb-5" data-reveal en="THE SHIFT" it="IL CAMBIAMENTO" />
        <T
          as="h2"
          class="slide-title text-[var(--ink-primary)] mb-3"
          style="font-size: clamp(2.25rem, 4.4vw, 4rem);"
          data-reveal
          data-reveal-delay="0.1"
          en="Search no longer starts with Google"
          it="La ricerca non parte più da Google"
        />
        <div class="uc-thread mx-auto mb-9 max-w-lg" data-reveal data-reveal-delay="0.15" aria-hidden="true">
          <span class="uc-node uc-node--rosso"></span>
          <span class="uc-thread-line"></span>
          <span class="uc-node"></span>
        </div>
        <div class="w-full grid grid-cols-3 gap-6 mb-9 items-stretch" data-reveal data-reveal-delay="0.2">
          {llmStats.map((s) => (
            <div class="uc-panel uc-panel--oro">
              <p class="uc-stat-value !text-[var(--color-rosso)] mb-3" style="text-align:left;">{s.num}</p>
              <T as="p" class="uc-panel-body" en={s.desc.en} it={s.desc.it} />
              <a href={s.url} target="_blank" rel="noopener noreferrer" class="uc-src underline underline-offset-2 hover:text-[var(--accent-primary)] mt-auto">{s.source}</a>
            </div>
          ))}
        </div>
        <div class="uc-panel uc-panel--rosso flex-row items-start gap-4 max-w-2xl mx-auto" data-reveal data-reveal-delay="0.45">
          <div class="uc-mark !mb-0">M</div>
          <div class="min-w-0">
            <T as="p" class="uc-tag mb-1.5" style="color:var(--color-grigio-400);" en="Marco, right now" it="Marco, in questo momento" />
            <T as="p" class="uc-quote-text !text-[1.05rem]" en={'«He typed into ChatGPT: "Best bank for a first-home mortgage in Italy." UniCredit came back first, and not by chance.»'} it={'«Ha digitato su ChatGPT: "Miglior banca per il mutuo della prima casa in Italia." UniCredit era la prima risposta, e non per caso.»'} />
          </div>
        </div>
      </div>
    </Slide>

    <!-- ── SLIDE 2: Marco's moment ───────────────────────────────── -->
    <Slide id="slide-marco-moment" bg="secondary" align="split">
      <div class="w-full flex-1 min-h-0 grid md:grid-cols-2 gap-10 md:gap-16 items-center">
        <div class="flex items-center justify-center">
          <div class="bg-[var(--surface-inverse)] text-[var(--ink-inverse)] rounded-sm p-6 font-mono text-sm leading-relaxed max-w-sm w-full" style="box-shadow: 0 18px 50px -20px rgba(26,26,46,0.55);">
            <p class="text-[var(--ink-inverse)]/50 text-xs mb-4">ChatGPT · 09:42</p>
            <T as="p" class="text-[var(--ink-inverse)]/80 mb-3" en={'🔍 "best bank first-home mortgage italy"'} it={'🔍 "miglior banca mutuo prima casa italia"'} />
            <div class="bg-[var(--ink-inverse)]/5 rounded p-3" style="border-left: 2px solid var(--color-oro); border-top: 1px solid rgba(245,242,238,0.1); border-right: 1px solid rgba(245,242,238,0.1); border-bottom: 1px solid rgba(245,242,238,0.1);">
              <p class="text-[var(--color-oro)] font-semibold mb-1">UniCredit</p>
              <T as="p" class="text-xs text-[var(--ink-inverse)]/70" en="A strong choice for a first-home mortgage: competitive rates, a dedicated advisor and a 100% digital application..." it="Ottima scelta per il mutuo prima casa: tassi competitivi, consulenza dedicata e richiesta 100% digitale..." />
            </div>
          </div>
        </div>
        <div class="text-left">
          <T as="p" class="slide-eyebrow text-[var(--accent-primary)] mb-4" data-reveal en="MARCO'S STORY · STEP 1 OF 10" it="LA STORIA DI MARCO · PASSO 1 DI 10" />
          <div class="uc-thread mb-4 max-w-[16rem]" data-reveal data-reveal-delay="0.05" aria-hidden="true">
            <span class="uc-node uc-node--rosso"></span>
            <span class="uc-thread-line"></span>
            <span class="uc-node"></span>
          </div>
          <p class="uc-tag mb-3" data-reveal data-reveal-delay="0.05">ADOBE BRAND VISIBILITY</p>
          <T
            as="h3"
            class="text-[var(--ink-primary)] mb-6"
            style="font-size: clamp(1.6rem, 2.8vw, 2.6rem);"
            data-reveal
            data-reveal-delay="0.1"
            en="UniCredit was there by design, not by luck"
            it="UniCredit era lì per scelta, non per fortuna"
          />
          <ul class="space-y-3" data-reveal data-reveal-delay="0.2">
            <li class="flex items-start gap-3">
              <span class="mt-2 uc-node uc-node--rosso"></span>
              <T as="p" class="uc-panel-body !mb-0" en="Monitoring across ChatGPT, Perplexity, Gemini, Copilot and other LLMs" it="Monitoraggio su ChatGPT, Perplexity, Gemini, Copilot e altri LLM" />
            </li>
            <li class="flex items-start gap-3">
              <span class="mt-2 uc-node uc-node--rosso"></span>
              <T as="p" class="uc-panel-body !mb-0" en="Content made readable and quotable by AI assistants" it="Contenuti resi leggibili e citabili dagli assistenti AI" />
            </li>
            <li class="flex items-start gap-3">
              <span class="mt-2 uc-node uc-node--rosso"></span>
              <T as="p" class="uc-panel-body !mb-0" en="Tracking from the first AI click through to conversion" it="Tracciamento dal primo click AI fino alla conversione" />
            </li>
          </ul>
        </div>
      </div>
    </Slide>

    <!-- ── SLIDE 3: Adobe Brand Visibility (Adobe + Semrush) ─────── -->
    <Slide id="slide-brand-visibility" bg="primary" align="split" data-solution="brand-visibility">
      <div slot="backdrop" class="uc-bg absolute inset-0" aria-hidden="true"></div>
      <div class="relative w-full flex-1 min-h-0 grid md:grid-cols-[0.9fr_1.1fr] gap-10 md:gap-14 items-center">
        <div class="text-left">
          <p class="slide-eyebrow text-[var(--accent-primary)] mb-4" data-reveal>ADOBE BRAND VISIBILITY · ADOBE + SEMRUSH</p>
          <div class="uc-thread mb-5 max-w-[18rem]" data-reveal data-reveal-delay="0.06" aria-hidden="true">
            <span class="uc-node uc-node--rosso"></span>
            <span class="uc-thread-line"></span>
            <span class="uc-node"></span>
          </div>
          <T
            as="h2"
            class="text-[var(--ink-primary)] mb-5 font-[family-name:var(--font-display)]"
            style="font-size: clamp(1.9rem, 3vw, 2.9rem); line-height: 1.08;"
            data-reveal
            data-reveal-delay="0.1"
            en="Measuring AI visibility isn't enough: you have to change it"
            it="Misurare la visibilità AI non basta: va cambiata"
          />
          <T as="p" class="uc-panel-body !text-base" data-reveal data-reveal-delay="0.15"
            en="Adobe and Semrush on one platform, from analysis to action to revenue: millions of real prompts, fixes at the edge and at the source, and every move tied to a business result."
            it="Adobe e Semrush in una sola piattaforma, dall'analisi all'azione fino al ricavo: milioni di prompt reali, ottimizzazioni all'edge e alla fonte, e ogni intervento legato a un risultato di business."
          />
        </div>
        <div class="grid grid-cols-2 gap-4" data-reveal data-reveal-delay="0.22">
          {brandVisibilityPillars.map((p, i) => (
            <div class="uc-card !p-5">
              <div class="uc-mark !w-8 !h-8 !text-sm !mb-3">{i + 1}</div>
              <T as="p" class="uc-card-title !text-[1.05rem] !mb-1.5" en={p.title.en} it={p.title.it} />
              <T as="p" class="uc-card-body !text-[0.95rem]" en={p.body.en} it={p.body.it} />
            </div>
          ))}
        </div>
      </div>
    </Slide>

    <!-- ── SLIDE 5: AEM Sites EDS ─────────────────────────────────── -->
    <Slide id="slide-eds" bg="inverse" align="center">
      <SlideBackdrop
        slot="backdrop"
        {...mediaProps('bg-data-dark')}
        imageClass="opacity-18"
        scrim="bg-[var(--surface-inverse)]/84"
      />
      <div data-demo-flex class="w-full flex items-start gap-8">
        <div class="flex-1 min-w-0 text-center">
          <p class="slide-eyebrow text-center text-[var(--color-oro)] mb-4" data-reveal>AEM SITES EDGE DELIVERY</p>
          <div class="uc-thread mx-auto mb-6 max-w-[18rem]" data-reveal data-reveal-delay="0.06" aria-hidden="true">
            <span class="uc-node"></span>
            <span class="uc-thread-line"></span>
            <span class="uc-node uc-node--rosso"></span>
          </div>
          <T
            as="h2"
            class="slide-title text-[var(--ink-inverse)] mb-5"
            style="font-size: clamp(2.25rem, 4.4vw, 4rem);"
            data-reveal
            data-reveal-delay="0.1"
            en="0.3 seconds. Not 3.2 seconds."
            it="0.3 secondi. Non 3.2 secondi."
          />
          <T as="p" class="text-[clamp(1.05rem,1.4vw,1.3rem)] text-[var(--color-grigio-200)] max-w-2xl mx-auto mb-10 leading-relaxed" data-reveal data-reveal-delay="0.15"
            en="When Marco clicks the ChatGPT link he already has 3 banks open: he stays with the one that loads first."
            it="Quando Marco clicca il link di ChatGPT ha già 3 banche aperte: resta con quella che si apre per prima."
          />
          <div class="w-full max-w-4xl mx-auto grid grid-cols-3 gap-6 mb-8" data-reveal data-reveal-delay="0.2">
            {edsMetrics.map((m) => (
              <div class="rounded-sm text-center px-5 py-6" style="background: rgba(245,242,238,0.05); border-top: 2px solid var(--color-oro); box-shadow: 0 8px 30px -18px rgba(0,0,0,0.6);">
                <p
                  class="font-[family-name:var(--font-display)] font-light text-[var(--accent-secondary)] leading-none mb-2"
                  style="font-size: clamp(2rem, 3.5vw, 3rem);"
                >{m.num}</p>
                <T as="p" class="text-sm font-semibold text-[var(--ink-inverse)] mb-1" en={m.label.en} it={m.label.it} />
                <T as="p" class="text-sm text-[var(--color-grigio-300)]" en={m.sub.en} it={m.sub.it} />
              </div>
            ))}
          </div>
          <T as="p" class="text-xs text-center text-[var(--color-grigio-300)] tracking-wider" data-reveal data-reveal-delay="0.35"
            en="Content served at the edge · CDN run by Adobe or your own (BYO) · Web development on open standards (JS/CSS) · Lightning-fast deployments"
            it="Contenuti serviti all'edge · CDN gestita da Adobe o propria (BYO) · Sviluppo web su standard aperti (JS/CSS) · Deployment rapidissimi"
          />
          <p class="mt-6 text-center text-[0.72rem] tracking-widest uppercase text-[var(--color-grigio-400)]">Fonte: AEM Edge Delivery Services benchmarks 2024 · Google CrUX, settore banking IT</p>
        </div>
        <MediaDemoSlot id="visibilita-aem-demo" label="AEM Sites EDS — Performance Demo" />
      </div>
    </Slide>

    <!-- ── SLIDE 6: AEM Sites Optimizer ──────────────────────────── -->
    <Slide id="slide-optimizer" bg="primary" align="split">
      <div slot="backdrop" class="uc-bg absolute inset-0" aria-hidden="true"></div>
      <div class="relative w-full flex-1 min-h-0 grid md:grid-cols-[0.85fr_1.15fr] gap-10 md:gap-14 items-center">
        <div class="text-left">
          <p class="slide-eyebrow text-[var(--accent-primary)] mb-4" data-reveal>AEM SITES OPTIMIZER</p>
          <div class="uc-thread mb-5 max-w-[18rem]" data-reveal data-reveal-delay="0.06" aria-hidden="true">
            <span class="uc-node uc-node--rosso"></span>
            <span class="uc-thread-line"></span>
            <span class="uc-node"></span>
          </div>
          <T
            as="h2"
            class="text-[var(--ink-primary)] mb-5 font-[family-name:var(--font-display)]"
            style="font-size: clamp(1.9rem, 3vw, 2.9rem); line-height: 1.08;"
            data-reveal
            data-reveal-delay="0.1"
            en="Where to improve, page by page"
            it="Dove migliorare, pagina per pagina"
          />
          <T as="p" class="uc-panel-body !text-base !mb-5" data-reveal data-reveal-delay="0.15"
            en="It analyzes every page and helps the marketing and content teams see where to act, with concrete, ready-ranked steps."
            it="Analizza ogni pagina e aiuta i team marketing e contenuti a capire dove intervenire, con azioni concrete e già prioritizzate."
          />
          <T as="p" class="uc-src !normal-case !tracking-normal !text-[0.9rem] leading-relaxed mb-6" data-reveal data-reveal-delay="0.2" style="color: var(--color-grigio-500);"
            en="Part of the AEM Sites suite: automated, continuous analysis built into the editorial workflow."
            it="Parte della suite AEM Sites: analisi automatica, continua e integrata nel workflow editoriale."
          />
          <div class="uc-quote !mt-0" data-reveal data-reveal-delay="0.35">
            <a
              href={href(base, '/conosci')}
              class="text-base text-[var(--accent-primary)] hover:underline font-semibold"
            >
              <T en="Next chapter: UniCredit already knows Marco →" it="Prossimo capitolo: UniCredit conosce già Marco →" />
            </a>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-5" data-reveal data-reveal-delay="0.22">
          {optimizerPillars.map((p) => (
            <div class="uc-panel uc-panel--rosso">
              <T as="p" class="uc-card-title !text-base !mb-1.5 !text-[var(--accent-primary)]" en={p.title.en} it={p.title.it} />
              <T as="p" class="uc-card-body !text-[0.95rem]" en={p.body.en} it={p.body.it} />
            </div>
          ))}
        </div>
      </div>
    </Slide>

  </DeckContainer>
</BaseLayout>
