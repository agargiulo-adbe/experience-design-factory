---
import BaseLayout from '../layouts/BaseLayout.astro';
import AdminConsole from '@edf/core/blocks/admin/AdminConsole.astro';
import { href } from '@edf/core/utils/url.js';

const base = import.meta.env.BASE_URL;
const SUPABASE_URL = import.meta.env.PUBLIC_SUPABASE_URL ?? '';
const SUPABASE_ANON_KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY ?? '';

// Registry di tutte le pagine e slide dell'experience
interface SlideEntry { id: string; label: string; }
interface PageEntry { slug: string; label: string; slides: SlideEntry[]; }

// Workshop cut — the six chapters of the customer story, in flow order.
// The old full-funnel sections (conosci/acquisisci/coinvolgi/b2b/motore-adobe)
// still exist as files but are out of the deck flow, so they're off the registry.
const PAGE_REGISTRY: PageEntry[] = [
  { slug: 'scenario', label: 'Scenario (00)', slides: [
    { id: 'slide-cover', label: 'Cover' },
    { id: 'slide-trends', label: 'Trend del banking' },
    { id: 'slide-gap', label: 'Il gap di UniCredit' },
    { id: 'slide-marco', label: 'Marco — profilo cliente' },
    { id: 'slide-engine-map', label: 'Il motore dietro la storia' },
    { id: 'slide-promise', label: 'La promessa' },
  ]},
  { slug: 'visibilita', label: 'Il Sito (01)', slides: [
    { id: 'slide-cover', label: 'Cover' },
    { id: 'slide-data', label: 'Dati: visibilità AI' },
    { id: 'slide-marco-moment', label: 'Il momento di Marco' },
    { id: 'slide-brand-visibility', label: 'Adobe Brand Visibility' },
    { id: 'slide-eds', label: 'AEM Sites Edge Delivery' },
    { id: 'slide-aem-agents', label: 'AI Agents in AEM' },
    { id: 'slide-optimizer', label: 'AEM Sites Optimizer' },
  ]},
  { slug: 'contenuti', label: 'Contenuti (02)', slides: [
    { id: 'slide-cover', label: 'Cover' },
    { id: 'slide-problem', label: 'Il problema di scala' },
    { id: 'slide-genstudio', label: 'GenStudio — varianti' },
    { id: 'slide-brand-concierge', label: 'Brand Concierge' },
  ]},
  { slug: 'analizza', label: 'Analizza (03)', slides: [
    { id: 'slide-cover', label: 'Cover' },
    { id: 'slide-journey', label: 'Il viaggio di Marco, misurato (CJA)' },
    { id: 'slide-lasttouch', label: 'Last-touch → vista complementare' },
    { id: 'slide-agent', label: 'Data Insights Agent' },
    { id: 'slide-llm', label: 'LLM Insights' },
    { id: 'slide-costpersale', label: 'Cost-per-click → cost-per-sale' },
    { id: 'slide-campaign', label: 'Marketing Campaign Analytics' },
    { id: 'slide-cxa-brand', label: 'Adobe CX Analytics — la piattaforma' },
    { id: 'slide-everywhere', label: 'Analytics everywhere → Coworker' },
  ]},
  { slug: 'coworker', label: 'Coworker AI (04)', slides: [
    { id: 'slide-cover', label: 'Cover' },
    { id: 'slide-coworker-intro', label: 'Introduzione Coworker' },
    { id: 'slide-problem', label: 'Il problema operativo' },
    { id: 'slide-marco-brief', label: 'Marco — brief AI' },
    { id: 'slide-governance', label: 'Enterprise governance' },
    { id: 'slide-coworker-result', label: 'Coworker — risultati' },
  ]},
  { slug: 'risultati', label: 'Risultati (05)', slides: [
    { id: 'slide-cover', label: 'Cover' },
    { id: 'slide-storie-roi', label: 'Il percorso di Marco — i numeri' },
    { id: 'slide-metrics', label: 'Metriche chiave' },
    { id: 'slide-cases', label: 'Case study' },
    { id: 'slide-roi', label: 'ROI UniCredit' },
  ]},
];

// Registry delle soluzioni Adobe — controllano l'accensione/spegnimento
// delle sezioni dell'experience (data-solution / pageSolutions).
// `gate` = sezioni per cui questo prodotto è NECESSARIO (spente tutte → sezione via).
// `appearsIn` = tutte le sezioni in cui il prodotto compare (chip/slide gated),
//   così l'utente sa dove agisce il toggle anche se compare in più sezioni.
interface SolutionEntry { id: string; name: string; shortName: string; pillar: string; description: string; appearsIn: string[]; }

const SOLUTIONS: SolutionEntry[] = [
  { id: 'aep', name: 'Adobe Experience Platform', shortName: 'AEP', pillar: 'foundation', description: 'Foundation: unifica tutti i dati cliente in real-time.', appearsIn: ['Motore'] },
  { id: 'brand-visibility', name: 'Adobe Brand Visibility', shortName: 'Brand Visibility', pillar: 'visibility', description: 'Adobe + Semrush: visibilità AI end-to-end — intelligence, ottimizzazioni all\'edge e alla fonte, misurazione closed-loop.', appearsIn: ['Visibilità'] },
  { id: 'rtcdp', name: 'Real-Time CDP', shortName: 'RT-CDP', pillar: 'data', description: 'Profili unificati e audience segmentation in tempo reale.', appearsIn: ['Conosci', 'Motore'] },
  { id: 'cja', name: 'Customer Journey Analytics', shortName: 'CJA', pillar: 'analytics', description: 'Cross-channel analytics: dal branch al mobile in una vista.', appearsIn: ['Analizza', 'B2B', 'Motore'] },
  { id: 'ajo-b2c', name: 'Journey Optimizer B2C', shortName: 'AJO B2C', pillar: 'journeys', description: 'Orchestrazione omnicanale per acquisizione e engagement.', appearsIn: ['Acquisisci', 'Coinvolgi', 'Motore'] },
  { id: 'aem-sites', name: 'AEM Sites & Edge Delivery', shortName: 'AEM Sites', pillar: 'content', description: 'Gestione canali digitali con velocità editoriale enterprise.', appearsIn: ['Acquisisci', 'Il Sito', 'Motore'] },
  { id: 'aem-assets', name: 'AEM Assets + Dynamic Media', shortName: 'AEM Assets', pillar: 'content', description: 'DAM enterprise per contenuti multicanale a scala.', appearsIn: ['Il Sito', 'Motore'] },
  { id: 'genstudio', name: 'GenStudio for Performance Marketing', shortName: 'GenStudio', pillar: 'content', description: 'Varianti di contenuto on-brand in pochi minuti.', appearsIn: ['Contenuti', 'Motore'] },
  { id: 'firefly', name: 'Adobe Firefly', shortName: 'Firefly', pillar: 'content', description: 'AI image generation sicura per uso commerciale; API, Custom Models e Foundry per modelli proprietari.', appearsIn: ['Contenuti', 'Motore'] },
  { id: 'brand-concierge', name: 'Adobe Brand Concierge', shortName: 'Brand Concierge', pillar: 'content', description: 'Esperienza conversazionale brand-first: dialogo naturale, grounded sui dati first-party, multi-agente.', appearsIn: ['Contenuti'] },
  { id: 'target', name: 'Adobe Target', shortName: 'Target', pillar: 'personalization', description: 'A/B testing e personalizzazione su ogni touchpoint digitale.', appearsIn: ['Coinvolgi', 'Motore'] },
  { id: 'ajo-b2b', name: 'Journey Optimizer B2B Edition', shortName: 'AJO B2B', pillar: 'b2b', description: 'Account-based journeys per PMI e corporate banking.', appearsIn: ['B2B', 'Motore'] },
  { id: 'marketo', name: 'Marketo Engage', shortName: 'Marketo', pillar: 'b2b', description: 'Marketing automation B2B per lead generation corporate.', appearsIn: ['B2B', 'Motore'] },
  { id: 'cx-analytics', name: 'Adobe CX Analytics', shortName: 'CX Analytics', pillar: 'intelligence', description: 'Umbrella: CJA + Content Analytics + Adobe Analytics — intelligence unificata.', appearsIn: ['Analizza', 'Motore'] },
  { id: 'data-insights-agent', name: 'Data Insights Agent', shortName: 'DIA', pillar: 'intelligence', description: 'AI agent per root cause analysis in linguaggio naturale.', appearsIn: ['Analizza', 'Motore'] },
  { id: 'content-analytics', name: 'Adobe Content Analytics', shortName: 'Content Analytics', pillar: 'intelligence', description: 'Misura quale contenuto porta a risultati — per segmento e canale.', appearsIn: ['Contenuti', 'Analizza', 'Motore'] },
  { id: 'mix-modeler', name: 'Adobe Marketing Campaign Analytics', shortName: 'MCA', pillar: 'intelligence', description: 'Causal AI — full-funnel attribution, incrementalità e budget optimization con raccomandazioni agentiche.', appearsIn: ['Analizza', 'Motore'] },
];

const PILLAR_LABELS: Record<string, string> = {
  foundation: 'Foundation', visibility: 'AI Visibility', data: 'Data & Profiles', journeys: 'Journeys',
  content: 'Content', analytics: 'Analytics', intelligence: 'CX Analytics & AI',
  personalization: 'Personalization', b2b: 'B2B',
};
const PILLAR_ORDER = ['foundation', 'visibility', 'data', 'journeys', 'content', 'analytics', 'intelligence', 'personalization', 'b2b'];
const PILLAR_COLORS: Record<string, string> = {
  foundation: '#BE2027', visibility: '#9333ea', data: '#2563eb', journeys: '#7c3aed', content: '#ea580c',
  analytics: '#0891b2', intelligence: '#0d9488', personalization: '#db2777', b2b: '#4f46e5',
};

const solutionGroups = PILLAR_ORDER
  .map((pillar) => ({
    pillar,
    label: PILLAR_LABELS[pillar],
    color: PILLAR_COLORS[pillar],
    solutions: SOLUTIONS.filter((s) => s.pillar === pillar),
  }))
  .filter((g) => g.solutions.length > 0);

const allSolutionIds = SOLUTIONS.map((s) => s.id);

const deckHref = href(base, '/');
---

<BaseLayout title="Console di configurazione — Engagement Unlimited">
  <AdminConsole
    projectSlug="unicredit-engagement"
    projectName="Engagement Unlimited"
    clientLabel="UniCredit × Adobe"
    deckHref={deckHref}
    pages={PAGE_REGISTRY}
    solutionGroups={solutionGroups}
    allSolutionIds={allSolutionIds}
    supabaseUrl={SUPABASE_URL}
    supabaseAnonKey={SUPABASE_ANON_KEY}
  />
</BaseLayout>
