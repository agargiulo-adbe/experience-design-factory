---
/**
 * CoBrand — la firma «Adobe × UniCredit» su ogni slide.
 *
 * Marchio Adobe come SVG inline, logo UniCredit dal file ufficiale monocromo
 * che il cliente stessa distribuisce (UC-logo-white.svg), riportato a
 * `currentColor` così la stessa risorsa sta su fondo chiaro e su fondo scuro.
 *
 * È un elemento di chrome, non contenuto: sta fuori dal flusso della slide
 * (fixed, in basso a sinistra, dentro la safe-area) e non entra nel conteggio
 * delle slide né nelle misure dell'audit. `aria-hidden` perché il nome delle
 * due aziende è già nel titolo del documento e nella nav.
 */
interface Props {
  /** 'chrome' (default) = firma discreta fissa in basso; 'lockup' = versione grande, in flusso. */
  variant?: 'chrome' | 'lockup';
  class?: string;
}
const { variant = 'chrome', class: className } = Astro.props;
