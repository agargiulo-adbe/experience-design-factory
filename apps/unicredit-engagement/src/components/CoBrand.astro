<style is:global>
  /* Fixed: la firma resta ferma mentre le slide scorrono, e non tocca né la nav
     (in alto) né i controlli del deck (in basso al centro). */
  .uc-cobrand-mark {
    position: fixed;
    left: var(--slide-safe-inset, 80px);
    bottom: calc(var(--deck-chrome-safe, 168px) / 3);
    z-index: 30;
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    pointer-events: none;
    opacity: 0.62;
    transition: opacity 200ms ease;
  }
  .uc-cobrand-adobe { width: 1.05rem; height: 1.05rem; flex-shrink: 0; fill: rgba(235,16,0,1); }
  .uc-cobrand-x { font-size: 0.7rem; line-height: 1; color: currentColor; opacity: 0.55; }
  .uc-cobrand-uni { height: 0.8rem; width: auto; flex-shrink: 0; color: currentColor; }

  /* L'inchiostro segue la slide: chiaro sulle slide scure, scuro sulle chiare.
     Il default è la slide scura, quella su cui vive quasi tutto il deck. */
  .uc-cobrand-mark { color: rgba(38,38,38,0.85); }
  [data-deck][data-on-dark] ~ .uc-cobrand-mark,
  body:has([data-deck][data-on-dark]) .uc-cobrand-mark { color: rgba(245,245,245,0.92); }

  /* Versione grande per la slide di chiusura: sta nel flusso, non è chrome. */
  .uc-cobrand-mark--lockup {
    position: static;
    opacity: 1;
    gap: 0.9rem;
    color: rgba(245,245,245,0.95);
  }
  .uc-cobrand-mark--lockup .uc-cobrand-adobe { width: 2rem; height: 2rem; }
  .uc-cobrand-mark--lockup .uc-cobrand-uni { height: 1.55rem; }
  .uc-cobrand-mark--lockup .uc-cobrand-x { font-size: 1.2rem; opacity: 0.5; }

  /* La firma è chrome del deck: fuori dal deck (admin, dossier) non ha senso. */
  body:not(:has([data-deck])) .uc-cobrand-mark:not(.uc-cobrand-mark--lockup) { display: none; }

  @media (max-width: 640px) { .uc-cobrand-mark:not(.uc-cobrand-mark--lockup) { display: none; } }
  @media (prefers-reduced-motion: reduce) { .uc-cobrand-mark { transition: none; } }
</style>
