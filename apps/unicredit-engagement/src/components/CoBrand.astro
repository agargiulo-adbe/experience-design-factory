---
/**
 * CoBrand (UniCredit) — wrapper sottile sul componente condiviso.
 *
 * Il motore (`@edf/core/blocks/CoBrand.astro`) porta la regola: ordine Adobe ×
 * Brand non invertibile, firma fissa su ogni slide, lockup grande su prima e
 * ultima slide. Qui si dichiara solo CHI è il brand e con quale marchio.
 * Ogni experience ha il suo wrapper identico a questo: cambia il nome e il marchio.
 */
import Core from '@edf/core/blocks/CoBrand.astro';
import UcBrandMark from './UcBrandMark.astro';

interface Props {
  variant?: 'chrome' | 'hero';
  class?: string;
  [key: string]: unknown;
}
const props = Astro.props as Props;
---
<Core brand="UniCredit" {...props}>
  <UcBrandMark slot="brand" />
</Core>
