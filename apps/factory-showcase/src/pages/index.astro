<script is:inline define:vars={{ SUPABASE_URL, SUPABASE_ANON_KEY, TYPE_LABELS }}>
/*
  Quali Experience Design compaiono qui lo decide il toggle in Super Admin, in
  tempo reale: nessun rebuild. La pagina parte dal set di default già renderizzato
  e lo corregge con lo stato remoto.

  FAIL-CLOSED per scelta: se manca la chiave, se la rete cade o se la risposta non
  si legge, non si tocca nulla e restano visibili solo le experience marcate
  pubbliche nel codice. Un guasto non può far comparire qualcosa che era stato
  depubblicato. La policy anon lato database restituisce comunque SOLO le righe
  con show_in_showcase = true.

  Le experience nate da materiale riservato NON stanno nel markup statico: né la
  card, né il link, né il nome del cliente. Se la Console le pubblica, la card
  viene costruita qui con i dati che il backend restituisce — così il DOM di una
  pagina pubblica non porta mai un URL che non è stato pubblicato.
*/
(function () {
  if (!SUPABASE_URL || !SUPABASE_ANON_KEY) return;

  var grid = document.querySelector('.exp-grid');
  var skinsRow = document.querySelector('.arch-skins-row');
  var nextSkin = skinsRow ? skinsRow.querySelector('.arch-skin--next') : null;

  function el(tag, cls, text) {
    var n = document.createElement(tag);
    if (cls) n.className = cls;
    if (text != null) n.textContent = text;
    return n;
  }

  // Una card costruita dal solo stato remoto. Nessuna immagine: lo screenshot
  // vive nel bundle statico e il suo nome direbbe da sé quale cliente è.
  function buildCard(row) {
    var a = el('a', 'exp-card exp-card--remote');
    a.href = row.base_url && row.base_url.charAt(0) === '/' ? row.base_url : '#';
    a.target = '_blank';
    a.rel = 'noopener';
    a.setAttribute('data-exp', row.slug);
    a.setAttribute('data-sections', '0');
    // Il registry statico non porta l'accento di una experience non pubblicata
    // (direbbe da se' quale cliente e'): la card remota prende quello di sistema.
    a.style.setProperty('--exp-accent', 'var(--accent-primary)');

    var visual = el('div', 'exp-visual');
    visual.appendChild(el('span', 'exp-chip', row.client || ''));
    var live = el('span', 'exp-live');
    live.setAttribute('aria-hidden', 'true');
    live.appendChild(el('span', 'exp-live-dot'));
    live.appendChild(document.createTextNode('LIVE'));
    visual.appendChild(live);
    a.appendChild(visual);

    var body = el('div', 'exp-body');
    // Il tipo e' una colonna del registry (migrazione 0016): la card remota
    // porta lo stesso badge delle altre, con l'etichetta della tassonomia.
    var lang = document.documentElement.getAttribute('data-lang') === 'en' ? 'en' : 'it';
    var label = row.type && TYPE_LABELS[row.type] ? TYPE_LABELS[row.type][lang] : '';
    if (label) body.appendChild(el('p', 'exp-type', label));
    body.appendChild(el('h3', 'exp-name', row.name || row.slug));
    if (row.description) body.appendChild(el('p', 'exp-desc', row.description));
    var open = el('span', 'exp-open');
    open.appendChild(el('span', null, lang === 'en' ? 'Open experience' : 'Apri l\u2019esperienza'));
    body.appendChild(open);
    a.appendChild(body);
    return a;
  }

  function buildSkin(row) {
    var d = el('div', 'arch-skin');
    d.style.setProperty('--k', 'var(--accent-primary)');
    d.setAttribute('data-exp-skin', row.slug);
    d.appendChild(el('strong', null, row.client || row.slug));
    d.appendChild(el('span', null, row.name || ''));
    return d;
  }

  function applyPublished(rows) {
    var slugs = rows.map(function (r) { return r.slug; });

    // 1. le card già nel markup: si spengono se non sono più pubblicate
    document.querySelectorAll('[data-exp]').forEach(function (card) {
      card.hidden = slugs.indexOf(card.getAttribute('data-exp')) === -1;
    });
    document.querySelectorAll('[data-exp-skin]').forEach(function (skin) {
      skin.hidden = slugs.indexOf(skin.getAttribute('data-exp-skin')) === -1;
    });

    // 2. le righe pubblicate che non hanno una card: si costruiscono adesso
    rows.forEach(function (row) {
      if (!row.slug) return;
      if (grid && !grid.querySelector('[data-exp="' + row.slug + '"]')) {
        grid.appendChild(buildCard(row));
      }
      if (skinsRow && !skinsRow.querySelector('[data-exp-skin="' + row.slug + '"]')) {
        skinsRow.insertBefore(buildSkin(row), nextSkin);
      }
    });

    var live = 0;
    document.querySelectorAll('[data-exp]').forEach(function (card) { if (!card.hidden) live++; });

    document.querySelectorAll('[data-live-count]').forEach(function (el2) {
      el2.setAttribute('data-count', String(live));
      el2.textContent = String(live);
      // Il contatore animato marca l'elemento come già contato e ne riscrive il
      // testo: se lo stato remoto arriva dopo, va ri-animato sul nuovo valore.
      // (Con reduced-motion countUp esce subito e resta il testo appena scritto.)
      el2.removeAttribute('data-counted');
      if (window.__edfCountUp) window.__edfCountUp(el2);
    });
    var EN = ['zero','One','Two','Three','Four','Five','Six','Seven','Eight','Nine','Ten','Eleven','Twelve'];
    var IT = ['zero','Una','Due','Tre','Quattro','Cinque','Sei','Sette','Otto','Nove','Dieci','Undici','Dodici'];
    document.querySelectorAll('[data-live-word]').forEach(function (el2) {
      var it = !!el2.closest('[data-lang-it]');
      var words = it ? IT : EN;
      el2.textContent = live < words.length ? words[live] : String(live);
    });
  }

  fetch(SUPABASE_URL + '/rest/v1/experiences?select=slug,name,client,description,base_url,type&show_in_showcase=eq.true', {
    headers: { apikey: SUPABASE_ANON_KEY, Authorization: 'Bearer ' + SUPABASE_ANON_KEY },
  })
    .then(function (r) { return r.ok ? r.json() : null; })
    .then(function (rows) {
      if (!Array.isArray(rows) || rows.length === 0) return;   // fail-closed
      applyPublished(rows);
    })
    .catch(function () { /* fail-closed: resta il set di default */ });
})();
</script>
</BaseLayout>

