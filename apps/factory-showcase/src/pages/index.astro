    ];

    function apply() {
      var max = maxColsFor(window.innerWidth);
      GRIDS.forEach(function (g) {
        var grid = document.querySelector(g.sel);
        if (!grid) return;
        var visible = [].slice.call(grid.querySelectorAll(g.item))
          .filter(function (el) { return !el.hasAttribute('hidden'); }).length;
        grid.style.setProperty('--exp-cols', String(best(visible, max)));
      });
    }

    var t;
    function schedule() { clearTimeout(t); t = setTimeout(apply, 60); }
    apply();
    window.addEventListener('resize', schedule);
    document.addEventListener('astro:page-load', apply);
    // il filtro di pubblicazione scopre/nasconde card dopo la risposta di Supabase
    try {
      GRIDS.forEach(function (g) {
        var el = document.querySelector(g.sel);
        if (el) new MutationObserver(schedule).observe(el, { attributes: true, subtree: true, attributeFilter: ['hidden'] });
      });
    } catch (e) {}
  })();
</script>
