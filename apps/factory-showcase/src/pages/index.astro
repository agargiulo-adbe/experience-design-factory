  :global(.hero-line) { display: block; }
  :global(.hero-line--grad) { background: var(--grad-adobe); -webkit-background-clip: text; background-clip: text; color: transparent; }
  :global(.hero-lead) { margin-top: 1.5rem; max-width: 40ch; }
  .hero-cta { display: flex; flex-wrap: wrap; gap: 0.8rem; margin-top: 2rem; }
  .hero-skill-cta { position: relative; }
  .hero-skill-dot { width: 0.5rem; height: 0.5rem; border-radius: 50%; background: #1E9E5A; box-shadow: 0 0 0 0 rgba(30,158,90,0.6); animation: skillPulse 2.2s infinite; }
  @keyframes skillPulse { 0% { box-shadow: 0 0 0 0 rgba(30,158,90,0.55); } 70% { box-shadow: 0 0 0 6px rgba(30,158,90,0); } 100% { box-shadow: 0 0 0 0 rgba(30,158,90,0); } }
  @media (prefers-reduced-motion: reduce) { .hero-skill-dot { animation: none; } }
  .hero-textlink { display: inline-flex; align-items: center; gap: 0.35rem; margin-top: 1rem; font-size: 0.9rem; font-weight: 600; color: var(--ink-tertiary); }
  .hero-textlink:hover { color: var(--accent-primary); }
  .hero-stat-ref { color: inherit; border-bottom: 1px dotted var(--line-default); padding-bottom: 1px; transition: color 0.15s, border-color 0.15s; }
  .hero-stat-ref:hover { color: var(--accent-primary); border-bottom-color: var(--accent-primary); }
  .hero-stats { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.5rem 2rem; margin-top: 3.5rem; max-width: 40rem; }
  @media (min-width: 720px) { .hero-stats { grid-template-columns: repeat(4, auto); } }
  .hero-stats dt { font-family: var(--font-display); font-weight: 800; font-size: clamp(1.8rem, 3.5vw, 2.6rem); letter-spacing: -0.03em; line-height: 1; }
  .hero-stats .hero-stat-u { font-size: 0.9rem; font-weight: 700; color: var(--ink-tertiary); }
  .hero-stats .hero-stat-lt { color: var(--accent-primary); }
  .hero-stats dd { font-size: 0.82rem; color: var(--ink-tertiary); margin-top: 0.4rem; max-width: 16ch; }

  /* ── WHAT ── */
  .band-what { background: var(--surface-primary); }
  :global(.what-lead) { margin-top: 1.5rem; }
  :global(.serif-note em) { font-family: var(--font-serif); font-style: italic; color: var(--ink-primary); }
  .split-cards { display: grid; gap: 1rem; margin-top: 3rem; align-items: center; }
  @media (min-width: 820px) { .split-cards { grid-template-columns: 1fr auto 1fr; } }
  .split-card { border: 1px solid var(--line-subtle); border-radius: 16px; padding: 1.75rem; background: var(--surface-secondary); }
  .split-card--engine { background: var(--surface-inverse); color: var(--ink-inverse); border-color: transparent; }
  .split-tag { font-family: var(--font-mono); font-size: 0.68rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--accent-primary); }
  .split-card--engine .split-tag { color: color-mix(in srgb, var(--color-adobe-red) 70%, #fff); }
  .split-card h3 { font-size: 1.5rem; margin: 0.35rem 0 1rem; }
  .split-card ul { list-style: none; display: flex; flex-direction: column; gap: 0.6rem; }
  .split-card li { position: relative; padding-left: 1.4rem; font-size: 0.95rem; color: var(--ink-secondary); }
  .split-card--engine li { color: color-mix(in srgb, var(--ink-inverse) 82%, transparent); }
  .split-card li::before { content: ""; position: absolute; left: 0; top: 0.6em; width: 0.5rem; height: 0.5rem; border-radius: 2px; background: var(--accent-primary); }
  .split-plus { font-size: 2rem; font-weight: 300; color: var(--ink-tertiary); text-align: center; }

  /* ── COSA RICEVE IL CLIENTE (dark) ──
     Fascia scura fra due chiare: la tassonomia e' la tesi della pagina, non una
     nota a margine, e il contrasto la stacca da «Cos'e'» senza spostare nulla. */
  .band-dlv { background: var(--surface-inverse); color: var(--ink-inverse); }
  .dlv-title { color: #fff; }
  :global(.dlv-lead) { color: var(--color-slate-300); margin-top: 1.2rem; max-width: 72ch; }
  .dlv-grid { display: grid; grid-template-columns: 1fr; gap: 1rem; margin-top: 3rem; }
  @media (min-width: 820px) { .dlv-grid { grid-template-columns: repeat(2, 1fr); } }
  .dlv-card { display: flex; flex-direction: column; height: 100%; padding: 1.6rem;
    border-radius: 16px; background: rgba(255,255,255,0.045); border: 1px solid rgba(255,255,255,0.12); }
  .dlv-badge { align-self: flex-start; font-family: var(--font-mono); font-size: 0.66rem; font-weight: 700;
    letter-spacing: 0.14em; text-transform: uppercase; color: #fff;
    background: color-mix(in srgb, var(--color-adobe-red) 62%, #000); padding: 3px 9px; border-radius: 999px; }
  .dlv-q { font-size: 1.35rem; color: #fff; margin: 0.8rem 0 1.1rem; letter-spacing: -0.01em; }
  .dlv-meta { display: flex; flex-direction: column; gap: 0.7rem; }
  .dlv-meta dt { font-family: var(--font-mono); font-size: 0.66rem; letter-spacing: 0.12em;
    text-transform: uppercase; color: var(--color-slate-400); margin-bottom: 0.15rem; }
  .dlv-meta dd { font-size: 0.95rem; color: var(--color-slate-300); }
  .dlv-path { margin-top: 1.1rem; padding-top: 1rem; border-top: 1px solid rgba(255,255,255,0.1);
    font-family: var(--font-mono); font-size: 0.72rem; line-height: 1.7; color: var(--color-slate-400); }
  .dlv-foot { margin-top: 2rem; }
  .dlv-spread { list-style: none; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .dlv-spread li { display: inline-flex; align-items: baseline; gap: 0.4rem; font-size: 0.8rem;
    color: var(--color-slate-300); background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.1); border-radius: 999px; padding: 0.3rem 0.7rem; }
  .dlv-sp-n { font-family: var(--font-display); font-weight: 800; font-size: 0.95rem; color: #fff; }
  .dlv-note { margin-top: 1.1rem; font-size: 0.9rem; line-height: 1.6; color: var(--color-slate-300); max-width: 76ch; }

  /* ── WHY ── */
  .band-why { background: var(--surface-secondary); }
  .value-grid { display: grid; grid-template-columns: 1fr; gap: 1rem; margin-top: 3rem; }
  /* Quattro valori brevi: 2x2 fino al desktop, una riga sola da 1240 in su.
     Mai tre colonne con quattro card, che lascerebbero un avanzo in fondo. */
  @media (min-width: 640px) { .value-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1240px) { .value-grid { grid-template-columns: repeat(4, 1fr); } }
  .value-grid { grid-auto-rows: 1fr; }
  .value-card { background: var(--surface-primary); border: 1px solid var(--line-subtle); border-radius: 16px; padding: 1.6rem; transition: transform 0.2s, box-shadow 0.2s; }
  .value-card:hover { transform: translateY(-3px); box-shadow: 0 18px 40px -24px rgba(22,22,26,0.4); }
  .value-n { font-family: var(--font-mono); font-size: 0.8rem; font-weight: 600; color: var(--color-adobe-red-dark); letter-spacing: 0.1em; }
  .value-title { font-size: 1.2rem; margin: 0.6rem 0 0.7rem; }
  :global(.value-body) { font-size: 0.94rem; color: var(--ink-secondary); }
  /* I due gate: una coppia, non due card fra sei. Testo lungo per costruzione,
     quindi due colonne larghe invece di una griglia di riquadri brevi. */
  .gate-pair { display: grid; grid-template-columns: 1fr; gap: 1rem; margin-top: 1rem; grid-auto-rows: 1fr; }
  @media (min-width: 900px) { .gate-pair { grid-template-columns: repeat(2, 1fr); } }
  .gate-card { height: 100%; padding: 1.75rem; border-radius: 16px; background: var(--surface-primary);
    border: 1px solid var(--line-default); border-top: 3px solid var(--accent-primary); }
  .gate-tag { font-family: var(--font-mono); font-size: 0.7rem; font-weight: 700; letter-spacing: 0.16em;
    text-transform: uppercase; color: var(--color-adobe-red-dark); }
  .gate-title { font-size: 1.25rem; margin: 0.5rem 0 0.8rem; letter-spacing: -0.01em; }
  :global(.gate-body) { font-size: 0.94rem; line-height: 1.6; color: var(--ink-secondary); }
  .why-note { margin-top: 2rem; padding: 1.25rem 1.5rem; border-radius: 14px;
    background: var(--surface-inverse); color: var(--ink-inverse); }
  .why-note-tag { font-family: var(--font-mono); font-size: 0.68rem; font-weight: 600; letter-spacing: 0.18em;
    text-transform: uppercase; color: color-mix(in srgb, var(--color-adobe-red) 72%, #fff); }
  .why-note-text { margin-top: 0.6rem; font-size: 0.92rem; line-height: 1.65; max-width: 78ch;
    color: color-mix(in srgb, var(--ink-inverse) 88%, transparent); }

  /* ── PROOF (dark) ── */
  .band-proof { background: var(--surface-inverse); color: var(--ink-inverse); }
  .eyebrow--dark { color: color-mix(in srgb, var(--color-adobe-red) 72%, #fff); }
  .proof-title { color: #fff; }
  :global(.proof-lead) { color: var(--color-slate-300); margin-top: 1.2rem; }
  /* La griglia delle experience non può avere colonne fisse: quante card sono
     visibili lo decide la Console a runtime (toggle di pubblicazione), quindi
     qualunque numero fisso prima o poi lascia una riga orfana — con cinque card
     dava 4+1 su desktop e 2+2+1 su tablet.
     Due mosse: il numero di colonne lo sceglie uno script in base alle card
     DAVVERO visibili (evitando sempre di lasciarne una sola in ultima riga), e
     il flex con `justify-content: center` centra comunque il resto. Così ogni
     conteggio, a ogni viewport, legge come una scelta e non come un avanzo. */
  .exp-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: stretch;
    gap: 1.25rem;
    margin-top: 3rem;
    --exp-cols: 1;
  }
  .exp-grid > :global(.exp-card) {
    flex: 0 1 calc((100% - (var(--exp-cols) - 1) * 1.25rem) / var(--exp-cols));
    min-width: 0;
  }
  /* Symmetric at every breakpoint: 2×2 on tablet/laptop, one 4-across row on wide. */
  @media (min-width: 720px)  { .exp-grid { --exp-cols: 2; } }
  @media (min-width: 940px)  { .exp-grid { --exp-cols: 3; } }
  @media (min-width: 1240px) { .exp-grid { --exp-cols: 4; } }
  :global(.exp-card) { display: flex; flex-direction: column; border-radius: 18px; overflow: hidden; background: var(--color-ink-800); border: 1px solid rgba(255,255,255,0.08); transition: transform 0.2s, border-color 0.2s; }
  :global(.exp-card:hover) { transform: translateY(-4px); border-color: color-mix(in srgb, var(--exp-accent) 60%, transparent); }
  :global(.exp-visual) { position: relative; aspect-ratio: 16 / 10; overflow: hidden; background: #101014; }
  /* Card costruita a runtime dallo stato remoto: non ha screenshot (vive nel
     bundle statico), quindi la superficie porta solo il colore e i chip. */
  :global(.exp-card--remote .exp-visual) { background: linear-gradient(135deg, #16161B, #0E0E12); }
  :global(.exp-shot) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: top center; transition: transform 0.5s cubic-bezier(.2,.7,.2,1); }
  :global(.exp-card:hover .exp-shot) { transform: scale(1.045); }
  :global(.exp-visual::after) { content: ""; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(16,16,20,0) 55%, rgba(16,16,20,0.55) 100%); }
  :global(.exp-chip) { position: absolute; top: 0.9rem; left: 0.9rem; z-index: 1; font-family: var(--font-mono); font-size: 0.68rem; letter-spacing: 0.12em; text-transform: uppercase; color: #fff; background: rgba(0,0,0,0.42); border: 1px solid rgba(255,255,255,0.24); padding: 0.25rem 0.6rem; border-radius: 999px; backdrop-filter: blur(4px); }
  :global(.exp-live) { position: absolute; top: 0.9rem; right: 0.9rem; z-index: 1; display: inline-flex; align-items: center; gap: 0.35rem; font-family: var(--font-mono); font-size: 0.6rem; font-weight: 700; letter-spacing: 0.14em; color: #fff; background: rgba(0,0,0,0.42); border: 1px solid rgba(255,255,255,0.24); padding: 0.22rem 0.55rem; border-radius: 999px; backdrop-filter: blur(4px); }
  :global(.exp-live-dot) { width: 0.42rem; height: 0.42rem; border-radius: 50%; background: #33D17A; box-shadow: 0 0 0 0 rgba(51,209,122,0.7); animation: livePulse 2s infinite; }
  @keyframes livePulse { 0% { box-shadow: 0 0 0 0 rgba(51,209,122,0.6); } 70% { box-shadow: 0 0 0 6px rgba(51,209,122,0); } 100% { box-shadow: 0 0 0 0 rgba(51,209,122,0); } }
  @media (prefers-reduced-motion: reduce) { :global(.exp-live-dot) { animation: none; } :global(.exp-card:hover .exp-shot) { transform: none; } }
  :global(.exp-body) { padding: 1.4rem; display: flex; flex-direction: column; gap: 0.5rem; flex: 1; }
  :global(.exp-name) { font-size: 1.35rem; color: #fff; }
  :global(.exp-type) { display:inline-block; font-family: var(--font-mono); font-size: 0.66rem; letter-spacing: 0.12em; text-transform: uppercase; color: #fff; background: color-mix(in srgb, var(--exp-accent) 55%, #000); padding: 2px 8px; border-radius: 999px; margin-bottom: 0.45rem; }
  :global(.exp-tag) { font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.04em; color: color-mix(in srgb, var(--exp-accent) 60%, #fff); }
  :global(.exp-desc) { font-size: 0.9rem; color: var(--color-slate-300); flex: 1; }
  :global(.exp-open) { margin-top: 0.4rem; font-weight: 600; font-size: 0.9rem; color: #fff; }
  /* Quattro righe asciutte, non un blocco: etichetta → fatto, niente prosa.
     Sostituiscono «Dove vive, chi la vede» (rimosso il 2 ott), che il panel del
     3 ott chiedeva all'unanimità di riportare in forma leggera. */
  .proof-terms { display: grid; grid-template-columns: 1fr; gap: 0.7rem 2rem; margin-top: 1.6rem;
    padding-top: 1.3rem; border-top: 1px solid rgba(255,255,255,0.14); }
  @media (min-width: 760px) { .proof-terms { grid-template-columns: repeat(2, 1fr); } }
  .proof-terms dt { font-family: var(--font-mono); font-size: 0.66rem; letter-spacing: 0.12em;
    text-transform: uppercase; color: var(--color-slate-400); margin-bottom: 0.15rem; }
  .proof-terms dd { font-size: 0.9rem; line-height: 1.55; color: var(--color-slate-300); }
  :global(.proof-note) { margin-top: 0.9rem; font-size: 0.92rem; color: var(--color-slate-300); max-width: 72ch; }
  :global(.proof-scope) { margin-top: 1.5rem; font-size: 0.92rem; color: var(--color-slate-300); max-width: 72ch; }

  .console-strip { display: flex; align-items: center; gap: 1rem; margin-top: 1.25rem; padding: 1.1rem 1.3rem; border-radius: 14px; background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.1); transition: border-color 0.2s, background 0.2s; }
  .console-strip:hover { border-color: rgba(255,255,255,0.25); background: rgba(255,255,255,0.07); }
  .console-ico { flex-shrink: 0; color: color-mix(in srgb, var(--color-adobe-red) 70%, #fff); }
  .console-text { flex: 1; }
  .console-title { font-family: var(--font-display); font-weight: 700; color: #fff; }
  :global(.console-desc) { font-size: 0.85rem; color: var(--color-slate-400); }
  .console-open { color: #fff; font-size: 1.1rem; }

  /* ── ARCHITECTURE ── */
  .band-arch { background: var(--surface-primary); }
  .arch-diagram { margin-top: 3rem; display: flex; flex-direction: column; gap: 0.85rem; }
  .arch-layer { border-radius: 16px; padding: 1.25rem; border: 1px solid var(--line-subtle); }
  .arch-top { display: grid; grid-template-columns: 1fr; gap: 0.85rem; border: none; padding: 0; }
  @media (min-width: 640px) { .arch-top { grid-template-columns: 2fr 1fr; } }
  .arch-box { border-radius: 14px; padding: 1.1rem 1.25rem; display: flex; flex-direction: column; gap: 0.15rem; }
  .arch-box--console { background: var(--grad-adobe); color: #fff; }
  .arch-box--backend { background: var(--surface-secondary); border: 1px solid var(--line-subtle); }
  .arch-kicker { font-family: var(--font-mono); font-size: 0.66rem; letter-spacing: 0.12em; text-transform: uppercase; opacity: 0.85; }
  .arch-box strong { font-size: 1.05rem; font-family: var(--font-display); }
  .arch-box em { font-style: normal; font-size: 0.8rem; opacity: 0.8; }
  .arch-skins { background: var(--surface-secondary); }
  .arch-layer-label, .arch-core-kicker { font-family: var(--font-mono); font-size: 0.66rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink-tertiary); }
  .arch-skins-row {
    display: flex; flex-wrap: wrap; justify-content: center; align-items: stretch;
    gap: 0.6rem; margin-top: 0.75rem; --exp-cols: 2;
  }
  .arch-skins-row > :global(.arch-skin) {
    flex: 0 1 calc((100% - (var(--exp-cols) - 1) * 0.6rem) / var(--exp-cols));
    min-width: 0;
  }
  @media (min-width: 720px) { .arch-skins-row { --exp-cols: 4; } }
  :global(.arch-skin) { background: var(--surface-primary); border: 1px solid var(--line-subtle); border-left: 3px solid var(--k, var(--accent-primary)); border-radius: 10px; padding: 0.7rem 0.85rem; display: flex; flex-direction: column; }
  :global(.arch-skin strong) { font-size: 0.95rem; }
  :global(.arch-skin span) { font-size: 0.72rem; color: var(--ink-tertiary); }
  :global(.arch-skin--next) { border-left-style: dashed; border-left-color: var(--ink-tertiary); opacity: 0.75; }
  .arch-core { background: var(--surface-inverse); color: var(--ink-inverse); border-color: transparent; text-align: center; padding: 1.75rem 1.25rem; }
  .arch-core-kicker { color: color-mix(in srgb, #fff 55%, transparent); }
  .arch-core-title { display: block; font-family: var(--font-display); font-size: 1.5rem; margin: 0.3rem 0 1rem; }
  /* La catena di build: è lo strato dove lavorano le API Adobe, fra il motore e
     le skin. Senza, il diagramma raccontava un'architettura a runtime e taceva
     il pezzo che produce metà di quello che si vede. */
  .arch-build { border-style: dashed; }
  .arch-build-cols { display: grid; grid-template-columns: 1fr; gap: 1rem 1.5rem; margin-top: 0.75rem; }
  @media (min-width: 820px) { .arch-build-cols { grid-template-columns: 1fr 1fr; } }
  .arch-build-col { display: flex; flex-direction: column; gap: 0.55rem; min-width: 0; }
  .arch-build-col-h { font-family: var(--font-mono); font-size: 0.7rem; font-weight: 700; letter-spacing: 0.12em;
    text-transform: uppercase; color: var(--ink-secondary); }
  .arch-build-step {
    display: flex; flex-direction: column; gap: 0.3rem;
    padding: 0.7rem 0.8rem; border-radius: 10px;
    background: color-mix(in srgb, var(--color-adobe-red) 6%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-adobe-red) 22%, transparent);
    text-align: left; min-width: 0;
  }
  .arch-build-step code {
    font-family: var(--font-mono); font-size: 0.72rem;
    color: var(--color-adobe-red-dark); overflow-wrap: anywhere;
  }
  /* Le API Adobe restano visivamente distinte dagli script della Factory: è il
     punto del P0 — non gonfiare il perimetro di cosa è Adobe nella catena. */
  .arch-build-step--api {
    background: color-mix(in srgb, var(--color-adobe-violet) 6%, transparent);
    border-color: color-mix(in srgb, var(--color-adobe-violet) 24%, transparent);
  }
  .arch-build-step--api code { color: var(--color-adobe-violet-dark); }
  .arch-build-step span { font-size: 0.8rem; line-height: 1.45; color: var(--ink-secondary); }
  .arch-build-out {
    display: block; margin-top: 0.7rem; text-align: center;
    font-family: var(--font-mono); font-size: 0.7rem; color: var(--ink-tertiary);
  }
  .arch-core-chips { display: flex; flex-wrap: wrap; gap: 0.5rem; justify-content: center; }
  .arch-core-chips span { font-size: 0.8rem; padding: 0.35rem 0.8rem; border-radius: 999px; background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.14); }
  .arch-deliver { text-align: center; display: flex; flex-direction: column; align-items: center; gap: 0.1rem; }
  .arch-arrow { color: var(--ink-tertiary); font-size: 1.1rem; }
  .arch-deliver-label { font-family: var(--font-mono); font-size: 0.74rem; color: var(--ink-tertiary); }
  .arch-cta { margin-top: 2.5rem; display: flex; flex-wrap: wrap; gap: 1.25rem 2rem; align-items: center; justify-content: space-between; padding: 1.75rem; border-radius: 16px; background: var(--surface-secondary); border: 1px solid var(--line-subtle); }
  .arch-cta-title { font-size: 1.25rem; }
  :global(.arch-cta-desc) { font-size: 0.9rem; color: var(--ink-secondary); max-width: 52ch; margin-top: 0.35rem; }

  /* ── TABELLE (tempi reali, risultati sul business) ── */
  .band-results { background: var(--surface-secondary); }
  .tbl-scroll { margin-top: 2rem; max-width: 100%; overflow-x: auto; border: 1px solid var(--line-subtle); border-radius: 12px; background: var(--surface-primary); }
  .tbl-scroll--flow { margin-top: 1rem; }
  .tbl { width: 100%; border-collapse: collapse; font-size: 0.9rem; min-width: 46rem; }
  .tbl--compact { min-width: 40rem; font-size: 0.86rem; }
  .tbl th, .tbl td { text-align: left; padding: 0.7rem 0.9rem; border-bottom: 1px solid var(--line-subtle); vertical-align: top; }
  .tbl thead th { font-family: var(--font-mono); font-size: 0.68rem; letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--ink-tertiary); background: var(--surface-secondary); white-space: nowrap; }
  .tbl tbody th { font-weight: 600; color: var(--ink-primary); }
  .tbl tbody td { color: var(--ink-secondary); }
  .tbl tbody tr:last-child th, .tbl tbody tr:last-child td { border-bottom: none; }
  .tbl-foot { margin-top: 0.9rem; font-size: 0.85rem; color: var(--ink-tertiary); max-width: 70ch; }
