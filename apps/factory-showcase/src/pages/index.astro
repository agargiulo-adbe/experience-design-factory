---
import BaseLayout from '../layouts/BaseLayout.astro';
import { href as buildHref } from '@edf/core/utils/url.js';
import T from '@edf/core/blocks/i18n/T.astro';
import { EXPERIENCES, DEFAULT_PUBLISHED, EXPERIENCE_COUNT, RESERVED_COUNT, spellCount } from '../data/experiences';
import { EXPERIENCE_TYPES, EXPERIENCE_TYPE_IDS } from '@edf/core/data/experienceTypes';
import * as LH from '../data/lighthouse';
import out01 from '../assets/apis/out-01.webp';
import out02 from '../assets/apis/out-02.webp';
import out03 from '../assets/apis/out-03.webp';
import out04 from '../assets/apis/out-04.webp';
import out05 from '../assets/apis/out-05.webp';
import out06 from '../assets/apis/out-06.webp';

const base = import.meta.env.BASE_URL;
const b = base.replace(/\/?$/, '/');
const blueprint = buildHref(base, '/blueprint');
const TEAMS_URL = 'https://teams.microsoft.com/l/chat/0/0?users=agargiulo@adobe.com';
const SKILL_URL = 'https://github.com/agargiulo-adbe/experience-design-factory/tree/main/skills/experience-brief';
const SKILL_ZIP = `${b}skill/experience-brief-skill.zip`;
const SKILL_MD = `${b}skill/experience-brief-SKILL.md`;
// Seconda skill condivisibile: il panel review. Stessa forma della prima —
// cartella versionata nel repo, zip servito dalla vetrina, istruzioni in chiaro.
const PANEL_URL = 'https://github.com/agargiulo-adbe/experience-design-factory/tree/main/skills/panel-review';
const PANEL_ZIP = `${b}skill/panel-review-skill.zip`;
const PANEL_MD = `${b}skill/panel-review-SKILL.md`;

// The entire site derives from the central EXPERIENCES module — add an entry
// there and the hero stats, prose counts, proof grid and architecture diagram
// all update automatically. LIVE URL lives on each entry; shots are resolved
// against the app base here.
const LIVE = 'https://agargiulo-adbe.github.io/experience-design-factory';
// Stato di pubblicazione: lo decide il toggle in Super Admin, non questo file.
// Senza chiavi o senza risposta la pagina resta sul set di default (fail-closed).
const SUPABASE_URL = import.meta.env.PUBLIC_SUPABASE_URL ?? '';
const SUPABASE_ANON_KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY ?? '';
// Solo il set di default finisce nel markup. Le experience nate da materiale
// riservato non compaiono nel DOM di questa pagina pubblica: se la Console le
// pubblica, la card viene costruita a runtime dai dati del backend.
const experiences = DEFAULT_PUBLISHED.map((e) => ({
  ...e,
  href: e.url,
  shot: `${b}${e.shot}`,
}));
const reservedWords = spellCount(RESERVED_COUNT);
// Il registry intero, pubblicate più non pubblicate: l'eroe dice entrambe le
// cifre, così «6» e «undici» non si leggono come un conteggio in conflitto.
const PORTFOLIO_COUNT = EXPERIENCE_COUNT + RESERVED_COUNT;
// Le non pubblicate non sono tutte uguali: alcune nascono da materiale di
// preparazione riservato, altre sono interne alla Factory e non hanno un
// cliente. Qui servono solo i due conteggi: i nomi restano fuori dal markup.
const INTERNAL_OFF_COUNT = EXPERIENCES.filter((e) => !e.defaultPublished && e.type === 'interno').length;
const CONFIDENTIAL_OFF_COUNT = RESERVED_COUNT - INTERNAL_OFF_COUNT;
// Perimetro dichiarato del registro dei risultati: le experience cliente, non
// quelle interne, che non hanno nessuno a cui presentarsi.
const INTERNAL_TOTAL = EXPERIENCES.filter((e) => e.type === 'interno').length;
const CLIENT_TOTAL = EXPERIENCES.length - INTERNAL_TOTAL;
const clientWords = spellCount(CLIENT_TOTAL);
const internalWords2 = spellCount(INTERNAL_TOTAL);
const confidentialWords = spellCount(CONFIDENTIAL_OFF_COUNT);
const internalWords = spellCount(INTERNAL_OFF_COUNT);
// Spelled-out portfolio count for prose ("Four" / "Quattro"), derived from data.
const countWords = spellCount(EXPERIENCE_COUNT);

// ── La tassonomia dei deliverable (decisa il 1 ott 2026) ────────────────
// Quattro tipi rivolti al cliente, nominati per la domanda a cui rispondono,
// piu' il tipo interno. Unica fonte: packages/core/src/data/experienceTypes.ts
// — la stessa mappa che rende la riga di copertina di ogni deck, i badge di hub
// e console, e lo scheletro di capitoli da cui parte `pnpm new:experience`.
// Qui non si riscrive nulla a mano: se un tipo cambia, cambia da li'.
const clientTypes = (['prospettiva', 'storia', 'blueprint', 'playbook'] as const).map(
  (id) => EXPERIENCE_TYPES[id],
);
// Le etichette dei tipi servono anche allo script che costruisce a runtime la
// card di una experience pubblicata dalla Console: e' un dato della tassonomia,
// non del cliente, quindi puo' stare nel markup di una pagina pubblica.
const TYPE_LABELS = Object.fromEntries(
  EXPERIENCE_TYPE_IDS.map((id) => [id, EXPERIENCE_TYPES[id].label]),
);
// Come il registry si distribuisce sui tipi: il conteggio esce dai dati, cosi'
// non puo' smentire le card della prova qui sotto.
const typeSpread = EXPERIENCE_TYPE_IDS.map((id) => ({
  id,
  label: EXPERIENCE_TYPES[id].label,
  n: EXPERIENCES.filter((e) => e.type === id).length,
}));

const values = [
  {
    n: '01',
    titleEn: 'No rebuilding, ever', titleIt: 'Mai più da zero',
    bodyEn: 'A brand-perfect, accessible experience is a skin over a shared core, not a rebuild. Once the thinking is done the engine assembles the skin from one command, so the effort goes into strategy instead of scaffolding.',
    bodyIt: 'Un’esperienza on-brand e accessibile è una skin sopra un core condiviso, non una ricostruzione. Fatto il pensiero, il motore assembla la skin da un comando: l’impegno va alla strategia invece che all’impalcatura.',
  },
  {
    n: '02',
    titleEn: 'Improve once, everyone inherits', titleIt: 'Migliora una volta, tutti ereditano',
    bodyEn: 'The deck, the admin console, i18n, responsiveness — they live in one engine. Fix or enhance it once and every experience in the portfolio gets it, verified.',
    bodyIt: 'Il deck, la console admin, l’i18n, il responsive — vivono in un solo motore. Correggi o migliori una volta e ogni esperienza del portfolio lo riceve, verificato.',
  },
  {
    n: '03',
    titleEn: 'Reconfigurable at runtime', titleIt: 'Riconfigurabile a runtime',
    bodyEn: 'Toggle Adobe solutions on or off, attach demo media to any slide, author new on-brand slides — then share a link. Tailor a live demo per audience with no redeploy.',
    bodyIt: 'Attiva o disattiva le solution Adobe, allega media demo a ogni slide, crea nuove slide on-brand — poi condividi un link. Adatta una demo live per ogni pubblico senza redeploy.',
  },
  {
    n: '04',
    titleEn: 'Governed and multi-user', titleIt: 'Governato e multi-utente',
    bodyEn: 'A Super Admin Console with real authentication and per-experience roles sits on top — the system of record for who can configure what.',
    bodyIt: 'In cima c’è una Super Admin Console con autenticazione reale e ruoli per-esperienza — il sistema di riferimento su chi può configurare cosa.',
  },
];

// I due gate non sono due valori fra gli altri: sono una coppia, e rispondono a
// due domande diverse — la slide si vede? l'argomento regge? Stanno in un blocco
// a due colonne perche' la loro lunghezza affonderebbe una griglia di card brevi.
const gates = [
  {
    k: 'A',
    tagEn: 'It shows', tagIt: 'Si vede',
    titleEn: 'A DOM audit at three projection sizes', titleIt: 'Un audit DOM a tre risoluzioni di proiezione',
    bodyEn: `Twelve geometric and contrast checks on the real DOM, at 1920, 1440 and 1280: the hard ones must sit at zero, the soft ones are accepted on deliberately airy slides. It runs before publishing and it covers neither keyboard navigation nor a screen-reader pass, so it is a layout and contrast gate rather than a WCAG 2.2 AA certification. Lighthouse accessibility 100 on ${LH.A11Y_PERFECT} experiences, ${LH.A11Y_SHOWCASE} on this page, ${LH.A11Y_HUB} on the hub; best practices 100 everywhere. Performance sits between ${LH.PERF_MIN} and ${LH.PERF_MAX}: ${LH.PERF_LIST}. No page is above 90 — that is open work, not a detail. The numbers are the median of ${LH.RUNS} runs per page on the published site, measured ${LH.MISURATO_EN}, each with its own spread recorded (${LH.SPREAD_MIN} to ${LH.SPREAD_MAX} points): a single run on these pages swung by tens of points, and a series that flips on its own is not a measurement. The file is in the repository, with tool and conditions.`,
    bodyIt: `Dodici check geometrici e di contrasto sul DOM reale, a 1920, 1440 e 1280: quelli hard devono stare a zero, i soft sono accettati sulle slide volutamente ariose. Si lancia prima di pubblicare e non copre la navigazione da tastiera né un passaggio con screen reader, quindi è un gate di layout e contrasto e non una certificazione WCAG 2.2 AA. Accessibilità Lighthouse 100 su ${LH.A11Y_PERFECT} experience, ${LH.A11Y_SHOWCASE} su questa pagina, ${LH.A11Y_HUB} sull'hub; best practices 100 ovunque. La performance sta fra ${LH.PERF_MIN} e ${LH.PERF_MAX}: ${LH.PERF_LIST}. Nessuna pagina è sopra 90, ed è lavoro aperto, non un dettaglio. I numeri sono la mediana di ${LH.RUNS} giri per pagina sul sito pubblicato, misurati il ${LH.MISURATO_IT}, ognuno con la sua oscillazione registrata accanto (da ${LH.SPREAD_MIN} a ${LH.SPREAD_MAX} punti): un giro solo su queste pagine oscillava di decine di punti, e una serie che si ribalta da sé non è una misura. Il file sta nel repository, con strumento e condizioni.`,
  },
  {
    k: 'B',
    tagEn: 'It holds', tagIt: 'Regge',
    titleEn: 'The room’s objections, before the room', titleIt: 'Le obiezioni della stanza, prima della stanza',
    bodyEn: 'An audit proves a slide renders. It proves nothing about whether the people who receive it buy the argument. So before handover, isolated agents read the deliverable as the real stakeholders — portraits built from dated public sources, without the context of whoever wrote it — a fact-checker re-verifies every claim at its source, and an arbiter turns the verdicts into a P0/P1/P2 backlog with a list of things not to touch. Two rounds per review, not three: what survives the second is an open point for a person. When the content changes substantially the round starts again on the delta — this page is on its third, the Poste playbook too. It has run on two deliverables out of eleven; for the other nine it is open work, not a result.',
    bodyIt: 'Un audit prova che una slide si vede. Non dice niente su chi la riceve, né se l’argomento lo convince. Quindi prima della consegna agenti isolati leggono il deliverable come i veri interlocutori — ritratti costruiti da fonti pubbliche datate, senza il contesto di chi l’ha scritto — un fact-checker riverifica ogni affermazione alla sua fonte, e un arbitro trasforma i verdetti in un backlog P0/P1/P2 con la lista delle cose da non toccare. Due giri per revisione, non tre: quello che sopravvive al secondo resta un punto aperto per una persona. Quando il contenuto cambia in modo sostanziale il giro riparte sulla delta — questa pagina è al terzo, e anche il playbook di Poste. È girato su due deliverable su undici: per gli altri nove è lavoro aperto, non un risultato.',
  },
];
/**
 * Le API Adobe della catena di build, divise per quello che conta davvero a chi
 * legge: che cosa gira oggi dentro una experience e che cosa è disponibile ma
 * non è ancora in catena. La seconda lista è al futuro per scelta — scriverla al
 * presente è esattamente il claim che il panel ha rifiutato.
 * Le credenziali stanno sul `.env` di progetto: se una riga è qui, il token IMS
 * per quel servizio è stato verificato.
 */
const apisLive = [
  { fam: 'firefly', api: '/v3/images/generate',
    name: 'Firefly Image',
    en: 'Every backdrop and scene, described in a manifest next to the deck: prompt, negative prompt, seed, brand colours. 17 images on Isybank, 10 on UniCredit. The image call does not send an explicit model version yet, so the provenance records the gateway default on /v3 at generation time, not a version the API confirmed back.',
    it: 'Ogni sfondo e ogni scena, descritti in un manifest accanto al deck: prompt, negative prompt, seed, colori di marca. 17 immagini su Isybank, 10 su UniCredit. La chiamata immagini non invia ancora una versione di modello esplicita, quindi il provenance registra il default del gateway su /v3 al momento della generazione, non una versione confermata dall’API.' },
  { fam: 'firefly', api: '/v3/videos/generate',
    name: 'Firefly Video',
    en: 'Text-to-video clips for covers and closings — seven in the portfolio so far. Asynchronous: the call returns a job, the pipeline polls it, then re-cuts the clip so it loops without a visible jump.',
    it: 'Clip text-to-video per copertine e chiusure — sette in tutto il portfolio. Asincrona: la chiamata torna un job, la pipeline lo interroga, poi la clip viene rimontata perché giri senza stacco.' },
  { fam: 'auth', api: 'ims/token/v3 · client_credentials',
    name: 'Adobe IMS',
    en: 'Server-to-server auth. Credentials live in the build environment and never reach the browser or the repository; one token per run, reused across every call.',
    it: 'Autenticazione server-to-server. Le credenziali stanno nell\u2019ambiente di build e non arrivano mai al browser né al repository; un token per esecuzione, riusato su tutte le chiamate.' },
  { fam: 'cc', api: 'cutout · select subject',
    name: 'Remove Background',
    en: 'Used once, by hand, on the UniCredit persona portrait, so the subject sits on the brand surface instead of in a scene that belongs to someone else. Wiring it into the scripts is the next step.',
    it: 'Usata una volta, a mano, sul ritratto della persona UniCredit, perché il soggetto stia sulla superficie del brand invece che in una scena che non gli appartiene. Integrazione negli script: prossimo passo.' },
];
const apisAvailable = [
  { fam: 'cc', api: 'generative expand · select subject',
    name: 'Photoshop',
    en: 'Next step: generative expand to reframe one asset to every projection size without cropping the subject, and subject selection to derive the no-text zones the layout audit checks.',
    it: 'Prossimo passo: generative expand per riquadrare un asset a ogni formato di proiezione senza tagliare il soggetto, e selezione del soggetto per ricavare le zone senza testo che l\u2019audit verifica.' },
  { fam: 'cc', api: 'presets · auto-tone',
    name: 'Lightroom',
    en: 'Next step: one photographic grade applied across every image of an experience, so forty backdrops would read as one film instead of forty sources.',
    it: 'Prossimo passo: una sola viratura fotografica su tutte le immagini di un\u2019experience, così quaranta sfondi leggerebbero come una pellicola sola invece che come quaranta fonti.' },
  { fam: 'cc', api: '3D render · materials',
    name: 'Substance 3D',
    en: 'Next step: abstract objects whose materials carry the exact brand colours — imagery that could never be wrong-brand, at any resolution.',
    it: 'Prossimo passo: oggetti astratti con materiali nei colori esatti del brand — imagery che non potrebbe essere del brand sbagliato, a qualunque risoluzione.' },
  { fam: 'doc', api: 'data merge · rendition',
    name: 'InDesign',
    en: 'Next step: a leave-behind PDF generated from the same content model that feeds the deck. One source, two artifacts — none of it built yet.',
    it: 'Prossimo passo: un PDF da lasciare, generato dallo stesso modello di contenuto che alimenta il deck. Una sorgente, due artefatti — ancora da costruire.' },
  { fam: 'doc', api: 'vector rendition · data merge',
    name: 'Illustrator',
    en: 'Next step: diagram and icon sets produced in the brand palette as SVG, instead of drawn by hand per experience.',
    it: 'Prossimo passo: diagrammi e set di icone prodotti nella palette del brand come SVG, invece che disegnati a mano per ogni experience.' },
];
const apiOutputs = [out01, out02, out03, out04, out05, out06];

---
<BaseLayout title="Home">
  <!-- ══ HERO ══ -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-bg" aria-hidden="true"></div>
    <div class="hero-grid" aria-hidden="true"></div>
    <div class="wrap hero-inner">
      <p class="eyebrow" data-reveal>Adobe · Experience Design</p>
      <h1 id="hero-title" class="h-display hero-title" data-reveal data-reveal-delay="1">
        <T en="One engine." it="Un solo motore." as="span" class="hero-line" />
        <T en="Every brand." it="Ogni brand." as="span" class="hero-line" />
        <T en="Any experience." it="Qualunque esperienza." as="span" class="hero-line hero-line--grad" />
      </h1>
      <T
        en="The Experience Design Factory turns brand-perfect, accessible, interactive Adobe experiences into something you assemble — not rebuild. A shared core, a skin per client, and a console to run them all."
        it="La Experience Design Factory trasforma esperienze Adobe on-brand, accessibili e interattive in qualcosa che assembli — non ricostruisci. Un core condiviso, una skin per cliente e una console per governarle tutte."
        as="p" class="lead hero-lead" data-reveal data-reveal-delay="2" />
      <div class="hero-cta" data-reveal data-reveal-delay="3">
        <a href="#proof" class="btn btn-primary">
          <T en="See it live" it="Guardalo dal vivo" />
          <span aria-hidden="true">→</span>
        </a>
        <a href="#skill" class="btn btn-ghost hero-skill-cta">
          <span class="hero-skill-dot" aria-hidden="true"></span>
          <T en="Get the skill" it="Ottieni la skill" />
        </a>
      </div>
      <a href={blueprint} class="hero-textlink" data-reveal data-reveal-delay="3">
        <T en="or read the architecture blueprint" it="o leggi il blueprint dell’architettura" /> <span aria-hidden="true">→</span>
      </a>
      <dl class="hero-stats" data-reveal data-reveal-delay="3">
        <div><dt><span data-count={String(EXPERIENCE_COUNT)} data-live-count>{EXPERIENCE_COUNT}</span></dt><dd><T en={`experiences published, ${PORTFOLIO_COUNT} in all`} it={`esperienze pubblicate, ${PORTFOLIO_COUNT} in tutto`} /></dd></div>
        <div><dt><span class="hero-stat-lt">&lt;</span>&nbsp;1<span class="hero-stat-u">h</span></dt><dd><T en="to scaffold the skin, from one command" it="per lo scaffold della skin, da un comando" /></dd></div>
        <div><dt><span data-count="12">12</span></dt><dd><a class="hero-stat-ref" href={`${blueprint}#deck`}><T en="layout & contrast checks, per slide" it="controlli di layout e contrasto, per slide" /></a></dd></div>
        <div><dt><span data-count="3">3</span></dt><dd><T en="languages — EN, IT, FR, already in production" it="lingue — EN, IT, FR, già in produzione" /></dd></div>
      </dl>
    </div>
  </section>

  <!-- ══ WHAT IT IS ══ -->
  <section id="what" class="section band-what" aria-labelledby="what-title">
    <div class="wrap">
      <p class="eyebrow" data-reveal><T en="What it is" it="Cos’è" /></p>
      <h2 id="what-title" class="h-section" data-reveal>
        <T en="A factory, not a folder of templates." it="Una fabbrica, non una cartella di template." />
      </h2>
      <T
        en="Every client Experience Design is a <em>skin</em> — design tokens, content, assets and configuration — laid over one shared engine. The engine owns the hard parts: the immersive keynote deck, the admin console, bilingual text, motion, the responsive behaviour and the quality gate. The skin owns what makes it unmistakably that brand."
        it="Ogni Experience Design cliente è una <em>skin</em> — design token, contenuti, asset e configurazione — stesa su un unico motore condiviso. Il motore possiede le parti difficili: il deck keynote immersivo, la console admin, il testo bilingue, il motion, il comportamento responsive e il controllo qualità. La skin possiede ciò che la rende inconfondibilmente quel brand."
        as="p" class="lead prose-max what-lead serif-note" data-reveal />

      <div class="split-cards">
        <article class="split-card split-card--engine" data-reveal>
          <span class="split-tag"><T en="The engine" it="Il motore" /></span>
          <h3><T en="Shared core" it="Core condiviso" /></h3>
          <ul role="list">
            <li><T en="Immersive keynote deck + presenter controls" it="Deck keynote immersivo + controlli presenter" /></li>
            <li><T en="Config-driven Admin Console" it="Admin Console guidata da configurazione" /></li>
            <li><T en="Bilingual i18n · motion · design-token contract" it="i18n bilingue · motion · contratto design-token" /></li>
            <li><T en="Responsive + fullscreen, phone → giant TV" it="Responsive + fullscreen, telefono → maxi-schermo" /></li>
          </ul>
        </article>
        <div class="split-plus" aria-hidden="true">+</div>
        <article class="split-card split-card--skin" data-reveal data-reveal-delay="1">
          <span class="split-tag"><T en="The skin" it="La skin" /></span>
          <h3><T en="Per client" it="Per cliente" /></h3>
          <ul role="list">
            <li><T en="Design tokens — colour, type, spacing" it="Design token — colore, tipografia, spaziatura" /></li>
            <li><T en="Real bilingual copy — never lorem" it="Copy bilingue reale — mai lorem" /></li>
            <li><T en="Curated, brand-safe imagery" it="Imagery curata e brand-safe" /></li>
            <li><T en="Section flow + solution configuration" it="Flusso sezioni + configurazione solution" /></li>
          </ul>
        </article>
      </div>
    </div>
  </section>

  <!-- ══ COSA RICEVE IL CLIENTE — la tassonomia ══
       Il tipo e' la prima cosa che il cliente legge in copertina. Qui non si
       riscrive niente a mano: etichetta, domanda, pubblico, passo successivo e
       scheletro dei capitoli arrivano da packages/core/src/data/experienceTypes.ts,
       la stessa mappa che rende la riga di copertina di ogni deck, i badge della
       prova qui sotto, quelli dell'hub e della console, e il generatore. Se un
       tipo cambia, cambia da li' e questa sezione lo segue. -->
  <section id="deliverables" class="section band-dlv" aria-labelledby="dlv-title">
    <div class="wrap">
      <p class="eyebrow eyebrow--dark" data-reveal><T en="What the client gets" it="Cosa riceve il cliente" /></p>
      <h2 id="dlv-title" class="h-section dlv-title" data-reveal>
        <T en="Four questions, four deliverables." it="Quattro domande, quattro artefatti." />
      </h2>
      <p class="lead dlv-lead" data-reveal>
        <T en="The type is the first thing on the cover, and it is named after the question it answers instead of after a format. It settles who is in the room, what the last slide asks for, and the chapter skeleton the generator starts from. There is no «demo» among the names: live software is a property of two of the four, not their title."
           it="Il tipo è la prima cosa in copertina, ed è nominato per la domanda a cui risponde invece che per un formato. Decide chi è in sala, che cosa chiede l’ultima slide e lo scheletro di capitoli da cui parte il generatore. Fra i nomi non c’è «demo»: il software dal vivo è una proprietà di due dei quattro, non il loro titolo." />
      </p>

      <div class="dlv-grid">
        {clientTypes.map((t, i) => (
          <article class="dlv-card" data-reveal data-reveal-delay={String((i % 3) as 0 | 1 | 2)}>
            <span class="dlv-badge"><T en={t.label.en} it={t.label.it} /></span>
            <h3 class="dlv-q"><T en={t.question.en} it={t.question.it} /></h3>
            <dl class="dlv-meta">
              <div>
                <dt><T en="In the room" it="In sala" /></dt>
                <dd><T en={t.audience.en} it={t.audience.it} /></dd>
              </div>
              <div>
                <dt><T en="It asks for" it="Chiede" /></dt>
                <dd><T en={t.nextStep.en} it={t.nextStep.it} /></dd>
              </div>
            </dl>
            <p class="dlv-path">
              <span data-lang-en>{t.skeleton.map((c) => c.title.en).join(' → ')}</span>
              <span data-lang-it>{t.skeleton.map((c) => c.title.it).join(' → ')}</span>
            </p>
          </article>
        ))}
      </div>

      <div class="dlv-foot" data-reveal>
        <ul class="dlv-spread" role="list">
          {typeSpread.map((t) => (
            <li><span class="dlv-sp-n">{t.n}</span> <T en={t.label.en} it={t.label.it} /></li>
          ))}
        </ul>
        <p class="dlv-note">
          <T en="A fifth type, Internal, covers what has no client to present to: the Factory’s own deck and the email observatory. This showcase is not in the registry at all, so it is in none of the counts. A hybrid is registered under the type where the client decides — the Ferrari one opens as a perspective and closes as a blueprint, so it counts as a blueprint. The taxonomy was set on 1 October 2026: the eleven experiences in the registry were classified onto it afterwards, not born from it, and the first one generated from a skeleton is still to come."
             it="Un quinto tipo, Interno, copre ciò che non ha un cliente a cui presentarsi: il deck della Factory e l’osservatorio sulle email. Questa vetrina nel registry non c’è, quindi non sta in nessuno dei conteggi. Un ibrido si registra sotto il tipo dove il cliente decide — quella Ferrari apre da prospettiva e chiude da blueprint, quindi conta come blueprint. La tassonomia è del 1 ottobre 2026: le undici experience del registry ci sono state classificate dopo, non ci sono nate, e la prima generata da uno scheletro deve ancora arrivare." />
        </p>
      </div>
    </div>
