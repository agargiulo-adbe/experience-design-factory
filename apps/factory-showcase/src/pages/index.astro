      radial-gradient(55% 50% at 78% 12%, color-mix(in srgb, var(--color-adobe-red) 26%, transparent), transparent 68%),
      radial-gradient(50% 48% at 14% 92%, color-mix(in srgb, var(--color-adobe-violet) 20%, transparent), transparent 70%),
      radial-gradient(42% 42% at 52% 40%, color-mix(in srgb, var(--color-adobe-magenta) 12%, transparent), transparent 72%);
    animation: heroDrift 22s ease-in-out infinite alternate; will-change: transform; }
  @keyframes heroDrift {
    0% { transform: translate3d(-2%, -1%, 0) scale(1); }
    100% { transform: translate3d(3%, 2%, 0) scale(1.08); }
