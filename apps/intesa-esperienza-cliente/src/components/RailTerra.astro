---
/**
 * La rail di «Come si mette a terra»: dice a che punto si è, e sta al posto
 * dell'occhiello, così non costa altezza a slide già piene. È il segno che
 * si è usciti dalla storia di Giulia, che il team non vedeva
 * («sembra di essere ancora nella storia», Teams, 30 ott 2026).
 */
const PASSI = [
  { id: 'mappa', it: 'La vostra architettura', en: 'Your architecture' },
  { id: 'trovare', it: 'Farsi trovare', en: 'Being found' },
  { id: 'contenuto', it: 'Content Factory', en: 'Content factory' },
  { id: 'ingaggio', it: 'Uno per uno', en: 'One to one' },
  { id: 'casi', it: 'Casi d’uso', en: 'Use cases' },
  { id: 'giro', it: 'Il ritorno', en: 'The return' },
];
interface Props { attivo: string }
const { attivo } = Astro.props;
---
<ol class="im-rail" aria-label="Messa a terra">
  {PASSI.map((p) => (
    <li class="im-rail-i" data-on={p.id === attivo ? '' : null} aria-current={p.id === attivo ? 'step' : undefined}>
      <span data-lang-it>{p.it}</span><span data-lang-en>{p.en}</span>
    </li>
  ))}
</ol>
