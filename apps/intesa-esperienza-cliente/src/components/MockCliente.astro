---
/**
 * MockCliente — lo schermo di Giulia, in SEI chrome diversi.
 *
 * ⚠️ IL CHROME PORTA IL MESSAGGIO PIÙ IMPORTANTE DELLA STORIA.
 * Giulia è un prospect: non ha la vostra app, e quindi **l'app compare
 * solo all'ultimo momento**, quando ha firmato. Chi guarda la sequenza
 * lo capisce senza che nessuno glielo dica — e capisce anche perché nei
 * momenti prima potevate raggiungerla solo per posta.
 *
 *   assistente  telefono, nessun marchio di banca: non è un vostro canale
 *   feed        telefono, un post fra gli altri
 *   sito        finestra di browser con l'indirizzo in chiaro: è il vostro
 *               sito pubblico, dove entra chiunque, anche chi non è cliente
 *   posta       telefono, una mail: l'unico canale che avete di lei
 *   filiale     desktop, cornice da gestionale: il posto di lavoro di un
 *               vostro collega, non un canale del cliente
 *   app         telefono, testata verde — e solo dopo la firma
 *
 * Nessuna immagine: solo geometria e token, così scala con la radice e
 * resta nitido su una parete.
 *
 * ⚠️ Il marchio non è ricostruito: il nome sta in carattere display, come
 * il ripiego wordmark del co-brand. L'SVG ufficiale non lo abbiamo.
 *
 * La conversazione si RACCONTA, non spunta: ogni bolla è un
 * `[data-substep]` e il motore la rivela con ↓ o Spazio (stessa forma di
 * `MockCaso` su Trenitalia). Lo stato base è quello finale e leggibile,
 * così con «Riduci movimento» non parte niente e si legge lo stesso.
 */
import type { ChromeCliente } from '../data/momenti';
/* Il creativo è una foto VERA, licenziata. Un rettangolo di colore al suo
   posto negava l'argomento della slide: è la slide della Content Factory,
   e mostrare un riquadro vuoto dice «il contenuto non c'è». */
import creativoIg from '../assets/generated/post-torino.webp';
/* Il marchio ufficiale, lo stesso della firma co-brand. Nel mockup del
   sito serve a far capire in un istante DI CHI è la pagina: con una
   barra anonima e un indirizzo scritto piccolo, il System Design non
   dice niente e la slide perde il suo punto. */
import logo from '../assets/brand/intesa-sanpaolo.svg?raw';

interface Props {
  chrome: ChromeCliente;
  /** Quale schermata, dentro il chrome. */
  scena: 'ricerca' | 'feed' | 'simulazione' | 'documenti' | 'ripresa' | 'firma' | 'sportello';
  /** Taglia compatta: niente didascalia propria. Sulla slide doppia la
      cautela è una sola, a livello di slide: ripeterla due volte la
      trasforma in rumore e ruba due righe che servono al racconto. */
  compatto?: boolean;
  class?: string;
}
const { chrome, scena, class: className, compatto = false } = Astro.props;

const ORA: Record<string, string> = {
  ricerca: '21:40', feed: '08:12', simulazione: '21:48',
  documenti: '22:05', ripresa: '08:02', firma: '15:40', sportello: '11:30',
};
const telefono = chrome === 'assistente' || chrome === 'feed' || chrome === 'posta' || chrome === 'app';
---

<figure class:list={['im-cli', compatto && 'im-cli--compatto', `im-cli--${chrome}`, className]} data-chrome={chrome}>
  <div class="im-cli-corpo">

    {telefono && (
      <div class="im-cli-barra">
        <span>{ORA[scena]}</span>
        <span class="im-cli-segnale" aria-hidden="true"><i></i><i></i><i></i></span>
      </div>
    )}

    {chrome === 'app' && (
      <div class="im-cli-testa im-cli-testa--banca"><span class="im-cli-marchio">Intesa Sanpaolo</span></div>
    )}
    {chrome === 'assistente' && (
      <div class="im-cli-testa im-cli-testa--neutra"><span class="im-cli-neutro">Assistente · illustrativo</span></div>
    )}
    {/* Un feed si riconosce dalla FORMA — avatar, «sponsorizzato», le
        azioni sotto — non dal logo di una piattaforma, che non possiamo
        mettere: sarebbe la wrong-brand imagery che la Quality Bar vieta. */}
    {chrome === 'feed' && (
      <div class="im-ig-testa">
        <span class="im-ig-av" aria-hidden="true"><i>IS</i></span>
        <span class="im-cli-feed-chi">
          <span class="im-cli-feed-nome">intesasanpaolo</span>
          <span class="im-cli-feed-spo">Sponsorizzato</span>
        </span>
        <span class="im-ig-piu" aria-hidden="true"><i></i><i></i><i></i></span>
      </div>
    )}
    {chrome === 'sito' && (
      <>
        <div class="im-cli-testa im-cli-testa--url">
          <span class="im-cli-punti" aria-hidden="true"><i></i><i></i><i></i></span>
          <span class="im-cli-url"><span class="im-cli-lucchetto" aria-hidden="true"></span>intesasanpaolo.com/mutui</span>
        </div>
        <div class="im-cli-sito-testa">
          <span class="im-cli-sito-logo" set:html={logo} aria-label="Intesa Sanpaolo" role="img" />
          <span class="im-cli-sito-nav" aria-hidden="true"><i>Conti</i><i>Mutui</i><i>Investi</i></span>
        </div>
      </>
    )}
    {chrome === 'posta' && (
      <div class="im-em-da">
        <span class="im-em-av" aria-hidden="true">IS</span>
        <span class="im-em-chi"><strong>Intesa Sanpaolo</strong><span>a Giulia · 08:02</span></span>
        <svg class="im-em-az" viewBox="0 0 24 24" aria-hidden="true"><path d="M10 7 4 12l6 5M4 12h10a6 6 0 0 1 6 6" /></svg>
      </div>
    )}
    {chrome === 'filiale' && (
      <div class="im-cli-testa im-cli-testa--gest">
        <span class="im-cli-gest-tab" data-attivo>Scheda contatto</span>
        <span class="im-cli-gest-tab">Pratiche</span>
        <span class="im-cli-gest-tab">Appuntamenti</span>
      </div>
    )}

    <div class="im-cli-in">
      {scena === 'ricerca' && (
        <>
          <div class="im-cli-chat">
            <p class="im-cli-bolla im-cli-bolla--in" data-substep data-side="in">Qual è il mutuo migliore per chi compra la prima casa?</p>
            <p class="im-cli-bolla im-cli-bolla--out" data-substep data-side="out">Dipende da durata e tasso. Fra i fissi a 25 anni, tre banche hanno condizioni confrontabili:</p>
          </div>
          {/* La lista e la sua nota sono UN passo solo: una didascalia che
              resta appesa mentre la chat è ancora vuota sembra un guasto. */}
          <div class="im-cli-esito" data-substep data-side="out">
            <ul class="im-cli-citate">
              <li data-citata>Intesa Sanpaolo</li>
              <li>Seconda banca</li>
              <li>Terza banca</li>
            </ul>
            <p class="im-cli-nota">Le tre fonti che l’assistente ha trovato e saputo leggere.</p>
          </div>
        </>
      )}

      {scena === 'feed' && (
        <>
          {/* Il feed SCORRE: il post sale come se il dito avesse appena
              scrollato. Prima c'erano anche due post muti sopra e sotto,
              tolti perché un assoluto fuori dalla scatola allunga
              `scrollHeight` e il primo antenato che ritaglia diventa un
              contenitore che scorre — il check `k`, HARD in un deck. Un
              elemento decorativo non vale un gate rotto: il gesto lo
              porta il post vero, e la testata dice già che è un feed. */}
          {/* Si riconosce dalla FORMA di un post social: avatar con l'anello, immagine
              con il messaggio sopra, barra d'azione, cuore-commento-invio-salva. Il logo
              della piattaforma non si mette. La personalizzazione sta nella creatività. */}
          <div class="im-ig">
            <div class="im-ig-img" style={`background-image:url('${creativoIg.src}')`}>
              <p class="im-ig-chip">Mutuo prima casa</p>
              <p class="im-ig-t">Prima casa a Torino? Calcola la rata in 2 minuti.</p>
            </div>
            <p class="im-ig-cta"><span>Simula la rata</span><svg viewBox="0 0 8 14" aria-hidden="true"><path d="m1 1 6 6-6 6" /></svg></p>
            <div class="im-ig-az" aria-hidden="true">
              <svg viewBox="0 0 24 24"><path d="M12 20s-7.5-4.6-9.2-9.1C1.7 7.7 3.7 4.8 6.9 4.8c2.1 0 3.9 1.1 5.1 3 1.2-1.9 3-3 5.1-3 3.2 0 5.2 2.9 4.1 6.1C19.5 15.4 12 20 12 20Z" /></svg>
              <svg viewBox="0 0 24 24"><path d="M21 12a9 9 0 0 1-13.3 7.9L3 21l1.2-4.5A9 9 0 1 1 21 12Z" /></svg>
              <svg viewBox="0 0 24 24"><path d="M21.5 3 10.8 13.6M21.5 3l-6.7 18-4-7.4-7.3-4Z" /></svg>
              <svg class="im-ig-salva" viewBox="0 0 24 24"><path d="M6 3h12v18l-6-4.6L6 21Z" /></svg>
            </div>
            <p class="im-ig-info">Messaggio pubblicitario con finalità promozionale. Condizioni nei fogli informativi.</p>
          </div>
        </>
      )}

      {scena === 'simulazione' && (
        <>
          <p class="im-cli-occhiello">Simulazione mutuo · esempio illustrativo</p>
          <p class="im-cli-titolo">Prima casa · 25 anni</p>
          <div class="im-cli-cifra">
            {/* ⚠️ 180.000 € a 25 anni al 3,10% dà ~863 €/mese con la rata
                francese; 742 implicava l'1,76%, e un Controllo di Gestione
                lo vede a mente (fact-check del panel, 30 ott 2026). */}
            <span class="im-cli-cifra-n">863</span><span class="im-cli-cifra-u">€ al mese</span>
          </div>
          <dl class="im-cli-righe">
            <div><dt>Importo</dt><dd>180.000 €</dd></div>
            {/* ⚠️ Il TAEG accanto al TAN (panel, 11 nov 2026): una
                simulazione di mutuo senza TAEG non è quella che un sito di
                banca può mostrare. 3,23% è calcolato, non preso: TAN 3,10%,
                300 rate da 863 €, e 1.570 € di spese iniziali di esempio
                (istruttoria 800, perizia 320, imposta sostitutiva 0,25% =
                450). Illustrativo, e la riga sopra lo dice. */}
            <div><dt>TAN fisso · TAEG</dt><dd>3,10% · 3,23%</dd></div>
          </dl>
          <div class="im-cli-campo">
            <span class="im-cli-campo-l">Salva la simulazione</span>
            <span class="im-cli-campo-v">giulia.marchetti@…</span>
          </div>
          {/* Due consensi, due caselle: i cookie (dati il 12 nov, alla
              prima visita) e il ricontatto (adesso). Il mock ne mostrava
              uno solo, e il titolo parlava dell'altro (panel, 11 nov 2026). */}
          <p class="im-cli-consenso im-cli-consenso--cookie"><span class="im-cli-spunta" aria-hidden="true"></span>Consenso alla profilazione: dato il 12 nov</p>
          <p class="im-cli-consenso"><span class="im-cli-spunta" aria-hidden="true"></span>Acconsento a essere ricontattata via email</p>{/* copy-audit-ignore V1 — testo di un consenso NELL'interfaccia, non voce del deck. */}
        </>
      )}

      {scena === 'documenti' && (
        <>
          <p class="im-cli-occhiello">La tua simulazione</p>{/* copy-audit-ignore V1 — messaggio del sito ALLA persona. */}
          <p class="im-cli-titolo">Mancano i documenti</p>
          <ul class="im-cli-passi">
            <li data-stato="fatto">Dati anagrafici</li>
            <li data-stato="fatto">Immobile</li>
            <li data-stato="aperto">Ultime due buste paga</li>
            <li data-stato="attesa">Appuntamento</li>
          </ul>
          <p class="im-cli-nota">Caricali entro 30 giorni per non perdere la simulazione.</p>{/* copy-audit-ignore V1 — messaggio del sito ALLA persona. */}
        </>
      )}

      {scena === 'ripresa' && (
        <>
          <div class="im-em">
            <div class="im-em-banda"><span class="im-em-logo" set:html={logo} aria-label="Intesa Sanpaolo" role="img" /></div>
            <div class="im-em-corpo">
              <p class="im-em-t">Giulia, la tua simulazione ti aspetta</p>{/* copy-audit-ignore V1 — mail ALLA persona. */}
              <dl class="im-em-num">
                <div><dd>180.000 €</dd><dt>importo</dt></div>
                <div><dd>25 anni</dd><dt>durata</dt></div>
                <div data-on><dd>863 €</dd><dt>al mese</dt></div>
              </dl>
              <p class="im-em-manca"><i aria-hidden="true"></i>Manca solo la busta paga</p>
              <p class="im-em-cta">Riprendi la simulazione</p>
              <p class="im-em-app">Oppure in filiale: mercoledì 18, ore 11:30</p>
            </div>
          </div>
        </>
      )}

      {scena === 'firma' && (
        <>
          <p class="im-cli-occhiello">La tua pratica</p>{/* copy-audit-ignore V1 — messaggio dell'app ALLA persona. */}
          {/* ⚠️ «Mutuo erogato» in tre settimane non esiste: istruttoria,
              perizia, delibera, atto. Il settimo momento è la FIRMA DELLA
              RICHIESTA, firmata in filiale insieme all'apertura del conto:
              senza un rapporto aperto l'app non si usa (panel, 11 nov 2026).
              Le date: appuntamento mercoledì 18 nov, firma tre settimane
              dopo, mercoledì 9 dic, in orario di filiale. Non il 5 dic
              (un sabato) e non l'8 (Immacolata, filiali chiuse). */}
          <p class="im-cli-titolo">Richiesta firmata · conto aperto</p>
          <dl class="im-cli-righe">
            <div><dt>Rata</dt><dd>863 €/mese</dd></div>
            <div><dt>Durata</dt><dd>25 anni</dd></div>
            <div><dt>Firmata il</dt><dd>9 dic, in filiale</dd></div>
          </dl>
          <div class="im-cli-notifica">
            <p class="im-cli-notifica-t">Benvenuta</p>
            <p class="im-cli-notifica-b">Da oggi la pratica, l’istruttoria e i documenti sono qui.</p>{/* copy-audit-ignore V1 — messaggio dell'app ALLA persona. */}
          </div>
        </>
      )}

      {scena === 'sportello' && (
        <div class="im-cli-gest">
          <div class="im-cli-gest-col">
            <p class="im-cli-occhiello">Contatto</p>
            <p class="im-cli-gest-nome">Giulia Marchetti</p>
            <dl class="im-cli-righe">
              <div><dt>Rapporto</dt><dd>non ancora cliente</dd></div>
              <div><dt>Appuntamento</dt><dd>oggi, 11:30</dd></div>
              <div><dt>Motivo</dt><dd>mutuo prima casa</dd></div>
            </dl>
          </div>
          <div class="im-cli-gest-col">
            <p class="im-cli-occhiello">Già fatto da lei</p>
            <ul class="im-cli-passi">
              <li data-stato="fatto">Simulazione · 863 €/mese</li>
              <li data-stato="fatto">Documenti caricati</li>
              <li data-stato="aperto">Da firmare in sede</li>
            </ul>
            <p class="im-cli-nota">Lead, appuntamento e simulazione arrivano al CRM dal percorso, via API.</p>
          </div>
        </div>
      )}
    </div>
  </div>

  {!compatto && (<figcaption class="im-mock-cap">
    {chrome === 'assistente'
      ? 'Ricostruzione illustrativa di un assistente di terze parti: non è un vostro canale.'
      : chrome === 'feed'
        ? 'Ricostruzione illustrativa: il formato è della piattaforma, il contenuto è vostro.'
        : chrome === 'posta'
          ? 'Ricostruzione illustrativa: il messaggio è vostro, i numeri sono di esempio.'
          : 'Ricostruzione illustrativa: il sistema è vostro, i numeri sono di esempio.'}
  </figcaption>)}
</figure>

<style>
  /* I cookie erano già accettati alla prima visita: casella spuntata ma
     neutra, così si distingue dal consenso che arriva adesso. */
  .im-cli-consenso--cookie { margin-bottom: 0.28rem; }
  .im-cli-consenso--cookie .im-cli-spunta { background: var(--color-grey-600); }
</style>
