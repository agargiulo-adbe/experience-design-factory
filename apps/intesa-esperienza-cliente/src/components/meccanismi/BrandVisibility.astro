---
/**
 * ADOBE BRAND VISIBILITY, disegnata (20 nov 2026).
 *
 * Era una riga di quattro schede legate da «+» e «=». Ora l'equazione
 * diventa flusso: dati di mercato + segnali di casa vostra (i log del CDN)
 * stanno nella fascia dei segnali; al terzo passo il «=» si scioglie nei
 * nastri che portano entrambi alle ottimizzazioni al bordo, nella fascia
 * delle ottimizzazioni; al quarto, gli esiti misurabili. Un passo per pezzo.
 *
 * Contenuti: gli stessi delle schede, ridistribuiti (titolo sul disegno, la
 * frase nella didascalia, l'elenco dei CDN del log forwarding sotto il suo
 * nodo). Lo strato delle ottimizzazioni era rosso pieno: ora porta l'accento
 * verde del deck, l'unico che gli altri disegni usano.
 * Il bordo (panel del 20 nov 2026), verificato su Experience League «Optimize at
 * Edge» il 20 nov: la regola instrada al servizio solo gli user agent AI, i
 * visitatori restano sull'origine, e se Edge Optimize dà errore si ripiega
 * sull'origine (snippet di failover per Fastly, Apache, Azure Front Door).
 * ⚠️ L'EN di «Esiti misurabili» dice più dell'IT (settimanale, simulazioni
 * con Analytics): è così nella fonte di partenza, non l'ho toccato.
 */
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import T from '@edf/core/blocks/i18n/T.astro';

const PEZZI = [
  { k: 'mercato', t: { it: 'Dati di mercato', en: 'Market intelligence' },
    d: { it: 'Chi viene citato accanto a voi, sugli assistenti che il servizio copre: l’elenco si fissa all’avvio.', en: 'Who gets cited next to you, on the assistants the service covers: the list is set at kick-off.' } },
  { k: 'casa', t: { it: 'Segnali di casa vostra', en: 'Brand-owned signals' },
    d: { it: 'Il traffico degli agenti dai log del vostro CDN: escono indirizzo della pagina, user agent, esito, referrer, orario; nessun dato personale.', en: 'Agent traffic from your CDN logs: page address, user agent, status, referrer and time go out; no personal data.' } },
  { k: 'bordo', t: { it: 'Ottimizzazioni', en: 'Optimisations' },
    d: { it: 'I correttivi vanno al bordo del vostro CDN (Akamai, Cloudflare, CloudFront, Fastly, Azure Front Door o Apache) con una regola che approvate e spegnete voi: manda alla versione ottimizzata solo il traffico degli assistenti AI. Se il servizio Adobe dà errore, la pagina esce dall’origine com’è. Regione e retention dei log si fissano prima di attivarla.', en: 'Fixes ship at the edge of your CDN (Akamai, Cloudflare, CloudFront, Fastly, Azure Front Door or Apache) through a rule you approve and switch off: it sends only AI assistant traffic to the optimised version. If the Adobe service errors, the page is served from origin as is. Log region and retention are set before switching it on.' } },
  { k: 'esiti', t: { it: 'Esiti misurabili', en: 'Measurable outcomes' },
    d: { it: 'Il traffico che arriva dagli assistenti, separato dal referral, per pagina e per piattaforma. Per domanda si misurano le citazioni.', en: 'Sessions from assistants over total, by page and by platform, weekly; with Analytics connected, how many start a simulation. Per question, citations are what gets measured.' } },
];
const LOG = { it: 'Log forwarding: Akamai, Cloudflare, CloudFront, Fastly, Imperva.', en: 'Log forwarding: Akamai, Cloudflare, CloudFront, Fastly, Imperva.' };
---
<Slide id="slide-brand-visibility" bg="inverse" align="left" data-lettura-ritmo="3200">
  <div slot="backdrop" class="im-bg-notte"></div>
  <div class="im-ado-cap im-ado-cap--largo" data-reveal>
    <T as="h2" class="im-ado-t im-ado-t--stretto" it="Come si misura e si corregge il modo in cui comparite" en="How to measure and correct the way you show up" />
    <T as="p" class="im-ado-l" it="Prima si misura come comparite nelle risposte generate, poi si interviene." en="First you measure how you show up in generated answers, then you act." />
    {PEZZI.map((_, i) => <i class="mc-bv-passo" data-substep data-p={i + 1} aria-hidden="true"></i>)}
    <figure class="mc-bv">
      <div class="mc-bv-int" aria-hidden="true">
        <T as="span" data-strato="segnali" style="--x:1.5%" it="Strato dei segnali" en="Signal layer" />
        <T as="span" data-strato="ottimizzazioni" style="--x:45.5%" it="Strato delle ottimizzazioni" en="Optimisation layer" />
      </div>
      <div class="mc-bv-g" role="img" aria-label="Dati di mercato più i segnali dei log del vostro CDN, nello strato dei segnali, portano alle ottimizzazioni al bordo del CDN e da lì a esiti misurabili, nello strato delle ottimizzazioni">
        <div class="mc-bv-fascia" data-strato="segnali" style="--x0:0%;--x1:36%"></div>
        <div class="mc-bv-fascia" data-strato="ottimizzazioni" style="--x0:44%;--x1:100%"></div>
        <svg class="mc-bv-svg mc-bv-in" viewBox="0 0 1000 400" preserveAspectRatio="none" aria-hidden="true">
          <path d="M344 100 C 470 100, 470 182, 600 182" />
          <path d="M344 280 C 470 280, 470 228, 600 228" />
        </svg>
        <svg class="mc-bv-svg mc-bv-out" viewBox="0 0 1000 400" preserveAspectRatio="none" aria-hidden="true">
          <path d="M614 205 L 860 205" />
        </svg>
        <svg class="mc-bv-nodi" viewBox="0 0 1000 400" preserveAspectRatio="none" aria-hidden="true">
          <rect class="mc-bv-n" data-n="mercato" x="330" y="55" width="14" height="90" />
          <rect class="mc-bv-n" data-n="casa" x="330" y="235" width="14" height="90" />
          <rect class="mc-bv-n mc-bv-n--bordo" data-n="bordo" x="600" y="150" width="14" height="110" />
          <rect class="mc-bv-n mc-bv-n--esiti" data-n="esiti" x="860" y="160" width="14" height="90" />
        </svg>
        <T as="span" class="mc-bv-l mc-bv-l--sx" data-n="mercato" style="--x:31.4%;--y:25%" it={PEZZI[0].t.it} en={PEZZI[0].t.en} />
        <span class="mc-bv-l mc-bv-l--sx" data-n="casa" style="--x:31.4%;--y:70%">
          <T as="span" class="mc-bv-l-t" it={PEZZI[1].t.it} en={PEZZI[1].t.en} />
          <T as="span" class="mc-bv-l-nota" it={LOG.it} en={LOG.en} />
        </span>
        <span class="mc-bv-op" data-op="piu" style="--x:33.7%;--y:47.5%" aria-hidden="true">+</span>
        <span class="mc-bv-op" data-op="uguale" style="--x:40%;--y:51%" aria-hidden="true">=</span>
        <T as="span" class="mc-bv-l mc-bv-l--su" data-n="bordo" style="--x:60.7%;--y:37.5%" it={PEZZI[2].t.it} en={PEZZI[2].t.en} />
        <T as="span" class="mc-bv-l mc-bv-l--sotto mc-bv-l-nota" data-n="bordo" style="--x:60.7%;--y:67.5%" it="al bordo del vostro CDN" en="at the edge of your CDN" />
        <T as="span" class="mc-bv-l mc-bv-l--su" data-n="esiti" style="--x:86.7%;--y:40%" it={PEZZI[3].t.it} en={PEZZI[3].t.en} />
      </div>
    </figure>
    <div class="mc-bv-banda">
      <div class="mc-bv-didas">
        {PEZZI.map((p, i) => <p data-per={i + 1}><T as="strong" it={p.t.it} en={p.t.en} /> <T as="span" it={p.d.it} en={p.d.en} /></p>)}
      </div>
    </div>
    <p class="im-fonte-riga">
      <span data-lang-it>Regione e retention dei log restano da verificare con Adobe. Documentazione: </span><span data-lang-en>Log region and retention are still to be verified with Adobe. Documentation: </span>
      <a href="https://experienceleague.adobe.com/en/docs/brand-visibility/using/essentials/overview" target="_blank" rel="noopener">Adobe Brand Visibility</a><span> · </span>
      <a href="https://experienceleague.adobe.com/en/docs/brand-visibility/using/resources/optimize-at-edge/overview" target="_blank" rel="noopener">Optimize at Edge</a><span> · </span>
      <a href="https://experienceleague.adobe.com/en/docs/brand-visibility/using/log-forwarding/log-forwarding-overview" target="_blank" rel="noopener">log forwarding</a><span> · </span>
      <a href="https://experienceleague.adobe.com/en/docs/brand-visibility/using/dashboards/agentic-traffic" target="_blank" rel="noopener"><span data-lang-it>campi dei log</span><span data-lang-en>log fields</span></a>
    </p>
  </div>
</Slide>

<style is:global>
  .mc-bv { --mc-n: #b9e6a3; --mc-nastro: rgba(185, 230, 163, 0.32); --mc-acc: #6cc04a; --mc-ease: cubic-bezier(0.16, 1, 0.3, 1);
    position: relative; margin: clamp(0.4rem, calc(0.6 * var(--vu)), 1.2rem) 0 0; }
  .mc-bv-passo { position: absolute; width: 0; height: 0; overflow: hidden; }

  .mc-bv-int { position: relative; height: 1.6em; font-size: clamp(0.8rem, calc(0.74 * var(--vu)), 1.55rem); font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; }
  .mc-bv-int > span { position: absolute; left: var(--x); white-space: nowrap; transition: opacity 0.45s ease; }
  .mc-bv-int > [data-strato="segnali"] { color: #9fd68a; }
  .mc-bv-int > [data-strato="ottimizzazioni"] { color: var(--mc-acc); opacity: 0.4; }

  .mc-bv-g { position: relative; height: clamp(11rem, calc(14.5 * var(--vu)), 28rem); margin-top: clamp(0.4rem, calc(0.6 * var(--vu)), 1.2rem); }
  .mc-bv-svg, .mc-bv-nodi { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }

  /* Le due fasce: lo strato dei segnali e quello delle ottimizzazioni. */
  .mc-bv-fascia { position: absolute; top: 0; bottom: 0; left: var(--x0); right: calc(100% - var(--x1)); border-radius: 10px; transition: background-color 0.5s ease, border-color 0.5s ease; }
  .mc-bv-fascia[data-strato="segnali"] { background: rgba(185, 230, 163, 0.05); border: 1px solid rgba(185, 230, 163, 0.22); }
  .mc-bv-fascia[data-strato="ottimizzazioni"] { background: rgba(108, 192, 74, 0.03); border: 1px dashed rgba(108, 192, 74, 0.3); }

  /* I nastri: dalle due fonti alle ottimizzazioni, poi agli esiti. */
  .mc-bv-svg path { fill: none; stroke: var(--mc-nastro); stroke-width: 12; vector-effect: non-scaling-stroke; }
  .mc-bv-out path { stroke: var(--mc-n); stroke-width: 14; }
  .mc-bv-in { clip-path: inset(-5% 65.6% -5% -5%); transition: clip-path 1.2s var(--mc-ease); }
  .mc-bv-out { clip-path: inset(-5% 38.6% -5% -5%); transition: clip-path 1s var(--mc-ease); }

  /* I nodi e le etichette: spenti finché il loro passo non arriva. */
  .mc-bv-n { fill: var(--mc-n); opacity: 0.25; transition: opacity 0.45s ease; }
  .mc-bv-n--bordo { fill: var(--mc-acc); }
  .mc-bv-n--esiti { fill: #ffffff; }
  .mc-bv-l { position: absolute; left: var(--x); top: var(--y); font-size: clamp(0.92rem, calc(0.86 * var(--vu)), 1.85rem); font-weight: 700; line-height: 1.15; color: #ffffff; white-space: nowrap; opacity: 0.3; transition: opacity 0.45s ease; }
  .mc-bv-l--sx { translate: -100% -50%; text-align: right; }
  .mc-bv-l--su { translate: -50% calc(-100% - 0.35rem); text-align: center; }
  .mc-bv-l--sotto { translate: -50% 0.35rem; text-align: center; }
  span.mc-bv-l--sx { display: grid; justify-items: end; gap: 0.25rem; }
  .mc-bv-l-nota { font-size: clamp(0.8rem, calc(0.68 * var(--vu)), 1.5rem); font-weight: 500; color: #c9dcc2; white-space: normal; }
  .mc-bv-l--sx .mc-bv-l-nota { max-width: 26vw; width: max-content; }
  .mc-bv-op { position: absolute; left: var(--x); top: var(--y); translate: -50% -50%; font-size: clamp(1.6rem, calc(1.7 * var(--vu)), 3.4rem); font-weight: 300; line-height: 1; color: #9fd68a; transition: opacity 0.5s ease; }
  .mc-bv-op[data-op="uguale"] { opacity: 0.4; }

  /* Passo per passo. */
  #slide-brand-visibility:has(.mc-bv-passo[data-p="1"][data-substep-active]) :is(.mc-bv-n, .mc-bv-l)[data-n="mercato"],
  #slide-brand-visibility:has(.mc-bv-passo[data-p="2"][data-substep-active]) :is(.mc-bv-n, .mc-bv-l)[data-n="casa"],
  #slide-brand-visibility:has(.mc-bv-passo[data-p="3"][data-substep-active]) :is(.mc-bv-n, .mc-bv-l)[data-n="bordo"],
  #slide-brand-visibility:has(.mc-bv-passo[data-p="4"][data-substep-active]) :is(.mc-bv-n, .mc-bv-l)[data-n="esiti"] { opacity: 1; }
  #slide-brand-visibility:has(.mc-bv-passo[data-p="1"][data-substep-active]) .mc-bv-fascia[data-strato="segnali"] { background: rgba(185, 230, 163, 0.1); border-color: rgba(185, 230, 163, 0.45); }
  /* Il terzo passo: l'equazione diventa flusso. */
  #slide-brand-visibility:has(.mc-bv-passo[data-p="3"][data-substep-active]) .mc-bv-in { clip-path: inset(-5% 39.6% -5% -5%); }
  #slide-brand-visibility:has(.mc-bv-passo[data-p="3"][data-substep-active]) .mc-bv-op[data-op="uguale"] { opacity: 0; }
  #slide-brand-visibility:has(.mc-bv-passo[data-p="3"][data-substep-active]) .mc-bv-fascia[data-strato="ottimizzazioni"] { background: rgba(108, 192, 74, 0.12); border: 1px solid rgba(108, 192, 74, 0.55); }
  #slide-brand-visibility:has(.mc-bv-passo[data-p="3"][data-substep-active]) .mc-bv-int > [data-strato="ottimizzazioni"] { opacity: 1; }
  #slide-brand-visibility:has(.mc-bv-passo[data-p="4"][data-substep-active]) .mc-bv-out { clip-path: inset(-5% 13.8% -5% -5%); }

  /* La fascia sotto: una didascalia per passo. */
  .mc-bv-banda { margin: clamp(0.6rem, calc(0.9 * var(--vu)), 1.8rem) 0 0; padding: clamp(0.55rem, calc(0.75 * var(--vu)), 1.4rem) clamp(0.9rem, calc(1.2 * var(--vu)), 2.2rem);
    border: 1px solid rgba(185, 230, 163, 0.34); border-radius: 8px; background: rgba(185, 230, 163, 0.09);
    font-size: clamp(1.02rem, calc(1 * var(--vu)), 2.2rem); line-height: 1.38; color: #f2f8f0;
    opacity: 0; visibility: hidden; transition: opacity 0.5s ease, visibility 0s linear 0.5s; }
  .mc-bv-didas { display: grid; min-width: 0; }
  .mc-bv-didas > p { grid-area: 1 / 1; margin: 0; max-width: none; opacity: 0; visibility: hidden; transition: opacity 0.25s ease, visibility 0s linear 0.25s; }
  .mc-bv-didas strong { color: #b9e6a3; margin-right: 0.35em; }
  #slide-brand-visibility:has(.mc-bv-passo[data-p="1"][data-substep-active]) .mc-bv-banda { opacity: 1; visibility: visible; transition: opacity 0.5s ease, visibility 0s; }
  #slide-brand-visibility:has(.mc-bv-passo[data-p="1"][data-substep-active]):not(:has(.mc-bv-passo[data-p="2"][data-substep-active])) .mc-bv-didas > [data-per="1"],
  #slide-brand-visibility:has(.mc-bv-passo[data-p="2"][data-substep-active]):not(:has(.mc-bv-passo[data-p="3"][data-substep-active])) .mc-bv-didas > [data-per="2"],
  #slide-brand-visibility:has(.mc-bv-passo[data-p="3"][data-substep-active]):not(:has(.mc-bv-passo[data-p="4"][data-substep-active])) .mc-bv-didas > [data-per="3"],
  #slide-brand-visibility:has(.mc-bv-passo[data-p="4"][data-substep-active]) .mc-bv-didas > [data-per="4"] { opacity: 1; visibility: visible; transition: opacity 0.35s ease 0.1s, visibility 0s; }

  @media (prefers-reduced-motion: reduce) {
    .mc-bv-in, .mc-bv-out, .mc-bv-n, .mc-bv-l, .mc-bv-op, .mc-bv-fascia, .mc-bv-int > span, .mc-bv-banda, .mc-bv-didas > p { transition: none !important; }
  }
  @media (max-height: 820px) {
    .mc-bv-g { height: clamp(9.5rem, calc(12.5 * var(--vu)), 26rem); }
    .mc-bv-banda { margin-top: 0.45rem; padding-block: 0.45rem; }
  }
</style>
