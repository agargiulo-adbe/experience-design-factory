---
/**
 * LA FABBRICA DI CONTENUTI, disegnata (20 nov 2026). Era quattro schede con
 * una figura piccola: ora è UN disegno che si costruisce in quattro passi,
 * uno per fase — un brief entra (Pianificare), si moltiplica in dodici
 * varianti che nascono ognuna con la spunta del marchio (Produrre), le
 * varianti entrano nell'archivio (Gestire), escono sui canali e l'esito
 * torna al brief successivo: il giro si chiude (Attivare e misurare).
 *
 * Contenuto INVARIATO rispetto alla slide a schede: le quattro frasi delle
 * fasi stanno nelle didascalie dei passi, la fascia «Ogni variante nasce
 * già validata» è l'etichetta sotto la griglia e la sua frase lunga è nella
 * didascalia del passo 4. Le fonti sono quelle di prima.
 *
 * I quattro passi vengono dai sei pilastri del Content Supply Chain
 * Maturity Assessment di Adobe, raggruppati in quattro. ⚠️ Panel dell'11 nov
 * 2026: GenStudio controlla marchio, regole di piattaforma e accessibilità;
 * le informative restano nell'iter legale della banca. Non si scrive che le
 * varianti sono «verificate contro le informative».
 *
 * Grammatica delle slide «domanda» (`domande.css`): marcatori di passo
 * invisibili, nastri in un SVG 1000×400 non proporzionale, etichette HTML in
 * percentuale, UNA didascalia per passo. Il rosa è il colore del blocco
 * «contenuti» (`--blk-contenuto`), unico accento della slide, sulle cose
 * prodotte (varianti, archivio, canali); nastri e spunte nel verde chiaro
 * del deck, e il giro che si chiude in verde pieno tratteggiato.
 */
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import T from '@edf/core/blocks/i18n/T.astro';

const FASI = [
  { x: 10.3, it: 'Pianificare', en: 'Plan',
    d: { it: 'Un’iniziativa nasce con dentro le sue approvazioni.', en: 'An initiative is born with its approvals inside it.' } },
  { x: 42, it: 'Produrre', en: 'Produce',
    d: { it: 'Dodici varianti da un brief solo, ognuna già validata sul marchio.', en: 'Twelve variants from one brief, each already checked against the brand.' } },
  { x: 70.7, it: 'Gestire', en: 'Manage',
    d: { it: 'Si sa che cosa si può usare, dove e fino a quando.', en: 'You know what can be used, where and until when.' } },
  { x: 100, it: 'Attivare e misurare', en: 'Activate and measure',
    d: { it: 'Varianti per ogni canale e ogni città, già conformi alle regole di marchio e di canale. L’esito rientra nel brief successivo.', en: 'Variants for every channel and city, already compliant with brand and channel rules. The outcome feeds the next brief.' } },
];
/* Righe della griglia di varianti, in coordinate del viewBox (centri). */
const RIGHE = [63, 166, 269];
const VARIANTI = Array.from({ length: 12 }, (_, i) => i);
---
<Slide id="slide-content-factory" bg="inverse" align="left" data-lettura-ritmo="3200">
  <div slot="backdrop" class="im-bg-notte"></div>
  <div class="im-ado-cap im-ado-cap--largo" data-reveal>
    <T as="h2" class="im-ado-t im-ado-t--stretto" it="Quattro passi per produrre varianti controllate sul marchio" en="Four steps to produce brand-checked variants" />
    <T as="p" class="im-ado-l" it="Il tempo di un’iniziativa se ne va fra approvazioni e rifacimenti." en="Most of an initiative’s time goes into approvals and rework." />
    {FASI.map((_, i) => <i class="mc-cf-passo" data-substep data-p={i + 1} aria-hidden="true"></i>)}
    <figure class="mc-cf">
      <div class="mc-cf-int" aria-hidden="true">
        {FASI.map((f, i) => <T as="span" data-f={i + 1} class={i === FASI.length - 1 ? 'mc-cf-int-dx' : ''} style={`--x:${f.x}%`} it={f.it} en={f.en} />)}
      </div>
      <div class="mc-cf-g" role="img" aria-label="Un brief entra, si moltiplica in dodici varianti già validate sul marchio, le varianti passano dall'archivio ai canali, e l'esito torna al brief successivo">
        <svg class="mc-cf-svg" viewBox="0 0 1000 400" preserveAspectRatio="none" aria-hidden="true">
          <g class="mc-cf-a" data-f="2">
            {RIGHE.map((y, i) => <path d={`M110 ${160 + i * 40} C 205 ${160 + i * 40}, 205 ${y}, 300 ${y}`} />)}
          </g>
          <g class="mc-cf-a" data-f="3">
            {RIGHE.map((y, i) => <path d={`M540 ${y} C 620 ${y}, 620 ${170 + i * 30}, 700 ${170 + i * 30}`} />)}
          </g>
          <g class="mc-cf-a" data-f="4">
            {[125, 200, 275].map((y, i) => <path d={`M714 ${170 + i * 30} C 787 ${170 + i * 30}, 787 ${y}, 860 ${y}`} />)}
          </g>
        </svg>
        <svg class="mc-cf-giro" viewBox="0 0 1000 400" preserveAspectRatio="none" aria-hidden="true">
          <path d="M867 300 C 867 375, 850 392, 805 392 L 160 392 C 112 392, 103 370, 103 292" />
        </svg>
        <svg class="mc-cf-nodi" viewBox="0 0 1000 400" preserveAspectRatio="none" aria-hidden="true">
          <rect class="mc-cf-n mc-cf-n--brief" x="96" y="110" width="14" height="180" />
          <rect class="mc-cf-n mc-cf-n--arch" x="700" y="110" width="14" height="180" />
          {[100, 175, 250].map((y) => <rect class="mc-cf-n mc-cf-n--can" x="860" y={y} width="14" height="50" />)}
        </svg>
        <div class="mc-cf-var" aria-hidden="true">
          {VARIANTI.map((i) => (
            <span class="mc-cf-v" style={`--i:${i}`}>
              <svg class="mc-cf-ok" viewBox="0 0 20 20"><circle cx="10" cy="10" r="9" /><path d="M5.6 10.4 L8.6 13.2 L14.4 7" /></svg>
            </span>
          ))}
        </div>
        <T as="span" class="mc-cf-l mc-cf-l--su" data-f="1" style="--x:10.3%;--y:27.5%" it="Brief" en="Brief" />
        <T as="span" class="mc-cf-l mc-cf-l--tag" data-f="2" style="--x:42%;--y:82%" it="Ogni variante nasce già validata" en="Every variant is born already checked" />
        <T as="span" class="mc-cf-l mc-cf-l--su" data-f="3" style="--x:70.7%;--y:27.5%" it="Che cosa, dove, fino a quando" en="What, where, until when" />
        <T as="span" class="mc-cf-l mc-cf-l--dx" data-f="4" style="--x:88.4%;--y:50%" it="Ogni canale,<br>ogni città" en="Every channel,<br>every city" />
        <T as="span" class="mc-cf-l mc-cf-l--giro" style="--x:70%;--y:98%" it="L’esito rientra nel brief successivo" en="The outcome feeds the next brief" />
      </div>
    </figure>
    <div class="mc-cf-banda">
      <div class="mc-cf-didas">
        {FASI.map((f, i) => <p data-per={i + 1}><T as="strong" it={f.it} en={f.en} /> <T as="span" it={f.d.it} en={f.d.en} /></p>)}
      </div>
    </div>
    <p class="im-fonte-riga">
      <span data-lang-it>I quattro passi sono uno schema nostro. Il controllo sul marchio è documentato: </span><span data-lang-en>The four steps are our own framing. Brand checking is documented: </span>
      <a href="https://experienceleague.adobe.com/en/docs/genstudio-for-performance-marketing/user-guide/guidelines/brand-validation" target="_blank" rel="noopener">GenStudio for Performance Marketing · brand validation</a>
    </p>
  </div>
</Slide>

<style is:global>
  #slide-content-factory .mc-cf { --cf-c: var(--blk-contenuto, #d8559c); --cf-nastro: rgba(185, 230, 163, 0.32); --cf-ok: #b9e6a3;
    --cf-ease: cubic-bezier(0.16, 1, 0.3, 1);
    position: relative; margin: clamp(0.4rem, calc(0.6 * var(--vu)), 1.2rem) 0 0; }
  #slide-content-factory .mc-cf-passo { position: absolute; width: 0; height: 0; overflow: hidden; }

  /* Le quattro fasi come intestazioni di colonna; quella del passo in corso si accende. */
  #slide-content-factory .mc-cf-int { position: relative; height: 1.6em; font-size: clamp(0.8rem, calc(0.74 * var(--vu)), 1.55rem); font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: #c9dcc2; }
  #slide-content-factory .mc-cf-int > span { position: absolute; left: var(--x); translate: -50% 0; white-space: nowrap; transition: color 0.4s ease; }
  #slide-content-factory .mc-cf-int > .mc-cf-int-dx { translate: -100% 0; }

  #slide-content-factory .mc-cf-g { position: relative; height: clamp(11rem, calc(14.5 * var(--vu)), 28rem); margin-top: clamp(1.2rem, calc(1.6 * var(--vu)), 3rem); }
  #slide-content-factory :is(.mc-cf-svg, .mc-cf-nodi, .mc-cf-giro) { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }

  /* Nastri a spessore costante; ogni fascio si scopre da sinistra al suo passo. */
  #slide-content-factory .mc-cf-svg path { fill: none; stroke: var(--cf-nastro); stroke-width: 10; vector-effect: non-scaling-stroke; }
  #slide-content-factory .mc-cf-a { clip-path: inset(-5% 100% -5% -5%); transition: clip-path 1.1s var(--cf-ease); }

  /* Il giro che si chiude: tratteggio verde, si disegna da destra verso il brief. */
  #slide-content-factory .mc-cf-giro path { fill: none; stroke: var(--cf-ok); stroke-width: 3; stroke-dasharray: 7 7; vector-effect: non-scaling-stroke; }
  #slide-content-factory .mc-cf-giro { clip-path: inset(-5% -5% -5% 100%); transition: clip-path 1.4s var(--cf-ease) 0.6s; }

  #slide-content-factory .mc-cf-n { fill: var(--cf-c); opacity: 0.35; transition: opacity 0.45s ease, fill 0.45s ease; }
  #slide-content-factory .mc-cf-n--brief { fill: #ffffff; opacity: 0.5; }

  /* La griglia delle dodici varianti: caselle vuote prima, piene con la spunta poi. */
  #slide-content-factory .mc-cf-var { position: absolute; left: 30%; top: 3%; width: 24%; height: 77%;
    display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); grid-template-rows: repeat(3, minmax(0, 1fr)); gap: clamp(0.3rem, calc(0.4 * var(--vu)), 0.8rem); }
  #slide-content-factory .mc-cf-v { position: relative; border-radius: 4px; border: 1.5px dashed rgba(236, 130, 186, 0.6); background: transparent;
    transition: background-color 0.4s ease calc(var(--i) * 0.07s), border-color 0.4s ease calc(var(--i) * 0.07s); }
  #slide-content-factory .mc-cf-ok { position: absolute; right: 12%; bottom: 14%; width: clamp(0.9rem, calc(1 * var(--vu)), 2rem); height: auto; opacity: 0; scale: 0.6;
    transition: opacity 0.3s ease calc(0.35s + var(--i) * 0.07s), scale 0.4s var(--cf-ease) calc(0.35s + var(--i) * 0.07s); }
  #slide-content-factory .mc-cf-ok circle { fill: #0b1f06; stroke: var(--cf-ok); stroke-width: 1.6; }
  #slide-content-factory .mc-cf-ok path { fill: none; stroke: var(--cf-ok); stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round; }

  #slide-content-factory .mc-cf-l { position: absolute; left: var(--x); top: var(--y); font-size: clamp(0.92rem, calc(0.86 * var(--vu)), 1.85rem); font-weight: 700; line-height: 1.15; color: #ffffff; white-space: nowrap;
    opacity: 0.4; transition: opacity 0.45s ease, color 0.45s ease; }
  #slide-content-factory .mc-cf-l--su { translate: -50% calc(-100% - 0.35rem); text-align: center; }
  #slide-content-factory .mc-cf-l--dx { translate: 0 -50%; }
  #slide-content-factory .mc-cf-l--tag { translate: -50% 0; font-size: clamp(0.82rem, calc(0.7 * var(--vu)), 1.55rem); letter-spacing: 0.06em; text-transform: uppercase; color: #9fd68a; opacity: 0; }
  #slide-content-factory .mc-cf-l--giro { translate: -50% calc(-100% - 0.4rem); font-weight: 600; color: #b9e6a3; opacity: 0; transition: opacity 0.45s ease 1.4s; }

  /* La fascia: una didascalia per passo. */
  #slide-content-factory .mc-cf-banda { margin: clamp(0.6rem, calc(0.9 * var(--vu)), 1.8rem) 0 0; padding: clamp(0.55rem, calc(0.75 * var(--vu)), 1.4rem) clamp(0.9rem, calc(1.2 * var(--vu)), 2.2rem);
    border: 1px solid rgba(185, 230, 163, 0.34); border-radius: 8px; background: rgba(185, 230, 163, 0.09);
    font-size: clamp(1.02rem, calc(1 * var(--vu)), 2.2rem); line-height: 1.38; color: #f2f8f0;
    opacity: 0; visibility: hidden; transition: opacity 0.5s ease, visibility 0s linear 0.5s; }
  #slide-content-factory .mc-cf-didas { display: grid; min-width: 0; }
  #slide-content-factory .mc-cf-didas > p { grid-area: 1 / 1; margin: 0; max-width: none; opacity: 0; visibility: hidden; transition: opacity 0.25s ease, visibility 0s linear 0.25s; }
  #slide-content-factory .mc-cf-didas strong { color: #b9e6a3; margin-right: 0.35em; }
  #slide-content-factory .mc-cf-didas strong::after { content: ':'; }

  /* ── I passi ─────────────────────────────────────────────────────────── */
  #slide-content-factory:has(.mc-cf-passo[data-p="1"][data-substep-active]) .mc-cf-banda { opacity: 1; visibility: visible; transition: opacity 0.5s ease, visibility 0s; }
  #slide-content-factory:has(.mc-cf-passo[data-p="1"][data-substep-active]):not(:has(.mc-cf-passo[data-p="2"][data-substep-active])) :is(.mc-cf-didas > [data-per="1"], .mc-cf-int > [data-f="1"]),
  #slide-content-factory:has(.mc-cf-passo[data-p="2"][data-substep-active]):not(:has(.mc-cf-passo[data-p="3"][data-substep-active])) :is(.mc-cf-didas > [data-per="2"], .mc-cf-int > [data-f="2"]),
  #slide-content-factory:has(.mc-cf-passo[data-p="3"][data-substep-active]):not(:has(.mc-cf-passo[data-p="4"][data-substep-active])) :is(.mc-cf-didas > [data-per="3"], .mc-cf-int > [data-f="3"]),
  #slide-content-factory:has(.mc-cf-passo[data-p="4"][data-substep-active]) :is(.mc-cf-didas > [data-per="4"], .mc-cf-int > [data-f="4"]) { opacity: 1; visibility: visible; color: #ffffff; transition: opacity 0.35s ease 0.1s, visibility 0s, color 0.4s ease; }

  /* 1 · Pianificare: il brief. */
  #slide-content-factory:has(.mc-cf-passo[data-p="1"][data-substep-active]) .mc-cf-n--brief,
  #slide-content-factory:has(.mc-cf-passo[data-p="1"][data-substep-active]) .mc-cf-l[data-f="1"] { opacity: 1; }
  /* 2 · Produrre: il brief si apre in dodici varianti, ognuna con la spunta. */
  #slide-content-factory:has(.mc-cf-passo[data-p="2"][data-substep-active]) .mc-cf-a[data-f="2"],
  #slide-content-factory:has(.mc-cf-passo[data-p="3"][data-substep-active]) .mc-cf-a[data-f="3"],
  #slide-content-factory:has(.mc-cf-passo[data-p="4"][data-substep-active]) .mc-cf-a[data-f="4"] { clip-path: inset(-5% -5% -5% -5%); }
  #slide-content-factory:has(.mc-cf-passo[data-p="2"][data-substep-active]) .mc-cf-v { background: rgba(216, 85, 156, 0.82); border: 1.5px solid var(--cf-c); }
  #slide-content-factory:has(.mc-cf-passo[data-p="2"][data-substep-active]) .mc-cf-ok { opacity: 1; scale: 1; }
  #slide-content-factory:has(.mc-cf-passo[data-p="2"][data-substep-active]) .mc-cf-l--tag { opacity: 1; transition-delay: 1.1s; }
  /* 3 · Gestire: le varianti entrano nell'archivio. */
  #slide-content-factory:has(.mc-cf-passo[data-p="3"][data-substep-active]) .mc-cf-n--arch,
  #slide-content-factory:has(.mc-cf-passo[data-p="3"][data-substep-active]) .mc-cf-l[data-f="3"] { opacity: 1; }
  /* 4 · Attivare e misurare: i canali, e l'esito che torna al brief. */
  #slide-content-factory:has(.mc-cf-passo[data-p="4"][data-substep-active]) .mc-cf-n--can,
  #slide-content-factory:has(.mc-cf-passo[data-p="4"][data-substep-active]) .mc-cf-l[data-f="4"],
  #slide-content-factory:has(.mc-cf-passo[data-p="4"][data-substep-active]) .mc-cf-l--giro { opacity: 1; }
  #slide-content-factory:has(.mc-cf-passo[data-p="4"][data-substep-active]) .mc-cf-giro { clip-path: inset(-5% -5% -5% -5%); }
  #slide-content-factory:has(.mc-cf-passo[data-p="4"][data-substep-active]) .mc-cf-n--brief { fill: var(--cf-ok); transition: fill 0.45s ease 1.9s; }

  @media (prefers-reduced-motion: reduce) {
    #slide-content-factory :is(.mc-cf-a, .mc-cf-giro, .mc-cf-n, .mc-cf-v, .mc-cf-ok, .mc-cf-l, .mc-cf-int > span, .mc-cf-banda, .mc-cf-didas > p) { transition: none !important; }
  }
  @media (max-height: 820px) {
    #slide-content-factory .mc-cf-g { height: clamp(9rem, calc(12.5 * var(--vu)), 26rem); margin-top: 1.4rem; }
    #slide-content-factory .mc-cf-banda { margin-top: 0.45rem; padding-block: 0.45rem; }
  }
</style>
