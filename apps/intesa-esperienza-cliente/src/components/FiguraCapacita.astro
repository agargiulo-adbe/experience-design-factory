 * la fila delle capacità in testa alle slide di approfondimento, così le due
 * figure sono identiche per costruzione (owner, 14 nov 2026).
 */
interface Props { k: 'riconosce' | 'sceglie' | 'agisce' | 'misura'; class?: string }
const { k, class: cls } = Astro.props;
---
<svg class={cls} viewBox="0 0 120 64" aria-hidden="true">
  {k === 'riconosce' && <><circle cx="30" cy="22" r="9" class="tr" /><path d="M14 52c2-11 9-16 16-16s14 5 16 16" class="tr" /><path d="M52 32h16M62 26l6 6-6 6" class="fr" /><circle cx="90" cy="22" r="9" class="ac" /><path d="M74 52c2-11 9-16 16-16s14 5 16 16" class="ac" /></>}
  {k === 'sceglie' && <><rect x="8" y="6" width="34" height="9" rx="2" class="pi" /><rect x="8" y="20" width="34" height="9" rx="2" class="pi" /><rect x="8" y="34" width="34" height="9" rx="2" class="pi" /><rect x="8" y="48" width="34" height="9" rx="2" class="pi" /><path d="M46 10 C62 10 62 31 76 31M46 24 C62 24 62 31 76 31M46 38 C62 38 62 31 76 31M46 52 C62 52 62 31 76 31" class="tr" /><rect x="80" y="23" width="32" height="16" rx="3" class="acf" /></>}
  {k === 'agisce' && <><circle cx="14" cy="32" r="7" class="acf" /><path d="M21 32h22M43 32 C58 32 58 10 74 10M43 32h31M43 32 C58 32 58 54 74 54" class="tr" /><rect x="78" y="3" width="30" height="14" rx="3" class="pi" /><rect x="78" y="25" width="30" height="14" rx="3" class="pi" /><rect x="78" y="47" width="30" height="14" rx="3" class="pi" /></>}
  {k === 'misura' && <><path d="M8 58h104" class="tr" /><rect x="14" y="10" width="16" height="48" rx="2" class="pi" /><rect x="38" y="24" width="16" height="34" rx="2" class="pi" /><rect x="62" y="36" width="16" height="22" rx="2" class="pi" /><rect x="86" y="44" width="16" height="14" rx="2" class="acf" /></>}
