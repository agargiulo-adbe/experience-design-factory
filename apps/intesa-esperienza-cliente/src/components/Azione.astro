---
/**
 * Il badge d'azione — il device che dice, senza parole, CHE COSA sta
 * succedendo in quel momento.
 *
 * Non porta dati nuovi: legge quello che il momento già dichiara — il
 * `chrome` per il lato di Giulia (dove sta succedendo) e il `gruppo` per
 * il lato interno (quale parte dell'offerta lavora). Un dato in più
 * sarebbe un dato in più da tenere allineato.
 *
 * Solo geometria: niente testo dentro l'SVG, perché un testo in un
 * disegno non cresce con la radice e su una parete sparisce.
 */
interface Props { segno: string; class?: string }
const { segno, class: cls = '' } = Astro.props;
---
<span class={`im-due-badge ${cls}`} aria-hidden="true">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"
       stroke-linecap="round" stroke-linejoin="round" width="1em" height="1em">
    {segno === 'assistente' && <><path d="M4 5h16v11H9l-5 4z" /><path d="M8.5 10.5h7" /></>}
    {segno === 'feed' && <><rect x="4" y="4" width="16" height="16" rx="3" /><path d="M8 9h8M8 13h5" /></>}
    {segno === 'sito' && <><rect x="3" y="5" width="18" height="14" rx="2" /><path d="M3 9h18M6.5 7h.01M9 7h.01" /></>}
    {segno === 'posta' && <><rect x="3" y="5.5" width="18" height="13" rx="2" /><path d="m3.6 7 8.4 6 8.4-6" /></>}
    {segno === 'filiale' && <><path d="M3 20h18M4.5 20V9.5M19.5 20V9.5M12 3.5 21 9H3z" /><path d="M9 20v-5h6v5" /></>}
    {segno === 'app' && <><rect x="7" y="2.5" width="10" height="19" rx="2.6" /><path d="M11 18.6h2" /></>}
    {segno === 'trovare' && <><circle cx="10.5" cy="10.5" r="6" /><path d="m15 15 4.5 4.5" /></>}
    {segno === 'contenuto' && <><rect x="3.5" y="3.5" width="7" height="7" rx="1.6" /><rect x="13.5" y="3.5" width="7" height="7" rx="1.6" /><rect x="3.5" y="13.5" width="7" height="7" rx="1.6" /><rect x="13.5" y="13.5" width="7" height="7" rx="1.6" /></>}
    {segno === 'engagement' && <><circle cx="12" cy="8" r="3.6" /><path d="M4.8 20c.8-3.8 3.7-5.6 7.2-5.6s6.4 1.8 7.2 5.6" /></>}
    {segno === 'piattaforma' && <><path d="m12 3.2 8.4 4.3-8.4 4.3-8.4-4.3z" /><path d="m3.6 12 8.4 4.3 8.4-4.3M3.6 16.4l8.4 4.3 8.4-4.3" /></>}
  </svg>
</span>
