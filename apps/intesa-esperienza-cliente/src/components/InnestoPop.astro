---
/**
 * IL MOCKUP A PASSI di un componente che si innesta. Stessa meccanica del pop-in di
 * Trenitalia: `<dialog>` nativo, i pezzi entrano al passo `data-da`, niente testo
 * dentro un SVG. Da chiuso è `display: none`, quindi i gate di layout non lo misurano.
 */
import { SCENE, type ScenaId } from '../data/pop';
import { POP3D } from '../data/pop3d';
import '../styles/pop.css';
interface Props { scena: ScenaId; }
const { scena } = Astro.props as Props;
const s = SCENE[scena];
const frecciaD = 'M1 7h24M19 1l6 6-6 6';
/* La versione 3D (data/pop3d.ts) si accende con `?pop3d=1`: senza, questo palco resta
   vuoto e nascosto, e non scarica niente. Se il video non parte, torna la scena HTML. */
const p3 = POP3D[scena];
const base3d = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/media/3d/${p3.clip}/`;
---
<dialog class="pp" data-pp data-deck-nochrome data-audit-skip data-tot={s.passi.length} data-scena={scena} aria-label={s.prodotto}>
  <div class="pp-in">
    <header class="pp-testa">
      <div class="pp-testa-t">
        <p class="pp-k">Componente Adobe</p>
        <h3 class="pp-h">{s.prodotto}</h3>
      </div>
      <p class="pp-cosa">{s.cosa}</p>
      <button type="button" class="pp-x" data-pp-chiudi aria-label="Chiudi">×</button>
    </header>

    <div class="pp-scena">
      <div class="pp-3d" data-pp3d={JSON.stringify(p3)} data-base={base3d} aria-hidden="true">
        <video muted playsinline preload="none"></video>
        <div class="pp-3d-et"></div>
        <p class="pp-3d-nota"></p>
      </div>
      {scena === 'cja' && (
        <div class="pp-cja">
          <div class="pp-strato" data-da="2">
            <div class="pp-strato-t"><strong>Customer Journey Analytics</strong><span>Analisi omnicanale dei non‑clienti e clienti</span></div>
            <div class="pp-strato-pila">
              <ol class="pp-viaggio" data-da="5" data-a="5">
                <li><small>Sito</small><strong>Simula il mutuo</strong></li>
                <li><small>Email</small><strong>Riprende la richiesta</strong></li>
                <li><small>Filiale</small><strong>Appuntamento tenuto</strong></li>
                <li data-on><small>Esito</small><strong>Richiesta firmata</strong></li>
              </ol>
              <div class="pp-barre" data-da="6">
                <p class="pp-barre-t">Attribuzione delle firme per canale · algoritmica</p>
                <p><span>Sito</span><i style="--v:78%"></i></p>
                <p><span>Email</span><i style="--v:34%"></i></p>
                <p data-on><span>Filiale</span><i style="--v:60%"></i></p>
              </div>
            </div>
          </div>
          <div class="pp-fili">
            <span class="pp-filo" data-da="2"></span>
            <span class="pp-filo" data-da="2"></span>
            <span class="pp-filo" data-da="3"></span>
            <span class="pp-filo" data-da="3"></span>
            <span class="pp-filo" data-da="4"></span>
          </div>
          <ul class="pp-fonti">
            <li class="pp-f" data-gia><small>Digitale</small><strong>Sito</strong></li>
            <li class="pp-f" data-gia><small>Digitale</small><strong>App</strong></li>
            <li class="pp-f" data-da="3"><small>Dal CRM</small><strong>Filiale</strong></li>
            <li class="pp-f" data-da="3"><small>Dalla Filiale Digitale</small><strong>Chiamate</strong></li>
            <li class="pp-f" data-gia data-da="4"><small>Dal motore di targeting</small><strong>Segmenti e score</strong></li>
          </ul>
        </div>
      )}

      {scena === 'cdp' && (
        <div class="pp-cdp">
          <ol class="pp-viaggio pp-viaggio--cdp">
            <li><small>Arriva sul sito</small><strong>Ancora senza nome: si sa che cosa fa, non chi è</strong></li>
            <li data-da="2"><small>Simula la rata</small><strong>Entra nel segmento «mutuo prima casa»</strong></li>
            <li data-da="3"><small>Torna sul sito</small><strong>«Riprendi la simulazione»</strong></li>
            <li data-da="4" data-on><small>Lascia l’email</small><strong>Le visite si uniscono al profilo</strong></li>
          </ol>
          <div class="pp-cdp-giu" data-da="5">
            <div class="pp-c"><small>Ora può anche scriverle</small><strong>Journey Optimizer</strong></div>
            <div class="pp-c"><small>Quando prende appuntamento</small><strong>Il lead nel CRM di filiale</strong></div>
          </div>
        </div>
      )}

      {scena === 'decisioning' && (
        <div class="pp-dec">
          <div class="pp-dec-c">
            <div class="pp-c">
              <small>Sistema attuale</small>
              <strong>Il motore di targeting</strong>
              <ul class="pp-sas"><li>Target</li><li>Propensione</li></ul>
              <small>Eleggibilità creditizia: core banking</small>
            </div>
            <div class="pp-dec-fr" data-da="2">
              <svg viewBox="0 0 28 14" aria-hidden="true"><path d={frecciaD} /></svg>
              <span>attributi del profilo</span>
            </div>
          </div>
          <div class="pp-strato" data-da="2">
            <div class="pp-strato-t"><strong>AI Decisioning</strong><span>Sceglie tra le proposte candidate</span></div>
            <ul class="pp-cand" data-da="3">
              <li data-primo><span>Promemoria con appuntamento proposto</span><em data-da="5">prima per priorità</em></li>
              <li><span>Promemoria senza appuntamento</span><em data-da="5">seconda</em></li>
              <li data-motivo><span>Contatto dalla Filiale Digitale</span><em data-da="4">escluso · non ammesso: manca il consenso al contatto telefonico</em></li>
              <li><span>Polizza casa</span><em data-da="4">esclusa: solo dopo la firma</em></li>
            </ul>
          </div>
          <div class="pp-dec-c">
            <div class="pp-c pp-c--ok" data-da="6"><small>Proposta selezionata</small><strong>Promemoria con appuntamento proposto, sul sito</strong></div>
            <div class="pp-c" data-da="6"><small>Invio</small><strong>Tramite i canali attuali</strong></div>
            <div class="pp-striscia" data-da="7"><strong>Customer Journey Analytics</strong><span>misura l’esito</span></div>
          </div>
        </div>
      )}
    </div>

    <footer class="pp-piede">
      <div class="pp-didas" aria-live="polite">
        {s.passi.map((p, i) => (<p class="pp-d" data-passo-t={i + 1}><span class="pp-d-n">{i + 1}</span>{p}</p>))}
      </div>
      <div class="pp-nav">
        <div class="pp-punti" aria-hidden="true">{s.passi.map((_, i) => <span data-punto={i + 1}></span>)}</div>
        <button type="button" class="pp-b-n" data-pp-prev aria-label="Passo precedente">←</button>
        <button type="button" class="pp-b-n pp-b-n--av" data-pp-next>Avanti →</button>
      </div>
      {(s.nota || s.fonti.length > 0) && (
        <p class="pp-nota">
          {s.nota}
          {s.fonti.map((f, i) => <>{(s.nota || i > 0) && ' · '}<a href={f.url} target="_blank" rel="noopener noreferrer">{f.label}</a></>)}
        </p>
      )}
    </footer>
  </div>
</dialog>

<style>
  /* Il motivo canonico dell'esclusione (le stesse parole di m-04) è lungo: va
     a capo SOTTO la proposta invece di spingere la riga fuori dal riquadro. */
  dialog.pp .pp-cand li[data-motivo] { flex-wrap: wrap; row-gap: 0.25rem; }
  dialog.pp .pp-cand li[data-motivo] em { flex-basis: 100%; white-space: normal; }

  /* ── La versione 3D (?pop3d=1) ─────────────────────────────
     Il palco 16:9 sta nella cella della scena senza deformarsi (unità del
     contenitore). Le etichette sono HTML sopra il video, alle coordinate che
     Blender ha calcolato a fine passo: l'etichetta NUOVA del passo ha il bordo,
     le altre si attenuano. */
  .pp-3d { display: none; }
  :global(html[data-pop3d='on']) dialog.pp:not([data-pp3d-ko]) .pp-scena { container-type: size; padding: clamp(0.6rem, 1.4vh, 1.2rem); background: #0d2901; }
  :global(html[data-pop3d='on']) dialog.pp:not([data-pp3d-ko]) .pp-scena > :not(.pp-3d) { display: none; }
  :global(html[data-pop3d='on']) dialog.pp:not([data-pp3d-ko]) .pp-3d {
    display: block; position: relative; margin: auto; overflow: hidden; border-radius: 0.6rem;
    width: min(100cqw, calc(100cqh * 16 / 9)); aspect-ratio: 16 / 9; background: #0d2901;
  }
  .pp-3d video { position: absolute; inset: 0; width: 100%; height: 100%; }
  .pp-3d :global(.pp-3d-e) {
    position: absolute; transform: translate(-50%, -100%); white-space: pre-line; width: max-content; text-align: center; pointer-events: none;
    font-weight: 600; font-size: clamp(0.75rem, 1.3cqw, 1.3rem); line-height: 1.25; color: #fff;
    padding: 0.1em 0.5em; border-radius: 0.35em; background: rgba(13, 41, 1, 0.82);
    opacity: 0; transition: opacity 0.45s, left 0.6s, top 0.6s;
  }
  .pp-3d :global(.pp-3d-e.on) { opacity: 0.62; }
  .pp-3d :global(.pp-3d-e.nuova) { opacity: 1; box-shadow: 0 0 0 1px #5ca740; }
  .pp-3d :global(.pp-3d-e.no) { color: #c8d0c4; white-space: nowrap; }
  .pp-3d :global(.pp-3d-e.no small) { display: inline; font-size: 0.85em; font-weight: 400; color: inherit; letter-spacing: 0; }
  dialog.pp .pp-3d-nota { position: absolute; right: 1.2%; bottom: 2%; font-size: clamp(0.75rem, 1.2cqw, 1.1rem); color: #c8d0c4; opacity: 0; transition: opacity 0.45s; }
  dialog.pp .pp-3d-nota.on { opacity: 1; }
</style>

<script>
  /* Una delega sola sul documento: regge ai cambi di capitolo (ClientRouter) e a
     più istanze per pagina. Lo script di un componente Astro gira una volta. */
  const aperto = () => document.querySelector<HTMLDialogElement>('dialog.pp[open]');

  /* ── La versione 3D ──────────────────────────────────────────
     Ogni passo riproduce SOLO il suo tratto di video e si ferma sullo stato finale
     (segmentazione): il video segue chi parla. Indietro, o con la riduzione del
     movimento, si salta allo stato finale senza animare. */
  const FPS = 24;
  type Et = { passo: number; nome: string; x: number; y: number; visibile: boolean };
  type Stato3d = { cap: { da: number; a: number }[]; et: Et[]; ferma: number | null; pronto: Promise<void> };
  const stati = new WeakMap<HTMLElement, Stato3d>();
  const acceso3d = (d: HTMLDialogElement) =>
    document.documentElement.dataset.pop3d === 'on' && !d.hasAttribute('data-pp3d-ko');

  function prepara3d(d: HTMLDialogElement): Stato3d | null {
    const palco = d.querySelector<HTMLElement>('.pp-3d');
    if (!palco || !acceso3d(d)) return null;
    let st = stati.get(palco);
    if (st) return st;
    const v = palco.querySelector('video')!;
    const base = palco.dataset.base!;
    const clip = JSON.parse(palco.dataset.pp3d!).clip as string;
    const ko = () => { d.setAttribute('data-pp3d-ko', ''); };
    st = { cap: [], et: [], ferma: null, pronto: Promise.resolve() };
    const s = st;
    st.pronto = Promise.all([
      fetch(base + 'capitoli.json').then((r) => r.json()),
      fetch(base + 'etichette.json').then((r) => r.json()),
    ]).then(([c, e]) => {
      s.cap = c.capitoli ?? c; s.et = e;
      v.poster = base + clip + '.poster.jpg';
      v.innerHTML = `<source src="${base}${clip}.webm" type="video/webm"><source src="${base}${clip}.mp4" type="video/mp4">`;
      v.querySelector('source:last-child')?.addEventListener('error', ko);
      v.preload = 'auto'; v.load();
      return new Promise<void>((ok) => {
        if (v.readyState >= 2) ok(); else v.addEventListener('loadeddata', () => ok(), { once: true });
        setTimeout(ok, 4000);
      });
    }).catch(ko);
    v.addEventListener('timeupdate', () => {
      if (s.ferma !== null && v.currentTime >= s.ferma) { v.pause(); v.currentTime = s.ferma - 0.5 / FPS; s.ferma = null; }
    });
    stati.set(palco, st);
    return st;
  }

  function etichette3d(palco: HTMLElement, st: Stato3d, p: number) {
    const cfg = JSON.parse(palco.dataset.pp3d!) as {
      nomi: Record<string, string>; escluse?: Record<string, number>; motivi?: Record<string, string>;
      sposta?: Record<string, [number, number]>; note?: Record<string, string>;
    };
    const box = palco.querySelector<HTMLElement>('.pp-3d-et')!;
    if (!box.childElementCount) {
      for (const n of Object.keys(cfg.nomi)) {
        const e = document.createElement('span'); e.className = 'pp-3d-e'; e.dataset.n = n; box.appendChild(e);
      }
    }
    box.querySelectorAll<HTMLElement>('.pp-3d-e').forEach((e) => {
      const n = e.dataset.n!;
      const qui = st.et.find((x) => x.passo === p && x.nome === n);
      const prima = st.et.find((x) => x.passo === p - 1 && x.nome === n);
      // Un oggetto tagliato dal bordo non porta etichetta: tirerebbe l'occhio fuori scena.
      const on = !!qui && qui.visibile && qui.x > 0.06 && qui.x < 0.94 && qui.y > 0.06 && qui.y < 0.82;
      e.classList.toggle('on', on);
      e.classList.toggle('nuova', on && !(prima && prima.visibile));
      const esclusa = !!(cfg.escluse?.[n] && p >= cfg.escluse[n]);
      e.classList.toggle('no', esclusa);
      const nome = cfg.nomi[n];
      // Il motivo sta accanto all'ULTIMA esclusione fatta: quelle di prima restano
      // barrate senza motivo, se no il fondo della scena diventa un elenco.
      const ultima = Math.max(0, ...Object.values(cfg.escluse ?? {}).filter((x) => x <= p));
      if (esclusa && cfg.motivi?.[n] && cfg.escluse![n] === ultima) {
        e.replaceChildren(Object.assign(document.createElement('s'), { textContent: nome.replace('\n', ' ') }), ' ',
          Object.assign(document.createElement('small'), { textContent: '· ' + cfg.motivi[n] }));
      } else if (esclusa) {
        e.replaceChildren(Object.assign(document.createElement('s'), { textContent: nome.replace('\n', ' ') }));
      } else e.textContent = nome;
      if (qui) {
        const [dx, dy] = cfg.sposta?.[n] ?? [0, 0];
        e.style.left = qui.x * 100 + dx + '%'; e.style.top = qui.y * 100 + dy + '%';
      }
    });
    // Un'etichetta larga vicino al bordo si tiene DENTRO il palco: tagliata a metà
    // («tore di targeting») si legge peggio che spostata di qualche pixel.
    const W = palco.clientWidth, m = 6;
    box.querySelectorAll<HTMLElement>('.pp-3d-e.on').forEach((e) => {
      const c = (parseFloat(e.style.left) / 100) * W, w = e.offsetWidth;
      const dx = Math.max(0, m + w / 2 - c) - Math.max(0, c + w / 2 - (W - m));
      e.style.transform = `translate(calc(-50% + ${dx}px), -100%)`;
    });
    const nota = palco.querySelector<HTMLElement>('.pp-3d-nota')!;
    const t = cfg.note?.[String(p)];
    nota.textContent = t ?? ''; nota.classList.toggle('on', !!t);
  }

  function passo3d(d: HTMLDialogElement, p: number, avanti: boolean) {
    const st = prepara3d(d);
    if (!st) return;
    const palco = d.querySelector<HTMLElement>('.pp-3d')!;
    const v = palco.querySelector('video')!;
    st.pronto.then(() => {
      if (!acceso3d(d) || Number(d.dataset.passo) !== p) return;
      const c = st.cap[p - 1];
      if (!c) return;
      const ridotto = matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (avanti && !ridotto) {
        v.currentTime = c.da / FPS; st.ferma = (c.a + 1) / FPS;
        v.play().catch(() => { st.ferma = null; v.currentTime = c.a / FPS; });
      } else { v.pause(); st.ferma = null; v.currentTime = c.a / FPS; }
      etichette3d(palco, st, p);
    });
  }

  function vai(d: HTMLDialogElement, n: number) {
    const tot = Number(d.dataset.tot);
    const p = Math.min(Math.max(1, n), tot);
    const prima = Number(d.dataset.passo ?? 0);
    d.dataset.passo = String(p);
    passo3d(d, p, p === prima + 1);
    d.querySelectorAll<HTMLElement>('[data-da],[data-a]').forEach((el) => {
      const da = Number(el.dataset.da ?? 1);
      const a = Number(el.dataset.a ?? 99);
      el.classList.toggle('pp-on', p >= da && p <= a);
    });
    d.querySelectorAll<HTMLElement>('[data-passo-t]').forEach((el) => {
      el.classList.toggle('pp-on', Number(el.dataset.passoT) === p);
    });
    d.querySelectorAll<HTMLElement>('[data-punto]').forEach((el) => {
      el.classList.toggle('pp-on', Number(el.dataset.punto) <= p);
    });
    const prev = d.querySelector<HTMLButtonElement>('[data-pp-prev]');
    const next = d.querySelector<HTMLButtonElement>('[data-pp-next]');
    if (prev) prev.disabled = p === 1;
    if (next) next.textContent = p === tot ? 'Chiudi' : 'Avanti →';
  }

  function avanti(d: HTMLDialogElement) {
    const p = Number(d.dataset.passo);
    if (p >= Number(d.dataset.tot)) d.close();
    else vai(d, p + 1);
  }

  function apri(d: HTMLDialogElement) {
    d.closest('[data-deck]')?.setAttribute('data-deck-lock', '');
    d.showModal();
    d.dataset.passo = '0';
    vai(d, 1);
    d.querySelector<HTMLElement>('[data-pp-next]')?.focus();
  }

  document.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    const open = t.closest<HTMLElement>('[data-pp-open]');
    if (open) {
      const d = open.parentElement?.querySelector<HTMLDialogElement>('dialog.pp');
      if (d) { e.preventDefault(); apri(d); }
      return;
    }
    const d = t.closest<HTMLDialogElement>('dialog.pp');
    if (!d) return;
    if (t === d || t.closest('[data-pp-chiudi]')) d.close();
    else if (t.closest('[data-pp-next]')) avanti(d);
    else if (t.closest('[data-pp-prev]')) vai(d, Number(d.dataset.passo) - 1);
  });

  /* `close` non risale: si ascolta in cattura. Copre Esc, la ×, l'ultimo passo. */
  document.addEventListener('close', (e) => {
    const d = e.target as HTMLElement;
    if (d.matches?.('dialog.pp')) d.closest('[data-deck]')?.removeAttribute('data-deck-lock');
  }, true);

  /* In cattura sul documento: a pop-in aperto i tasti non arrivano al deck, che
     ascolta su window. Vale anche per i telecomandi, che mandano PageDown/PageUp. */
  document.addEventListener('keydown', (e) => {
    const d = aperto();
    if (!d) return;
    if (['ArrowRight', 'ArrowDown', 'PageDown', ' '].includes(e.key)) {
      if ((e.target as HTMLElement).tagName === 'A') return;
      e.preventDefault(); e.stopPropagation(); avanti(d);
    } else if (['ArrowLeft', 'ArrowUp', 'PageUp'].includes(e.key)) {
      e.preventDefault(); e.stopPropagation(); vai(d, Number(d.dataset.passo) - 1);
    } else if (e.key !== 'Escape' && e.key !== 'Tab') {
      e.stopPropagation();
    }
  }, true);
</script>
