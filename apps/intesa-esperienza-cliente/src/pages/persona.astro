---
/**
 * La persona — Giulia, e i sette momenti che seguiremo.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import T from '@edf/core/blocks/i18n/T.astro';
import Divisore from '../components/Divisore.astro';
import { href } from '@edf/core/utils/url.js';
import { CHAPTERS, prevSlug, nextSlug } from '../data/chapters';
import CircoloJourney from '../components/CircoloJourney.astro';
import ritratto from '../assets/generated/persona-giulia.webp';

const SLUG = 'persona';
const ch = CHAPTERS.find((c) => c.slug === SLUG)!;
const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;
---
<BaseLayout title={ch.title.it}>
  <div class="fixed top-0 left-0 right-0 z-50">
    <Navigation currentPath={currentPath} base={base} />
  </div>

  <DeckContainer nextHref={href(base, nextSlug(SLUG))} prevHref={href(base, prevSlug(SLUG))}>

    <Slide id="slide-cover" bg="secondary" align="left">
      <div slot="backdrop" class="im-div-bg" data-ritratto style={`--foto: url('${ritratto.src}'); --fuoco: center 20%`}></div>
      <Divisore num={ch.num}
        tIt="Giulia, 34 anni, non è vostra cliente" tEn="Giulia, 34, and not your customer" />
    </Slide>

    {/* ⚠️ UNA SLIDE SOLA, con Giulia al centro del giro.
        Erano due: il ritratto con quello che di lei non avete, e il
        cerchio delle sette fermate. Separate, chi guardava doveva tenere
        a mente la prima mentre leggeva la seconda — e il giro sembrava
        del sistema invece che suo. Al centro dell'anello il ritratto dice
        di chi è il percorso prima di qualunque etichetta.
        Le sette fermate compaiono una alla volta con la freccia in basso:
        il giro si costruisce davanti a chi guarda. */}
    <Slide id="slide-giro-di-giulia" bg="inverse" align="center">
      <div slot="backdrop" class="im-bg-notte"></div>
      <div class="im-cerslide im-cerslide--persona" data-reveal>
        <header class="im-cerslide-testa">
          <T as="p" class="im-mom-blocco" it="Il percorso di Giulia" en="Giulia’s journey" />
          <T as="h2" class="im-cerslide-t" it="Giulia diventa cliente in sette momenti" en="Giulia becomes a customer in seven moments" data-reveal data-reveal-delay="0.08" />
        </header>

        {/* La premessa e l'esito del giro, ai due capi della sequenza: la
            premessa c'è da subito, l'esito entra dopo il settimo momento.
            Sta DOPO l'anello nel DOM perché i passi si scoprono in
            quest'ordine. Era una riga sola a lato, e si perdeva (owner,
            10 nov 2026). */}
        <div class="im-capo" data-reveal data-reveal-delay="0.26">
          <T as="p" class="im-capo-k" it="Il punto di partenza" en="The starting point" />
          <T as="p" class="im-capo-t" it="Non è ancora cliente. La banca non sa niente di lei." en="She is not a customer yet. The bank knows nothing about her." />
        </div>

        <CircoloJourney grande ampio aPassi ritratto={ritratto.src} data-reveal data-reveal-delay="0.16" />

        <div class="im-capo im-capo--esito" data-substep data-side="in">
          <T as="p" class="im-capo-k" it="Dopo sette momenti" en="Seven moments later" />
          <T as="p" class="im-capo-t" it="Ha firmato la richiesta. La banca sa da dove è arrivata, dove si è fermata e, con la spesa in piattaforma, quanto è costata." en="She has signed the application. The bank knows where she came from, where she stopped and, with spend in the platform, what she cost." />
        </div>
      </div>
    </Slide>

  </DeckContainer>
</BaseLayout>
