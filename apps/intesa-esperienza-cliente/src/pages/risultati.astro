---
/**
 * Referenze — chi lo ha già fatto, e con quali numeri.
 *
 * Ogni cifra porta la banca che l'ha prodotta e il link che la regge: non
 * sono promesse su Intesa Sanpaolo, sono risultati di altri, e la pagina lo
 * dice invece di lasciarlo capire. Fonti aperte e lette il 29 ott 2026.
 *
 * ⚠️ IL CAPITOLO DICE UNA COSA SOLA, ed è per questo che è corto: che
 * altre banche lo fanno e lo dicono in pubblico. Tutto ciò che parla di
 * noi — le misure, l'ask, la firma — è stato spostato a valle, dove il
 * flusso lo chiede: referenze → CX Analytics → prossimi passi → firma.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import T from '@edf/core/blocks/i18n/T.astro';
import Divisore from '../components/Divisore.astro';
import { href } from '@edf/core/utils/url.js';
import { CHAPTERS, prevSlug, nextSlug } from '../data/chapters';
/* Le cifre vengono dalla FONTE UNICA: il taglio «In dieci minuti» legge
   gli stessi oggetti, e due copie a mano divergono. Misure e ask stanno
   nella stessa fonte ma si rendono in «Prossimi passi». */
import { CASI } from '../data/referenze';
import fondo from '../assets/generated/cover-banche.webp';
import Caso from '../components/Caso.astro';

const SLUG = 'risultati';
const ch = CHAPTERS.find((c) => c.slug === SLUG)!;
const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;


---
<BaseLayout title={ch.title.it}>
  <div class="fixed top-0 left-0 right-0 z-50">
    <Navigation currentPath={currentPath} base={base} />
  </div>

  <DeckContainer nextHref={href(base, nextSlug(SLUG))} prevHref={href(base, prevSlug(SLUG))}>

    <Slide id="slide-cover" bg="secondary" align="left" data-made-with="Adobe Firefly" data-made-with-for="sfondo">
      <div slot="backdrop" class="im-div-bg" style={`--foto: url('${fondo.src}'); --fuoco: center 44%`}></div>
      <Divisore num={ch.num}
        tIt="Tre banche e Unipol: lo fanno già" tEn="Three banks and Unipol already doing it" />
    </Slide>

    {/* I CASI, una slide ciascuno, sulla stessa grammatica
        (components/Caso.astro). Ordine dell'owner (11 nov 2026): Santander,
        Crédit Agricole, TSB, poi Unipol, che non è una banca ma porta la
        rete fisica e il digitale nella stessa analisi. L'ordine si può
        cambiare anche dalla Console, senza toccare il codice. */}
    <Slide id="slide-santander" bg="secondary" align="left">
      <Caso caso={CASI.santander} />
    </Slide>

    <Slide id="slide-credit-agricole" bg="secondary" align="left">
      <Caso caso={CASI.creditAgricole} />
    </Slide>

    <Slide id="slide-tsb" bg="secondary" align="left">
      <Caso caso={CASI.tsb} />
    </Slide>

    <Slide id="slide-unipol" bg="secondary" align="left">
      <Caso caso={CASI.unipol} />
    </Slide>

    {/* ⚠️ QUI STAVANO «CHE COSA MISUREREMMO» E LA SLIDE-FIRMA, e sono
        andate dove servono (revisione critica, 30 ott 2026).
        Le misure erano in un capitolo di REFERENZE, dove rompevano
        l'argomento del capitolo: le prime tre slide dicono «questi sono
        risultati di altri, con la pagina che li regge», e la quarta
        cambiava soggetto e diventava la nostra proposta. Ora stanno in
        «Prossimi passi», che è la domanda a cui rispondono — e lì sta
        anche l'ask, in un posto solo.
        La slide-firma chiude il PERCORSO, non il capitolo sette: con
        CX Analytics e Prossimi passi dopo di sé, firmare qui faceva
        finire il documento tre capitoli prima della fine. */}
  </DeckContainer>
</BaseLayout>
