---
/**
 * LA PAGINA BREVE — il primo livello sul telefono (spec 2026-11-19, §3).
 *
 * Chi apre il link dal telefono, di solito dalla posta e per pochi secondi,
 * non trova il deck (che sul telefono non si legge) ma questa pagina che si
 * scorre: la storia in sette momenti, le tre persone da contattare, e il
 * rimando al computer per la versione intera. Nessun testo nuovo sui momenti:
 * le righe vengono da `momenti.ts`, le stesse delle slide.
 * Esiste solo nella build lettura. Non è un DeckContainer: è una pagina.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import CoBrand from '../components/CoBrand.astro';
import Contatti from '../components/Contatti.astro';
import ContaAperture from '@edf/core/blocks/immersive/ContaAperture.astro';
import { SITE } from '../data/site';
import { TITOLO_INCONTRO } from '../data/agenda';
import { MOMENTI, TITOLO_GIRO } from '../data/momenti';
import { EXPERIENCE_TYPES } from '@edf/core/data/experienceTypes';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const intero = new URL(base, Astro.site).href;
const tipo = EXPERIENCE_TYPES[SITE.type];
const mandami = `mailto:?subject=${encodeURIComponent('Adobe × Intesa Sanpaolo · la storia intera')}&body=${encodeURIComponent(intero)}`;
---
<BaseLayout title="In breve">
  <main class="br">
    {/* PRIMA SCHERMATA: chi siamo, che cosa si legge, e chi è Giulia — un personaggio
        inventato, detto subito, perché chi apre il link non era in sala. */}
    <header class="br-pg br-testa">
      <CoBrand variant="hero" class="br-lockup edf-cobrand--on-dark" />
      <h1 class="br-t">{TITOLO_INCONTRO.t.it}</h1>
      <p class="br-s">{TITOLO_INCONTRO.s.it}</p>
      <div class="br-intro">
        <p>Giulia è un personaggio inventato per raccontare il percorso: 34&nbsp;anni, cerca il primo mutuo e non è ancora cliente di Intesa Sanpaolo.</p>
        <p>In sette momenti, dalla prima domanda a un assistente AI fino alla firma, si vede che cosa fa lei e che cosa fa la banca con le soluzioni Adobe.</p>
      </div>
      <p class="br-tipo">{tipo.coverLine.it}</p>
      <p class="br-giu" aria-hidden="true">{TITOLO_GIRO.it} <span>↓</span></p>
    </header>

    {/* UN MOMENTO PER SCHERMATA, come gli anni del diario de «L'ora in più»: la pagina
        si aggancia all'inizio di ogni momento (scroll-snap) e la testata resta in alto
        mentre lo si legge, finché il momento dopo non la spinge via (sticky). */}
    <ol class="br-mom" aria-label={TITOLO_GIRO.it}>
      {MOMENTI.map((m, i) => (
        <li class="br-pg br-m">
          <p class="br-m-k"><span class="br-m-n">{m.n}</span><span class="br-m-q">{m.ora.it} · {m.dove.it}</span></p>
          <div class="br-m-corpo">
            <img class="br-m-img" src={`${base}miniature/lettura/m-0${i + 1}.jpg`} alt="" loading="lazy" decoding="async" />
            <p class="br-m-chi">Giulia</p>
            <p class="br-m-r">{m.cliente.titolo.it}</p>
            <p class="br-m-chi">La banca</p>
            <p class="br-m-r">{m.interno.titolo.it}</p>
            {/* Il prodotto Adobe che copre quella capability: una riga sola, non una
                scheda. Marchio, nome, e in tono minore che cosa fa (`funzione`). */}
            <p class="br-m-pro">
              <span class="adb-tile br-m-adb" role="img" aria-label="Adobe"></span>
              <span class="br-m-pro-t"><strong>{m.prodotto}</strong><span>{m.funzione.it}</span></span>
            </p>
          </div>
        </li>
      ))}
    </ol>

    <section class="br-pg br-pc" aria-labelledby="br-pc-t">
      <h2 class="br-h" id="br-pc-t">La storia intera, con le schermate dei prodotti</h2>
      <p class="br-l">Momento per momento, con quello che succede nei sistemi della banca. Dà il meglio su uno schermo grande: mandatevi il link e riapritelo con calma.</p>
      <div class="br-az">
        <a class="br-btn br-btn--pieno" href={mandami}>Mandate il link alla vostra email</a>
        <a class="br-btn" href={base} data-apri-comunque>Apri qui la versione intera</a>
      </div>
    </section>

    <section class="br-pg br-parl" aria-labelledby="br-parl-t">
      <h2 class="br-h" id="br-parl-t">Parliamone</h2>
      <p class="br-l">Una domanda su un momento di Giulia, su un prodotto, su come si innesta nei vostri sistemi: scriveteci, anche solo una riga.</p>
      <Contatti class="br-cont" />
      <p class="br-nota">Contiamo quante volte questa pagina viene aperta, giorno per giorno. Non registriamo chi la apre.</p>
    </section>
  </main>
  <ContaAperture progetto="intesa-storia" pagina="breve" />
</BaseLayout>

<script is:inline>
  document.addEventListener('click', function (e) {
    var a = e.target && e.target.closest && e.target.closest('[data-apri-comunque]');
    if (!a) return;
    try { sessionStorage.setItem('edf:apri-comunque', '1'); } catch (_) {}
  });
</script>

<style>
  /* Lo sfoglio: la pagina si aggancia all'inizio di ogni schermata. `mandatory`
     regge perché OGNI blocco è un punto d'aggancio; un blocco più alto dello
     schermo (i contatti) si scorre lo stesso al suo interno. */
  :global(html:has(.br)) { scroll-snap-type: y mandatory; background: var(--color-night); }
  .br {
    color: var(--color-paper); font-family: var(--font-body); font-size: 1rem; line-height: 1.5;
    background: linear-gradient(180deg, var(--color-night-2) 0%, var(--color-night) 40%);
  }
  .br-pg {
    min-height: 100svh; scroll-snap-align: start;
    padding: max(2rem, env(safe-area-inset-top)) 1.15rem max(2rem, env(safe-area-inset-bottom));
    display: flex; flex-direction: column;
  }
  .br-pg > * , .br-m-corpo { width: 100%; max-width: 34rem; margin-inline: auto; }
  .br-testa { justify-content: center; }
  .br-lockup { justify-content: flex-start; margin-bottom: 1.5rem; }
  .br-t { margin: 0; font-family: var(--font-display); font-weight: 700; font-size: 1.95rem; line-height: 1.12; letter-spacing: -0.01em; text-wrap: balance; }
  .br-s { margin: 0.5rem 0 0; font-size: 1.15rem; color: var(--color-verde-chiaro); }
  .br-intro { margin-top: 1.6rem; padding-top: 1.3rem; border-top: 1px solid rgba(255, 255, 255, 0.18); }
  .br-intro p { margin: 0; font-size: 1.05rem; line-height: 1.55; color: rgba(255, 255, 255, 0.92); text-wrap: pretty; }
  .br-intro p + p { margin-top: 0.7rem; }
  .br-tipo { margin: 1.4rem 0 0; font-size: 0.8rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: rgba(255, 255, 255, 0.66); }
  .br-giu { margin-top: auto; padding-top: 2rem; font-size: 1rem; font-weight: 600; color: var(--color-verde-chiaro); }
  .br-giu span { display: inline-block; margin-left: 0.3rem; }
  @media (prefers-reduced-motion: no-preference) {
    .br-giu span { animation: br-giu 1.8s cubic-bezier(0.16, 1, 0.3, 1) infinite; }
  }
  @keyframes br-giu { 0%, 60%, 100% { transform: translateY(0); } 30% { transform: translateY(5px); } }

  .br-mom { list-style: none; margin: 0; padding: 0; }
  /* Il momento: alto quanto lo schermo, la testata ferma in alto mentre lo si legge. */
  .br-m { position: relative; padding-top: 0; border-top: 1px solid rgba(255, 255, 255, 0.1); }
  .br-m-k {
    position: sticky; top: 0; z-index: 2;
    display: flex; align-items: baseline; gap: 0.75rem;
    margin: 0 -1.15rem 1rem; padding: max(0.9rem, env(safe-area-inset-top)) 1.15rem 0.8rem;
    background: var(--color-night); border-bottom: 2px solid var(--color-verde-chiaro);
    max-width: none; width: auto;
  }
  .br-m-n { font-family: var(--font-display); font-weight: 700; font-size: 2.1rem; line-height: 0.9; color: var(--color-verde-chiaro); font-variant-numeric: tabular-nums; }
  .br-m-q { font-size: 1rem; line-height: 1.3; color: rgba(255, 255, 255, 0.86); }
  .br-m-corpo { flex: 1; display: flex; flex-direction: column; justify-content: center; }
  .br-m-img { display: block; width: 100%; height: auto; border-radius: 10px; margin-bottom: 1rem; box-shadow: 0 0.8rem 2rem -0.9rem rgba(0, 0, 0, 0.7); }
  .br-m-chi { margin: 0.8rem 0 0; font-size: 0.8rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-verde-chiaro); }
  .br-m-r { margin: 0.15rem 0 0; font-size: 1.1rem; font-weight: 600; line-height: 1.35; text-wrap: pretty; }

  .br-m-pro {
    display: flex; align-items: center; gap: 0.7rem;
    margin: 1rem 0 0; padding-top: 0.85rem; border-top: 1px solid rgba(255, 255, 255, 0.14);
  }
  .br-m-adb { font-size: 1.15rem; }
  .br-m-pro-t { display: flex; flex-direction: column; min-width: 0; line-height: 1.3; }
  .br-m-pro-t strong { font-size: 1rem; font-weight: 700; color: var(--color-paper); }
  .br-m-pro-t span { font-size: 1rem; color: rgba(255, 255, 255, 0.72); }
  .br-pc, .br-parl { justify-content: center; border-top: 1px solid rgba(255, 255, 255, 0.1); }
  .br-h { margin: 0; font-family: var(--font-display); font-weight: 700; font-size: 1.5rem; line-height: 1.2; text-wrap: balance; }
  .br-l { margin: 0.7rem 0 0; color: rgba(255, 255, 255, 0.88); text-wrap: pretty; }
  .br-cont { margin-top: 1.4rem; }
  .br-az { display: grid; gap: 0.75rem; margin-top: 1.4rem; }
  .br-btn {
    display: flex; align-items: center; justify-content: center; min-height: 48px; padding: 0 1.2rem;
    border-radius: 999px; border: 1.5px solid rgba(255, 255, 255, 0.6);
    color: var(--color-paper); font-weight: 600; text-decoration: none; text-align: center;
  }
  .br-btn--pieno { background: var(--color-cta); border-color: var(--color-cta); color: var(--color-on-cta); }
  .br-btn:focus-visible { outline: 2px solid var(--color-verde-chiaro); outline-offset: 3px; }
  .br-nota { margin-top: 2.2rem; padding-top: 1.1rem; border-top: 1px solid rgba(255, 255, 255, 0.16); font-size: 1rem; color: rgba(255, 255, 255, 0.7); }
  .br ::selection { background: var(--color-verde-chiaro); color: var(--color-night); }
</style>
