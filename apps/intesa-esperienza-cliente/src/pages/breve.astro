---
/**
 * LA PAGINA BREVE — il libro di Giulia, sul telefono (owner, 19 nov 2026).
 *
 * Chi apre il link dal telefono lo fa di solito dalla posta, per pochi secondi: il
 * deck lì non si legge, e questa pagina lo sostituisce. Si sfoglia come un libro, una
 * schermata alla volta (scroll-snap, come il diario de «L'ora in più»):
 *   copertina (il volto di Giulia) → prologo (chi è, e l'indice dei sette momenti) →
 *   sette momenti (la sua scena, quello che vede, quello che fa la banca, il prodotto)
 *   → la storia intera → «Parliamone».
 * Le righe dei momenti vengono da `momenti.ts`, le stesse delle slide.
 * VOCE (owner, 19 nov 2026): i pulsanti al «tu», perché sono il gesto di una persona sul
 * suo telefono; il testo in terza persona, senza «voi» («i sistemi della banca»), così
 * «tu» e «voi» non si mescolano mai nella stessa frase. Nel deck resta il «voi».
 * Esiste solo nella build lettura. Non è un DeckContainer: è una pagina.
 */
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import CoBrand from '../components/CoBrand.astro';
import Contatti from '../components/Contatti.astro';
import ContaAperture from '@edf/core/blocks/immersive/ContaAperture.astro';
import { TITOLO_INCONTRO } from '../data/agenda';
import { MOMENTI } from '../data/momenti';
import ritratto from '../assets/generated/persona-giulia.webp';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const intero = new URL(base, Astro.site).href;
const mandami = `mailto:?subject=${encodeURIComponent('Adobe × Intesa Sanpaolo · la storia intera')}&body=${encodeURIComponent(intero)}`;

/* Le scene dei momenti: le stesse fotografie delle slide (Adobe Firefly). */
const SCENE = import.meta.glob<{ default: ImageMetadata }>('../assets/generated/scena-0*.webp', { eager: true });
const scena = (nome: string) => SCENE[`../assets/generated/${nome}.webp`]?.default;
---
<BaseLayout title="In breve">
  <main class="br">
    {/* La barra dei sette momenti: compare solo mentre si sfogliano. */}
    <ol class="br-filo" aria-hidden="true">
      {MOMENTI.map((m) => <li data-filo={m.n}></li>)}
    </ol>

    {/* COPERTINA: il volto, il titolo, il gesto. */}
    <header class="br-pg br-cop">
      <Image class="br-cop-foto" src={ritratto} widths={[480, 800, 1200]} sizes="100vw" alt="" loading="eager" fetchpriority="high" />
      <div class="br-cop-in">
        <CoBrand variant="hero" class="br-lockup edf-cobrand--on-dark" />
        <div class="br-cop-giu">
          <h1 class="br-t">{TITOLO_INCONTRO.t.it}</h1>
          <p class="br-s">{TITOLO_INCONTRO.s.it}</p>
          <a class="br-sfoglia" href="#br-prologo">Sfoglia la storia<span aria-hidden="true">↓</span></a>
        </div>
      </div>
    </header>

    {/* PROLOGO: chi è Giulia, detto subito, e l'indice come in un libro. */}
    <section class="br-pg br-pro" id="br-prologo" aria-labelledby="br-pro-t">
      <h2 class="br-pro-t" id="br-pro-t">Giulia, 34 anni</h2>
      <p class="br-pro-l">È un personaggio inventato. Cerca il primo mutuo, a Torino, e non è ancora cliente di Intesa Sanpaolo.</p>
      <p class="br-pro-l">La storia la segue in sette momenti, dalla prima domanda alla firma, e accanto a ogni suo gesto mostra la risposta della banca con le soluzioni Adobe.</p>
      <ol class="br-indice">
        {MOMENTI.map((m) => (
          <li><a href={`#m-${m.n}`}><span class="br-ind-n">{m.n}</span><span class="br-ind-t">{m.ora.it}<small>{m.dove.it}</small></span></a></li>
        ))}
      </ol>
    </section>

    {/* I SETTE MOMENTI: la scena di lei, quello che vede, quello che fa la banca. */}
    {MOMENTI.map((m, i) => {
      const foto = scena(m.cliente.scena);
      return (
        <section class="br-pg br-m" id={`m-${m.n}`} data-momento={m.n} aria-label={`Momento ${m.n}: ${m.ora.it}`}>
          <div class="br-m-scena">
            {foto && <Image class="br-m-foto" src={foto} widths={[480, 800]} sizes="100vw" alt="" loading="lazy" />}
            <p class="br-m-n" aria-hidden="true">{m.n}</p>
            <div class="br-m-quando">
              <p class="br-m-ora">{m.ora.it}</p>
              <p class="br-m-dove">{m.dove.it}</p>
            </div>
          </div>
          <img class="br-m-mock" src={`${base}miniature/lettura/m-0${i + 1}.jpg`} alt="" loading="lazy" decoding="async" />
          <div class="br-m-testo">
            <p class="br-m-chi">Giulia</p>
            <p class="br-m-r">{m.cliente.titolo.it}</p>
            <p class="br-m-chi">La banca</p>
            <p class="br-m-r">{m.interno.titolo.it}</p>
            <p class="br-m-pro">
              <span class="adb-tile br-m-adb" role="img" aria-label="Adobe"></span>
              <span class="br-m-pro-t"><strong>{m.prodotto}</strong><span>{m.funzione.it}</span></span>
            </p>
          </div>
        </section>
      );
    })}

    <section class="br-pg br-pc" aria-labelledby="br-pc-t">
      <h2 class="br-h" id="br-pc-t">La storia intera, con le schermate dei prodotti</h2>
      <p class="br-l">Momento per momento, con quello che succede nei sistemi della banca. Dà il meglio su uno schermo grande.</p>
      <div class="br-az">
        <a class="br-btn br-btn--pieno" href={mandami}>Mandati il link per email</a>
        <a class="br-btn" href={base} data-apri-comunque>Apri qui la versione intera</a>
      </div>
    </section>

    <section class="br-pg br-parl" aria-labelledby="br-parl-t">
      <h2 class="br-h" id="br-parl-t">Parliamone</h2>
      <p class="br-l">Bastano due righe, su un momento di Giulia, su un prodotto o su come si collega ai sistemi della banca.</p>
      <Contatti class="br-cont" />
      <p class="br-nota">Le scene sono generate con Adobe Firefly; il ritratto di Giulia è una foto di repertorio. Contiamo quante volte questa pagina viene aperta, giorno per giorno. Non registriamo chi la apre.</p>
    </section>
  </main>
  <ContaAperture progetto="intesa-storia" pagina="breve" />
</BaseLayout>

<script is:inline>
  (function () {
    document.addEventListener('click', function (e) {
      var a = e.target && e.target.closest && e.target.closest('[data-apri-comunque]');
      if (!a) return;
      try { sessionStorage.setItem('edf:apri-comunque', '1'); } catch (_) {}
    });
    /* Il filo dei momenti e l'arrivo del mockup: si accendono quando un momento
       occupa più di metà schermo. Senza IntersectionObserver tutto resta visibile. */
    if (!('IntersectionObserver' in window)) return;
    var root = document.documentElement;
    root.classList.add('br-vivo');
    var filo = document.querySelector('.br-filo');
    var io = new IntersectionObserver(function (voci) {
      voci.forEach(function (v) {
        if (!v.isIntersecting) return;
        var n = v.target.getAttribute('data-momento');
        v.target.setAttribute('data-visto', '');
        if (filo) {
          filo.toggleAttribute('data-on', !!n);
          filo.querySelectorAll('[data-filo]').forEach(function (li) {
            li.toggleAttribute('data-fatto', !!n && li.getAttribute('data-filo') <= n);
          });
        }
      });
    }, { threshold: 0.55 });
    document.querySelectorAll('.br-pg').forEach(function (s) { io.observe(s); });
  })();
</script>

<style>
  /* Lo sfoglio: la pagina si aggancia all'inizio di ogni schermata. `mandatory`
     regge perché OGNI blocco è un punto d'aggancio; un blocco più alto dello
     schermo si scorre lo stesso al suo interno. */
  :global(html:has(.br)) { scroll-snap-type: y mandatory; background: var(--color-night); }
  .br { color: var(--color-paper); font-family: var(--font-body); font-size: 1rem; line-height: 1.5; background: var(--color-night); }
  .br ::selection { background: var(--color-verde-chiaro); color: var(--color-night); }
  .br-pg {
    position: relative; min-height: 100svh; scroll-snap-align: start;
    padding: max(1.6rem, env(safe-area-inset-top)) 1.25rem max(1.8rem, env(safe-area-inset-bottom));
    display: flex; flex-direction: column;
  }

  /* ── La copertina ───────────────────────────────────────────── */
  .br-cop { padding: 0; overflow: hidden; }
  .br-cop-foto { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 22%; }
  .br-cop::after {
    content: ''; position: absolute; inset: 0;
    background: linear-gradient(180deg, rgb(13 41 1 / 0.55) 0%, rgb(13 41 1 / 0) 22%, rgb(13 41 1 / 0) 38%, rgb(13 41 1 / 0.86) 64%, var(--color-night) 86%);
  }
  .br-cop-in {
    position: relative; z-index: 1; flex: 1; display: flex; flex-direction: column; justify-content: space-between;
    padding: max(1.4rem, env(safe-area-inset-top)) 1.25rem max(1.8rem, env(safe-area-inset-bottom));
  }
  .br-lockup { justify-content: flex-start; }
  .br-t { margin: 0; font-family: var(--font-display); font-weight: 700; font-size: clamp(2.3rem, 10.5vw, 3.2rem); line-height: 1.02; letter-spacing: -0.025em; text-wrap: balance; }
  .br-s { margin: 0.55rem 0 0; font-size: 1.2rem; font-weight: 600; color: var(--color-verde-chiaro); }
  .br-sfoglia {
    display: inline-flex; align-items: center; gap: 0.5rem; margin-top: 1.6rem; min-height: 48px; padding: 0 1.3rem;
    border-radius: 999px; background: var(--color-cta); color: var(--color-on-cta); font-weight: 700; text-decoration: none;
  }
  .br-sfoglia span { display: inline-block; }
  @media (prefers-reduced-motion: no-preference) {
    .br-sfoglia span { animation: br-giu 1.9s cubic-bezier(0.16, 1, 0.3, 1) infinite; }
  }
  @keyframes br-giu { 0%, 55%, 100% { transform: translateY(0); } 28% { transform: translateY(4px); } }

  /* ── Il prologo ─────────────────────────────────────────────── */
  .br-pro { justify-content: center; background: linear-gradient(180deg, var(--color-night) 0%, var(--color-night-2) 100%); }
  .br-pro > * { width: 100%; max-width: 32rem; margin-inline: auto; }
  .br-pro-t { margin-bottom: 1rem; font-family: var(--font-display); font-weight: 700; font-size: 2rem; line-height: 1.1; letter-spacing: -0.015em; }
  .br-pro-l { margin-top: 0; margin-bottom: 0; font-size: 1.1rem; line-height: 1.55; color: rgb(255 255 255 / 0.9); text-wrap: pretty; }
  .br-pro-l + .br-pro-l { margin-top: 0.75rem; }
  .br-indice { list-style: none; margin-top: 1.8rem; padding: 0; border-top: 1px solid rgb(255 255 255 / 0.16); }
  .br-indice a {
    display: grid; grid-template-columns: 2.6rem 1fr; align-items: baseline; gap: 0.4rem; min-height: 48px; padding: 0.55rem 0;
    border-bottom: 1px solid rgb(255 255 255 / 0.1); color: var(--color-paper); text-decoration: none;
  }
  .br-ind-n { font-family: var(--font-display); font-weight: 700; font-size: 1.1rem; color: var(--color-verde-chiaro); font-variant-numeric: tabular-nums; }
  .br-ind-t { font-size: 1.05rem; font-weight: 600; line-height: 1.3; }
  .br-ind-t small { display: block; font-size: 1rem; font-weight: 400; color: rgb(255 255 255 / 0.68); }
  .br-indice a:focus-visible { outline: 2px solid var(--color-verde-chiaro); outline-offset: 2px; }

  /* ── Il momento: la scena in alto, il mockup che sale sopra, le due righe ── */
  .br-m { padding: 0 0 max(1.6rem, env(safe-area-inset-bottom)); }
  .br-m-scena { position: relative; height: 34svh; min-height: 15rem; overflow: hidden; }
  .br-m-foto { width: 100%; height: 100%; object-fit: cover; object-position: 50% 45%; }
  .br-m-scena::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, rgb(13 41 1 / 0.35) 0%, rgb(13 41 1 / 0) 35%, rgb(13 41 1 / 0.7) 78%, var(--color-night) 100%); }
  .br-m-n {
    position: absolute; z-index: 1; right: 1rem; top: max(0.9rem, env(safe-area-inset-top)); margin: 0;
    font-family: var(--font-display); font-weight: 700; font-size: 5.5rem; line-height: 1; letter-spacing: -0.04em;
    color: transparent; -webkit-text-stroke: 1.5px rgb(255 255 255 / 0.85); font-variant-numeric: tabular-nums;
  }
  .br-m-quando { position: absolute; z-index: 1; left: 1.25rem; right: 1.25rem; bottom: 3.6rem; }
  .br-m-ora { margin: 0; font-family: var(--font-display); font-weight: 700; font-size: 1.7rem; line-height: 1.1; text-shadow: 0 2px 14px rgb(0 0 0 / 0.5); }
  .br-m-dove { margin: 0.2rem 0 0; font-size: 1.05rem; color: rgb(255 255 255 / 0.88); text-shadow: 0 2px 10px rgb(0 0 0 / 0.5); }
  .br-m-mock {
    position: relative; z-index: 2; display: block; width: calc(100% - 2.5rem); max-width: 30rem; height: auto; margin: -2.6rem auto 0;
    border-radius: 12px; box-shadow: 0 1.2rem 2.4rem -1rem rgb(0 0 0 / 0.75), 0 0 0 1px rgb(255 255 255 / 0.12);
  }
  .br-m-testo { width: 100%; max-width: 32rem; margin: 0 auto; padding: 0.4rem 1.25rem 0; }
  .br-m-chi { margin: 1rem 0 0; font-size: 0.8rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-verde-chiaro); }
  .br-m-r { margin: 0.2rem 0 0; font-size: 1.12rem; font-weight: 600; line-height: 1.35; text-wrap: pretty; }
  .br-m-pro { display: flex; align-items: center; gap: 0.7rem; margin: 1.1rem 0 0; padding-top: 0.9rem; border-top: 1px solid rgb(255 255 255 / 0.14); }
  .br-m-adb { font-size: 1.15rem; }
  .br-m-pro-t { display: flex; flex-direction: column; min-width: 0; line-height: 1.3; }
  .br-m-pro-t strong { font-size: 1rem; font-weight: 700; }
  .br-m-pro-t span { font-size: 1rem; color: rgb(255 255 255 / 0.72); }

  /* L'unico movimento pensato: il mockup sale sulla scena quando il momento arriva.
     Senza JavaScript (o con il movimento ridotto) è già al suo posto. */
  @media (prefers-reduced-motion: no-preference) {
    :global(html.br-vivo) .br-m .br-m-mock { opacity: 0; transform: translateY(2rem) scale(0.97); }
    :global(html.br-vivo) .br-m[data-visto] .br-m-mock { opacity: 1; transform: none; transition: opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1); }
  }

  /* Il filo dei momenti: sette tratti in alto, accesi fino al momento in lettura. */
  .br-filo {
    position: fixed; z-index: 30; top: 0; left: 0; right: 0; display: flex; gap: 4px; margin: 0;
    padding: max(0.45rem, env(safe-area-inset-top)) 0.75rem 0; list-style: none; pointer-events: none;
    opacity: 0; transition: opacity 0.3s ease;
  }
  .br-filo[data-on] { opacity: 1; }
  .br-filo li { flex: 1; height: 3px; border-radius: 2px; background: rgb(255 255 255 / 0.28); transition: background-color 0.35s ease; }
  .br-filo li[data-fatto] { background: var(--color-paper); }

  /* ── La storia intera, «Parliamone» ─────────────────────────── */
  .br-pc, .br-parl { justify-content: center; }
  .br-pc > *, .br-parl > * { width: 100%; max-width: 32rem; margin-inline: auto; }
  .br-pc { background: linear-gradient(180deg, var(--color-night) 0%, var(--color-night-2) 100%); }
  .br-h { margin: 0; font-family: var(--font-display); font-weight: 700; font-size: 1.6rem; line-height: 1.18; text-wrap: balance; }
  .br-l { margin: 0.7rem 0 0; font-size: 1.05rem; color: rgb(255 255 255 / 0.88); text-wrap: pretty; }
  .br-cont { margin-top: 1.4rem; }
  .br-az { display: grid; gap: 0.75rem; margin-top: 1.5rem; }
  .br-btn {
    display: flex; align-items: center; justify-content: center; min-height: 48px; padding: 0 1.2rem;
    border-radius: 999px; border: 1.5px solid rgb(255 255 255 / 0.6);
    color: var(--color-paper); font-weight: 600; text-decoration: none; text-align: center;
  }
  .br-btn--pieno { background: var(--color-cta); border-color: var(--color-cta); color: var(--color-on-cta); }
  .br-btn:focus-visible, .br-sfoglia:focus-visible { outline: 2px solid var(--color-verde-chiaro); outline-offset: 3px; }
  .br-nota { margin-top: 2rem; padding-top: 1rem; border-top: 1px solid rgb(255 255 255 / 0.16); font-size: 1rem; line-height: 1.5; color: rgb(255 255 255 / 0.66); }
</style>
