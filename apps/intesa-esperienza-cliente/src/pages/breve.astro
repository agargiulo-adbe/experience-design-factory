---
/**
 * LA PAGINA BREVE — il libro di Giulia, sul telefono (owner, 19 nov 2026).
 *
 * Chi apre il link dal telefono lo fa di solito dalla posta, per pochi secondi: il
 * deck lì non si legge, e questa pagina lo sostituisce. Si sfoglia come un libro, una
 * schermata alla volta (scroll-snap, come il diario de «L'ora in più»):
 *   copertina (il volto di Giulia) → prologo (chi è, e l'indice dei sette momenti) →
 *   sette momenti (la sua scena, quello che vede, quello che fa la banca, il prodotto)
 *   → la versione intera (tre schermate vere) → «Parliamone» → il piede.
 * Le righe di Giulia e della banca vengono da `momenti.ts`, le stesse delle slide; la
 * riga del prodotto è scritta qui (CAPACITA), per il telefono.
 * VOCE (owner, 19 nov 2026): i pulsanti al «tu», perché sono il gesto di una persona sul
 * suo telefono; il testo in terza persona, senza «voi», così «tu» e «voi» non si
 * mescolano nella stessa frase. Nel deck resta il «voi».
 * MISURE: un telefono vero, con le barre del browser, ha ~660px utili e non 844. Scena e
 * mockup si misurano in `svh` perché la riga del prodotto stia sempre nello schermo.
 * Esiste solo nella build lettura. Non è un DeckContainer: è una pagina.
 */
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import CoBrand from '../components/CoBrand.astro';
import { CONTATTI, OGGETTO_EMAIL, TESTO_WHATSAPP, PROGETTO_EDIZIONE } from '../data/contatti';
import { conContributi } from '@edf/core/utils/edizione';
import { linkWhatsApp } from '@edf/core/utils/contatti';
import ContaAperture from '@edf/core/blocks/immersive/ContaAperture.astro';
import { TITOLO_INCONTRO } from '../data/agenda';
import { MOMENTI } from '../data/momenti';
import ritratto from '../assets/generated/persona-giulia.webp';
import finestra from '../assets/generated/scena-08-tracce.webp';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const intero = new URL(base, Astro.site).href;
const mandami = `mailto:?subject=${encodeURIComponent('Adobe × Intesa Sanpaolo · la storia intera')}&body=${encodeURIComponent(intero)}`;
const mail = (e: string) => `mailto:${e}?subject=${encodeURIComponent(OGGETTO_EMAIL)}`;

/* Le scene dei momenti: le stesse fotografie delle slide (Adobe Firefly). */
const SCENE = import.meta.glob<{ default: ImageMetadata }>('../assets/generated/scena-0*.webp', { eager: true });
const scena = (nome: string) => SCENE[`../assets/generated/${nome}.webp`]?.default;

/* CHE COSA FA IL PRODOTTO, detto per il telefono (owner, 19 nov 2026): le etichette
   corte della mappa del deck («Più citata dall'AI», «La pratica riparte») qui stanno
   da sole e suonano da slogan. Ogni riga dice un fatto che la riga della banca non dice
   già, preso dalle tessere di `momenti.ts`. */
const CAPACITA: Record<string, string> = {
  '01': 'Suggerisce i contenuti da pubblicare per entrare nelle risposte',
  '02': 'Mostra quale annuncio rende di più, e il brief dopo parte da lì',
  '03': 'Tiene un solo profilo di Giulia per sito, email e annunci, aggiornato in tempo reale',
  '04': 'Sceglie la Next Best Experience, nel rispetto di consenso e regole',
  '05': 'Coordina email, sito e annunci in un solo percorso',
  '06': 'Il gestore la accoglie sapendo già quale mutuo ha simulato e dove si è fermata',
  '07': 'Misura quanto rende ogni canale, dalla prima visita alla firma',
};
---
<BaseLayout title="In breve">
  <main class="br">
    {/* La barra dei sette momenti: compare solo mentre si sfogliano. */}
    <ol class="br-filo" aria-hidden="true">
      {MOMENTI.map((m) => <li data-filo={m.n}></li>)}
    </ol>

    {/* COPERTINA: il volto, il titolo, il gesto. */}
    <header class="br-pg br-cop">
      <Image class="br-cop-foto" src={ritratto} widths={[480, 800, 1200]} sizes="100vw" alt="" loading="eager" fetchpriority="high" />
      <div class="br-cop-in">
        <CoBrand variant="hero" class="br-lockup edf-cobrand--on-dark" />
        <div class="br-cop-giu">
          <h1 class="br-t">{TITOLO_INCONTRO.t.it}</h1>
          <p class="br-s">{TITOLO_INCONTRO.s.it}</p>
          <a class="br-sfoglia" href="#br-prologo">Sfoglia la storia<span aria-hidden="true">↓</span></a>
        </div>
      </div>
    </header>

    {/* PROLOGO: chi è Giulia e l'indice, come in un libro. Che sia inventata lo dice
        una pillola accanto al nome, non la prima frase (owner, 19 nov 2026). */}
    <section class="br-pg br-pro" id="br-prologo" aria-labelledby="br-pro-t">
      <h2 class="br-pro-t" id="br-pro-t">Giulia, 34&nbsp;anni</h2>
      <span class="br-pill">personaggio di fantasia</span>
      <p class="br-pro-l">Cerca il primo mutuo per una casa a Torino e non è ancora cliente di Intesa Sanpaolo.</p>
      <p class="br-pro-l">Il suo percorso va dalla prima domanda a un assistente AI fino alla firma, in sette momenti. In ognuno si vede che cosa fa lei e come risponde la banca con le soluzioni Adobe.</p>
      <ol class="br-indice">
        {MOMENTI.map((m) => (
          <li><a href={`#m-${m.n}`}><span class="br-ind-n">{m.n}</span><span class="br-ind-t">{m.ora.it}<small>{m.dove.it}</small></span></a></li>
        ))}
      </ol>
    </section>

    {/* I SETTE MOMENTI: la scena di lei, quello che vede, quello che fa la banca. */}
    {MOMENTI.map((m, i) => {
      const foto = scena(m.cliente.scena);
      return (
        <section class="br-pg br-m" id={`m-${m.n}`} data-momento={m.n} aria-label={`Momento ${m.n}: ${m.ora.it}`}>
          <div class="br-scena">
            {foto && <Image class="br-scena-foto" src={foto} widths={[480, 800]} sizes="100vw" alt="" loading="lazy" />}
            <p class="br-ff">Generata con Adobe Firefly</p>
            <p class="br-m-n" aria-hidden="true">{m.n}</p>
            <div class="br-scena-t">
              <p class="br-m-ora">{m.ora.it}</p>
              <p class="br-m-dove">{m.dove.it}</p>
            </div>
          </div>
          <img class="br-m-mock" src={`${base}miniature/lettura/m-0${i + 1}.jpg`} alt="" loading="lazy" decoding="async" />
          <div class="br-m-testo">
            <p class="br-m-chi">Giulia</p>
            <p class="br-m-r">{m.cliente.titolo.it}</p>
            <p class="br-m-chi">La banca</p>
            <p class="br-m-r">{m.interno.titolo.it}</p>
            <p class="br-m-pro">
              <span class="adb-tile br-m-adb" role="img" aria-label="Adobe"></span>
              <span class="br-m-pro-t"><strong>{m.prodotto}</strong><span>{CAPACITA[m.n]}</span></span>
            </p>
          </div>
        </section>
      );
    })}

    {/* LA VERSIONE INTERA: si mostra, non si descrive. Una sola immagine calma, la sua
        copertina dentro un portatile: tre schermate a ventaglio dicevano «complicato». */}
    <section class="br-pg br-pc" aria-labelledby="br-pc-t">
      <div class="br-pc-pc" aria-hidden="true">
        <div class="br-pc-schermo"><img src={`${base}miniature/lettura/d-copertina.jpg`} alt="" loading="lazy" decoding="async" /></div>
        <div class="br-pc-base"></div>
      </div>
      <div class="br-pc-testo">
        <h2 class="br-h" id="br-pc-t">Questo è solo il riassunto</h2>
        <p class="br-l">La versione completa mostra, per ogni momento, le schermate dei prodotti e quello che succede nei sistemi della banca. È pensata per uno schermo grande.</p>
        <div class="br-az">
          <a class="br-btn br-btn--pieno" href={mandami}>Invia il link a te stesso</a>
          <a class="br-btn" href={base} data-apri-comunque>Aprila qui comunque</a>
        </div>
      </div>
    </section>

    {/* PARLIAMONE: la scena del telefono sul davanzale, poi le tre persone in righe. */}
    <section class="br-pg br-m br-parl" aria-labelledby="br-parl-t">
      <div class="br-scena br-scena--parl">
        <Image class="br-scena-foto" src={finestra} widths={[480, 800]} sizes="100vw" alt="" loading="lazy" />
        <p class="br-ff">Generata con Adobe Firefly</p>
        <div class="br-scena-t">
          <h2 class="br-m-ora" id="br-parl-t">Parliamone</h2>
          <p class="br-m-dove">Bastano due righe, su un momento di Giulia, su un prodotto o su come si collega ai sistemi della banca.</p>
        </div>
      </div>
      <ul class="br-pers">
        {CONTATTI.map((c) => (
          <li class="br-per">
            <span class="br-per-ft" style={`--ritratto: url('${c.foto.src}')`} aria-hidden="true"></span>
            <span class="br-per-chi"><strong>{c.nome}</strong><span>{c.ruolo}</span></span>
            <span class="br-per-az">
              <a class="br-per-a" href={mail(c.email)}>Scrivi</a>
              {c.whatsapp && <a class="br-per-a" href={linkWhatsApp(c.whatsapp, TESTO_WHATSAPP)} target="_blank" rel="noopener">WhatsApp</a>}
            </span>
          </li>
        ))}
      </ul>
      {/* Versione B: il modulo anonimo, per chi non vuole scrivere a una persona. */}
      {conContributi() && (
        <p class="br-anon">
          <button type="button" class="br-per-a br-anon-b" data-contributo-apri data-sezione="La storia in breve">Fateci una domanda, anche senza firmarvi</button>
        </p>
      )}
    </section>

    {/* IL PIEDE: chi l'ha preparata, da dove vengono le immagini, che cosa si conta. */}
    <footer class="br-piede">
      <CoBrand variant="hero" class="br-piede-lockup edf-cobrand--on-dark" />
      <p class="br-piede-k">Storia preparata dal team Adobe Italia per Intesa Sanpaolo</p>
      <dl class="br-piede-dl">
        <div><dt>Immagini</dt><dd>Le scene sono generate con Adobe Firefly. Il ritratto di Giulia è una foto di repertorio.</dd></div>
        <div><dt>Misura</dt><dd>Contiamo quante volte questa pagina viene aperta, giorno per giorno. Non registriamo chi la apre.</dd></div>
        {conContributi() && <div><dt>Modulo</dt><dd>Non chiede nome né contatto e lo legge il team Adobe dell’account. Per una risposta diretta vi fa scrivere per email.</dd></div>}
      </dl>
    </footer>
  </main>
  <ContaAperture progetto={PROGETTO_EDIZIONE} pagina="breve" />
</BaseLayout>

<script is:inline>
  (function () {
    document.addEventListener('click', function (e) {
      var a = e.target && e.target.closest && e.target.closest('[data-apri-comunque]');
      if (!a) return;
      try { sessionStorage.setItem('edf:apri-comunque', '1'); } catch (_) {}
    });
    /* Il filo dei momenti e l'arrivo del mockup: si accendono quando un momento
       occupa più di metà schermo. Senza IntersectionObserver tutto resta visibile. */
    if (!('IntersectionObserver' in window)) return;
    document.documentElement.classList.add('br-vivo');
    var filo = document.querySelector('.br-filo');
    var io = new IntersectionObserver(function (voci) {
      voci.forEach(function (v) {
        if (!v.isIntersecting) return;
        var n = v.target.getAttribute('data-momento');
        v.target.setAttribute('data-visto', '');
        if (filo) {
          filo.toggleAttribute('data-on', !!n);
          filo.querySelectorAll('[data-filo]').forEach(function (li) {
            li.toggleAttribute('data-fatto', !!n && li.getAttribute('data-filo') <= n);
          });
        }
      });
    }, { threshold: 0.55 });
    document.querySelectorAll('.br-pg').forEach(function (s) { io.observe(s); });
  })();
</script>

<style>
  /* Lo sfoglio: la pagina si aggancia all'inizio di ogni schermata. `mandatory`
     regge perché OGNI blocco è un punto d'aggancio (il piede si aggancia in fondo). */
  :global(html:has(.br)) { scroll-snap-type: y mandatory; background: var(--color-night); }
  .br { color: var(--color-paper); font-family: var(--font-body); font-size: 1rem; line-height: 1.5; background: var(--color-night); }
  .br ::selection { background: var(--color-verde-chiaro); color: var(--color-night); }
  /* LO SCORCIO DELLA PAGINA DOPO (owner, 19 nov 2026): su Safari, scorrendo in giù la
     barra si ritira e lo schermo cresce da `svh` a `lvh`. Pagine alte `svh` lasciavano
     vedere l'inizio della successiva; in su la barra tornava e la copriva. Ora ogni pagina
     è alta `lvh` (lo schermo senza barra) e il contenuto sta nei primi `svh`: lo spazio in
     più è fondo della pagina stessa. Su desktop svh = lvh e non cambia niente. */
  .br-pg {
    --br-barra: calc(100lvh - 100svh);
    position: relative; min-height: 100svh; min-height: 100lvh; scroll-snap-align: start;
    padding: max(1.6rem, env(safe-area-inset-top)) 1.25rem calc(max(1.6rem, env(safe-area-inset-bottom)) + var(--br-barra, 0px));
    display: flex; flex-direction: column;
  }

  /* ── La copertina ───────────────────────────────────────────── */
  .br-cop { padding: 0 0 var(--br-barra, 0px); overflow: hidden; }
  .br-cop-foto { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 22%; }
  .br-cop::after {
    content: ''; position: absolute; inset: 0;
    background: linear-gradient(180deg, rgb(13 41 1 / 0.55) 0%, rgb(13 41 1 / 0) 22%, rgb(13 41 1 / 0) 38%, rgb(13 41 1 / 0.86) 64%, var(--color-night) 86%);
  }
  .br-cop-in {
    position: relative; z-index: 1; flex: 1; display: flex; flex-direction: column; justify-content: space-between;
    padding: max(1.4rem, env(safe-area-inset-top)) 1.25rem max(1.8rem, env(safe-area-inset-bottom));
  }
  .br-lockup { justify-content: flex-start; }
  .br-t { margin: 0; font-family: var(--font-display); font-weight: 700; font-size: clamp(2.3rem, 10.5vw, 3.2rem); line-height: 1.02; letter-spacing: -0.025em; text-wrap: balance; }
  .br-s { margin: 0.55rem 0 0; font-size: 1.2rem; font-weight: 600; color: var(--color-verde-chiaro); }
  .br-sfoglia {
    display: inline-flex; align-items: center; gap: 0.5rem; margin-top: 1.6rem; min-height: 48px; padding: 0 1.3rem;
    border-radius: 999px; background: var(--color-cta); color: var(--color-on-cta); font-weight: 700; text-decoration: none;
  }
  .br-sfoglia span { display: inline-block; }
  @media (prefers-reduced-motion: no-preference) {
    .br-sfoglia span { animation: br-giu 1.9s cubic-bezier(0.16, 1, 0.3, 1) infinite; }
  }
  @keyframes br-giu { 0%, 55%, 100% { transform: translateY(0); } 28% { transform: translateY(4px); } }

  /* ── Il prologo ─────────────────────────────────────────────── */
  .br-pro { justify-content: center; background: linear-gradient(180deg, var(--color-night) 0%, var(--color-night-2) 100%); }
  .br-pro > * { width: 100%; max-width: 32rem; margin-inline: auto; }
  .br-pro > .br-pill { width: fit-content; max-width: none; margin-inline: 0 auto; }
  .br-pro-t { margin-bottom: 1rem; font-family: var(--font-display); font-weight: 700; font-size: 2rem; line-height: 1.15; letter-spacing: -0.015em; }
  .br-pro-t { margin-bottom: 0.55rem; }
  .br-pill {
    display: block; width: fit-content; margin: 0 0 1rem; padding: 0.15rem 0.6rem; border-radius: 999px;
    border: 1px solid rgb(185 230 163 / 0.55); color: var(--color-verde-chiaro);
    font-family: var(--font-body); font-size: 0.8rem; font-weight: 600; letter-spacing: 0.02em; white-space: nowrap;
  }
  .br-pro-l { margin-top: 0; margin-bottom: 0; font-size: 1.1rem; line-height: 1.55; color: rgb(255 255 255 / 0.9); text-wrap: pretty; }
  .br-pro-l + .br-pro-l { margin-top: 0.75rem; }
  .br-indice { list-style: none; margin-top: 1.2rem; padding: 0; border-top: 1px solid rgb(255 255 255 / 0.16); }
  .br-indice a {
    display: grid; grid-template-columns: 2.6rem 1fr; align-items: baseline; gap: 0.4rem; min-height: 44px; padding: 0.3rem 0;
    border-bottom: 1px solid rgb(255 255 255 / 0.1); color: var(--color-paper); text-decoration: none;
  }
  .br-ind-n { font-family: var(--font-display); font-weight: 700; font-size: 1.1rem; color: var(--color-verde-chiaro); font-variant-numeric: tabular-nums; }
  .br-ind-t { font-size: 1.05rem; font-weight: 600; line-height: 1.3; }
  .br-ind-t small { display: block; font-size: 1rem; font-weight: 400; color: rgb(255 255 255 / 0.68); }
  .br-indice a:focus-visible { outline: 2px solid var(--color-verde-chiaro); outline-offset: 2px; }

  /* ── La scena (momenti e «Parliamone») ──────────────────────── */
  .br-m { padding: 0 0 calc(max(1.2rem, env(safe-area-inset-bottom)) + var(--br-barra, 0px)); }
  .br-scena { position: relative; flex: none; height: 30svh; min-height: 11rem; overflow: hidden; }
  .br-scena-foto { width: 100%; height: 100%; object-fit: cover; object-position: 50% 45%; }
  .br-scena::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, rgb(13 41 1 / 0.4) 0%, rgb(13 41 1 / 0) 32%, rgb(13 41 1 / 0.72) 76%, var(--color-night) 100%); }
  .br-scena-t { position: absolute; z-index: 1; left: 1.25rem; right: 1.25rem; bottom: 2.9rem; }
  .br-m-ora { margin: 0; font-family: var(--font-display); font-weight: 700; font-size: 1.6rem; line-height: 1.1; text-shadow: 0 2px 14px rgb(0 0 0 / 0.5); }
  .br-m-dove { margin: 0.2rem 0 0; font-size: 1.05rem; color: rgb(255 255 255 / 0.9); text-shadow: 0 2px 10px rgb(0 0 0 / 0.55); }
  .br-m-n {
    position: absolute; z-index: 1; right: 1rem; top: max(0.9rem, env(safe-area-inset-top)); margin: 0;
    font-family: var(--font-display); font-weight: 700; font-size: 4.6rem; line-height: 1; letter-spacing: -0.04em;
    color: transparent; -webkit-text-stroke: 1.5px rgb(255 255 255 / 0.85); font-variant-numeric: tabular-nums;
  }
  /* LA FILIGRANA DI FIREFLY (owner, 19 nov 2026): la pillola col marchio sembrava un
     prodotto della storia. Qui è solo testo, piccolo e trasparente, nell'angolo libero
     della scena, in alto a sinistra (il numero sta a destra, il titolo in basso). */
  .br-ff {
    position: absolute; z-index: 1; left: 1.25rem; top: max(1.25rem, calc(env(safe-area-inset-top) + 0.8rem)); margin: 0;
    font-size: 0.6rem; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; white-space: nowrap;
    color: rgb(255 255 255 / 0.45); text-shadow: 0 1px 6px rgb(0 0 0 / 0.4); pointer-events: none;
  }

  /* Il mockup sale sulla scena; alto al massimo il 30% dello schermo, così la riga del
     prodotto resta dentro anche su un telefono vero con le barre del browser. */
  .br-m-mock {
    position: relative; z-index: 2; display: block; width: auto; max-width: calc(100% - 2.5rem); max-height: 30svh; height: auto;
    margin: -2.2rem auto 0; border-radius: 12px; box-shadow: 0 1.2rem 2.4rem -1rem rgb(0 0 0 / 0.75), 0 0 0 1px rgb(255 255 255 / 0.12);
  }
  .br-m-testo { width: 100%; max-width: 32rem; margin: 0 auto; padding: 0 1.25rem; }
  .br-m-chi { margin: 0.75rem 0 0; font-size: 0.78rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-verde-chiaro); }
  .br-m-r { margin: 0.12rem 0 0; font-size: 1.05rem; font-weight: 600; line-height: 1.32; text-wrap: pretty; }
  .br-m-pro { display: flex; align-items: center; gap: 0.7rem; margin: 0.85rem 0 0; padding-top: 0.75rem; border-top: 1px solid rgb(255 255 255 / 0.14); }
  .br-m-adb { font-size: 1.1rem; }
  .br-m-pro-t { display: flex; flex-direction: column; min-width: 0; line-height: 1.3; }
  .br-m-pro-t strong { font-size: 1rem; font-weight: 700; }
  .br-m-pro-t span { font-size: 1rem; color: rgb(255 255 255 / 0.74); }

  /* L'unico movimento pensato: il mockup sale sulla scena quando il momento arriva. */
  @media (prefers-reduced-motion: no-preference) {
    :global(html.br-vivo) .br-m .br-m-mock { opacity: 0; transform: translateY(2rem) scale(0.97); }
    :global(html.br-vivo) .br-m[data-visto] .br-m-mock { opacity: 1; transform: none; transition: opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1); }
  }

  /* Il filo dei momenti: sette tratti in alto, accesi fino al momento in lettura. */
  .br-filo {
    position: fixed; z-index: 30; top: 0; left: 0; right: 0; display: flex; gap: 4px; margin: 0;
    padding: max(0.45rem, env(safe-area-inset-top)) 0.75rem 0; list-style: none; pointer-events: none;
    opacity: 0; transition: opacity 0.3s ease;
  }
  .br-filo[data-on] { opacity: 1; }
  .br-filo li { flex: 1; height: 3px; border-radius: 2px; background: rgb(255 255 255 / 0.28); transition: background-color 0.35s ease; }
  .br-filo li[data-fatto] { background: var(--color-paper); }

  /* ── La versione intera: tre schermate a ventaglio, poi il testo ── */
  .br-pc { justify-content: center; gap: 2.2rem; background: radial-gradient(120% 70% at 50% 18%, var(--color-night-2) 0%, var(--color-night) 70%); }
  /* Il portatile: due forme, nessun dettaglio. Lo schermo porta la copertina. */
  .br-pc-pc { width: 100%; max-width: 21rem; margin: 0 auto; }
  .br-pc-schermo {
    padding: 0.45rem; border-radius: 12px 12px 4px 4px; background: #0a1404;
    box-shadow: 0 0 0 1px rgb(255 255 255 / 0.16), 0 1.6rem 3rem -1.4rem rgb(0 0 0 / 0.85);
