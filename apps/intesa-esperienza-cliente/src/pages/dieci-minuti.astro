---
/**
 * «In dieci minuti» — la Storia quando l'ora concessa diventa venti
 * minuti, e la versione che l'interlocutore gira al suo capo.
 *
 * ⚠️ PERCHÉ ESISTE (detto in riunione il 29 ott 2026, parole testuali):
 * «Già troppo lungo. […] così solo sta roba ci leva 40 minuti.» Il
 * percorso intero resta, perché serve a chi ha l'ora; questo è lo stesso
 * racconto in sei slide.
 *
 * ⚠️ 11 NOV 2026 (panel): il taglio non rispondeva a «e il nostro motore?».
 * Entra «Accanto», dall'innesto, ridotta alla posizione su cui si decide e
 * alla riga di confine — dalla fonte unica `data/innesto.ts`. Per restare a
 * sei esce la slide della protagonista: Giulia arriva comunque col suo
 * ritratto e il suo nome nella slide del momento.
 *
 * ⚠️ NON È UNA COPIA. Ogni blocco viene dalla fonte unica — `MOMENTI`,
 * `referenze.ts` — e i componenti sono gli stessi. Un taglio che tiene
 * una copia a mano degli stessi numeri diverge sempre, e diverge sempre
 * il corto, perché le correzioni arrivano sul lungo. Il gate è
 * `pnpm audit:taglio`.
 *
 * E un taglio è una versione BREVE, non una versione SPENTA: stessa
 * firma co-brand, stessa clip in copertina, stesso guscio.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import CoBrand from '../components/CoBrand.astro';
import LoopVideo from '@edf/core/blocks/immersive/LoopVideo.astro';
import T from '@edf/core/blocks/i18n/T.astro';
import { href } from '@edf/core/utils/url.js';
import { MOMENTI, DOMANDE_IN_SLIDE, CORPO_IN_SLIDE } from '../data/momenti';
import { MISURE, ASK, SEGUITO, CASI } from '../data/referenze';
import Caso from '../components/Caso.astro';
import { TITOLO, CONFINE, OGGI, ACCANTO, TAVOLO, IPOTESI, WEB_ANALYTICS } from '../data/innesto';
import { TITOLO_INCONTRO } from '../data/agenda';
import '../styles/innesto.css';
/* TUTTE le misure, dalla stessa fonte di «prossimi-passi/slide-da-voi»
   (panel dell'11 nov 2026: il taglio ne portava quattro su sei, e mancavano
   quelle che Controllo di Gestione e Rete chiedono ad alta voce). Dove la
   fonte ha un campo breve accanto (`lBreve`, `oggiBreve`, `poiBreve`) il
   taglio usa quello: stesso oggetto, meno parole, mai un altro elenco. */
type Bil = { it: string; en: string };
const corto = (m: (typeof MISURE)[number], k: 'l' | 'oggi' | 'poi'): Bil =>
  ((m as unknown as Record<string, Bil | undefined>)[`${k}Breve`]) ?? m[k];
import CircoloJourney from '../components/CircoloJourney.astro';
import MockCliente from '../components/MockCliente.astro';
import MockAdobe from '../components/MockAdobe.astro';
import DaVerificare from '../components/DaVerificare.astro';
import Azione from '../components/Azione.astro';
import ritratto from '../assets/generated/persona-giulia.webp';
import scena from '../assets/generated/scena-03-tavolo.webp';
import fondo from '../assets/generated/fondo-risultati.webp';

const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;
const CLIP = 'https://github.com/agargiulo-adbe/experience-design-factory/releases/download/media';

/* Il momento che porta la differenza: da visita anonima a persona con un
   nome. È il terzo, ed è quello in cui la piattaforma fa una cosa che il
   CRM non può fare, perché il CRM conosce i clienti. */
const M = MOMENTI[2];
---
<BaseLayout title="In dieci minuti">
  <div class="fixed top-0 left-0 right-0 z-50">
    <Navigation currentPath={currentPath} base={base} />
  </div>

  <DeckContainer nextHref={href(base, '/')} prevHref={href(base, '/')}>

    <Slide id="slide-cover" bg="inverse" align="center"
           data-made-with="Adobe Firefly" data-made-with-for="clip" data-audio="loud">
      <LoopVideo slot="backdrop" src={`${CLIP}/innesto-cover.loop.mp4`}
                 poster={`${base}media/innesto-cover.poster.jpg`}
                 scrim="im-clip-scrim" opacity={1} />
      <div class="im-cov im-cov--grande" data-reveal>
        <CoBrand variant="hero" class="im-cov-lockup edf-cobrand--on-dark" data-reveal />
        <T as="h1" class="im-cov-t" it={TITOLO_INCONTRO.t.it} en={TITOLO_INCONTRO.t.en} data-reveal data-reveal-delay="0.1" />
        <T as="p" class="im-cop-sot" it={TITOLO_INCONTRO.s.it} en={TITOLO_INCONTRO.s.en} data-reveal data-reveal-delay="0.14" />
        <T as="p" class="im-cov-l"
           it="In dieci minuti: una persona in cerca di casa, e che cosa serve per non perderla."
           en="In ten minutes: someone looking for a home, and what it takes not to lose her."
           data-reveal data-reveal-delay="0.18" />
      </div>
    </Slide>

    <Slide id="slide-giro" bg="inverse" align="center">
      <div slot="backdrop" class="im-bg-notte"></div>
      <div class="im-cerslide" data-reveal>
        <T as="p" class="im-mom-blocco" it="Il percorso, in un giro" en="The path, as one loop" />
        <T as="h2" class="im-cerslide-t" it="Giulia diventa cliente in sette momenti" en="Giulia becomes a customer in seven moments" data-reveal data-reveal-delay="0.08" />
        <CircoloJourney grande data-reveal data-reveal-delay="0.16" />
        <T as="p" class="im-cerslide-l" it="Per ogni fermata: il canale, quello che fa lei, e quello che fate voi." en="For each stop: the channel, what she does, and what you do." data-reveal data-reveal-delay="0.26" /> {/* copy-audit-ignore · L3 — parallelo voluto: il suo lato e il vostro. La forma breve («la sua mossa e la vostra») scende del 19%, fuori dal contratto di lunghezza. */}
      </div>
    </Slide>

    <Slide id="slide-momento" bg="inverse" align="left">
      <div slot="backdrop" class="im-bg-vx" style={`--foto: url('${scena.src}'); --fuoco: center 42%`}></div>
      <div class="im-due" data-reveal>
        <header class="im-due-testa">
          <T as="span" class="im-mom-blocco" data-gruppo={M.gruppo} it={M.blocco.it} en={M.blocco.en} />
          <T as="span" class="im-due-ora" it={`${M.ora.it} · ${M.dove.it}`} en={`${M.ora.en} · ${M.dove.en}`} />
          <span class="im-due-passo">
            <span class="im-due-passo-n">{M.n}</span>
            <span class="im-due-passo-d">/ {M.of}</span>
          </span>
        </header>

        <section class="im-due-banda" data-lato="cliente" data-substep data-side="in">
          <div class="im-due-txt">
            <p class="im-due-chi">
              <img class="im-due-chi-r" src={ritratto.src} alt="" width="120" height="120" loading="eager" />
              <span>
                <T as="span" class="im-due-chi-n" it="Giulia" en="Giulia" />
                <T as="span" class="im-due-chi-q" it="Non ancora cliente" en="Not a customer yet" />
              </span>
            </p>
            <T as="h2" class="im-due-t" it={M.cliente.titolo.it} en={M.cliente.titolo.en} />
            {CORPO_IN_SLIDE && <T as="p" class="im-due-b" it={M.cliente.corpo.it} en={M.cliente.corpo.en} />}
          </div>
          <div class="im-due-mock">
            <MockCliente chrome={M.cliente.chrome} scena="simulazione" compatto />
            <Azione segno={M.cliente.chrome} />
          </div>
        </section>

        <section class="im-due-banda" data-lato="interno" data-substep data-side="in">
          <div class="im-due-txt">
            <p class="im-due-chi">
              <span class="im-due-chi-s" aria-hidden="true">IS</span>
              <span>
                <T as="span" class="im-due-chi-n" it="In Intesa Sanpaolo" en="Inside Intesa Sanpaolo" />
                <T as="span" class="im-due-chi-q" it="Come è stato possibile" en="How it was possible" />
              </span>
            </p>
            <T as="h2" class="im-due-t" it={M.interno.titolo.it} en={M.interno.titolo.en} />
            {CORPO_IN_SLIDE && <T as="p" class="im-due-b" it={M.interno.corpo.it} en={M.interno.corpo.en} />}
            <p class="im-due-pro im-due-tess"><strong>{M.prodotto}</strong><T as="span" it={M.funzione.it} en={M.funzione.en} /></p>
            {DOMANDE_IN_SLIDE && <DaVerificare it={M.verifica.it} en={M.verifica.en} />}
          </div>
          <div class="im-due-mock">
            <MockAdobe prodotto={M.interno.prodotto} compatto />
            <Azione segno={M.gruppo} />
          </div>
        </section>
      </div>
    </Slide>

    {/* La prova: lo stesso caso del percorso intero, stesso componente e
        stesso oggetto, con i campi corti accanto. */}
    <Slide id="slide-prova" bg="secondary" align="left">
      <Caso caso={CASI.tsb} breve />
    </Slide>

    {/* ACCANTO — dall'innesto del percorso intero, ridotto alla posizione su cui
        si decide e alla riga di confine sul motore. Fonte: `data/innesto.ts`. */}
    <Slide id="slide-accanto" bg="inverse" align="left">
      <div slot="backdrop" class="im-bg-notte"></div>
      <div class="im-ado-cap im-ado-cap--largo" data-reveal>
        <T as="h2" class="im-ado-t im-ado-t--stretto" it={TITOLO.it} en={TITOLO.en} />
        <T as="p" class="im-inn-confine" it={CONFINE.it} en={CONFINE.en} />
        <div class="im-acc">
          <ol class="im-inn-oggi">
            {OGGI.map((n, i) => (
              <li class="im-inn-n" data-forte={n.forte ? '' : null}>
                <T as="span" class="im-inn-t" it={n.t.it} en={n.t.en} />
                {n.s && <T as="span" class="im-inn-s" it={n.s.it} en={n.s.en} />}
                <T as="span" class="im-inn-d" it={n.d.it} en={n.d.en} />
                {i > 0 && <svg class="im-inn-fr" viewBox="0 0 28 14" aria-hidden="true"><path d="M1 7h24M19 1l6 6-6 6" /></svg>}
              </li>
            ))}
          </ol>
          <p class="im-acc-giu" data-substep>
            <svg viewBox="0 0 14 28" aria-hidden="true"><path d="M7 1v24M1 19l6 6 6-6" /></svg>
            <span><span data-lang-it>Sopra, sui prospect: Real-Time CDP, Journey Optimizer con AI Decisioning, Customer Journey Analytics.</span><span data-lang-en>On top, for prospects: Real-Time CDP, Journey Optimizer with AI Decisioning, Customer Journey Analytics.</span></span>
          </p>
          <div class="im-accanto" data-substep>
            <T as="span" class="im-accanto-k" it={ACCANTO.k.it} en={ACCANTO.k.en} />
            <T as="strong" class="im-accanto-t" it={ACCANTO.t.it} en={ACCANTO.t.en} />
            <T as="span" class="im-accanto-d" it={ACCANTO.d.it} en={ACCANTO.d.en} />
          </div>
          <T as="p" class="im-acc-wa" it={WEB_ANALYTICS.it} en={WEB_ANALYTICS.en} data-substep />
        </div>
        <p class="im-fonte-riga">
          <span data-lang-it>{IPOTESI.it} </span><span data-lang-en>{IPOTESI.en} </span>
          <a href={`${href(base, '/messa-a-terra')}#slide-innesto`}><span data-lang-it>L’innesto intero →</span><span data-lang-en>The full picture →</span></a>
        </p>
      </div>
    </Slide>

    <Slide id="slide-firma" bg="inverse" align="center"
           data-made-with="Adobe Firefly" data-made-with-for="clip" data-audio="loud">
      <LoopVideo slot="backdrop" src={`${CLIP}/innesto-chiusura.loop.mp4`}
                 poster={`${base}media/innesto-chiusura.poster.jpg`}
                 scrim="im-clip-scrim" opacity={1} />
      <div class="im-firma" data-reveal>
        <CoBrand variant="hero" class="im-cov-lockup edf-cobrand--on-dark" />
        <div class="im-mis im-mis--taglio im-mis--tutte" data-stagger>
          {MISURE.map((m) => (
            <div class="im-mis-b" data-chiave={m.chiave ? '' : null}>
              <T as="p" class="im-mis-l" it={corto(m, 'l').it} en={corto(m, 'l').en} />
              <p class="im-mis-r">
                <span class="im-mis-oggi"><span data-lang-it>{corto(m, 'oggi').it}</span><span data-lang-en>{corto(m, 'oggi').en}</span></span>
                <span class="im-mis-f" aria-hidden="true"></span>
                <span class="im-mis-poi"><span data-lang-it>{corto(m, 'poi').it}</span><span data-lang-en>{corto(m, 'poi').en}</span></span>
              </p>
            </div>
          ))}
        </div>
        <T as="p" class="im-firma-l" it={ASK.it} en={ASK.en} data-reveal data-reveal-delay="0.14" />
        <T as="p" class="im-firma-tavolo" it={SEGUITO.it} en={SEGUITO.en} data-reveal data-reveal-delay="0.2" />
        <T as="p" class="im-firma-tavolo" it={TAVOLO.it} en={TAVOLO.en} data-reveal data-reveal-delay="0.2" />
        <a href={href(base, '/')} class="edf-sig-cta">
          <span data-lang-it>Il percorso intero</span><span data-lang-en>The full path</span>
        </a>
      </div>
    </Slide>

  </DeckContainer>
</BaseLayout>
<style>
  /* La firma del taglio porta tutte le misure: tre colonne invece di due, e
     la colonna si allarga, perché in altezza non c'è posto per un'altra riga. */
  #slide-firma .im-firma { max-width: 78rem; gap: 0.8rem; }
  .im-mis--tutte { max-width: 78rem; grid-template-columns: repeat(3, minmax(0, 1fr)); }
  /* Sette misure su tre colonne lasciano l'ultima sola: occupa la riga intera, come in slide-da-voi. */
  .im-mis--tutte > .im-mis-b:last-child:nth-child(3n + 1) { grid-column: 1 / -1; }
  .im-firma-tavolo { margin: 0; max-width: none; font-size: clamp(1.05rem, 1.05vw, 2.3rem); font-weight: 700; color: #d7f0cd; }
  @media (max-width: 900px) { .im-mis--tutte { grid-template-columns: minmax(0, 1fr); } }
</style>
