---
/**
 * 09 · PROSSIMI PASSI — la fine del percorso.
 *
 * ⚠️ NON È PIÙ UN SEGNAPOSTO (revisione critica, 30 ott 2026). Era un
 * capitolo che dichiarava di essere vuoto, e nel frattempo la risposta
 * alla sua domanda stava tre capitoli prima, dentro le referenze: «Che
 * cosa misureremmo, dal giorno uno» parlava di noi in un capitolo che
 * parla di altre banche, e lì rompeva l'argomento del capitolo.
 * Ora sta qui, dove è la domanda, insieme all'ask — che resta in UN
 * POSTO SOLO, letto dalla fonte unica `referenze.ts` come il taglio «In
 * dieci minuti» (gate `pnpm audit:taglio`).
 *
 * Le tre cose che chiediamo vengono dalla slide 61 del deck del 5
 * novembre («Prossimi passi | che cosa ci serve per la proposta»).
 * ⚠️ Una riga è stata riscritta: l'originale nominava due prodotti di un
 * altro fornitore. In un documento che va al cliente quei nomi non
 * entrano — e la frase funziona meglio senza, perché chiede la mappa dei
 * collegamenti invece di presupporre quali siano.
 *
 * L'ultima slide è la slide-FIRMA, e chiude il PERCORSO: per contratto è
 * una slide a sé (la chiusura densa più il lockup grande sborda).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import CoBrand from '../components/CoBrand.astro';
import T from '@edf/core/blocks/i18n/T.astro';
import { href } from '@edf/core/utils/url.js';
import { CHAPTERS, prevSlug } from '../data/chapters';
import Divisore from '../components/Divisore.astro';
import FiguraCap from '../components/FiguraCap.astro';
import LoopVideo from '@edf/core/blocks/immersive/LoopVideo.astro';
import { MISURE, ASK, TRIMESTRE, SOGLIA } from '../data/referenze';
import HowItWorks from '@edf/core/blocks/HowItWorks.astro';
import fondo from '../assets/generated/cover-passi.webp';
/* La clip sta sul Release `media`, ricucita con `pnpm loop:seamless`. */
const CLIP = 'https://github.com/agargiulo-adbe/experience-design-factory/releases/download/media';

const SLUG = 'prossimi-passi';
const ch = CHAPTERS.find((c) => c.slug === SLUG)!;
const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;

/* Le cose che servono per scrivere una proposta con un perimetro
   invece di un ordine di grandezza. Dalla slide 61 del deck, RIFATTE
   (panel, 30 ott 2026): ogni voce ha la funzione che la possiede e che
   cosa basta mandare; «i profili in dodici mesi» sono la base di prezzo e
   stanno a parte («non toccare», panel dell'11 nov 2026).
   Giro dell'11 nov 2026: ogni voce dice in QUALE TAPPA serve (`quando`);
   la governance passa a «Targeting · Canali · CRM» con la regola di
   precedenza proposta, e la conferma resta loro; fra chi porta i dati
   entra l'Analytics digitale della Divisione; la spesa per canale non si
   chiede alla prima sessione: in fase 0 si disegna il flusso, in fase 1
   la banca la carica nella propria istanza (disaccordo Baa/Rubino,
   risolto in sequenza dall'arbitro). */
/* Le cinque cose da portare: ora in `data/serve.ts`, resa in approfondimenti/slide-serve. */
/* I sistemi della banca con UN nome solo, uguale in innesto, mappa,
   integrazioni e qui (glossario del panel, 11 nov 2026): motore di
   targeting · data warehouse · core banking · CRM di filiale · CDP attuale
   · registro dei consensi. Sta nella card delle integrazioni. */
/* Le fasi del seguito: un piano, non un preventivo.
   ⚠️ Il titolo prometteva «ogni tappa ha un responsabile» e nessuna card
   ne portava uno (panel, 11 nov 2026). Ora `guida` è la funzione della
   banca, `con` chi lavora accanto. Le date sono da fissare in sala. Niente
   importi e niente durate di licenza inventate: dove il fatto non c'è, si
   scrive «da definire». La tappa 1 decide sul digitale ma misura fino
   allo sportello, perché il mutuo si chiude in filiale. */
const FASI = [
  { n: '0', t: { it: 'La progettazione', en: 'The design' },
    guidaBreve: { it: 'Targeting e Group Technology, con Adobe', en: 'Targeting and Group Technology, with Adobe' },
    quandoBreve: { it: 'primo tavolo entro fine novembre, se la banca dice sì', en: 'first table by end of November, if the bank agrees' },
    guida: { it: 'Guidano Targeting e Group Technology, con il responsabile della Divisione, insieme ad Adobe e all’integratore.', en: 'Led by Targeting and Group Technology, with the Division’s owner. Alongside, Adobe and the integrator you choose.' },
    quando: { it: 'I mesi si contano dal sì della banca: primo tavolo, poi la progettazione, che si chiude con le stime di implementazione e di costo.', en: 'Months count from the bank’s yes: first table, then the design, which closes with implementation and cost estimates.' },
    b: { it: 'Si progettano identificativi, eventi, consenso e gruppo di controllo. Il Targeting scrive la regola per scegliere i non‑clienti. Si decide quanto convivono Analytics e CJA.', en: 'Identifiers, events, consent and control group get designed. Targeting writes the rule for picking non-customers. How long Analytics and CJA coexist gets decided.' } },
  { n: '1', t: { it: 'Il mutuo, sui non‑clienti', en: 'The mortgage, on non-customers' },
    guidaBreve: { it: 'Targeting, con Canali e CRM', en: 'Targeting, with Channels and CRM' },
    quandoBreve: { it: 'un trimestre dal primo invio', en: 'one quarter from the first send' },
    guida: { it: 'Guida il Targeting, con Canali e CRM, insieme ad Adobe e all’integratore.', en: 'Led by Targeting, with Channels and CRM. Alongside, Adobe and the integrator.' },
    quando: { it: 'Prima l’implementazione: Web SDK sul sito AEM on-premise e API del CRM di filiale sono il percorso critico, <span class=im-nw>da stimare in fase 0.</span> Poi un trimestre di misura dal primo invio, e gli erogati si leggono il trimestre dopo.', en: 'Implementation first: Web SDK on the on-premise AEM site and the branch CRM APIs are the critical path, to estimate in phase 0. Then a quarter of measurement from the first send; disbursements are read the quarter after.' },
    b: { it: 'Si decide sul digitale e si misura fino allo sportello. L’esito dell’appuntamento lo registra la filiale nel CRM. Licenza con durata minima da definire. A fine trimestre si continua o ci si ferma, e i profili dei non‑clienti si cancellano; per gli erogati restano solo gruppo e codice pratica, pseudonimizzati, con il DPO.', en: 'Decisions on digital, measured up to the counter: the branch records the appointment outcome in the CRM. Licence with a minimum term to be defined. At quarter end it continues or stops, and non-customer profiles are deleted; for disbursements only group and file code remain, pseudonymised, with the DPO.' } },
  { n: '2', t: { it: 'Dopo il trimestre', en: 'After the quarter' },
    guidaBreve: { it: 'Targeting, con il prodotto', en: 'Targeting, with product' },
    quandoBreve: { it: 'un caso alla volta, se la soglia è raggiunta', en: 'one case at a time, if the threshold is met' },
    guida: { it: 'Guida il Targeting, con il prodotto, insieme ad Adobe e all’integratore.', en: 'Led by Targeting, with product. Alongside, Adobe and the integrator.' },
    quando: { it: 'Un caso alla volta, solo <span class=im-nw>se la soglia è raggiunta.</span>', en: 'One case at a time, only if the threshold is met.' },
    b: { it: 'Prima il cross-sell dopo la firma, poi gli altri casi, ognuno con la sua misura. Sui clienti la classifica resta del vostro motore.', en: 'First cross-sell after signature, then the other cases, each with its own measure. On customers the ranking stays with your engine.' } },
];
/* Perché il mutuo prima del cross-sell: lo chiedono Rete e Targeting. */
const CRITERIO = {
  it: 'Perché il mutuo prima del cross-sell: è un perimetro dove la classifica del vostro motore non si tocca, e dal primo invio la misura si chiude in un trimestre.',
  en: 'Why the mortgage before cross-sell: it is a scope where your engine’s ranking is untouched, and from the first send the measurement closes within a quarter.',
};
/* I TEMI DI OGGI (call del team, 17 nov 2026): chi decide i prossimi passi deve
   ritrovare i temi di cui si è parlato, con i nomi e i colori che ha già visto nel
   deck. Sono i quattro gruppi della codifica a colori (global.css, «la codifica a
   colori dei blocchi dell'offerta») più il Coworker, che sta nel neutro della
   piattaforma come CX Analytics. Ogni tema rimanda al punto del deck dove è stato
   trattato. */
const TEMI = [
  { g: 'trovare', t: { it: 'Farsi trovare', en: 'Brand visibility' }, d: { it: 'Dove gli assistenti AI vi citano, e come esserci dove mancate', en: 'Where AI assistants cite you, and how to show up where you are missing' }, p: 'Brand Visibility', dove: { it: 'Giulia, momento 01', en: 'Giulia, moment 01' }, url: '/momenti/#slide-m-01' },
  { g: 'contenuto', t: { it: 'Content Factory', en: 'Content Factory' }, d: { it: 'Annunci su misura per ogni canale, già validati sul marchio', en: 'Ads tailored to each channel, already checked against the brand' }, p: 'GenStudio for Performance Marketing', dove: { it: 'Giulia, momento 02', en: 'Giulia, moment 02' }, url: '/momenti/#slide-m-02' },
  { g: 'engagement', t: { it: 'Ingaggio clienti e\u00a0non clienti', en: 'Engaging customers and non\u2011customers' }, d: { it: 'Riconoscere chi arriva, scegliere la proposta, riprendere la pratica fino in filiale', en: 'Recognise who arrives, choose the offer, resume the application all the way to the branch' }, p: 'Real-Time Activation · Journey Optimizer', dove: { it: 'Momenti 03–06 · Dove ci innestiamo', en: 'Moments 03–06 · Where we plug in' }, url: '/messa-a-terra/#slide-innesto' },
  { g: 'piattaforma', t: { it: 'CX Analytics', en: 'CX Analytics' }, d: { it: 'Analisi multicanale: dove passa chi compra, e quanto vale ogni canale, filiale compresa', en: 'Cross-channel analysis: the path to a purchase, and what each channel is worth, branch included' }, p: 'Customer Journey Analytics', dove: { it: 'Momento 07 · Dove ci innestiamo', en: 'Moment 07 · Where we plug in' }, url: '/messa-a-terra/#slide-cja-banca' },
  { g: 'piattaforma', t: { it: 'CX Enterprise Coworker', en: 'CX Enterprise Coworker' }, d: { it: 'Audience, contenuti e percorso preparati in una conversazione, fino all’approvazione', en: 'Audience, content and journey prepared in one conversation, up to approval' }, p: 'Adobe CX Enterprise Coworker', dove: { it: 'Capitolo 04', en: 'Chapter 04' }, url: '/coworker/#slide-video' },
] as const;
/* I sei modi di approfondirli (commenti del team, 16 nov 2026). Nessun numero e
   nessun ordine: l'ordine lo danno loro. Il nome della banca della reference call
   non si scrive: lo si dice a voce, se chiedono. */
const INSIEME = [
  { t: { it: 'Sessione con Group Technology', en: 'Session with Group Technology' }, d: { it: 'Architettura, identità e integrazioni, sui vostri sistemi', en: 'Architecture, identity and integrations, on your systems' } },
  { t: { it: 'Demo di dettaglio', en: 'Detailed demo' }, d: { it: 'Un componente alla volta, sui casi che scegliete voi', en: 'One component at a time, on the cases you choose' } },
  { t: { it: 'Executive workshop', en: 'Executive workshop' }, d: { it: 'Ambizione e priorità, con chi decide', en: 'Ambition and priorities, with the decision makers' } },
  { t: { it: 'Business case', en: 'Business case' }, d: { it: 'Il valore, costruito sui vostri numeri', en: 'The value, built on your own numbers' } },
  { t: { it: 'Reference call', en: 'Reference call' }, d: { it: 'Con una banca che lo fa già', en: 'With a bank already doing it' } },
  { t: { it: 'Un incontro per dipartimento', en: 'One meeting per department' }, d: { it: 'Marketing, Advanced Analytics, Controllo di Gestione, IT', en: 'Marketing, Advanced Analytics, Management Control, IT' } },
];
---
<BaseLayout title={ch.title.it}>
  <div class="fixed top-0 left-0 right-0 z-50">
    <Navigation currentPath={currentPath} base={base} />
  </div>

  <DeckContainer nextHref={href(base, '/')} prevHref={href(base, prevSlug(SLUG))}>

    <Slide id="slide-cover" bg="secondary" align="left" data-made-with="Adobe Firefly" data-made-with-for="sfondo">
      <div slot="backdrop" class="im-div-bg" style={`--foto: url('${fondo.src}'); --fuoco: 34% 62%`}></div>
      <Divisore num={ch.num}
        tIt="I prossimi passi" tEn="Next steps" />
    </Slide>

    {/* ── DA QUI, INSIEME (team, 16 nov 2026) ─────────────────────────
        Il primo incontro non chiude una proposta: apre il confronto. Niente
        trimestre né fasi in slide: una tavola quasi di sfondo, sei
        approfondimenti possibili senza numeri e senza un ordine, e la domanda
        a cui rispondono loro. La proposta del trimestre e le fasi restano di
        riserva (tasto G), se in sala chiedono come si parte. */}
    <Slide id="slide-insieme" bg="inverse" align="left">
      <div slot="backdrop" class="im-bg-notte"></div>
      <div class="im-ins" data-reveal>
        <div class="im-ins-testa">
          <T as="h2" class="im-ins-t" it="Che cosa approfondiamo, e in che ordine?" en="What do we explore next, and in what order?" />
          <T as="p" class="im-ins-l" it="Le priorità le fissate voi. Sopra, i temi di oggi; sotto, i modi per approfondirli." en="You set the priorities. Above, today’s topics; below, the ways to go deeper." />
        </div>

        {/* I TEMI: un tocco li mette in ordine (1, 2, 3…), un secondo tocco toglie il
            numero e fa scalare gli altri. È la risposta al titolo, scritta in sala.
            Il rimando sotto ogni tema porta al punto del deck dove se n'è parlato. */}
        <section class="im-ins-temi" aria-labelledby="ins-temi-k">
          <div class="im-ins-riga">
            <T as="h3" id="ins-temi-k" class="im-ins-k" it="I temi di oggi" en="Today’s topics" />
            <T as="p" class="im-ins-aiuto" it="Un tocco per metterli in ordine" en="Tap to put them in order" />
          </div>
          <ol class="im-ins-tg">
            {TEMI.map((x) => (
              <li class="im-ins-tema" data-gruppo={x.g}>
                <button type="button" class="im-ins-tb" aria-pressed="false">
                  <span class="im-ins-ord" aria-hidden="true"></span>
                  <T as="span" class="im-ins-tn" it={x.t.it} en={x.t.en} />
                  <T as="span" class="im-ins-td" it={x.d.it} en={x.d.en} />
                  <span class="im-ins-tp">{x.p}</span>
                </button>
                <a class="im-ins-dove" href={href(base, x.url)}><T as="span" it={x.dove.it} en={x.dove.en} /><span aria-hidden="true"> ↗</span></a>
              </li>
            ))}
          </ol>
        </section>

        <section class="im-ins-modi" aria-labelledby="ins-modi-k">
          <T as="h3" id="ins-modi-k" class="im-ins-k" it="Come approfondirli" en="How to go deeper" />
          <ul class="im-ins-g">
            {INSIEME.map((x) => (
              <li class="im-ins-i">
                <T as="span" class="im-ins-n" it={x.t.it} en={x.t.en} />
                <T as="span" class="im-ins-d" it={x.d.it} en={x.d.en} />
              </li>
            ))}
          </ul>
        </section>
      </div>
    </Slide>

    {/* ── LA PROPOSTA (sintesi dell'11 nov 2026) ─────────────────────
        Il capitolo era cresciuto a quattro slide dense — sette misure, la
        soglia, le fasi, le cinque cose da portare — e in una prima stanza
        la richiesta si perdeva. Ora sono DUE slide da proiettare: che cosa
        proponiamo e come si misura (con l'ask), poi come si parte. Il resto
        non si butta: sta a richiesta, perché il deck viene inoltrato. */}
    <Slide id="slide-da-voi" bg="inverse" align="left" data-riserva>
      <div slot="backdrop" class="im-bg-notte"></div>
      <div class="im-sl" data-reveal>
        <div class="im-sl-head">
          <T as="p" class="im-n" it="La proposta" en="The proposal" />
          <T as="h2" class="im-h2" it="Un trimestre sul mutuo, misurato dal primo giorno" en="One quarter on the mortgage, measured from day one" />
        </div>
        <div class="im-ask" data-reveal data-reveal-delay="0.1">
          <p class="im-ask-n" data-display>1</p>
          <T as="p" class="im-ask-t" it={ASK.it} en={ASK.en} />
        </div>
        <div class="im-mis im-mis--sei im-mis--quattro" data-stagger>
          {MISURE.filter((m) => m.davanti).map((m) => (
            <div class="im-mis-b">
              <T as="p" class="im-mis-l" it={m.l.it} en={m.l.en} />
              <p class="im-mis-r">
                <span class="im-mis-oggi"><span data-lang-it>{m.oggi.it}</span><span data-lang-en>{m.oggi.en}</span></span>
                <span class="im-mis-f" aria-hidden="true"></span>
                <span class="im-mis-poi"><span data-lang-it>{m.poi.it}</span><span data-lang-en>{m.poi.en}</span></span>
              </p>
            </div>
          ))}
        </div>
        <HowItWorks title="Le altre misure, e come si legge la soglia" label="Le altre misure e la soglia" tone="onDark" class="ex-dett im-pp-dett">
          <div class="im-mis im-mis--sei im-mis--dett">
            {MISURE.filter((m) => !m.davanti).map((m) => (
              <div class="im-mis-b">
                <T as="p" class="im-mis-l" it={m.l.it} en={m.l.en} />
                <p class="im-mis-r"><span class="im-mis-poi"><span data-lang-it>{(m.poiLungo ?? m.poi).it}</span><span data-lang-en>{(m.poiLungo ?? m.poi).en}</span></span></p>
              </div>
            ))}
          </div>
          <div class="im-mis im-mis--sei im-mis--dett">
            {SOGLIA.map((x) => (
              <div class="im-mis-b">
                <T as="p" class="im-mis-l" it={x.k.it} en={x.k.en} />
                <p class="im-mis-r"><span class="im-mis-oggi"><span data-lang-it>{x.v.it}</span><span data-lang-en>{x.v.en}</span></span></p>
              </div>
            ))}
          </div>
        </HowItWorks>
        <T as="p" class="im-fonte-riga" it={TRIMESTRE.it} en={TRIMESTRE.en} />
      </div>
    </Slide>

    {/* ── COME SI PARTE: le tre tappe, con chi guida e quando. Che cosa si
        fa in ogni tappa e le cinque cose da portare stanno a richiesta. */}
    <Slide id="slide-fasi" bg="inverse" align="left" data-riserva>
      <div slot="backdrop" class="im-bg-notte"></div>
      <div class="im-ado-cap im-ado-cap--largo" data-reveal>
        <T as="p" class="im-ado-occ" it="Come si parte" en="How we start" />
        <T as="h2" class="im-ado-t im-ado-t--stretto" it="Prima la progettazione, poi un trimestre sul mutuo" en="First the design, then one quarter on the mortgage" />
        <ol class="im-rm im-rm--guida" data-reveal data-reveal-delay="0.12">
          {FASI.map((f, i) => (
            <li class="im-rm-i" data-tratto={i === 0 ? 'posato' : 'da-posare'}>
              <span class="im-rm-n">{f.n}</span>
              <T as="span" class="im-rm-t" it={f.t.it} en={f.t.en} />
              <T as="span" class="im-rm-chi" it={f.guidaBreve.it} en={f.guidaBreve.en} />
              <T as="span" class="im-rm-q" it={f.quandoBreve.it} en={f.quandoBreve.en} />
            </li>
          ))}
        </ol>
        <HowItWorks title="Che cosa si fa in ogni tappa" label="Che cosa si fa in ogni tappa" tone="onDark" class="ex-dett im-pp-dett">
          <ol class="im-pp-fasi" role="list">
            {FASI.map((f) => (
              <li>
                <p class="im-pp-ft"><span>{f.n}</span> <T as="span" it={f.t.it} en={f.t.en} /></p>
                <T as="p" class="im-pp-fd" it={f.guida.it} en={f.guida.en} />
                <T as="p" class="im-pp-fd" it={f.quando.it} en={f.quando.en} />
                <T as="p" class="im-pp-fd" it={f.b.it} en={f.b.en} />
              </li>
            ))}
          </ol>
        </HowItWorks>
        <p class="im-fonte-riga">
          <span data-lang-it>{CRITERIO.it} </span><span data-lang-en>{CRITERIO.en} </span>
          <a href={`${href(base, '/approfondimenti/')}#slide-serve`}><span data-lang-it>Che cosa serve per la fase 0 →</span><span data-lang-en>What phase 0 needs →</span></a>
        </p>
      </div>
    </Slide>

    {/* ⚠️ LA CHIUSURA NON DICE «MANCA» (panel, 11 nov 2026). Diceva «Il
        segnale sui prospect ce l'avete già. Manca chi decide che farne»:
        un'affermazione di assenza sulla banca, mai verificata, davanti a
        una Divisione che un motore di decisione ce l'ha. Ora è la proposta,
        e sotto il confine sul motore con la frase canonica. */}
    <Slide id="slide-firma" bg="inverse" align="center"
           data-made-with="Adobe Firefly" data-made-with-for="clip" data-audio="loud">
      <LoopVideo slot="backdrop" src={`${CLIP}/innesto-chiusura.loop.mp4`}
                 poster={`${base}media/innesto-chiusura.poster.jpg`}
                 scrim="im-clip-scrim" opacity={1} />
      <div class="im-firma" data-reveal>
        <CoBrand variant="hero" class="im-cov-lockup edf-cobrand--on-dark" />
        {/* Un titolo e un sottotitolo, niente di più (owner, 13 nov 2026): la
            riga di confine sul motore è già detta nel capitolo 03. */}
        <T as="h2" class="im-firma-t" it="Raggiungere chi non è ancora cliente, prima dell’email" en="Reaching people who are not yet customers, before the email" data-reveal data-reveal-delay="0.14" />
        <T as="p" class="im-firma-l" it="Perché chi stasera simula un mutuo arrivi in filiale già riconosciuto, e non come una scheda vuota." en="So that whoever simulates a mortgage tonight reaches the branch already recognised, not as a blank record." data-reveal data-reveal-delay="0.2" />
        <a href={href(base, '/')} class="edf-sig-cta">
          <span data-lang-it>Torna all’inizio</span><span data-lang-en>Back to the start</span>
        </a>
      </div>
    </Slide>

  </DeckContainer>
</BaseLayout>

<style is:global>
  /* La soglia: stessi corpi delle misure (globale su #slide-da-voi). */
  /* Sei voci su tre colonne (panel, 11 nov 2026, giro 2): con le righe su
     ripresa, estrazione e vincolo per la Rete, due colonne non entravano a
     1280×800 col tipo pieno. Il titolo usa la larghezza, non tre righe. */
  /* Le fasi: il quando sotto la guida, in un inchiostro più quieto. */
  #slide-fasi .im-rm-q { font-size: clamp(0.95rem, calc(0.8 * var(--vu)), 1.8rem); line-height: 1.38; color: #cfe3c6; }
  #slide-fasi .im-rm-chi { line-height: 1.32; }
  #slide-fasi .im-rm-b { font-size: clamp(0.95rem, calc(0.86 * var(--vu)), 1.95rem); }
  /* Serve: la tappa in cui serve, sotto la funzione. */
  /* Il costo, a tutta larghezza: etichetta a sinistra, misura a destra. */
  #slide-da-voi .im-mis--sette > [data-chiave] { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: 0.2rem 1.2rem; align-items: center; }
  #slide-da-voi .im-mis--sette > [data-chiave] .im-mis-l { margin: 0; }
  @media (max-height: 950px) { #slide-da-voi .im-mis--sette { gap: 0.4rem 0.7rem; margin-top: 0.3rem; } #slide-da-voi .im-mis--sette .im-mis-b { padding: 0.5rem 0.8rem; } #slide-da-voi .im-mis--sette .im-mis-l { margin-bottom: 0.25rem; } }
  /* La chiusura: un titolo, e sotto la proposta in una riga. */
  #slide-firma .im-firma-l { margin: 0; max-width: 44rem; font-family: var(--font-body); font-weight: 400; font-size: clamp(1.15rem, calc(1.35 * var(--vu)), 2.7rem); line-height: 1.45; color: #e3eedf; }
  .im-firma-t { margin: 0; max-width: 46rem; font-family: var(--font-display); font-weight: 800; font-size: clamp(2rem, calc(2.9 * var(--vu)), 5.6rem); line-height: 1.12; color: #ffffff; text-align: center; text-wrap: balance; }
  /* Sintesi (11 nov 2026): quattro misure in due colonne, l'ask sopra. */
  #slide-da-voi .im-mis--quattro { grid-template-columns: repeat(2, minmax(0, 1fr)); max-width: 78rem; }
  #slide-da-voi .im-ask { max-width: 78rem; }
  /* Il dettaglio aperto prende la slide: le misure e le fasi in vista si ritirano. */
  [data-slide]:has(.im-pp-dett[data-hiw-on]) :is(.im-ask, .im-mis--quattro, .im-rm, .im-n, .im-ado-occ, .im-fonte-riga) { display: none; }
  .im-mis--dett .im-mis-b { padding: 0.6rem 0.9rem; }
  .im-mis--dett { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.5rem 0.8rem; margin-top: 0.6rem; max-width: none; }
  .im-pp-fasi { list-style: none; margin: 0.6rem 0 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.8rem; }
  .im-pp-fasi li { margin: 0; display: grid; align-content: start; gap: 0.3rem; padding: 0.8rem 1rem; border-radius: 10px; border: 1px solid rgba(255, 255, 255, 0.22); background: rgba(6, 22, 2, 0.6); }
  .im-pp-ft { margin: 0; max-width: none; font-weight: 700; font-size: clamp(1.05rem, calc(1 * var(--vu)), 2.2rem); color: #ffffff; }
  .im-pp-ft > span:first-child { color: #b9e6a3; }
  .im-pp-fd { margin: 0; max-width: none; font-size: clamp(0.95rem, calc(0.86 * var(--vu)), 1.95rem); line-height: 1.45; color: #e3eedf; }
  .im-pp-dett .im-serve { margin-top: 0.8rem; }
  /* Sugli schermi bassi, a dettaglio aperto, il titolo si ritira: il link
     aperto dice già di che cosa si parla, e così il dettaglio sta nell'area
     sicura senza rimpicciolire il tipo (check exp, 11 nov 2026). */
  @media (max-height: 920px) { [data-slide]:has(.im-pp-dett[data-hiw-on]) :is(.im-h2, .im-ado-t) { display: none; } }
</style>

<script>
  /* L'ORDINE DEI TEMI, deciso in sala: ogni tocco assegna il numero successivo,
     un secondo tocco lo toglie e fa scalare gli altri. Il bottone perde il fuoco
     dopo il clic, così le frecce restano al deck. */
  const tavola = document.querySelector<HTMLElement>('#slide-insieme .im-ins-tg');
  if (tavola) {
    const bottoni = [...tavola.querySelectorAll<HTMLButtonElement>('.im-ins-tb')];
    let ordine: HTMLButtonElement[] = [];
    const scrivi = () => bottoni.forEach((b) => {
      const i = ordine.indexOf(b);
      b.setAttribute('aria-pressed', String(i >= 0));
      b.closest('li')!.toggleAttribute('data-scelto', i >= 0);
      b.querySelector('.im-ins-ord')!.textContent = i >= 0 ? String(i + 1) : '';
    });
    bottoni.forEach((b) => b.addEventListener('click', (e) => {
      e.stopPropagation();
      ordine = ordine.includes(b) ? ordine.filter((x) => x !== b) : [...ordine, b];
      scrivi(); b.blur();
    }));
  }
</script>
