---
/**
 * 09 · PROSSIMI PASSI — la fine del percorso.
 *
 * ⚠️ NON È PIÙ UN SEGNAPOSTO (revisione critica, 30 ott 2026). Era un
 * capitolo che dichiarava di essere vuoto, e nel frattempo la risposta
 * alla sua domanda stava tre capitoli prima, dentro le referenze: «Che
 * cosa misureremmo, dal giorno uno» parlava di noi in un capitolo che
 * parla di altre banche, e lì rompeva l'argomento del capitolo.
 * Ora sta qui, dove è la domanda, insieme all'ask — che resta in UN
 * POSTO SOLO, letto dalla fonte unica `referenze.ts` come il taglio «In
 * dieci minuti» (gate `pnpm audit:taglio`).
 *
 * Le tre cose che chiediamo vengono dalla slide 61 del deck del 5
 * novembre («Prossimi passi | che cosa ci serve per la proposta»).
 * ⚠️ Una riga è stata riscritta: l'originale nominava due prodotti di un
 * altro fornitore. In un documento che va al cliente quei nomi non
 * entrano — e la frase funziona meglio senza, perché chiede la mappa dei
 * collegamenti invece di presupporre quali siano.
 *
 * L'ultima slide è la slide-FIRMA, e chiude il PERCORSO: per contratto è
 * una slide a sé (la chiusura densa più il lockup grande sborda).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import CoBrand from '../components/CoBrand.astro';
import T from '@edf/core/blocks/i18n/T.astro';
import { href } from '@edf/core/utils/url.js';
import { CHAPTERS, prevSlug } from '../data/chapters';
import Divisore from '../components/Divisore.astro';
import FiguraCap from '../components/FiguraCap.astro';
import LoopVideo from '@edf/core/blocks/immersive/LoopVideo.astro';
import { MISURE, ASK, TRIMESTRE, SOGLIA } from '../data/referenze';
import HowItWorks from '@edf/core/blocks/HowItWorks.astro';
import { CONFINE } from '../data/innesto';
import fondo from '../assets/generated/cover-passi.webp';
/* La clip sta sul Release `media`, ricucita con `pnpm loop:seamless`. */
const CLIP = 'https://github.com/agargiulo-adbe/experience-design-factory/releases/download/media';

const SLUG = 'prossimi-passi';
const ch = CHAPTERS.find((c) => c.slug === SLUG)!;
const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;

/* Le cose che servono per scrivere una proposta con un perimetro
   invece di un ordine di grandezza. Dalla slide 61 del deck, RIFATTE
   (panel, 30 ott 2026): ogni voce ha la funzione che la possiede e che
   cosa basta mandare; «i profili in dodici mesi» sono la base di prezzo e
   stanno a parte («non toccare», panel dell'11 nov 2026).
   Giro dell'11 nov 2026: ogni voce dice in QUALE TAPPA serve (`quando`);
   la governance passa a «Targeting · Canali · CRM» con la regola di
   precedenza proposta, e la conferma resta loro; fra chi porta i dati
   entra l'Analytics digitale della Divisione; la spesa per canale non si
   chiede alla prima sessione: in fase 0 si disegna il flusso, in fase 1
   la banca la carica nella propria istanza (disaccordo Baa/Rubino,
   risolto in sequenza dall'arbitro). */
/* Le cinque cose da portare: ora in `data/serve.ts`, resa in approfondimenti/slide-serve. */
/* I sistemi della banca con UN nome solo, uguale in innesto, mappa,
   integrazioni e qui (glossario del panel, 11 nov 2026): motore di
   targeting · data warehouse · core banking · CRM di filiale · CDP attuale
   · registro dei consensi. Sta nella card delle integrazioni. */
/* Le fasi del seguito: un piano, non un preventivo.
   ⚠️ Il titolo prometteva «ogni tappa ha un responsabile» e nessuna card
   ne portava uno (panel, 11 nov 2026). Ora `guida` è la funzione della
   banca, `con` chi lavora accanto. Le date sono da fissare in sala. Niente
   importi e niente durate di licenza inventate: dove il fatto non c'è, si
   scrive «da definire». La tappa 1 decide sul digitale ma misura fino
   allo sportello, perché il mutuo si chiude in filiale. */
const FASI = [
  { n: '0', t: { it: 'Il disegno', en: 'The design' },
    guidaBreve: { it: 'Targeting e Group Technology, con Adobe', en: 'Targeting and Group Technology, with Adobe' },
    quandoBreve: { it: 'primo tavolo entro novembre', en: 'first table by November' },
    guida: { it: 'Guidano Targeting e Group Technology, con il responsabile della Divisione, insieme ad Adobe e all’integratore.', en: 'Led by Targeting and Group Technology, with the Division’s owner. Alongside, Adobe and the integrator you choose.' },
    quando: { it: 'Primo tavolo entro novembre, disegno chiuso entro gennaio. Date e costo si fissano insieme.', en: 'First table by November, design closed by January. Dates and cost are set together.' },
    b: { it: 'Si disegnano identificativi, eventi, consenso e gruppo di controllo. Il Targeting scrive la regola per scegliere i prospect. Si decide quanto convivono Analytics e CJA.', en: 'Identifiers, events, consent and control group get designed. Targeting writes the rule for picking prospects. How long Analytics and CJA coexist gets decided.' } },
  { n: '1', t: { it: 'Il mutuo, sui prospect', en: 'The mortgage, on prospects' },
    guidaBreve: { it: 'Targeting, con Canali e CRM', en: 'Targeting, with Channels and CRM' },
    quandoBreve: { it: 'un trimestre dal primo invio', en: 'one quarter from the first send' },
    guida: { it: 'Guida il Targeting, con Canali e CRM, insieme ad Adobe e all’integratore.', en: 'Led by Targeting, with Channels and CRM. Alongside, Adobe and the integrator.' },
    quando: { it: 'Il primo invio arriva dopo qualche mese, <span class=im-nw>da stimare in fase 0.</span> Poi un trimestre di misura.', en: 'First send a few months later, to estimate in phase 0. Then one quarter of measurement.' },
    b: { it: 'Si decide sul digitale e si misura fino allo sportello. L’esito dell’appuntamento lo registra la filiale nel CRM. Licenza con durata minima da definire. A fine trimestre si continua o ci si ferma, e i profili dei prospect si cancellano; per gli erogati restano solo gruppo e codice pratica, pseudonimizzati, con il DPO.', en: 'Decisions on digital, measured up to the counter: the branch records the appointment outcome in the CRM. Licence with a minimum term to be defined. At quarter end it continues or stops, and prospect profiles are deleted; for disbursements only group and file code remain, pseudonymised, with the DPO.' } },
  { n: '2', t: { it: 'Dopo il trimestre', en: 'After the quarter' },
    guidaBreve: { it: 'Targeting, con il prodotto', en: 'Targeting, with product' },
    quandoBreve: { it: 'un caso alla volta, se la soglia si è mossa', en: 'one case at a time, if the threshold moved' },
    guida: { it: 'Guida il Targeting, con il prodotto, insieme ad Adobe e all’integratore.', en: 'Led by Targeting, with product. Alongside, Adobe and the integrator.' },
    quando: { it: 'Un caso alla volta, solo <span class=im-nw>se la soglia si è mossa.</span>', en: 'One case at a time, if the threshold moved.' },
    b: { it: 'Prima il cross-sell dopo la firma, poi gli altri casi, ognuno con la sua misura. Sui clienti la classifica resta del vostro motore.', en: 'First cross-sell after signature, then the other cases, each with its own measure. On customers the ranking stays with your engine.' } },
];
/* Perché il mutuo prima del cross-sell: lo chiedono Rete e Targeting. */
const CRITERIO = {
  it: 'Perché il mutuo prima del cross-sell: sui prospect il vostro motore non ha punteggi, e la sua classifica non si tocca. La misura si chiude in un trimestre.',
  en: 'Why the mortgage before cross-sell: on prospects your engine has no scores, and its ranking stays untouched. The measurement closes within a quarter.',
};
---
<BaseLayout title={ch.title.it}>
  <div class="fixed top-0 left-0 right-0 z-50">
    <Navigation currentPath={currentPath} base={base} />
  </div>

  <DeckContainer nextHref={href(base, '/')} prevHref={href(base, prevSlug(SLUG))}>

    <Slide id="slide-cover" bg="secondary" align="left" data-made-with="Adobe Firefly" data-made-with-for="sfondo">
      <div slot="backdrop" class="im-div-bg" style={`--foto: url('${fondo.src}'); --fuoco: center 40%`}></div>
      <Divisore num={ch.num}
        tIt="La proposta e come si parte" tEn="The proposal and how we start" />
    </Slide>

    {/* ── LA PROPOSTA (sintesi dell'11 nov 2026) ─────────────────────
        Il capitolo era cresciuto a quattro slide dense — sette misure, la
        soglia, le fasi, le cinque cose da portare — e in una prima stanza
        la richiesta si perdeva. Ora sono DUE slide da proiettare: che cosa
        proponiamo e come si misura (con l'ask), poi come si parte. Il resto
        non si butta: sta a richiesta, perché il deck viene inoltrato. */}
    <Slide id="slide-da-voi" bg="inverse" align="left">
      <div slot="backdrop" class="im-bg-notte"></div>
      <div class="im-sl" data-reveal>
        <div class="im-sl-head">
          <T as="p" class="im-n" it="La proposta" en="The proposal" />
          <T as="h2" class="im-h2" it="Un trimestre sul mutuo, misurato dal primo giorno" en="One quarter on the mortgage, measured from day one" />
        </div>
        <div class="im-ask" data-reveal data-reveal-delay="0.1">
          <p class="im-ask-n" data-display>1</p>
          <T as="p" class="im-ask-t" it={ASK.it} en={ASK.en} />
        </div>
        <div class="im-mis im-mis--sei im-mis--quattro" data-stagger>
          {MISURE.filter((m) => m.davanti).map((m) => (
            <div class="im-mis-b">
              <T as="p" class="im-mis-l" it={m.l.it} en={m.l.en} />
              <p class="im-mis-r">
                <span class="im-mis-oggi"><span data-lang-it>{m.oggi.it}</span><span data-lang-en>{m.oggi.en}</span></span>
                <span class="im-mis-f" aria-hidden="true"></span>
                <span class="im-mis-poi"><span data-lang-it>{m.poi.it}</span><span data-lang-en>{m.poi.en}</span></span>
              </p>
            </div>
          ))}
        </div>
        <HowItWorks title="Le altre misure, e come si legge la soglia" label="Le altre misure e la soglia" tone="onDark" class="ex-dett im-pp-dett">
          <div class="im-mis im-mis--sei im-mis--dett">
            {MISURE.filter((m) => !m.davanti).map((m) => (
              <div class="im-mis-b">
                <T as="p" class="im-mis-l" it={m.l.it} en={m.l.en} />
                <p class="im-mis-r"><span class="im-mis-poi"><span data-lang-it>{(m.poiLungo ?? m.poi).it}</span><span data-lang-en>{(m.poiLungo ?? m.poi).en}</span></span></p>
              </div>
            ))}
          </div>
          <div class="im-mis im-mis--sei im-mis--dett">
            {SOGLIA.map((x) => (
              <div class="im-mis-b">
                <T as="p" class="im-mis-l" it={x.k.it} en={x.k.en} />
                <p class="im-mis-r"><span class="im-mis-oggi"><span data-lang-it>{x.v.it}</span><span data-lang-en>{x.v.en}</span></span></p>
              </div>
            ))}
          </div>
        </HowItWorks>
        <T as="p" class="im-fonte-riga" it={TRIMESTRE.it} en={TRIMESTRE.en} />
      </div>
    </Slide>

    {/* ── COME SI PARTE: le tre tappe, con chi guida e quando. Che cosa si
        fa in ogni tappa e le cinque cose da portare stanno a richiesta. */}
    <Slide id="slide-fasi" bg="inverse" align="left">
      <div slot="backdrop" class="im-bg-notte"></div>
      <div class="im-ado-cap im-ado-cap--largo" data-reveal>
        <T as="p" class="im-ado-occ" it="Come si parte" en="How we start" />
        <T as="h2" class="im-ado-t im-ado-t--stretto" it="Prima un tavolo di disegno, poi un trimestre sul mutuo" en="First a design table, then one quarter on the mortgage" />
        <ol class="im-rm im-rm--guida" data-reveal data-reveal-delay="0.12">
          {FASI.map((f, i) => (
            <li class="im-rm-i" data-tratto={i === 0 ? 'posato' : 'da-posare'}>
              <span class="im-rm-n">{f.n}</span>
              <T as="span" class="im-rm-t" it={f.t.it} en={f.t.en} />
              <T as="span" class="im-rm-chi" it={f.guidaBreve.it} en={f.guidaBreve.en} />
              <T as="span" class="im-rm-q" it={f.quandoBreve.it} en={f.quandoBreve.en} />
            </li>
          ))}
        </ol>
        <HowItWorks title="Che cosa si fa in ogni tappa" label="Che cosa si fa in ogni tappa" tone="onDark" class="ex-dett im-pp-dett">
          <ol class="im-pp-fasi" role="list">
            {FASI.map((f) => (
              <li>
                <p class="im-pp-ft"><span>{f.n}</span> <T as="span" it={f.t.it} en={f.t.en} /></p>
                <T as="p" class="im-pp-fd" it={f.guida.it} en={f.guida.en} />
                <T as="p" class="im-pp-fd" it={f.quando.it} en={f.quando.en} />
                <T as="p" class="im-pp-fd" it={f.b.it} en={f.b.en} />
              </li>
            ))}
          </ol>
        </HowItWorks>
        <p class="im-fonte-riga">
          <span data-lang-it>{CRITERIO.it} </span><span data-lang-en>{CRITERIO.en} </span>
          <a href={`${href(base, '/approfondimenti/')}#slide-serve`}><span data-lang-it>Che cosa serve per la fase 0 →</span><span data-lang-en>What phase 0 needs →</span></a>
        </p>
      </div>
    </Slide>

    {/* ⚠️ LA CHIUSURA NON DICE «MANCA» (panel, 11 nov 2026). Diceva «Il
        segnale sui prospect ce l'avete già. Manca chi decide che farne»:
        un'affermazione di assenza sulla banca, mai verificata, davanti a
        una Divisione che un motore di decisione ce l'ha. Ora è la proposta,
        e sotto il confine sul motore con la frase canonica. */}
    <Slide id="slide-firma" bg="inverse" align="center"
           data-made-with="Adobe Firefly" data-made-with-for="clip" data-audio="loud">
      <LoopVideo slot="backdrop" src={`${CLIP}/innesto-chiusura.loop.mp4`}
                 poster={`${base}media/innesto-chiusura.poster.jpg`}
                 scrim="im-clip-scrim" opacity={1} />
      <div class="im-firma" data-reveal>
        <CoBrand variant="hero" class="im-cov-lockup edf-cobrand--on-dark" />
        <T as="p" class="im-firma-l" it="Sui prospect il segnale arriva già al sito. Proponiamo di usarlo prima che lascino l’email, su un percorso solo, e di misurarlo." en="On prospects the signal already reaches the site. We propose to use it before they leave their email, on a single journey, and to measure it." data-reveal data-reveal-delay="0.14" />
        <T as="p" class="im-firma-confine" it={CONFINE.it} en={CONFINE.en} data-reveal data-reveal-delay="0.2" />
        <a href={href(base, '/')} class="edf-sig-cta">
          <span data-lang-it>Torna all’inizio</span><span data-lang-en>Back to the start</span>
        </a>
      </div>
    </Slide>

  </DeckContainer>
</BaseLayout>

<style is:global>
  /* La soglia: stessi corpi delle misure (globale su #slide-da-voi). */
  /* Sei voci su tre colonne (panel, 11 nov 2026, giro 2): con le righe su
     ripresa, estrazione e vincolo per la Rete, due colonne non entravano a
     1280×800 col tipo pieno. Il titolo usa la larghezza, non tre righe. */
  /* Le fasi: il quando sotto la guida, in un inchiostro più quieto. */
  #slide-fasi .im-rm-q { font-size: clamp(0.95rem, 0.8vw, 1.8rem); line-height: 1.38; color: #cfe3c6; }
  #slide-fasi .im-rm-chi { line-height: 1.32; }
  #slide-fasi .im-rm-b { font-size: clamp(0.95rem, 0.86vw, 1.95rem); }
  /* Serve: la tappa in cui serve, sotto la funzione. */
  /* Il costo, a tutta larghezza: etichetta a sinistra, misura a destra. */
  #slide-da-voi .im-mis--sette > [data-chiave] { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: 0.2rem 1.2rem; align-items: center; }
  #slide-da-voi .im-mis--sette > [data-chiave] .im-mis-l { margin: 0; }
  @media (max-height: 950px) { #slide-da-voi .im-mis--sette { gap: 0.4rem 0.7rem; margin-top: 0.3rem; } #slide-da-voi .im-mis--sette .im-mis-b { padding: 0.5rem 0.8rem; } #slide-da-voi .im-mis--sette .im-mis-l { margin-bottom: 0.25rem; } }
  /* La chiusura: il confine sul motore, sotto la proposta. */
  .im-firma-confine { margin: 0.6rem auto 0; max-width: 46rem; font-size: clamp(1rem, 0.9vw, 2rem); line-height: 1.45; color: #e3eedf; text-align: center; }
  /* Sintesi (11 nov 2026): quattro misure in due colonne, l'ask sopra. */
  #slide-da-voi .im-mis--quattro { grid-template-columns: repeat(2, minmax(0, 1fr)); max-width: 78rem; }
  #slide-da-voi .im-ask { max-width: 78rem; }
  /* Il dettaglio aperto prende la slide: le misure e le fasi in vista si ritirano. */
  [data-slide]:has(.im-pp-dett[data-hiw-on]) :is(.im-ask, .im-mis--quattro, .im-rm, .im-n, .im-ado-occ, .im-fonte-riga) { display: none; }
  .im-mis--dett .im-mis-b { padding: 0.6rem 0.9rem; }
  .im-mis--dett { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.5rem 0.8rem; margin-top: 0.6rem; max-width: none; }
  .im-pp-fasi { list-style: none; margin: 0.6rem 0 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.8rem; }
  .im-pp-fasi li { margin: 0; display: grid; align-content: start; gap: 0.3rem; padding: 0.8rem 1rem; border-radius: 10px; border: 1px solid rgba(255, 255, 255, 0.22); background: rgba(6, 22, 2, 0.6); }
  .im-pp-ft { margin: 0; max-width: none; font-weight: 700; font-size: clamp(1.05rem, 1vw, 2.2rem); color: #ffffff; }
  .im-pp-ft > span:first-child { color: #b9e6a3; }
  .im-pp-fd { margin: 0; max-width: none; font-size: clamp(0.95rem, 0.86vw, 1.95rem); line-height: 1.45; color: #e3eedf; }
  .im-pp-dett .im-serve { margin-top: 0.8rem; }
  /* Sugli schermi bassi, a dettaglio aperto, il titolo si ritira: il link
     aperto dice già di che cosa si parla, e così il dettaglio sta nell'area
     sicura senza rimpicciolire il tipo (check exp, 11 nov 2026). */
  @media (max-height: 920px) { [data-slide]:has(.im-pp-dett[data-hiw-on]) :is(.im-h2, .im-ado-t) { display: none; } }
</style>
