---
/**
 * Il riepilogo per la banca — solo nella versione B (`build:insieme`):
 * l'integrazione d'edizione lo toglie dalla sala e dalla versione A.
 * Il contenuto arriva con `?t=<token>` dalla RPC `get_riepilogo` (0041), con
 * le soglie già applicate nel database. La voce è quella della banca.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import RiepilogoPage from '@edf/core/blocks/doc/RiepilogoPage.astro';
---
<BaseLayout title="Riepilogo dei contributi" noindex>
  <RiepilogoPage
    titolo="Le domande e gli spunti delle nostre funzioni sull’esperienza cliente"
    sottotitolo="Raccolti fra i colleghi che hanno letto la storia di Giulia, che non è ancora cliente e cerca il primo mutuo, presentata il 19 novembre. Ordinati per area di evoluzione."
    piede="La versione finale la approva il referente della banca. Raccolta resa possibile dal team Adobe dell’account."
  />
</BaseLayout>
<style is:global>
  /* La pagina del riepilogo è un documento, non un deck: fondo chiaro, scorre. */
  html, body { overflow: auto !important; height: auto !important; }
  body { background: var(--surface-primary); }
</style>
