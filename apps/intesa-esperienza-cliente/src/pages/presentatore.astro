---
/**
 * /presentatore/ — LA FINESTRA PRESENTATORE (owner, 18 nov 2026).
 *
 * Si apre accanto al deck (tasto P sul deck, o questo indirizzo in un'altra
 * finestra) e parla col deck via BroadcastChannel: il protocollo sta in
 * `components/PresenterBridge.astro`. Modello: la vista presentatore di
 * `apps/mim-alfabeti`, qui con le miniature delle slide.
 *
 * Che cosa c'è: la slide corrente e la successiva in miniatura, le note di
 * `data/relatore.ts` (per i sette momenti, il testo di `momenti.ts`), il passo
 * del «Come funziona» quando il racconto è aperto, cronometro totale e per
 * capitolo, l'ora, i comandi, e tutte le slide in miniatura per saltare avanti o
 * indietro (riserve comprese: si accendono con l'ancora, come da «Vai a…»).
 *
 * Le miniature sono immagini PRE-RESE in `public/miniature/` (leggere, nessun
 * peso sul deck in sala). Si rifanno quando cambia una slide:
 *   DECK_URL=http://localhost:4590 npx tsx apps/intesa-esperienza-cliente/scripts/miniature.ts
 * Una miniatura che manca mostra il titolo della slide.
 *
 * Pubblica come il deck e come `/relatore/`: qui entra solo ciò che è già nelle
 * note per chi presenta. Fuori dal registro delle slide, quindi fuori da nav,
 * «Vai a…» e audit; noindex.
 */
import { existsSync } from 'node:fs';
import { resolve } from 'node:path';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../data/site';
import { CHAPTERS } from '../data/chapters';
import { PAGE_REGISTRY } from '../data/slides';
import { NOTE, TRE_COSE } from '../data/relatore';
import { MOMENTI } from '../data/momenti';
import { SCENE } from '../data/pop';
import { SCRIPT, COME_FUNZIONA } from '../data/script';
import { SCALETTA, DURATA_MIN } from '../data/scaletta';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const CANALE = `edf-presentatore:${SITE.slug}`;
const ordine = ['index', ...CHAPTERS.map((c) => c.slug), 'approfondimenti'];
const DIR = resolve(process.cwd(), 'public/miniature');

type Riga = { k: string; t: string; tono?: 'at' | 'se' | 'anc' | 'q' };
const sezioni = ordine
  .map((s) => PAGE_REGISTRY.find((p) => p.slug === s))
  .filter((p): p is NonNullable<typeof p> => Boolean(p))
  .map((p) => ({
    slug: p.slug,
    label: p.label.replace(/\s*\(\d+\)\s*$/, ''),
    url: p.slug === 'index' ? base : `${base}${p.slug}/`,
    slides: p.slides.map((x) => {
      const file = `${p.slug}--${x.id}.jpg`;
      const n = NOTE[p.slug]?.[x.id];
      const m = p.slug === 'momenti' ? MOMENTI.find((mm) => `slide-m-${mm.n}` === x.id) : undefined;
      const sc = SCRIPT[p.slug]?.[x.id];
      const righe: Riga[] = sc
        ? [
            { k: `⏱ ${sc.quando}`, t: sc.inSlide ? `In slide: ${sc.inSlide}` : '', tono: 'q' as const },
            ...(sc.ancora ? [{ k: '', t: sc.ancora, tono: 'anc' as const }] : []),
            ...sc.testo.map((t) => ({ k: '', t })),
            ...(sc.no ? [{ k: 'Da non dire', t: sc.no, tono: 'at' as const }] : []),
            ...(sc.ponte ? [{ k: 'Ponte', t: sc.ponte }] : []),
            ...(n?.seChiedono ? [{ k: 'Se chiedono', t: n.seChiedono, tono: 'se' as const }] : []),
          ]
        : m
        ? [{ k: 'Giulia', t: m.cliente.corpo.it }, { k: 'In banca', t: m.interno.corpo.it }, { k: 'Da chiedere', t: m.verifica.it, tono: 'se' }]
        : n
          ? [{ k: 'Da dire', t: n.dire }, ...(n.attenzione ? [{ k: 'Attenzione', t: n.attenzione, tono: 'at' as const }] : []), ...(n.seChiedono ? [{ k: 'Se chiedono', t: n.seChiedono, tono: 'se' as const }] : [])]
          : [];
      return { id: x.id, label: x.label, riserva: Boolean(x.riserva), thumb: existsSync(resolve(DIR, file)) ? `${base}miniature/${file}` : '', righe };
    }),
  }));
const scene = Object.fromEntries(Object.entries(SCENE).map(([k, s]) => [k, { prodotto: s.prodotto, passi: s.passi.map(String) }]));
const data = { canale: CANALE, sezioni, scene, deck: base, cf: COME_FUNZIONA };
const conMiniatura = sezioni.reduce((n, s) => n + s.slides.filter((x) => x.thumb).length, 0);
const totale = sezioni.reduce((n, s) => n + s.slides.length, 0);
---
<BaseLayout title={`Presentatore — ${SITE.name}`}>
  <div class="pv" data-pv>
    <header class="pv-top">
      <p class="pv-marca">Presentatore · {SITE.name}</p>
      <span class="pv-conn" data-pv-conn data-stato="attesa"><span class="pv-c-a">In attesa del deck</span><span class="pv-c-l">Deck collegato</span></span>
      <p class="pv-ora" data-pv-ora aria-label="Ora">--:--</p>
      <a class="pv-apri" href={base} target="edf-deck" rel="opener">Apri il deck ↗</a>
    </header>

    <div class="pv-grid">
      <section class="pv-ora-qui" aria-labelledby="pv-k-ora">
        <p class="pv-k" id="pv-k-ora">Ora in sala <span class="pv-cont" data-pv-cont>— / —</span> <span class="pv-cap" data-pv-cap></span></p>
        <figure class="pv-fig pv-fig--grande" data-pv-ora-fig><span class="pv-fig-t" data-pv-ora-t>—</span></figure>
        <p class="pv-passo" data-pv-passo hidden></p>
        <div class="pv-note" data-pv-note><p class="pv-vuoto">Collega il deck: aprilo in un'altra finestra, o premi P sul deck.</p></div>
      </section>

      <aside class="pv-lato">
        <section aria-labelledby="pv-k-dopo">
          <p class="pv-k" id="pv-k-dopo">Dopo <span class="pv-cap" data-pv-dopo-cap></span></p>
          <figure class="pv-fig" data-pv-dopo-fig><span class="pv-fig-t" data-pv-dopo-t>—</span></figure>
        </section>

        {/* IL CONTO ALLA ROVESCIA (owner, 18 nov 2026): il tempo del relatore di turno
            secondo la scaletta del team (data/scaletta.ts), non solo il cronometro. Parte
            con Avvia (T): il minuto 0 è quando si comincia a parlare, non le 11:00. */}
        <section class="pv-card pv-tempo" aria-label="Tempo" data-pv-tempo>
          <p class="pv-k">Di turno <span class="pv-chi" data-pv-chi>—</span></p>
          <p class="pv-blocco" data-pv-blocco>Il blocco si accende con la slide in onda</p>
          <p class="pv-orologio pv-resta" data-pv-resta>—</p>
          <p class="pv-resta-k" data-pv-resta-k>resta nel blocco</p>
          <div class="pv-tempi">
            <div><p class="pv-k">Totale</p><p class="pv-orologio pv-orologio--s" data-pv-tot>0:00</p></div>
            <div><p class="pv-k">Ai {DURATA_MIN}′ mancano</p><p class="pv-orologio pv-orologio--s" data-pv-fine>{DURATA_MIN}:00</p></div>
          </div>
          <p class="pv-scarto" data-pv-scarto>In linea con la scaletta</p>
          <div class="pv-riga">
            <button type="button" class="pv-b pv-b--primo" data-pv-via>Avvia <kbd>T</kbd></button>
            <button type="button" class="pv-b" data-pv-azzera>Azzera</button>
          </div>
          <ol class="pv-scaletta">
            {SCALETTA.map((b) => (
              <li data-pv-b={b.id}>
                <span class="pv-sc-m">{b.da}–{b.a}′</span>
                <span class="pv-sc-t"><b>{b.n}</b> {b.titolo}<small>{b.chi}</small></span>
                <span class="pv-sc-u" data-pv-usato={b.id}>—</span>
              </li>
            ))}
          </ol>
        </section>

        <section class="pv-card" aria-label="Comandi">
          <div class="pv-comandi">
            <button type="button" class="pv-b" data-pv-tasto="ArrowLeft"><kbd>←</kbd> Slide</button>
            <button type="button" class="pv-b pv-b--primo" data-pv-tasto="ArrowRight">Slide <kbd>→</kbd></button>
            <button type="button" class="pv-b" data-pv-tasto="ArrowUp"><kbd>↑</kbd> Passo</button>
            <button type="button" class="pv-b pv-b--primo" data-pv-tasto="ArrowDown">Passo <kbd>↓</kbd></button>
          </div>
          <p class="pv-nota-c">Dentro «Come funziona» le frecce muovono i passi del racconto. Lo schermo intero si accende con F sul deck.</p>
        </section>

        <details class="pv-card pv-tre">
          <summary class="pv-k">Le tre cose che devono restare</summary>
          <ol>{TRE_COSE.map((t) => <li>{t}</li>)}</ol>
        </details>
      </aside>
    </div>

    <section class="pv-tutte" aria-labelledby="pv-k-tutte">
      <p class="pv-k" id="pv-k-tutte">Tutte le slide · un clic e il deck va lì <span class="pv-nm">{conMiniatura}/{totale} miniature</span></p>
      {sezioni.map((s) => (
        <div class="pv-sez" data-pv-sez-slug={s.slug}>
          <h2 class="pv-sez-t">{s.label}</h2>
          <ol class="pv-strip">
            {s.slides.map((x, i) => (
              <li>
                <button type="button" class="pv-mini" data-pv-vai={s.slug} data-pv-id={x.id} data-pv-href={`${s.url}#${x.id}`} title={x.label}>
                  {x.thumb ? <img src={x.thumb} alt="" loading="lazy" width="320" height="180" /> : <span class="pv-mini-t">{x.label}</span>}
                  <span class="pv-mini-n">{i + 1}{x.riserva && <em> · riserva</em>}</span>
                </button>
              </li>
            ))}
          </ol>
        </div>
      ))}
    </section>
    <p class="pv-aiuto"><kbd>←</kbd><kbd>→</kbd> slide · <kbd>↑</kbd><kbd>↓</kbd><kbd>Spazio</kbd> passi · <kbd>T</kbd> cronometro · sul deck: <kbd>P</kbd> apre questa finestra, <kbd>F</kbd> schermo intero</p>
  </div>
  <script is:inline type="application/json" id="pv-dati" set:html={JSON.stringify(data)} />
</BaseLayout>

<style is:global>
  /* Globale e con prefisso .pv-: metà del DOM nasce a runtime. Fondo scuro come
     /relatore/: in sala la finestra sta sul portatile, accanto allo schermo. */
  body:has(.pv) { overflow: auto; background: #0b2204; }
  .pv { min-height: 100dvh; padding: 1rem clamp(1rem, 2vw, 2rem) 1.5rem; background: #0b2204; color: #f2f8f0; font-family: var(--font-body); display: flex; flex-direction: column; gap: 1rem; }
  .pv kbd { font: 700 0.72rem/1 var(--font-body); padding: 0.15rem 0.4rem; border: 1px solid currentColor; border-radius: 4px; opacity: 0.85; }
  .pv-top { display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; padding-bottom: 0.75rem; border-bottom: 1px solid rgba(185, 230, 163, 0.2); }
  .pv-marca { margin: 0; font: 700 1.05rem/1.2 var(--font-display); color: #fff; }
  .pv-conn { padding: 0.2rem 0.65rem; border-radius: 999px; font-size: 0.8rem; font-weight: 700; background: rgba(255, 255, 255, 0.1); color: #dfeadb; }
  .pv-conn .pv-c-l, .pv-conn[data-stato="live"] .pv-c-a { display: none; }
  .pv-conn[data-stato="live"] { background: #1f7400; color: #fff; }
  .pv-conn[data-stato="live"] .pv-c-l { display: inline; }
  .pv-ora { margin: 0 0 0 auto; font: 700 1.6rem/1 var(--font-display); font-variant-numeric: tabular-nums; color: #fff; }
  .pv-apri { color: #b9e6a3; font-weight: 700; text-decoration: none; }
  .pv-apri:hover { text-decoration: underline; }

  .pv-grid { display: grid; grid-template-columns: minmax(0, 1.7fr) minmax(18rem, 1fr); gap: 1.25rem; align-items: start; }
  @media (max-width: 960px) { .pv-grid { grid-template-columns: 1fr; } }
  .pv-k { display: flex; align-items: baseline; gap: 0.7rem; flex-wrap: wrap; margin: 0 0 0.45rem; font-size: 0.78rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: #9fd68a; }
  .pv-cont { font: 700 1.05rem/1 var(--font-display); letter-spacing: 0.04em; color: #fff; font-variant-numeric: tabular-nums; }
  .pv-cap { text-transform: none; letter-spacing: 0; font-weight: 600; color: #dfeadb; }
  .pv-fig { position: relative; margin: 0; aspect-ratio: 16 / 9; border-radius: 10px; overflow: hidden; background: #163b0b; box-shadow: inset 0 0 0 1px rgba(185, 230, 163, 0.25); display: grid; place-items: center; }
  .pv-fig img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .pv-fig-t { padding: 1rem; text-align: center; font: 600 1.05rem/1.3 var(--font-display); color: #dfeadb; }
  .pv-fig--grande { box-shadow: 0 0 0 3px #4fc21f; }
  .pv-passo { margin: 0.6rem 0 0; font-weight: 700; color: #b9e6a3; }
  .pv-passo i { display: inline-block; width: 0.55rem; height: 0.55rem; margin-left: 0.25rem; border-radius: 50%; background: rgba(255, 255, 255, 0.2); }
  .pv-passo i.on { background: #4fc21f; }
  .pv-note { margin-top: 0.8rem; padding: 1rem 1.2rem; border-radius: 10px; background: rgba(255, 255, 255, 0.06); font-size: clamp(1.05rem, 1.2vw, 1.3rem); line-height: 1.55; }
  .pv-note p { margin: 0 0 0.7em; max-width: none; text-align: left; }
  .pv-note p:last-child { margin-bottom: 0; }
  .pv-note b { color: #fff; }
  .pv-note .at { color: #ffc27a; }
  .pv-note .se { color: #c9d8c4; font-size: 0.92em; }
  .pv-note .anc { display: inline-block; padding: 0.15rem 0.5rem; border-left: 4px solid #4fc21f; background: rgba(79, 194, 31, 0.16); color: #fff; font-weight: 700; }
  .pv-note p.anc { display: block; }
  .pv-note .q { color: #9fd68a; font-size: 0.85em; }
  .pv-note .pop { padding: 0.6rem 0.8rem; border-left: 4px solid #4fc21f; background: rgba(79, 194, 31, 0.12); color: #fff; }
  .pv-vuoto { color: #c9d8c4; }

  .pv-lato { display: flex; flex-direction: column; gap: 1rem; min-width: 0; }
  .pv-card { padding: 0.9rem 1rem; border-radius: 10px; background: rgba(255, 255, 255, 0.06); }
  .pv-tempi { display: grid; grid-template-columns: 1fr 1fr; gap: 0.8rem; }
  .pv-orologio { margin: 0; font: 700 2.4rem/1 var(--font-display); font-variant-numeric: tabular-nums; color: #fff; }
  .pv-orologio--s { font-size: 1.8rem; }
  .pv-tempo[data-va="1"] .pv-orologio { color: #b9e6a3; }
  .pv-chi { text-transform: none; letter-spacing: 0; font: 700 1.15rem/1.2 var(--font-display); color: #fff; }
  .pv-blocco { margin: 0 0 0.4rem; font-size: 0.85rem; color: #c9d8c4; }
  .pv .pv-resta { font-size: 3.4rem; }
  .pv-resta-k { margin: 0.1rem 0 0.7rem; font-size: 0.8rem; color: #c9d8c4; }
  .pv-tempo[data-stato="ultimo"] .pv-resta { color: #ffc46b; }
  .pv-tempo[data-stato="oltre"] .pv-resta, .pv .over { color: #ff8a7a !important; }
  .pv-scarto { margin: 0.6rem 0 0; font-size: 0.85rem; font-weight: 700; color: #c9d8c4; }
  .pv-scarto[data-verso="ritardo"] { color: #ff8a7a; }
  .pv-scarto[data-verso="anticipo"] { color: #b9e6a3; }
  .pv-scaletta { list-style: none; margin: 0.8rem 0 0; padding: 0.6rem 0 0; border-top: 1px solid rgba(185, 230, 163, 0.2); display: grid; gap: 0.3rem; }
  .pv-scaletta li { display: grid; grid-template-columns: 3.4rem minmax(0, 1fr) 3rem; gap: 0.5rem; align-items: baseline; padding: 0.25rem 0.35rem; border-radius: 6px; font-size: 0.82rem; color: #c9d8c4; }
  .pv-scaletta li[data-qui] { background: rgba(79, 194, 31, 0.18); color: #fff; }
  .pv-sc-m, .pv-sc-u { font-variant-numeric: tabular-nums; }
  .pv-sc-u { text-align: right; }
  .pv-sc-t small { display: block; color: #9fd68a; }
  .pv-riga { display: flex; gap: 0.5rem; margin-top: 0.75rem; }
  .pv-comandi { display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem; }
  .pv-b { display: inline-flex; align-items: center; justify-content: center; gap: 0.45rem; min-height: 2.75rem; padding: 0.45rem 0.8rem; border: 1.5px solid rgba(185, 230, 163, 0.4); border-radius: 8px; background: none; color: #fff; font: 600 0.95rem/1 var(--font-body); cursor: pointer; }
  .pv-b:hover { background: rgba(185, 230, 163, 0.12); }
  .pv-b:focus-visible, .pv-mini:focus-visible { outline: 2px solid #b9e6a3; outline-offset: 2px; }
  .pv-b--primo { background: #1f7400; border-color: #1f7400; }
  .pv-b--primo:hover { background: #2a8f06; }
  .pv-nota-c { margin: 0.6rem 0 0; font-size: 0.8rem; color: #c9d8c4; }
  .pv-tre summary { cursor: pointer; margin: 0; }
  .pv-tre ol { margin: 0.5rem 0 0; padding-left: 1.2rem; font-size: 0.95rem; }

  .pv-tutte { border-top: 1px solid rgba(185, 230, 163, 0.2); padding-top: 0.9rem; }
  .pv-nm { text-transform: none; letter-spacing: 0; font-weight: 600; color: #c9d8c4; }
  .pv-sez { margin-bottom: 0.9rem; }
  .pv-sez-t { margin: 0 0 0.35rem; font: 700 0.95rem/1.3 var(--font-display); color: #fff; }
  .pv-sez[data-qui] .pv-sez-t { color: #b9e6a3; }
  .pv-strip { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(10.5rem, 1fr)); gap: 0.55rem; }
  .pv-mini { position: relative; display: grid; place-items: center; width: 100%; aspect-ratio: 16 / 9; padding: 0; border: 0; border-radius: 7px; overflow: hidden; background: #163b0b; box-shadow: inset 0 0 0 1px rgba(185, 230, 163, 0.25); cursor: pointer; }
  .pv-mini img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform 0.2s; }
  .pv-mini:hover img { transform: scale(1.04); }
  .pv-mini-t { padding: 0.4rem; font-size: 0.75rem; line-height: 1.25; color: #dfeadb; text-align: center; }
  .pv-mini-n { position: absolute; left: 0.3rem; bottom: 0.3rem; padding: 0.05rem 0.4rem; border-radius: 4px; background: rgba(4, 14, 1, 0.8); color: #fff; font-size: 0.72rem; font-weight: 700; }
  .pv-mini-n em { font-style: normal; color: #ffc46b; }
  .pv-mini[aria-current] { box-shadow: 0 0 0 3px #4fc21f; }
  .pv-mini[aria-current] .pv-mini-n { background: #1f7400; }
  .pv-aiuto { margin: 0; font-size: 0.8rem; color: #c9d8c4; line-height: 2; }
</style>

<script>
  import { SCALETTA, DURATA_MIN, bloccoDi } from '../data/scaletta';
  interface Riga { k: string; t: string; tono?: 'at' | 'se' | 'anc' | 'q' }
  interface PSlide { id: string; label: string; riserva: boolean; thumb: string; righe: Riga[] }
  interface PSez { slug: string; label: string; url: string; slides: PSlide[] }
  interface Dati { canale: string; sezioni: PSez[]; scene: Record<string, { prodotto: string; passi: string[] }>; deck: string;
    cf: { leggi: { quando: string; ancora: string; righe: string[] }; passi: { quando: string; come: string; righe: string[]; no: string }; passaggio: { quando: string; ancora: string; come: string } } }
  interface Stato { type: 'state'; slug: string; id: string; index: number; total: number; substep: number; substeps: number; pop: { scena: string; passo: number; tot: number; leggi: number } | null }

  function avvia() {
    const trovato = document.querySelector<HTMLElement>('[data-pv]');
    const el = document.getElementById('pv-dati');
    if (!trovato || !el || trovato.hasAttribute('data-pronto')) return;
    // Una const non nulla: le funzioni dichiarate qui sotto non ereditano il restringimento.
    const root: HTMLElement = trovato;
    root.setAttribute('data-pronto', '');
    const dati = JSON.parse(el.textContent || '{}') as Dati;
    const $ = <T extends HTMLElement = HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

    let bc: BroadcastChannel | null = null;
    try { bc = new BroadcastChannel(dati.canale); } catch { bc = null; }
    const manda = (m: Record<string, unknown>) => { try { bc?.postMessage(m); } catch { /* chiuso */ } };

    /* La sequenza del percorso, per sapere che cosa viene dopo: le riserve non
       sono nel percorso delle frecce, quindi non sono mai «la prossima». */
    const sequenza = dati.sezioni.flatMap((s) => s.slides.filter((x) => !x.riserva).map((x) => ({ s, x })));
    const trova = (slug: string, id: string) => {
      const s = dati.sezioni.find((z) => z.slug === slug);
      return s ? { s, x: s.slides.find((z) => z.id === id) ?? null } : null;
    };

    // ── Tempo: la scaletta del team, un blocco per relatore ──
    // Il blocco di turno si ricava dalla slide in onda (bloccoDi); una slide fuori
    // scaletta (approfondimenti) lascia il tempo sul blocco che l'ha aperta.
    let va = false, prima = 0, da = 0, sezCorr = '', sezDa = 0;
    const perSez: Record<string, number> = {};
    const ora = () => Date.now();
    const totMs = () => prima + (va ? ora() - da : 0);
    const sezMs = (s: string) => (perSez[s] ?? 0) + (va && sezCorr === s ? ora() - sezDa : 0);
    const entra = (s: string) => { if (!s || s === sezCorr) return; if (va && sezCorr) perSez[sezCorr] = sezMs(sezCorr); sezCorr = s; sezDa = ora(); };
    const fmt = (ms: number) => { const s = Math.floor(Math.abs(ms) / 1000); return `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`; };
    const commuta = () => {
      if (va) { prima = totMs(); if (sezCorr) perSez[sezCorr] = sezMs(sezCorr); va = false; }
      else { da = ora(); sezDa = ora(); va = true; }
      tempo();
    };
    const azzera = () => { va = false; prima = 0; Object.keys(perSez).forEach((k) => delete perSez[k]); sezDa = ora(); tempo(); };
    function tempo() {
      const box = $('[data-pv-tempo]');
      box.dataset.va = va ? '1' : '0';
      $('[data-pv-tot]').textContent = fmt(totMs());
      const fine = DURATA_MIN * 60000 - totMs();
      $('[data-pv-fine]').textContent = (fine < 0 ? '+' : '') + fmt(fine);
      $('[data-pv-fine]').classList.toggle('over', fine < 0);
      const b = SCALETTA.find((x) => x.id === sezCorr) ?? null;
      $('[data-pv-chi]').textContent = b ? b.chi : '—';
      $('[data-pv-blocco]').textContent = b ? `${b.n} · ${b.titolo} · ${b.da}–${b.a}′` : 'Il blocco si accende con la slide in onda';
      if (b) {
        const resta = (b.a - b.da) * 60000 - sezMs(b.id);
        const el = $('[data-pv-resta]');
        el.textContent = (resta < 0 ? '+' : '') + fmt(resta);
        box.dataset.stato = resta < 0 ? 'oltre' : resta < 60000 ? 'ultimo' : '';
        $('[data-pv-resta-k]').textContent = resta < 0 ? 'oltre il tempo del blocco' : 'resta nel blocco';
        // Anticipo o ritardo: dove dovrebbe essere il totale, secondo la scaletta, a
        // questo punto del blocco.
        // Lo sforamento del blocco in corso è già ritardo: il tempo del blocco conta
        // fino alla sua durata, oltre va tutto in scarto.
        const scarto = totMs() - (b.da * 60000 + Math.min(sezMs(b.id), (b.a - b.da) * 60000));
        const s = $('[data-pv-scarto]');
        s.textContent = Math.abs(scarto) < 30000 ? 'In linea con la scaletta' : `${scarto > 0 ? 'In ritardo' : 'In anticipo'} di ${fmt(scarto)} sulla scaletta`;
        s.dataset.verso = Math.abs(scarto) < 30000 ? '' : scarto > 0 ? 'ritardo' : 'anticipo';
      } else { $('[data-pv-resta]').textContent = '—'; box.dataset.stato = ''; }
      root.querySelectorAll<HTMLElement>('[data-pv-b]').forEach((li) => {
        const id = li.dataset.pvB!;
        const x = SCALETTA.find((y) => y.id === id)!;
        const usato = sezMs(id);
        li.toggleAttribute('data-qui', id === sezCorr);
        const u = li.querySelector<HTMLElement>('[data-pv-usato]')!;
        u.textContent = usato ? fmt(usato) : '—';
        u.classList.toggle('over', usato > (x.a - x.da) * 60000);
      });
      $('[data-pv-via]').innerHTML = `${va ? 'Pausa' : 'Avvia'} <kbd>T</kbd>`;
    }

    // ── Rendering ──
    let st: Stato | null = null, visto = 0;
    const fig = (sel: string, tSel: string, x: PSlide | null, vuoto: string) => {
      const f = $(sel);
      f.querySelector('img')?.remove();
      $(tSel).textContent = x ? x.label : vuoto;
      if (x?.thumb) { const i = new Image(); i.src = x.thumb; i.alt = ''; f.prepend(i); }
    };
    function disegna() {
      const qui = st ? trova(st.slug, st.id) : null;
      const x = qui?.x ?? null;
      const pad = (n: number) => String(n).padStart(2, '0');
      $('[data-pv-cont]').textContent = st ? `${pad(st.index + 1)} / ${pad(st.total)}` : '— / —';
      $('[data-pv-cap]').textContent = qui?.s.label ?? '';
      fig('[data-pv-ora-fig]', '[data-pv-ora-t]', x, '—');

      // Dopo: la slide successiva del percorso (o la prossima di questa pagina).
      const pos = x ? sequenza.findIndex((q) => q.x === x) : -1;
      const dopo = pos >= 0 ? sequenza[pos + 1] ?? null : null;
      fig('[data-pv-dopo-fig]', '[data-pv-dopo-t]', dopo?.x ?? null, st ? 'Fine del deck' : '—');
      $('[data-pv-dopo-cap]').textContent = dopo && dopo.s !== qui?.s ? `· ${dopo.s.label}` : '';

      // Passo: dentro il «Come funziona» vince il racconto; fuori, i sotto-passi.
      const p = $('[data-pv-passo]');
      const pop = st?.pop;
      const punti = (n: number, tot: number) => Array.from({ length: tot }, (_, i) => `<i class="${i < n ? 'on' : ''}"></i>`).join('');
      if (pop && pop.tot) {
        p.hidden = false;
        const nome = dati.scene[pop.scena]?.prodotto ?? 'Racconto';
        p.innerHTML = pop.leggi ? `${esc(nome)} · come si legge, riga ${pop.leggi} di 4` : `${esc(nome)} · passo ${pop.passo} di ${pop.tot} ${punti(pop.passo, pop.tot)}`;
      } else if (st && st.substeps) {
        p.hidden = false; p.innerHTML = `Passo ${st.substep} di ${st.substeps} ${punti(st.substep, st.substeps)}`;
      } else { p.hidden = true; p.textContent = ''; }

      const note = $('[data-pv-note]');
      // Nel racconto unico parla lo SCRIPT (data/script.ts), non la didascalia del passo:
      // la riga di «come si legge», o la frase del passo; all'ultimo, il passaggio.
      const cf = dati.cf;
      let testoPop = '';
      if (pop && pop.scena === 'e2e') {
        if (pop.leggi) testoPop = `${pop.leggi === 1 ? `<span class="anc">${esc(cf.leggi.ancora)}</span><br>` : ''}${esc(cf.leggi.righe[pop.leggi - 1] ?? '')}`;
        else if (pop.passo) testoPop = `<b>Passo ${pop.passo}.</b> ${esc(cf.passi.righe[pop.passo - 1] ?? '')}` +
          (pop.passo === pop.tot ? `<br><span class="anc">${esc(cf.passaggio.ancora)}</span> <small>${esc(cf.passaggio.come)}</small>` : '');
      } else if (pop && pop.passo && !pop.leggi) testoPop = esc(dati.scene[pop.scena]?.passi[pop.passo - 1] ?? '');
      const righe = pop && pop.scena === 'e2e' ? [{ k: 'Da non dire', t: cf.passi.no, tono: 'at' as const }] : (x?.righe ?? []);
      const riga = (r: Riga) => r.tono === 'anc' ? `<p class="anc">${esc(r.t)}</p>`
        : r.tono === 'q' ? `<p class="q"><b>${esc(r.k)}</b>${r.t ? ` · ${esc(r.t)}` : ''}</p>`
        : `<p class="${r.tono ?? ''}">${r.k ? `<b>${esc(r.k)}.</b> ` : ''}${esc(r.t)}</p>`;
      note.innerHTML = (testoPop ? `<p class="pop">${testoPop}</p>` : '') +
        (righe.length ? righe.map(riga).join('')
          : `<p class="pv-vuoto">${st ? 'Nessuna nota per questa slide.' : 'Collega il deck: aprilo in un’altra finestra, o premi P sul deck.'}</p>`);

      root.querySelectorAll<HTMLElement>('[data-pv-vai]').forEach((b) => {
        const on = !!st && b.dataset.pvVai === st.slug && b.dataset.pvId === st.id;
        if (on) b.setAttribute('aria-current', 'true'); else b.removeAttribute('aria-current');
      });
      root.querySelectorAll<HTMLElement>('[data-pv-sez-slug]').forEach((s) => s.toggleAttribute('data-qui', !!st && s.dataset.pvSezSlug === st.slug));
      tempo();
    }

    setInterval(() => {
      if (va) tempo();
      const d = new Date();
      $('[data-pv-ora]').textContent = `${String(d.getHours()).padStart(2, '0')}:${String(d.getMinutes()).padStart(2, '0')}`;
      $('[data-pv-conn]').dataset.stato = visto && ora() - visto < 5000 ? 'live' : 'attesa';
      // Un battito: il ponte manda solo quando cambia, quindi si chiede ogni 2 s.
      if (!visto || ora() - visto > 2000) manda({ type: 'hello' });
    }, 500);

    root.addEventListener('click', (e) => {
      const t = (e.target as HTMLElement).closest<HTMLElement>('[data-pv-tasto], [data-pv-vai], [data-pv-via], [data-pv-azzera]');
      if (!t) return;
      if (t.dataset.pvTasto) manda({ type: 'key', key: t.dataset.pvTasto });
      else if (t.dataset.pvVai) manda({ type: 'vai', slug: t.dataset.pvVai, id: t.dataset.pvId, href: t.dataset.pvHref });
      else if (t.hasAttribute('data-pv-via')) commuta();
      else if (t.hasAttribute('data-pv-azzera')) azzera();
    });
    window.addEventListener('keydown', (e) => {
      if (e.metaKey || e.ctrlKey || e.altKey) return;
      if ((e.target as HTMLElement).matches?.('input, textarea, select')) return;
      const k = e.key === ' ' || e.key === 'Spacebar' || e.key === 'PageDown' ? 'ArrowDown' : e.key === 'PageUp' ? 'ArrowUp' : e.key;
      if (['ArrowLeft', 'ArrowRight', 'ArrowUp', 'ArrowDown'].includes(k)) { e.preventDefault(); manda({ type: 'key', key: k }); }
      else if (k === 't' || k === 'T') { e.preventDefault(); commuta(); }
    });

    bc?.addEventListener('message', (e: MessageEvent) => {
      const m = e.data as Stato | undefined;
      if (!m || m.type !== 'state') return;
      visto = ora();
      const k = JSON.stringify(m);
      if (st && JSON.stringify(st) === k) return;
      st = m; entra(bloccoDi(m.slug, m.id)?.id ?? ''); disegna();
    });
    manda({ type: 'hello' });
    disegna();
  }
  avvia();
  document.addEventListener('astro:page-load', avvia);
</script>
