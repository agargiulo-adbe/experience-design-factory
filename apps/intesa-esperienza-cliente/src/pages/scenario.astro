---
/**
 * Dal dato alla decisione — l'apertura del capitolo.
 *
 * Una slide, un disegno. Il 10 nov 2026 il team l'ha chiesta «decomplicata
 * completamente»: restano il titolo, una riga e l'imbuto. Il tema di chi
 * decide fra le proposte sta dove il deck ha anche la risposta, l'arbitro.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import T from '@edf/core/blocks/i18n/T.astro';
import Divisore from '../components/Divisore.astro';
import { href } from '@edf/core/utils/url.js';
import { CHAPTERS, prevSlug, nextSlug } from '../data/chapters';
/* Torino al tramonto, non l'astrazione scura: il divisore è una pagina
   CHIARA, e una foto quasi nera lì dentro è una macchia, non una
   fotografia. Visto guardando la slide, non deducendolo. */
import fondo from '../assets/generated/cover-dato.webp';
import tracce from '../assets/generated/scena-08-tracce.webp';

const SLUG = 'scenario';
const ch = CHAPTERS.find((c) => c.slug === SLUG)!;
const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;

/* L'imbuto: dalla FONTE UNICA `data/imbuto.ts`. Numeri illustrativi. */
/* Il dato di mercato: l'imbuto con numeri inventati faceva un'assunzione su
   Intesa che non conosciamo (owner, 10 nov 2026). Questo è verificato alla
   fonte: Borsino Mutui di Nomisma e MutuiSupermarket.it, maggio 2026. */
const NOMISMA = 'https://www.teleborsa.it/DettaglioNews/51_2026-05-18_TLB/Nomisma-MutuiSupermarket-il-65-degli-italiani-cerca-il-mutuo-online-1-su-3-si-fida-dellAI.html';
---
<BaseLayout title={ch.title.it}>
  <div class="fixed top-0 left-0 right-0 z-50">
    <Navigation currentPath={currentPath} base={base} />
  </div>

  <DeckContainer nextHref={href(base, nextSlug(SLUG))} prevHref={href(base, prevSlug(SLUG))}>

    <Slide id="slide-cover" bg="secondary" align="left" data-made-with="Adobe Firefly" data-made-with-for="sfondo">
      <div slot="backdrop" class="im-div-bg" style={`--foto: url('${fondo.src}'); --fuoco: center 46%`}></div>
      <Divisore num={ch.num}
        tIt="Dal dato alla decisione" tEn="From data to decision" />
    </Slide>

    <Slide id="slide-segnale" bg="inverse" align="left">
      <div slot="backdrop" class="im-bg-scena" style={`--bg: url('${tracce.src}')`}></div>
      <div class="im-seg" data-reveal>
        <div class="im-seg-testa">
          <T as="h2" class="im-h2" it="Quasi una famiglia su due vuole simulare la rata prima di lasciare il nome" en="Almost one household in two wants to simulate the repayment before giving a name" />
          <T as="p" class="im-sub" it="Il segnale più forte arriva prima del nome. In quel momento la banca non può contattarla, ma il sito può già rispondere." en="The strongest signal comes before the name. The bank cannot contact her yet, but the site can already respond." />
        </div>
        <figure class="im-seg-fig">
          <div class="im-seg-dati">
            <p class="im-seg-dato" data-primo=""><span class="im-seg-n">45%</span><T as="span" class="im-seg-l" it="vuole simulare la rata" en="want to simulate the repayment" /></p>
            <p class="im-seg-dato"><span class="im-seg-n">65%</span><T as="span" class="im-seg-l" it="si informa sul mutuo online" en="research mortgages online" /></p>
          </div>
          <figcaption class="im-fonte-riga"><span data-lang-it>Fonte: </span><span data-lang-en>Source: </span><a href={NOMISMA} target="_blank" rel="noopener">Nomisma e MutuiSupermarket.it, Borsino Mutui Acquisto Casa, maggio 2026</a></figcaption>
        </figure>
      </div>
    </Slide>

  </DeckContainer>
</BaseLayout>
