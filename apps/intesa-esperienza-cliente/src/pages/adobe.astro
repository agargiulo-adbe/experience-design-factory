---
/**
 * 01 · ADOBE PER INTESA SANPAOLO — il capitolo che viene dal deck.
 *
 * Innesta cinque slide del `.pptx` del 5 novembre: il team (02), Adobe in
 * cifre con i Forrester Wave (06, 08), chi è Adobe (07) e Adobe CX
 * Enterprise (11). L'ordine va dal generale al particolare: chi siamo, la
 * piattaforma, la stessa piattaforma vista dai bisogni della banca.
 *
 * ⚠️ È L'UNICO CAPITOLO IN CUI IL DESIGN SYSTEM NON È DI INTESA.
 * La regola «un artefatto, un design system» non è violata: qui Adobe
 * parla di sé, e il blocco sta dentro il documento come **citazione**
 * dichiarata — non ridisegnato in verde, non mimetizzato. I quadranti
 * Forrester restano le immagini originali, perché un grafico di un
 * analista terzo non si ricolora e non si ridisegna: o è il suo, o non
 * vale niente.
 *
 * Che cosa NON è stato innestato, e perché:
 *   - le otto slide «Agenda»: in un documento la navigazione è l'agenda;
 *   - la slide 10, che diceva la stessa cosa della 11 con meno disegno;
 *   - i numeri della 07, che la 06 ripeteva quasi uguali con il taglio
 *     FSI in più. Stanno in un posto solo (vedi «slide-numeri»).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import T from '@edf/core/blocks/i18n/T.astro';
import { href } from '@edf/core/utils/url.js';
import { CHAPTERS, prevSlug, nextSlug } from '../data/chapters';
import Divisore from '../components/Divisore.astro';
import fondo from '../assets/generated/cover-adobe.webp';
/* Le tre cose: fonte unica, letta anche dalla slide di ripresa in
   «Prossimi passi». Due copie a mano divergono sempre. */
import { TRE } from '../data/tre';
/* Una fotografia per blocco, scelta GUARDANDOLE in provino, non dal
   nome del file: le prime tre erano un monitor, una lavagna di post-it e
   una sala riunioni vuota, e non dicevano niente dei tre concetti.
   Queste sì — le luci nel buio sono il segnale che c'è e si disperde, la
   mano sola al bancone è «uno per uno», il grafico è la misura.
   ⚠️ Sono fotografie da STOCK LICENZIATO (Pexels), non generate: per
   questo la slide non dichiara `data-made-with="Adobe Firefly"`, che su
   una foto stock sarebbe una dichiarazione falsa. Nel deck quel credito
   lo portano le sole clip. */
/* I sette ritratti del team. Ritagliati dalla slide 2 nella sua versione
   aggiornata — quella a sette persone, che nei file su disco non c'è:
   il deck a quattro era una versione precedente.
   11 nov 2026: SCONTORNATI, a colori. Erano sette foto con sette sfondi
   (rosso, verde acqua, mattoni, una bandiera); il bianco e nero provato
   prima toglieva il colore alle persone vere mentre Giulia resta a
   colori, e non uniformava luce e taglio. Ora il soggetto è ritagliato
   in locale (riconoscimento del soggetto di macOS, nessun file uscito
   dalla macchina) e lo sfondo è uno solo per tutti, quello della skin,
   messo dal CSS. Su Ellena e De Matteis due pezzi di sfondo che il
   riconoscimento teneva come parte della persona sono stati tolti a mano.
   ⚠️ Il ritaglio d'origine di Gargiulo è più stretto sul viso: per
   pareggiarlo serve la foto originale, non un ingrandimento. */
import rGordiani from '../assets/team/gordiani.png';
import rEllena from '../assets/team/ellena.png';
import rGargiulo from '../assets/team/gargiulo.png';
import rSelmi from '../assets/team/selmi.png';
import rMecca from '../assets/team/mecca.png';
import rGrieco from '../assets/team/grieco.png';
import rDeMatteis from '../assets/team/dematteis.png';
/* ⚠️ Luca Mecca (13 nov 2026): il ritratto non è ancora nel repo. Finché
   manca, il cerchio porta le iniziali: si sostituisce aggiungendo
   `../assets/team/mecca.png` e passando `f` nella riga del TEAM. */

const SLUG = 'adobe';
const ch = CHAPTERS.find((c) => c.slug === SLUG)!;
const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;

/* Il team che è in sala il 19 novembre, nell'ordine della slide 2.
   Sei persone: il product marketing non partecipa al 19 (deciso il 12 nov 2026);
   se servirà, entra al tavolo di approfondimento sull'analisi. */
const TEAM: { n: string; f?: ImageMetadata; r: { it: string; en: string } }[] = [
  { n: 'Alex Gordiani', f: rGordiani, r: { it: 'Head of FSI', en: 'Head of FSI' } },
  { n: 'Francesca Ellena', f: rEllena, r: { it: 'Account Executive FSI', en: 'Account Executive FSI' } },
  { n: 'Antonio Gargiulo', f: rGargiulo, r: { it: 'Product Sales Specialist · Data', en: 'Product Sales Specialist · Data' } },
  { n: 'Luca Mecca', f: rMecca, r: { it: 'Product Sales Specialist · Content', en: 'Product Sales Specialist · Content' } },
  { n: 'Giacomo Selmi', f: rSelmi, r: { it: 'Senior Solutions Consultant', en: 'Senior Solutions Consultant' } },
  { n: 'Matteo Grieco', f: rGrieco, r: { it: 'Solutions Consultant', en: 'Solutions Consultant' } },
  { n: 'Raffaele De Matteis', f: rDeMatteis, r: { it: 'Solutions Consulting Manager', en: 'Solutions Consulting Manager' } },
];

/* LE QUATTRO COSE CHE LA PIATTAFORMA FA, in ordine.
   Struttura e nomi dalla marketecture di Adobe CX Enterprise: «FSI CXO POV
   2026.pptx», slide 11 (cartella Intesa, e deck omonimo su Field Readiness).
   I verbi sono quelli scelti dal team il 30 ott 2026. */
const VERBI = [
  { t: { it: 'Comprendere', en: 'Understand' }, p: ['CX Analytics', 'Brand Visibility'] },
  { t: { it: 'Decidere', en: 'Decide' }, p: ['Real-Time Activation', 'Journey Optimizer AI Decisioning'] },
  { t: { it: 'Creare', en: 'Create' }, p: ['Firefly', 'GenStudio', 'Experience Manager'] },
  { t: { it: 'Attivare', en: 'Activate' }, p: ['Journey Optimizer', 'Target'] },
];
/* IL FILO FRA LE DUE SLIDE (owner, 13 nov 2026: «non è chiara la correlazione
   della prima con la seconda»). Ogni blocco della slide-cx porta le frecce
   della slide-chi da cui vengono i suoi prodotti, nella stessa forma e nella
   stessa tonalità: si riconosce la catena di prima applicata ai bisogni della
   banca. L'indice è la posizione in VERBI (1–4); 0 è la base, Adobe AI Platform.
   La mappa segue dove la slide-chi mette i prodotti di ciascun blocco. */
const FUNZIONI: Record<string, number[]> = { trovare: [1], engagement: [2, 4], contenuto: [3], piattaforma: [1], voce: [0] };
const etichettaFn = (i: number) => (i === 0 ? { it: 'Adobe AI Platform', en: 'Adobe AI Platform' } : VERBI[i - 1].t);

/* I numeri e i quattro Wave: slide-fsi, di nuovo nel percorso (owner, 13 nov
   2026; l'11 nov il panel l'aveva spostata fuori dalle frecce). */
import { WAVE, NUMERI } from '../data/wave';

/* L'ARCHITETTURA — disegnata sullo schema che il team usa già.
   Tre blocchi in alto, una fascia sottile che li attraversa tutti, e
   sotto una fascia alta che fa da pavimento. Le taglie non sono uguali
   perché i ruoli non lo sono: i tre in alto sono canali, la fascia di
   mezzo è la misura che serve a tutti e tre, quella in basso è il modo
   in cui il lavoro si chiede.

   ⚠️ I DUE NOMI IN BASSO NON SONO NOMI DI PRODOTTO, ed è il punto.
   «Adobe CX Analytics» dice che cosa si compra, «Analisi omnicanale»
   dice che cosa fa; «CX Enterprise Coworker» è un listino, «AI
   conversazionale a supporto del vostro lavoro» è una promessa che in
   sala si capisce senza glossario. Il nome del prodotto resta accanto,
   piccolo: serve sapere di che cosa si parla, ma non è quello il titolo. */
/* ⚠️ I BLOCCHI DELLA SLIDE «LE TRE COSE» STANNO QUI (Teams, 30 ott 2026:
   «ridondante rispetto alla 05, ne farei una unica»). Tre di questi blocchi
   prendono la loro riga da `tre.ts`, che resta la fonte unica anche per la
   ripresa finale. */
const NUMERATA: Record<string, { n: string; riga: { it: string; en: string } }> = Object.fromEntries(TRE.map((c) => [c.gruppo, { n: c.n, riga: c.riga }]));
const CANALI = [
  { g: 'trovare', t: { it: 'Farsi trovare dagli assistenti AI', en: 'Being found by AI assistants' },
    p: 'Adobe Brand Visibility',
    d: { it: 'Essere citati nelle risposte generate dagli assistenti.', en: 'Being cited in the answers assistants generate.' } },
  { g: 'engagement', t: { it: 'Ingaggio di clienti e non‑clienti', en: 'Engaging customers and non-customers' },
    /* Diceva «Adobe Experience Platform»: nella slide prima Experience
       Platform è il fondamento di tutto, qui diventava un blocco fra tre.
       Le applicazioni dell'ingaggio sono queste due (13 nov 2026). */
    p: 'Real-Time Activation · Journey Optimizer',
    d: { it: 'Profilo, decisione e regia del percorso sullo stesso dato.', en: 'Profile, decision and journey orchestration on the same data.' } },
  { g: 'contenuto', t: { it: 'Content Factory', en: 'Content factory' },
    p: 'Adobe GenStudio',
    d: { it: 'Da un solo brief, le varianti per ogni canale e ogni città in poco tempo, già conformi alle regole di marchio.', en: 'From one brief, variants for every channel and city in little time, already compliant with brand rules.' } },
];
const FASCE = [
  { g: 'piattaforma', alta: false,
    t: { it: 'Analisi omnicanale', en: 'Omnichannel analytics' },
    p: 'Adobe CX Analytics',
    d: { it: 'Una misura sola sotto i tre, dal primo contatto alla firma.', en: 'One measurement beneath all three, from first contact to signing.' } },
  { g: 'voce', alta: true,
    t: { it: 'Un assistente AI per chi prepara le iniziative', en: 'An AI assistant for the people who prepare initiatives' },
    p: 'CX Enterprise Coworker',
    d: { it: 'Si descrive l’obiettivo a parole e il sistema prepara audience, contenuti e percorso.', en: 'You describe the objective in words and the system prepares audience, content and journey.' } },
];
---
<BaseLayout title={ch.title.it}>
  <div class="fixed top-0 left-0 right-0 z-50">
    <Navigation currentPath={currentPath} base={base} />
  </div>

  <DeckContainer nextHref={href(base, nextSlug(SLUG))} prevHref={href(base, prevSlug(SLUG))}>

    <Slide id="slide-cover" bg="secondary" align="left" data-made-with="Adobe Firefly" data-made-with-for="sfondo">
      <div slot="backdrop" class="im-div-bg" style={`--foto: url('${fondo.src}'); --fuoco: center 46%`}></div>
      <Divisore num={ch.num}
        tIt="Adobe, chi siamo" tEn="Adobe, who we are" />
    </Slide>

    <Slide id="slide-team" bg="inverse" align="left">
      <div slot="backdrop" class="im-bg-notte"></div>
      {/* «Adobe Italia» stava sotto ogni nome, sette volte la stessa riga:
          ora la dice l'occhiello, una volta. */}
      <div class="im-ado-cap im-ado-cap--largo" data-reveal>
        <T as="p" class="im-ado-occ" it="Chi partecipa · Adobe Italia" en="Who is taking part · Adobe Italy" />
        <T as="h2" class="im-ado-t" it="Il team Adobe per i servizi finanziari" en="The Adobe team for financial services" />
        <ul class="im-team">
          {TEAM.map((p) => (
            <li class="im-team-i">
              {/* Il ritratto è lo SFONDO del cerchio, non un <img> ingrandito:
                  un'immagine scalata dentro un contenitore con overflow nascosto
                  è uno scroll nascosto per `audit:deck` (check c e k, HARD).
                  Decorativo: il nome accanto dice chi è. */}
              {p.f
                ? <span class="im-team-ft" style={`--ritratto: url('${p.f.src}')`} aria-hidden="true"></span>
                : <span class="im-team-ft im-team-ft--vuoto" style="--ritratto: none" data-ini={p.n.split(' ').map((w) => w[0]).join('')} aria-hidden="true"></span>}
              <span class="im-team-n">{p.n}</span>
              <T as="span" class="im-team-r" it={p.r.it} en={p.r.en} />
            </li>
          ))}
        </ul>
      </div>
    </Slide>

    {/* ⚠️ RIMESSA NEL PERCORSO (owner, 13 nov 2026). L'11 nov era uscita dalle
        frecce, in una pagina a sé, per il panel; il team la vuole in sala:
        chi è Adobe, con i numeri e il giudizio di Forrester, prima della
        piattaforma. La pagina «Adobe in cifre» non esiste più. */}
    <Slide id="slide-fsi" bg="inverse" align="left">
      <div slot="backdrop" class="im-bg-notte"></div>
      <div class="im-ado-cap im-ado-cap--wave" data-reveal>
        {/* ⚠️ «Adobe nei servizi finanziari» (owner, 13 nov 2026): la slide aveva
            perso il suo senso e diceva solo «Leader in quattro Wave». Torna
            l'occhiello, e sotto ogni quadrante che cosa vuol dire per una banca.
            Non torna «il settore finanziario è la prima industry di Adobe»:
            nessuna fonte l'ha retto (panel, 30 ott 2026). */}
        <T as="p" class="im-ado-occ" it="Adobe nei servizi finanziari" en="Adobe in financial services" />
        <T as="h2" class="im-ado-t im-ado-t--stretto" it="Leader nei quattro Forrester Wave del 2026 che contano per una banca" en="A Leader in the four 2026 Forrester Waves that matter to a bank" />
        <ul class="im-wave im-wave--fsi">
          {WAVE.map((w) => (
            <li class="im-wave-i">
              <img class="im-wave-img" src={w.img.src} alt={`Forrester Wave ${w.cat}: Adobe fra i Leader`} width="680" height="664" loading="eager" />
              <div class="im-wave-txt">
                <T as="span" class="im-wave-q" it={w.q.it} en={w.q.en} />
                <a class="im-wave-c" href={w.url} target="_blank" rel="noopener">{w.cat}</a>
                <T as="span" class="im-wave-per" it={w.per.it} en={w.per.en} />
              </div>
            </li>
          ))}
        </ul>
        <ul class="im-num im-num--striscia" aria-label="Adobe in quattro numeri">
          {NUMERI.map((n) => (
            <li class="im-num-i">
              <span class="im-num-k">{n.k}</span>
              <T as="span" class="im-num-v" it={n.v.it} en={n.v.en} />
            </li>
          ))}
        </ul>
        <T as="p" class="im-fonte-riga" it="Fonti: Forrester Research, The Forrester Wave™, 2026 (link sul nome di ogni report) · Adobe Form 10-K esercizio 2025 · risultati Q4 e FY2025 · Adobe Fast Facts" en="Sources: Forrester Research, The Forrester Wave™, 2026 (link on each report name) · Adobe Form 10-K fiscal 2025 · Q4 and FY2025 results · Adobe Fast Facts" />
      </div>
    </Slide>

    <Slide id="slide-chi" bg="inverse" align="left">
      <div slot="backdrop" class="im-bg-notte"></div>
      <div class="im-ado-cap im-ado-cap--largo" data-reveal>
        <T as="h2" class="im-ado-t" it="Dati, contenuti e decisioni nello stesso sistema" en="Data, content and decisions in the same system" />
        <T as="p" class="im-ado-l" it="Le quattro funzioni di Adobe CX Enterprise." en="The four functions of Adobe CX Enterprise." />
        <div class="im-cx-fig">
          <ol class="im-cx-catena">
            {VERBI.map((v) => (
              <li class="im-cx-el">
                <T as="span" class="im-cx-verbo" it={v.t.it} en={v.t.en} />
              </li>
            ))}
          </ol>
          <div class="im-cx-base">
            <span class="im-cx-base-t">Adobe AI Platform</span>
            <span class="im-cx-base-d">Experience Platform · CX Enterprise Coworker · agenti Adobe e di terzi</span>
          </div>
        </div>
      </div>
    </Slide>

    <Slide id="slide-cx" bg="inverse" align="left">
      <div slot="backdrop" class="im-bg-notte"></div>
      <div class="im-ado-cap im-ado-cap--largo" data-reveal>
        {/* La fascia d'apertura viene dalla slide 10 del deck, che diceva
            la stessa cosa con parole migliori: il titolo è un verbo —
            «orchestrare» — e il claim nomina il cliente e i suoi canali
            invece di restare astratto. */}
        <div class="im-orch">
          <T as="h2" class="im-orch-t" it="Orchestrare l’esperienza del cliente" en="Orchestrating the customer experience" />
          <T as="p" class="im-orch-c" it="<strong>Dati, contenuti e decisione</strong> nello stesso sistema: per servire clienti e non‑clienti di Intesa Sanpaolo uno per uno: in app, sul sito, in Filiale Digitale e in filiale." en="<strong>Data, content and decisioning</strong> in one system: to serve Intesa Sanpaolo’s customers and non-customers one by one: in the app, on the site, in Filiale Digitale and in the branch." />
        </div>
        <div class="im-arch" data-reveal data-reveal-delay="0.12">
          <ul class="im-arch-su">
            {CANALI.map((b) => (
              <li class="im-arch-b" data-gruppo={b.g} data-substep>
                <span class="im-fn" aria-label="Funzioni">{(FUNZIONI[b.g] ?? []).map((i) => <T as="span" class="im-fn-v" data-v={String(i)} it={etichettaFn(i).it} en={etichettaFn(i).en} />)}</span>
                <T as="span" class="im-arch-t" it={b.t.it} en={b.t.en} />
                <T as="span" class="im-arch-d" it={(NUMERATA[b.g]?.riga ?? b.d).it} en={(NUMERATA[b.g]?.riga ?? b.d).en} />
                <span class="im-arch-pro">{b.p}</span>
              </li>
            ))}
          </ul>
          {FASCE.map((f) => (
            <section class="im-arch-b im-arch-f" data-gruppo={f.g} data-alta={f.alta ? '' : undefined} data-substep>
              <div class="im-arch-f-t">
                <span class="im-fn" aria-label="Funzioni">{(FUNZIONI[f.g] ?? []).map((i) => <T as="span" class="im-fn-v" data-v={String(i)} it={etichettaFn(i).it} en={etichettaFn(i).en} />)}</span>
                <T as="span" class="im-arch-t" it={f.t.it} en={f.t.en} />
                <span class="im-arch-pro">{f.p}</span>
              </div>
              <T as="span" class="im-arch-d" it={(NUMERATA[f.g]?.riga ?? f.d).it} en={(NUMERATA[f.g]?.riga ?? f.d).en} />
            </section>
          ))}
        </div>
      </div>
    </Slide>

  </DeckContainer>
</BaseLayout>

<script>
  // Lo zoom sui Wave della slide FSI: la colonna porta quadrante E testo, quindi
  // un fattore fisso o la taglia sotto la barra o la lascia piccola. Si misura la
  // colonna prima che cresca e si sceglie il fattore che la fa stare intera fra
  // la barra e il fondo, spostandola in verticale se serve (13 nov 2026).
  const fitWave = (e: Event) => {
    const li = (e.target as Element | null)?.closest?.('.im-wave--fsi .im-wave-i') as HTMLElement | null;
    if (!li || li.contains((e as PointerEvent).relatedTarget as Node | null)) return;
    const nav = document.querySelector('.ex-nav')?.getBoundingClientRect().bottom ?? 0;
    // il fondo utile finisce sopra i comandi del deck (frecce e contatore)
    const btns = [...document.querySelectorAll('[data-deck] .deck-btn')].map((b) => b.getBoundingClientRect()).filter((b) => b.height > 0);
    const floor = btns.length ? Math.min(...btns.map((b) => b.top)) : window.innerHeight;
    const top = nav + 16, bottom = Math.min(window.innerHeight, floor) - 16;
    const r = li.getBoundingClientRect();
    const h = li.offsetHeight;
    const z = Math.max(1, Math.min(1.85, (bottom - top) / h));
    const half = (z * h) / 2;
    const c = r.top + r.height / 2;
    const cc = Math.min(Math.max(c, top + half), bottom - half);
    li.style.setProperty('--z', z.toFixed(3));
    li.style.setProperty('--dy', `${Math.round(cc - c)}px`);
  };
  document.addEventListener('pointerover', fitWave);
  document.addEventListener('focusin', fitWave);
</script>
