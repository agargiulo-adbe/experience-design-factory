<script>
  /* La fila delle capacità riporta alla slide dei componenti: il deck ci va
     con goTo, e il link resta l'àncora se lo script non c'è. */
  document.addEventListener('click', (e) => {
    const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('[data-capmap]');
    if (!a) return;
    const deck = (window as any).__edfDeck;
    const i = deck?.slides?.findIndex?.((s: HTMLElement) => s.id === 'slide-capacita') ?? -1;
    if (i >= 0) { e.preventDefault(); e.stopPropagation(); deck.goTo(i); }
  }, true);
</script>

<script>
  /* LE CARTE DELL'INNESTO (owner, 13 nov 2026). Un clic gira una carta e
     abbassa il resto; le frecce della carta si accendono con l'etichetta.
     Un altro clic, Esc, un clic fuori o l'uscita dalla slide la rigirano. Il
     clic sulla carta non deve far avanzare il deck: si ferma in cattura. */
  const inn = document.querySelector<HTMLElement>('#slide-innesto .im-inn');
  if (inn) {
    const slideI = document.getElementById('slide-innesto')!;
    const posa = (k: string | null) => {
      inn.querySelectorAll<HTMLElement>('.im-carta').forEach((c) => {
        const on = c.dataset.carta === k;
        c.toggleAttribute('data-girata', on);
        c.setAttribute('aria-pressed', String(on));
      });
      if (k) inn.dataset.carta = k; else delete inn.dataset.carta;
      /* Rigirata col mouse o con Esc, la carta non deve restare con l'anello
         di focus: si toglie il focus se era su una carta. */
      if (!k && (document.activeElement as HTMLElement | null)?.classList?.contains('im-carta')) (document.activeElement as HTMLElement).blur();
      inn.querySelectorAll<HTMLElement>('[data-luce]').forEach((el) => {
        const ks = (el.dataset.luce ?? '').split(' ');
        el.classList.toggle('is-acceso', !!k && ks.includes(k));
        el.classList.toggle('is-spento', !!k && !ks.includes(k));
      });
    };
    /* Servizi comuni e «Come entrano i dati» stanno sullo stesso bordo:
       se ne apre uno alla volta. */
    const ingresso = (apri?: boolean) => {
      const b = inn.querySelector<HTMLButtonElement>('[data-ingresso]');
      if (!b) return;
      const on = apri ?? b.getAttribute('aria-expanded') !== 'true';
      b.setAttribute('aria-expanded', String(on));
      inn.toggleAttribute('data-ingresso-aperto', on);
      bordo();
    };
    /* IL BORDO BASSO (owner, 17 nov 2026): i tre bottoni restano cliccabili in
       qualunque momento, quindi nessuno sparisce più. Quando uno si apre, gli altri si
       accorciano un passo alla volta finché fra loro restano almeno 12 px: mai due
       pillole che si toccano, mai un bottone nascosto. Il CSS dei passi è in
       innesto.css, «Il bordo basso non nasconde più niente». */
    const bordo = () => {
      const ing = inn.querySelector<HTMLElement>('[data-ingresso]');
      const fz = inn.querySelector<HTMLElement>('.im-inn-funziona');
      const svc = document.getElementById('im-svc');
      if (!ing || !fz || !svc) return;
      ['data-fz', 'data-ing-corto', 'data-svc-corto'].forEach((a) => inn.removeAttribute(a));
      inn.style.removeProperty('--svc-fine');
      const svcOn = inn.hasAttribute('data-svc-aperto');
      if (!svcOn && !inn.hasAttribute('data-ingresso-aperto')) return;
      if (getComputedStyle(fz).position !== 'absolute') return; // sotto i 900 px i bottoni vanno a capo da sé
      const ok = () => {
        const f = fz.getBoundingClientRect();
        if (!svcOn) return ing.getBoundingClientRect().right + 24 <= f.left;
        const fine = svc.getBoundingClientRect().right + parseFloat(getComputedStyle(svc).marginInlineEnd || '0'); // il bordo destro della fascia senza margine
        inn.style.setProperty('--svc-fine', `${Math.max(0, Math.ceil(fine - f.left + 14))}px`);
        const s = svc.getBoundingClientRect();
        return ing.getBoundingClientRect().right + 12 <= s.left && s.right + 12 <= f.left;
      };
      const passi: [string, string][] = svcOn
        ? [['data-fz', 'corto'], ['data-ing-corto', ''], ['data-svc-corto', ''], ['data-fz', 'icona']]
        : [['data-fz', 'corto'], ['data-fz', 'icona']];
      for (const [a, v] of passi) { if (ok()) return; inn.setAttribute(a, v); }
      ok();
    };
    addEventListener('resize', () => bordo());
    const servizi = (apri?: boolean) => {
      const b = inn.querySelector<HTMLButtonElement>('[data-svc]');
      const p = document.getElementById('im-svc');
      if (!b || !p) return;
      const on = apri ?? b.getAttribute('aria-expanded') !== 'true';
      b.setAttribute('aria-expanded', String(on));
      p.toggleAttribute('data-chiuso', !on);
      inn.toggleAttribute('data-svc-aperto', on);
      if (on) ingresso(false); else bordo();
    };
    const gira = (c: HTMLElement) => posa(inn.dataset.carta === c.dataset.carta ? null : c.dataset.carta!);

    document.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      if (!slideI.contains(t) || t.closest('dialog, #im-gm, .im-inn-m, [data-pp-open], [data-pp-e2e], a')) return;
      if (t.closest('[data-svc]')) { e.stopPropagation(); servizi(); return; }
      if (t.closest('[data-ingresso]')) { e.stopPropagation(); ingresso(); if (inn.hasAttribute('data-ingresso-aperto')) servizi(false); return; }
      const c = t.closest<HTMLElement>('.im-carta');
      if (c && inn.contains(c)) { e.stopPropagation(); e.preventDefault(); gira(c); return; }
      if (inn.dataset.carta) { e.stopPropagation(); posa(null); }
    }, true);
    document.addEventListener('keydown', (e) => {
      const t = e.target as HTMLElement;
      if (t?.classList?.contains('im-carta') && (e.key === 'Enter' || e.key === ' ')) {
        e.stopPropagation();
        if (t.tagName !== 'BUTTON') { e.preventDefault(); gira(t); }
        return;
      }
      if (e.key === 'Escape' && inn.dataset.carta && !document.querySelector('dialog.pp[open]')) posa(null);
    }, true);
    new MutationObserver(() => { if (slideI.getAttribute('aria-hidden') === 'true') { posa(null); servizi(false); ingresso(false); } })
      .observe(slideI, { attributes: true, attributeFilter: ['aria-hidden'] });

    /* La freccia bianca entra sotto la pillola «programmate»: la posizione si
       misura, in percentuale, così regge lingua, carattere e scala del deck. */
    const allinea = () => {
      const f = inn.querySelector<HTMLElement>('.im-inn-f--clienti');
      const p = inn.querySelector<HTMLElement>('.im-inn-tipo[data-match]');
      if (!f || !p) return;
      const fb = f.getBoundingClientRect(), pb = p.getBoundingClientRect();
      if (!fb.width || !pb.width) return;
      const x = ((pb.left + pb.width / 2 - fb.left) / fb.width) * 100;
      f.style.setProperty('--rx', `${Math.min(92, Math.max(4, x)).toFixed(2)}%`);
    };
    /* I due «Next Best Experience» fra le due cornici, alla stessa altezza.
       Su una riga se fra la freccia bianca e quella verde c'è posto, se no a
       capo tutti e due; se la fascia fra i bordi è più bassa dell'etichetta
       più un margine, la fascia si allunga (min-height sul filo bianco). */
    const nomi = () => {
      const fb = inn.querySelector<HTMLElement>('.im-inn-f--clienti');
      const su = inn.querySelector<HTMLElement>('.im-inn-up--su');
      const nb = fb?.querySelector<HTMLElement>('.im-inn-nbe');
      const nv = su?.querySelector<HTMLElement>('.im-inn-nbe-l');
      const co = inn.querySelector<HTMLElement>('.im-inn-cornice--oggi');
      const ca = inn.querySelector<HTMLElement>('.im-inn-cornice--aep');
      if (!fb || !su || !nb || !nv || !co || !ca || !fb.getBoundingClientRect().width) return;
      const sc = fb.getBoundingClientRect().height / (fb.offsetHeight || 1) || 1;
      /* Una riga o due: si misura la riga intera contro lo spazio fra le frecce. */
      inn.removeAttribute('data-nbe-a-capo');
      const xb = nb.getBoundingClientRect().left;
      const xv = su.getBoundingClientRect().left + su.getBoundingClientRect().width * 0.08;
      const serve = nb.getBoundingClientRect().width + 4 * sc;
      if (xb + serve > xv - 4 * sc) inn.setAttribute('data-nbe-a-capo', '');
      /* La fascia fra i bordi: se non basta, si allunga. */
      fb.style.minHeight = '';
      const off = (el: HTMLElement) => parseFloat(getComputedStyle(el).outlineOffset) * sc;
      const misura = () => ({ b: co.getBoundingClientRect().bottom + off(co), a: ca.getBoundingClientRect().top - off(ca) });
      let { b, a } = misura();
      const h = Math.max(nb.getBoundingClientRect().height, nv.getBoundingClientRect().height);
      const minimo = h + 8 * sc;
      if (a - b < minimo) {
        fb.style.minHeight = `${(fb.getBoundingClientRect().height + (minimo - (a - b))) / sc}px`;
        ({ b, a } = misura());
      }
      const y = (b + a) / 2;
      fb.style.setProperty('--nbe-y', `${(y - fb.getBoundingClientRect().top) / sc}px`);
      su.style.setProperty('--nbe-y', `${(y - su.getBoundingClientRect().top) / sc}px`);
    };
    const ro = new ResizeObserver(() => { allinea(); nomi(); });
    inn.querySelectorAll('.im-inn-f--clienti, .im-inn-tipo[data-match]').forEach((el) => ro.observe(el));
    inn.querySelectorAll('.im-inn-cornice').forEach((el) => ro.observe(el));
    const tutto = () => { allinea(); nomi(); };
    document.fonts?.ready.then(tutto);
    new MutationObserver(tutto).observe(document.documentElement, { attributes: true, attributeFilter: ['lang', 'data-lang'] });
    tutto();
  }
</script>

<script>
  /* La colonna del momento di Giulia: una pillola la apre, la stessa la
     richiude, un'altra la cambia. Si chiude anche con la ×, con Esc e quando
     si lascia la slide (il deck mette aria-hidden su quella che esce). */
  const col = document.getElementById('im-gm');
  if (col) {
    const pills = () => document.querySelectorAll<HTMLButtonElement>('#slide-innesto .im-inn-m[data-mom]');
    const chiudi = () => {
      col.hidden = true;
      pills().forEach((p) => p.setAttribute('aria-expanded', 'false'));
    };
    const apri = (k: string) => {
      col.querySelectorAll<HTMLElement>('[data-mom-p]').forEach((el) => { el.hidden = el.dataset.momP !== k; });
      pills().forEach((p) => p.setAttribute('aria-expanded', String(p.dataset.mom === k)));
      col.hidden = false;
    };
    document.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      const p = t.closest<HTMLButtonElement>('.im-inn-m[data-mom]');
      if (p) {
        e.stopPropagation();
        if (!col.hidden && p.getAttribute('aria-expanded') === 'true') chiudi();
        else apri(p.dataset.mom!);
        return;
      }
      if (t.closest('[data-mom-chiudi]')) { e.stopPropagation(); chiudi(); }
    }, true);
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !col.hidden && !document.querySelector('dialog.pp[open]')) chiudi();
    });
    const slide = document.getElementById('slide-innesto');
    if (slide) new MutationObserver(() => { if (slide.getAttribute('aria-hidden') === 'true') chiudi(); })
      .observe(slide, { attributes: true, attributeFilter: ['aria-hidden'] });
  }
</script>

<script>
  /* Il selettore del modello sul pannello di attribuzione. I due passi della
     slide lo muovono da soli: il primo mostra l'ultimo clic, il secondo
     l'algoritmico. Al clic si gira a mano, in qualunque momento; quando la
     slide cambia passo, torna a seguire il passo. Il bottone perde il fuoco
     dopo il clic, così le frecce restano al deck. */
  const slide = document.getElementById('slide-attribuzione');
  const pan = slide?.querySelector<HTMLElement>('[data-cjp]');
  if (slide && pan) {
    const bottoni = pan.querySelectorAll<HTMLButtonElement>('.im-cjp-mod button');
    const metti = (m: string) => {
      pan.dataset.modello = m;
      bottoni.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.mod === m)));
    };
    const passo = () => slide.querySelectorAll('.im-cjp-passo[data-substep-active]').length;
    const segui = () => {
      const p = passo();
      pan.toggleAttribute('data-pieno', p > 0 || pan.hasAttribute('data-mano'));
      if (!pan.hasAttribute('data-mano')) metti(p >= 2 ? 'algo' : 'ultimo');
    };
    bottoni.forEach((b) => b.addEventListener('click', (e) => {
      e.stopPropagation();
      pan.setAttribute('data-mano', '');
      pan.setAttribute('data-pieno', '');
      metti(b.dataset.mod ?? 'ultimo');
      b.blur();
    }));
    const passi = slide.querySelectorAll('.im-cjp-passo');
    const mo = new MutationObserver(() => { pan.removeAttribute('data-mano'); segui(); });
    passi.forEach((p) => mo.observe(p, { attributes: true, attributeFilter: ['data-substep-active'] }));
    new MutationObserver(() => { if (slide.getAttribute('aria-hidden') === 'true') { pan.removeAttribute('data-mano'); segui(); } })
      .observe(slide, { attributes: true, attributeFilter: ['aria-hidden'] });
    segui();
  }
</script>

<script>
  /* Il Sankey: con il mouse su un'etichetta restano accesi solo i suoi nastri. */
  const flu = document.querySelector<HTMLElement>('#slide-flusso [data-flu]');
  if (flu) {
    const nastri = [...flu.querySelectorAll<SVGPathElement>('.im-flu-svg path')];
    flu.querySelectorAll<HTMLElement>('.im-flu-l[data-n]').forEach((l) => {
      l.addEventListener('mouseenter', () => {
        const k = l.dataset.n!;
        nastri.forEach((p) => p.toggleAttribute('data-hit', p.dataset.da === k || p.dataset.a === k));
        flu.setAttribute('data-fuoco', k);
      });
      l.addEventListener('mouseleave', () => { flu.removeAttribute('data-fuoco'); nastri.forEach((p) => p.removeAttribute('data-hit')); });
    });

    /* IL SANKEY SI RIDISEGNA (owner, 17 nov 2026). Al terzo passo la dimensione
       «Prodotto» va sulla colonna di mezzo, come in Customer Journey Analytics, e
       il flusso si ridisegna nastro per nastro: i lati restano fermi, cambia solo
       la domanda. Si fa anche a mano, trascinando i bottoni delle dimensioni sulla
       colonna (mouse e touch) o premendoli. Niente tempi promessi: l'animazione è
       breve perché si legga in sala, non perché il prodotto sia istantaneo. */
    const slide = document.getElementById('slide-flusso')!;
    const zona = flu.querySelector<HTMLElement>('.im-flu-zona')!;
    const rett = [...flu.querySelectorAll<SVGRectElement>('.im-flu-n--m')];
    const chips = [...slide.querySelectorAll<HTMLButtonElement>('.im-flu-chip')];
    const p3 = slide.querySelector<HTMLElement>('.im-flu-passo[data-p="3"]');
    const lento = () => matchMedia('(prefers-reduced-motion: reduce)').matches;
    const NUM = /-?\d+(?:\.\d+)?(?:e-?\d+)?/g;
    const forme = nastri.map((p) => ({ a: p.dataset.d1!.match(NUM)!.map(Number), b: p.dataset.d2!.match(NUM)!.map(Number), sk: p.dataset.d1!.split(NUM) }));
    const disegna = (t: number) => {
      nastri.forEach((p, i) => {
        const { a, b, sk } = forme[i];
        let d = sk[0];
        for (let k = 0; k < a.length; k++) d += (a[k] + (b[k] - a[k]) * t).toFixed(2) + sk[k + 1];
        p.setAttribute('d', d);
      });
      rett.forEach((r) => {
        const y = +r.dataset.y1! + (+r.dataset.y2! - +r.dataset.y1!) * t;
        const h = +r.dataset.h1! + (+r.dataset.h2! - +r.dataset.h1!) * t;
        r.setAttribute('y', y.toFixed(2)); r.setAttribute('height', h.toFixed(2));
      });
    };
    let vista = 'interazione', pos = 0, raf = 0, attesa = 0;
    /* Il tempo è quello di una sala, non di un clic (owner, 17 nov: «troppo
       rapida per essere letta»). Tre battute: cambia l'intestazione, si muove il
       flusso con i nomi di mezzo spenti (se no galleggiano su rettangoli non
       loro), poi i nomi nuovi si accendono al posto giusto. */
    const vai = (nuova: string, anima = true, dur = 1300) => {
      const meta = nuova === 'prodotto' ? 1 : 0;
      if (anima && nuova === vista && pos === meta) return;
      vista = nuova;
      flu.dataset.vista = nuova;
      chips.forEach((c) => c.setAttribute('aria-pressed', String(c.dataset.dim === nuova)));
      nastri.forEach((p) => {
        const k = meta ? p.dataset.k2! : p.dataset.k1!;
        if (p.dataset.tratto === '1') p.dataset.a = k; else p.dataset.da = k;
      });
      cancelAnimationFrame(raf); clearTimeout(attesa);
      if (!anima || lento()) { pos = meta; disegna(pos); flu.removeAttribute('data-cambia'); return; }
      flu.setAttribute('data-cambia', '');
      const da = pos;
      /* una pausa breve: prima si legge la colonna che cambia nome, poi si muove */
      attesa = window.setTimeout(() => {
        const t0 = performance.now();
        const passo = (ora: number) => {
          const x = Math.min(1, (ora - t0) / dur);
          const e = x < 0.5 ? 4 * x * x * x : 1 - Math.pow(-2 * x + 2, 3) / 2;
          pos = da + (meta - da) * e; disegna(pos);
          if (x < 1) raf = requestAnimationFrame(passo);
          else flu.removeAttribute('data-cambia');
        };
        raf = requestAnimationFrame(passo);
      }, 350);
    };

    /* Il fantasma che si trascina vive DENTRO la figura (non nel body), così si vede
       anche a schermo intero; la figura può essere scalata dal deck, e le coordinate
       si riportano alla sua scala. */
    const scala = () => { const b = flu.getBoundingClientRect(); return { b, s: b.width / (flu.offsetWidth || 1) }; };
    const fantasma = (c: HTMLElement, demo = false) => {
      const g = c.cloneNode(true) as HTMLElement;
      g.classList.add('im-flu-ghost'); g.removeAttribute('aria-pressed'); g.setAttribute('aria-hidden', 'true');
      if (demo) g.insertAdjacentHTML('beforeend', '<svg class="im-flu-cursore" viewBox="0 0 16 20" aria-hidden="true"><path d="M1 1v15l4-4 3 7 3-1.4-3-6.6h6z" /></svg>');
      flu.appendChild(g);
      return g;
    };
    const metti = (g: HTMLElement, cx: number, cy: number) => {
      const { b, s } = scala();
      g.style.left = `${(cx - b.left) / s - g.offsetWidth / 2}px`;
      g.style.top = `${(cy - b.top) / s - g.offsetHeight / 2}px`;
    };
    const sopra = (cx: number, cy: number) => {
      const r = zona.getBoundingClientRect();
      return cx >= r.left - 24 && cx <= r.right + 24 && cy >= r.top - 24 && cy <= r.bottom + 24;
    };

    /* A mano: trascinare un bottone sulla colonna, oppure premerlo. */
    let sopprimi = false;
    chips.forEach((c) => {
      let g: HTMLElement | null = null, x0 = 0, y0 = 0, giu = false;
      c.addEventListener('pointerdown', (e) => {
        if (e.button !== 0) return;
        giu = true; x0 = e.clientX; y0 = e.clientY;
        c.setPointerCapture(e.pointerId);
      });
      c.addEventListener('pointermove', (e) => {
        if (!giu) return;
        if (!g && Math.hypot(e.clientX - x0, e.clientY - y0) < 6) return;
        if (!g) { g = fantasma(c); flu.setAttribute('data-trascina', ''); stopDemo(); }
        metti(g, e.clientX, e.clientY);
        zona.toggleAttribute('data-sopra', sopra(e.clientX, e.clientY));
      });
      const fine = (e: PointerEvent, annulla = false) => {
        if (!giu) return;
        giu = false;
        if (!g) return;
        if (!annulla && sopra(e.clientX, e.clientY)) vai(c.dataset.dim!);
        g.remove(); g = null; sopprimi = true;
        flu.removeAttribute('data-trascina'); zona.removeAttribute('data-sopra');
      };
      c.addEventListener('pointerup', (e) => fine(e));
      c.addEventListener('pointercancel', (e) => fine(e, true));
      c.addEventListener('click', (e) => {
        e.stopPropagation();
        if (sopprimi) { sopprimi = false; return; }
        stopDemo(); vai(c.dataset.dim!);
      });
      /* Uno swipe sul touch farebbe avanzare il deck: il trascinamento non lo è. */
      c.addEventListener('touchend', (e) => e.stopPropagation());
    });

    /* Al terzo passo, la dimostrazione: il bottone «Prodotto» va sulla colonna. */
    let timer = 0, demo: Animation | null = null, demoG: HTMLElement | null = null;
    const stopDemo = () => {
      clearTimeout(timer); demo?.cancel(); demo = null; demoG?.remove(); demoG = null;
      flu.removeAttribute('data-trascina'); zona.removeAttribute('data-sopra');
    };
    const dimostra = () => {
      const c = chips.find((x) => x.dataset.dim === 'prodotto');
      if (!c || vista === 'prodotto') return;
      if (lento()) { vai('prodotto', false); return; }
      const { b, s } = scala();
      const da = c.getBoundingClientRect(), a = zona.getBoundingClientRect();
      const g = demoG = fantasma(c, true);
      metti(g, da.left + da.width / 2, da.top + da.height / 2);
      const dx = (a.left + a.width / 2 - (da.left + da.width / 2)) / s;
      const dy = (a.top + Math.min(a.height * 0.18, 60) - (da.top + da.height / 2)) / s;
      flu.setAttribute('data-trascina', '');
      /* si prende il bottone e lo si tiene un attimo (si legge «Prodotto»), lo si
         porta sulla colonna, ci si ferma sopra (la colonna si accende), si lascia */
      demo = g.animate([
        { transform: 'translate(0, 0) scale(1)', opacity: 0, easing: 'ease-out' },
        { transform: 'translate(0, 0) scale(1.08)', opacity: 1, offset: 0.1 },
        { transform: 'translate(0, 0) scale(1.08)', opacity: 1, offset: 0.24, easing: 'cubic-bezier(0.45, 0, 0.2, 1)' },
        { transform: `translate(${dx}px, ${dy}px) scale(1.08)`, opacity: 1, offset: 0.72 },
        { transform: `translate(${dx}px, ${dy}px) scale(1.08)`, opacity: 1, offset: 0.9 },
        { transform: `translate(${dx}px, ${dy}px) scale(0.92)`, opacity: 0 },
      ], { duration: 2400, fill: 'forwards' });
      timer = window.setTimeout(() => zona.setAttribute('data-sopra', ''), 1600);
      demo.finished.then(() => { stopDemo(); vai('prodotto', true, 1600); }).catch(() => {});
    };
    if (p3) {
      new MutationObserver(() => {
        if (p3.hasAttribute('data-substep-active')) { stopDemo(); timer = window.setTimeout(dimostra, 450); }
        else if (vista !== 'interazione') { stopDemo(); vai('interazione'); }
        else stopDemo();
      }).observe(p3, { attributes: true, attributeFilter: ['data-substep-active'] });
    }
    new MutationObserver(() => {
      if (slide.getAttribute('aria-hidden') === 'true') { stopDemo(); vai('interazione', false); }
    }).observe(slide, { attributes: true, attributeFilter: ['aria-hidden'] });
  }
</script>

<script>
  /* LA MAPPA ENTRA NELLO SCHERMO (16 nov 2026). Con una finestra bassa (un
     portatile col browser non a tutto schermo, sotto i ~700px) la slide
     dell'innesto era più alta dello schermo: Customer Journey Analytics finiva
     sotto i comandi del deck e fuori dall'area cliccabile, e la sua carta non si
     girava, quindi «Come funziona» non si raggiungeva. Qui la si scala quanto
     basta per stare nel contenitore, sopra i comandi. Con `scale` e non con
     `zoom`: i clic seguono quello che si vede, e i pop-in, che si aprono nel top
     layer, restano a grandezza piena. Alle misure del gate non scatta. */
  const slideF = document.getElementById('slide-innesto');
  const capF = slideF?.querySelector<HTMLElement>('.im-ado-cap');
  if (slideF && capF) {
    const adatta = () => {
      /* La proprietà `scale`, non `transform`: l'animazione d'ingresso usa
         `transform` in linea, e le due non si devono pestare. */
      capF.style.scale = ''; capF.style.transformOrigin = ''; capF.style.marginBottom = '';
      if (innerWidth <= 900) return;
      /* Sotto gli 800px di altezza il motore fa SCORRERE il contenitore interno
         della slide: la mappa deve stare lì dentro, e sopra i comandi. Alle misure
         di proiezione il contenitore non scorre e la slide resta com'è, come la
         vedono il gate e la sala. */
      const box = capF.parentElement!;
      const ov = getComputedStyle(box).overflowY;
      if (ov !== 'auto' && ov !== 'scroll') return;
      box.scrollTop = 0;
      if (box.scrollHeight - box.clientHeight <= 4) return;
      const bb = box.getBoundingClientRect();
      const ctrl = document.querySelector<HTMLElement>('[data-deck-controls]')?.getBoundingClientRect().top ?? innerHeight;
      const su = bb.top, giu = Math.min(bb.bottom, ctrl - 8);
      const r = capF.getBoundingClientRect();
      const z = Math.min(1, (giu - su) / r.height);
      /* Scala dall'alto e restituisce l'altezza risparmiata: così il contenitore
         non scorre più e l'indicatore «scorri» del motore si spegne da sé. */
      capF.style.transformOrigin = '50% 0';
      capF.style.scale = z.toFixed(3);
      capF.style.marginBottom = `${(-r.height * (1 - z)).toFixed(1)}px`;
      box.removeAttribute('data-scrollable'); box.removeAttribute('data-scroll-end');
    };
    let t = 0;
    const presto = () => { cancelAnimationFrame(t); t = requestAnimationFrame(adatta); };
    addEventListener('resize', presto);
    document.fonts?.ready.then(presto);
    new MutationObserver(presto).observe(slideF, { attributes: true, attributeFilter: ['aria-hidden'] });
    new MutationObserver(presto).observe(document.documentElement, { attributes: true, attributeFilter: ['lang', 'data-lang'] });
    presto();
  }
</script>

