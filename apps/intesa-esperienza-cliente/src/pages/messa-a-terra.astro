---
/**
 * Come si mette a terra — il capitolo fuori dalla storia.
 *
 * ⚠️ PERCHÉ ESISTE (Teams «Intesa: daily check doc», 30 ott 2026). Le slide
 * 9-17 stavano dentro «I sette momenti»: quattro colleghi su quattro hanno
 * scritto che spezzavano il racconto e che «sembra di essere ancora nella
 * storia», mentre lì si dice come quello che si è appena visto si innesta
 * sulla loro architettura. Quindi: capitolo a sé, che assorbe il circolo,
 * e che si apre sull'architettura invece che sui prodotti.
 *
 * Dal 10 nov 2026 sono tre slide: la mappa, il motore e il ritorno. Collegamenti,
 * Brand Visibility, Content Factory e i quattro componenti stanno in
 * `/approfondimenti`, a un clic dalla mappa: l'ora e mezza non li reggeva.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import T from '@edf/core/blocks/i18n/T.astro';
import { href } from '@edf/core/utils/url.js';
import FiguraCap from '../components/FiguraCap.astro';
import HowItWorks from '@edf/core/blocks/HowItWorks.astro';
import Dettaglio from '@edf/core/blocks/Dettaglio.astro';
import DettaglioVoce from '@edf/core/blocks/DettaglioVoce.astro';
import Figura from '../components/Figura.astro';
import InnestoPop from '../components/InnestoPop.astro';
import { CHAPTERS, prevSlug, nextSlug } from '../data/chapters';
import Divisore from '../components/Divisore.astro';
import fondo from '../assets/generated/cover-innesto.webp';
import fondoMisura from '../assets/generated/lavoro-07-misura.webp';

const SLUG = 'messa-a-terra';
const ch = CHAPTERS.find((c) => c.slug === SLUG)!;
const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;
const DETTAGLI = href(base, '/approfondimenti');

/* L'architettura di oggi, a grandi blocchi. SAS è pubblico (storie cliente su
   sas.com); il resto della catena si dice per funzione e resta un'ipotesi. */
const EL = 'https://experienceleague.adobe.com/en/docs';
const CAPACITA = [
  { p: 'Real-Time CDP', k: 'riconosce', r: { it: 'Riconosce', en: 'Recognises' }, v: [
    { it: 'Profilo anche anonimo', en: 'Profiles for anonymous visitors' },
    { it: 'Si unisce al consenso', en: 'Merges at consent' },
    { it: 'Segmenti in tempo reale', en: 'Real-time segments' },
  ], g: { it: 'la riconosce quando lascia il nome', en: 'recognises her when she gives her name' } },
  { p: 'Decisioning', k: 'sceglie', r: { it: 'Sceglie', en: 'Chooses' }, v: [
    { it: 'Un catalogo di offerte', en: 'One offer catalogue' },
    { it: 'Regole e limiti per persona', en: 'Rules and caps per person' },
    { it: 'Classifica con l’AI', en: 'AI ranking' },
  ], g: { it: 'sceglie il promemoria buste paga', en: 'picks the payslip reminder' } },
  { p: 'Journey Optimizer', k: 'agisce', r: { it: 'Agisce', en: 'Acts' }, v: [
    { it: 'Parte da un evento', en: 'Triggered by an event' },
    { it: 'Email, sito, app, SMS', en: 'Email, site, app, SMS' },
    { it: 'Consenso e frequenza', en: 'Consent and frequency' },
  ], g: { it: 'la ricorda su email, sito e social', en: 'follows up by email, site and social' } },
  { p: 'Customer Journey Analytics', k: 'misura', r: { it: 'Misura', en: 'Measures' }, v: [
    { it: 'Un percorso fra i canali', en: 'One journey across channels' },
    { it: 'Parte da Analytics', en: 'Starts from Analytics' },
    { it: 'Attribuzione algoritmica', en: 'Algorithmic attribution' },
  ], g: { it: 'misura quanto è costato acquisirla', en: 'measures what it cost to acquire her' } },
];
const DOC = [
  { l: 'Real-Time CDP · segmentazione edge', u: `${EL}/experience-platform/segmentation/methods/edge-segmentation` },
  { l: 'Journey Optimizer', u: `${EL}/journey-optimizer/using/ajo-home` },
  { l: 'Decisioning', u: `${EL}/journey-optimizer/using/decisioning/gs-decision` },
  { l: 'Connettore Analytics', u: `${EL}/experience-platform/sources/connectors/adobe-applications/analytics` },
];
const OGGI = [
  { t: 'Data warehouse', d: { it: 'i dati dei clienti', en: 'customer data' } },
  { t: 'SAS', forte: true, d: { it: 'target, propensione, eleggibilità', en: 'targets, propensity, eligibility' } },
  { t: 'Campagne', d: { it: 'segmenti, contact policy e invii', en: 'segments, contact policy and sends' } },
  { t: 'Canali', d: { it: 'app, sito, contact center, filiale', en: 'app, site, contact centre, branch' } },
];

/* IL BLOCCO SU CUSTOMER JOURNEY ANALYTICS: dopo lo schema dell'innesto (10 nov 2026). Fonti pubbliche in calce a ogni slide. */
const FONTI = [
  { it: 'Sito', en: 'Website' },
  { it: 'App', en: 'App' },
  { it: 'Contact center', en: 'Contact centre' },
  { it: 'Filiale', en: 'Branch' },
  { it: 'CRM', en: 'CRM' },
];
const TAPPE = [
  { it: 'Sito', en: 'Website' },
  { it: 'App', en: 'App' },
  { it: 'Contact center', en: 'Contact centre' },
  { it: 'Filiale', en: 'Branch' },
  { it: 'Firma', en: 'Signing' },
];

const BANCA = [
  { fig: 'flusso', t: { it: 'Il percorso in sequenza', en: 'The journey in sequence' }, d: { it: 'Digitale, contact center e filiale in ordine, su una persona sola.', en: 'Digital, contact centre and branch in order, on one person.' } },
  { fig: 'esito', t: { it: 'Il digitale fino allo sportello', en: 'Digital through to the counter' }, d: { it: 'Vendite in filiale e al contact center attribuite ai contatti digitali.', en: 'Branch and contact-centre sales attributed to digital touches.' } },
  { fig: 'serie', t: { it: 'Dove si rompe la pratica', en: 'Where the application breaks' }, d: { it: 'Abbandoni delle richieste e chiamate evitabili, punto per punto.', en: 'Abandoned applications and avoidable calls, point by point.' } },
  { fig: 'regia', t: { it: 'Dalla lettura all’azione', en: 'From reading to action' }, d: { it: 'Chi si ferma diventa un’audience per il percorso successivo.', en: 'Whoever stalls becomes an audience for the next journey.' } },
];

/* Altezze schematiche, senza valori: dicono la forma, e la slide lo dichiara. */
const TOCCHI = [
  { it: 'Ricerca', en: 'Search' }, { it: 'Social', en: 'Social' }, { it: 'Sito', en: 'Website' },
  { it: 'App', en: 'App' }, { it: 'Email', en: 'Email' }, { it: 'Filiale', en: 'Branch' },
];
const PERCORSO = [34, 44, 92, 62, 30, 72];

/* IL MOTORE DI TARGETING RESTA (panel del 30 ott 2026, P0). Davanti a chi i
   target li costruisce, «nessuno decide» suonava «il vostro lavoro non serve»:
   il posto esiste, manca la decisione su chi non è cliente. Spostata qui dallo
   Scenario e ridotta a un disegno il 9 nov 2026 su richiesta di chi presenta:
   sta subito dopo la mappa, che dice che il motore resta vostro. */
const ENTRA = [
  { t: { it: 'Score e audience', en: 'Scores and audiences' }, d: { it: 'dal vostro motore', en: 'from your engine' } },
  { t: { it: 'Eleggibilità', en: 'Eligibility' }, d: { it: 'dal core banking', en: 'from core banking' } },
  { t: { it: 'Politica di contatto', en: 'Contact policy' }, d: { it: 'regola vostra', en: 'your rule' } },
];
const RITORNO = [
  { m: '01', g: 'trovare', k: { it: 'Le domande che non vi citavano', en: 'The questions that did not cite you' },
    v: { it: 'Piano dei contenuti', en: 'Content plan' }, p: 'Brand Visibility' },
  { m: '02', g: 'content', k: { it: 'La variante che ha funzionato', en: 'The variant that worked' },
    v: { it: 'Brief per Milano e Bologna', en: 'Brief for Milan and Bologna' }, p: 'GenStudio' },
  { m: '04', g: 'engagement', k: { it: 'La proposta che ha accettato', en: 'The offer she accepted' },
    v: { it: 'Classifica delle proposte', en: 'Offer ranking' }, p: 'Decisioning' },
  { m: '05', g: 'engagement', k: { it: 'Il punto dove si è fermata', en: 'Where she stalled' },
    v: { it: 'Un passo in meno nel percorso', en: 'One step fewer in the journey' }, p: 'Journey Optimizer' },
];
---
<BaseLayout title={ch.title.it}>
  <div class="fixed top-0 left-0 right-0 z-50">
    <Navigation currentPath={currentPath} base={base} />
  </div>

  <DeckContainer nextHref={href(base, nextSlug(SLUG))} prevHref={href(base, prevSlug(SLUG))}>

    <Slide id="slide-cover" bg="secondary" align="left" data-made-with="Adobe Firefly" data-made-with-for="sfondo">
      <div slot="backdrop" class="im-div-bg" style={`--foto: url('${fondo.src}'); --fuoco: center 42%`}></div>
      <Divisore num={ch.num} tIt="Dove ci innestiamo" tEn="Where we plug in" />
    </Slide>

    {/* L'INNESTO, ad alto livello. Parte dall'architettura di oggi, con SAS a monte;
        la freccia giù accende i due componenti Adobe. Ogni componente apre il suo
        mockup a passi. Le etichette sono HTML accanto ai nodi, l'SVG porta i tratti. */}
    <Slide id="slide-innesto" bg="inverse" align="left">
      <div slot="backdrop" class="im-bg-notte"></div>
      <div class="im-ado-cap im-ado-cap--largo" data-reveal>
        <T as="h2" class="im-ado-t im-ado-t--stretto" it="SAS e le campagne restano dove sono, e Adobe aggiunge tre componenti" en="SAS and campaigns stay where they are, and Adobe adds three components" />
        <div class="im-inn">
          <ol class="im-inn-oggi">
            {OGGI.map((n, i) => (
              <li class="im-inn-n" data-forte={n.forte ? '' : null}>
                <span class="im-inn-t">{n.t}</span>
                <T as="span" class="im-inn-d" it={n.d.it} en={n.d.en} />
                {i > 0 && <svg class="im-inn-fr" viewBox="0 0 28 14" aria-hidden="true"><path d="M1 7h24M19 1l6 6-6 6" /></svg>}
              </li>
            ))}
          </ol>

          {/* Real-Time CDP per chi non è ancora cliente: il CRM e il CDP che la
              banca ha già restano sui clienti noti; qui entra il comportamento
              anonimo, che si unisce al profilo al consenso (10 nov 2026). */}
          <div class="im-inn-cdp" data-substep>
            <span class="im-inn-t">Real-Time CDP</span>
            <T as="span" class="im-inn-d" it="Chi non è ancora cliente, dal primo clic al consenso" en="People who are not yet customers, from first click to consent" />
          </div>

          <div class="im-inn-dec" data-substep>
            <svg class="im-inn-cdp-fr" viewBox="0 0 28 14" aria-hidden="true"><path d="M1 7h24M19 1l6 6-6 6" /></svg>
            <div class="im-inn-fili">
              <span class="im-inn-f"><T as="span" it="score e audience" en="scores and audiences" /></span>
              <span class="im-inn-f" data-su><T as="span" it="quale proposta" en="which proposal" /></span>
            </div>
            <button type="button" class="im-inn-b" data-pp-open aria-haspopup="dialog">
              <span class="im-inn-t">Journey Optimizer · Decisioning</span>
              <T as="span" class="im-inn-d" it="Parte dagli eventi in tempo reale e sceglie quale proposta esce. L’invio può restare vostro." en="Starts from real-time events and chooses which proposal goes out. Sending can stay yours." />
              <T as="span" class="im-inn-come" it="Come funziona" en="How it works" />
            </button>
            <InnestoPop scena="decisioning" />
          </div>

          <div class="im-inn-cja" data-substep>
            <span class="im-inn-f im-inn-f--lungo"><T as="span" it="gli esiti" en="outcomes" /></span>
            <span class="im-inn-f im-inn-f--ritorno" data-su><T as="span" it="il risultato" en="the result" /></span>
            <button type="button" class="im-inn-b im-inn-b--largo" data-pp-open aria-haspopup="dialog">
              <span class="im-inn-t">Customer Journey Analytics</span>
              <T as="span" class="im-inn-d" it="Legge Adobe Analytics, che avete, più filiale, contact center e CRM" en="Reads Adobe Analytics, which you have, plus branch, contact centre and CRM" />
              <T as="span" class="im-inn-come" it="Come funziona" en="How it works" />
            </button>
            <InnestoPop scena="cja" />
          </div>
        </div>

        <p class="im-fonte-riga">
          <span data-lang-it>L’architettura attuale è una nostra ipotesi, da correggere con voi. </span><span data-lang-en>The current architecture is our assumption, to correct with you. </span>
          <a href={DETTAGLI}><span data-lang-it>Dettagli tecnici →</span><span data-lang-en>Technical detail →</span></a>
        </p>
      </div>
    </Slide>

    {/* LE CAPABILITY, una colonna per componente, nell'ordine dello schema.
        Solo cose documentate su Experience League (link in fondo), lette il
        10 nov 2026. Ancore, non frasi: il dettaglio lo dà chi parla. */}
    <Slide id="slide-capacita" bg="inverse" align="left">
      <div slot="backdrop" class="im-bg-notte"></div>
      <div class="im-ado-cap im-ado-cap--largo" data-reveal>
        <T as="h2" class="im-ado-t im-ado-t--stretto" it="Che cosa porta ciascun componente" en="What each component brings" />
        <ol class="im-capg">
          {CAPACITA.map((c, i) => (
            <li class="im-capg-col" data-substep data-k={c.k}>
              <svg class="im-capg-fig" viewBox="0 0 120 64" aria-hidden="true">
                {c.k === 'riconosce' && <><circle cx="30" cy="22" r="9" class="tr" /><path d="M14 52c2-11 9-16 16-16s14 5 16 16" class="tr" /><path d="M52 32h16M62 26l6 6-6 6" class="fr" /><circle cx="90" cy="22" r="9" class="ac" /><path d="M74 52c2-11 9-16 16-16s14 5 16 16" class="ac" /></>}
                {c.k === 'sceglie' && <><rect x="8" y="6" width="34" height="9" rx="2" class="pi" /><rect x="8" y="20" width="34" height="9" rx="2" class="pi" /><rect x="8" y="34" width="34" height="9" rx="2" class="pi" /><rect x="8" y="48" width="34" height="9" rx="2" class="pi" /><path d="M46 10 C62 10 62 31 76 31M46 24 C62 24 62 31 76 31M46 38 C62 38 62 31 76 31M46 52 C62 52 62 31 76 31" class="tr" /><rect x="80" y="23" width="32" height="16" rx="3" class="acf" /></>}
                {c.k === 'agisce' && <><circle cx="14" cy="32" r="7" class="acf" /><path d="M21 32h22M43 32 C58 32 58 10 74 10M43 32h31M43 32 C58 32 58 54 74 54" class="tr" /><rect x="78" y="3" width="30" height="14" rx="3" class="pi" /><rect x="78" y="25" width="30" height="14" rx="3" class="pi" /><rect x="78" y="47" width="30" height="14" rx="3" class="pi" /></>}
                {c.k === 'misura' && <><path d="M8 58h104" class="tr" /><rect x="14" y="10" width="16" height="48" rx="2" class="pi" /><rect x="38" y="24" width="16" height="34" rx="2" class="pi" /><rect x="62" y="36" width="16" height="22" rx="2" class="pi" /><rect x="86" y="44" width="16" height="14" rx="2" class="acf" /></>}
              </svg>
              <T as="p" class="im-capg-r" it={c.r.it} en={c.r.en} />
              <p class="im-capg-p">{c.p}</p>
              <ul>{c.v.map((v) => <T as="li" it={v.it} en={v.en} />)}</ul>
              <p class="im-capg-g"><T as="span" class="im-capg-gk" it="Per Giulia" en="For Giulia" /><T as="span" it={c.g.it} en={c.g.en} /></p>
              {i > 0 && <svg class="im-capg-fr" viewBox="0 0 28 14" aria-hidden="true"><path d="M1 7h24M19 1l6 6-6 6" /></svg>}
            </li>
          ))}
        </ol>
        <p class="im-fonte-riga">
          <span data-lang-it>Documentazione: </span><span data-lang-en>Documentation: </span>
          {DOC.map((d, k) => <>{k > 0 && ' · '}<a href={d.u} target="_blank" rel="noopener">{d.l}</a></>)}
        </p>
      </div>
    </Slide>

    <Slide id="slide-unifica" bg="inverse" align="left">
      <div slot="backdrop" class="im-bg-notte"></div>
      <div class="im-ado-cap im-ado-cap--largo" data-reveal>
        <T as="h2" class="im-ado-t im-ado-t--stretto" it="Customer Journey Analytics legge sito, app, contact center e filiale come un percorso solo" en="Customer Journey Analytics reads site, app, contact centre and branch as one journey" />
        <div class="im-un">
          <ul class="im-un-fonti">
            {FONTI.map((f) => <T as="li" it={f.it} en={f.en} />)}
          </ul>
          <div class="im-un-misura" data-substep>
            <div class="im-un-rami" aria-hidden="true">
              <svg viewBox="0 0 100 100" preserveAspectRatio="none">
                {[10, 30, 50, 70, 90].map((y) => <path d={`M0 ${y} C 55 ${y}, 45 50, 100 50`} />)}
              </svg>
            </div>
            <div class="im-un-hub">
              <span class="im-un-hub-t">CX Analytics</span>
              <span class="im-un-hub-d">Customer Journey Analytics</span>
            </div>
          </div>
          <div class="im-un-esito" data-substep>
            <span class="im-un-ponte" aria-hidden="true"></span>
            <div class="im-un-pers">
              <T as="p" class="im-un-pers-t" it="Una persona, dal primo contatto alla firma" en="One person, from first contact to signing" />
              <ol class="im-un-linea">
                {TAPPE.map((t) => (
                  <li><span class="im-un-punto" aria-hidden="true"></span><T as="span" it={t.it} en={t.en} /></li>
                ))}
              </ol>
            </div>
          </div>
        </div>
        <p class="im-fonte-riga">
          <span data-lang-it>Il dato di Adobe Analytics entra senza toccare l’implementazione. Filiale, contact center e CRM entrano se si decide di portarli nel dato. Fonti: </span><span data-lang-en>Adobe Analytics data comes in without touching the implementation. Branch, contact centre and CRM come in if the decision is made to bring them into the data. Sources: </span>
          <a href="https://experienceleague.adobe.com/en/docs/experience-platform/sources/connectors/adobe-applications/analytics" target="_blank" rel="noopener"><span data-lang-it>il connettore di Analytics</span><span data-lang-en>the Analytics connector</span></a> · <a href="https://business.adobe.com/solutions/cx-analytics.html" target="_blank" rel="noopener">Adobe CX Analytics</a>
        </p>
      </div>
    </Slide>

    {/* I MESSAGGI PER UNA BANCA. Da «CJA Analytics Modernization for FSI», dai business
        case bancari e dai casi cliente su Field Readiness (10 nov 2026). Il dettaglio
        Analytics → CJA è negli approfondimenti. */}
    <Slide id="slide-cja-banca" bg="inverse" align="left">
      <div slot="backdrop" class="im-bg-notte"></div>
      <div class="im-ado-cap im-ado-cap--largo" data-reveal>
        <T as="h2" class="im-ado-t im-ado-t--stretto" it="Quattro risposte che una banca ottiene da Customer Journey Analytics" en="Four answers a bank gets from Customer Journey Analytics" />
        <ul class="im-banca">
          {BANCA.map((b) => (
            <li class="im-banca-i" data-substep>
              <FiguraCap segno={b.fig} class="im-banca-fig" />
              <T as="span" class="im-banca-t" it={b.t.it} en={b.t.en} />
              <T as="span" class="im-banca-d" it={b.d.it} en={b.d.en} />
            </li>
          ))}
        </ul>
        <T as="p" class="im-banca-s" it="Si affianca a SAS e al BI che avete, e li lascia dove sono." en="It sits alongside SAS and your BI, and leaves them where they are." />
        <p class="im-fonte-riga">
          <a href="https://experienceleague.adobe.com/en/docs/analytics-platform/using/cja-overview/cja-b2c-overview/cja-faq" target="_blank" rel="noopener"><span data-lang-it>Online e offline in Customer Journey Analytics</span><span data-lang-en>Online and offline in Customer Journey Analytics</span></a><span> · </span>
          <a href={`${href(base, '/approfondimenti')}#slide-passaggio`}><span data-lang-it>Da Adobe Analytics a Customer Journey Analytics →</span><span data-lang-en>From Adobe Analytics to Customer Journey Analytics →</span></a>
        </p>
      </div>
    </Slide>

    <Slide id="slide-attribuzione" bg="inverse" align="left">
      <div slot="backdrop" class="im-bg-doppia" style={`--bg: url('${fondoMisura.src}')`}></div>
      <div class="im-ado-cap im-ado-cap--largo" data-reveal>
        <T as="h2" class="im-ado-t im-ado-t--stretto" it="Quanto del digitale arriva in filiale?" en="How much of digital reaches the branch?" />
        <T as="p" class="im-ado-l" it="Si vede soltanto se la filiale entra nel dato." en="It only shows if the branch is in the data." />

        <div class="im-att">
          <div class="im-att-r" data-substep>
            <div class="im-att-e">
              <T as="span" class="im-att-t" it="Ultimo clic" en="Last click" />
              <T as="span" class="im-att-d" it="Tutto il peso va a un canale solo" en="One channel gets the credit" />
            </div>
            <div class="im-att-barre">
              {TOCCHI.map((_, i) => i === 4
                ? <span class="im-att-b" style="--h:100%"></span>
                : i === 5
                  ? <T as="span" class="im-att-no" it="Non si vede" en="Not visible" />
                  : <span></span>)}
            </div>
          </div>
          <div class="im-att-r" data-substep>
            <div class="im-att-e">
              <T as="span" class="im-att-t" it="Tutto il percorso" en="The whole journey" />
              <T as="span" class="im-att-d" it="Il peso si divide fra i canali, filiale compresa" en="The credit is shared, branch included" />
            </div>
            <div class="im-att-barre" aria-hidden="true">
              {PERCORSO.map((h, i) => <span class="im-att-b" style={`--h:${h}%`} data-filiale={i === 5 ? '' : null}></span>)}
            </div>
          </div>
          <div class="im-att-asse">
            <ol>{TOCCHI.map((t) => <T as="li" it={t.it} en={t.en} />)}</ol>
          </div>
        </div>

        <HowItWorks title="Come si misura" tone="onDark" class="ex-dett">
          <Dettaglio>
            <DettaglioVoce>
              <FiguraCap segno="serie" />
              <T slot="ancora" as="p" it="Oggi, da verificare" en="Today, to check" />
              <T slot="riga" as="p" it="Quale modello usate in Adobe Analytics, e su quali canali." en="Which model you use in Adobe Analytics, and on which channels." />
            </DettaglioVoce>
            <DettaglioVoce>
              <FiguraCap segno="grafo" />
              <T slot="ancora" as="p" it="I modelli" en="The models" />
