---
/**
 * Come si mette a terra — il capitolo fuori dalla storia.
 *
 * ⚠️ PERCHÉ ESISTE (Teams «Intesa: daily check doc», 30 ott 2026). Le slide
 * 9-17 stavano dentro «I sette momenti»: quattro colleghi su quattro hanno
 * scritto che spezzavano il racconto e che «sembra di essere ancora nella
 * storia», mentre lì si dice come quello che si è appena visto si innesta
 * sulla loro architettura. Quindi: capitolo a sé, che assorbe il circolo,
 * e che si apre sull'architettura invece che sui prodotti.
 *
 * Dal 10 nov 2026 sono tre slide: la mappa, il motore e il ritorno. Collegamenti,
 * Brand Visibility, Content Factory e i quattro componenti stanno in
 * `/approfondimenti`, a un clic dalla mappa: l'ora e mezza non li reggeva.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import T from '@edf/core/blocks/i18n/T.astro';
import { href } from '@edf/core/utils/url.js';
import FiguraCap from '../components/FiguraCap.astro';
import HowItWorks from '@edf/core/blocks/HowItWorks.astro';
import Dettaglio from '@edf/core/blocks/Dettaglio.astro';
import DettaglioVoce from '@edf/core/blocks/DettaglioVoce.astro';
import Figura from '../components/Figura.astro';
import InnestoPop from '../components/InnestoPop.astro';
import Segno from '../components/Segno.astro';
import FiguraCapacita from '../components/FiguraCapacita.astro';
import { ATTRIBUZIONE, DIGITALE } from '../data/attribuzione';
import { CONTATTO, INTERAZIONE, PRODOTTO, ESITO, NL, NM, NM_P, NR, FLUSSI, FLUSSI_P, GEO } from '../data/flusso';
import MappaCapacita from '../components/MappaCapacita.astro';
import { CHAPTERS, prevSlug, nextSlug } from '../data/chapters';
import Divisore from '../components/Divisore.astro';
import fondo from '../assets/generated/cover-innesto.webp';
import fondoMisura from '../assets/generated/lavoro-07-misura.webp';
import { TITOLO, CONFINE, OGGI, ACCANTO, EVOLUZIONE, AFFIANCA, IPOTESI, MOMENTO_SCHEMA } from '../data/innesto';
import { MOMENTI } from '../data/momenti';
import '../styles/innesto.css';

const SLUG = 'messa-a-terra';
/* Le chiavi delle carte del perimetro di oggi, nell'ordine di OGGI. */
const CARTE_OGGI = ['lake', 'motore', 'iniz', 'canali'];
const ch = CHAPTERS.find((c) => c.slug === SLUG)!;
const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;
const DETTAGLI = href(base, '/approfondimenti');

/* L'architettura di oggi, a grandi blocchi, sta in `data/innesto.ts` (fonte
   unica anche per il taglio corto). Il nome del motore non è confermato dal
   cliente: «motore di targeting», e «SAS (da confermare)» nel solo riquadro. */
const EL = 'https://experienceleague.adobe.com/en/docs';
const CAPACITA = [
  { p: 'Real-Time Activation', k: 'riconosce', r: { it: 'Riconosce', en: 'Recognises' }, v: [
    { it: 'Un profilo anche per chi non ha ancora lasciato il nome', en: 'A profile even before someone leaves their name' },
    { it: 'Unisce le sessioni quando arriva un identificativo', en: 'Merges sessions when an identifier arrives' },
    { it: 'Segmenti in tempo reale', en: 'Real-time segments' },
  ], g: { it: 'quando lascia l’email, le visite delle sere prima si agganciano al suo profilo', en: 'when she leaves her email, the visits of the evenings before attach to her profile' } },
  { p: 'AI Decisioning', k: 'sceglie', r: { it: 'Sceglie', en: 'Chooses' }, v: [
    { it: 'Un unico catalogo di offerte', en: 'A single offer catalogue' },
    { it: 'Applica la politica di contatto della banca', en: 'Applies the bank’s contact policy' },
    { it: 'Priorità e regole; i modelli AI imparano dalle risposte passate', en: 'Priority and rules; AI models learn from past responses' },
  ], g: { it: 'sceglie il promemoria con appuntamento proposto', en: 'picks the reminder with a proposed appointment' } },
  { p: 'Journey Optimizer', k: 'agisce', r: { it: 'Orchestra', en: 'Orchestrates' }, v: [
    { it: 'Si attiva su un’azione del cliente', en: 'Triggered by a customer action' },
    { it: 'Email, sito, app, SMS, WhatsApp', en: 'Email, site, app, SMS, WhatsApp' },
    { it: 'Consenso e tetto per canale', en: 'Consent and per-channel cap' },
  ], g: { it: 'le ricorda la richiesta per email e sul sito; gli annunci partono da Real-Time Activation', en: 'reminds her of the application by email and on the site; ads start from Real-Time Activation' } },
  { p: 'Customer Journey Analytics', k: 'misura', r: { it: 'Misura', en: 'Measures' }, v: [
    { it: 'Percorso del cliente su tutti i canali', en: 'The customer journey across every channel' },
    { it: 'Comportamento digitale e fonti offline insieme', en: 'Digital behaviour and offline sources together' },
    { it: 'Quanto contribuisce ogni canale ai mutui firmati', en: 'How much each channel contributes to signed mortgages' },
  ], g: { it: 'misura quanto è costato acquisirla', en: 'measures what it cost to acquire her' } },
] as const;
const DOC = [
  { l: 'Real-Time Activation · segmentazione edge', u: `${EL}/experience-platform/segmentation/methods/edge-segmentation` },
  { l: 'Journey Optimizer', u: `${EL}/journey-optimizer/using/ajo-home` },
  { l: 'Decisioning', u: `${EL}/journey-optimizer/using/decisioning/experience-decisioning/gs-experience-decisioning` },
  { l: 'Connettore Analytics', u: `${EL}/experience-platform/sources/connectors/adobe-applications/analytics` },
];

/* IL BLOCCO SU CUSTOMER JOURNEY ANALYTICS: dopo lo schema dell'innesto (10 nov 2026). Fonti pubbliche in calce a ogni slide. */
const FONTI = [
  { it: 'Sito', en: 'Website' },
  { it: 'App', en: 'App' },
  { it: 'Filiale Digitale', en: 'Filiale Digitale' },
  { it: 'Filiale', en: 'Branch' },
  { it: 'CRM', en: 'CRM' },
];
const TAPPE = [
  { it: 'Sito', en: 'Website' },
  { it: 'App', en: 'App' },
  { it: 'Filiale Digitale', en: 'Filiale Digitale' },
  { it: 'Filiale', en: 'Branch' },
  { it: 'Firma', en: 'Signing' },
];

const BANCA = [
  { k: 'sequenza', q: { it: 'In che ordine si muove una persona?', en: 'In what order does a person move?' }, t: { it: 'Sequenza dei contatti su tutti i canali, per ogni cliente e non‑cliente', en: 'Sequence of contacts across every channel, for every customer and non-customer' } },
  { k: 'sportello', q: { it: 'Quante vendite nate online si chiudono in filiale?', en: 'How many sales that start online close in the branch?' }, t: { it: 'Conversioni in filiale attribuite al canale digitale d’origine', en: 'Branch conversions attributed to the originating digital channel' } },
  { k: 'rottura', q: { it: 'Dove si ferma la richiesta?', en: 'Where does the application stop?' }, t: { it: 'Punti di abbandono e chiamate al servizio clienti che ne derivano', en: 'Drop-off points and the customer-service calls they cause' } },
  { k: 'azione', q: { it: 'Che cosa si fa con chi si ferma?', en: 'What happens to those who stop?' }, t: { it: 'Diventa un segmento da ricontattare con Journey Optimizer', en: 'They become a segment to re-contact with Journey Optimizer' } },
];

/* Altezze schematiche, senza valori: dicono la forma, e la slide lo dichiara. */

/* UNA CHIAVE, UNA STORIA (check col referente, 11 nov 2026). Le due tavole
   che ha chiesto stanno in una: l'«omni tracking» — un comportamento seguito
   su proprietà digitali e fisiche, in momenti distinti, con una chiave che
   ricostruisce la storia — e la «translation» da non‑cliente a cliente, dove
   oggi la storia si perde. È quella che lui chiama la killer application per il
   Controllo di Gestione. Il momento 01 non sta qui: la risposta di un
   assistente non si osserva, e la slide non finge di vederla. Le fonti sono in
   calce: stitching di CJA (finestra per pacchetto) e Identity Service.
   IL CODICE PRATICA E L'NDG (call interna e owner, 16 nov 2026). L'NDG lo
   emette il core banking quando la persona diventa cliente (alla firma), non
   all'apertura della pratica: lo ha fatto notare chi conosce i sistemi della
   banca. Il deck lavora su un'IPOTESI DICHIARATA in slide: il codice pratica
   si stacca alla simulazione, quando Giulia lascia l'email, ed è
   riconciliabile con l'NDG. Così sito, pratica e NDG si ricuciono sulla stessa
   persona. Da confermare con i Mutui in fase 0; la finestra di replay dello
   stitching (7/14/30 giorni) resta il limite da dire se chiedono. */
const CHIAVE = [
  { m: '02', id: 'ecid', passo: 1, dove: { it: 'Sito, dall’annuncio', en: 'Site, from the ad' }, k: { it: 'Pseudonimo del browser', en: 'Browser pseudonym' } },
  { m: '03', id: 'pratica', passo: 2, dove: { it: 'Simulazione', en: 'Simulation' }, k: { it: 'Email col consenso e codice pratica', en: 'Email with consent and application code' }, unisce: true },
  { m: '04', id: 'email', passo: 3, dove: { it: 'Sito, si ferma', en: 'Site, stops' }, k: { it: 'Email', en: 'Email' } },
  { m: '05', id: 'email', passo: 3, dove: { it: 'Email', en: 'Email' }, k: { it: 'Email', en: 'Email' } },
  { m: '06', id: 'tel', passo: 4, dove: { it: 'Filiale, apre la pratica', en: 'Branch, opens the application' }, k: { it: 'Codice pratica, email e telefono', en: 'Application code, email and phone' } },
  { m: '07', id: 'ndg', passo: 5, dove: { it: 'Firma e app', en: 'Signing and app' }, k: { it: 'Il core emette l’NDG: diventa cliente', en: 'Core banking issues her customer ID: she becomes a customer' }, cliente: true },
];

/* IL MOTORE DI TARGETING RESTA (panel del 30 ott 2026, P0). Davanti a chi i
   target li costruisce, «nessuno decide» suonava «il vostro lavoro non serve»:
   il posto esiste, manca la decisione su chi non è cliente. Spostata qui dallo
   Scenario e ridotta a un disegno il 9 nov 2026 su richiesta di chi presenta:
   sta subito dopo la mappa, che dice che il motore resta vostro. */
const ENTRA = [
  { t: { it: 'Score e audience', en: 'Scores and audiences' }, d: { it: 'dal vostro motore', en: 'from your engine' } },
  { t: { it: 'Eleggibilità', en: 'Eligibility' }, d: { it: 'dal core banking', en: 'from core banking' } },
  { t: { it: 'Politica di contatto', en: 'Contact policy' }, d: { it: 'regola vostra', en: 'your rule' } },
];
const RITORNO = [
  { m: '01', g: 'trovare', k: { it: 'Domande agli assistenti AI in cui la banca non compare', en: 'Questions to AI assistants where the bank does not appear' },
    v: { it: 'Piano dei contenuti', en: 'Content plan' }, p: 'Brand Visibility', c: { it: 'Comprendere', en: 'Understand' } },
  { m: '02', g: 'content', k: { it: 'La variante creativa con la risposta migliore', en: 'The creative variant with the best response' },
    v: { it: 'Brief per Milano e Bologna', en: 'Brief for Milan and Bologna' }, p: 'GenStudio for Performance Marketing', c: { it: 'Creare', en: 'Create' } },
  /* La riga di AI Decisioning torna (era stata tolta l'11 nov perché parlava di
     «classifica» su un prospect che non ha score): sul prospect la misura
     corregge le REGOLE, non un punteggio. Il numero è quello del momento. */
  { m: '04', g: 'engagement', k: { it: 'Tasso di risposta per proposta', en: 'Response rate by offer' },
    v: { it: 'Priorità e regole aggiornate sui risultati', en: 'Priorities and rules updated on results' }, p: 'AI Decisioning', c: { it: 'Sceglie', en: 'Chooses' } },
  { m: '05', g: 'engagement', k: { it: 'Il passaggio in cui la richiesta si è fermata', en: 'The step where the application stalled' },
    v: { it: 'Un passo in meno nel percorso', en: 'One step fewer in the journey' }, p: 'Journey Optimizer', c: { it: 'Orchestra', en: 'Orchestrates' } },
];
---
<BaseLayout title={ch.title.it}>
  <div class="fixed top-0 left-0 right-0 z-50">
    <Navigation currentPath={currentPath} base={base} />
  </div>

  <DeckContainer nextHref={href(base, nextSlug(SLUG))} prevHref={href(base, prevSlug(SLUG))}>

    <Slide id="slide-cover" bg="secondary" align="left" data-made-with="Adobe Firefly" data-made-with-for="sfondo">
      <div slot="backdrop" class="im-div-bg" style={`--foto: url('${fondo.src}'); --fuoco: center 42%`}></div>
      <Divisore num={ch.num} tIt="Dove ci innestiamo" tEn="Where we plug in" />
    </Slide>


    {/* L'INNESTO, ad alto livello. Parte dall'architettura di oggi, con il motore di targeting a monte;
        la freccia giù accende i due componenti Adobe. Ogni componente apre il suo
        mockup a passi. Le etichette sono HTML accanto ai nodi, l'SVG porta i tratti. */}
    <Slide id="slide-innesto" bg="inverse" align="left">
      <div slot="backdrop" class="im-bg-notte"></div>
      <div class="im-ado-cap im-ado-cap--largo" data-reveal>
        {/* Titolo e riga di confine: decisione del proprietario dell'11 nov 2026.
            SAS non è confermato dal cliente, quindi non sta nel titolo come fatto. */}
        <T as="h2" class="im-ado-t" it={TITOLO.it} en={TITOLO.en} />
        <T as="p" class="im-inn-confine" it={CONFINE.it} en={CONFINE.en} />
        <div class="im-inn">
          {/* DUE CORNICI (check col referente, 11 nov 2026). Sopra, il perimetro
              che la banca ha già: non si sostituisce, si delimita. Sotto, i tre
              componenti Adobe dentro una piattaforma sola, Experience Platform:
              lo stesso profilo e le stesse regole per clienti e non‑clienti, che
              è la differenza da dire senza nominare nessuno. Sono elementi della
              griglia, non pseudo-elementi: il testo si traduce e l'audit lo vede. */}
          <div class="im-inn-cornice im-inn-cornice--oggi" aria-hidden="true">
            <T as="span" class="im-inn-legenda" it="Il perimetro di Intesa Sanpaolo" en="Intesa Sanpaolo’s perimeter" />
            {/* LA LEGENDA DELLE FRECCE (owner, 13 nov 2026): tre segni, tre significati. */}
            <span class="im-inn-legenda im-inn-legenda--frecce">
              <span class="im-lg im-lg--nbe"><i></i><span data-lang-it>Next Best Experience</span><span data-lang-en>Next Best Experience</span></span>
              <span class="im-lg im-lg--dati"><i></i><span data-lang-it>dati</span><span data-lang-en>data</span></span>
              <span class="im-lg im-lg--oggi"><i></i><span data-lang-it>processo di oggi</span><span data-lang-en>today’s process</span></span>
            </span>
          </div>
          {/* La legenda di Experience Platform apre e chiude i Servizi comuni
              (owner, 13 nov 2026): a riposo non si vedono. */}
          <div class="im-inn-cornice im-inn-cornice--aep">
            <button type="button" class="im-inn-legenda im-inn-legenda--aep" data-svc aria-expanded="false" aria-controls="im-svc">Adobe Experience Platform<svg viewBox="0 0 12 12" aria-hidden="true"><path d="M6 2.5v7M2.5 6h7" /></svg></button>
            {/* COME ENTRANO I DATI (owner, 13 nov 2026): l'offerta di integrazione di
                Experience Platform, senza ipotesi sui sistemi della banca. Nomi da
                Experience League, «Data Ingestion Overview». A riposo le icone; con un
                clic i nomi. Si esclude con i Servizi comuni, sullo stesso bordo. */}
            {/* IL COME FUNZIONA (team e owner, 16 nov 2026): il racconto unico, dall'annuncio
                alla firma, si apre da qui in overlay. Sta sul bordo della cornice di Experience
                Platform perché racconta quello che succede DENTRO la cornice; a destra, opposto a
                «Come entrano i dati». Pieno, non a contorno: è l'azione della slide. Al termine
                del racconto il deck va alle «Quattro domande». */}
            <button type="button" class="im-inn-funziona" data-pp-e2e aria-haspopup="dialog">
              <svg viewBox="0 0 12 12" aria-hidden="true"><path d="M3.5 2.2v7.6L9.8 6z" /></svg>
              <span data-lang-it>Come funziona</span><span data-lang-en>How it works</span>
              <span class="im-inn-funziona-d"><span data-lang-it>dall’annuncio alla firma</span><span data-lang-en>from the ad to the signature</span></span>
            </button>
            <button type="button" class="im-inn-ingresso" data-ingresso aria-expanded="false">
              <span class="im-ing-k"><span data-lang-it>Come entrano i dati</span><span data-lang-en>How data comes in</span></span>
              <span class="im-ing-i"><Segno k="online" /><span class="im-ing-n">Web e Mobile SDK</span></span>
              <span class="im-ing-i"><Segno k="connettore" /><span class="im-ing-n"><span data-lang-it>Connettori Sources</span><span data-lang-en>Sources connectors</span></span></span>
              <span class="im-ing-i"><Segno k="stream" /><span class="im-ing-n"><span data-lang-it>API in streaming</span><span data-lang-en>Streaming API</span></span></span>
              <span class="im-ing-i"><Segno k="lotti" /><span class="im-ing-n"><span data-lang-it>Caricamento batch</span><span data-lang-en>Batch ingestion</span></span></span>
            </button>
          </div>
          {/* LE CARTE (owner, 13 nov 2026). La slide si proietta in sala e su Teams:
              a riposo dice solo i ruoli (i titoli) e il perimetro (le pillole
              clienti / non‑clienti e i tipi d'invio). Un clic gira una carta: sul
              retro c'è che cosa fa, e per i componenti Adobe il momento di Giulia
              e «Come funziona». Mentre una carta è girata il resto si abbassa e si
              accendono le sue frecce, con l'etichetta. Un secondo clic, Esc o un
              clic fuori la rigirano. */}
          <ol class="im-inn-oggi">
            {OGGI.map((n, i) => (
              <li class="im-inn-n im-carta-li" data-forte={n.forte ? '' : null} data-luce={CARTE_OGGI[i]}>
                <button type="button" class="im-carta" data-carta={CARTE_OGGI[i]} aria-pressed="false">
                  <span class="im-carta-in">
                    <span class="im-carta-f">
                      <Segno k="giro" />
                      <T as="span" class="im-inn-t" it={n.t.it} en={n.t.en} />
                      {/* Online e offline sul fronte (owner, 14 nov 2026): una terza forma, né
                          pillola (persona) né etichetta (campagna): righe con il segno e la
                          parola, senza contorno. */}
                      {n.canali && (
                        <span class="im-carta-canali">
                          {n.canali.map((c) => (
                            <span class="im-carta-canale"><Segno k={c.k} /><T as="span" it={`<strong>${c.t.it}</strong> ${c.d.it}`} en={`<strong>${c.t.en}</strong> ${c.d.en}`} /></span>
                          ))}
                        </span>
                      )}
                      {n.tipi && (
                        <span class="im-inn-tipi" role="list" aria-label={n.d.it}>
                          {n.tipi.map((x) => x.k
                            ? <T as="span" role="listitem" class="im-inn-tipo im-chi im-chi--c" it={x.it} en={x.en} />
                            : <span role="listitem" class="im-inn-tipo im-come" data-match={x.it === 'programmate' ? '' : null}><Segno k={x.it === 'programmate' ? 'calendario' : 'evento'} /><T as="span" it={x.it} en={x.en} /></span>)}
                        </span>
                      )}
                    </span>
                    <span class="im-carta-r">
                      <T as="span" class="im-carta-k" it={n.t.it} en={n.t.en} />
                      {n.lega ? <T as="span" class="im-inn-d" it={n.lega.it} en={n.lega.en} /> : n.canali ? (
                        <span class="im-inn-ch">
                          {n.canali.map((c) => (
                            <span class="im-inn-ch-i" data-k={c.k}>
                              <Segno k={c.k} />
                              <T as="span" it={`<strong>${c.t.it}</strong> ${c.d.it}`} en={`<strong>${c.t.en}</strong> ${c.d.en}`} />
                            </span>
                          ))}
                        </span>
                      ) : <T as="span" class="im-inn-d" it={n.d.it} en={n.d.en} />}
                    </span>
                  </span>
                </button>
                {i > 0 && <svg class="im-inn-fr" viewBox="0 0 28 14" aria-hidden="true"><path d="M1 7h24M19 1l6 6-6 6" /></svg>}
              </li>
            ))}
          </ol>

          {/* «Real-Time Activation» (owner, 13 nov 2026) è il nome che il deck dà a
              Adobe Real-Time CDP: dice che cosa fa, attivare, e non si sovrappone
              al Data Cloud di Salesforce. Il prodotto si chiama ancora Real-Time CDP
              (wiki di terminologia, 2 ott 2026): in sala, se chiedono, si dice.
              Sui non‑clienti: il CRM e il CDP che la banca ha già restano sui
              clienti noti; qui entra il comportamento anonimo, che si unisce al
              profilo quando la persona lascia l'email. La pillola «non‑clienti»
              sta sul fronte, come quelle delle Iniziative (owner, 13 nov 2026). */}
          <div class="im-inn-cdp" data-substep>
            <div class="im-inn-bx im-inn-bx--cdp im-carta im-carta--aep" data-carta="cdp" data-luce="cdp" role="button" tabindex="0" aria-pressed="false" aria-label="Real-Time Activation">
              <div class="im-carta-in">
                <div class="im-carta-f">
                  <Segno k="giro" />
                  <span class="im-inn-t">Real-Time Activation</span>
                  <span class="im-inn-tipi im-inn-tipi--b" role="list"><T as="span" role="listitem" class="im-inn-tipo im-chi im-chi--nc" it="non‑clienti" en="non-customers" /></span>
                </div>
                <div class="im-carta-r">
                  <T as="span" class="im-inn-d" it="Le visite dei non‑clienti si uniscono al profilo" en="Non-customers’ visits join the profile" />
                  <span class="im-carta-az"><button type="button" class="im-inn-m" data-mom="03" aria-controls="im-gm" aria-expanded="false"><span data-lang-it>momento 03</span><span data-lang-en>moment 03</span><svg viewBox="0 0 12 12" aria-hidden="true"><path d="M4.5 2.5 8 6l-3.5 3.5" /></svg></button><span class="im-carta-pp"><button type="button" class="im-carta-come" data-pp-open aria-haspopup="dialog"><span data-lang-it>Come funziona</span><span data-lang-en>How it works</span><svg viewBox="0 0 12 12" aria-hidden="true"><path d="M4.5 2.5 8 6l-3.5 3.5" /></svg></button><InnestoPop scena="cdp" /></span></span>
                </div>
              </div>
            </div>
          </div>

          <div class="im-inn-dec" data-substep>
            <span class="im-inn-cdp-dati" aria-hidden="true" data-luce="cdp ajo"></span>
            <i class="im-inn-cdp-segno" role="img" aria-label="profilo" data-luce="cdp ajo" data-muto><Segno k="profilo" /></i>
            <div class="im-inn-fili">
              <span class="im-inn-f im-inn-f--sx" data-luce="motore ajo" data-muto><span class="im-inn-lab"><Segno k="score" /><T as="span" it="score e segmenti" en="scores and segments" /></span></span>
              {/* La freccia bianca entra nelle Iniziative sotto la pillola
