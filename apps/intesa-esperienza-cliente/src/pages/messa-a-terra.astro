---
/**
 * Come si mette a terra — il capitolo fuori dalla storia.
 *
 * ⚠️ PERCHÉ ESISTE (Teams «Intesa: daily check doc», 30 ott 2026). Le slide
 * 9-17 stavano dentro «I sette momenti»: quattro colleghi su quattro hanno
 * scritto che spezzavano il racconto e che «sembra di essere ancora nella
 * storia», mentre lì si dice come quello che si è appena visto si innesta
 * sulla loro architettura. Quindi: capitolo a sé, che assorbe il circolo,
 * e che si apre sull'architettura invece che sui prodotti.
 *
 * Dal 10 nov 2026 sono tre slide: la mappa, il motore e il ritorno. Collegamenti,
 * Brand Visibility, Content Factory e i quattro componenti stanno in
 * `/approfondimenti`, a un clic dalla mappa: l'ora e mezza non li reggeva.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import T from '@edf/core/blocks/i18n/T.astro';
import { href } from '@edf/core/utils/url.js';
import FiguraCap from '../components/FiguraCap.astro';
import HowItWorks from '@edf/core/blocks/HowItWorks.astro';
import Dettaglio from '@edf/core/blocks/Dettaglio.astro';
import DettaglioVoce from '@edf/core/blocks/DettaglioVoce.astro';
import Figura from '../components/Figura.astro';
import InnestoPop from '../components/InnestoPop.astro';
import { CHAPTERS, prevSlug, nextSlug } from '../data/chapters';
import Divisore from '../components/Divisore.astro';
import fondo from '../assets/generated/cover-innesto.webp';
import fondoMisura from '../assets/generated/lavoro-07-misura.webp';
import { TITOLO, CONFINE, OGGI, ACCANTO, EVOLUZIONE, FREQUENZA, DECIDETE, IPOTESI, MOMENTO_SCHEMA } from '../data/innesto';
import { MOMENTI } from '../data/momenti';
import '../styles/innesto.css';

const SLUG = 'messa-a-terra';
const ch = CHAPTERS.find((c) => c.slug === SLUG)!;
const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;
const DETTAGLI = href(base, '/approfondimenti');

/* L'architettura di oggi, a grandi blocchi, sta in `data/innesto.ts` (fonte
   unica anche per il taglio corto). Il nome del motore non è confermato dal
   cliente: «motore di targeting», e «SAS (da confermare)» nel solo riquadro. */
const EL = 'https://experienceleague.adobe.com/en/docs';
const CAPACITA = [
  { p: 'Real-Time CDP', k: 'riconosce', r: { it: 'Riconosce', en: 'Recognises' }, v: [
    { it: 'Profilo anche sotto pseudonimo', en: 'Profiles under a pseudonym too' },
    { it: 'Unisce le sessioni quando arriva un identificativo', en: 'Merges sessions when an identifier arrives' },
    { it: 'Segmenti in tempo reale', en: 'Real-time segments' },
  ], g: { it: 'la riconosce quando lascia l’email', en: 'recognises her when she leaves her email' } },
  { p: 'AI Decisioning', k: 'sceglie', r: { it: 'Sceglie', en: 'Chooses' }, v: [
    { it: 'Un unico catalogo di offerte', en: 'A single offer catalogue' },
    { it: 'Applica la politica di contatto della banca', en: 'Applies the bank’s contact policy' },
    { it: 'Priorità e regole; modelli AI dove ci sono dati storici di risposta', en: 'Priority and rules; AI models where response history exists' },
  ], g: { it: 'sceglie il promemoria con appuntamento proposto', en: 'picks the reminder with a proposed appointment' } },
  { p: 'Journey Optimizer', k: 'agisce', r: { it: 'Invia', en: 'Sends' }, v: [
    { it: 'Si attiva su un’azione del cliente', en: 'Triggered by a customer action' },
    { it: 'Email, sito, app, SMS', en: 'Email, site, app, SMS' },
    { it: 'Consenso e tetto per canale', en: 'Consent and per-channel cap' },
  ], g: { it: 'le ricorda la richiesta via email e sul sito; gli annunci di retargeting partono da Real-Time CDP', en: 'reminds her of the application by email and on the site; retargeting ads start from Real-Time CDP' } },
  { p: 'Customer Journey Analytics', k: 'misura', r: { it: 'Misura', en: 'Measures' }, v: [
    { it: 'Percorso del cliente su tutti i canali', en: 'The customer journey across every channel' },
    { it: 'Usa i dati di Adobe Analytics', en: 'Uses Adobe Analytics data' },
    { it: 'Attribuzione algoritmica delle firme', en: 'Algorithmic attribution of signatures' },
  ], g: { it: 'misura quanto è costato acquisirla', en: 'measures what it cost to acquire her' } },
];
const DOC = [
  { l: 'Real-Time CDP · segmentazione edge', u: `${EL}/experience-platform/segmentation/methods/edge-segmentation` },
  { l: 'Journey Optimizer', u: `${EL}/journey-optimizer/using/ajo-home` },
  { l: 'Decisioning', u: `${EL}/journey-optimizer/using/decisioning/experience-decisioning/gs-experience-decisioning` },
  { l: 'Connettore Analytics', u: `${EL}/experience-platform/sources/connectors/adobe-applications/analytics` },
];

/* IL BLOCCO SU CUSTOMER JOURNEY ANALYTICS: dopo lo schema dell'innesto (10 nov 2026). Fonti pubbliche in calce a ogni slide. */
const FONTI = [
  { it: 'Sito', en: 'Website' },
  { it: 'App', en: 'App' },
  { it: 'Filiale Digitale', en: 'Filiale Digitale' },
  { it: 'Filiale', en: 'Branch' },
  { it: 'CRM', en: 'CRM' },
];
const TAPPE = [
  { it: 'Sito', en: 'Website' },
  { it: 'App', en: 'App' },
  { it: 'Filiale Digitale', en: 'Filiale Digitale' },
  { it: 'Filiale', en: 'Branch' },
  { it: 'Firma', en: 'Signing' },
];

const BANCA = [
  { k: 'sequenza', q: { it: 'In che ordine si muove il cliente?', en: 'In what order does the customer move?' }, t: { it: 'Sequenza dei contatti su tutti i canali, per singolo cliente', en: 'Sequence of contacts across every channel, per customer' } },
  { k: 'sportello', q: { it: 'Quante richieste nate online si firmano in filiale?', en: 'How many online applications are signed in branch?' }, t: { it: 'Firme in filiale attribuite al canale digitale d’origine', en: 'Branch signatures attributed to the originating digital channel' } },
  { k: 'rottura', q: { it: 'Dove si ferma la richiesta?', en: 'Where does the application stop?' }, t: { it: 'Punti di abbandono e chiamate al servizio clienti che ne derivano', en: 'Drop-off points and the customer-service calls they cause' } },
  { k: 'azione', q: { it: 'Che cosa si fa con chi si ferma?', en: 'What happens to those who stop?' }, t: { it: 'Diventa un segmento da ricontattare con Journey Optimizer', en: 'They become a segment to re-contact with Journey Optimizer' } },
];

/* Altezze schematiche, senza valori: dicono la forma, e la slide lo dichiara. */
const TOCCHI = [
  { it: 'Search', en: 'Search' }, { it: 'Social', en: 'Social' }, { it: 'Sito', en: 'Website' },
  { it: 'App', en: 'App' }, { it: 'Email', en: 'Email' }, { it: 'Filiale', en: 'Branch' },
];
const PERCORSO = [34, 44, 92, 62, 30, 72];

/* UNA CHIAVE, UNA STORIA (check col referente, 11 nov 2026). Le due tavole
   che ha chiesto stanno in una: l'«omni tracking» — un comportamento seguito
   su proprietà digitali e fisiche, in momenti distinti, con una chiave che
   ricostruisce la storia — e la «translation» da non‑cliente a cliente, dove
   oggi la storia si perde. È quella che lui chiama la killer application per il
   Controllo di Gestione. Il momento 01 non sta qui: la risposta di un
   assistente non si osserva, e la slide non finge di vederla. Le fonti sono in
   calce: stitching di CJA (finestra per pacchetto) e Identity Service. */
const CHIAVE = [
  { m: '02', dove: { it: 'Sito, dall’annuncio', en: 'Site, from the ad' }, k: { it: 'Pseudonimo del browser', en: 'Browser pseudonym' } },
  { m: '03', dove: { it: 'Simulazione', en: 'Simulation' }, k: { it: 'Pseudonimo + email, col consenso', en: 'Pseudonym + email, with consent' }, unisce: true },
  { m: '04', dove: { it: 'Sito, si ferma', en: 'Site, stops' }, k: { it: 'Email', en: 'Email' } },
  { m: '05', dove: { it: 'Email', en: 'Email' }, k: { it: 'Email', en: 'Email' } },
  { m: '06', dove: { it: 'Filiale', en: 'Branch' }, k: { it: 'Email e telefono', en: 'Email and phone' } },
  { m: '07', dove: { it: 'Firma e app', en: 'Signing and app' }, k: { it: 'NDG, all’apertura del rapporto', en: 'Customer ID (NDG), at account opening' }, cliente: true },
];

/* IL MOTORE DI TARGETING RESTA (panel del 30 ott 2026, P0). Davanti a chi i
   target li costruisce, «nessuno decide» suonava «il vostro lavoro non serve»:
   il posto esiste, manca la decisione su chi non è cliente. Spostata qui dallo
   Scenario e ridotta a un disegno il 9 nov 2026 su richiesta di chi presenta:
   sta subito dopo la mappa, che dice che il motore resta vostro. */
const ENTRA = [
  { t: { it: 'Score e audience', en: 'Scores and audiences' }, d: { it: 'dal vostro motore', en: 'from your engine' } },
  { t: { it: 'Eleggibilità', en: 'Eligibility' }, d: { it: 'dal core banking', en: 'from core banking' } },
  { t: { it: 'Politica di contatto', en: 'Contact policy' }, d: { it: 'regola vostra', en: 'your rule' } },
];
const RITORNO = [
  { m: '01', g: 'trovare', k: { it: 'Domande agli assistenti AI in cui la banca non compare', en: 'Questions to AI assistants where the bank does not appear' },
    v: { it: 'Piano dei contenuti', en: 'Content plan' }, p: 'Brand Visibility' },
  { m: '02', g: 'content', k: { it: 'La variante creativa con la risposta migliore', en: 'Response by creative variant' },
    v: { it: 'Brief per le prossime iniziative (es. Milano e Bologna)', en: 'Brief for the next initiatives (e.g. Milan and Bologna)' }, p: 'GenStudio' },
  /* La riga di AI Decisioning torna (era stata tolta l'11 nov perché parlava di
     «classifica» su un prospect che non ha score): sul prospect la misura
     corregge le REGOLE, non un punteggio. Il numero è quello del momento. */
  { m: '04', g: 'engagement', k: { it: 'Tasso di risposta per proposta', en: 'Response rate per offer' },
    v: { it: 'Priorità e regole riviste a fine trimestre', en: 'Priority and rules revised at quarter end' }, p: 'AI Decisioning' },
  { m: '05', g: 'engagement', k: { it: 'Il passaggio in cui la richiesta si è fermata', en: 'The step where the application stalled' },
    v: { it: 'Percorso semplificato in quel passaggio', en: 'Journey simplified at that step' }, p: 'Journey Optimizer' },
];
---
<BaseLayout title={ch.title.it}>
  <div class="fixed top-0 left-0 right-0 z-50">
    <Navigation currentPath={currentPath} base={base} />
  </div>

  <DeckContainer nextHref={href(base, nextSlug(SLUG))} prevHref={href(base, prevSlug(SLUG))}>

    <Slide id="slide-cover" bg="secondary" align="left" data-made-with="Adobe Firefly" data-made-with-for="sfondo">
      <div slot="backdrop" class="im-div-bg" style={`--foto: url('${fondo.src}'); --fuoco: center 42%`}></div>
      <Divisore num={ch.num} tIt="Dove ci innestiamo" tEn="Where we plug in" />
    </Slide>

    {/* L'INNESTO, ad alto livello. Parte dall'architettura di oggi, con il motore di targeting a monte;
        la freccia giù accende i due componenti Adobe. Ogni componente apre il suo
        mockup a passi. Le etichette sono HTML accanto ai nodi, l'SVG porta i tratti. */}
    <Slide id="slide-innesto" bg="inverse" align="left">
      <div slot="backdrop" class="im-bg-notte"></div>
      <div class="im-ado-cap im-ado-cap--largo" data-reveal>
        {/* Titolo e riga di confine: decisione del proprietario dell'11 nov 2026.
            SAS non è confermato dal cliente, quindi non sta nel titolo come fatto. */}
        <T as="h2" class="im-ado-t" it={TITOLO.it} en={TITOLO.en} />
        <T as="p" class="im-inn-confine" it={CONFINE.it} en={CONFINE.en} />
        <div class="im-inn">
          {/* DUE CORNICI (check col referente, 11 nov 2026). Sopra, il perimetro
              che la banca ha già: non si sostituisce, si delimita. Sotto, i tre
              componenti Adobe dentro una piattaforma sola, Experience Platform:
              lo stesso profilo e le stesse regole per clienti e non‑clienti, che
              è la differenza da dire senza nominare nessuno. Sono elementi della
              griglia, non pseudo-elementi: il testo si traduce e l'audit lo vede. */}
          <div class="im-inn-cornice im-inn-cornice--oggi" aria-hidden="true">
            <T as="span" class="im-inn-legenda" it="Il perimetro che avete già" en="What you already have" />
          </div>
          <div class="im-inn-cornice im-inn-cornice--aep" aria-hidden="true">
            <span class="im-inn-legenda im-inn-legenda--aep">Adobe Experience Platform</span>
          </div>
          <ol class="im-inn-oggi">
            {OGGI.map((n, i) => (
              <li class="im-inn-n" data-forte={n.forte ? '' : null}>
                <T as="span" class="im-inn-t" it={n.t.it} en={n.t.en} />
                {n.s && <T as="span" class="im-inn-s" it={n.s.it} en={n.s.en} />}
                {n.canali ? (
                  <span class="im-inn-ch">
                    {n.canali.map((c) => (
                      <span class="im-inn-ch-i" data-k={c.k}>
                        {c.k === 'online'
                          ? <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="2" y="4" width="13" height="10" rx="1.5" /><path d="M5.5 18h6M8.5 14v4" /><rect x="17" y="7" width="5" height="11" rx="1" /></svg>
                          : <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 9.5 12 4l9 5.5" /><path d="M5.5 10v8M10 10v8M14 10v8M18.5 10v8" /><path d="M3 20.5h18" /></svg>}
                        <T as="span" it={`<strong>${c.t.it}</strong> ${c.d.it}`} en={`<strong>${c.t.en}</strong> ${c.d.en}`} />
                      </span>
                    ))}
                  </span>
                ) : <T as="span" class="im-inn-d" it={n.d.it} en={n.d.en} />}
                {i > 0 && <svg class="im-inn-fr" viewBox="0 0 28 14" aria-hidden="true"><path d="M1 7h24M19 1l6 6-6 6" /></svg>}
              </li>
            ))}
          </ol>

          {/* Real-Time CDP per chi non è ancora cliente: il CRM e il CDP che la
              banca ha già restano sui clienti noti; qui entra il comportamento
              anonimo, che si unisce al profilo quando la persona lascia l'email. */}
          <div class="im-inn-cdp" data-substep>
            <div class="im-inn-bx im-inn-bx--cdp">
              <button type="button" class="im-inn-b im-inn-b--cdp" data-pp-open aria-haspopup="dialog" aria-label="Real-Time CDP: come funziona">
                <span class="im-inn-t">Real-Time CDP</span>
                <T as="span" class="im-inn-d" it="non‑clienti: le visite si uniscono al profilo" en="Non-customers: visits stitched into the profile" />
                <span class="im-inn-piu" aria-hidden="true">+</span>
              </button>
              <button type="button" class="im-inn-m" data-mom="03" aria-controls="im-gm" aria-expanded="false"><span data-lang-it>momento 03</span><span data-lang-en>moment 03</span><svg viewBox="0 0 12 12" aria-hidden="true"><path d="M4.5 2.5 8 6l-3.5 3.5" /></svg></button>
              <InnestoPop scena="cdp" />
            </div>
          </div>

          <div class="im-inn-dec" data-substep>
            <svg class="im-inn-cdp-fr" viewBox="0 0 28 14" aria-hidden="true"><path d="M1 7h24M19 1l6 6-6 6" /></svg>
            <div class="im-inn-fili">
              <span class="im-inn-f"><T as="span" it="score e segmenti" en="scores and segments" /></span>
              <span class="im-inn-f" data-su><T as="span" it="proposta scelta" en="selected offer" /></span>
            </div>
            <div class="im-inn-bx">
              <button type="button" class="im-inn-b" data-pp-open aria-haspopup="dialog">
                <span class="im-inn-t">Journey Optimizer · AI Decisioning</span>
                <T as="span" class="im-inn-d" it="Il percorso parte da un’azione del cliente; AI Decisioning sceglie l’offerta da mostrare, entro consenso e regole di contatto" en="The journey starts from a customer action; AI Decisioning picks the offer to show, within consent and contact rules" />
                <span class="im-inn-piu" aria-hidden="true">+</span>
              </button>
              <button type="button" class="im-inn-m" data-mom="04-06" aria-controls="im-gm" aria-expanded="false"><span data-lang-it>momenti 04–06</span><span data-lang-en>moments 04–06</span><svg viewBox="0 0 12 12" aria-hidden="true"><path d="M4.5 2.5 8 6l-3.5 3.5" /></svg></button>
              <InnestoPop scena="decisioning" />
            </div>
          </div>

          <div class="im-inn-cja" data-substep>
            <span class="im-inn-f im-inn-f--lungo"><T as="span" it="dati online e offline" en="online and offline data" /></span>
            <span class="im-inn-f im-inn-f--ritorno" data-su><T as="span" it="risultati per canale" en="results by channel" /></span>
            <div class="im-inn-bx im-inn-b--largo">
              <button type="button" class="im-inn-b" data-pp-open aria-haspopup="dialog">
                <span class="im-inn-t">Customer Journey Analytics</span>
                <T as="span" class="im-inn-d" it="Legge insieme i dati online di Adobe Analytics e quelli offline di filiale, Filiale Digitale e CRM" en="Reads Adobe Analytics online data together with offline data from branch, Filiale Digitale and CRM" />
                <span class="im-inn-piu" aria-hidden="true">+</span>
              </button>
              <button type="button" class="im-inn-m" data-mom="07" aria-controls="im-gm" aria-expanded="false"><span data-lang-it>momento 07</span><span data-lang-en>moment 07</span><svg viewBox="0 0 12 12" aria-hidden="true"><path d="M4.5 2.5 8 6l-3.5 3.5" /></svg></button>
              <InnestoPop scena="cja" />
            </div>
          </div>

          {/* I SERVIZI COMUNI di Experience Platform (owner, 13 nov 2026): i tre
              componenti stanno sopra le stesse fondamenta, configurate una volta
              per tutte le applicazioni. Nomi da Experience League, «How Adobe
              Experience Platform and applications work together». */}
          <p class="im-inn-svc">
            <T as="span" class="im-inn-svc-k" it="Servizi comuni" en="Shared services" />
            <T as="span" it="Sorgenti" en="Sources" />
            <T as="span" it="Identità" en="Identity" />
            <T as="span" it="Profilo" en="Profile" />
            <T as="span" it="Segmentazione" en="Segmentation" />
            <T as="span" it="Governance e consenso" en="Governance and consent" />
            <span>Query Service</span>
          </p>

          {/* LA COLONNA DEL MOMENTO (owner, 13 nov 2026): si apre dalla pillola,
              a destra, sopra la colonna dei canali. Non è un modale: non blocca
              il deck e si chiude con la ×, con Esc o ripremendo la pillola. */}
          <aside class="im-gm" id="im-gm" aria-label="Il momento di Giulia" hidden>
            <button type="button" class="im-gm-x" data-mom-chiudi aria-label="Chiudi"><svg viewBox="0 0 12 12" aria-hidden="true"><path d="M2.5 2.5l7 7M9.5 2.5l-7 7" /></svg></button>
            {Object.entries(MOMENTO_SCHEMA).map(([k, m]) => (
              <div class="im-gm-p" data-mom-p={k} hidden>
                <p class="im-gm-q"><span data-lang-it>Giulia · {k === '04-06' ? 'momenti 04–06' : `momento ${k}`}</span><span data-lang-en>Giulia · {k === '04-06' ? 'moments 04–06' : `moment ${k}`}</span></p>
                <T as="p" class="im-gm-h" it={m.quando.it} en={m.quando.en} />
                <ol class="im-gm-fila" aria-hidden="true">
                  {MOMENTI.map((x, i) => (
                    <li data-on={m.attivi.includes(i) ? '' : null}><T as="span" it={x.short.it} en={x.short.en} /></li>
                  ))}
                </ol>
                <dl class="im-gm-dl">
                  <div><T as="dt" it="Lei" en="She" /><T as="dd" it={m.lei.it} en={m.lei.en} /></div>
                  <div><T as="dt" it="La banca" en="The bank" /><T as="dd" it={m.banca.it} en={m.banca.en} /></div>
                  <div data-cambia><T as="dt" it="Che cosa cambia" en="What changes" /><T as="dd" it={m.cambia.it} en={m.cambia.en} /></div>
                </dl>
              </div>
            ))}
          </aside>
        </div>

        {/* LA POSIZIONE DELLE CAMPAGNE (decisione del proprietario, 11 nov 2026):
            in slide si proietta solo «Accanto», su cui si decide il 19. Le altre
            posizioni sono opzioni nel dettaglio, senza numeri — i numeri di fase
            sono del piano. Lo strumento di campagna di oggi non si nomina. */}
        <div class="im-accanto-riga">
        <div class="im-accanto" data-substep>
          <T as="span" class="im-accanto-k" it={ACCANTO.k.it} en={ACCANTO.k.en} />
          <T as="strong" class="im-accanto-t" it={ACCANTO.t.it} en={ACCANTO.t.en} />
          <T as="span" class="im-accanto-d" it={ACCANTO.d.it} en={ACCANTO.d.en} />
        </div>
        <HowItWorks title="Come possono evolvere le iniziative" label="Come possono evolvere le iniziative" tone="onDark" class="ex-dett">
          {/* Tre tappe in fila con la freccia fra l'una e l'altra: la prima è
              accesa (si parte da lì), le altre due dicono chi le decide. La
              frequenza è una decisione di fase 0, non una tappa: sta sotto. */}
          <ol class="im-evo" role="list">
            {EVOLUZIONE.map((e) => (
              <li class="im-evo-i" data-ora={e.ora ? '' : null}>
                <FiguraCap segno={e.segno} />
                <T as="span" class="im-evo-k" it={e.k.it} en={e.k.en} />
                <T as="strong" class="im-evo-t" it={e.t.it} en={e.t.en} />
                <T as="p" class="im-evo-d" it={e.d.it} en={e.d.en} />
              </li>
            ))}
          </ol>
          <div class="im-evo-note">
            <T as="p" class="im-evo-n" it={FREQUENZA.it} en={FREQUENZA.en} />
            <T as="p" class="im-evo-n" it={DECIDETE.it} en={DECIDETE.en} />
          </div>
        </HowItWorks>
        </div>
        <p class="im-fonte-riga">
          <span data-lang-it>{IPOTESI.it} </span><span data-lang-en>{IPOTESI.en} </span>
          <a href={DETTAGLI}><span data-lang-it>Dettagli tecnici →</span><span data-lang-en>Technical detail →</span></a>
        </p>
      </div>
    </Slide>

    {/* LE CAPABILITY, una colonna per componente, nell'ordine dello schema.
        Solo cose documentate su Experience League (link in fondo), lette il
        10 nov 2026. Ancore, non frasi: il dettaglio lo dà chi parla. */}
    <Slide id="slide-capacita" bg="inverse" align="left">
