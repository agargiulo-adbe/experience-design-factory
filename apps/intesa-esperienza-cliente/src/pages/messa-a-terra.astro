<script>
  /* La colonna del momento di Giulia: una pillola la apre, la stessa la
     richiude, un'altra la cambia. Si chiude anche con la ×, con Esc e quando
     si lascia la slide (il deck mette aria-hidden su quella che esce). */
  const col = document.getElementById('im-gm');
  if (col) {
    const pills = () => document.querySelectorAll<HTMLButtonElement>('#slide-innesto .im-inn-m[data-mom]');
    const chiudi = () => {
      col.hidden = true;
      pills().forEach((p) => p.setAttribute('aria-expanded', 'false'));
    };
    const apri = (k: string) => {
      col.querySelectorAll<HTMLElement>('[data-mom-p]').forEach((el) => { el.hidden = el.dataset.momP !== k; });
      pills().forEach((p) => p.setAttribute('aria-expanded', String(p.dataset.mom === k)));
      col.hidden = false;
    };
    document.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      const p = t.closest<HTMLButtonElement>('.im-inn-m[data-mom]');
      if (p) {
        e.stopPropagation();
        if (!col.hidden && p.getAttribute('aria-expanded') === 'true') chiudi();
        else apri(p.dataset.mom!);
        return;
      }
      if (t.closest('[data-mom-chiudi]')) { e.stopPropagation(); chiudi(); }
    }, true);
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !col.hidden && !document.querySelector('dialog.pp[open]')) chiudi();
    });
    const slide = document.getElementById('slide-innesto');
    if (slide) new MutationObserver(() => { if (slide.getAttribute('aria-hidden') === 'true') chiudi(); })
      .observe(slide, { attributes: true, attributeFilter: ['aria-hidden'] });
  }
</script>
