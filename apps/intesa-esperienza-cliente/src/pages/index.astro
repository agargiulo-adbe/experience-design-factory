---
/**
 * La copertina della Storia — slide sequenziali.
 *
 * Il tipo di deliverable è la prima cosa che si legge, e la riga la rende
 * `EXPERIENCE_TYPES[type].coverLine`: mai una stringa a mano.
 * Il lockup co-brand `hero` sta sulla PRIMA e sull'ULTIMA slide del
 * percorso (qui e sulla slide-firma di `risultati`), ed è regola del motore.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import CoBrand from '../components/CoBrand.astro';
import LoopVideo from '@edf/core/blocks/immersive/LoopVideo.astro';
import T from '@edf/core/blocks/i18n/T.astro';
import { href } from '@edf/core/utils/url.js';
import { EXPERIENCE_TYPES } from '@edf/core/data/experienceTypes';
import { SITE } from '../data/site';
import { CHAPTERS } from '../data/chapters';
import { AGENDA as AGENDA_SALA, TITOLO_INCONTRO } from '../data/agenda';
import { EDIZIONE } from '@edf/core/utils/edizione';
import ContaAperture from '@edf/core/blocks/immersive/ContaAperture.astro';
import { PROGETTO_EDIZIONE } from '../data/contatti';
import ritratto from '../assets/generated/persona-giulia.webp';
import { MOMENTI } from '../data/momenti';

const type = EXPERIENCE_TYPES[SITE.type];
const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;
const first = CHAPTERS[0];
/* La clip sta sul Release `media`, ricucita con `pnpm loop:seamless` perché
   il giro non faccia stacco. Il poster è in `public/`, così la copertina è
   già composta prima che la rete risponda. */
const CLIP = 'https://github.com/agargiulo-adbe/experience-design-factory/releases/download/media';
const last = CHAPTERS[CHAPTERS.length - 1];
/* Edizione da distribuire: la copertina non è più quella di un incontro.
   Niente data, e l'indice diventa «Da dove volete partire», con l'ultimo
   capitolo che porta a «Parliamone» invece che ai prossimi passi. */
const LETTURA = EDIZIONE === 'lettura';
const AGENDA = LETTURA
  ? AGENDA_SALA.map((v) => v.capitolo === 'prossimi-passi'
      ? { ...v, capitolo: 'parliamone', ancora: undefined, titolo: { it: 'Parliamone', en: 'Let’s talk' } }
      : v)
  : AGENDA_SALA;
---
<BaseLayout title={SITE.name}>
  <div class="fixed top-0 left-0 right-0 z-50">
    <Navigation currentPath={currentPath} base={base} />
  </div>

  <DeckContainer nextHref={href(base, '/' + first.slug)} prevHref={href(base, '/' + last.slug)}>

    {/* ⚠️ LA COPERTINA DELL'INCONTRO, NON DELLA SOLA STORIA.
        Da quando questo documento ingloba il deck del 5 novembre, la
        copertina ha un secondo mestiere: dire **che cosa c'è dentro**.
        Nel `.pptx` quel mestiere lo facevano otto slide «Agenda»
        ripetute fra un capitolo e l'altro — qui l'indice sta in
        copertina, una volta sola, ed è cliccabile.
        Il titolo resta quello della Storia perché è il filo che tiene
        insieme i sei capitoli: il capitolo su Adobe è la premessa, non
        il tema. */}
    {/* LA COPERTINA DEL LIBRO (owner, 19 nov 2026): nella versione da distribuire non è
        la copertina di un incontro. Niente agenda: il volto di Giulia, il titolo, due righe
        che promettono la storia e un solo gesto, aprirla. L'indice resta nella barra. */}
    {LETTURA ? (
      <Slide id="slide-cover" bg="inverse" align="left">
        <div slot="backdrop" class="im-libro-fondo" style={`--ritratto: url('${ritratto.src}')`}></div>
        <div class="im-libro" data-reveal>
          <CoBrand variant="hero" class="im-libro-lockup edf-cobrand--on-dark" />
          <h1 class="im-libro-t">{TITOLO_INCONTRO.t.it}</h1>
          <p class="im-libro-s">{TITOLO_INCONTRO.s.it}</p>
          <p class="im-libro-l">Giulia ha 34 anni, cerca il primo mutuo e non è ancora vostra cliente. In sette momenti si vede come la banca la riconosce, le parla quando serve e la accompagna fino alla firma.</p>
          <div class="im-libro-azioni">
            <a class="im-libro-apri" href={href(base, '/' + first.slug)}>Apri la storia<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h9M8.5 4 12.5 8l-4 4" /></svg></a>
            <button type="button" class="im-libro-funz" data-funzioni-apri>Oppure partite dalla vostra funzione</button>
          </div>
          <p class="im-libro-tipo">{type.coverLine.it}</p>
          <p class="im-cop-nota">Contiamo quante volte questa pagina viene aperta, giorno per giorno; il conteggio non registra cookie, indirizzi IP o altro su chi la apre.</p>
        </div>
      </Slide>
    ) : (
    <Slide id="slide-cover" bg="inverse" align="left"
           data-made-with="Adobe Firefly" data-made-with-for="clip" data-audio="loud">
      <LoopVideo slot="backdrop" src={`${CLIP}/innesto-cover.loop.mp4`}
                 poster={`${base}media/innesto-cover.poster.jpg`}
                 scrim="im-clip-scrim" opacity={1} />

      <div class="im-cop" data-reveal>
        <div class="im-cop-sx">
          <CoBrand variant="hero" class="im-cop-lockup edf-cobrand--on-dark" data-reveal />
          {!LETTURA && <T as="p" class="im-cov-occ" it="Incontro del 19 novembre 2026" en="Meeting of 19 November 2026" data-reveal data-reveal-delay="0.06" />}
          <T as="h1" class="im-cop-t" it={TITOLO_INCONTRO.t.it} en={TITOLO_INCONTRO.t.en} data-reveal data-reveal-delay="0.1" />
          <T as="p" class="im-cop-sot" it={TITOLO_INCONTRO.s.it} en={TITOLO_INCONTRO.s.en} data-reveal data-reveal-delay="0.16" />
          <T as="p" class="im-cop-tipo" it={type.coverLine.it} en={type.coverLine.en} data-reveal data-reveal-delay="0.22" />
        </div>

        <nav class="im-cop-dx" data-reveal data-reveal-delay="0.2" aria-label="Il percorso">
          {LETTURA
            ? <T as="p" class="im-cop-occ" it="Da dove volete partire" en="Where would you like to start" />
            : <T as="p" class="im-cop-occ" it="Agenda dell’incontro" en="Meeting agenda" />}
          {/* ⚠️ L'agenda viene da `agenda.ts`, non dai capitoli: i
              capitoli sono quello che il documento contiene OGGI,
              l'agenda è quello di cui si parla in sala. Finché un pezzo
              del deck non è innestato la sua voce si legge ma non si
              clicca — un'agenda che mostra solo ciò che è pronto non è
              l'agenda dell'incontro. */}
          <ol class="im-cop-indice" data-stagger>
            {AGENDA.map((v) => (
              <li>
                {v.capitolo ? (
                  <a href={`${href(base, '/' + v.capitolo)}${v.ancora ? `#${v.ancora}` : ''}`} class="im-cop-cap">
                    <span class="im-cop-n">{v.n}</span>
                    <span class="im-cop-tit"><span data-lang-it>{v.titolo.it}</span><span data-lang-en>{v.titolo.en}</span></span>
                  </a>
                ) : (
                  <span class="im-cop-cap" data-futura>
                    <span class="im-cop-n">{v.n}</span>
                    <span class="im-cop-tit"><span data-lang-it>{v.titolo.it}</span><span data-lang-en>{v.titolo.en}</span></span>
                  </span>
                )}
              </li>
            ))}
          </ol>
        </nav>
      </div>

    </Slide>
    )}

  </DeckContainer>
  {LETTURA && <ContaAperture progetto={PROGETTO_EDIZIONE} pagina="copertina" />}
</BaseLayout>
