   LA REGIA — tre modi di eseguire la stessa decisione.
   Dal materiale di affiancamento su AI Decisioning per una grande banca
   nordamericana (Field Readiness, letto il 30 ott 2026), che li chiama
   «tre gruppi di esecuzione»: SDK al bordo, dentro il percorso, e
   chiamata dal backend del cliente.
   ⚠️ È LA SLIDE CHE PARLA AL LORO STACK REALE, e per questo il terzo
   modo non è un dettaglio tecnico: dice che l'orchestrazione può restare
   dove è oggi e cambiare solo chi decide. Senza quella frase, la
   proposta suona come «sostituite tutto».
   ⚠️ Niente nomi di quella banca in slide: il materiale è interno.
   ══════════════════════════════════════════════════════════════════════ */
const ESEC = [
  { fig: 'bordo', t: { it: 'Al bordo, in sessione', en: 'At the edge, in session' },
    chi: { it: 'SDK web e app, o Edge API', en: 'Web and app SDK, or Edge API' },
    d: { it: 'L’offerta compare sulla pagina o nella schermata mentre la persona è lì.', en: 'The offer appears on the page or screen while the person is there.' } },
  { fig: 'regia', t: { it: 'Dentro il percorso', en: 'Inside the journey' },
    chi: { it: 'Journey Optimizer', en: 'Journey Optimizer' },
    d: { it: 'Il percorso decide quando, e la decisione entra nel messaggio al momento dell’invio.', en: 'The journey decides when, and the decision enters the message at send time.' } },
  { fig: 'canali', t: { it: 'Dai vostri sistemi', en: 'From your own systems' },
    chi: { it: 'API di decisioning', en: 'AI Decisioning API' },
    d: { it: 'Il vostro backend resta il motore di campagna e chiede solo quale offerta. La postazione del contact center fa la stessa chiamata.', en: 'Your backend stays the campaign engine and only asks which offer. The contact-centre desktop makes the same call.' } },
];

/* ══════════════════════════════════════════════════════════════════════
   L'ARBITRO — come ragiona una decisione, in cinque passaggi.
   Dalla mappatura fra caso d'uso e capacità AJO per una banca (Field
   Readiness, 30 ott 2026): catalogo delle risoluzioni, regole di
   eleggibilità, vincoli, formula di ranking, esito di ripiego.
   ⚠️ IL CONFINE È CITATO, non addolcito: quel materiale dice che il
   motore «non deve essere il sistema di record per eleggibilità
   creditizia, saldi e approvazioni». In una banca è la frase che fa
   passare la slide, perché è la paura che ha chi la guarda.
   ══════════════════════════════════════════════════════════════════════ */
const DECIDE = [
  { n: '1', t: { it: 'Il catalogo', en: 'The catalogue' },
    d: { it: 'Le offerte che esistono, con le loro date e i canali su cui possono uscire.', en: 'The offers that exist, with their dates and the channels they may go out on.' } },
  { n: '2', t: { it: 'L’eleggibilità', en: 'Eligibility' },
    d: { it: 'Chi può ricevere che cosa. Sul credito la dichiara il core banking.', en: 'Who can receive what. On credit, core banking declares it.' } },
  { n: '3', t: { it: 'I vincoli', en: 'The constraints' },
    d: { it: 'Limite per offerta, consenso, capienza di un’offerta, esclusioni.', en: 'Per-offer limit, consent, an offer’s capacity, exclusions.' } },
  { n: '4', t: { it: 'La classifica', en: 'The ranking' },
    d: { it: 'Fra le ammesse, l’ordine: quanto vale per la persona e quanto per la banca.', en: 'Among those allowed, the order: what it is worth to the person and to the bank.' } },
  { n: '5', t: { it: 'Il ripiego', en: 'The fallback' },
    d: { it: 'Che cosa esce quando nessuna è ammessa, dichiarato in anticipo.', en: 'What goes out when none is allowed, declared in advance.' } },
];
---
<BaseLayout title="Approfondimenti">
  <div class="fixed top-0 left-0 right-0 z-50">
    <Navigation currentPath={currentPath} base={base} />
  </div>

  <DeckContainer nextHref={USCITA} prevHref={USCITA}>

    {/* ══ LA MAPPA: ACCANTO A CHE COSA (panel del 30 ott 2026, P0) ═══
        Nessuna slide diceva quali prodotti Adobe la banca ha già, che
        cosa è nuovo, che cosa è da capire, dove gira ciascuno e che
        cosa passa su ogni freccia: «una marketecture, non la nostra
        architettura», e quattro personas su sei ne facevano una
        condizione. È la domanda fatta il 22 ottobre. Apre gli
        approfondimenti, ed è la prima cosa che si apre al tavolo
        tecnico. Le caselle «da confermare» restano tali: l'installato
        vero si legge dal footprint prima del 5, non si indovina. */}
    <Slide id="slide-ingaggio-mappa" bg="inverse" align="left">
      <div slot="backdrop" class="im-bg-notte"></div>
      <div class="im-ado-cap im-ado-cap--largo" data-reveal>
        <T as="h2" class="im-ado-t im-ado-t--stretto" it="Che cosa avete, che cosa si aggiunge, che cosa resta vostro" en="What you have, what gets added, what stays yours" />

        <div class="im-mappa">
          {MAPPA.map((col) => (
            <section class="im-mappa-c" data-stato={col.stato}>
              <T as="p" class="im-mappa-k" it={col.t.it} en={col.t.en} />
              <ul class="im-mappa-l">
                {col.v.map((x) => (
                  <li>
                    <span class="im-mappa-n">{x.n}</span>
                    <T as="span" class="im-mappa-d" it={x.d.it} en={x.d.en} />
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </div>

        <p class="im-fonte-riga">
          <span data-lang-it>L’installato è un’ipotesi nostra: le voci «da confermare» si chiudono con il vostro footprint, prima dell’incontro. </span><span data-lang-en>The installed base is our assumption: the “to confirm” items close with your footprint, before the meeting. </span>
        </p>
      </div>
    </Slide>

    {/* ── Ingaggiare il cliente, in tre tempi ──────────────────────── */}
    <Slide id="slide-ingaggio-ciclo" bg="inverse" align="left">
      <div slot="backdrop" class="im-bg-notte"></div>
      <div class="im-ado-cap im-ado-cap--largo" data-reveal>
        <T as="h2" class="im-ado-t im-ado-t--stretto" it="Quattro componenti sullo stesso dato" en="Four components on the same data" />

        <ul class="im-ciclo">
          {CICLO.map((c) => (
            <li class="im-ciclo-i">
              <div class="im-ciclo-su">
                <span class="im-ciclo-n">{c.n}</span>
                <FiguraCap segno={c.fig} class="im-ciclo-fig" />
                <T as="span" class="im-bv-t" it={c.t.it} en={c.t.en} />
                <T as="span" class="im-bv-s" it={c.s.it} en={c.s.en} />
                <T as="span" class="im-bv-d" it={c.d.it} en={c.d.en} />
                <a class="im-apri" href={`#${c.ancora}`}><span data-lang-it>Apri il dettaglio →</span><span data-lang-en>Open the detail →</span></a>
              </div>
              <T as="p" class="im-ciclo-giu" it={c.i.it} en={c.i.en} />
            </li>
          ))}
        </ul>
        <T as="p" class="im-ciclo-base" it="Sotto tutti e quattro, Adobe Experience Platform." en="Beneath all four, Adobe Experience Platform." />
        <p class="im-fonte-riga">
          <span data-lang-it>La riga verde è quello che succederebbe nel vostro perimetro, e va confermata con voi. </span><span data-lang-en>The green line is what would happen inside your perimeter, and is to be confirmed with you. </span>
          <a href="#slide-ingaggio-casi"><span data-lang-it>Quattro casi d’uso →</span><span data-lang-en>Four use cases →</span></a>
        </p>
      </div>
    </Slide>

    <Slide id="slide-ingaggio-dato" bg="inverse" align="left">
      <div slot="backdrop" class="im-bg-notte"></div>
      <div class="im-ado-cap im-ado-cap--largo" data-reveal>
        <T as="p" class="im-ado-occ" it="Approfondimento · la misura unica" en="Deep dive · one measurement" />
        <T as="h2" class="im-ado-t im-ado-t--stretto" it="Una sola misura di app, sito, contact center e filiale" en="One measurement across app, site, contact centre and branch" />

        <div class="im-flusso">
          <ul class="im-flusso-fonti">
            {FONTI_DATO.map((f) => <li><span data-lang-it>{f.it}</span><span data-lang-en>{f.en}</span></li>)}
          </ul>
          <span class="im-flusso-fr" aria-hidden="true">→</span>
          <section class="im-flusso-aep">
            <span class="im-flusso-t">Experience Platform</span>
            <T as="span" class="im-flusso-d" it="Identità cross-canale, consenso e schema dati comune. Il grafo si aggiorna man mano che i dati arrivano." en="Cross-channel identity, consent and a common data schema. The graph updates as data arrives." />
          </section>
          <span class="im-flusso-fr" aria-hidden="true">→</span>
          <section class="im-flusso-cja">
            <span class="im-flusso-t">Customer Journey Analytics</span>
            <T as="span" class="im-flusso-d" it="Percorsi, funnel, coorti e attribuzione su dati a livello di evento." en="Journeys, funnels, cohorts and attribution on event-level data." />
          </section>
        </div>

        {/* Quattro DOMANDE, non tre reparti: una per area operativa, con
            chi la fa e che cosa la rende rispondibile. Vedi il commento
            su `DOMANDE_CJA` per il perché del cambio. */}
        <ul class="im-dom">
          {DOMANDE_CJA.map((d) => (
            <li class="im-dom-i">
              <T as="span" class="im-dom-chi" it={d.chi.it} en={d.chi.en} />
              <T as="span" class="im-dom-q" it={d.q.it} en={d.q.en} />
              <T as="span" class="im-dom-d" it={d.d.it} en={d.d.en} />
            </li>
          ))}
        </ul>

        <p class="im-fonte-riga">
          <span data-lang-it>Tre cose si concordano prima: quali identificativi compongono il grafo, la tassonomia degli eventi (anche in filiale), i KPI con i gruppi di controllo dal giorno uno. L’attribuzione sostituisce la congettura sull’ultimo clic con modelli regolati o algoritmici. Il limite si dichiara, perché non misura quello che succede fuori dai canali osservati e la finestra di osservazione è una scelta. Modelli: </span>
          <span data-lang-en>Three things get agreed first: which identifiers build the graph, the event taxonomy (in the branch too), KPIs with control groups from day one. Attribution replaces last-click guesswork with rule-based or algorithmic models. The limit is stated, because it does not measure what happens outside the observed channels and the lookback window is a choice. Models: </span>
          <a href="https://experienceleague.adobe.com/en/docs/analytics-platform/using/cja-workspace/attribution/models" target="_blank" rel="noopener">Customer Journey Analytics · attribution</a>
          <a class="im-torna" href={TORNA}><span data-lang-it>← Torna ai quattro componenti</span><span data-lang-en>← Back to the four components</span></a>
        </p>
      </div>
    </Slide>

    {/* ── Il profilo · Real-Time CDP ───────────────────────────────── */}
    <Slide id="slide-ingaggio-profilo" bg="inverse" align="left">
      <div slot="backdrop" class="im-bg-notte"></div>
      <div class="im-ado-cap im-ado-cap--largo" data-reveal>
        <T as="p" class="im-ado-occ" it="Approfondimento · il profilo" en="Deep dive · the profile" />
        <T as="h2" class="im-ado-t im-ado-t--stretto" it="Il profilo collega cookie, telefono e codice cliente alla stessa persona" en="The profile links cookie, phone number and customer number to one person" />
        <T as="p" class="im-ado-l" it="Giulia è un cookie sul sito, un numero di telefono al contact center e un codice cliente dopo la firma. Il profilo li collega." en="Giulia is a cookie on the site, a phone number at the call centre and a customer number after signature. The profile links them." />

        <div class="im-bv im-cat">
          {PROFILO.map((c, i) => (
            <>
              <section class="im-bv-i">
                <FiguraCap segno={c.fig} />
                <T as="span" class="im-bv-t" it={c.t.it} en={c.t.en} />
                <T as="span" class="im-bv-d" it={c.d.it} en={c.d.en} />
              </section>
              {i < PROFILO.length - 1 && <span class="im-bv-op im-cat-op" aria-hidden="true">→</span>}
            </>
          ))}
        </div>

        {/* La scelta di disegno. Due strade, entrambe legittime: è la
            domanda che il loro IT fa per primo, e arrivarci prima di
            loro vale più che rispondere dopo. */}
        <div class="im-scelta">
          <T as="p" class="im-scelta-k" it="Una scelta di disegno, da fare insieme" en="One design choice, to make together" />
          <div class="im-scelta-g">
            {SCELTA_PROFILO.map((o) => (
              <section class="im-scelta-i">
                <T as="span" class="im-scelta-t" it={o.t.it} en={o.t.en} />
                <T as="span" class="im-scelta-d" it={o.d.it} en={o.d.en} />
                <T as="span" class="im-scelta-q" it={o.q.it} en={o.q.en} />
              </section>
            ))}
          </div>
        </div>

        <p class="im-fonte-riga">
          <span data-lang-it>La seconda strada è </span><span data-lang-en>The second route is </span>
          <a href="https://experienceleague.adobe.com/en/docs/federated-audience-composition/using/overview" target="_blank" rel="noopener">Federated Audience Composition</a><span
            data-lang-it>: un modulo di Real-Time CDP e Journey Optimizer, con i suoi prerequisiti di pacchetto e un elenco di data warehouse supportati da verificare col vostro. Compone audience senza copiare il dato, e quelle audience si aggiornano a ogni esecuzione pianificata, non alla qualificazione a evento. Per il caso del mutuo serve la prima strada (riconoscimento in sessione, decisione a evento); la seconda vale per le audience sui dati regolamentati dei clienti. Verificato sulla documentazione pubblica, 30 ott 2026.</span>
          <span data-lang-en>: a module of Real-Time CDP and Journey Optimizer, with its own package prerequisites and a list of supported data warehouses to check against yours. It composes audiences without copying the data, and those audiences refresh at each scheduled run, not on event qualification. For the mortgage case the first route is needed (in-session recognition, event-driven decision); the second holds for audiences on customers’ regulated data. Verified on the public documentation, 30 Oct 2026.</span>
          <a class="im-torna" href={TORNA}><span data-lang-it>← Torna ai quattro componenti</span><span data-lang-en>← Back to the four components</span></a>
        </p>
      </div>
    </Slide>

    {/* ── La regia · Journey Optimizer ─────────────────────────────── */}
    <Slide id="slide-ingaggio-regia" bg="inverse" align="left">
      <div slot="backdrop" class="im-bg-notte"></div>
      <div class="im-ado-cap im-ado-cap--largo" data-reveal>
        <T as="p" class="im-ado-occ" it="Approfondimento · la regia" en="Deep dive · orchestration" />
        <T as="h2" class="im-ado-t im-ado-t--stretto" it="Tre modi di eseguire la stessa decisione" en="Three ways to execute the same decision" />
        <T as="p" class="im-ado-l" it="La decisione si configura una volta. Dove viene eseguita è una scelta, e le tre strade convivono." en="The decision is configured once. Where it runs is a choice, and the three routes coexist." />

        <div class="im-esec">
          {ESEC.map((e) => (
            <section class="im-esec-i">
              <FiguraCap segno={e.fig} class="im-esec-fig" />
              <T as="span" class="im-bv-t" it={e.t.it} en={e.t.en} />
              <T as="span" class="im-esec-chi" it={e.chi.it} en={e.chi.en} />
              <T as="span" class="im-bv-d" it={e.d.it} en={e.d.en} />
            </section>
          ))}
        </div>

        <div class="im-csc-conf im-csc-conf--eng">
          <T as="span" class="im-csc-conf-t" it="Il terzo modo è la risposta a «e quello che abbiamo già?»" en="The third route answers “what about what we already have?”" />
          <T as="span" class="im-csc-conf-d" it="L’orchestrazione può restare dove è oggi: cambia solo chi decide quale offerta esce. La regola è una; il contatore si comporta diversamente al bordo (per identità, in tempo reale) e nel percorso (per profilo, con qualche minuto)." en="The orchestration can stay where it is today: only who decides which offer goes out changes. The rule is one; the counter behaves differently at the edge (per identity, in real time) and in the journey (per profile, with a few minutes’ lag)." />
        </div>

        <p class="im-fonte-riga">
          <span data-lang-it>I tre modi di esecuzione e il comportamento dei contatori, dalla documentazione pubblica (30 ott 2026): </span><span data-lang-en>The three execution routes and the counters’ behaviour, from the public documentation (30 Oct 2026): </span>
          <a href="https://experienceleague.adobe.com/en/docs/journey-optimizer/using/decisioning/offer-decisioning/api-reference/offer-delivery-api/start-offer-delivery-apis" target="_blank" rel="noopener">AI Decisioning · delivery APIs</a><span> · </span>
          <a href="https://experienceleague.adobe.com/en/docs/journey-optimizer/using/conflict-prioritization/capping-rules/rule-sets" target="_blank" rel="noopener">rule sets</a>
          <a class="im-torna" href={TORNA}><span data-lang-it>← Torna ai quattro componenti</span><span data-lang-en>← Back to the four components</span></a>
        </p>
      </div>
    </Slide>

    {/* ── L'arbitro · AI Decisioning ───────────────────────────────── */}
    <Slide id="slide-ingaggio-arbitro" bg="inverse" align="left">
      <div slot="backdrop" class="im-bg-notte"></div>
      <div class="im-ado-cap im-ado-cap--largo" data-reveal>
        <T as="p" class="im-ado-occ" it="Approfondimento · l’arbitro" en="Deep dive · the arbiter" />
        <T as="h2" class="im-ado-t im-ado-t--stretto" it="Come ragiona una decisione, in cinque passaggi" en="How a decision reasons, in five steps" />
        <T as="p" class="im-ado-l" it="Delle quattro proposte del momento 04 ne esce una sola, scelta in cinque passaggi." en="Of the four proposals in moment 04 only one goes out, picked in five steps." />

        <ol class="im-dec">
          {DECIDE.map((d) => (
            <li class="im-dec-i">
              <span class="im-dec-n">{d.n}</span>
              <T as="span" class="im-bv-t" it={d.t.it} en={d.t.en} />
              <T as="span" class="im-bv-d" it={d.d.it} en={d.d.en} />
            </li>
          ))}
        </ol>

        {/* Il confine. Si dice prima, perché è la paura di chi guarda. */}
        <div class="im-confine">
          <T as="span" class="im-confine-t" it="Dove si fermano le nostre regole" en="Where our rules stop" />
          <T as="span" class="im-confine-d" it="Il motore non è il sistema di record dell’eleggibilità creditizia, dei saldi e delle approvazioni: quelli restano nel core banking. Qui si scelgono offerta, canale e momento fra ciò che il core ha già dichiarato ammissibile." en="The engine is not the system of record for credit eligibility, balances or approvals: those stay in core banking. Here offer, channel and timing are chosen among what the core has already declared eligible." />
        </div>

        <p class="im-fonte-riga">
          <span data-lang-it>I cinque passaggi, dalla documentazione pubblica (30 ott 2026): </span><span data-lang-en>The five steps, from the public documentation (30 Oct 2026): </span>
          <a href="https://experienceleague.adobe.com/en/docs/journey-optimizer/using/decisioning/offer-decisioning/get-started-decision/starting-offer-decisioning" target="_blank" rel="noopener">Journey Optimizer · AI Decisioning</a><span data-lang-it>. Il confine con il core banking è una scelta di disegno nostra, da confermare con voi.</span><span data-lang-en>. The boundary with core banking is a design choice of ours, to confirm with you.</span>
          <a class="im-torna" href={TORNA}><span data-lang-it>← Torna ai quattro componenti</span><span data-lang-en>← Back to the four components</span></a>
        </p>
      </div>
    </Slide>

    <Slide id="slide-ingaggio-casi" bg="inverse" align="left">
      <div slot="backdrop" class="im-bg-notte"></div>
      <div class="im-ado-cap im-ado-cap--largo" data-reveal>
        <T as="p" class="im-ado-occ" it="Approfondimento · casi d’uso" en="Deep dive · use cases" />
        <T as="h2" class="im-ado-t im-ado-t--stretto" it="Quattro casi d’uso che richiedono profilo, decisione e misura nello stesso sistema" en="Four use cases that need profile, decision and measurement in one system" />
        <T as="p" class="im-ado-l" it="In tutti e quattro la persona non deve ripetere quello che ha già detto a un altro canale." en="In all four, the person does not have to repeat what they already told another channel." />

        <ul class="im-casi">
          {CASI.map((c) => (
            <li class="im-casi-i">
              <p class="im-casi-rotta">
                <T as="span" class="im-casi-da" it={c.da.it} en={c.da.en} />
                <span class="im-casi-fr" aria-hidden="true">→</span>
                <T as="span" class="im-casi-a" it={c.a.it} en={c.a.en} />
              </p>
              <T as="span" class="im-bv-t" it={c.t.it} en={c.t.en} />
              <T as="span" class="im-bv-d" it={c.serve.it} en={c.serve.en} />
              <T as="span" class="im-casi-pezzi" it={c.pezzi.it} en={c.pezzi.en} />
            </li>
          ))}
        </ul>
        <T as="p" class="im-fonte-riga" it="Casi d’uso proposti sul vostro perimetro, da prioritizzare insieme: la fattibilità di ciascuno dipende da quali dati sono già in piattaforma. La riga in basso di ogni caso dice che cosa resta fuori portata con profilo, decisione e misura in tre sistemi diversi." en="Use cases proposed for your perimeter, to be prioritised together: the feasibility of each depends on which data is already on the platform. The bottom line of each case says what stays out of reach when profile, decision and measurement live in different systems." />
        <p class="im-fonte-riga"><a class="im-torna" href={TORNA}><span data-lang-it>← Torna ai quattro componenti</span><span data-lang-en>← Back to the four components</span></a></p>
      </div>
    </Slide>

    {/* ⚠️ LE FRECCE STAVANO SULLA MAPPA, sotto tre colonne, ed è la slide che
        il team ha chiamato «troppo densa» (Teams, 30 ott 2026). Qui stanno
        da sole, e accanto hanno la domanda che in una banca viene subito
        dopo: dove gira e sotto quale contratto. */}
    <Slide id="slide-integrazioni" bg="inverse" align="left">
      <div slot="backdrop" class="im-bg-notte"></div>
      <div class="im-ado-cap im-ado-cap--largo" data-reveal>
        <T as="h2" class="im-ado-t im-ado-t--stretto" it="Servono sei collegamenti e due si disegnano con voi" en="Six connections are needed and two get designed with you" />
        <T as="p" class="im-ado-l" it="Ogni freccia porta un contenuto, un verso e una modalità." en="Each arrow says what passes, in which direction and how." />

        <ul class="im-frecce">
          {FRECCE.map((f) => (
            <li class="im-frecce-i" data-aperta={f.aperta ? '' : null}>
              <span class="im-frecce-da">{f.da}</span><span class="im-frecce-fr" aria-hidden="true">→</span><span class="im-frecce-a">{f.a}</span>
              <T as="span" class="im-frecce-d" it={f.d.it} en={f.d.en} />
            </li>
