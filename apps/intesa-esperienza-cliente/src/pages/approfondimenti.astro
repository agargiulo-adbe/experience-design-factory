<style is:global>
  #slide-serve .im-serve-q { font-weight: 700; color: #ffc46b; white-space: nowrap; }
  #slide-serve .im-serve-nota { grid-column: 1 / -1; display: flex; flex-wrap: wrap; gap: 0.2rem 0.8rem; align-items: baseline; padding: 0.3rem 0.2rem 0; }
  @media (max-width: 1400px) { #slide-serve .im-serve-nota { grid-column: auto; display: grid; align-content: start; padding: 0.8rem 0.85rem; border: 1px dashed rgba(255, 255, 255, 0.35); border-radius: 6px; } }
  /* Panel dell'11 nov 2026. Stili SOLO di questa pagina, inchiostri pieni su
     fondo scuro (audit:ink), corpo ≥ 0,95rem: quando la copia cresce si
     ricompone, non si rimpicciolisce. */

  /* La mappa: «Avete» porta nove sistemi e si stende su due colonne, in
     colonna (cinque e quattro) così i sistemi restano raggruppati. */
  .im-mappa--avete { grid-template-columns: minmax(0, 2fr) minmax(0, 1fr) minmax(0, 1fr); }
  .im-mappa-l--due { grid-template-rows: repeat(5, auto); grid-auto-flow: column; column-gap: 1.4rem; }
  .im-mappa-l--due li:nth-child(5) { border-bottom: 0; padding-bottom: 0; }
  @media (max-width: 900px) {
    .im-mappa--avete { grid-template-columns: minmax(0, 1fr); }
    .im-mappa-l--due { grid-template-rows: none; grid-auto-flow: row; }
    .im-mappa-l--due li:nth-child(5) { border-bottom: 1px solid rgba(255, 255, 255, 0.14); padding-bottom: 0.42rem; }
  }

  /* Una riga fatta solo di rimandi parte dal bordo, come i blocchi sopra. */
  #slide-integrazioni .im-fonte-riga :is(.im-torna:first-child, .im-frecce-legenda + .im-torna) { margin-left: 0; }

  /* I collegamenti: le due frecce del cross-sell sotto un'etichetta sola. */
  .im-frecce-dopo {
    grid-column: 1 / -1; margin: 0.35rem 0 0; max-width: none; list-style: none;
    font-family: var(--font-display); font-weight: 700;
    font-size: clamp(0.82rem, calc(0.7 * var(--vu)), 1.5rem); letter-spacing: 0.08em; text-transform: uppercase; color: #9fd68a;
  }
  /* Sotto i 1500px i nomi lunghi («Postazione Filiale Digitale») schiacciano
     la descrizione in una colonna di tre parole: la descrizione va a capo
     sotto i nomi, a tutta larghezza della scheda. */
  @media (max-width: 1500px) {
    #slide-integrazioni .im-frecce-i { grid-template-columns: auto auto auto minmax(0, 1fr); }
    #slide-integrazioni .im-frecce-d { grid-column: 1 / -1; }
    #slide-integrazioni .im-frecce-da, #slide-integrazioni .im-frecce-a { white-space: normal; }
  }
  /* A 1280×800 scende la densità, mai il tipo: figure più basse e righe
     più strette su profilo e collegamenti. */
  @media (max-height: 880px) {
    #slide-ingaggio-profilo .im-fig { height: clamp(2rem, calc(2.6 * var(--vu)), 4rem); margin-bottom: 0.25rem; }
    #slide-ingaggio-profilo .im-scelta { margin-top: 0.4rem; }
    #slide-integrazioni .im-frecce { gap: 0.3rem 0.6rem; }
    #slide-integrazioni .im-frecce-i { padding-block: 0.3rem; row-gap: 0.15rem; }
    .im-frecce-dopo { margin-top: 0.15rem; }
    #slide-integrazioni-dati .im-csc-conf { margin-top: 0.45rem; padding: 0.6rem 0.9rem 0.7rem; }
  }

  /* Dove sta ogni dato: tre colonne, una riga per tipo di dato. */
  .im-dati { margin-top: 0.9rem; display: grid; gap: 0.45rem; width: 100%; }
  .im-dati-i {
    display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.7fr) minmax(0, 1.1fr);
    gap: 0.3rem 1.3rem; align-items: baseline;
    padding: 0.55rem 0.95rem; border-radius: 10px;
    background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.14);
    font-size: clamp(0.95rem, calc(0.8 * var(--vu)), 1.8rem); line-height: 1.45; color: #dfeadb;
  }
  .im-dati-i > span { max-width: none; min-width: 0; }
  .im-dati-n { font-weight: 700; color: #ffffff; }
  .im-dati-h {
    background: transparent; border-color: transparent; padding-block: 0 0.1rem;
    font-family: var(--font-display); font-weight: 700;
    font-size: clamp(0.82rem, calc(0.7 * var(--vu)), 1.5rem); letter-spacing: 0.08em; text-transform: uppercase; color: #9fd68a;
  }
  /* La riga del CRM: quattro schede sulla griglia `.im-esec`. */
  .im-esec--quattro { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  @media (max-width: 1100px) { .im-esec--quattro { grid-template-columns: repeat(2, minmax(0, 1fr)); grid-template-rows: none; } .im-esec--quattro .im-esec-i { grid-row: auto; grid-template-rows: auto auto auto 1fr; } }
  @media (max-height: 880px) {
