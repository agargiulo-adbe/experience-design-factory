  <script>
    /* «Chi è il riferimento» (slide-domanda-consenso, passo 4): il pulsante
       sceglie l'architettura, i nastri si ridisegnano e cambia la didascalia.
       Delegato su document: regge la navigazione SPA senza ricollegarsi. */
    document.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-dq-arch]');
      if (!b) return;
      const cap = b.closest<HTMLElement>('[data-arch]');
      const fig = cap?.querySelector<HTMLElement>('[data-dq-cons]');
      if (!cap || !fig || cap.dataset.arch === b.dataset.dqArch) return;
      cap.dataset.arch = b.dataset.dqArch!;
      cap.querySelectorAll<HTMLButtonElement>('[data-dq-arch]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      fig.removeAttribute('data-ridisegna'); void fig.offsetWidth; fig.setAttribute('data-ridisegna', '');
    });
  </script>
