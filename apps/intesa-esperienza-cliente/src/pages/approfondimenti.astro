const CSC = [
  { fig: 'flusso', t: { it: 'Pianificare', en: 'Plan' },
    d: { it: 'Un’iniziativa nasce con dentro le sue approvazioni.', en: 'A campaign is born with its approvals inside it.' } },
  { fig: 'varianti', t: { it: 'Produrre', en: 'Produce' },
