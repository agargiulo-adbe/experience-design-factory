/* ⚠️ QUI C'ERANO TRE BLOCCHI, E DICEVANO LA COSA SBAGLIATA.
   Erano «Controllo di Gestione», «Advanced Analytics» e «Da definire
   insieme»: i primi due sono reparti, non domande, e il terzo non è un
   uso del dato — è una lista di cose da concordare, messa alla pari
   degli altri due come se CJA servisse a produrre questioni aperte.
   Il modo in cui Adobe presenta CJA a una banca retail è un altro, e si
   legge nel materiale di Field Readiness (business case CJA per banche
   retail nordamericane, letti il 30 ott 2026): **una domanda per area
   operativa**, con chi la fa e che cosa la rende rispondibile. Le aree
   che tornano sono acquisizione, legame fra digitale e filiale, share of
   wallet e abbandono — e sono esattamente le quattro di una banca
   italiana che vende mutui.
   ⚠️ Niente nomi di quelle banche in slide: quel materiale è interno. Lo
   schema si riusa, i clienti citati no.
   Le cose da concordare restano, ma dove vanno: nella riga di chiusura,
   non in un blocco che finge di essere un beneficio. */
const DOMANDE_CJA = [
  { q: { it: 'Quale canale porta davvero clienti nuovi?', en: 'Which channel actually brings new customers?' },
    chi: { it: 'Marketing e Controllo di Gestione', en: 'Marketing and management control' },
    d: { it: 'Attribuzione su dati a livello di evento, filiale compresa, con la finestra di osservazione dichiarata.', en: 'Attribution on event-level data, branch included, with the lookback window stated.' } },
  { q: { it: 'Quanto il digitale porta in filiale?', en: 'How much does digital bring into the branch?' },
    chi: { it: 'Direzione commerciale e rete', en: 'Commercial division and the network' },
    d: { it: 'Il percorso online e l’esito allo sportello nello stesso dato: prodotti per cliente, tempo per acquisire.', en: 'The online path and the counter outcome in one dataset: products per customer, time to acquire.' } },
  { q: { it: 'Dove si perde il cross-sell?', en: 'Where is cross-sell lost?' },
    chi: { it: 'Prodotto', en: 'Product' },
    d: { it: 'Coorti e punti di abbandono per segmento, dentro Analysis Workspace, senza un’estrazione dedicata.', en: 'Cohorts and drop-off points per segment, inside Analysis Workspace, without a dedicated extraction.' } },
  { q: { it: 'Chi sta per andarsene, e da dove si vede?', en: 'Who is about to leave, and where does it show?' },
    chi: { it: 'CRM e retention', en: 'CRM and retention' },
    d: { it: 'I punti in cui il percorso si rompe, e i segmenti a rischio che ne derivano, su eventi di tutti i canali.', en: 'The points where the journey breaks, and the at-risk segments that result, on events from every channel.' } },
];

/* ══════════════════════════════════════════════════════════════════════
   IL PROFILO — Real-Time CDP. Quattro passaggi e UNA scelta di disegno.
   La scelta è la slide 56 del deck del 5 novembre («duplicare o federare
   il profilo»), e la verifica sta su due fonti: la guida GTM di
   Real-Time CDP su Field Readiness (30 ott 2026) e la documentazione
   pubblica di Federated Audience Composition.
   ⚠️ IL LIMITE SI DICHIARA COL PREGIO, e qui è preciso: un'audience
   federata è una composizione STATICA, aggiornata a ogni esecuzione
   pianificata, e non si usa nella qualificazione a evento. Venderla come
   «tempo reale» è il modo più rapido di perdere credibilità col loro IT
   al secondo incontro. Richiede inoltre i pacchetti Prime o Ultimate e
   l'acquisto del modulo: sta nella riga di fonte, non in slide.
   ══════════════════════════════════════════════════════════════════════ */
const PROFILO = [
  { fig: 'archivio', t: { it: 'Uno schema dati comune', en: 'One common data schema' },
    d: { it: 'Eventi e attributi scritti nello stesso modo, da qualunque canale arrivino.', en: 'Events and attributes written the same way, whichever channel they come from.' } },
  { fig: 'grafo', t: { it: 'Gli identificativi si cuciono', en: 'Identifiers get stitched' },
    d: { it: 'Pseudonimo del browser, ID dell’app, email, codice cliente: lo stitching li riporta alla stessa persona.', en: 'Browser pseudonym, app ID, email, customer number: stitching ties them back to one person.' } },
  { fig: 'serie', t: { it: 'Il grafo si aggiorna da sé', en: 'The graph updates itself' },
    d: { it: 'Si aggiorna man mano che i dati arrivano.', en: 'It updates as data arrives.' } },
  { fig: 'bordo', t: { it: 'Il consenso viene dal vostro registro', en: 'Consent comes from your register' },
    d: { it: 'Il consenso resta nel vostro registro; la piattaforma lo riceve e lo applica. Una revoca in filiale arriva al profilo dal registro.', en: 'Consent stays in your register; the platform receives and applies it. A revocation in the branch reaches the profile from the register.' } },
];
const SCELTA_PROFILO = [
  { t: { it: 'Portare il dato in piattaforma', en: 'Bring the data into the platform' },
    d: { it: 'Il profilo si costruisce qui: segmentazione libera e qualificazione nel momento in cui l’evento arriva.', en: 'The profile is built here: free segmentation and qualification the moment the event lands.' },
    q: { it: 'Serve una copia del dato', en: 'A copy of the data is needed' } },
  { t: { it: 'Lasciarlo dov’è, e interrogarlo', en: 'Leave it where it is, and query it' },
    d: { it: 'Le audience si compongono sul vostro data lake senza copiare il dato. Si ricompongono a ogni esecuzione pianificata, non a evento.', en: 'Audiences are composed on your data warehouse without copying the data. They recompose at each scheduled run, not on an event.' },
    q: { it: 'Il dato regolamentato non si muove', en: 'Regulated data does not move' } },
];

/* ══════════════════════════════════════════════════════════════════════
   LA REGIA — tre modi di eseguire la stessa decisione.
   Dal materiale di affiancamento su AI Decisioning per una grande banca
   nordamericana (Field Readiness, letto il 30 ott 2026), che li chiama
   «tre gruppi di esecuzione»: SDK al bordo, dentro il percorso, e
   chiamata dal backend del cliente.
   ⚠️ È LA SLIDE CHE PARLA AL LORO STACK REALE, e per questo il terzo
   modo non è un dettaglio tecnico: dice che l'orchestrazione può restare
   dove è oggi e cambiare solo chi decide. Senza quella frase, la
   proposta suona come «sostituite tutto».
   ⚠️ Niente nomi di quella banca in slide: il materiale è interno.
   ══════════════════════════════════════════════════════════════════════ */
const ESEC = [
  { fig: 'bordo', t: { it: 'Al bordo, in sessione', en: 'At the edge, in session' },
    chi: { it: 'SDK web e app, o Edge API', en: 'Web and app SDK, or Edge API' },
    d: { it: 'L’offerta compare sulla pagina o nella schermata mentre la persona è lì.', en: 'The offer appears on the page or screen while the person is there.' } },
  { fig: 'regia', t: { it: 'Dentro il percorso', en: 'Inside the journey' },
    chi: { it: 'Journey Optimizer', en: 'Journey Optimizer' },
    d: { it: 'Il percorso decide quando, e la decisione entra nel messaggio al momento dell’invio.', en: 'The journey decides when, and the decision enters the message at send time.' } },
  { fig: 'canali', t: { it: 'Dai vostri sistemi', en: 'From your own systems' },
    chi: { it: 'API di decisioning', en: 'Decisioning API' },
    d: { it: 'Il vostro backend resta il motore delle iniziative e chiede solo quale offerta. La postazione della Filiale Digitale fa la stessa chiamata.', en: 'Your backend stays the campaign engine and only asks which offer. The Filiale Digitale desktop makes the same call.' } },
];

/* ══════════════════════════════════════════════════════════════════════
   L'ARBITRO — come ragiona una decisione, in cinque passaggi.
   Dalla mappatura fra caso d'uso e capacità AJO per una banca (Field
   Readiness, 30 ott 2026): catalogo delle risoluzioni, regole di
   eleggibilità, vincoli, formula di ranking, esito di ripiego.
   ⚠️ IL CONFINE È CITATO, non addolcito: quel materiale dice che il
   motore «non deve essere il sistema di record per eleggibilità
   creditizia, saldi e approvazioni». In una banca è la frase che fa
   passare la slide, perché è la paura che ha chi la guarda.
   ══════════════════════════════════════════════════════════════════════ */
const DECIDE = [
  { n: '1', t: { it: 'Il catalogo', en: 'The catalogue' },
    d: { it: 'Le offerte che esistono, con le loro date e i canali su cui possono uscire.', en: 'The offers that exist, with their dates and the channels they may go out on.' } },
  { n: '2', t: { it: 'L’eleggibilità', en: 'Eligibility' },
    d: { it: 'Eleggibilità creditizia: core banking; target e propensione: motore di targeting.', en: 'Credit eligibility: core banking; targets and propensity: targeting engine.' } },
  { n: '3', t: { it: 'I vincoli', en: 'The constraints' },
    d: { it: 'Limite per offerta, consenso, capienza di un’offerta, esclusioni.', en: 'Per-offer limit, consent, an offer’s capacity, exclusions.' } },
  { n: '4', t: { it: 'La classifica', en: 'The ranking' },
    d: { it: 'Fra le ammesse, l’ordine. Sui non clienti oggi avete un punteggio o una regola? Se c’è, entra come attributo; se no, valgono la priorità dell’offerta e le regole scritte insieme.', en: 'Among those allowed, the order. Do you have a score or a rule on non-customers today? If so, it comes in as an attribute; if not, the offer’s priority and the rules written together apply.' } },
  { n: '5', t: { it: 'Il ripiego', en: 'The fallback' },
    d: { it: 'Che cosa esce quando nessuna è ammessa, dichiarato in anticipo.', en: 'What goes out when none is allowed, declared in advance.' } },
];
---
<BaseLayout title="Approfondimenti">
  <div class="fixed top-0 left-0 right-0 z-50">
    <Navigation currentPath={currentPath} base={base} />
  </div>

  <DeckContainer nextHref={USCITA} prevHref={USCITA}>

    {/* ══ LA MAPPA: ACCANTO A CHE COSA (panel del 30 ott 2026, P0) ═══
        Nessuna slide diceva quali prodotti Adobe la banca ha già, che
        cosa è nuovo, che cosa è da capire, dove gira ciascuno e che
        cosa passa su ogni freccia: «una marketecture, non la nostra
        architettura», e quattro personas su sei ne facevano una
        condizione. È la domanda fatta il 22 ottobre. Apre gli
        approfondimenti, ed è la prima cosa che si apre al tavolo
        tecnico. Le caselle «da confermare» restano tali: l'installato
        vero si legge dal footprint prima del 5, non si indovina. */}
    <Slide id="slide-ingaggio-mappa" bg="inverse" align="left">
      <div slot="backdrop" class="im-bg-notte"></div>
      <div class="im-ado-cap im-ado-cap--largo" data-reveal>
        <T as="h2" class="im-ado-t im-ado-t--stretto" it="Che cosa avete, che cosa si aggiunge, che cosa resta vostro" en="What you have, what gets added, what stays yours" />

        <div class="im-mappa im-mappa--avete">
          {MAPPA.map((col) => (
            <section class="im-mappa-c" data-stato={col.stato}>
              <T as="p" class="im-mappa-k" it={col.t.it} en={col.t.en} />
              <ul class:list={['im-mappa-l', col.stato === 'avete' && 'im-mappa-l--due']}>
                {col.v.map((x) => (
                  <li>
                    <span class="im-mappa-n">{x.n}</span>
                    <T as="span" class="im-mappa-d" it={x.d.it} en={x.d.en} />
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </div>

        <p class="im-fonte-riga">
          <span data-lang-it>L’installato è un’ipotesi nostra: le voci «da confermare» si chiudono con voi al primo tavolo. </span><span data-lang-en>The installed base is our assumption: the “to confirm” items close with you at the first working session. </span>
        </p>
      </div>
    </Slide>

    {/* ── Ingaggiare il cliente, in tre tempi ──────────────────────── */}
    <Slide id="slide-ingaggio-ciclo" bg="inverse" align="left">
      <div slot="backdrop" class="im-bg-notte"></div>
      <div class="im-ado-cap im-ado-cap--largo" data-reveal>
        <T as="h2" class="im-ado-t im-ado-t--stretto" it="Quattro componenti sullo stesso dato" en="Four components on the same data" />

        <ul class="im-ciclo">
          {CICLO.map((c) => (
            <li class="im-ciclo-i">
              <div class="im-ciclo-su">
                <span class="im-ciclo-n">{c.n}</span>
                <FiguraCap segno={c.fig} class="im-ciclo-fig" />
                <T as="span" class="im-bv-t" it={c.t.it} en={c.t.en} />
                <T as="span" class="im-bv-s" it={c.s.it} en={c.s.en} />
                <T as="span" class="im-bv-d" it={c.d.it} en={c.d.en} />
                <a class="im-apri" href={`#${c.ancora}`}><span data-lang-it>Apri il dettaglio →</span><span data-lang-en>Open the detail →</span></a>
              </div>
              <T as="p" class="im-ciclo-giu" it={c.i.it} en={c.i.en} />
            </li>
          ))}
        </ul>
        <T as="p" class="im-ciclo-base" it="Sotto tutti e quattro, Adobe Experience Platform." en="Beneath all four, Adobe Experience Platform." />
        <p class="im-fonte-riga">
          <span data-lang-it>La riga verde è quello che succederebbe nel vostro perimetro, e va confermata con voi. </span><span data-lang-en>The green line is what would happen inside your perimeter, and is to be confirmed with you. </span>
          <a href="#slide-ingaggio-casi"><span data-lang-it>Quattro casi d’uso →</span><span data-lang-en>Four use cases →</span></a>
        </p>
      </div>
    </Slide>

    <Slide id="slide-ingaggio-dato" bg="inverse" align="left">
      <div slot="backdrop" class="im-bg-notte"></div>
      <div class="im-ado-cap im-ado-cap--largo" data-reveal>
        <T as="p" class="im-ado-occ" it="Approfondimento · la misura unica" en="Deep dive · one measurement" />
        <T as="h2" class="im-ado-t im-ado-t--stretto" it="Una sola misura di app, sito, Filiale Digitale e filiale" en="One measurement across app, site, Filiale Digitale and branch" />

        <div class="im-flusso">
          <ul class="im-flusso-fonti">
            {FONTI_DATO.map((f) => <li><span data-lang-it>{f.it}</span><span data-lang-en>{f.en}</span></li>)}
          </ul>
          <span class="im-flusso-fr" aria-hidden="true">→</span>
          <section class="im-flusso-aep">
            <span class="im-flusso-t">Experience Platform</span>
            <T as="span" class="im-flusso-d" it="Identità cross-canale, consenso e schema dati comune. Il grafo si aggiorna man mano che i dati arrivano." en="Cross-channel identity, consent and a common data schema. The graph updates as data arrives." />
          </section>
          <span class="im-flusso-fr" aria-hidden="true">→</span>
          <section class="im-flusso-cja">
            <span class="im-flusso-t">Customer Journey Analytics</span>
            <T as="span" class="im-flusso-d" it="Percorsi, funnel, coorti e attribuzione su dati a livello di evento." en="Journeys, funnels, cohorts and attribution on event-level data." />
          </section>
        </div>

        {/* Quattro DOMANDE, non tre reparti: una per area operativa, con
            chi la fa e che cosa la rende rispondibile. Vedi il commento
            su `DOMANDE_CJA` per il perché del cambio. */}
        <ul class="im-dom">
          {DOMANDE_CJA.map((d) => (
            <li class="im-dom-i">
              <T as="span" class="im-dom-chi" it={d.chi.it} en={d.chi.en} />
              <T as="span" class="im-dom-q" it={d.q.it} en={d.q.en} />
              <T as="span" class="im-dom-d" it={d.d.it} en={d.d.en} />
            </li>
          ))}
        </ul>

        <p class="im-fonte-riga">
          <span data-lang-it>Tre cose si concordano prima: quali identificativi compongono il grafo, la tassonomia degli eventi (anche in filiale), i KPI con i gruppi di controllo dal giorno uno. Il modello conta meno del dato: oggi la filiale non entra nell’attribuzione. Sul media servono test di incrementalità (pubblico o area geografica di controllo), dal cross-sell sui clienti (fase 2 del piano). Il limite si dichiara, perché non misura quello che succede fuori dai canali osservati e la finestra di osservazione è una scelta. Modelli: </span>
          <span data-lang-en>Three things get agreed first: which identifiers build the graph, the event taxonomy (in the branch too), KPIs with control groups from day one. The model matters less than the data: today the branch is not part of attribution. On media, incrementality tests (holdout audience or geography) are needed, from cross-sell to customers (phase 2 of the plan). The limit is stated, because it does not measure what happens outside the observed channels and the lookback window is a choice. Models: </span>
          <a href="https://experienceleague.adobe.com/en/docs/analytics-platform/using/cja-workspace/attribution/models" target="_blank" rel="noopener">Customer Journey Analytics · attribution</a>
          <a class="im-torna" href={TORNA}><span data-lang-it>← Torna ai quattro componenti</span><span data-lang-en>← Back to the four components</span></a>
        </p>
      </div>
    </Slide>

    {/* ── Il profilo · Real-Time CDP ───────────────────────────────── */}
    <Slide id="slide-ingaggio-profilo" bg="inverse" align="left">
      <div slot="backdrop" class="im-bg-notte"></div>
      <div class="im-ado-cap im-ado-cap--largo" data-reveal>
        <T as="p" class="im-ado-occ" it="Approfondimento · il profilo" en="Deep dive · the profile" />
        <T as="h2" class="im-ado-t im-ado-t--stretto" it="Il profilo collega pseudonimo, telefono e codice cliente alla stessa persona" en="The profile links pseudonym, phone number and customer number to one person" />
        <T as="p" class="im-ado-l" it="Giulia è uno pseudonimo sul sito, un numero di telefono alla Filiale Digitale e un codice cliente dopo la firma. Il profilo li collega." en="Giulia is a pseudonym on the site, a phone number at the Filiale Digitale and a customer number after signature. The profile links them." />

        <div class="im-bv im-cat">
          {PROFILO.map((c, i) => (
            <>
              <section class="im-bv-i">
                <FiguraCap segno={c.fig} />
                <T as="span" class="im-bv-t" it={c.t.it} en={c.t.en} />
                <T as="span" class="im-bv-d" it={c.d.it} en={c.d.en} />
              </section>
              {i < PROFILO.length - 1 && <span class="im-bv-op im-cat-op" aria-hidden="true">→</span>}
            </>
          ))}
        </div>

        {/* La scelta di disegno. Due strade, entrambe legittime: è la
            domanda che il loro IT fa per primo, e arrivarci prima di
            loro vale più che rispondere dopo. */}
        <div class="im-scelta">
          <T as="p" class="im-scelta-k" it="Una scelta di disegno, da fare insieme" en="One design choice, to make together" />
          <div class="im-scelta-g">
            {SCELTA_PROFILO.map((o) => (
              <section class="im-scelta-i">
                <T as="span" class="im-scelta-t" it={o.t.it} en={o.t.en} />
                <T as="span" class="im-scelta-d" it={o.d.it} en={o.d.en} />
                <T as="span" class="im-scelta-q" it={o.q.it} en={o.q.en} />
              </section>
            ))}
          </div>
        </div>

        <p class="im-fonte-riga">
          <span data-lang-it>La seconda strada è </span><span data-lang-en>The second route is </span>
          <a href="https://experienceleague.adobe.com/en/docs/federated-audience-composition/using/overview" target="_blank" rel="noopener">Federated Audience Composition</a><span
            data-lang-it>: un modulo a parte di Real-Time CDP e Journey Optimizer. Lavora solo su un elenco chiuso di database (Redshift, Synapse, Databricks, BigQuery, Fabric, Oracle, Snowflake, Teradata, Vertica). Il mutuo vuole la prima strada: riconoscimento in sessione, decisione a evento. Verificato l’11 nov 2026: </span>
          <span data-lang-en>: a separate module of Real-Time CDP and Journey Optimizer. It works only on a closed list of databases (Redshift, Synapse, Databricks, BigQuery, Fabric, Oracle, Snowflake, Teradata, Vertica). For the mortgage case the first route is needed (in-session recognition, event-driven decision). Verified 11 Nov 2026: </span>
          <a href="https://experienceleague.adobe.com/en/docs/federated-audience-composition/using/connections/home" target="_blank" rel="noopener"><span data-lang-it>database supportati</span><span data-lang-en>supported databases</span></a>
          <a class="im-torna" href={TORNA}><span data-lang-it>← Torna ai quattro componenti</span><span data-lang-en>← Back to the four components</span></a>
        </p>
      </div>
    </Slide>

    {/* ── La regia · Journey Optimizer ─────────────────────────────── */}
    <Slide id="slide-ingaggio-regia" bg="inverse" align="left">
      <div slot="backdrop" class="im-bg-notte"></div>
      <div class="im-ado-cap im-ado-cap--largo" data-reveal>
        <T as="p" class="im-ado-occ" it="Approfondimento · la regia" en="Deep dive · orchestration" />
        <T as="h2" class="im-ado-t im-ado-t--stretto" it="Tre modi di eseguire la stessa decisione" en="Three ways to execute the same decision" />
        <T as="p" class="im-ado-l" it="La decisione si configura una volta. Dove viene eseguita è una scelta, e le tre strade convivono." en="The decision is configured once. Where it runs is a choice, and the three routes coexist." />

        <div class="im-esec">
          {ESEC.map((e) => (
            <section class="im-esec-i">
              <FiguraCap segno={e.fig} class="im-esec-fig" />
              <T as="span" class="im-bv-t" it={e.t.it} en={e.t.en} />
              <T as="span" class="im-esec-chi" it={e.chi.it} en={e.chi.en} />
              <T as="span" class="im-bv-d" it={e.d.it} en={e.d.en} />
            </section>
          ))}
        </div>

        <div class="im-csc-conf im-csc-conf--eng">
          <T as="span" class="im-csc-conf-t" it="Il terzo modo è la risposta a «e quello che abbiamo già?»" en="The third route answers “what about what we already have?”" />
          <T as="span" class="im-csc-conf-d" it="L’orchestrazione può restare dove è oggi: cambia solo chi decide quale offerta esce. La regola resta vostra. Due contatori: il limite per offerta si valuta quando si decide; il tetto per persona e per canale si applica all’invio (su web e app vale solo il primo). La vostra politica si mappa sul secondo, oppure arriva dal vostro sistema come attributo “contatti residui”: si sceglie in fase 0." en="The orchestration can stay where it is today: only who decides which offer goes out changes. The rule stays yours. Two counters: the per-offer limit is evaluated when deciding; the per-person, per-channel cap is applied at send (on web and app only the first holds). Your policy maps onto the second, or comes from your system as a “contacts remaining” attribute: this is chosen in phase 0." />
        </div>

        <p class="im-fonte-riga">
          <span data-lang-it>Il limite per offerta si conta per identità al bordo e per profilo nel percorso. Per la funzione precedente (Offer Decisioning) la documentazione indica qualche minuto di ritardo sulla Decisioning API e fino a 30 minuti fra bordo e hub; per il nuovo Decisioning i tempi vanno riverificati. Documentazione pubblica, 11 nov 2026: </span><span data-lang-en>The per-offer limit counts per identity at the edge and per profile in the journey. For the previous capability (Offer Decisioning) the documentation gives a few minutes’ delay on the Decisioning API and up to 30 minutes between edge and hub; for the new Decisioning the timings need re-checking. Public documentation, 11 Nov 2026: </span>
