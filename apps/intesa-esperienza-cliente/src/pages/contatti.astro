---
/**
 * Chi vuole una risposta — solo nella versione B (`build:insieme`), per il
 * referente della banca. Separata dal riepilogo: il riepilogo sale ai vertici
 * e non porta indirizzi, questa no. Contenuto dalla RPC `get_contatti` (0042)
 * con `?t=<contatti_token>`. Spec 2026-11-20-contatto-facoltativo-design.md.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import ContattiPage from '@edf/core/blocks/doc/ContattiPage.astro';
---
<BaseLayout title="Chi vuole una risposta" noindex>
  <ContattiPage
    titolo="Chi ha lasciato un’email per avere una risposta"
    sottotitolo="Le domande arrivate dal modulo della storia di Giulia da chi ha chiesto di essere ricontattato. Rispondiamo noi, e vi proponiamo una sessione insieme quando più domande vanno nella stessa direzione. Le email non entrano nel riepilogo e si cancellano dopo la risposta, o al più tardi dopo 90 giorni."
    piede="Pagina riservata al referente del progetto, preparata con il team Adobe dell’account."
  />
</BaseLayout>
<style is:global>
  /* Un documento, non un deck: fondo chiaro, scorre. */
  html, body { overflow: auto !important; height: auto !important; }
  body { background: var(--surface-primary); }
</style>
