---
/**
 * 06 · IL LAVORO SI CHIEDE A PAROLE — intro a Coworker e il video.
 *
 * Due slide: che cos'è, e la dimostrazione su dati di esempio (i dati
 * del cliente solo dopo l'attivazione e la fase 0: panel, 11 nov 2026).
 * Il video NON è in pagina: è uno slot che si riempie dalla console di
 * amministrazione (`MediaDemoSlot` dentro una slide `data-demo-flex`),
 * così la clip si attacca quando esiste e il link si condivide senza
 * ricompilare niente.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import T from '@edf/core/blocks/i18n/T.astro';
import { href } from '@edf/core/utils/url.js';
import { CHAPTERS, prevSlug, nextSlug } from '../data/chapters';
import Divisore from '../components/Divisore.astro';
import fondo from '../assets/generated/cover-coworker.webp';

const SLUG = 'coworker';
const ch = CHAPTERS.find((c) => c.slug === SLUG)!;
const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;

/* Lo storyboard del video. È anche la scaletta di che cosa si vede
   nella clip: chi guarda sa dove siamo mentre scorre.
   ⚠️ RIALLINEATO AL MUTUO (panel, 30 ott 2026). Partiva da «tassi in
   calo, clienti con molta liquidità»: un caso su CLIENTI, fuori dalla
   storia di Giulia e dentro il perimetro POG; «canali, tempi e frequenza
   decisi dall'agente» scavalcava la politica di contatto della banca;
   «Marketing e Compliance approvano» saltava il Targeting; «si ottimizza
   da sé» non è una capacità documentata. Ora c'è un passo «Target», la
   frequenza resta regola loro, e approva chi approva oggi. */
/* Il video della demo, da un link pubblico AEM (https: da GitHub Pages un
   http verrebbe bloccato come contenuto misto). ⚠️ SEGNAPOSTO: va sostituito
   con la clip di Coworker prima del 19 novembre. */
const VIDEO_DEMO = 'https://publish-p129757-e1266090.adobeaemcloud.com/content/dam/ferrero/nutella/campaigns/buongiorno-insieme/The-Sound-of-SnapYT.App.mp4';

const STORY = [
  { n: '1', t: { it: 'Obiettivo', en: 'Objective' },
    d: { it: '«Riprendere le simulazioni di mutuo ferme da più di 12 ore, prima che chiudano altrove».', en: '“Resume the mortgage simulations stalled for more than 12 hours, before they close elsewhere.”' } },
  { n: '2', t: { it: 'Target', en: 'Target' },
    d: { it: 'Lo definisce e lo approva chi lo fa oggi. Sui non clienti oggi avete un punteggio o una regola? Se c’è, entra come attributo; se no, valgono la priorità dell’offerta e le regole scritte insieme.', en: 'Defined and approved by whoever does it today. Do you have a score or a rule on non-customers today? If so, it comes in as an attribute; if not, the offer’s priority and the rules written together apply.' } },
  { n: '3', t: { it: 'Contenuti', en: 'Content' },
    d: { it: 'Email e variante per città. Varianti controllate contro le linee guida di marchio e di canale mentre si producono; le informative restano nell’iter di approvazione legale.', en: 'Email and a per-city variant. Variants are checked against brand and channel guidelines while they are produced; disclosures stay in the legal approval process.' } },
  { n: '4', t: { it: 'Percorso', en: 'Journey' },
    d: { it: 'Canali e tempi proposti dall’agente dentro la vostra politica di contatto. La regola di contatto resta vostra.', en: 'Channels and timing proposed by the agent inside your contact policy. The contact rule stays yours.' } },
  { n: '5', t: { it: 'Approvazione', en: 'Approval' },
    d: { it: 'Chi approva oggi approva anche qui, secondo il vostro iter.', en: 'Whoever approves today approves here too, following your process.' } },
  { n: '6', t: { it: 'Misura', en: 'Measurement' },
    d: { it: 'I risultati tornano in CX Analytics; sul gruppo di controllo si vede se il percorso rende; se il target era giusto, solo confrontando due regole.', en: 'Results flow back into CX Analytics; the control group shows whether the journey pays; whether the target was right, only by comparing two rules.' } },
];
---
<BaseLayout title={ch.title.it}>
  <div class="fixed top-0 left-0 right-0 z-50">
    <Navigation currentPath={currentPath} base={base} />
  </div>

  <DeckContainer nextHref={href(base, nextSlug(SLUG))} prevHref={href(base, prevSlug(SLUG))}>

    <Slide id="slide-cover" bg="secondary" align="left" data-made-with="Adobe Firefly" data-made-with-for="sfondo">
      <div slot="backdrop" class="im-div-bg" style={`--foto: url('${fondo.src}'); --fuoco: center 44%`}></div>
      <Divisore num={ch.num}
        tIt="Coworker prepara una bozza; l’approvazione resta a chi approva oggi" tEn="Coworker prepares a draft; approval stays with today’s approvers" />
    </Slide>

    <Slide id="slide-cosa" bg="inverse" align="left">
      <div slot="backdrop" class="im-bg-notte"></div>
      <div class="im-ado-cap im-ado-cap--largo" data-reveal>
        <T as="p" class="im-ado-occ" it="Adobe CX Enterprise Coworker" en="Adobe CX Enterprise Coworker" />
        {/* ⚠️ CHAT E PROJECTS NON SI DISTINGUONO PIÙ (Teams 30 ott e check
            dell'11 nov 2026, chiesto due volte dal team): Projects non è
            disponibile, e a questo livello la distinzione non serve a chi
            ascolta. Le tre voci dicono come si usa, fin dove arriva, dove gira. */}
        {/* ⚠️ Diceva «un collega che esegue, non un assistente che
            suggerisce»: un agente che «esegue» senza identità, permessi
            e approvazione dichiarati è una domanda di sicurezza, e tutte
            e sei le personas l'hanno riscritto (panel, 30 ott 2026). */}
        <T as="h2" class="im-ado-t im-ado-t--stretto" it="Prepara audience, contenuti e percorso fino all’approvazione. Chi approva resta chi approva oggi" en="It prepares audience, content and journey up to approval. Whoever approves stays in charge" />
        <T as="p" class="im-ado-l" it={`Si scrive il compito; Coworker prepara una bozza di audience, contenuti e percorso, e chi approva oggi la rivede. <span class=im-nw>Niente parte senza approvazione.</span>`} en="You write the task; Coworker drafts audience, content and journey, and today’s approvers review it. Nothing goes out without approval." />

        <ul class="im-cow">
          <li class="im-cow-i" data-k="chat">
            <svg class="im-cow-fig" viewBox="0 0 68 64" aria-hidden="true"><path d="M10 14h44a6 6 0 0 1 6 6v18a6 6 0 0 1-6 6H30l-12 10V44h-8a6 6 0 0 1-6-6V20a6 6 0 0 1 6-6Z" class="tr"/><path d="M18 26h28M18 33h18" class="ac"/></svg>
            <T as="span" class="im-bv-t" it="A parole" en="In plain words" />
            <T as="span" class="im-bv-d" it="Audience, contenuti e percorso in una conversazione, a passi" en="Audience, content and journey in one conversation, step by step" />
          </li>
          <li class="im-cow-i" data-k="agente">
            <svg class="im-cow-fig" viewBox="0 0 68 64" aria-hidden="true"><circle cx="34" cy="32" r="18" class="tr"/><path d="m26 32 6 6 11-12" class="ac"/><path d="M52 18l6-4M52 46l6 4M16 18l-6-4M16 46l-6 4" class="tr"/></svg>
            <T as="span" class="im-bv-t" it="Fino all’approvazione" en="Up to approval" />
            <T as="span" class="im-bv-d" it="Si ferma alla bozza: il resto lo decide il vostro iter" en="It stops at the draft: your process decides the rest" />
          </li>
          <li class="im-cow-i" data-k="dove">
            <svg class="im-cow-fig" viewBox="0 0 68 64" aria-hidden="true"><path d="M34 8 54 16v14c0 13-9 22-20 26C23 52 14 43 14 30V16Z" class="tr"/><path d="m26 31 6 6 11-11" class="ac"/></svg>
            <T as="span" class="im-bv-t" it="Dove gira" en="Where it runs" />
            <T as="span" class="im-bv-d" it="In Adobe, con permessi e approvazione" en="Inside Adobe, with permissions and approval" />
          </li>
        </ul>

        <p class="im-fonte-riga">
          <span data-lang-it>L’attivazione per la vostra istanza passa dal team Adobe (licenze, onboarding, permessi) e va confermata. Finché non è confermata, questo capitolo non è un impegno. Quello che gira <span class="im-nw">sui vostri dati va concordato.</span> Documentazione pubblica: </span>
          <span data-lang-en>For financial services, activation for your instance must be requested and confirmed by Adobe. Until it is confirmed, this chapter is not a commitment. What runs on your data is to be agreed. Public documentation: </span>
          <a href="https://experienceleague.adobe.com/en/docs/coworker/content/home" target="_blank" rel="noopener">experienceleague.adobe.com · CX Enterprise Coworker</a><span> · </span>
          <a href="https://experienceleague.adobe.com/en/docs/coworker/content/chat/overview" target="_blank" rel="noopener">Coworker Chat</a>
        </p>
      </div>
    </Slide>

    <Slide id="slide-video" bg="inverse" align="split" data-demo-flex>
      <div slot="backdrop" class="im-bg-notte"></div>
      <div class="im-cow-demo" data-reveal>
        <div class="im-cow-demo-sx">
          {/* ⚠️ Diceva «Dal vivo · con i vostri dati», con sotto una nota di lavoro: nessuno ha chiesto dati della banca, la demo dal vivo è stata esclusa il 28 ottobre e l'attivazione non è confermata (panel, 11 nov 2026). Si mostra su dati di esempio. */}
          <T as="p" class="im-ado-occ" it="Dimostrazione · su dati di esempio" en="Demo · on sample data" />
          <T as="h2" class="im-ado-t im-ado-t--stretto" it="Un’iniziativa sul mutuo preparata in una sessione" en="A mortgage initiative prepared in one session" />
          {/* ⚠️ SEGNAPOSTO (12 nov 2026): finché la demo di Coworker non è
              montata, qui gira un video pubblicato su AEM, scelto da chi
              presenta per provare l'embed da un link pubblico Adobe. Il
              video definitivo si mette cambiando VIDEO_DEMO, una riga. */}
          <video class="im-cow-video" src={VIDEO_DEMO} controls playsinline preload="metadata" aria-label="Video della dimostrazione"></video>
          <T as="p" class="im-fonte-riga" it="Sui vostri dati, dopo l’attivazione e con il perimetro concordato in fase 0." en="On your data, after activation and within the scope agreed in phase 0." />
        </div>
        <ol class="im-story">
          {STORY.map((s) => (
            <li class="im-story-i">
              <span class="im-story-n">{s.n}</span>
              <span>
                <T as="span" class="im-story-t" it={s.t.it} en={s.t.en} />
                <T as="span" class="im-story-d" it={s.d.it} en={s.d.en} />
              </span>
            </li>
          ))}
        </ol>
      </div>
    </Slide>

  </DeckContainer>
</BaseLayout>
