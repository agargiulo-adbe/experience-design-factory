---
/**
 * 06 · IL LAVORO SI CHIEDE A PAROLE — intro a Coworker e il video.
 *
 * Due slide: che cos'è, e la dimostrazione con i dati del cliente.
 * Il video NON è in pagina: è uno slot che si riempie dalla console di
 * amministrazione (`MediaDemoSlot` dentro una slide `data-demo-flex`),
 * così la clip si attacca quando esiste e il link si condivide senza
 * ricompilare niente.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import MediaDemoSlot from '@edf/core/blocks/immersive/MediaDemoSlot.astro';
import T from '@edf/core/blocks/i18n/T.astro';
import { href } from '@edf/core/utils/url.js';
import { CHAPTERS, prevSlug, nextSlug } from '../data/chapters';
import Divisore from '../components/Divisore.astro';
import fondo from '../assets/generated/lavoro-06-filiale-back.webp';

const SLUG = 'coworker';
const ch = CHAPTERS.find((c) => c.slug === SLUG)!;
const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;

/* Lo storyboard del video. È anche la scaletta di che cosa si vede
   nella clip: chi guarda sa dove siamo mentre scorre.
   ⚠️ RIALLINEATO AL MUTUO (panel, 30 ott 2026). Partiva da «tassi in
   calo, clienti con molta liquidità»: un caso su CLIENTI, fuori dalla
   storia di Giulia e dentro il perimetro POG; «canali, tempi e frequenza
   decisi dall'agente» scavalcava la politica di contatto della banca;
   «Marketing e Compliance approvano» saltava il Targeting; «si ottimizza
   da sé» non è una capacità documentata. Ora c'è un passo «Target», la
   frequenza resta regola loro, e approva chi approva oggi. */
const STORY = [
  { n: '1', t: { it: 'Obiettivo', en: 'Objective' },
    d: { it: '«Riprendere le simulazioni di mutuo ferme da più di 48 ore, prima che chiudano altrove».', en: '“Resume the mortgage simulations stalled for more than 48 hours, before they close elsewhere.”' } },
  { n: '2', t: { it: 'Target', en: 'Target' },
    d: { it: 'Lo definisce e lo approva chi lo fa oggi; sulle prospect vale la regola di eleggibilità scritta insieme, perché lì il motore non ha ancora score.', en: 'Defined and approved by whoever does it today; on prospects the eligibility rule written together applies, because there the engine has no scores yet.' } },
  { n: '3', t: { it: 'Contenuti', en: 'Content' },
    d: { it: 'Email e variante per città, verificate contro le informative prima dell’approvazione.', en: 'Email and a per-city variant, checked against disclosures before approval.' } },
  { n: '4', t: { it: 'Percorso', en: 'Journey' },
    d: { it: 'Canali e tempi proposti dall’agente dentro la vostra politica di contatto: la frequenza resta la vostra regola.', en: 'Channels and timing proposed by the agent inside your contact policy: frequency stays your rule.' } },
  { n: '5', t: { it: 'Approvazione', en: 'Approval' },
    d: { it: 'Chi approva oggi approva anche qui, secondo il vostro iter.', en: 'Whoever approves today approves here too, following your process.' } },
  { n: '6', t: { it: 'Misura', en: 'Measurement' },
    d: { it: 'I risultati tornano in CX Analytics; sul gruppo di controllo si vede se il target era giusto, e il giro dopo si corregge.', en: 'Results flow back into CX Analytics; the control group shows whether the target was right, and the next loop gets corrected.' } },
];
---
<BaseLayout title={ch.title.it}>
  <div class="fixed top-0 left-0 right-0 z-50">
    <Navigation currentPath={currentPath} base={base} />
  </div>

  <DeckContainer nextHref={href(base, nextSlug(SLUG))} prevHref={href(base, prevSlug(SLUG))}>

    <Slide id="slide-cover" bg="secondary" align="left">
      <div slot="backdrop" class="im-div-bg" style={`--foto: url(${fondo.src}); --fuoco: center 44%`}></div>
      <Divisore num={ch.num}
        tIt="Il lavoro si chiede a parole" tEn="The work is asked for in words"
        lIt="Dall’obiettivo alla campagna pronta, con i vostri dati e il vostro iter di approvazione."
        lEn="From objective to a campaign ready to go, on your data and through your approval process." />
    </Slide>

    <Slide id="slide-cosa" bg="inverse" align="left">
      <div slot="backdrop" class="im-bg-notte"></div>
      <div class="im-ado-cap im-ado-cap--largo" data-reveal>
        <T as="p" class="im-ado-occ" it="Adobe CX Enterprise Coworker" en="Adobe CX Enterprise Coworker" />
        {/* ⚠️ Diceva «un collega che esegue, non un assistente che
            suggerisce»: un agente che «esegue» senza identità, permessi
            e approvazione dichiarati è una domanda di sicurezza, e tutte
            e sei le personas l'hanno riscritto (panel, 30 ott 2026). */}
        <T as="h2" class="im-ado-t im-ado-t--stretto" it="Prepara audience, contenuti e percorso fino all’approvazione. Chi approva resta chi approva oggi" en="It prepares audience, content and journey up to approval. Whoever approves stays in charge" />
        <T as="p" class="im-ado-l" it="Si descrive l’obiettivo in una frase. Da lì il sistema costruisce il piano e chiama gli strumenti che servono, nell’ordine giusto. Si corregge quando qualcosa non torna, e tiene memoria di quello che ha già fatto. Niente parte senza un sì." en="You describe the objective in a sentence. From there the system builds the plan and calls the tools it needs, in the right order. It corrects itself when something is off, and keeps memory of what it has already done. Nothing goes out without a yes." />

        <ul class="im-cow">
          <li class="im-cow-i" data-substep data-side="in">
            <T as="span" class="im-bv-t" it="Chat" en="Chat" />
            <T as="span" class="im-bv-d" it="Si chiede una cosa a parole e si ottiene fatta: esecuzione autonoma, più passi di fila, con la conversazione che resta." en="You ask for something in plain words and get it done: autonomous execution, several steps in a row, with the conversation kept." />
          </li>
          <li class="im-cow-i" data-substep data-side="in">
            <T as="span" class="im-bv-t" it="Projects · annunciato, in arrivo" en="Projects · announced, coming" />
            <T as="span" class="im-bv-d" it="Uno spazio di lavoro per un obiettivo intero: compiti, approvazioni e persone diverse, coordinati dallo stesso agente." en="A workspace for a whole objective: tasks, approvals and different people, coordinated by the same agent." />
          </li>
          <li class="im-cow-i" data-substep data-side="in">
            <T as="span" class="im-bv-t" it="Dove gira" en="Where it runs" />
            <T as="span" class="im-bv-d" it="Dentro Adobe, con un’identità sua e i permessi che gli date; ogni invio passa da un’approvazione umana e resta tracciato. L’orchestratore parla anche con piattaforme di terzi." en="Inside Adobe, with its own identity and the permissions you grant; every send passes a human approval and stays logged. The orchestrator also talks to third-party platforms." />
          </li>
        </ul>

        <p class="im-fonte-riga">
          <span data-lang-it>Per il settore finanziario l’attivazione si chiede ad Adobe, e per la vostra istanza la richiesta è in corso: finché non è confermata, questo capitolo descrive, non promette. Quello che gira sui vostri dati va concordato. Documentazione pubblica: </span>
          <span data-lang-en>For financial services, activation is requested from Adobe, and for your instance the request is under way: until it is confirmed, this chapter describes, it does not promise. What runs on your data is to be agreed. Public documentation: </span>
          <a href="https://experienceleague.adobe.com/en/docs/coworker/content/home" target="_blank" rel="noopener">experienceleague.adobe.com · CX Enterprise Coworker</a>
        </p>
      </div>
    </Slide>

    <Slide id="slide-video" bg="inverse" align="split" data-demo-flex>
      <div slot="backdrop" class="im-bg-notte"></div>
      <div class="im-cow-demo" data-reveal>
        <div class="im-cow-demo-sx">
          <T as="p" class="im-ado-occ" it="Dal vivo · con i vostri dati" en="Live · on your data" />
          <T as="h2" class="im-ado-t im-ado-t--stretto" it="Dall’obiettivo alla campagna, in una sessione" en="From objective to campaign, in one session" />
          {/* Lo slot si riempie dalla console: la clip si attacca quando
              c'è, e il link si condivide senza ricompilare. */}
          <MediaDemoSlot id="coworker-demo" label="Video demo Coworker" />
          <T as="p" class="im-fonte-riga" it="Scenario, dati e durata da concordare prima dell’incontro." en="Scenario, data and length to be agreed before the meeting." />
        </div>
        <ol class="im-story">
          {STORY.map((s) => (
            <li class="im-story-i" data-substep data-side="in">
              <span class="im-story-n">{s.n}</span>
              <span>
                <T as="span" class="im-story-t" it={s.t.it} en={s.t.en} />
                <T as="span" class="im-story-d" it={s.d.it} en={s.d.en} />
              </span>
            </li>
          ))}
        </ol>
      </div>
    </Slide>

  </DeckContainer>
</BaseLayout>
