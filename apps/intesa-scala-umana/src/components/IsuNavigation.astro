---
import { href } from '@edf/core/utils/url.js';
import LangToggle from '@edf/core/blocks/i18n/LangToggle.astro';
import { CHAPTERS } from '../data/chapters';

/**
 * La nav resta UNA barra: rail dei capitoli a `nowrap` con scroll, cluster a
 * destra. Nessun marchio disegnato — non esiste un SVG ufficiale verificato del
 * cliente, e il nome basta (vedi `CoBrand.astro`). Nessuna voce «Admin»: questa
 * app non ha una console, e una voce di navigazione che non porta da nessuna
 * parte è un difetto.
 */
interface Props {
  currentPath: string;
  base: string;
}
const { currentPath, base } = Astro.props;

function isActive(slug: string) {
  return currentPath.replace(/\/+$/, '').endsWith('/' + slug);
}
---
<nav class="isu-nav flex items-center justify-between px-6 py-3" aria-label="Navigazione">
  <a
    href={href(base, '/')}
    class="flex items-center gap-2.5 no-underline group flex-shrink-0"
    aria-label="Home — Su scala umana"
  >
    {/* Il marchio al posto del nome: è LA STESSA FORMA del favicon — la scala
        che sale e la base su cui poggia — così la scheda del browser, la barra
        e l'anteprima del link dicono tutte la stessa cosa. Quando il favicon
        cambia, questo va cambiato con lui: è un SVG inline, `brand:icons` non
        lo tocca (è la ragione per cui era rimasto indietro di una versione).
        Il nome resta nel titolo del documento e sulla copertina, dove ha lo
        spazio per contare; con il nome fuori c'è posto per la firma, che prima
        compariva solo sopra i 1536px. */}
    <span class="isu-nav-mark" aria-hidden="true">
      <svg viewBox="0 0 32 32" width="26" height="26" role="presentation" focusable="false">
        <rect width="32" height="32" rx="7" fill="#0d2901"/>
        <path d="M7 22.5 V17.5 H13.5 V12 H20 V6.5 H25.5"
              fill="none" stroke="#4fc21f" stroke-width="2.6"
              stroke-linecap="square" stroke-linejoin="miter"/>
        <rect x="6" y="24.5" width="20" height="3" rx="1.5" fill="#258900"/>
      </svg>
    </span>
    <span class="hidden sm:inline text-[0.65rem] font-bold tracking-widest uppercase text-[var(--color-grigio-600)] whitespace-nowrap">
      Adobe × Intesa Sanpaolo
    </span>
  </a>

  <ol
    class="hidden md:flex flex-nowrap items-center gap-0.5 min-w-0 overflow-x-auto [scrollbar-width:none] [-ms-overflow-style:none] [&::-webkit-scrollbar]:hidden"
    role="list"
  >
    {CHAPTERS.map((c) => (
      <li role="listitem" class="flex-shrink-0">
        <a
          href={href(base, '/' + c.slug)}
          class:list={[
            'isu-nav-link block whitespace-nowrap px-2.5 py-1.5 text-xs font-semibold transition-colors no-underline',
            isActive(c.slug) && 'isu-nav-link--active',
          ]}
          aria-current={isActive(c.slug) ? 'page' : undefined}
        >
          <span class="text-[var(--color-grigio-500)] mr-1 tabular-nums">{c.num}</span>
          <span data-lang-it>{c.label.it}</span><span data-lang-en>{c.label.en}</span>
        </a>
      </li>
    ))}
  </ol>

  <div class="flex items-center gap-3 flex-shrink-0">
    <a
      href={href(base, '/exec')}
      class:list={['isu-nav-link whitespace-nowrap px-2.5 py-1.5 text-xs font-semibold no-underline', isActive('exec') && 'isu-nav-link--active']}
      aria-current={isActive('exec') ? 'page' : undefined}
    >
      <span data-lang-it>In dieci minuti</span><span data-lang-en>In ten minutes</span>
    </a>
    <LangToggle langs={['it', 'en']} />
  </div>
</nav>
