---
/**
 * CoBrand (Intesa Sanpaolo) — wrapper sottile sul componente condiviso.
 *
 * Il motore (`@edf/core/blocks/CoBrand.astro`) porta la regola: ordine Adobe ×
 * Brand non invertibile, firma fissa su ogni slide, lockup grande su prima e
 * ultima slide. Qui si dichiara solo CHI è il brand.
 *
 * MARCHIO UFFICIALE. `src/assets/brand/intesa-sanpaolo.svg` è il logotipo
 * distribuito dal cliente stesso sul proprio dominio corporate
 * (group.intesasanpaolo.com → /content/dam/portalgroup/nuove-immagini/
 * immagini-cross/loghi/logo_isp.svg, scaricato l'8 ottobre 2026). L'originale
 * è un export Illustrator con `fill:#FFFFFF` fisso: qui il fill è portato a
 * `currentColor`, se no il lockup non si ribalta con la superficie e sul fondo
 * chiaro sparisce. Niente altro è stato toccato — nessun ridisegno, nessun
 * ritocco di tracciati: la Quality Bar vieta i marchi ricostruiti a mano.
 *
 * Si inietta inline (`?raw` + `set:html`) e non come `<img>`: un'immagine non
 * eredita `currentColor`, e il ribaltamento chiaro/scuro si perderebbe.
 */
import Core from '@edf/core/blocks/CoBrand.astro';
import logo from '../assets/brand/intesa-sanpaolo.svg?raw';

interface Props {
  variant?: 'chrome' | 'hero';
  class?: string;
  [key: string]: unknown;
}
const props = Astro.props as Props;
---
<Core brand="Intesa Sanpaolo" {...props}>
  <span slot="brand" class="isu-brand-mark" set:html={logo} />
</Core>
