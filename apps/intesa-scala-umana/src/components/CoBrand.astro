---
/**
 * CoBrand (Intesa Sanpaolo) — wrapper sottile sul componente condiviso.
 *
 * Il motore (`@edf/core/blocks/CoBrand.astro`) porta la regola: ordine Adobe ×
 * Brand non invertibile, firma fissa su ogni slide, lockup grande su prima e
 * ultima slide. Qui si dichiara solo CHI è il brand.
 *
 * NESSUN SVG UFFICIALE VERIFICATO. Il marchio Intesa Sanpaolo non è stato
 * trovato come SVG distribuibile a `currentColor`, quindi vale il ripiego
 * automatico previsto dalla regola: il nome nel carattere del cliente (Open
 * Sans, lo stesso di intesasanpaolo.com). **Non è il logo** — e un logo
 * ricostruito a mano è esattamente la wrong-brand imagery che la Quality Bar
 * vieta. Il ripiego resta a peso UNICO di proposito: imitare il contrasto di
 * pesi del logotipo vero senza averlo verificato sarebbe una ricostruzione.
 * Quando il cliente consegna l'SVG ufficiale si passa `<svg slot="brand">`.
 */
import Core from '@edf/core/blocks/CoBrand.astro';

interface Props {
  variant?: 'chrome' | 'hero';
  class?: string;
  [key: string]: unknown;
}
const props = Astro.props as Props;
---
<Core brand="Intesa Sanpaolo" {...props}>
  <span slot="brand" class="isu-cobrand-word" aria-hidden="true">Intesa Sanpaolo</span>
</Core>
