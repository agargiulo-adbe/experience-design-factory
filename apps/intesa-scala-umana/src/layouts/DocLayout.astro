---
// Guscio minimo per la sola pagina dossier. Niente deck, niente tailwind,
// niente @edf/core: questa app oggi serve UNA pagina orfana e gated.
//
// TOKEN — letti dal CSS di produzione di www.intesasanpaolo.com con
// `pnpm brand:tokens https://www.intesasanpaolo.com` (4 fogli, 805 KB, 4 ott
// 2026), non a memoria. Il colore di SISTEMA è il verde #258900 (181
// occorrenze), non un blu; l'accento è l'arancio #fa9600 (35); il verde notte
// #0d2901 (46) regge la superficie scura. I valori Bootstrap 3 trovati nel
// foglio (#337ab7, #a94442, #3c763d, #8a6d3b) sono default di framework e
// NON fanno parte del design system: scartati.
//
// Carattere: Open Sans, dichiarato 59 volte dal sito. Per una volta non serve
// una sostituta — è distribuibile. `ispfont` è il loro font di icone, non di testo.
interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}
const { title, description = '', noindex = false } = Astro.props;
---
<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex, nofollow, noarchive" />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;600;700&display=swap"
    />
    <style is:global>
      :root {
        /* ── PALETTE INTESA → contratto `--dw-*` del motore dossier ──────────
           Valori letti dal CSS di produzione di www.intesasanpaolo.com con
           `pnpm brand:tokens` (4 ott 2026), non a memoria: il colore di SISTEMA
           è il verde #258900 (181 occorrenze), l'accento l'arancio #fa9600 (35),
           il verde notte #0d2901 (46) regge la superficie scura. I valori
           Bootstrap 3 del foglio (#337ab7, #a94442…) sono default di framework:
           scartati.
           Un accento non è un inchiostro: #258900 su fondo notte dà 3,5:1 e non
           basta per il testo, quindi per testo e pieni si usa la sua schiaritura
           #4fc21f (7,6:1 su #0d2901) e #258900 resta disponibile per i fondi.
           --dw-alt è una schiaritura ulteriore (8,9:1): serve ai ruoli e ai
           sottotitoli, dove il verde pieno #2b8804 dava 3,5:1 — sotto la soglia. */
        --dw-bg: #0d2901;
        --dw-tint: rgba(37, 137, 0, 0.16);
        --dw-surface: rgba(16, 48, 6, 0.6);
        --dw-surface-2: rgba(37, 137, 0, 0.18);
        --dw-line: #203b18;

        --dw-ink: #d7e3d2;          /* 11,8:1 — corpo del testo */
        --dw-ink-soft: #a8bda2;     /*  7,8:1 — note e metadati */
        --dw-ink-faint: #7d9276;    /*  4,7:1 — etichette minute */
        --dw-ink-strong: #ffffff;

        --dw-accent: #4fc21f;       /* 7,6:1 — numeri, bullet, stato attivo */
        --dw-fill: #4fc21f;
        --dw-on-fill: #0d2901;      /* inchiostro scuro sul pieno: 7,6:1 */
        --dw-warn: #fa9600;
        --dw-on-warn: #0d2901;      /* 7,1:1 — il bianco sull'arancio dava 2,2:1 */
        --dw-alt: #9ecf8a;          /* 8,9:1 — ruoli, sottotitoli, crediti */

        /* Carattere: Open Sans, dichiarato 59 volte dal sito. Per una volta non
           serve una sostituta — è distribuibile. `ispfont` è il loro font di
           icone, non di testo. */
        --dw-font-display: 'Open Sans', system-ui, sans-serif;
        --dw-font-body: 'Open Sans', system-ui, sans-serif;
      }
      * { margin: 0; padding: 0; box-sizing: border-box; }
      html { -webkit-text-size-adjust: 100%; }
      body {
        background: var(--dw-bg);
        color: var(--dw-ink);
        font-family: var(--dw-font-body);
        line-height: 1.6;
      }
      img { max-width: 100%; }
      /* Serve davvero: la pagina nasconde il gate con l'attributo `hidden`, ma
         .dw-state dichiara display:flex e senza questa riga lo batte — il gate
         resterebbe a schermo sopra il contenuto. */
      [hidden] { display: none !important; }
      @media print {
        body { background: #fff; color: #222; }
      }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
