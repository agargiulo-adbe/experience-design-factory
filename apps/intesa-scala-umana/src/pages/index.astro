---
import BaseLayout from '../layouts/BaseLayout.astro';
import IsuNavigation from '../components/IsuNavigation.astro';
import CoBrand from '../components/CoBrand.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import LoopVideo from '@edf/core/blocks/immersive/LoopVideo.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import T from '@edf/core/blocks/i18n/T.astro';
import { href } from '@edf/core/utils/url.js';
import { EXPERIENCE_TYPES } from '@edf/core/data/experienceTypes';
import { CHAPTERS } from '../data/chapters';
import bgPercorso from '../assets/generated/bg/light-percorso.jpg';

const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;

/* La clip della copertina. Sta sul Release `media` come tutte le altre: i .mp4
   non entrano nel repo. Ricucita con `pnpm loop:seamless --boomerang`, perché
   la luce deriva lungo i cinque secondi e nessuna dissolvenza faceva combaciare
   testa e coda (39,7 → 44,5 dB, riferimento 49,2). */
const COVER_VIDEO =
  'https://github.com/agargiulo-adbe/experience-design-factory/releases/download/media/isu-cover.loop.mp4';
// La copertina rende la riga del TIPO, mai una stringa a mano: se la tassonomia
// cambia, cambiano tutte le copertine insieme.
const TYPE = EXPERIENCE_TYPES.prospettiva;
---
<BaseLayout title="Su scala umana · Adobe × Intesa Sanpaolo" preloadImage={`${base.replace(/\/?$/, '/')}media/isu-cover.poster.jpg`}>
  <div class="fixed top-0 left-0 right-0 z-50">
    <IsuNavigation currentPath={currentPath} base={base} />
  </div>

  <DeckContainer wallScale nextHref={href(base, '/' + CHAPTERS[0].slug)}>

    <!-- ── Copertina ─────────────────────────────────────────────────────── -->
    <Slide id="slide-cover" bg="inverse" align="center" data-audio="loud" data-made-with="Firefly" data-made-with-for="clip">
      <LoopVideo
        slot="backdrop"
        src={COVER_VIDEO}
        poster={`${base.replace(/\/?$/, '/')}media/isu-cover.poster.jpg`}
        scrim="isu-scrim-cover"
        opacity={0.42}
      />
      <div class="isu-wrap max-w-5xl">
        <!-- `hero` al posto dell'occhiello «Adobe × Intesa Sanpaolo»: lì il
             lockup è contenuto, non chrome. La firma fissa si spegne da sola. -->
        <CoBrand variant="hero" class="mb-9" />
        <h1 class="isu-title text-[var(--ink-inverse)]">Su scala umana</h1>
        <hr class="isu-rule mx-auto" />
        <T
          as="p"
          class="isu-lead"
          it="Contenuto, dati e ascolto alla scala della Banca dei Territori."
          en="Content, data and listening at the scale of the Banca dei Territori."
        />
        <p class="isu-coverline mt-10">
          <span data-lang-it><b>{TYPE.coverLine.it}</b> · Milano · 22 ottobre 2026</span>
          <span data-lang-en><b>{TYPE.coverLine.en}</b> · Milan · 22 October 2026</span>
        </p>
      </div>
    </Slide>

    <!-- ── Il percorso ───────────────────────────────────────────────────── -->
    <Slide id="slide-percorso" bg="primary" align="center" data-made-with="Firefly" data-made-with-for="sfondo">
      <div slot="backdrop" class="isu-bg isu-bg--light" style={`--bg-src: url(${bgPercorso.src})`}></div>
      <div class="isu-wrap max-w-7xl">
        <T as="p" class="slide-eyebrow" it="Un’ora, quattro passaggi" en="One hour, four steps" />
        <T as="h2" class="isu-title mt-3 text-[var(--ink-primary)]" it="Il percorso" en="The route" />
        <hr class="isu-rule mx-auto" />
        <T
          as="p"
          class="isu-lead mb-9 mx-auto"
          it="Un’ora, e la maggior parte vorremmo passarla ad ascoltare. Queste quattro sezioni servono a tenere il filo."
          en="One hour, and we would rather spend most of it listening. These four sections are here to hold the thread."
        />
        <ol class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4 auto-rows-fr" role="list">
          {CHAPTERS.map((c) => (
            <li role="listitem" class="h-full">
              <a href={href(base, '/' + c.slug)} class="isu-road isu-left">
                <span class="isu-num">{c.num}</span>
                <T as="h3" class="isu-col-title" it={c.label.it} en={c.label.en} />
                <T as="p" class="isu-col-sub" it={c.lead.it} en={c.lead.en} />
              </a>
            </li>
          ))}
        </ol>
        <T
          as="p"
          class="isu-note mt-9 mx-auto"
          it="I fatti del primo capitolo sono pubblici e datati, con la fonte in pagina. Dove invece interpretiamo, lo diciamo. Testo redatto con assistenza di AI generativa e verificato alla fonte; sfondi generati con Adobe Firefly."
          en="The facts in the first chapter are public and dated, with the source on the page. Where we interpret instead, we say so. Text written with generative AI assistance and verified against the source; backdrops generated with Adobe Firefly."
        />
      </div>
    </Slide>

  </DeckContainer>
</BaseLayout>
