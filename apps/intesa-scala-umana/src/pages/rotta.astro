---
import BaseLayout from '../layouts/BaseLayout.astro';
import IsuNavigation from '../components/IsuNavigation.astro';
import CoBrand from '../components/CoBrand.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import T from '@edf/core/blocks/i18n/T.astro';
import { href } from '@edf/core/utils/url.js';
import { CHAPTERS, nextSlug, prevSlug } from '../data/chapters';

const SLUG = 'rotta';
const ch = CHAPTERS.find((c) => c.slug === SLUG)!;
const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;

const passi = [
  {
    n: '01',
    t: { it: 'Un tavolo di lavoro', en: 'A working session' },
    b: {
      it: 'Mezza giornata con le persone che il lavoro lo fanno: canali, contenuto, dati. Non una presentazione.',
      en: 'Half a day with the people who do the work: channels, content, data. Not a presentation.',
    },
  },
  {
    n: '02',
    t: { it: 'Due casi scelti da voi', en: 'Two cases you choose' },
    b: {
      it: 'Si guardano sui vostri processi e sui vostri vincoli, non sui nostri esempi.',
      en: 'We look at them against your processes and your constraints, not our examples.',
    },
  },
  {
    n: '03',
    t: { it: 'Una risposta netta', en: 'A clear answer' },
    b: {
      it: 'Che cosa conviene fare, che cosa no, e in che ordine. Per iscritto, entro fine anno.',
      en: 'What is worth doing, what is not, and in what order. In writing, before the year is out.',
    },
  },
];
---
<BaseLayout title={ch.label.it}>
  <div class="fixed top-0 left-0 right-0 z-50">
    <IsuNavigation currentPath={currentPath} base={base} />
  </div>

  <DeckContainer nextHref={href(base, nextSlug(SLUG))} prevHref={href(base, prevSlug(SLUG))}>

    <!-- ── Come andiamo avanti ───────────────────────────────────────────── -->
    <Slide id="slide-passi" bg="primary" align="left">
      <div class="w-full max-w-7xl">
        <T as="p" class="slide-eyebrow" it="La proposta" en="The proposal" />
        <T
          as="h2"
          class="isu-title mt-3 text-[var(--ink-primary)]"
          it="Come andiamo avanti"
          en="How we move forward"
        />
        <hr class="isu-rule" />

        <ol class="grid gap-x-6 gap-y-6 md:grid-cols-3 auto-rows-fr mb-8" role="list">
          {passi.map((p) => (
            <li role="listitem" class="flex flex-col gap-2 min-w-0 h-full">
              <span class="isu-num">{p.n}</span>
              <span class="isu-col-rule" aria-hidden="true"></span>
              <T as="h3" class="isu-col-title text-lg mt-1" it={p.t.it} en={p.t.en} />
              <T as="p" class="isu-col-sub" it={p.b.it} en={p.b.en} />
            </li>
          ))}
        </ol>

        <hr class="isu-rule" />
        <T
          as="p"
          class="isu-ask"
          it="Quello che chiediamo è poco: un referente, due casi e una data."
          en="What we are asking for is small: one contact, two cases and one date."
        />
        <T
          as="p"
          class="isu-col-sub mt-3"
          it="Il resto lo mettiamo noi."
          en="We bring the rest."
        />
      </div>
    </Slide>

    <!-- ── Firma ─────────────────────────────────────────────────────────── -->
    <!-- Slide a sé per contratto: la chiusura è già densa e il lockup grande la
         farebbe sbordare. Fondo scuro perché questa experience ha dominante
         CHIARA. Fallisce il check SOFT `i` (il lockup è un SVG e il parser non
         lo conta come massa di testo): è voluta ariosa, e non si aggiusta
         rimpicciolendo il tipo. -->
    <Slide id="slide-signature" bg="inverse" align="center">
      <CoBrand variant="hero" />
      <T
        as="p"
        class="isu-sig-line"
        it="Un referente, due casi, una data. Il resto lo mettiamo noi."
        en="One contact, two cases, one date. We bring the rest."
      />
      <a href={href(base, '/')} class="edf-sig-cta">
        <span data-lang-it>Torna all’inizio →</span><span data-lang-en>Back to the start →</span>
      </a>
    </Slide>

  </DeckContainer>
</BaseLayout>
