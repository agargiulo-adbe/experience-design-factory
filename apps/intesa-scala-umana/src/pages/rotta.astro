---
import BaseLayout from '../layouts/BaseLayout.astro';
import IsuNavigation from '../components/IsuNavigation.astro';
import CoBrand from '../components/CoBrand.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import LoopVideo from '@edf/core/blocks/immersive/LoopVideo.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import T from '@edf/core/blocks/i18n/T.astro';
import { href } from '@edf/core/utils/url.js';
import { CHAPTERS, nextSlug, prevSlug } from '../data/chapters';
import bgRotta from '../assets/generated/bg/stacco-rotta.jpg';

// La clip ricucita sta sul Release `media`, non nel repo (regola di .gitignore).
// `pnpm loop:seamless` l'ha misurata: giro da 14,8 a 30,9 dB contro un
// riferimento di 29,8 fra due fotogrammi adiacenti. Il poster è il PRIMO
// fotogramma della clip ricucita, quindi l'attacco non fa stacco.
const FIRMA_VIDEO =
  'https://github.com/agargiulo-adbe/experience-design-factory/releases/download/media/isu-firma.loop.mp4';

const SLUG = 'rotta';
const ch = CHAPTERS.find((c) => c.slug === SLUG)!;
const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;

const passi = [
  {
    n: '01',
    t: { it: 'Un tavolo di lavoro', en: 'A working session' },
    b: {
      it: 'Mezza giornata con le persone che il lavoro lo fanno: canali, contenuto, dati. Non una presentazione.',
      en: 'Half a day with the people who do the work: channels, content, data. Not a presentation.',
    },
  },
  {
    n: '02',
    t: { it: 'Due casi scelti da voi', en: 'Two cases you choose' },
    b: {
      it: 'Si guardano sui vostri processi e sui vostri vincoli, non sui nostri esempi.',
      en: 'We look at them against your processes and your constraints, not our examples.',
    },
  },
  {
    n: '03',
    t: { it: 'Una risposta netta', en: 'A clear answer' },
    b: {
      it: 'Che cosa conviene fare, che cosa no, e in che ordine. Per iscritto, entro fine anno.',
      en: 'What is worth doing, what is not, and in what order. In writing, before the year is out.',
    },
  },
];
---
<BaseLayout title={ch.label.it} preloadImage={bgRotta.src}>
  <div class="fixed top-0 left-0 right-0 z-50">
    <IsuNavigation currentPath={currentPath} base={base} />
  </div>

  <DeckContainer nextHref={href(base, nextSlug(SLUG))} prevHref={href(base, prevSlug(SLUG))}>

    <!-- ── Come andiamo avanti ───────────────────────────────────────────── -->
    <!-- Questo capitolo non ha stacco: la rotta arriva dopo quaranta minuti di
         conversazione, e una pagina di respiro in più qui allontana la
         richiesta invece di prepararla. Lo sfondo sta sulla slide stessa. -->
    <Slide id="slide-passi" bg="inverse" align="center" data-made-with="Firefly" data-made-with-for="sfondo">
      <div slot="backdrop" class="isu-bg" style={`--bg-src: url(${bgRotta.src})`}></div>
      <div class="isu-wrap max-w-7xl">
        <T as="p" class="slide-eyebrow" it="La proposta" en="The proposal" />
        <T
          as="h2"
          class="isu-title mt-3 text-[var(--ink-inverse)]"
          it="Come andiamo avanti"
          en="How we move forward"
        />
        <hr class="isu-rule mx-auto" />

        <ol class="isu-path mb-9" role="list">
          {passi.map((p) => (
            <li role="listitem" class="isu-path-step">
              <span class="isu-path-dot" aria-hidden="true"></span>
              <span class="isu-num block mb-1">{p.n}</span>
              <T as="h3" class="isu-col-title text-lg" it={p.t.it} en={p.t.en} />
              <T as="p" class="isu-col-sub mt-1.5" it={p.b.it} en={p.b.en} />
            </li>
          ))}
        </ol>

        <hr class="isu-rule mx-auto" />
        <T
          as="p"
          class="isu-ask mx-auto"
          it="Quello che chiediamo è poco: un referente, due casi e una data."
          en="What we are asking for is small: one contact, two cases and one date."
        />
        <T
          as="p"
          class="isu-col-sub mt-3 mx-auto"
          it="Il resto lo mettiamo noi."
          en="We bring the rest."
        />
      </div>
    </Slide>

    <!-- ── Firma ─────────────────────────────────────────────────────────── -->
    <!-- Slide a sé per contratto: la chiusura è già densa e il lockup grande la
         farebbe sbordare. Fondo scuro perché questa experience ha dominante
         CHIARA. Fallisce il check SOFT `i` (il lockup è un SVG e il parser non
         lo conta come massa di testo): è voluta ariosa, e non si aggiusta
         rimpicciolendo il tipo. -->
    <Slide id="slide-signature" bg="inverse" align="center" data-made-with="Firefly" data-made-with-for="clip">
      <LoopVideo
        slot="backdrop"
        src={FIRMA_VIDEO}
        poster={`${base.replace(/\/?$/, '/')}media/isu-firma.poster.jpg`}
        scrim="isu-scrim-firma"
        opacity={1}
      />
      <CoBrand variant="hero" />
      <T
        as="p"
        class="isu-sig-line"
        it="Un referente, due casi, una data. Il resto lo mettiamo noi."
        en="One contact, two cases, one date. We bring the rest."
      />
      <a href={href(base, '/')} class="edf-sig-cta">
        <span data-lang-it>Torna all’inizio →</span><span data-lang-en>Back to the start →</span>
      </a>
    </Slide>

  </DeckContainer>
</BaseLayout>
