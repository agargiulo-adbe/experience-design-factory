---
import BaseLayout from '../layouts/BaseLayout.astro';
import IsuNavigation from '../components/IsuNavigation.astro';
import IsuStack from '../components/IsuStack.astro';
import IsuPipeline from '../components/IsuPipeline.astro';
import IsuLoop from '../components/IsuLoop.astro';
import IsuJourney from '../components/IsuJourney.astro';
import IsuArbiter from '../components/IsuArbiter.astro';
import HowItWorks from '@edf/core/blocks/HowItWorks.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import ChapterPoint from '@edf/core/blocks/immersive/ChapterPoint.astro';
import T from '@edf/core/blocks/i18n/T.astro';
import { href } from '@edf/core/utils/url.js';
import { CHAPTERS, nextSlug, prevSlug } from '../data/chapters';
import { SOURCES } from '../data/sources';
import { strati as pila } from '../data/contenuti';
import bgStacco from '../assets/generated/bg/stacco-idee.jpg';
import bgInnesto from '../assets/generated/bg/dark-innesto.jpg';
import bgFiliera from '../assets/generated/bg/dark-filiera.jpg';
import bgTrovare from '../assets/generated/bg/light-trovare.jpg';
import bgViaggio from '../assets/generated/bg/dark-viaggio.jpg';
import bgProva from '../assets/generated/bg/light-prova.jpg';
import bgNumeri from '../assets/generated/bg/light-numeri.jpg';
import bgPercorsoUsi from '../assets/generated/bg/light-percorso.jpg';
import bgGestore from '../assets/generated/bg/cover-scala.jpg';

const SLUG = 'idee';
const ch = CHAPTERS.find((c) => c.slug === SLUG)!;
const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;

/**
 * IL CAPITOLO DELLE DUE IDEE, in sei slide.
 *
 * La pila dice la posizione prima delle parole: lo strato del cliente sta
 * SOTTO, pieno e col suo verde, e quelli Adobe si appoggiano sopra senza
 * coprirlo. È il disegno di «ci innestiamo, non sostituiamo» — una frase che
 * il cliente ha già sentito da tutti, e che disegnata si verifica a colpo
 * d'occhio. Da qui in poi la pila fa anche da INDICE: ogni strato porta alla
 * pagina che lo racconta per esteso.
 *
 * L'ORDINE NON È NEGOZIABILE: prima il contenuto, poi il viaggio. Il contenuto
 * è il mestiere di chi è in sala; il viaggio intero è il mestiere di chi non
 * c'è. Aprire dal secondo vuol dire parlare alla persona sbagliata del lavoro
 * di qualcun altro.
 *
 * OGNI CAPACITÀ DESCRITTA QUI HA UNA FONTE PUBBLICA IN PAGINA, con la data di
 * lettura: una slide che spiega come funziona una cosa deve poter essere
 * verificata da chi la riceve, senza passare da noi. Il dettaglio tecnico non
 * sta nella slide ma dentro «Come funziona, in concreto»: chi legge in fretta
 * non lo apre, l'IT che riceve il link sì. Lì dentro sta anche il vincolo del
 * connettore, perché un vincolo detto da noi vale molto più dello stesso
 * vincolo scoperto da loro un mese dopo.
 */
/**
 * VIA I «TEMPI», e via i prodotti.
 *
 * «Primo» e «secondo tempo» dichiaravano una sequenza che non esiste: i due
 * bisogni che il partner ha riportato il 7 ottobre sono espressamente NON
 * collegati, e numerarli prometteva un ordine di esecuzione che nessuno ha
 * deciso. L'ordine qui è solo di racconto, e si legge dall'alto.
 *
 * E in una slide di sintesi l'elenco dei prodotti non dice niente a chi
 * ascolta: dice che cosa compriamo, non che cosa cambia. Al suo posto, una
 * riga su COSA CAMBIA. I nomi dei prodotti stanno nelle slide di dettaglio,
 * dove c'è lo spazio per spiegare che cosa fanno.
 *
 * L'array va dal basso: la fondazione per prima, il componente impila al
 * contrario.
 */

/* ── Il contenuto · la filiera ─────────────────────────────────────────── */
const tappe = [
  {
    n: '01',
    t: { it: 'Assemblare', en: 'Assemble' },
    d: {
      it: 'Copy, immagine e video nascono da template che stabiliscono che cosa si modifica, che cosa si sostituisce e che cosa resta bloccato.',
      en: 'Copy, image and video come out of templates that set what can be edited, what can be swapped and what stays locked.',
    },
  },
  {
    n: '02',
    t: { it: 'Attivare', en: 'Activate' },
    d: {
      it: 'Le varianti approvate escono verso i canali già marcate: campagna, prodotto, destinatario, mercato.',
      en: 'Approved variants go out to the channels already tagged: campaign, product, audience, market.',
    },
  },
  {
    n: '03',
    t: { it: 'Ottimizzare', en: 'Optimise' },
    d: {
      it: 'Gli insight non dicono soltanto quanto ha reso una campagna. Dicono quale attributo ha reso, su quale pubblico e su quale canale.',
      en: 'Insights do not only say how a campaign performed. They say which attribute performed, with which audience and on which channel.',
    },
  },
];

/* ── Il contenuto · farsi trovare ──────────────────────────────────────── */
const giro = [
  {
    n: '01',
    t: { it: 'Le domande vere', en: 'The real questions' },
    d: {
      it: 'Si parte dalle domande che le persone fanno davvero agli assistenti: circa 300 milioni di prompt reali portati da Semrush, ordinati per intenzione, non una lista di parole chiave.',
      en: 'You start from the questions people actually ask the assistants: around 300 million real prompts brought in by Semrush, sorted by intent, not a keyword list.',
    },
  },
  {
    n: '02',
    t: { it: 'Come vi raccontano', en: 'How you are described' },
    d: {
      it: 'Quante volte il marchio viene citato su ChatGPT, Google AI Mode, Copilot e Perplexity, con che tono, accanto a chi, e come cambia nel tempo.',
      en: 'How often the brand is cited on ChatGPT, Google AI Mode, Copilot and Perplexity, in what tone, next to whom, and how that shifts over time.',
    },
  },
  {
    n: '03',
    t: { it: 'Che cosa si corregge', en: 'What gets fixed' },
    d: {
      it: 'Le correzioni suggerite si pubblicano sui template già approvati di Experience Manager Sites, senza un rilascio applicativo. Il flusso di approvazione resta il vostro.',
      en: 'Suggested fixes publish onto the already-approved Experience Manager Sites templates, with no application release. The approval flow stays yours.',
    },
  },
  {
    n: '04',
    t: { it: 'Che cosa ha prodotto', en: 'What it produced' },
    d: {
      it: 'Il traffico che arriva dalle risposte, e che cosa fa una volta sul sito, letto dentro Analytics.',
      en: 'The traffic arriving from the answers, and what it does once on the site, read inside Analytics.',
    },
  },
];

/* ── Il decisioning: l'arbitro davanti al cliente ──────────────────────
 * Le tre regole hanno un nome sulla pagina prodotto Adobe — AI ranking,
 * eligibility constraints, frequency capping — e sono tradotte, non inventate.
 * L'ordine è quello in cui agiscono: prima si ordina, poi si filtra per
 * ammissibilità, infine si mette il tetto.
 */
const sorgenti = [
  { it: 'I vostri modelli di propensione', en: 'Your own propensity models' },
  { it: 'Gli strumenti di decisioning specializzati che già usate', en: 'The specialised decisioning tools you already use' },
  { it: 'Le regole di business, anche quelle che oggi vivono in un foglio', en: 'Business rules, including the ones living in a spreadsheet today' },
];
const regole = [
  {
    t: { it: 'Ordina', en: 'Rank' },
    d: {
      it: 'Mette in fila le opzioni per probabilità che quella persona reagisca, e impara dagli esiti.',
      en: 'Ranks the options by how likely that person is to respond, and learns from the outcomes.',
    },
  },
  {
    t: { it: 'Filtra', en: 'Filter' },
    d: {
      it: 'Prima il consenso per finalità e canale e i limiti di contatto della banca, che la decisione legge e non riscrive. Poi le altre regole di ammissibilità.',
      en: 'Consent by purpose and channel first, plus the bank’s own contact limits: the decision reads them and does not rewrite them. Then the other eligibility rules.',
    },
  },
  {
    t: { it: 'Mette il tetto', en: 'Cap' },
    d: {
      it: 'Un limite di frequenza per persona e per spazio, perché la buona offerta di troppo è un’offerta persa.',
      en: 'A frequency limit per person and per placement, because one offer too many is an offer lost.',
    },
  },
];
const esito = {
  t: { it: 'Una cosa sola, nel momento giusto', en: 'One single thing, at the right moment' },
  d: {
    it: 'Non la somma di quello che ogni sistema avrebbe mandato per conto suo. Una pratica lasciata a metà sul sito il martedì, e il giovedì il cliente la ritrova dove si era fermato invece di tre messaggi diversi: l’informazione c’era già, mancava qualcuno che decidesse che cosa farne.',
    en: 'Not the sum of what every system would have sent on its own. An application left half-finished on the website on Tuesday, and on Thursday the customer picks it up where it stopped instead of getting three different messages: the information was already there, what was missing was someone deciding what to do with it.',
  },
};

/* ── La decisione che arriva al banco ──────────────────────────────────
 * Tre passi, non un diagramma nuovo: la geometria è quella della rotta
 * (`.isu-path`), che l'audit attraversa già pulita.
 *
 * PERCHÉ QUESTA SLIDE ESISTE. La Divisione ha dichiarato tre direzioni e la
 * prima è «evoluzione agentica degli strumenti a supporto della Rete». Il
 * deck, fino al 15 ottobre, parlava solo di canali digitali: un documento
 * intitolato «Su scala umana» in cui la persona che il cliente ha davanti non
 * compariva mai. Questa slide non rivendica quella direzione — la tocca nel
 * solo punto in cui possiamo dire qualcosa di verificabile.
 *
 * LA FONTE È OBBLIGATORIA QUI PIÙ CHE ALTROVE: è l'unica pagina dove Adobe
 * descrive il caso per esteso (le API della decisione che alimentano il
 * portale di chi riceve le chiamate). Senza, sarebbe una capacità raccontata
 * a parole nostre.
 */
const alBanco = [
  {
    n: '01',
    t: { it: 'La decisione esiste già', en: 'The decision already exists' },
    d: {
      it: 'Lo stesso arbitro della pagina prima, con le stesse regole.',
      en: 'The same arbiter as the page before, with the same rules.',
    },
  },
  {
    n: '02',
    t: { it: 'L’applicazione la chiede', en: 'The application asks for it' },
    d: {
      it: 'Le applicazioni di rete chiedono la decisione quando si apre la scheda, e ricevono JSON.',
      en: 'The branch applications ask for the decision as the record opens, and get JSON back.',
    },
  },
  {
    n: '03',
    t: { it: 'La persona sceglie', en: 'The person chooses' },
    d: {
      it: 'La proposta compare accanto al cliente. Decide il Gestore, non il motore.',
      en: 'The proposal appears next to the customer. The advisor decides, not the engine.',
    },
  },
];

/* ── Una persona sola · il viaggio intero ─────────────────────────────── */
const tappeViaggio = [
  { it: 'Annuncio', en: 'Ad' },
  { it: 'Sito', en: 'Website' },
  { it: 'App', en: 'App' },
  { it: 'Filiale', en: 'Branch' },
  { it: 'Servizio clienti', en: 'Customer service' },
];
/* Quello che la vista omnicanale ABILITA. L'attribuzione è il quarto, non il
   titolo: prima viene la fondazione, poi quello che ci si costruisce sopra.
   Ordinati per vicinanza al problema che loro stessi hanno dichiarato — il
   funnel commerciale che non si segue fino in fondo. */
const casiUso = [
  {
    t: { it: 'Dove si rompe', en: 'Where it breaks' },
    d: { it: 'Il punto esatto in cui la pratica si ferma, canale per canale', en: 'The exact point where the application stalls, channel by channel' },
  },
  {
    t: { it: 'Perché chiamano', en: 'Why they call' },
    d: { it: 'Le telefonate che nascono da un passaggio digitale che non ha funzionato', en: 'The calls that come from a digital step that did not work' },
  },
  {
    t: { it: 'Chi richiamare', en: 'Who to go back to' },
    d: { it: 'Gruppi di persone trovati qui e pubblicati sul profilo, pronti da usare', en: 'Groups found here and published to the profile, ready to use' },
  },
  {
    t: { it: 'Che cosa sarebbe successo comunque', en: 'What would have happened anyway' },
    d: { it: 'Un gruppo di controllo sulla stessa audience; l’attribuzione viene dopo, e ordina le leve', en: 'A control group on the same audience; attribution comes after, and ranks the levers' },
  },
];

/* ── La prova ─────────────────────────────────────────────────────────────
 * Due numeri per idea, così la referenza prova il capitolo intero e non metà.
 * Tutti e quattro stanno nella pagina pubblica del caso, alla lettera: il
 * «15 min invece di tre giorni» che stava qui prima NON ci stava, e la fonte
 * dice «de dias para minutos». Un numero che non sopravvive alla sua fonte
 * esce, non si arrotonda.
 */
const prova = [
  {
    v: '100 mln',
    l: { it: 'profili unificati', en: 'unified profiles' },
    s: { it: 'una vista sola su individui, PMI e prospect', en: 'one view covering individuals, SMEs and prospects' },
  },
  {
    v: '+600%',
    l: { it: 'conversioni', en: 'conversions' },
    s: { it: 'sulle campagne di ripresa delle richieste interrotte, attivate in 15 minuti invece che dopo tre giorni', en: 'on campaigns that pick up abandoned applications, triggered in 15 minutes instead of after three days' },
  },
  {
    v: '4.400',
    l: { it: 'asset creativi', en: 'creative assets' },
    s: { it: 'per 530 offerte al retail e 800 alle PMI', en: 'for 530 retail offers and 800 for SMEs' },
  },
  {
    v: 'minuti',
    l: { it: 'invece di giorni', en: 'instead of days' },
    s: { it: 'il tempo per portare una campagna sul mercato', en: 'the time to take a campaign to market' },
  },
];
---
<BaseLayout title={ch.label.it} preloadImage={bgStacco.src}>
  <div class="fixed top-0 left-0 right-0 z-50">
    <IsuNavigation currentPath={currentPath} base={base} />
  </div>

  <DeckContainer wallScale nextHref={href(base, nextSlug(SLUG))} prevHref={href(base, prevSlug(SLUG))}>

    <!-- ── Stacco di capitolo ────────────────────────────────────────────── -->
    <Slide id="slide-cover" bg="inverse" align="center" data-made-with="Firefly" data-made-with-for="sfondo">
      <div slot="backdrop" class="isu-bg" style={`--bg-src: url(${bgStacco.src})`}></div>
      <div class="isu-wrap max-w-4xl">
        <p class="isu-ch-n">
          <span data-lang-it>Capitolo {ch.num}</span><span data-lang-en>Chapter {ch.num}</span>
        </p>
        <T as="h2" class="isu-ch-t mt-4 mx-auto" it={ch.label.it} en={ch.label.en} />
        <hr class="isu-rule mx-auto" />
        <T
          as="p"
          class="isu-lead mx-auto"
          it="Dove ci appoggiamo su quello che avete già, e una banca che ha fatto una strada vicina."
          en="Where we build on what you already have, and a bank that walked a nearby road."
        />
      </div>
    </Slide>

    <!-- ── La pila dell'innesto, che è anche l'indice delle due idee ─────── -->
    <Slide id="slide-innesto" bg="inverse" align="center" data-made-with="Firefly" data-made-with-for="sfondo">
      <div slot="backdrop" class="isu-bg" style={`--bg-src: url(${bgInnesto.src})`}></div>
      <div class="isu-wrap max-w-5xl">
        <T as="p" class="slide-eyebrow" it="Su quello che avete già" en="On what you already have" />
        <T
          as="h2"
          class="isu-title mt-3 text-[var(--ink-inverse)]"
          it="Dove ci innestiamo"
          en="Where we plug in"
        />
        <hr class="isu-rule mx-auto" />

        <IsuStack layers={pila('lungo')} class="mb-5" />

        <T
          as="p"
          class="isu-col-sub mx-auto"
          it="La fondazione è già vostra. I tre strati sopra si aprono sulla pagina che li racconta."
          en="The foundation is already yours. The three layers above open onto the page that tells each one."
        />
      </div>
    </Slide>

    <!-- ── Il contenuto · la filiera ──────────────────────────────────────── -->
    <Slide id="slide-filiera" bg="inverse" align="center" data-made-with="Firefly" data-made-with-for="sfondo">
      <div slot="backdrop" class="isu-bg" style={`--bg-src: url(${bgFiliera.src})`}></div>
      <div class="isu-wrap max-w-6xl">
        <T
          as="p"
          class="slide-eyebrow"
          it="Produrre contenuto · come nasce una variante"
          en="Producing content · how a variant is made"
        />
        <T
          as="h2"
          class="isu-title mt-3 text-[var(--ink-inverse)]"
          it="Centinaia di versioni, una linea guida sola"
          en="Hundreds of versions, one set of guidelines"
        />
        <hr class="isu-rule mx-auto" />

        <IsuPipeline
          stops={tappe}
          back={{
            it: 'quello che ha funzionato rientra nel giro dopo',
            en: 'what worked feeds the next round',
          }}
          rail={{
            k: { it: 'Governance', en: 'Governance' },
            t: {
              it: 'Ogni variante prende un punteggio di aderenza alle linee guida e pubblica solo dopo l’approvazione di una persona. Le parti obbligatorie, avvertenze e citazioni, entrano come elementi pre-approvati e restano intatte. Richieste, scadenze e passaggi fra agenzie stanno in un posto solo, con Workfront.',
              en: 'Every variant is scored against the brand guidelines and goes live only once a person approves it. Mandatory elements, disclaimers and citations, come in pre-approved and stay untouched. Briefs, deadlines and hand-offs between agencies live in one place, with Workfront.',
            },
          }}
          class="mb-4"
        />

        <HowItWorks
          title="filiera"
          tone="onDark"
          label="Come funziona, in concreto"
          labelEn="How it actually works"
          class="isu-hiw mb-3"
        >
          <p>
            <span data-lang-it>Le linee guida, i prodotti e le persone si caricano una volta e valgono per tutto quello che si genera dopo. Il controllo gira su ogni variante e indica il punto da correggere, non un voto.</span>
            <span data-lang-en>Guidelines, products and personas are loaded once and govern everything generated afterwards. The check runs on every variant and points at what to fix, not at a score.</span>
          </p>
          <p>
            <span data-lang-it>I modelli generativi sono più d’uno, Firefly compreso, e la scelta resta vostra. Un template può uscire da Journey Optimizer o da Marketo, essere riempito qui e tornare indietro pronto da inviare: i campi personalizzati per ogni destinatario restano al loro posto.</span>
            <span data-lang-en>More than one generative model is available, Firefly included, and the choice stays yours. A template can leave Journey Optimizer or Marketo, be filled in here and go back ready to send: the fields personalised for each recipient stay where they were.</span>
          </p>
        </HowItWorks>

        <div class="isu-credits"><p class="isu-products">Experience Manager · GenStudio for Performance Marketing · Firefly · Workfront</p>
        <p class="isu-note">
          <span data-lang-it>{SOURCES.genstudioPm.label.it}</span><span data-lang-en>{SOURCES.genstudioPm.label.en}</span>
          · <a href={SOURCES.genstudioPm.url} target="_blank" rel="noopener noreferrer">{SOURCES.genstudioPm.short}</a>
        </p></div>
      </div>
    </Slide>

    <!-- ── Il contenuto · farsi trovare ───────────────────────────────────── -->
    <Slide id="slide-trovare" bg="primary" align="center" data-made-with="Firefly" data-made-with-for="sfondo">
      <div slot="backdrop" class="isu-bg isu-bg--light" style={`--bg-src: url(${bgTrovare.src})`}></div>
      <div class="isu-wrap max-w-6xl">
        <T
          as="p"
          class="slide-eyebrow"
          it="Produrre contenuto · farsi trovare dagli assistenti"
          en="Producing content · being found by the assistants"
        />
        <T
          as="h2"
          class="isu-title mt-3 text-[var(--ink-primary)]"
          it="Comparire nelle risposte, non solo nei risultati"
          en="Showing up in the answers, not only in the results"
        />
        <hr class="isu-rule mx-auto" />

        <IsuLoop
          nodes={giro}
          core={{
            v: '60%',
            t: {
              it: 'delle ricerche finisce senza un clic verso il sito',
              en: 'of searches end without a click through to the site',
            },
            src: 'Bain & Company',
          }}
          class="mb-4"
        />

        <div class="isu-pipe-rail">
          <span class="isu-pipe-rail-k">
            <svg width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false">
              <path d="M2 11.5L6 7l3 2.5L14 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M10.5 4H14v3.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            4,4×
          </span>
          <T
            as="span"
            class="isu-pipe-rail-t"
            it="converte chi arriva da una risposta generata rispetto a chi arriva dalla ricerca organica: è un confronto fra sorgenti di traffico, media fra settori, non un effetto dello strumento. Brand Visibility unisce le due metà: l’intelligenza di Semrush su come il marchio appare nelle risposte, e la correzione che si pubblica da Adobe."
            en="is how traffic arriving from a generated answer converts against traffic from organic search: a comparison between sources, averaged across industries, not an effect of the tool. Brand Visibility joins the two halves: Semrush intelligence on how the brand shows up in answers, and the fix you publish from Adobe."
          />
        </div>

        <div class="isu-credits mt-4"><p class="isu-products">Adobe Brand Visibility (Adobe + Semrush) · Experience Manager Sites · Analytics</p>
        <p class="isu-note">
          <span data-lang-it>{SOURCES.brandVisibility.label.it}</span><span data-lang-en>{SOURCES.brandVisibility.label.en}</span>
          · <a href={SOURCES.brandVisibility.url} target="_blank" rel="noopener noreferrer">{SOURCES.brandVisibility.short}</a>
        </p>
        <p class="isu-note">
          <span data-lang-it>Il 60%: {SOURCES.bain.label.it}</span><span data-lang-en>The 60%: {SOURCES.bain.label.en}</span>
          · <a href={SOURCES.bain.url} target="_blank" rel="noopener noreferrer">{SOURCES.bain.short}</a>
          · <span data-lang-it>il 4,4×: {SOURCES.semrush.label.it}</span><span data-lang-en>the 4.4×: {SOURCES.semrush.label.en}</span>
          · <a href={SOURCES.semrush.url} target="_blank" rel="noopener noreferrer">{SOURCES.semrush.short}</a>
        </p></div>
      </div>
    </Slide>

    <!-- ── L'arbitro: il decisioning davanti al cliente ─────────────────── -->
    <!-- Idea arrivata DA LORO tramite il partner, non proposta da noi: per
         questo apre dichiarando di non toccare quello che c'è. Se la slide
         facesse pensare «vogliono rifarci i modelli», avrebbe già perso. -->
    <Slide id="slide-decisioning" bg="primary" align="center" data-made-with="Firefly" data-made-with-for="sfondo">
      <div slot="backdrop" class="isu-bg isu-bg--light isu-bg--veil" style={`--bg-src: url(${bgNumeri.src})`}></div>
      <div class="isu-wrap max-w-7xl">
        <T
          as="p"
          class="slide-eyebrow"
          it="Decidere che cosa arriva · l’ultimo strato"
          en="Deciding what reaches whom · the last layer"
        />
        <T
          as="h2"
          class="isu-title mt-3 text-[var(--ink-primary)]"
          it="Molti decidono, al cliente arriva una cosa sola"
          en="Many decide, one thing reaches the customer"
        />
        <hr class="isu-rule mx-auto" />

        <IsuArbiter sources={sorgenti} rules={regole} out={esito} class="mb-5" />

