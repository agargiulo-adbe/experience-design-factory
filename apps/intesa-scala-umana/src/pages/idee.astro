---
import BaseLayout from '../layouts/BaseLayout.astro';
import IsuNavigation from '../components/IsuNavigation.astro';
import IsuStack from '../components/IsuStack.astro';
import IsuPipeline from '../components/IsuPipeline.astro';
import IsuLoop from '../components/IsuLoop.astro';
import IsuJourney from '../components/IsuJourney.astro';
import IsuArbiter from '../components/IsuArbiter.astro';
import HowItWorks from '@edf/core/blocks/HowItWorks.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import T from '@edf/core/blocks/i18n/T.astro';
import { href } from '@edf/core/utils/url.js';
import { CHAPTERS, nextSlug, prevSlug } from '../data/chapters';
import { SOURCES } from '../data/sources';
import bgStacco from '../assets/generated/bg/stacco-idee.jpg';
import bgInnesto from '../assets/generated/bg/dark-innesto.jpg';
import bgFiliera from '../assets/generated/bg/dark-filiera.jpg';
import bgTrovare from '../assets/generated/bg/light-trovare.jpg';
import bgViaggio from '../assets/generated/bg/dark-viaggio.jpg';
import bgProva from '../assets/generated/bg/light-prova.jpg';
import bgNumeri from '../assets/generated/bg/light-numeri.jpg';
import bgPercorsoUsi from '../assets/generated/bg/light-percorso.jpg';

const SLUG = 'idee';
const ch = CHAPTERS.find((c) => c.slug === SLUG)!;
const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;

/**
 * IL CAPITOLO DELLE DUE IDEE, in sei slide.
 *
 * La pila dice la posizione prima delle parole: lo strato del cliente sta
 * SOTTO, pieno e col suo verde, e quelli Adobe si appoggiano sopra senza
 * coprirlo. È il disegno di «ci innestiamo, non sostituiamo» — una frase che
 * il cliente ha già sentito da tutti, e che disegnata si verifica a colpo
 * d'occhio. Da qui in poi la pila fa anche da INDICE: ogni strato porta alla
 * pagina che lo racconta per esteso.
 *
 * L'ORDINE NON È NEGOZIABILE: prima il contenuto, poi il viaggio. Il contenuto
 * è il mestiere di chi è in sala; il viaggio intero è il mestiere di chi non
 * c'è. Aprire dal secondo vuol dire parlare alla persona sbagliata del lavoro
 * di qualcun altro.
 *
 * OGNI CAPACITÀ DESCRITTA QUI HA UNA FONTE PUBBLICA IN PAGINA, con la data di
 * lettura: una slide che spiega come funziona una cosa deve poter essere
 * verificata da chi la riceve, senza passare da noi. Il dettaglio tecnico non
 * sta nella slide ma dentro «Come funziona, in concreto»: chi legge in fretta
 * non lo apre, l'IT che riceve il link sì. Lì dentro sta anche il vincolo del
 * connettore, perché un vincolo detto da noi vale molto più dello stesso
 * vincolo scoperto da loro un mese dopo.
 */
/**
 * VIA I «TEMPI», e via i prodotti.
 *
 * «Primo» e «secondo tempo» dichiaravano una sequenza che non esiste: i due
 * bisogni che il partner ha riportato il 7 ottobre sono espressamente NON
 * collegati, e numerarli prometteva un ordine di esecuzione che nessuno ha
 * deciso. L'ordine qui è solo di racconto, e si legge dall'alto.
 *
 * E in una slide di sintesi l'elenco dei prodotti non dice niente a chi
 * ascolta: dice che cosa compriamo, non che cosa cambia. Al suo posto, una
 * riga su COSA CAMBIA. I nomi dei prodotti stanno nelle slide di dettaglio,
 * dove c'è lo spazio per spiegare che cosa fanno.
 *
 * L'array va dal basso: la fondazione per prima, il componente impila al
 * contrario.
 */
const strati = [
  {
    kind: 'base' as const,
    t: { it: 'Quello che avete già', en: 'What you already have' },
    s: {
      it: 'Experience Manager, Forms e Analytics, dentro la banca, sulla rotta verso il cloud',
      en: 'Experience Manager, Forms and Analytics, inside the bank, heading for the cloud',
    },
  },
  {
    kind: 'add' as const,
    t: { it: 'Vedere il cliente intero, non il canale', en: 'Seeing the whole customer, not the channel' },
    s: {
      it: 'Dal contare le visite su un canale al seguire la stessa persona dal primo annuncio alla firma: da lì in poi si misura dove si perde, e quanto ha pesato ogni passaggio',
      en: 'From counting visits on one channel to following the same person from the first ad to signature: from there you can measure where it breaks, and what each step was worth',
    },
    href: '#slide-viaggio',
  },
  {
    kind: 'add' as const,
    t: { it: 'Decidere che cosa arriva, a chi', en: 'Deciding what reaches whom' },
    s: {
      it: 'Un solo arbitro davanti al cliente: prende i punteggi dai modelli che avete già e sceglie cosa esce, su che canale e quanto spesso — senza rifare nulla di quello che c’è',
      en: 'One arbiter in front of the customer: it takes the scores from the models you already have and picks what goes out, on which channel and how often — without redoing any of it',
    },
    href: '#slide-decisioning',
  },
  {
    kind: 'add' as const,
    t: { it: 'Produrre contenuto alla scala della banca', en: 'Producing content at the scale of the bank' },
    s: {
      it: 'Centinaia di offerte e decine di mercati senza moltiplicare le mani che le scrivono, con le parti obbligatorie che restano intatte e una persona che approva',
      en: 'Hundreds of offers and dozens of markets without multiplying the hands that write them, with mandatory wording left intact and a person who approves',
    },
    href: '#slide-filiera',
  },
];

/* ── Primo tempo · la filiera ─────────────────────────────────────────── */
const tappe = [
  {
    n: '01',
    t: { it: 'Assemblare', en: 'Assemble' },
    d: {
      it: 'Copy, immagine e video nascono da template che stabiliscono che cosa si modifica, che cosa si sostituisce e che cosa resta bloccato.',
      en: 'Copy, image and video come out of templates that set what can be edited, what can be swapped and what stays locked.',
    },
  },
  {
    n: '02',
    t: { it: 'Attivare', en: 'Activate' },
    d: {
      it: 'Le varianti approvate escono verso i canali già marcate: campagna, prodotto, destinatario, mercato.',
      en: 'Approved variants go out to the channels already tagged: campaign, product, audience, market.',
    },
  },
  {
    n: '03',
    t: { it: 'Ottimizzare', en: 'Optimise' },
    d: {
      it: 'Gli insight non dicono soltanto quanto ha reso una campagna. Dicono quale attributo ha reso, su quale pubblico e su quale canale.',
      en: 'Insights do not only say how a campaign performed. They say which attribute performed, with which audience and on which channel.',
    },
  },
];

/* ── Primo tempo · farsi trovare ──────────────────────────────────────── */
const giro = [
  {
    n: '01',
    t: { it: 'Le domande vere', en: 'The real questions' },
    d: {
      it: 'Si parte dalle domande che le persone fanno davvero agli assistenti, ordinate per intenzione, non da una lista di parole chiave.',
      en: 'You start from the questions people actually ask the assistants, sorted by intent, not from a keyword list.',
    },
  },
  {
    n: '02',
    t: { it: 'Come vi raccontano', en: 'How you are described' },
    d: {
      it: 'Quante volte il marchio viene citato, con che tono, accanto a chi, e come cambia nel tempo.',
      en: 'How often the brand is cited, in what tone, next to whom, and how that shifts over time.',
    },
  },
  {
    n: '03',
    t: { it: 'Che cosa si corregge', en: 'What gets fixed' },
    d: {
      it: 'Le correzioni suggerite si pubblicano su Experience Manager Sites senza aprire un progetto con l’IT.',
      en: 'Suggested fixes publish straight to Experience Manager Sites without opening an IT project.',
    },
  },
  {
    n: '04',
    t: { it: 'Che cosa ha prodotto', en: 'What it produced' },
    d: {
      it: 'Il traffico che arriva dalle risposte, e che cosa fa una volta sul sito, letto dentro Analytics.',
      en: 'The traffic arriving from the answers, and what it does once on the site, read inside Analytics.',
    },
  },
];

/* ── Il decisioning: l'arbitro davanti al cliente ──────────────────────
 * Le tre regole hanno un nome sulla pagina prodotto Adobe — AI ranking,
 * eligibility constraints, frequency capping — e sono tradotte, non inventate.
 * L'ordine è quello in cui agiscono: prima si ordina, poi si filtra per
 * ammissibilità, infine si mette il tetto.
 */
const sorgenti = [
  { it: 'I vostri modelli di propensione', en: 'Your own propensity models' },
  { it: 'Gli strumenti di decisioning specializzati che già usate', en: 'The specialised decisioning tools you already use' },
  { it: 'Le regole di business, anche quelle che oggi vivono in un foglio', en: 'Business rules, including the ones living in a spreadsheet today' },
];
const regole = [
  {
    t: { it: 'Ordina', en: 'Rank' },
    d: {
      it: 'Mette in fila le opzioni per probabilità che quella persona reagisca, e impara dagli esiti.',
      en: 'Ranks the options by how likely that person is to respond, and learns from the outcomes.',
    },
  },
  {
    t: { it: 'Filtra', en: 'Filter' },
    d: {
      it: 'Regole di ammissibilità: che cosa può essere mostrato a chi, e in quale momento.',
      en: 'Eligibility rules: what can be shown to whom, and when.',
    },
  },
  {
    t: { it: 'Mette il tetto', en: 'Cap' },
    d: {
      it: 'Un limite di frequenza per persona e per spazio, perché la buona offerta di troppo è un’offerta persa.',
      en: 'A frequency limit per person and per placement, because one offer too many is an offer lost.',
    },
  },
];
const esito = {
  t: { it: 'Una cosa sola, nel momento giusto', en: 'One single thing, at the right moment' },
  d: {
    it: 'Non la somma di quello che ogni sistema avrebbe mandato per conto suo. Un pagamento rifiutato al POS, e nello stesso minuto in app arriva la proposta giusta per quella persona: l’informazione c’era già, mancava qualcuno che decidesse di usarla subito.',
    en: 'Not the sum of what every system would have sent on its own. A card declined at the till, and in the same minute the right proposal appears in the app: the information was already there, what was missing was someone deciding to use it straight away.',
  },
};

/* ── Secondo tempo · il viaggio intero ────────────────────────────────── */
const tappeViaggio = [
  { it: 'Annuncio', en: 'Ad' },
  { it: 'Sito', en: 'Website' },
  { it: 'App', en: 'App' },
  { it: 'Filiale', en: 'Branch' },
  { it: 'Servizio clienti', en: 'Customer service' },
];
/* Quello che la vista omnicanale ABILITA. L'attribuzione è il quarto, non il
   titolo: prima viene la fondazione, poi quello che ci si costruisce sopra.
   Ordinati per vicinanza al problema che loro stessi hanno dichiarato — il
   funnel commerciale che non si segue fino in fondo. */
const casiUso = [
  {
    t: { it: 'Dove si rompe', en: 'Where it breaks' },
    d: { it: 'Il punto esatto in cui la pratica si ferma, canale per canale', en: 'The exact point where the application stalls, channel by channel' },
  },
  {
    t: { it: 'Perché chiamano', en: 'Why they call' },
    d: { it: 'Le telefonate che nascono da un passaggio digitale che non ha funzionato', en: 'The calls that come from a digital step that did not work' },
  },
  {
    t: { it: 'Chi richiamare', en: 'Who to go back to' },
    d: { it: 'Gruppi di persone trovati qui e pubblicati sul profilo, pronti da usare', en: 'Groups found here and published to the profile, ready to use' },
  },
  {
    t: { it: 'Che cosa ha pesato', en: 'What counted' },
    d: { it: 'L’attribuzione: uno dei casi, non il titolo', en: 'Attribution: one of the cases, not the headline' },
  },
];

const letture = [
  { k: { it: 'Primo tocco', en: 'First touch' }, w: [100, 0, 0, 0, 0] },
  { k: { it: 'Algoritmico', en: 'Algorithmic' }, w: [42, 26, 16, 34, 12] },
];

/* ── La prova ─────────────────────────────────────────────────────────────
 * Due numeri per idea, così la referenza prova il capitolo intero e non metà.
 * Tutti e quattro stanno nella pagina pubblica del caso, alla lettera: il
 * «15 min invece di tre giorni» che stava qui prima NON ci stava, e la fonte
 * dice «de dias para minutos». Un numero che non sopravvive alla sua fonte
 * esce, non si arrotonda.
 */
const prova = [
  {
    v: '100 mln',
    l: { it: 'profili unificati', en: 'unified profiles' },
    s: { it: 'una vista sola su individui, PMI e prospect', en: 'one view covering individuals, SMEs and prospects' },
  },
  {
    v: '+600%',
    l: { it: 'conversioni', en: 'conversions' },
    s: { it: 'sulle campagne di recupero del carrello', en: 'on cart recovery campaigns' },
  },
  {
    v: '4.400',
    l: { it: 'asset creativi', en: 'creative assets' },
    s: { it: 'per 530 offerte al retail e 800 alle PMI', en: 'for 530 retail offers and 800 for SMEs' },
  },
  {
    v: 'minuti',
    l: { it: 'invece di giorni', en: 'instead of days' },
    s: { it: 'il tempo per portare una campagna sul mercato', en: 'the time to take a campaign to market' },
  },
];
---
<BaseLayout title={ch.label.it} preloadImage={bgStacco.src}>
  <div class="fixed top-0 left-0 right-0 z-50">
    <IsuNavigation currentPath={currentPath} base={base} />
  </div>

  <DeckContainer wallScale nextHref={href(base, nextSlug(SLUG))} prevHref={href(base, prevSlug(SLUG))}>

    <!-- ── Stacco di capitolo ────────────────────────────────────────────── -->
    <Slide id="slide-cover" bg="inverse" align="center" data-made-with="Firefly" data-made-with-for="sfondo">
      <div slot="backdrop" class="isu-bg" style={`--bg-src: url(${bgStacco.src})`}></div>
      <div class="isu-wrap max-w-4xl">
        <p class="isu-ch-n">
          <span data-lang-it>Capitolo {ch.num}</span><span data-lang-en>Chapter {ch.num}</span>
        </p>
        <T as="h2" class="isu-ch-t mt-4 mx-auto" it={ch.label.it} en={ch.label.en} />
        <hr class="isu-rule mx-auto" />
        <T
          as="p"
          class="isu-lead mx-auto"
          it="Dove ci appoggiamo su quello che avete già, e una banca che ha fatto la stessa strada."
          en="Where we build on what you already have, and a bank that walked the same road."
        />
      </div>
    </Slide>

    <!-- ── La pila dell'innesto, che è anche l'indice delle due idee ─────── -->
    <Slide id="slide-innesto" bg="inverse" align="center" data-made-with="Firefly" data-made-with-for="sfondo">
      <div slot="backdrop" class="isu-bg" style={`--bg-src: url(${bgInnesto.src})`}></div>
      <div class="isu-wrap max-w-5xl">
        <T as="p" class="slide-eyebrow" it="Su quello che avete già" en="On what you already have" />
        <T
          as="h2"
          class="isu-title mt-3 text-[var(--ink-inverse)]"
          it="Dove ci innestiamo"
          en="Where we plug in"
        />
        <hr class="isu-rule mx-auto" />

        <IsuStack layers={strati} class="mb-5" />

        <T
          as="p"
          class="isu-col-sub mx-auto"
          it="La fondazione è già vostra. I tre strati sopra si aprono sulla pagina che li racconta."
          en="The foundation is already yours. The three layers above open onto the page that tells each one."
        />
      </div>
    </Slide>

    <!-- ── Primo tempo · la filiera ──────────────────────────────────────── -->
    <Slide id="slide-filiera" bg="inverse" align="center" data-made-with="Firefly" data-made-with-for="sfondo">
      <div slot="backdrop" class="isu-bg" style={`--bg-src: url(${bgFiliera.src})`}></div>
      <div class="isu-wrap max-w-6xl">
        <T
          as="p"
          class="slide-eyebrow"
          it="Primo tempo · il contenuto alla scala della banca"
          en="First half · content at the scale of the bank"
        />
        <T
          as="h2"
          class="isu-title mt-3 text-[var(--ink-inverse)]"
          it="Centinaia di versioni, una linea guida sola"
          en="Hundreds of versions, one set of guidelines"
        />
        <hr class="isu-rule mx-auto" />

        <IsuPipeline
          stops={tappe}
          back={{
            it: 'quello che ha funzionato rientra nel giro dopo',
            en: 'what worked feeds the next round',
          }}
          rail={{
            k: { it: 'Governance', en: 'Governance' },
            t: {
              it: 'Ogni variante prende un punteggio di aderenza alle linee guida e pubblica solo dopo l’approvazione di una persona. Le parti obbligatorie, avvertenze e citazioni, entrano come elementi pre-approvati e restano intatte.',
              en: 'Every variant is scored against the brand guidelines and goes live only once a person approves it. Mandatory elements, disclaimers and citations, come in pre-approved and stay untouched.',
            },
          }}
          class="mb-4"
        />

        <HowItWorks
          title="filiera"
          tone="onDark"
          label="Come funziona, in concreto"
          class="isu-hiw mb-3"
        >
          <p>
            <span data-lang-it>Le linee guida, i prodotti e le persone si caricano una volta e valgono per tutto quello che si genera dopo. Il controllo gira su ogni variante e indica il punto da correggere, non un voto.</span>
            <span data-lang-en>Guidelines, products and personas are loaded once and govern everything generated afterwards. The check runs on every variant and points at what to fix, not at a score.</span>
          </p>
          <p>
            <span data-lang-it>I modelli generativi sono più d’uno, Firefly compreso, e la scelta resta vostra. I template arrivano da Journey Optimizer o da Marketo e ci tornano con il codice di personalizzazione intatto.</span>
            <span data-lang-en>More than one generative model is available, Firefly included, and the choice stays yours. Templates come in from Journey Optimizer or Marketo and go back with their personalisation code intact.</span>
          </p>
        </HowItWorks>

        <div class="isu-credits"><p class="isu-products">Experience Manager · GenStudio for Performance Marketing · Firefly</p>
        <p class="isu-note">
          <span data-lang-it>{SOURCES.genstudioPm.label.it}</span><span data-lang-en>{SOURCES.genstudioPm.label.en}</span>
          · <a href={SOURCES.genstudioPm.url} target="_blank" rel="noopener noreferrer">{SOURCES.genstudioPm.short}</a>
        </p></div>
      </div>
    </Slide>

    <!-- ── Primo tempo · farsi trovare ───────────────────────────────────── -->
    <Slide id="slide-trovare" bg="primary" align="center" data-made-with="Firefly" data-made-with-for="sfondo">
      <div slot="backdrop" class="isu-bg isu-bg--light" style={`--bg-src: url(${bgTrovare.src})`}></div>
      <div class="isu-wrap max-w-6xl">
        <T
          as="p"
          class="slide-eyebrow"
          it="Primo tempo · la stessa filiera, dall’altra parte"
          en="First half · the same pipeline, from the other end"
        />
        <T
          as="h2"
          class="isu-title mt-3 text-[var(--ink-primary)]"
          it="Comparire nelle risposte, non solo nei risultati"
          en="Showing up in the answers, not only in the results"
        />
        <hr class="isu-rule mx-auto" />

        <IsuLoop
          nodes={giro}
          core={{
            v: '60%',
            t: {
              it: 'delle ricerche finisce senza un clic verso il sito',
              en: 'of searches end without a click through to the site',
            },
            src: 'Bain & Company',
          }}
          class="mb-4"
        />

        <div class="isu-pipe-rail">
          <span class="isu-pipe-rail-k">
            <svg width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false">
              <path d="M2 11.5L6 7l3 2.5L14 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M10.5 4H14v3.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            4,4×
          </span>
          <T
            as="span"
            class="isu-pipe-rail-t"
            it="è quanto converte in più chi arriva da una risposta generata, rispetto al traffico da ricerca organica. Brand Visibility unisce le due metà: l’intelligenza di Semrush su come il marchio appare nelle risposte, e la correzione che si pubblica da Adobe."
            en="is how much better traffic arriving from a generated answer converts, compared with organic search. Brand Visibility joins the two halves: Semrush intelligence on how the brand shows up in answers, and the fix you publish from Adobe."
          />
        </div>

        <div class="isu-credits mt-4"><p class="isu-products">Adobe Brand Visibility (Adobe + Semrush) · Experience Manager Sites · Analytics</p>
        <p class="isu-note">
          <span data-lang-it>{SOURCES.brandVisibility.label.it}</span><span data-lang-en>{SOURCES.brandVisibility.label.en}</span>
          · <a href={SOURCES.brandVisibility.url} target="_blank" rel="noopener noreferrer">{SOURCES.brandVisibility.short}</a>
        </p></div>
      </div>
    </Slide>

    <!-- ── L'arbitro: il decisioning davanti al cliente ─────────────────── -->
    <!-- Idea arrivata DA LORO tramite il partner, non proposta da noi: per
         questo apre dichiarando di non toccare quello che c'è. Se la slide
         facesse pensare «vogliono rifarci i modelli», avrebbe già perso. -->
    <Slide id="slide-decisioning" bg="primary" align="center" data-made-with="Firefly" data-made-with-for="sfondo">
      <div slot="backdrop" class="isu-bg isu-bg--light isu-bg--veil" style={`--bg-src: url(${bgNumeri.src})`}></div>
      <div class="isu-wrap max-w-7xl">
        <T
          as="p"
          class="slide-eyebrow"
          it="L’ultimo strato, quello davanti al cliente"
          en="The last layer, the one in front of the customer"
        />
        <T
          as="h2"
          class="isu-title mt-3 text-[var(--ink-primary)]"
          it="Molti decidono, al cliente arriva una cosa sola"
          en="Many decide, one thing reaches the customer"
        />
        <hr class="isu-rule mx-auto" />

        <IsuArbiter sources={sorgenti} rules={regole} out={esito} class="mb-5" />

        {/* Il vincolo sta IN CHIARO, non dentro una disclosure: su questa
            slide il pannello aperto sforava la safe-area a 1440 e 1280, e fra
            nascondere il vincolo e nasconderlo dietro un clic si sceglie di
            dirlo. Una riga si legge sempre; un pannello si legge se qualcuno
            lo apre. */}
        <T
          as="p"
          class="isu-note mt-3 mx-auto"
          it="Il punto aperto, detto subito: la decisione legge il profilo dove il profilo vive. Se la base dati sta altrove la strada esiste, ma va verificata su un’architettura vera — ed è la prima cosa da mettere su un tavolo tecnico, non l’ultima."
          en="The open point, up front: the decision reads the profile where the profile lives. If the data foundation sits elsewhere there is a route, but it must be checked against a real architecture — and that is the first thing for a technical session, not the last."
        />

        <div class="isu-credits"><p class="isu-products">AI decisioning · Journey Optimizer</p>
        <p class="isu-note">
          <span data-lang-it>{SOURCES.aiDecisioning.label.it}</span><span data-lang-en>{SOURCES.aiDecisioning.label.en}</span>
          · <a href={SOURCES.aiDecisioning.url} target="_blank" rel="noopener noreferrer">{SOURCES.aiDecisioning.short}</a>
        </p></div>
      </div>
    </Slide>

    <!-- ── Secondo tempo · il viaggio intero ─────────────────────────────── -->
    <Slide id="slide-viaggio" bg="inverse" align="center" data-made-with="Firefly" data-made-with-for="sfondo">
      <div slot="backdrop" class="isu-bg" style={`--bg-src: url(${bgViaggio.src})`}></div>
      <div class="isu-wrap max-w-6xl">
        <T
          as="p"
          class="slide-eyebrow"
          it="La fondazione, e quello che ci si costruisce sopra"
          en="The foundation, and what gets built on it"
        />
        <T
          as="h2"
          class="isu-title mt-3 text-[var(--ink-inverse)]"
          it="Lo stesso cliente, visto su tutti i canali"
          en="The same customer, seen across every channel"
        />
        <hr class="isu-rule mx-auto" />

        <IsuJourney
          stops={tappeViaggio}
          readings={letture}
          cap={{
            it: 'Il filo in alto è la fondazione: lo stesso cliente riconosciuto su tutte le tappe. Le due righe sotto sono uno dei suoi usi — proporzioni di esempio — e mostrano che il modello si applica quando il dato si legge, non quando si raccoglie: vale anche sul passato.',
            en: 'The thread above is the foundation: the same customer recognised at every step. The two rows below are one of its uses — illustrative proportions — and show that the model applies when the data is read, not when it is collected: it holds for the past too.',
          }}
          class="mb-4"
        />

        <HowItWorks
          title="viaggio"
          tone="onDark"
          label="Come funziona, in concreto"
          class="isu-hiw mt-4 mb-3"
        >
          <p>
            <span data-lang-it><b>Analytics resta acceso.</b> Customer Journey Analytics legge dati che stanno su Experience Platform; lo storico di Adobe Analytics ci arriva con il connettore dedicato, Analysis Workspace resta lo strumento di chi lo usa già, e i due ambienti convivono finché serve il confronto.</span>
            <span data-lang-en><b>Analytics stays on.</b> Customer Journey Analytics reads data on Experience Platform; the Adobe Analytics history arrives through the dedicated connector, Analysis Workspace stays the tool your people know, and the two run side by side as long as the comparison needs.</span>
          </p>
          <p>
            <span data-lang-it><b>Da sapere prima:</b> il connettore da solo non è la strada di lungo periodo: latenza, schema legato alla nomenclatura di Analytics, dati che restano dentro l’analisi invece di essere disponibili alle altre applicazioni. Il percorso consigliato da Adobe è lo storico via connettore insieme a una raccolta nuova, pianificata.</span>
            <span data-lang-en><b>Worth knowing first:</b> the connector on its own is not the long-term route: latency, a schema tied to Analytics nomenclature, data that stays inside the analysis instead of reaching the other applications. The route Adobe recommends is history through the connector alongside a new, planned collection.</span>
          </p>
          <p>
            <span data-lang-it><b>Una porta che resta aperta.</b> Dalla stessa fondazione si arriva anche a come ripartire la spesa fra i canali, mettendo insieme la lettura evento per evento e quella aggregata nel tempo (Marketing Campaign Analytics). Non la proponiamo qui: è una decisione di chi possiede il budget media, e prima vorremmo sapere da voi se quel tavolo è vostro o di qualcun altro.</span>
            <span data-lang-en><b>A door left open.</b> The same foundation also leads to how spend is split across channels, combining the event-level and the aggregated-over-time readings (Marketing Campaign Analytics). We are not proposing it here: it is a decision for whoever owns the media budget, and we would rather ask you first whether that table is yours or someone else’s.</span>
          </p>
        </HowItWorks>

        <div class="isu-credits"><p class="isu-products">Customer Journey Analytics · Experience Platform</p>
        <p class="isu-note">
          <span data-lang-it>{SOURCES.cjaUpgrade.label.it}</span><span data-lang-en>{SOURCES.cjaUpgrade.label.en}</span>
          · <a href={SOURCES.cjaUpgrade.url} target="_blank" rel="noopener noreferrer">{SOURCES.cjaUpgrade.short}</a>
        </p></div>
      </div>
    </Slide>

    <!-- ── Che cosa ci si costruisce sopra ───────────────────────────────── -->
    <!-- Erano quattro blocchi in coda alla slide del viaggio, che a 1280 non
         ci stavano. Divisa, non compressa: il contratto dice di tagliare la
         copia e poi di dividere, mai di rimpicciolire il tipo. -->
    <Slide id="slide-usi" bg="secondary" align="center" data-made-with="Firefly" data-made-with-for="sfondo">
      <div slot="backdrop" class="isu-bg isu-bg--light isu-bg--veil" style={`--bg-src: url(${bgPercorsoUsi.src})`}></div>
      <div class="isu-wrap max-w-7xl">
        <T
          as="p"
          class="slide-eyebrow"
          it="Una volta che il filo c’è"
          en="Once the thread is there"
        />
        <T
          as="h2"
          class="isu-title mt-3 text-[var(--ink-primary)]"
          it="Quattro domande che prima non avevano risposta"
          en="Four questions that had no answer before"
        />
        <hr class="isu-rule mx-auto" />

        <ul class="isu-uses mb-6" role="list">
          {casiUso.map((u) => (
            <li role="listitem">
              <T as="h3" class="isu-uses-t" it={u.t.it} en={u.t.en} />
              <T as="p" class="isu-uses-d" it={u.d.it} en={u.d.en} />
            </li>
          ))}
        </ul>

        <T
          as="p"
          class="isu-lead mx-auto"
          it="Nessuna delle quattro richiede un progetto a sé: richiedono la stessa fondazione. È per questo che l’ordine conta — prima si vede il cliente intero, poi si sceglie da dove cominciare."
          en="None of the four needs a project of its own: they all need the same foundation. That is why the order matters — first you see the whole customer, then you choose where to start."
        />
      </div>
    </Slide>

    <!-- ── Una banca che l'ha fatto ──────────────────────────────────────── -->
    <Slide id="slide-prova" bg="primary" align="center" data-made-with="Firefly" data-made-with-for="sfondo">
      <div slot="backdrop" class="isu-bg isu-bg--light" style={`--bg-src: url(${bgProva.src})`}></div>
      <div class="isu-wrap max-w-7xl">
        <T
          as="p"
          class="slide-eyebrow"
          it="Santander Brasil · 68 milioni di clienti"
          en="Santander Brasil · 68 million customers"
        />
        <T
          as="h2"
          class="isu-title mt-3 text-[var(--ink-primary)]"
          it="Una banca che l’ha fatto"
          en="A bank that has done it"
        />
        <hr class="isu-rule mx-auto" />

        <ul class="grid gap-x-6 gap-y-7 sm:grid-cols-2 lg:grid-cols-4 auto-rows-fr mb-7 w-full" role="list">
          {prova.map((p) => (
            <li role="listitem" class="flex flex-col items-center gap-1.5 min-w-0 h-full" data-display>
              <span class="isu-col-rule" aria-hidden="true"></span>
              <p class="isu-metric mt-2 break-words">{p.v}</p>
              <T as="h3" class="isu-col-title" it={p.l.it} en={p.l.en} />
              <T as="p" class="isu-col-sub" it={p.s.it} en={p.s.en} />
            </li>
          ))}
        </ul>

        <p class="isu-products mx-auto">
          Experience Platform · Real-Time CDP · Journey Optimizer · Customer Journey Analytics · Experience Manager · Target · Workfront
        </p>
        <p class="isu-note mt-3 mx-auto">
          <span data-lang-it>{SOURCES.santander.label.it}</span><span data-lang-en>{SOURCES.santander.label.en}</span>
          · <a href={SOURCES.santander.url} target="_blank" rel="noopener noreferrer">{SOURCES.santander.short}</a>
        </p>
      </div>
    </Slide>

  </DeckContainer>
</BaseLayout>
