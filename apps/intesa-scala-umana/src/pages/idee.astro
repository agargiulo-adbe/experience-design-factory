---
import BaseLayout from '../layouts/BaseLayout.astro';
import IsuNavigation from '../components/IsuNavigation.astro';
import IsuStack from '../components/IsuStack.astro';
import IsuPipeline from '../components/IsuPipeline.astro';
import IsuLoop from '../components/IsuLoop.astro';
import IsuJourney from '../components/IsuJourney.astro';
import IsuArbiter from '../components/IsuArbiter.astro';
import HowItWorks from '@edf/core/blocks/HowItWorks.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import T from '@edf/core/blocks/i18n/T.astro';
import { href } from '@edf/core/utils/url.js';
import { CHAPTERS, nextSlug, prevSlug } from '../data/chapters';
import IsuFonte from '../components/IsuFonte.astro';
import { strati as pila } from '../data/contenuti';
import bgStacco from '../assets/generated/bg/stacco-idee.jpg';
import bgInnesto from '../assets/generated/bg/dark-innesto.jpg';
import bgFiliera from '../assets/generated/bg/dark-filiera.jpg';
import bgTrovare from '../assets/generated/bg/light-trovare.jpg';
import bgViaggio from '../assets/generated/bg/dark-viaggio.jpg';
import bgProva from '../assets/generated/bg/light-prova.jpg';
import bgNumeri from '../assets/generated/bg/light-numeri.jpg';
import bgPercorsoUsi from '../assets/generated/bg/light-percorso.jpg';

const SLUG = 'idee';
const ch = CHAPTERS.find((c) => c.slug === SLUG)!;
const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;

/**
 * IL CAPITOLO DELLE DUE IDEE, in sei slide.
 *
 * La pila dice la posizione prima delle parole: lo strato del cliente sta
 * SOTTO, pieno e col suo verde, e quelli Adobe si appoggiano sopra senza
 * coprirlo. È il disegno di «ci innestiamo, non sostituiamo» — una frase che
 * il cliente ha già sentito da tutti, e che disegnata si verifica a colpo
 * d'occhio. Da qui in poi la pila fa anche da INDICE: ogni strato porta alla
 * pagina che lo racconta per esteso.
 *
 * L'ORDINE NON È NEGOZIABILE: prima il contenuto, poi il viaggio. Il contenuto
 * è il mestiere di chi è in sala; il viaggio intero è il mestiere di chi non
 * c'è. Aprire dal secondo vuol dire parlare alla persona sbagliata del lavoro
 * di qualcun altro.
 *
 * OGNI CAPACITÀ DESCRITTA QUI HA UNA FONTE PUBBLICA IN PAGINA, con la data di
 * lettura: una slide che spiega come funziona una cosa deve poter essere
 * verificata da chi la riceve, senza passare da noi. Il dettaglio tecnico non
 * sta nella slide ma dentro «Come funziona, in concreto»: chi legge in fretta
 * non lo apre, l'IT che riceve il link sì. Lì dentro sta anche il vincolo del
 * connettore, perché un vincolo detto da noi vale molto più dello stesso
 * vincolo scoperto da loro un mese dopo.
 */
/**
 * VIA I «TEMPI», e via i prodotti.
 *
 * «Primo» e «secondo tempo» dichiaravano una sequenza che non esiste: i due
 * bisogni che il partner ha riportato il 7 ottobre sono espressamente NON
 * collegati, e numerarli prometteva un ordine di esecuzione che nessuno ha
 * deciso. L'ordine qui è solo di racconto, e si legge dall'alto.
 *
 * E in una slide di sintesi l'elenco dei prodotti non dice niente a chi
 * ascolta: dice che cosa compriamo, non che cosa cambia. Al suo posto, una
 * riga su COSA CAMBIA. I nomi dei prodotti stanno nelle slide di dettaglio,
 * dove c'è lo spazio per spiegare che cosa fanno.
 *
 * L'array va dal basso: la fondazione per prima, il componente impila al
 * contrario.
 */

/* ── Il contenuto · la filiera ─────────────────────────────────────────── */
/* I CINQUE PILASTRI DELLA CONTENT SUPPLY CHAIN, nella forma che hanno.
   Prima erano cinque tappe in fila con Asset Management in terza posizione e
   una didascalia che diceva «è un giro, non una fila» — cioè il testo che si
   scusava per il disegno, lo stesso difetto tolto dagli obiettivi due giorni
   prima. Nella fonte Adobe non è una fila: è un ANELLO, e Asset Management sta
   AL CENTRO — «Workflow & Planning, Creation & Production, Asset Management at
   the centre, Delivery & Activation, and Reporting & Insights. The important
   word is connected. It's a loop, not a pipeline: insights from the end feed
   planning at the start». Quattro attorno a uno, in senso orario dall'alto a
   sinistra, e il perno è l'archivio che tutte e quattro toccano.
   Fonte: Field Readiness, materiale di abilitazione sulla Content Supply
   Chain. Fonte interna: si cita senza link, dicendo che cos'è. */
const tappe = [
  {
    n: '01',
    t: { it: 'Richieste e pianificazione', en: 'Workflow & Planning' },
    d: {
      it: 'Richieste, scadenze e passaggi fra agenzie in un posto solo.',
      en: 'Briefs, deadlines and agency hand-offs in one place.',
    },
  },
  {
    n: '02',
    t: { it: 'Produzione', en: 'Creation & Production' },
    d: {
      it: 'Template che dicono che cosa si cambia e che cosa resta bloccato.',
      en: 'Templates that set what changes and what stays locked.',
    },
  },
  {
    n: '03',
    t: { it: 'Pubblicazione', en: 'Delivery & Activation' },
    d: {
      it: 'Le varianti approvate escono già marcate: campagna, prodotto, destinatario.',
      en: 'Approved variants go out already tagged: campaign, product, audience.',
    },
  },
  {
    n: '04',
    t: { it: 'Misura', en: 'Reporting & Insights' },
    d: {
      it: 'Non quanto ha reso la campagna: quale attributo ha reso, e su chi.',
      en: 'Not how the campaign performed: which attribute performed, and with whom.',
    },
  },
];


/* ── Il contenuto · farsi trovare ──────────────────────────────────────── */
const giro = [
  {
    n: '01',
    t: { it: 'Le domande vere', en: 'The real questions' },
    d: {
      it: 'Si parte dalle domande che le persone fanno davvero agli assistenti: circa 300 milioni di prompt reali portati da Semrush, raggruppati per tema e categoria. Non una lista di parole chiave.',
      en: 'You start from the questions people actually ask the assistants: around 300 million real prompts brought in by Semrush, grouped by theme and category. Not a keyword list.',
    },
  },
  {
    n: '02',
    t: { it: 'Come vi raccontano', en: 'How you are described' },
    d: {
      it: 'Quante volte il marchio viene citato su ChatGPT, Google AI Mode, Copilot e Perplexity, accanto a chi, e come cambia nel tempo.',
      en: 'How often the brand is cited on ChatGPT, Google AI Mode, Copilot and Perplexity, next to whom, and how that shifts over time.',
    },
  },
  {
    n: '03',
    t: { it: 'Che cosa si corregge', en: 'What gets fixed' },
    d: {
      it: 'Le correzioni suggerite escono dal flusso editoriale che usate già, sui template approvati, senza un rilascio applicativo. L’approvazione resta la vostra, e sulla vostra installazione va verificato.',
      en: 'The suggested fixes go out through the editorial flow you already use, on approved templates, without an application release. Approval stays yours, and it has to be checked on your installation.',
    },
  },
  {
    n: '04',
    t: { it: 'Che cosa ha prodotto', en: 'What it produced' },
    d: {
      it: 'Il traffico che arriva dalle risposte, e che cosa fa una volta sul sito, letto dentro Analytics.',
      en: 'The traffic arriving from the answers, and what it does once on the site, read inside Analytics.',
    },
  },
];

/* ── Il decisioning: l'arbitro davanti al cliente ──────────────────────
 * Le tre regole hanno un nome sulla pagina prodotto Adobe — AI ranking,
 * eligibility constraints, frequency capping — e sono tradotte, non inventate.
 * L'ordine è quello in cui agiscono: prima si ordina, poi si filtra per
 * ammissibilità, infine si mette il tetto.
 */
const sorgenti = [
  { it: 'I vostri modelli di propensione', en: 'Your own propensity models' },
  { it: 'Gli strumenti specializzati che già usate', en: 'The specialised tools you already use' },
  { it: 'Le vostre regole di ammissibilità e di contatto, dove stanno oggi', en: 'Your eligibility and contact rules, wherever they live today' },
];
const regole = [
  {
    t: { it: 'Ordina', en: 'Rank' },
    d: {
      it: 'Mette in fila le opzioni per probabilità che quella persona reagisca, e impara dagli esiti.',
      en: 'Ranks the options by how likely that person is to respond, and learns from the outcomes.',
    },
  },
  {
    t: { it: 'Filtra', en: 'Filter' },
    d: {
      it: 'Prima il consenso e le preferenze. Poi le regole: che cosa può essere mostrato a chi, e quando.',
      en: 'First consent and preferences. Then the rules: what can be shown to whom, and when.',
    },
  },
  {
    t: { it: 'Mette il tetto', en: 'Cap' },
    d: {
      it: 'Oltre un certo numero di contatti la risposta cala. Il tetto lo fissate voi, e vale su più canali insieme invece che uno per uno.',
      en: 'Past a certain number of contacts the response rate drops. You set the cap, and it holds across several channels together instead of one by one.',
    },
  },
];
const esito = {
  t: { it: 'Una cosa sola, nel momento giusto', en: 'One single thing, at the right moment' },
  d: {
    it: 'Per dire: una richiesta di prodotto lasciata a metà, e il giorno dopo in app c’è il modo di riprenderla da dove si era fermata. Il dato arriva già oggi; quello che manca è chi decide, in quel minuto, che cosa farne.',
    en: 'Say: a product application left half-finished, and the next day the app offers the way to pick it up where it stopped. The data already arrives today; what is missing is someone deciding, in that minute, what to do with it.',
  },
};

/* ── Una persona sola · il viaggio intero ─────────────────────────────── */
/* I canali sono i LORO, con le loro parole: filiale e filiale digitale sono
   due cose diverse, e chiamare «servizio clienti» la seconda è il genere di
   imprecisione che chi presidia i canali coglie in due secondi. */
const tappeViaggio = [
  { it: 'Annuncio', en: 'Ad' },
  { it: 'Sito', en: 'Website' },
  { it: 'App', en: 'App' },
  { it: 'Filiale digitale', en: 'Digital branch' },
  { it: 'Filiale', en: 'Branch' },
];
/* Quello che la vista omnicanale ABILITA. L'attribuzione è il quarto, non il
   titolo: prima viene la fondazione, poi quello che ci si costruisce sopra.
   Ordinati per vicinanza al problema che loro stessi hanno dichiarato — il
   funnel commerciale che non si segue fino in fondo. */
const casiUso = [
  {
    t: { it: 'Dove si rompe', en: 'Where it breaks' },
    d: { it: 'Il punto esatto in cui la pratica si ferma, canale per canale', en: 'The exact point where the application stalls, channel by channel' },
  },
  {
    t: { it: 'Perché chiamano', en: 'Why they call' },
    d: { it: 'Le telefonate che nascono da un passaggio digitale che non ha funzionato', en: 'The calls that come from a digital step that did not work' },
  },
  {
    t: { it: 'Chi richiamare', en: 'Who to go back to' },
    d: { it: 'Gruppi di persone trovati qui e pubblicati sul profilo, pronti da sottoporre alle regole di contattabilità', en: 'Groups found here and published to the profile, ready to run through the contactability rules' },
  },
  {
    t: { it: 'Che cosa ha pesato', en: 'What counted' },
    d: { it: 'L’attribuzione: uno dei casi, non il titolo', en: 'Attribution: one of the cases, not the headline' },
  },
];


/* ── La prova ─────────────────────────────────────────────────────────────
 * Due numeri per idea, così la referenza prova il capitolo intero e non metà.
 * Tutti e quattro stanno nella pagina pubblica del caso, alla lettera: il
 * «15 min invece di tre giorni» che stava qui prima NON ci stava, e la fonte
 * dice «de dias para minutos». Un numero che non sopravvive alla sua fonte
 * esce, non si arrotonda.
 */
const prova = [
  {
    v: '100 mln',
    l: { it: 'profili unificati', en: 'unified profiles' },
    s: { it: 'una vista sola su individui, PMI e prospect', en: 'one view covering individuals, SMEs and prospects' },
  },
  {
    v: '+600%',
    l: { it: 'conversioni', en: 'conversions' },
    s: { it: 'sulle campagne di ripresa delle richieste interrotte', en: 'on abandoned-application recovery campaigns' },
  },
  {
    v: '4.400',
    l: { it: 'asset creativi', en: 'creative assets' },
    s: { it: 'per 530 offerte al retail e 800 alle PMI', en: 'for 530 retail offers and 800 for SMEs' },
  },
  {
    v: 'minuti',
    l: { it: 'invece di giorni', en: 'instead of days' },
    s: { it: 'il tempo per portare una campagna sul mercato', en: 'the time to take a campaign to market' },
  },
];
---
<BaseLayout title={ch.label.it} preloadImage={bgStacco.src}>
  <div class="fixed top-0 left-0 right-0 z-50">
    <IsuNavigation currentPath={currentPath} base={base} />
  </div>

  <DeckContainer wallScale nextHref={href(base, nextSlug(SLUG))} prevHref={href(base, prevSlug(SLUG))}>

    <!-- ── Stacco di capitolo ────────────────────────────────────────────── -->
    <Slide id="slide-cover" bg="inverse" align="center" data-made-with="Firefly" data-made-with-for="sfondo">
      <div slot="backdrop" class="isu-bg" style={`--bg-src: url(${bgStacco.src})`}></div>
      <div class="isu-wrap max-w-4xl">
        <p class="isu-ch-n">
          <span data-lang-it>Capitolo {ch.num}</span><span data-lang-en>Chapter {ch.num}</span>
        </p>
        <T as="h2" class="isu-ch-t mt-4 mx-auto" it={ch.label.it} en={ch.label.en} />
        <hr class="isu-rule mx-auto" />
        <T
          as="p"
          class="isu-lead mx-auto"
          it={ch.cover.it}
          en={ch.cover.en}
        />
      </div>
    </Slide>

    <!-- ── La pila dell'innesto, che è anche l'indice delle due idee ─────── -->
    <Slide id="slide-innesto" bg="inverse" align="center" data-made-with="Firefly" data-made-with-for="sfondo">
      <div slot="backdrop" class="isu-bg" style={`--bg-src: url(${bgInnesto.src})`}></div>
      <div class="isu-wrap max-w-5xl">
        <T as="p" class="slide-eyebrow" it="Su quello che avete già" en="On what you already have" />
        <T
          as="h2"
          class="isu-title mt-3 text-[var(--ink-inverse)]"
          it="Dove ci innestiamo"
          en="Where we plug in"
        />
        <hr class="isu-rule mx-auto" />

        <IsuStack layers={pila('lungo')} class="mb-5" />

        <T
          as="p"
          class="isu-col-sub mx-auto"
          it="La base ce l’avete già: si parte da lì. I tre strati sopra hanno bisogno di una piattaforma di profilo, ed è il primo pezzo da mettere. Ogni strato si apre sulla pagina che lo racconta."
          en="The base is already there: that is where it starts. The three layers above need a profile platform, and that is the first piece to put in. Each layer opens onto the page that tells it."
        />
      </div>
    </Slide>

    <!-- ── Il contenuto · la filiera ──────────────────────────────────────── -->
    <Slide id="slide-filiera" bg="inverse" align="center" data-made-with="Firefly" data-made-with-for="sfondo">
      <div slot="backdrop" class="isu-bg" style={`--bg-src: url(${bgFiliera.src})`}></div>
      <div class="isu-wrap max-w-6xl">
        <T
          as="p"
          class="slide-eyebrow"
          it="Produrre contenuto · i cinque pilastri"
          en="Producing content · the five pillars"
        />
        <T
          as="h2"
          class="isu-title mt-3 text-[var(--ink-inverse)]"
          it="Un giro solo, dal brief alla misura"
          en="One loop, from brief to measurement"
        />
        <hr class="isu-rule mx-auto" />

        <IsuLoop
          nodes={tappe}
          core={{
            k: { it: 'Archivio', en: 'Asset Management' },
            t: {
              it: 'Un posto solo, che tutte e quattro toccano.',
              en: 'One place, which all four touch.',
            },
          }}
          class="mb-5"
        />

        {/* La governance non è un sesto pilastro: sta SOTTO tutti. Prima era
            il binario della pipeline; con l'anello diventa una fascia a sé,
            che è anche più fedele — nella fonte non è una tappa. */}
        <div class="isu-pipe-rail mb-3">
          <span class="isu-pipe-rail-k">
            <svg width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false">
              <rect x="3" y="7" width="10" height="7" rx="1" stroke="currentColor" stroke-width="1.5"/>
              <path d="M5.5 7V5a2.5 2.5 0 015 0v2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
            <T as="span" it="Governance" en="Governance" />
          </span>
          <T
            as="span"
            class="isu-pipe-rail-t"
            it="Sta sotto tutte e cinque. Chi approva è una persona vostra, nominata nel flusso; la versione pubblicata resta tracciata. Avvertenze e citazioni entrano pre-approvate e restano intatte."
            en="It runs under all five. Whoever approves is one of your people, named in the flow; the published version stays traceable. Disclaimers and citations come in pre-approved and stay untouched."
          />
        </div>

        {/* QUI STAVA UNA DISCLOSURE, e il vincolo decisivo stava dentro.
            «Il caveat più importante dentro un link che in sala nessuno apre»
            — tre personas, giro 2 del panel. Un vincolo che si apre con un
            clic non è un vincolo dichiarato. Adesso è una riga che si legge
            sempre, e la disclosure non serve più: era rimasta con un
            paragrafo solo. */}
        <T
          as="p"
          class="isu-note mt-2 mx-auto"
          it="Un template può uscire da Journey Optimizer, essere riempito qui e tornare pronto da inviare: vale sul canale email, e non con l’add-on di privacy e sicurezza."
          en="A template can leave Journey Optimizer, be filled in here and come back ready to send: on the email channel, and not with the privacy and security add-on."
        />

        <div class="isu-credits"><p class="isu-products">Workfront · Firefly · Experience Manager · GenStudio for Performance Marketing</p>
        <IsuFonte
          of={['genstudioPm']}
          interne={[{
            it: 'I cinque pilastri della Content Supply Chain · materiale di abilitazione Adobe, fonte interna senza link',
            en: 'The five pillars of the Content Supply Chain · Adobe enablement material, internal source, no link',
          }]}
        /></div>
      </div>
    </Slide>

    <!-- ── Il contenuto · farsi trovare ───────────────────────────────────── -->
    <Slide id="slide-trovare" bg="primary" align="center" data-made-with="Firefly" data-made-with-for="sfondo">
      <div slot="backdrop" class="isu-bg isu-bg--light" style={`--bg-src: url(${bgTrovare.src})`}></div>
      <div class="isu-wrap max-w-6xl">
        <T
          as="p"
          class="slide-eyebrow"
          it="Produrre contenuto · farsi trovare dagli assistenti"
          en="Producing content · being found by the assistants"
        />
        <T
          as="h2"
          class="isu-title mt-3 text-[var(--ink-primary)]"
          it="Comparire nelle risposte, non solo nei risultati"
          en="Showing up in the answers, not only in the results"
        />
        <hr class="isu-rule mx-auto" />

        <IsuLoop
          nodes={giro}
          core={{
            v: '60%',
            t: {
              it: 'delle ricerche finisce senza un clic verso il sito',
              en: 'of searches end without a click through to the site',
            },
            src: 'Bain & Company, 2025',
          }}
          class="mb-4"
        />

        <div class="isu-pipe-rail">
          <span class="isu-pipe-rail-k">
            <svg width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false">
              <path d="M2 11.5L6 7l3 2.5L14 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M10.5 4H14v3.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            4,4×
          </span>
          <T
            as="span"
            class="isu-pipe-rail-t"
            it="è quanto converte in più chi arriva da una risposta generata, rispetto al traffico da ricerca organica. È una misura Semrush, società Adobe, fatta in media fra settori."
            en="is how much better traffic arriving from a generated answer converts, compared with organic search. It is a Semrush (an Adobe company) measure, averaged across industries."
          />
        </div>

        <div class="isu-credits mt-4"><p class="isu-products">Adobe Brand Visibility (Adobe + Semrush) · Experience Manager Sites · Analytics</p>
        <IsuFonte of={['brandVisibility']} /></div>
      </div>
    </Slide>

    <!-- ── L'arbitro: il decisioning davanti al cliente ─────────────────── -->
    <!-- Idea arrivata DA LORO tramite il partner, non proposta da noi: per
         questo apre dichiarando di non toccare quello che c'è. Se la slide
         facesse pensare «vogliono rifarci i modelli», avrebbe già perso. -->
    <Slide id="slide-decisioning" bg="primary" align="center" data-made-with="Firefly" data-made-with-for="sfondo">
      <div slot="backdrop" class="isu-bg isu-bg--light isu-bg--veil" style={`--bg-src: url(${bgNumeri.src})`}></div>
      <div class="isu-wrap max-w-7xl">
        <T
          as="p"
          class="slide-eyebrow"
          it="Decidere che cosa arriva · l’ultimo strato"
          en="Deciding what reaches whom · the last layer"
        />
        <T
          as="h2"
          class="isu-title mt-3 text-[var(--ink-primary)]"
          it="Molti decidono, al cliente arriva una cosa sola"
          en="Many decide, one thing reaches the customer"
        />
        <hr class="isu-rule mx-auto" />

        <IsuArbiter sources={sorgenti} rules={regole} out={esito} class="mb-5" />

        {/* Il vincolo sta IN CHIARO, non dentro una disclosure: su questa
            slide il pannello aperto sforava la safe-area a 1440 e 1280, e fra
            nascondere il vincolo e nasconderlo dietro un clic si sceglie di
            dirlo. Una riga si legge sempre; un pannello si legge se qualcuno
            lo apre. */}
        <T
          as="p"
          class="isu-note mt-3 mx-auto"
          it="La decisione legge il profilo dove il profilo vive: se la base dati sta altrove, la strada va verificata su un’architettura vera. Al gestore, in filiale e in filiale digitale, arriva la stessa decisione quando apre la scheda, e resta sua la scelta di usarla."
          en="The decision reads the profile where the profile lives: if the data foundation sits elsewhere, the route has to be checked against a real architecture. The adviser, in the branch and the digital branch, gets the same decision when they open the record, and whether to use it stays their call."
        />

        {/* UN clic per scendere. L'affondo esiste perché questa è la domanda
            che in riunione arriva, e ricostruirla a braccio vale meno di
            quattro slide già pronte. Sta qui e non nella barra: la barra
            porta alle tappe del racconto, questo è un ramo. */}
        <a class="isu-drill mt-4" href={href(base, 'decisioning')}>
          <T as="span" it="Scendi nel dettaglio" en="Go deeper" />
          <svg width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false">
            <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>

        <div class="isu-credits"><p class="isu-products">AI decisioning · Journey Optimizer</p>
        <IsuFonte of={['aiDecisioning']} /></div>
      </div>
    </Slide>

    <!-- ── Una persona sola · il viaggio intero ──────────────────────────── -->
    <Slide id="slide-viaggio" bg="inverse" align="center" data-made-with="Firefly" data-made-with-for="sfondo">
      <div slot="backdrop" class="isu-bg" style={`--bg-src: url(${bgViaggio.src})`}></div>
      <div class="isu-wrap max-w-6xl">
        <T
          as="p"
          class="slide-eyebrow"
          it="Una persona sola · la fondazione"
          en="One person · the foundation"
        />
        <T
          as="h2"
          class="isu-title mt-3 text-[var(--ink-inverse)]"
          it="Lo stesso cliente, visto su tutti i canali"
          en="The same customer, seen across every channel"
        />
        <hr class="isu-rule mx-auto" />

        <IsuJourney
          stops={tappeViaggio}
          cap={{
            it: 'Il filo è la fondazione: lo stesso cliente riconosciuto su tutte le tappe. Il modello si applica quando il dato si legge, non quando si raccoglie: vale anche sul passato.',
            en: 'The thread is the foundation: the same customer recognised at every step. The model applies when the data is read, not when it is collected: it holds for the past too.',
          }}
          class="mb-4"
        />

        <HowItWorks
          title="viaggio"
          tone="onDark"
          label="Che cosa comporta, in pratica"
          class="isu-hiw mt-4 mb-3"
        >
          <p>
            <span data-lang-it><b>Non si butta niente.</b> Lo storico di Analytics si porta dentro, e Analysis Workspace resta lo strumento delle stesse persone. Ci sono differenze da imparare, e Adobe stessa stima tre-sei mesi. I segmenti e le metriche calcolate di oggi si rifanno. I due ambienti restano accesi in parallelo finché serve il confronto.</span>
            <span data-lang-en><b>Nothing is thrown away.</b> The Analytics history comes across, and Analysis Workspace stays the tool of the same people. There are differences to learn, and Adobe itself estimates three to six months. Today’s segments and calculated metrics get rebuilt. Both environments stay on in parallel for as long as the comparison is needed.</span>
          </p>
          <p>
            <span data-lang-it><b>Si comincia da un percorso solo.</b> Non serve collegare tutti i canali il primo giorno: si sceglie un percorso commerciale, si mettono insieme le sue tappe e si guarda dove si perde. Quello che si impara lì vale per gli altri. La raccolta nuova passa dal Web SDK, e per il periodo di confronto i due ambienti si pagano entrambi.</span>
            <span data-lang-en><b>You start with one path.</b> There is no need to connect every channel on day one: you pick one commercial path, bring its steps together and look at where it leaks. What you learn there carries to the rest. New collection goes through the Web SDK, and for the comparison period both environments are paid for.</span>
          </p>
        </HowItWorks>

        <div class="isu-credits"><p class="isu-products">Customer Journey Analytics · Experience Platform</p>
        <IsuFonte of={['cjaUpgrade']} /></div>
      </div>
    </Slide>

    <!-- ── Che cosa ci si costruisce sopra ───────────────────────────────── -->
    <!-- Erano quattro blocchi in coda alla slide del viaggio, che a 1280 non
         ci stavano. Divisa, non compressa: il contratto dice di tagliare la
         copia e poi di dividere, mai di rimpicciolire il tipo. -->
    <Slide id="slide-usi" bg="secondary" align="center" data-made-with="Firefly" data-made-with-for="sfondo">
      <div slot="backdrop" class="isu-bg isu-bg--light isu-bg--veil" style={`--bg-src: url(${bgPercorsoUsi.src})`}></div>
      <div class="isu-wrap max-w-7xl">
        <T
          as="p"
          class="slide-eyebrow"
          it="Una persona sola · quello che abilita"
          en="One person · what it unlocks"
        />
        <T
          as="h2"
          class="isu-title mt-3 text-[var(--ink-primary)]"
          it="Quattro domande che prima non avevano risposta"
          en="Four questions that had no answer before"
        />
        <hr class="isu-rule mx-auto" />

        <ul class="isu-uses mb-6" role="list">
          {casiUso.map((u) => (
            <li role="listitem">
              <T as="h3" class="isu-uses-t" it={u.t.it} en={u.t.en} />
              <T as="p" class="isu-uses-d" it={u.d.it} en={u.d.en} />
            </li>
          ))}
        </ul>

        <T
          as="p"
          class="isu-lead mb-6 mx-auto"
          it="Nessuna delle quattro richiede un progetto a sé: richiedono la stessa fondazione. È per questo che l’ordine conta: prima si vede il cliente intero, poi si sceglie da dove cominciare."
          en="None of the four needs a project of its own: they all need the same foundation. That is why the order matters: first you see the whole customer, then you choose where to start."
        />

        {/* COWORKER entra QUI e non altrove, perché qui ha una ragione vera:
            una fondazione che sa interrogare una persona sola resta ferma
            a quella scrivania. È anche
            il punto che il partner ha segnalato come «da posizionare a
            prescindere, utile soprattutto alle persone business».
            La rivendicazione è volutamente stretta — domande sui dati di
            percorso — perché è quella documentata. */}
        <div class="isu-pipe-rail">
          <span class="isu-pipe-rail-k">
            <svg width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false">
              <path d="M2.5 3.5h11v7h-6l-3 2.5v-2.5h-2z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
            </svg>
            <T as="span" it="E chi la fa, la domanda" en="And who asks the question" />
          </span>
          <T
            as="span"
            class="isu-pipe-rail-t"
            it="Oggi la domanda passa da un analista, e si aspetta il suo turno. Con CX Enterprise Coworker la fa chi ha il problema, scritta come la direbbe a voce, e la risposta torna sui dati di percorso. Le domande non si accodano più tutte sullo stesso analista."
            en="Today the question goes through an analyst, and waits its turn. With CX Enterprise Coworker it comes from whoever has the problem, written as they would say it, and the answer comes back off the journey data. Questions no longer all queue up on the same analyst."
          />
        </div>

        <IsuFonte of={['coworkerChat']} class="mt-4" />
      </div>
    </Slide>

    <!-- ── Una banca che l'ha fatto ──────────────────────────────────────── -->
