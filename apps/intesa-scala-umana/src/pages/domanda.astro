---
import BaseLayout from '../layouts/BaseLayout.astro';
import IsuNavigation from '../components/IsuNavigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import T from '@edf/core/blocks/i18n/T.astro';
import { href } from '@edf/core/utils/url.js';
import { CHAPTERS, nextSlug, prevSlug } from '../data/chapters';

const SLUG = 'domanda';
const ch = CHAPTERS.find((c) => c.slug === SLUG)!;
const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;

/**
 * Le quattro domande che aprono. Prese dal set verificato («le domande da fare
 * — nell'ordine»), NON riscritte: sono il vero deliverable dell'incontro.
 *
 * Il set ne contiene altre quattro che restano FUORI dalle slide, di proposito:
 * due sono costruite per far emergere il sentiment verso gli strumenti in uso e
 * stampate si leggerebbero per quello che sono; due preparano la richiesta e
 * vivono meglio dette a voce, dove si può scegliere il momento. Una domanda
 * stampata è un'agenda, una domanda detta è una conversazione.
 *
 * La quarta usa «consenso» e «preferenze»: è il vocabolario corretto, e l'altra
 * parola non si usa.
 */
const domande = [
  {
    n: '01',
    t: {
      it: 'Quando decidete di parlare a un cliente, dove nasce la decisione: dal contenuto, dal target, dal canale? Chi tiene la penna?',
      en: 'When you decide to talk to a customer, where does the decision start: with the content, the audience, the channel? Who holds the pen?',
    },
  },
  {
    n: '02',
    t: {
      it: 'Quanto ci mette oggi un’idea di campagna a diventare qualcosa che il cliente vede? E dove si ferma, di solito?',
      en: 'How long does a campaign idea take today to become something a customer actually sees? And where does it usually get stuck?',
    },
  },
  {
    n: '03',
    t: {
      it: 'Sul prospect: oggi cosa riuscite a fare, e cosa vi manca per fare di più?',
      en: 'On prospects: what can you do today, and what is missing to do more?',
    },
  },
  {
    n: '04',
    t: {
      it: 'Come è cambiato il modo di lavorare sul consenso e sulle preferenze nell’ultimo anno?',
      en: 'How has the way you work on consent and preferences changed over the past year?',
    },
  },
];
---
<BaseLayout title={ch.label.it}>
  <div class="fixed top-0 left-0 right-0 z-50">
    <IsuNavigation currentPath={currentPath} base={base} />
  </div>

  <DeckContainer nextHref={href(base, nextSlug(SLUG))} prevHref={href(base, prevSlug(SLUG))}>

    <!-- ── Le quattro domande ────────────────────────────────────────────── -->
    <Slide id="slide-domande" bg="inverse" align="left">
      <div class="w-full max-w-6xl">
        <T
          as="p"
          class="slide-eyebrow"
          it="Prima di proporre qualunque cosa"
          en="Before proposing anything at all"
        />
        <T
          as="h2"
          class="isu-title mt-3 text-[var(--ink-inverse)]"
          it="Quello che vogliamo capire"
          en="What we want to understand"
        />
        <hr class="isu-rule" />

        <ul class="flex flex-col gap-5 mb-6" role="list">
          {domande.map((d) => (
            <li role="listitem" class="isu-q min-w-0">
              <span class="isu-q-n" aria-hidden="true">{d.n}</span>
              <T as="p" class="isu-q-t" it={d.t.it} en={d.t.en} />
            </li>
          ))}
        </ul>

        <T
          as="p"
          class="isu-ask"
          it="Le risposte a queste quattro decidono che cosa ha senso proporre. Per questo vengono prima."
          en="The answers to these four decide what is worth proposing. That is why they come first."
        />
      </div>
    </Slide>

  </DeckContainer>
</BaseLayout>
