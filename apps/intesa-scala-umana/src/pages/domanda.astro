---
import BaseLayout from '../layouts/BaseLayout.astro';
import IsuNavigation from '../components/IsuNavigation.astro';
import IsuFlow from '../components/IsuFlow.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import T from '@edf/core/blocks/i18n/T.astro';
import { href } from '@edf/core/utils/url.js';
import { CHAPTERS, nextSlug, prevSlug } from '../data/chapters';
import bgStacco from '../assets/generated/bg/stacco-domanda.jpg';
import bgSpostamento from '../assets/generated/bg/dark-spostamento.jpg';
import bgDomande from '../assets/generated/bg/dark-domande.jpg';

const SLUG = 'domanda';
const ch = CHAPTERS.find((c) => c.slug === SLUG)!;
const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;

/**
 * Le quattro domande che aprono. Prese dal set verificato («le domande da fare
 * — nell'ordine»), NON riscritte: sono il vero deliverable dell'incontro.
 *
 * Il set ne contiene altre quattro che restano FUORI dalle slide, di proposito:
 * due sono costruite per far emergere il sentiment verso gli strumenti in uso e
 * stampate si leggerebbero per quello che sono; due preparano la richiesta e
 * vivono meglio dette a voce, dove si sceglie il momento. Una domanda stampata
 * è un'agenda, una domanda detta è una conversazione.
 *
 * LA QUARTA È CAMBIATA il 9 ottobre. Chiedeva di consenso e preferenze: nata
 * come eco del provvedimento del Garante, suonava difensiva e invitava la
 * risposta «siamo a posto» — che non apre niente. Al suo posto c'è la domanda
 * sul filo che si perde fra primo contatto e firma, perché quella ha una fonte
 * vera: in riunione interna del 9 ottobre è emerso che il problema dichiarato
 * è l'incapacità di tracciare il funnel commerciale end-to-end. Una domanda
 * che tocca un problema loro vale dieci domande che tocchino una nostra
 * preoccupazione. Il vocabolario su consenso e preferenze resta quello
 * corretto ovunque serva: non è cambiata la regola, è cambiato il bersaglio.
 */
const domande = [
  {
    n: '01',
    t: {
      it: 'Quando decidete di parlare a un cliente, dove nasce la decisione: dal contenuto, dal target, dal canale? Chi tiene la penna?',
      en: 'When you decide to talk to a customer, where does the decision start: with the content, the audience, the channel? Who holds the pen?',
    },
  },
  {
    n: '02',
    t: {
      it: 'Quanto ci mette oggi un’idea di campagna a diventare qualcosa che il cliente vede? E dove si ferma, di solito?',
      en: 'How long does a campaign idea take today to become something a customer actually sees? And where does it usually get stuck?',
    },
  },
  {
    n: '03',
    t: {
      it: 'Sul prospect: oggi cosa riuscite a fare, e cosa vi manca per fare di più?',
      en: 'On prospects: what can you do today, and what is missing to do more?',
    },
  },
  {
    n: '04',
    t: {
      it: 'Un cliente che vi conosce dal primo annuncio fino alla firma: oggi riuscite a seguirlo tutto? E dove si perde il filo?',
      en: 'A customer you meet from the first ad through to signature: can you follow the whole path today? And where does the thread break?',
    },
  },
];
---
<BaseLayout title={ch.label.it} preloadImage={bgStacco.src}>
  <div class="fixed top-0 left-0 right-0 z-50">
    <IsuNavigation currentPath={currentPath} base={base} />
  </div>

  <DeckContainer wallScale nextHref={href(base, nextSlug(SLUG))} prevHref={href(base, prevSlug(SLUG))}>

    <!-- ── Stacco di capitolo ────────────────────────────────────────────── -->
    <Slide id="slide-cover" bg="inverse" align="center" data-made-with="Firefly" data-made-with-for="sfondo">
      <div slot="backdrop" class="isu-bg" style={`--bg-src: url(${bgStacco.src})`}></div>
      <div class="isu-wrap max-w-4xl">
        <p class="isu-ch-n">
          <span data-lang-it>Capitolo {ch.num}</span><span data-lang-en>Chapter {ch.num}</span>
        </p>
        <T as="h2" class="isu-ch-t mt-4 mx-auto" it={ch.label.it} en={ch.label.en} />
        <hr class="isu-rule mx-auto" />
        <T
          as="p"
          class="isu-lead mx-auto"
          it="Quattro cose che vorremmo capire prima di proporre qualunque cosa."
          en="Four things we would like to understand before proposing anything at all."
        />
      </div>
    </Slide>

    <!-- ── Dove si sposta il punto di attrito ────────────────────────────── -->
    <Slide id="slide-spostamento" bg="inverse" align="center" data-made-with="Firefly" data-made-with-for="sfondo">
      <div slot="backdrop" class="isu-bg" style={`--bg-src: url(${bgSpostamento.src})`}></div>
      <div class="isu-wrap max-w-6xl">
        <T as="p" class="slide-eyebrow" it="Dove si è spostato il lavoro difficile" en="Where the hard work has moved" />
        <T
          as="h2"
          class="isu-title mt-3 text-[var(--ink-inverse)]"
          it="Da «si può fare» a «chi lo fa»"
          en="From “can it be done” to “who does it”"
        />
        <hr class="isu-rule mx-auto" />

        <IsuFlow
          class="mb-7"
          from={{ k: 'Prima', t: 'Costruire il canale' }}
          to={{ k: 'Adesso', t: 'Riempirlo, e sapere che cosa ha funzionato' }}
        />

        <T
          as="p"
          class="isu-lead mx-auto"
          it="Il 95% dei prodotti per i privati è già gestibile digitalmente e circa il 70% dei journey è già omnicanale: i numeri sono vostri, e dicono che il canale c’è. Quello che resta aperto è quanta materia serve per riempirlo, chi la scrive, chi la aggiorna quando cambia un’offerta — e come si distingue il passaggio che ha spostato il risultato da quello che era solo di passaggio."
          en="95% of retail products can already be handled digitally and around 70% of journeys are already omnichannel: the figures are yours, and they say the channel is there. What stays open is how much material it takes to fill it, who writes it, who updates it when an offer changes — and how anyone tells the step that moved the outcome from the step that was merely passed through."
        />
        <T
          as="p"
          class="isu-note mt-5 mx-auto"
          it="Questa è una nostra lettura, costruita sui due numeri che avete pubblicato voi. Se da dentro si vede diversamente, è la prima cosa che ci interessa sentire."
          en="This is our reading, built on two figures you published yourselves. If it looks different from the inside, that is the first thing we want to hear."
        />
      </div>
    </Slide>

    <!-- ── Le quattro domande ────────────────────────────────────────────── -->
    <Slide id="slide-domande" bg="inverse" align="center" data-made-with="Firefly" data-made-with-for="sfondo">
      <div slot="backdrop" class="isu-bg" style={`--bg-src: url(${bgDomande.src})`}></div>
      <div class="isu-wrap max-w-5xl">
        <T
          as="p"
          class="slide-eyebrow"
          it="Prima di proporre qualunque cosa"
          en="Before proposing anything at all"
        />
        <T
          as="h2"
          class="isu-title mt-3 text-[var(--ink-inverse)]"
          it="Quello che vorremmo capire"
          en="What we would like to understand"
        />
        <hr class="isu-rule mx-auto" />

        {/* Quattro blocchi di pari dimensione su due righe, non un elenco:
            l'elenco faceva partire la domanda corta da un'ascissa diversa (il
            reset centra i paragrafi dentro una slide centrata) e si vedeva. In
            griglia le quattro domande pesano uguale, che è il punto: nessuna
            conta più delle altre. */}
        <ul class="grid gap-x-7 gap-y-6 sm:grid-cols-2 auto-rows-fr mb-7 w-full" role="list">
          {domande.map((d) => (
            <li role="listitem" class="isu-q h-full min-w-0">
              <span class="isu-q-n" aria-hidden="true">{d.n}</span>
              <T as="p" class="isu-q-t" it={d.t.it} en={d.t.en} />
            </li>
          ))}
        </ul>

        <T
          as="p"
          class="isu-ask mx-auto"
          it="Le risposte a queste quattro decidono che cosa ha senso proporre. Per questo vengono prima."
          en="The answers to these four decide what is worth proposing. That is why they come first."
        />
      </div>
    </Slide>

  </DeckContainer>
</BaseLayout>
