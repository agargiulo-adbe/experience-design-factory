---
import BaseLayout from '../layouts/BaseLayout.astro';
import IsuNavigation from '../components/IsuNavigation.astro';
import IsuFonte from '../components/IsuFonte.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import T from '@edf/core/blocks/i18n/T.astro';
import { href } from '@edf/core/utils/url.js';
import bgInnesto from '../assets/generated/bg/dark-innesto.jpg';
import bgLettura from '../assets/generated/bg/light-lettura.jpg';
import bgViaggio from '../assets/generated/bg/dark-viaggio.jpg';

/**
 * L'AFFONDO SUL DECISIONING — tre slide fuori dal percorso.
 *
 * PERCHÉ ESISTE. In revisione (20 ott 2026) è arrivata due volte la stessa
 * richiesta: «preparati dell'extra materiale a supporto per il decisioning,
 * che magari neanche apriamo». La ragione è precisa, ed è la parte che vale:
 * un affondo su quello che facciamo ogni giorno si improvvisa a voce, questo
 * no — e se la domanda arriva in riunione, dieci minuti di ricostruzione a
 * braccio valgono meno di tre slide già pronte.
 *
 * PERCHÉ TRE E NON QUATTRO. Il primo giro ne aveva quattro, e le prime due
 * erano il diagramma della slide madre riscritto in prosa: «quello che resta
 * / si aggiunge un arbitro» È la colonna «resta dov'è → decide qui», e «che
 * cosa legge / decide / emette» SONO «ordina · filtra · mette il tetto». Più
 * pagine non è più profondità, e un affondo che ripete non si apre due volte.
 * Quello che era stato chiesto non erano le meccaniche: era «perché Adobe
 * decisioning», da dire su due piedi. Quindi qui sta solo ciò che la slide
 * madre NON dice.
 *
 * PERCHÉ FUORI DAL PERCORSO. Non è un capitolo: è un ramo. Sta fuori da
 * `CHAPTERS`, quindi non compare nella barra — le voci della barra sono
 * destinazioni del racconto, e un affondo che si apre solo se qualcuno lo
 * chiede non è una tappa. Ci si arriva con UN clic dalla slide che lo
 * riguarda, che è il punto: pronti a scendere subito, non a cercare un file.
 *
 * VINCOLI EREDITATI da `chapters.ts`, e qui valgono tutti:
 *  · nessun competitor nominato, mai — né in pagina né in questi commenti;
 *  · mai «sostituire», «migrazione», «rip-and-replace»: la posizione è
 *    l'innesto, e in un cliente che ha appena finito di rifare il suo CRM è
 *    anche l'unica posizione onesta;
 *  · nessuna condizione commerciale, nessuna iniziativa, nessuna scadenza.
 *    In revisione si è parlato di una leva commerciale: non è confermata per
 *    iscritto, e un documento che il cliente può girare non è il posto dove
 *    scriverla. Resta una cosa da dire a voce, da chi la può garantire;
 *  · ogni affermazione di prodotto porta la sua fonte pubblica.
 */

const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;
/** Si torna da dove si è venuti: la slide che apre l'affondo. */
const RITORNO = 'idee/#slide-decisioning';

/* Slide A — l'argomento, non le meccaniche. Tre cose che il diagramma della
   slide madre non può dire, e la seconda è quella che disinnesca l'obiezione
   di chi possiede un motore suo: l'arbitro è l'ULTIMO anello, non un motore
   in più. Detto da noi prima che lo pensi lui.

   QUI C'ERA UNA QUARTA CARTA sul come si licenzia il modulo. Fuori: il
   packaging non è il tema di questa stanza, e una riga commerciale dentro un
   affondo tecnico sposta la conversazione dove non la vogliamo. Con lei è
   uscita la fonte interna che la reggeva — una fonte senza più un fatto da
   sostenere è rumore. */
const perche = [
  {
    n: '01',
    t: { it: 'Un tetto che vale davvero', en: 'A cap that actually holds' },
    d: {
      it: 'Quando decidono più sistemi il limite vive dentro ciascuno, e sommati non fanno un limite. Un arbitro lo applica una volta sui canali che passano dalla piattaforma: email, app, push, SMS, web, posta. Fuori restano contact center, ATM e i contatti dovuti. Il tetto che conta somma anche quelli, e si disegna con voi.',
      en: 'When several systems decide the limit lives inside each one, and added up they are not a limit. An arbiter applies it once across the channels that run through the platform: email, app, push, SMS, web, direct mail. Outside stay the contact centre, the ATM and the contacts you owe. The cap that counts adds those too, and it gets designed with you.',
    },
  },
  {
    n: '02',
    t: { it: 'Chi propone continua a proporre', en: 'Whoever proposes keeps proposing' },
    d: {
      it: 'L’arbitro è l’ultimo anello, non un motore in più. I motori che avete scelgono che cosa proporre; lui sceglie quale delle proposte esce adesso.',
      en: 'The arbiter is the last link, not one more engine. Your engines choose what to propose; it chooses which proposal goes out now.',
    },
  },
  {
    n: '03',
    t: { it: 'Anche al gestore, non solo al cliente', en: 'To the adviser too, not only to the customer' },
    d: {
      it: 'Lo strumento di filiale e di filiale digitale chiede la decisione quando apre la scheda, e riceve quello che è vero in quel momento. È un’integrazione da fare, un canale alla volta: ha un responsabile e un rilascio.',
      en: 'The branch and digital-branch tool asks for the decision when it opens the record, and gets what is true at that moment. It is an integration to build, one channel at a time: it has an owner and a release.',
    },
  },
];

/* Slide 3 — i due punti aperti. Si dicono PRIMA: un vincolo dichiarato da noi
   vale molto più dello stesso vincolo scoperto dal loro IT fra un mese. */
const daVerificare = [
  {
    n: '01',
    t: { it: 'Dove vive il profilo', en: 'Where the profile lives' },
    d: {
      it: 'La decisione legge il profilo dove il profilo vive. Se la base dati è altrove la strada esiste, ma va disegnata sulla vostra architettura, non su uno schema generico.',
      en: 'The decision reads the profile where the profile lives. If the data foundation is elsewhere there is a route, but it has to be drawn on your architecture, not on a generic diagram.',
    },
  },
  {
    n: '02',
    t: { it: 'Il tempo fra decisione e canale', en: 'The time between decision and channel' },
    d: {
      it: 'Fra il momento in cui si decide e quello in cui il canale esegue passa del tempo. Quanto dipende dalla strada che fa il dato, e si misura su un caso vostro, non in astratto.',
      en: 'Time passes between the moment of the decision and the moment the channel acts. How much depends on the path the data takes, and it is measured on a case of yours, not in the abstract.',
    },
  },
  /* La terza non è tecnica, ed è la più pesante: in una banca dove campagne,
     servizio e canali hanno padroni diversi, l'ultimo anello è il pezzo più
     politico del disegno. Non ha una risposta nostra, e fingere di averla
     sarebbe peggio che dichiararla aperta. */
  {
    n: '03',
    t: { it: 'Di chi è l’arbitro', en: 'Whose arbiter it is' },
    d: {
      it: 'Chi lo governa, chi ne cambia le regole, chi risponde di quello che decide. È una scelta vostra, non una proprietà del prodotto: campagne, servizio e canali hanno padroni diversi, e l’ultimo anello li tocca tutti.',
      en: 'Who governs it, who changes its rules, who answers for what it decides. That is your choice, not a property of the product: campaigns, service and channels have different owners, and the last link touches all of them.',
    },
  },
];

/* Slide 4 — come si prova. Tre condizioni, nessuna delle quali è un numero
   contrattuale: quelle non stanno in un documento che gira. */
const comeSiProva = [
  {
    n: '01',
    t: { it: 'Un caso solo, scelto da voi', en: 'One case, chosen by you' },
    d: {
      it: 'Accanto a quelli che girano oggi, non al posto loro. Così il confronto è leggibile e nessuno smonta niente per provare.',
      en: 'Alongside the ones running today, not instead of them. That way the comparison is readable and nothing gets dismantled to run a test.',
    },
  },
  {
    n: '02',
    t: { it: 'Una misura concordata prima', en: 'A measure agreed up front' },
    d: {
      it: 'Che cosa guardiamo per dire che ha funzionato si scrive all’inizio, e un gruppo resta fuori: senza qualcuno che non riceve niente, non è un confronto.',
      en: 'What we look at to call it a success is written down at the start, and one group stays out: without people who receive nothing, there is no comparison.',
    },
  },
  {
    n: '03',
    t: { it: 'Chi lo porta a terra', en: 'Who makes it land' },
    d: {
      it: 'Un partner che conosce la vostra architettura, accanto alle vostre persone. Qui la scelta di chi implementa pesa quanto quella dello strumento.',
      en: 'A partner who knows your architecture, next to your people. Here the choice of who implements weighs as much as the choice of tool.',
    },
  },
];
---
<BaseLayout
  title="Decidere che cosa arriva — l’affondo"
  description="L’affondo sul decisioning: dove si innesta, che cosa legge e che cosa decide, i due punti da verificare su un’architettura vera, e come si prova senza spostare niente."
  preloadImage={bgInnesto.src}
>
  <div class="fixed top-0 left-0 right-0 z-50">
    <IsuNavigation currentPath={currentPath} base={base} />
  </div>

  {/* Le due frecce portano entrambe alla slide da cui si è scesi: un ramo non
      ha un «dopo» nel racconto, ha un ritorno. */}
  <DeckContainer wallScale nextHref={href(base, RITORNO)} prevHref={href(base, RITORNO)}>

    <!-- ── 1 · Perché un arbitro, e perché questo ───────────────────────── -->
    <Slide id="slide-perche" bg="inverse" align="center" data-made-with="Firefly" data-made-with-for="sfondo">
      <div slot="backdrop" class="isu-bg" style={`--bg-src: url(${bgInnesto.src})`}></div>
      <div class="isu-wrap max-w-7xl">
        <T as="p" class="slide-eyebrow" it="Affondo · perché un arbitro solo" en="Deep dive · why a single arbiter" />
        <T
          as="h2"
          class="isu-title mt-3 text-[var(--ink-inverse)]"
          it="Quello che un motore da solo non può fare"
          en="What one engine alone cannot do"
        />
        <hr class="isu-rule mx-auto" />

        <ul class="grid gap-x-7 gap-y-6 sm:grid-cols-3 auto-rows-fr mb-7 w-full" role="list">
          {perche.map((p) => (
            <li role="listitem" class="isu-q h-full min-w-0">
              <span class="isu-q-n" aria-hidden="true">{p.n}</span>
              <T as="h3" class="isu-col-title" it={p.t.it} en={p.t.en} />
              <T as="p" class="isu-col-sub mt-1.5" it={p.d.it} en={p.d.en} />
            </li>
          ))}
        </ul>

        <IsuFonte of={['aiDecisioning']} />
      </div>
    </Slide>

    <!-- ── 2 · I due punti aperti ────────────────────────────────────────── -->
    <Slide id="slide-verifiche" bg="primary" align="center" data-made-with="Firefly" data-made-with-for="sfondo">
      <div slot="backdrop" class="isu-bg isu-bg--light" style={`--bg-src: url(${bgLettura.src})`}></div>
      <div class="isu-wrap max-w-6xl">
        <T as="p" class="slide-eyebrow" it="Affondo · quello che non sappiamo ancora" en="Deep dive · what we do not know yet" />
        <T
          as="h2"
          class="isu-title mt-3 text-[var(--ink-primary)]"
          it="Tre cose da verificare prima di decidere"
          en="Three things to check before deciding"
        />
        <hr class="isu-rule mx-auto" />

        <ul class="grid gap-x-7 gap-y-6 sm:grid-cols-3 auto-rows-fr mb-7 w-full" role="list">
          {daVerificare.map((v) => (
            <li role="listitem" class="isu-q h-full min-w-0">
              <span class="isu-q-n" aria-hidden="true">{v.n}</span>
              <T as="h3" class="isu-col-title" it={v.t.it} en={v.t.en} />
              <T as="p" class="isu-col-sub mt-1.5" it={v.d.it} en={v.d.en} />
            </li>
          ))}
        </ul>

        <T
          as="p"
          class="isu-ask mx-auto"
          it="Le prime due aprono un tavolo tecnico. La terza no: quella la decidete voi."
          en="The first two open a technical session. The third does not: that one is yours to decide."
        />
      </div>
    </Slide>

    <!-- ── 3 · Come si prova ─────────────────────────────────────────────── -->
    <Slide id="slide-prova-decisioning" bg="inverse" align="center" data-made-with="Firefly" data-made-with-for="sfondo">
      <div slot="backdrop" class="isu-bg" style={`--bg-src: url(${bgViaggio.src})`}></div>
      <div class="isu-wrap max-w-7xl">
        <T as="p" class="slide-eyebrow" it="Affondo · come si prova" en="Deep dive · how it gets tested" />
        <T
          as="h2"
          class="isu-title mt-3 text-[var(--ink-inverse)]"
          it="Si prova senza spostare niente"
          en="It gets tested without moving anything"
        />
        <hr class="isu-rule mx-auto" />

        <ul class="grid gap-x-7 gap-y-6 sm:grid-cols-3 auto-rows-fr mb-7 w-full" role="list">
          {comeSiProva.map((c) => (
            <li role="listitem" class="isu-q h-full min-w-0">
              <span class="isu-q-n" aria-hidden="true">{c.n}</span>
              <T as="h3" class="isu-col-title" it={c.t.it} en={c.t.en} />
              <T as="p" class="isu-col-sub mt-1.5" it={c.d.it} en={c.d.en} />
            </li>
          ))}
        </ul>

        {/* La domanda competitiva è aperta anche per noi, e si porta come
            domanda. Farsela fare dal cliente è peggio che farla. */}
        <T
          as="p"
          class="isu-ask mx-auto"
          it="Che cosa continua a decidere quello che avete già, quando davanti al cliente c’è un arbitro solo?"
          en="What keeps being decided by what you already have, once a single arbiter sits in front of the customer?"
        />
      </div>
    </Slide>

  </DeckContainer>
</BaseLayout>
