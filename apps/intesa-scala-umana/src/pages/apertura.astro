---
import BaseLayout from '../layouts/BaseLayout.astro';
import IsuNavigation from '../components/IsuNavigation.astro';
import IsuGauge from '../components/IsuGauge.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import T from '@edf/core/blocks/i18n/T.astro';
import { href } from '@edf/core/utils/url.js';
import { CHAPTERS, nextSlug, prevSlug } from '../data/chapters';
import { SOURCES } from '../data/sources';
import { NUMERI as numeri, OBIETTIVI as obiettivi, NOTA_OBIETTIVI } from '../data/contenuti';
import bgStacco from '../assets/generated/bg/stacco-anno.jpg';
import bgAnno from '../assets/generated/bg/light-anno.jpg';
import bgNumeri from '../assets/generated/bg/light-numeri.jpg';

const SLUG = 'apertura';
const ch = CHAPTERS.find((c) => c.slug === SLUG)!;
const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;

/**
 * Tutto questo capitolo viene da fonti PUBBLICHE del cliente su sé stesso, con
 * la data accanto. È la differenza fra una Prospettiva e un verbale: non si
 * rimanda indietro quello che ci hanno detto in una call, si mostra di averli
 * guardati da fuori.
 */
/**
 * TRE OBIETTIVI, non tre date. La cronologia diceva che cosa è successo; gli
 * obiettivi dicono dove stanno andando, e sono le ANCORE a cui si aggancia
 * tutto il resto del percorso: ogni idea più avanti si attacca a uno di questi
 * tre. Una data non è un'ancora — è un fatto che si legge e si dimentica.
 *
 * Restano fatti pubblici e datati, presi dalle fonti del cliente su sé stesso:
 * cambia l'inquadratura, non la verità. La riga «che cosa chiede» è invece una
 * nostra lettura, e come tale è dichiarata.
 */

// L'arco rende visibile la quota PRIMA che si legga il numero. Per i due che
// non sono percentuali di un intero, l'arco porta comunque la proporzione:
// 64 su 100 per il cloud, e il pieno per i 150 use case (è un conteggio, non
// una quota — l'arco resta pieno e il numero fa il lavoro).
---
<BaseLayout title={ch.label.it} preloadImage={bgStacco.src}>
  <div class="fixed top-0 left-0 right-0 z-50">
    <IsuNavigation currentPath={currentPath} base={base} />
  </div>

  <DeckContainer wallScale nextHref={href(base, nextSlug(SLUG))} prevHref={href(base, prevSlug(SLUG))}>

    <!-- ── Stacco di capitolo ────────────────────────────────────────────── -->
    <Slide id="slide-cover" bg="inverse" align="center" data-made-with="Firefly" data-made-with-for="sfondo">
      <div slot="backdrop" class="isu-bg" style={`--bg-src: url(${bgStacco.src})`}></div>
      <div class="isu-wrap max-w-4xl">
        <p class="isu-ch-n">
          <span data-lang-it>Capitolo {ch.num}</span><span data-lang-en>Chapter {ch.num}</span>
        </p>
        <T as="h2" class="isu-ch-t mt-4 mx-auto" it={ch.label.it} en={ch.label.en} />
        <hr class="isu-rule mx-auto" />
        <T
          as="p"
          class="isu-lead mx-auto"
          it="Quello che di voi si legge da fuori, con la data accanto a ogni fatto."
          en="What can be read about you from outside, with a date beside every fact."
        />
      </div>
    </Slide>

    <!-- ── I tre obiettivi, che faranno da ancora a tutto il resto ───────── -->
    <Slide id="slide-obiettivi" bg="primary" align="center" data-made-with="Firefly" data-made-with-for="sfondo">
      <div slot="backdrop" class="isu-bg isu-bg--light" style={`--bg-src: url(${bgAnno.src})`}></div>
      <div class="isu-wrap max-w-6xl">
        <T as="p" class="slide-eyebrow" it="Dichiarati da voi, in pubblico" en="Stated by you, in public" />
        <T
          as="h2"
          class="isu-title mt-3 text-[var(--ink-primary)]"
          it="Tre obiettivi del vostro piano"
          en="Three goals from your plan"
        />
        <hr class="isu-rule mx-auto" />

        <div class="isu-goals mb-5 w-full">
          {obiettivi.map((o) => (
            <div class="isu-goal">
              <span class="isu-num" aria-hidden="true">{o.n}</span>
              <p class="isu-goal-t">
                <span data-lang-it set:html={o.goal.it} /><span data-lang-en set:html={o.goal.en} />
              </p>
              <p class="isu-goal-s">
                <span data-lang-it set:html={o.ask.it} /><span data-lang-en set:html={o.ask.en} />
              </p>
            </div>
          ))}
        </div>

        <T
          as="p"
          class="isu-note mx-auto"
          it={NOTA_OBIETTIVI.it}
          en={NOTA_OBIETTIVI.en}
        />
        <p class="isu-note mt-2 mx-auto">
          <span data-lang-it>{SOURCES.piano.label.it} · {SOURCES.tecnologia.label.it}</span>
          <span data-lang-en>{SOURCES.piano.label.en} · {SOURCES.tecnologia.label.en}</span>
        </p>
      </div>
    </Slide>

    <!-- ── I numeri, resi visibili ───────────────────────────────────────── -->
    <Slide id="slide-numeri" bg="secondary" align="center" data-made-with="Firefly" data-made-with-for="sfondo">
      <div slot="backdrop" class="isu-bg isu-bg--light isu-bg--veil" style={`--bg-src: url(${bgNumeri.src})`}></div>
      <div class="isu-wrap max-w-7xl">
        <T as="p" class="slide-eyebrow" it="Dichiarati da voi, in pubblico" en="Stated by you, in public" />
        <T
          as="h2"
          class="isu-title mt-3 text-[var(--ink-primary)]"
          it="Dove siete già arrivati"
          en="How far you have already come"
        />
        <hr class="isu-rule mx-auto" />

        <ul class="grid gap-x-7 gap-y-8 sm:grid-cols-2 lg:grid-cols-4 auto-rows-fr mb-7 w-full" role="list">
          {numeri.map((n) => (
            <li role="listitem" class="flex flex-col items-center gap-3 min-w-0 h-full" data-display>
              <IsuGauge value={n.v} label={n.label} />
              <T as="h3" class="isu-col-title" it={n.l.it} en={n.l.en} />
              <T as="p" class="isu-col-sub" it={n.s.it} en={n.s.en} />
            </li>
          ))}
        </ul>

        <T
          as="p"
          class="isu-ask mt-2 mx-auto"
          it="Questa lettura regge, vista da dentro?"
          en="Does this reading hold, seen from the inside?"
        />
        <p class="isu-note mt-6 mx-auto">
          <span data-lang-it>{SOURCES.tecnologia.label.it}</span>
          <span data-lang-en>{SOURCES.tecnologia.label.en}</span>
          · <a href={SOURCES.tecnologia.url} target="_blank" rel="noopener noreferrer">{SOURCES.tecnologia.short}</a>
        </p>
      </div>
    </Slide>

  </DeckContainer>
</BaseLayout>
