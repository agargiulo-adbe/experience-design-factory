---
/**
 * Le ancore — un nome per concetto, una riga sotto. Markup della pelle della
 * Prospettiva (`.tp-ancore`), così i due deck si leggono con la stessa mano.
 * `cols` fissa le colonne quando `auto-fit` darebbe un'ultima riga zoppa.
 */
interface Item { k: string; t: string; b?: string }
interface Props { items: Item[]; cols?: number; delay?: number }
const { items, cols, delay = 0.14 } = Astro.props as Props;
---
<div
  class="tp-ancore cc-ancore"
  style={cols ? `--cc-cols:${cols}` : undefined}
  data-cols={cols}
  data-stagger
  data-reveal
  data-reveal-delay={String(delay)}
>
  {items.map((v) => (
    <div class="tp-anc">
      <p class="tp-anc-k">{v.k}</p>
      <p class="tp-anc-n">{v.t}</p>
      {v.b && <p class="tp-anc-b">{v.b}</p>}
    </div>
  ))}
</div>
