---
/**
 * Il bozzetto dell'invito: un cartoncino in busta, firmato dal padrone di casa.
 *
 * È disegnato in HTML e non è un'immagine: così si corregge come il resto del
 * deck. Il cartoncino porta una superficie chiara SUA dentro una slide scura,
 * quindi dichiara inchiostri espliciti e pieni (vedi `audit:ink`).
 */
import Chiasmo from './Chiasmo.astro';
import { INVITO } from '../data/contenuti';
const c = INVITO.card;
---
<figure class="cc-invito" aria-label="Bozzetto dell'invito, fronte">
  <span class="cc-invito-busta" aria-hidden="true"></span>
  <div class="cc-invito-carta">
    <p class="cc-invito-occ">{c.occhiello}</p>
    <p class="cc-invito-t"><Chiasmo /></p>
    <span class="cc-invito-filo" aria-hidden="true"></span>
    <p class="cc-invito-testo">{c.testo}</p>
    <p class="cc-invito-quando">{c.quando}</p>
    <p class="cc-invito-firma"><span class="cc-invito-mano" aria-hidden="true"></span>{c.firma}</p>
  </div>
</figure>
