---
/**
 * Il guscio di una slide RISERVATA: vuoto nel bundle, si riempie dallo strato
 * interno (chiave = id della slide). Nel livello pubblico esce dal flusso.
 * `scuro` la mette sul fondo ardesia: il ritmo del deck alterna chiaro e scuro.
 */
import Slide from '@edf/core/blocks/immersive/Slide.astro';
interface Props { id: string; scuro?: boolean }
const { id, scuro = false } = Astro.props as Props;
---
<Slide id={id} bg="primary" align="left" data-riservato data-tono={scuro ? 'scuro' : undefined}>
  <div slot="backdrop" class="xd-bg-piano"></div>
  <div class="xd-sl cc-r-slide" data-reveal data-r={id}><p class="cc-attesa">Si carica lo strato interno…</p></div>
</Slide>
