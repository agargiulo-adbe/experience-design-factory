---
/**
 * La scaletta della giornata — una riga per blocco, l'ora a sinistra.
 *
 * I blocchi con la Direzione presente portano un segno: chi legge vede subito
 * che ai dirigenti chiediamo la mattina e la rotta, non la giornata intera.
 * È un elenco e non una tabella: su telefono le righe si impilano da sole.
 */
import { SCALETTA } from '../data/contenuti';
---
<ol class="cc-scal" data-stagger>
  {SCALETTA.voci.map((v) => (
    <li class:list={['cc-scal-i', v.dir && 'cc-scal-i--dir']}>
      <span class="cc-scal-o">{v.o}</span>
      <span class="cc-scal-c">
        <span class="cc-scal-t">{v.t}{v.dir && <span class="cc-scal-dir">con la Direzione</span>}</span>
        <span class="cc-scal-d">{v.d}</span>
      </span>
    </li>
  ))}
</ol>
