---
/**
 * La prova in sequenza: quattro frecce che si accendono una dopo l'altra quando
 * la slide entra. Prima la risposta sui dati storici, poi il cancello di fine
 * gennaio (un rombo, non una freccia: lì si decide come si misura), poi il test
 * dal vivo; l'ultima, rossa, è la giornata, che arriva quando la prova è chiusa.
 */
import { SEQUENZA } from '../data/contenuti';
---
<ol class="cc-seq" style={`--n:${SEQUENZA.passi.length}`}>
  {SEQUENZA.passi.map((p, i) => (
    <li class="cc-seq-i" data-forte={p.forte ? '' : undefined} data-cancello={p.cancello ? '' : undefined} style={`--i:${i}`}>
      {p.cancello && <svg class="cc-seq-rombo" viewBox="0 0 40 40" aria-hidden="true"><path d="M20 3 L37 20 L20 37 L3 20 Z" /></svg>}
      <p class="cc-seq-q">{p.q}</p>
      <p class="cc-seq-l">{p.l}</p>
      <p class="cc-seq-d">{p.d}</p>
    </li>
  ))}
</ol>
