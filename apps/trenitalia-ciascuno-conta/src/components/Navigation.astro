---
/**
 * Navigation — UNA barra: marchio a sinistra, rail dei capitoli al centro (nowrap,
 * scorre se non entra), cluster destro («Lo strato interno» + lingua + Admin).
 * Mai su due righe.
 */
import { href } from '@edf/core/utils/url.js';
import LangToggle from '@edf/core/blocks/i18n/LangToggle.astro';
import { CHAPTERS, PRESENTAZIONE } from '../data/chapters';
import { SITE } from '../data/site';

interface Props {
  currentPath: string;
  base: string;
}
const { currentPath, base } = Astro.props;

function isActive(slug: string) {
  const norm = currentPath.replace(/\/+$/, '');
  return norm.endsWith('/' + slug);
}
// Nella barra l'annex è UNA voce, accesa su ogni sua pagina.
const inAnnex = CHAPTERS.some((c) => c.parte === 'annex' && isActive(c.slug));
const VOCI = [...PRESENTAZIONE.map((c) => ({ c, on: isActive(c.slug) })), { c: CHAPTERS.find((c) => c.slug === 'annex')!, on: inAnnex }];
---
<nav class="ex-nav flex items-center justify-between px-6 py-3" aria-label="Navigazione">
  <a href={href(base, '/')} class="flex items-center gap-2.5 no-underline group flex-shrink-0" aria-label={`Home — ${SITE.name}`}>
    <span class="ex-mark" aria-hidden="true">
      <svg width="28" height="28" viewBox="0 0 32 32" fill="none">
        <rect width="32" height="32" rx="7" fill="var(--color-rosso)"/>
        <circle cx="16" cy="16" r="7.5" stroke="var(--color-bianco)" stroke-width="2.6"/>
        <circle cx="16" cy="16" r="2.6" fill="var(--color-bianco)"/>
      </svg>
    </span>
    <span class="text-sm font-bold text-[var(--ink-primary)] group-hover:text-[var(--ink-accent)] transition-colors whitespace-nowrap">
      {SITE.name}
    </span>
    <span class="hidden 2xl:inline text-[0.6rem] font-bold tracking-widest uppercase text-[var(--color-grigio-600)] ml-1 whitespace-nowrap">
      Adobe × {SITE.client}
    </span>
  </a>

  <ol class="hidden md:flex flex-nowrap items-center gap-0.5 min-w-0 overflow-x-auto [scrollbar-width:none] [-ms-overflow-style:none] [&::-webkit-scrollbar]:hidden" role="list">
    {VOCI.map(({ c, on }) => (
      <li role="listitem" class="flex-shrink-0">
        <a
          href={href(base, '/' + c.slug)}
          class:list={['ex-nav-link block whitespace-nowrap px-2.5 py-1.5 text-xs font-medium rounded-sm transition-colors no-underline', on && 'ex-nav-link--active']}
          aria-current={on ? 'page' : undefined}
        >
          {c.slug !== 'annex' && <span class="text-[var(--color-ardesia-chiara)] mr-1 tabular-nums" data-cap-num={c.slug}>{c.num}</span>}
          <span>{c.short}</span>
        </a>
      </li>
    ))}
  </ol>

  <div class="flex items-center gap-3 flex-shrink-0">
    <!-- Nell'annex: il ritorno alla slide da cui si è scesi nel dettaglio (vedi
         BaseLayout, `cc:da`). Senza memoria, torna all'apertura. -->
    {inAnnex && (
      <a href={href(base, '/')} class="cc-torna ex-nav-link whitespace-nowrap px-2.5 py-1.5 text-xs font-semibold rounded-sm no-underline" data-cc-torna>
        ← Torna alla presentazione
      </a>
    )}
    <!-- Il segno del livello interno: c'è solo quando lo strato è caricato. -->
    <span class="cc-tag-interno" aria-label="Documento interno Adobe, riservato">Interno · riservato</span>
    <!-- Il dossier (pagina gated, contenuto in Supabase) non è un capitolo: sta nel
         cluster destro, e solo nel livello interno. Sotto `lg` sparisce, perché la
         barra resta UNA riga. -->
    <a
      href={href(base, '/dossier')}
      class:list={['cc-solo-interno ex-nav-link hidden lg:block whitespace-nowrap px-2.5 py-1.5 text-xs font-semibold rounded-sm transition-colors no-underline', isActive('dossier') && 'ex-nav-link--active']}
      aria-current={isActive('dossier') ? 'page' : undefined}
    >
      Il dossier
    </a>
    {SITE.langs.length > 1 && <LangToggle langs={SITE.langs} />}
    <a
      href={href(base, '/admin')}
      class="text-[0.7rem] font-semibold tracking-wider uppercase px-3 py-1.5 border border-[var(--line-default)] text-[var(--color-grigio-600)] hover:text-[var(--ink-accent)] hover:border-[var(--color-rosso)] rounded-sm transition-colors no-underline"
      data-admin-only
    >
      Admin
    </a>
  </div>
</nav>
