---
/**
 * La domanda delle nove, fra un anno: una schermata d'esempio.
 *
 * Una chat con Coworker su Customer Journey Analytics. La persona che chiede e
 * l'assistente che risponde parlano al singolare: è un dialogo, non la voce del
 * deck. Dati illustrativi, dichiarati nella nota sotto la schermata.
 */
import Venduto from './Venduto.astro';
import { MATTINA } from '../data/contenuti';
---
<div class="cc-mock" role="img" aria-label="Schermata d'esempio: una domanda sul calo del venduto e la risposta con l'azione da fare">
  <div class="cc-mock-testa">
    <span class="cc-mock-pallino" aria-hidden="true"></span>
    <span>Coworker · Customer Journey Analytics</span>
    <span class="cc-mock-ora">09:01</span>
  </div>
  <div class="cc-mock-grafico"><Venduto /></div>
  <p class="cc-mock-chiede">{MATTINA.domanda}</p>
  <div class="cc-mock-risponde">
    {MATTINA.risposta.map((r) => <p>{r}</p>)}
    <p class="cc-mock-azione"><span>Azione</span>{MATTINA.azione}</p>
  </div>
</div>
<p class="cc-mock-nota">{MATTINA.nota}</p>
