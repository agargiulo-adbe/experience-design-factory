---
/**
 * La pianta delle mani sugli strumenti: una plenaria e tre salette.
 *
 * Tre gruppi misti ruotano fra le salette ogni quaranta minuti. La pianta dice
 * anche il requisito di luogo che decide la scelta dello spazio: tre stanze
 * chiuse oltre alla sala grande.
 */
import { POSTAZIONI } from '../data/contenuti';
---
<div class="cc-pianta">
  <div class="cc-pianta-plen">
    <p class="cc-pianta-k">Plenaria</p>
    <p class="cc-pianta-b">Apertura, risultati, pomeriggio, rotta</p>
  </div>
  <ol class="cc-pianta-sale" data-stagger>
    {POSTAZIONI.stanze.map((s, i) => (
      <li class="cc-pianta-sala">
        <p class="cc-pianta-n">Saletta {i + 1} · {s.k}</p>
        <p class="cc-pianta-t">{s.t}</p>
        <p class="cc-pianta-b">{s.b}</p>
      </li>
    ))}
  </ol>
</div>
