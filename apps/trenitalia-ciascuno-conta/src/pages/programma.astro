---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import Divisore from '../components/Divisore.astro';
import { href } from '@edf/core/utils/url.js';
import { CHAPTERS, prevSlug, nextSlug } from '../data/chapters';
import Atti from '../components/Atti.astro';
import Sequenza from '../components/Sequenza.astro';
import Circuito from '../components/Circuito.astro';
import { ATTI, SEQUENZA, CIRCUITO } from '../data/contenuti';
import foto from '../assets/stock/programma.webp';

/**
 * Capitolo — Il programma. Tre figure: i quattro atti nel tempo, i due binari
 * della prova (la misura completa alla giornata, i test con i primi dati), il
 * circuito dei dati da Analytics a Target e ritorno.
 */
const SLUG = 'programma';
const ch = CHAPTERS.find((c) => c.slug === SLUG)!;
const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;
---
<BaseLayout title={ch.title.it}>
  <div class="fixed top-0 left-0 right-0 z-50">
    <Navigation currentPath={currentPath} base={base} />
  </div>

  <DeckContainer wallScale nextHref={href(base, nextSlug(SLUG))} prevHref={href(base, prevSlug(SLUG))}>

    <Slide id="slide-cover" bg="primary" align="left" data-made-with="Adobe Stock" data-made-with-for="fotografia">
      <div slot="backdrop" class="xd-div-bg" style={`--foto: url(${foto.src})`}></div>
      <Divisore num={ch.num} titolo={ch.title.it} punto={ch.punto} slug={SLUG} />
    </Slide>

    <Slide id="slide-atti" bg="primary" align="left">
      <div slot="backdrop" class="xd-bg-piano"></div>
      <div class="xd-sl xd-sl--fig" data-reveal>
        <div class="xd-sl-head">
          <h2 class="xd-h2">{ATTI.titolo}</h2>
        </div>
        <div class="cc-corpo"><Atti /></div>
      </div>
    </Slide>

    <Slide id="slide-sequenza" bg="primary" align="left" data-tono="scuro">
      <div slot="backdrop" class="xd-bg-piano"></div>
      <div class="xd-sl xd-sl--fig" data-reveal>
        <div class="xd-sl-head">
          <h2 class="xd-h2">{SEQUENZA.titolo}</h2>
        </div>
        <div class="cc-corpo"><Sequenza /><p class="cc-noi" data-r="noi-sequenza"></p></div>
      </div>
    </Slide>

    <Slide id="slide-circuito" bg="primary" align="left">
      <div slot="backdrop" class="xd-bg-piano"></div>
      <div class="xd-sl xd-sl--fig" data-reveal>
        <div class="xd-sl-head">
          <h2 class="xd-h2">{CIRCUITO.titolo}</h2>
        </div>
        <div class="cc-corpo"><Circuito /><p class="cc-noi" data-r="noi-circuito"></p></div>
      </div>
    </Slide>

  </DeckContainer>
</BaseLayout>
