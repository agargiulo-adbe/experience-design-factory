---
import BaseLayout from '../layouts/BaseLayout.astro';
import AdminConsole from '@edf/core/blocks/admin/AdminConsole.astro';
import { href } from '@edf/core/utils/url.js';
import { SITE } from '../data/site';

const base = import.meta.env.BASE_URL;
const SUPABASE_URL = import.meta.env.PUBLIC_SUPABASE_URL ?? '';
const SUPABASE_ANON_KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY ?? '';

interface SlideEntry { id: string; label: string; }
interface PageEntry { slug: string; label: string; slides: SlideEntry[]; }

// Ogni slide del deck, pagina per pagina: è ciò che il tab «Capitoli e slide»
// accende e spegne. Ogni <Slide id> nuova va registrata qui.
const PAGE_REGISTRY: PageEntry[] = [
  { slug: 'index', label: 'Ciascuno conta (00)', slides: [
    { id: 'slide-cover', label: 'Copertina e capitoli' },
    { id: 'r-tesi',      label: 'La tesi in una slide (riservata)' },
  ]},
  { slug: 'origine', label: 'Da dove nasce (01, riservato)', slides: [
    { id: 'slide-cover', label: 'Divisore — Da dove nasce' },
    { id: 'r-linea',     label: 'Sei mesi, tre passaggi (riservata)' },
  ]},
  { slug: 'idea', label: 'L’idea (02)', slides: [
    { id: 'slide-cover',   label: 'Divisore — L’idea' },
    { id: 'slide-mattina', label: 'Alle nove e un minuto' },
    { id: 'slide-folla',   label: 'Le tre direttrici' },
  ]},
  { slug: 'programma', label: 'Il programma (03)', slides: [
    { id: 'slide-cover', label: 'Divisore — Il programma' },
    { id: 'slide-atti',  label: 'Quattro atti, da dicembre a giugno' },
    { id: 'slide-sequenza', label: 'La prova in sequenza' },
    { id: 'slide-circuito', label: 'Il circuito dei dati' },
  ]},
  { slug: 'valore', label: 'Quanto vale, quanto costa (04, riservato)', slides: [
    { id: 'slide-cover', label: 'Divisore — Quanto vale, quanto costa' },
    { id: 'r-gnarr',     label: 'Il ritorno: il cuore (riservata)' },
    { id: 'r-leva',      label: 'Come si apre l’istanza di CJA (riservata)' },
    { id: 'r-attorno',   label: 'Attorno al cuore (riservata)' },
    { id: 'r-sforzo',    label: 'L’effort per persona e per mese (riservata)' },
  ]},
  { slug: 'scegliere', label: 'Scegliere, misurare, attivare (05)', slides: [
    { id: 'slide-cover',     label: 'Divisore — Scegliere, misurare, attivare' },
    { id: 'slide-scegliere', label: 'Atto 1 · Quattro passi di dicembre' },
    { id: 'slide-criteri',   label: 'I criteri di successo' },
    { id: 'slide-misurare',  label: 'Atto 2 · Otto settimane, due corsie' },
  ]},
  { slug: 'giornata', label: 'Decidere: la giornata (06)', slides: [
    { id: 'slide-cover',      label: 'Divisore — La giornata' },
    { id: 'slide-giorno',     label: 'La giornata in una figura' },
    { id: 'slide-scaletta',   label: 'Ora per ora' },
    { id: 'slide-postazioni', label: '11:30 · Le mani sugli strumenti' },
    { id: 'r-sala',           label: 'Chi c’è, e chi conduce (riservata)' },
    { id: 'r-luogo',          label: 'Il luogo e i costi (riservata)' },
    { id: 'slide-intorno',    label: 'Prima e dopo' },
    { id: 'slide-invito',     label: 'L’invito' },
  ]},
  { slug: 'scalare', label: 'Scalare (07)', slides: [
    { id: 'slide-cover',     label: 'Divisore — Scalare' },
    { id: 'slide-rotta',     label: 'Atto 4 · La rotta a tre tappe' },
    { id: 'slide-ruoli',     label: 'Chi fa che cosa' },
    { id: 'slide-passo',     label: 'Il prossimo passo (solo pubblico)' },
    { id: 'slide-signature', label: 'La firma (solo pubblico)' },
  ]},
  { slug: 'decisione', label: 'Che cosa vi chiediamo (08, riservato)', slides: [
    { id: 'slide-cover',     label: 'Divisore — Che cosa vi chiediamo' },
    { id: 'r-rischi',        label: 'I rischi, con la contromossa (riservata)' },
    { id: 'r-richiesta',     label: 'Che cosa vi chiediamo (riservata)' },
    { id: 'r-passi',         label: 'I prossimi passi (riservata)' },
    { id: 'slide-signature', label: 'La firma — Adobe × Trenitalia' },
  ]},
  { slug: 'annex', label: 'Annex: i punti da validare (09, riservato)', slides: [
    { id: 'slide-cover',      label: 'Divisore — Annex' },
    { id: 'r-annex-sintesi',  label: 'La sintesi per il team (riservata)' },
    { id: 'r-annex-1',        label: 'Da validare subito (riservata)' },
    { id: 'r-annex-2',        label: 'Da validare entro il cancello (riservata)' },
    { id: 'r-annex-3',        label: 'Da validare prima della proposta (riservata)' },
    { id: 'r-annex-domande',  label: 'Le domande ai partner (riservata)' },
  ]},
];

interface SolutionEntry {
  id: string; name: string; shortName: string;
  pillar: string; description: string; appearsIn: string[];
}

// Segnaposto: il deck generato non ha slide gated. Sostituire con le soluzioni
// Adobe che l'experience propone davvero (nomi verificati, vedi memoria
// adobe-product-naming-2026) e marcare le slide con `data-solution="<id>"`.
const SOLUTIONS: SolutionEntry[] = [
  { id: 'piattaforma', name: 'Adobe Experience Cloud — segnaposto', shortName: 'Adobe', pillar: 'piattaforma',
    description: 'Sostituire con i prodotti Adobe che il deck propone, uno per voce, con il nome per esteso.', appearsIn: ['L’idea', 'Il programma', 'Scegliere e misurare', 'La giornata', 'Scalare'] },
];

const PILLAR_LABELS: Record<string, string> = { piattaforma: 'Piattaforma' };
const PILLAR_ORDER = ['piattaforma'];
const PILLAR_COLORS: Record<string, string> = { piattaforma: '#d91835' };

const solutionGroups = PILLAR_ORDER
  .map((pillar) => ({ pillar, label: PILLAR_LABELS[pillar], color: PILLAR_COLORS[pillar], solutions: SOLUTIONS.filter((s) => s.pillar === pillar) }))
  .filter((g) => g.solutions.length > 0);

const allSolutionIds = SOLUTIONS.map((s) => s.id);
const deckHref = href(base, '/');
// I dossier interni di questa experience, se ne ha: la console è il posto dove
// chi presenta trova il deck e il documento che prepara la stanza. Quando nasce
// un `dossier.astro`, si aggiunge qui — restano gated, il link non li apre.
const DOSSIERS: { href: string; label?: string }[] = [
  { href: href(base, '/dossier'), label: 'Lo strato interno' },
];
---
<BaseLayout title={`Console — ${SITE.name} · ${SITE.client}`}>
  <AdminConsole
    projectSlug={SITE.slug}
    projectName={SITE.name}
    clientLabel={`Adobe × ${SITE.client}`}
    deckHref={deckHref}
    dossiers={DOSSIERS}
    pages={PAGE_REGISTRY}
    solutionGroups={solutionGroups}
    allSolutionIds={allSolutionIds}
    supabaseUrl={SUPABASE_URL}
    supabaseAnonKey={SUPABASE_ANON_KEY}
  />
</BaseLayout>
