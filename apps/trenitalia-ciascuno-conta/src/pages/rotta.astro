---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import Divisore from '../components/Divisore.astro';
import Ancore from '../components/Ancore.astro';
import Approfondisci from '../components/Approfondisci.astro';
import CoBrand from '../components/CoBrand.astro';
import Folla from '../components/Folla.astro';
import { href } from '@edf/core/utils/url.js';
import foto from '../assets/generated/sole/sole-rotta.webp';
import { CHAPTERS, prevSlug, nextSlug } from '../data/chapters';
import { ROTTA, PASSO, COVER } from '../data/contenuti';

/**
 * Capitolo 06 — Che cosa resta.
 *
 * La rotta a tre tappe è un punto di partenza: alla giornata la scrivono loro.
 * Poi il passo, uno solo e piccolo, e la slide-firma. Avanti oltre l'ultima
 * slide si torna alla copertina: il deck è un anello.
 */
const SLUG = 'rotta';
const ch = CHAPTERS.find((c) => c.slug === SLUG)!;
const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;
---
<BaseLayout title={ch.title.it}>
  <div class="fixed top-0 left-0 right-0 z-50">
    <Navigation currentPath={currentPath} base={base} />
  </div>

  <DeckContainer wallScale nextHref={href(base, '/')} prevHref={href(base, prevSlug(SLUG))}>

    <!-- ── Divisore di capitolo (il fondo sta qui: Astro non propaga slot="backdrop") -->
    <Slide id="slide-cover" bg="primary" align="left" data-made-with="Adobe Firefly" data-made-with-for="sfondo">
      <div slot="backdrop" class="xd-div-bg" style={`--foto: url(${foto.src})`}></div>
      <Divisore num={ch.num} titolo={ch.title.it} punto={ch.punto} slug={SLUG} />
    </Slide>

    <Slide id="slide-rotta" bg="primary" align="left">
      <div slot="backdrop" class="xd-bg-piano"></div>
      <div class="xd-sl xd-sl--fig" data-reveal>
        <div class="xd-sl-head">
          <p class="xd-n">{ROTTA.eyebrow}</p>
          <h2 class="xd-h2">{ROTTA.titolo}</h2>
          <p class="xd-sub">{ROTTA.sub}</p>
        </div>
        <div class="cc-corpo">
          <ol class="xd-passi cc-passi" style="--cols:3" data-stagger data-reveal data-reveal-delay="0.14">
            {ROTTA.passi.map((p, i) => (
              <li class="xd-passi-i">
                <span class="xd-passi-n">{i + 1}</span>
                <p class="xd-passi-l">{p.l}</p>
                <p class="xd-passi-d">{p.d}</p>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </Slide>

    <Slide id="slide-passo" bg="primary" align="left">
      <div slot="backdrop" class="xd-bg-piano"></div>
      <div class="xd-sl cc-domanda" data-reveal>
        <p class="xd-n">{PASSO.eyebrow}</p>
        <h2 class="cc-cit">{PASSO.titolo}</h2>
        <p class="xd-sub">{PASSO.sub}</p>
      </div>
    </Slide>

    <!-- ── Slide-firma ─────────────────────────────────────────────────── -->
    <Slide id="slide-signature" data-audio="loud" bg="primary" align="center">
      <div slot="backdrop" class="cc-cop-bg cc-cop-bg--firma" data-scrim>
        <Folla />
      </div>
      <CoBrand variant="hero" data-reveal />
      <p class="ex-sig-line" data-reveal data-reveal-delay="0.1">{COVER.firma}</p>
      <a href={href(base, '/' + CHAPTERS[0].slug)} class="edf-sig-cta" data-reveal data-reveal-delay="0.18">Ricomincia dal primo capitolo →</a>
    </Slide>

  </DeckContainer>
</BaseLayout>
