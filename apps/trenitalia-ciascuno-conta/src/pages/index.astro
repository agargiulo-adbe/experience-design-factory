---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import Guscio from '../components/Guscio.astro';
import CoBrand from '../components/CoBrand.astro';
import Folla from '../components/Folla.astro';
import Chiasmo from '../components/Chiasmo.astro';
import { href } from '@edf/core/utils/url.js';
import { EXPERIENCE_TYPES } from '@edf/core/data/experienceTypes';
import { SITE } from '../data/site';
import { CHAPTERS } from '../data/chapters';
import { COVER } from '../data/contenuti';

/**
 * Copertina e agenda, su una pagina sola — la forma XD della Prospettiva.
 *
 * Il titolo è un chiasmo in movimento: «Ciascuno conta» (ognuno è importante)
 * diventa «Conta ciascuno» (si conta, uno per uno) scambiando di posto le due
 * parole, nella stessa riga (`Chiasmo.astro`). Niente sottotitolo che lo spieghi.
 *
 * L'agenda è generata da CHAPTERS: un capitolo in più e l'agenda lo sa.
 */
const type = EXPERIENCE_TYPES[SITE.type];
const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;
const first = CHAPTERS[0];
const last = CHAPTERS[CHAPTERS.length - 1];
---
<BaseLayout title={SITE.name}>
  <div class="fixed top-0 left-0 right-0 z-50">
    <Navigation currentPath={currentPath} base={base} />
  </div>

  <DeckContainer wallScale nextHref={href(base, '/' + first.slug)} prevHref={href(base, '/' + last.slug)}>

    <!-- ── 0 · Copertina e agenda ───────────────────────────────────────── -->
    <Slide id="slide-cover" data-audio="loud" bg="primary" align="left">
      <div slot="backdrop" class="cc-cop-bg" data-scrim>
        <Folla />
      </div>

      <div class="xd-cop" data-reveal>
        <div class="xd-cop-sx">
          <CoBrand variant="hero" class="xd-cop-lockup" data-reveal />
          <p class="xd-cop-occ" data-reveal data-reveal-delay="0.06" data-r="cover-occhiello">{COVER.occhiello}</p>
          <h1 class="xd-cop-t cc-cop-t" data-reveal data-reveal-delay="0.1"><Chiasmo /></h1>
          <p class="xd-cop-l" data-reveal data-reveal-delay="0.16">{COVER.sub}</p>
          <p class="xd-cop-tipo" data-reveal data-reveal-delay="0.22" data-r="cover-tipo">{type.coverLine.it}</p>
        </div>

        <nav class="xd-cop-dx" data-reveal data-reveal-delay="0.2" aria-label="I capitoli">
          <p class="xd-cop-occ">I capitoli</p>
          <ol class="xd-cop-indice" data-stagger>
            {CHAPTERS.map((c) => (
              <li>
                <a href={href(base, '/' + c.slug)} class="xd-cop-cap">
                  <span class="xd-cop-n" data-cap-num={c.slug}>{c.num}</span>
                  <span class="xd-cop-tit">{c.title.it}</span>
                </a>
              </li>
            ))}
          </ol>
        </nav>
      </div>
    </Slide>

    <!-- La tesi in una slide · RISERVATA: il contenuto arriva dallo strato interno -->
    <Guscio id="r-tesi" />

  </DeckContainer>
</BaseLayout>
