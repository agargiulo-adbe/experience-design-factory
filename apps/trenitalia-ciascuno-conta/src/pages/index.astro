---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import Guscio from '../components/Guscio.astro';
import CoBrand from '../components/CoBrand.astro';
import Folla from '../components/Folla.astro';
import Chiasmo from '../components/Chiasmo.astro';
import Ouverture from '../components/Ouverture.astro';
import { href } from '@edf/core/utils/url.js';
import { EXPERIENCE_TYPES } from '@edf/core/data/experienceTypes';
import { SITE } from '../data/site';
import { CHAPTERS, PRESENTAZIONE } from '../data/chapters';
import { COVER } from '../data/contenuti';

/**
 * Copertina e agenda, su una pagina sola — la forma XD della Prospettiva.
 *
 * Il titolo è un chiasmo in movimento: «Ciascuno conta» (ognuno è importante)
 * diventa «Conta ciascuno» (si conta, uno per uno) scambiando di posto le due
 * parole, nella stessa riga (`Chiasmo.astro`). Niente sottotitolo che lo spieghi.
 *
 * L'agenda è generata da CHAPTERS: un capitolo in più e l'agenda lo sa.
 */
const type = EXPERIENCE_TYPES[SITE.type];
const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;
const first = CHAPTERS[0];
const AGENDA = [...PRESENTAZIONE, CHAPTERS.find((c) => c.slug === 'annex')!];
const last = CHAPTERS[CHAPTERS.length - 1];
---
<BaseLayout title={SITE.name}>
  <!-- L'apertura: il concept a tutta pagina, poi si ritira nella copertina. -->
  <Ouverture />
  <div class="fixed top-0 left-0 right-0 z-50">
    <Navigation currentPath={currentPath} base={base} />
  </div>

  <DeckContainer wallScale nextHref={href(base, '/' + first.slug)} prevHref={href(base, '/' + last.slug)}>

    <!-- ── 0 · Copertina e agenda ───────────────────────────────────────── -->
    <Slide id="slide-cover" data-audio="loud" bg="primary" align="left">
      <div slot="backdrop" class="cc-cop-bg" data-scrim>
        <Folla />
      </div>

      <div class="xd-cop" data-reveal>
        <div class="xd-cop-sx">
          <CoBrand variant="hero" class="xd-cop-lockup" data-reveal />
          <p class="xd-cop-occ" data-reveal data-reveal-delay="0.06" data-r="cover-occhiello">{COVER.occhiello}</p>
          <h1 class="xd-cop-t cc-cop-t" data-reveal data-reveal-delay="0.1"><Chiasmo /></h1>
          <p class="xd-cop-l" data-reveal data-reveal-delay="0.16">{COVER.sub}</p>
          <p class="xd-cop-tipo" data-reveal data-reveal-delay="0.22" data-r="cover-tipo">{type.coverLine.it}</p>
          <!-- Senza token il documento non si apre: si vede solo questa copertina. -->
          <p class="cc-solo-pubblico">Si apre con il link riservato.</p>
          <button type="button" class="cc-rivedi" data-cc-rivedi data-reveal data-reveal-delay="0.28">
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M4 12a8 8 0 1 0 2.4-5.7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="M4 4v4.5h4.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Rivedi l’apertura
          </button>
        </div>

        <nav class="xd-cop-dx" data-reveal data-reveal-delay="0.2" aria-label="I capitoli">
          <p class="xd-cop-occ">I capitoli</p>
          <ol class="xd-cop-indice" data-stagger>
            {AGENDA.map((c) => (
              <li>
                <a href={href(base, '/' + c.slug)} class="xd-cop-cap">
                  <span class="xd-cop-n" data-cap-num={c.slug}>{c.slug === 'annex' ? '+' : c.num}</span>
                  <span class="xd-cop-tit">{c.title.it}</span>
                </a>
              </li>
            ))}
          </ol>
        </nav>
      </div>
    </Slide>

    <!-- L'apertura per il leadership team: la tesi, la richiesta con ciò che il sì
         avvia, perché adesso. RISERVATE: il contenuto arriva dallo strato interno. -->
    <Guscio id="r-tesi" dettaglio="numeri#r-gnarr-dettaglio" />

    <Guscio id="r-richiesta" scuro dettaglio="punti#r-annex-sintesi" />

    <Guscio id="r-linea" />

  </DeckContainer>
</BaseLayout>
