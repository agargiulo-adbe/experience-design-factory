---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import Divisore from '../components/Divisore.astro';
import { href } from '@edf/core/utils/url.js';
import { CHAPTERS, ANNEX, prevSlug, nextSlug } from '../data/chapters';
import foto from '../assets/stock/origine.webp';

/**
 * L'annex — il sommario. Viene dopo la firma: la presentazione finisce lì, e da qui
 * si scende nel dettaglio di ciascuna parte. Le slide della presentazione ci portano
 * anche direttamente, con «Il dettaglio →» (componente Dettaglio).
 * I titoli e le righe sono neutri: il contenuto riservato sta nelle pagine, dallo strato.
 */
const SLUG = 'annex';
const ch = CHAPTERS.find((c) => c.slug === SLUG)!;
const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;
---
<BaseLayout title={ch.title.it}>
  <div class="fixed top-0 left-0 right-0 z-50">
    <Navigation currentPath={currentPath} base={base} />
  </div>

  <DeckContainer wallScale nextHref={href(base, nextSlug(SLUG))} prevHref={href(base, prevSlug(SLUG))}>

    <Slide id="slide-cover" bg="primary" align="left" data-made-with="Adobe Stock" data-made-with-for="fotografia">
      <div slot="backdrop" class="xd-div-bg" style={`--foto: url(${foto.src})`}></div>
      <Divisore num={ch.num} titolo={ch.title.it} punto={ch.punto} slug={SLUG} />
    </Slide>

    <Slide id="slide-sommario" bg="primary" align="left" data-tono="scuro">
      <div slot="backdrop" class="xd-bg-piano"></div>
      <div class="xd-sl" data-reveal>
        <div class="xd-sl-head">
          <h2 class="xd-h2">Il dettaglio, in sei parti</h2>
        </div>
        <ol class="cc-sommario" data-stagger>
          {ANNEX.map((c) => (
            <li>
              <a href={href(base, '/' + c.slug)} class="cc-sommario-a">
                <span class="cc-sommario-n">{c.num}</span>
                <span class="cc-sommario-t">{c.title.it}</span>
                <span class="cc-sommario-d">{c.punto}</span>
              </a>
            </li>
          ))}
        </ol>
      </div>
    </Slide>

  </DeckContainer>
</BaseLayout>
