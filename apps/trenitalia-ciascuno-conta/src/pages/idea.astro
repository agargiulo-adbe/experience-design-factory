---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import Divisore from '../components/Divisore.astro';
import Mattina from '../components/Mattina.astro';
import Folla from '../components/Folla.astro';
import Ancore from '../components/Ancore.astro';
import { href } from '@edf/core/utils/url.js';
import foto from '../assets/generated/sole/sole-ricerca.webp';
import { CHAPTERS, prevSlug, nextSlug } from '../data/chapters';
import { MATTINA, FOLLA } from '../data/contenuti';

/**
 * Capitolo — L'idea.
 *
 * Prima l'immagine di arrivo, poi il concetto. La domanda delle nove con la
 * risposta accanto è la cosa che il programma rende possibile; la folla di punti
 * è il nome detto senza spiegarlo: ogni persona conta, e si conta.
 */
const SLUG = 'idea';
const ch = CHAPTERS.find((c) => c.slug === SLUG)!;
const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;
---
<BaseLayout title={ch.title.it}>
  <div class="fixed top-0 left-0 right-0 z-50">
    <Navigation currentPath={currentPath} base={base} />
  </div>

  <DeckContainer wallScale nextHref={href(base, nextSlug(SLUG))} prevHref={href(base, prevSlug(SLUG))}>

    <!-- ── Divisore di capitolo (il fondo sta qui: Astro non propaga slot="backdrop") -->
    <Slide id="slide-cover" bg="primary" align="left" data-made-with="Adobe Firefly" data-made-with-for="sfondo">
      <div slot="backdrop" class="xd-div-bg" style={`--foto: url(${foto.src})`}></div>
      <Divisore num={ch.num} titolo={ch.title.it} punto={ch.punto} slug={SLUG} />
    </Slide>

    <Slide id="slide-mattina" bg="primary" align="left">
      <div slot="backdrop" class="xd-bg-piano"></div>
      <div class="xd-sl cc-split" data-reveal>
        <div class="xd-sl-head">
          <p class="xd-n">{MATTINA.eyebrow}</p>
          <h2 class="xd-h2">{MATTINA.titolo}</h2>
          <p class="xd-sub">{MATTINA.sub}</p>
          <p class="cc-noi" data-r="noi-mattina"></p>
        </div>
        <div class="cc-split-fig" data-reveal data-reveal-delay="0.18"><Mattina /></div>
      </div>
    </Slide>

    <Slide id="slide-folla" bg="primary" align="left">
      <div slot="backdrop" class="xd-bg-piano cc-folla-chiara"><Folla /></div>
      <div class="xd-sl" data-reveal>
        <div class="xd-sl-head">
          <p class="xd-n">{FOLLA.eyebrow}</p>
          <h2 class="xd-h2">{FOLLA.titolo}</h2>
          <p class="xd-sub">{FOLLA.sub}</p>
        </div>
        <div class="cc-corpo">
          <Ancore items={FOLLA.ancore} cols={3} />
          <p class="xd-chiusa" data-reveal data-reveal-delay="0.24">{FOLLA.chiusa}</p>
        </div>
      </div>
    </Slide>

  </DeckContainer>
</BaseLayout>
