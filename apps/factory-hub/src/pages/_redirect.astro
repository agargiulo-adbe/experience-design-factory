---
// Shared redirect stub for old Max Mara deep links that used to live at the
// site root. Max Mara now lives under /generazioni-maxmara/, so we forward each
// old path there, preserving the query string. JS redirect + <meta refresh>
// fallback + a visible link for no-JS.
interface Props {
  /** Path segment under the maxmara base, e.g. 'acquisizione' (no slashes). */
  slug: string;
}
const { slug } = Astro.props;
const base = import.meta.env.BASE_URL;
const b = base.replace(/\/?$/, '/');
const target = `${b}generazioni-maxmara/${slug}/`;
---
<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Reindirizzamento…</title>
    <link rel="canonical" href={target} />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <script is:inline define:vars={{ target }}>
      // Preserve the query string on the way to the new subpath.
      location.replace(target + location.search);
    </script>
    <style>
      body {
        margin: 0;
        min-height: 100vh;
        display: grid;
        place-items: center;
        background: #0e0e10;
        color: #f4f4f2;
        font-family: system-ui, -apple-system, 'Segoe UI', sans-serif;
        text-align: center;
        padding: 2rem;
      }
      p { color: #a7a7a4; margin: 0 0 1rem; }
      a { color: #f4f4f2; font-weight: 600; }
    </style>
      <!-- L'anteprima del link anche qui: questa pagina è un rimando, e un vecchio
         link incollato in chat è proprio il caso in cui il riquadro grigio fa
         sembrare rotto un link che funziona. L'URL è assoluto (i crawler non
         risolvono i relativi) e punta all'og.png dell'app di destinazione. -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Generazioni — Adobe × Max Mara" />
    <meta property="og:description" content="Questo indirizzo si è spostato: Generazioni vive sotto /generazioni-maxmara/." />
    <meta property="og:locale" content="it_IT" />
    <meta property="og:image" content={new URL(`${b}og.png`, Astro.site).href} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Generazioni — Adobe × Max Mara" />
    <meta name="twitter:image" content={new URL(`${b}og.png`, Astro.site).href} />
  </head>
  <body>
    <main>
      <p>Questa pagina si è spostata.</p>
      <a href={target}>Continua verso l’esperienza →</a>
    </main>
  </body>
</html>
