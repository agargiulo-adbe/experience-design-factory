---
/**
 * RIMANDO: il vecchio indirizzo dell'experience di Intesa Sanpaolo.
 *
 * Lo slug è passato da `intesa-mutuo` a `intesa-esperienza-cliente` il
 * 30 ott 2026 — con nove capitoli, «mutuo» nell'URL riduceva l'intero
 * incontro a un prodotto. Ma il vecchio indirizzo era **già pubblicato**,
 * quindi può essere stato girato a qualcuno: senza questi stub darebbe
 * 404, ed è il modo peggiore di scoprire che un documento è stato
 * rinominato.
 *
 * Una pagina per rotta, generata da `getStaticPaths`: GitHub Pages serve
 * file statici e non conosce le riscritture, quindi ogni vecchio
 * percorso deve esistere come file. L'elenco è quello di
 * `scripts/lib/deck-routes.ts`, tenuto qui a mano perché l'hub non
 * dipende da quel modulo.
 *
 * Porta l'anteprima del link come ogni altra pagina della Factory: un
 * vecchio link incollato in chat è proprio il caso in cui il riquadro
 * grigio fa sembrare rotto un link che invece funziona.
 */
export function getStaticPaths() {
  const ROTTE = [
    undefined, 'adobe', 'scenario', 'persona', 'momenti', 'circolo',
    'coworker', 'risultati', 'analytics', 'prossimi-passi',
    'dieci-minuti', 'admin',
  ];
  return ROTTE.map((rotta) => ({ params: { rotta } }));
}

const { rotta } = Astro.params;
const base = import.meta.env.BASE_URL;
const b = base.replace(/\/?$/, '/');
const target = `${b}intesa-esperienza-cliente/${rotta ? `${rotta}/` : ''}`;
const anteprima = new URL(`${b}intesa-esperienza-cliente/og.png`, Astro.site).href;
const TITOLO = 'Adobe × Intesa Sanpaolo';
---
<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Reindirizzamento…</title>
    <link rel="canonical" href={target} />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <script is:inline define:vars={{ target }}>
      // La query string segue: i link condivisi portano `?c=`, `?s=` e `?cfg=`.
      location.replace(target + location.search);
    </script>
    <meta property="og:type" content="website" />
    <meta property="og:title" content={TITOLO} />
    <meta property="og:description" content="Questo indirizzo si è spostato: il documento vive sotto /intesa-esperienza-cliente/." />
    <meta property="og:locale" content="it_IT" />
    <meta property="og:image" content={anteprima} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={TITOLO} />
    <meta name="twitter:image" content={anteprima} />
    <style>
      body {
        margin: 0; min-height: 100vh; display: grid; place-items: center;
        background: #0d2901; color: #f2f8f0; text-align: center; padding: 2rem;
        font-family: system-ui, -apple-system, 'Segoe UI', sans-serif;
      }
      p { color: #cfe3c8; margin: 0 0 1rem; }
      a { color: #ffffff; font-weight: 600; }
    </style>
  </head>
  <body>
    <main>
      <p>Questa pagina si è spostata.</p>
      <a href={target}>Continua verso il documento →</a>
    </main>
  </body>
</html>
