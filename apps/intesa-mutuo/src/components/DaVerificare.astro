---
/**
 * DaVerificare — il punto che differenzia, chiesto invece che affermato.
 *
 * ⚠️ PERCHÉ UNA DOMANDA E NON UN'AFFERMAZIONE.
 * Serve a far notare la meccanica dove l'offerta si distingue, su una
 * slide che va davanti a una banca che ha già scelto un'altra
 * piattaforma. Un distintivo «qui siamo più bravi» farebbe tre danni:
 * chi ha firmato quella scelta passa l'ora sulla difensiva; un codice
 * decodificabile come «contro il tale» equivale ad averlo nominato, col
 * rischio e senza la franchezza; e la Storia smetterebbe di essere una
 * storia. Una domanda sul loro OGGI non fa nessuno dei tre, e chi
 * conosce il mercato arriva da solo alla conclusione — che è più forte
 * di sentirsela dire.
 *
 * E c'è una ragione di onestà: quello che «sappiamo» che oggi non fanno
 * arriva da terzi riportati in riunione. Come domanda è vero comunque;
 * come verdetto, se sbagliato, si perde lì.
 *
 * Sta SOLO sul lato interno: quello di Giulia resta racconto.
 *
 * È anche un SOTTO-PASSO a sé — il terzo, dopo Giulia e dopo chi prepara:
 * chi presenta la fa comparire se vuole farla, e tira dritto se la stanza
 * non è quella giusta. Spegnerla del tutto resta `?domande=0` o
 * `DOMANDE_IN_SLIDE` in `momenti.ts`.
 */
import T from '@edf/core/blocks/i18n/T.astro';

interface Props { it: string; en: string; class?: string }
const { it, en, class: className } = Astro.props;
---
<p class:list={['im-ver', className]} data-domanda data-substep data-side="in">
  <T as="span" class="im-ver-tag" it="Da verificare con voi" en="To check with you" />
  <T as="span" class="im-ver-q" it={it} en={en} />
</p>
