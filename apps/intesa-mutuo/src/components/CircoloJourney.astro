---
/**
 * CircoloJourney — il percorso di Giulia come CIRCOLO VIRTUOSO.
 *
 * ⚠️ PERCHÉ UN CERCHIO E NON UN BINARIO (feedback del team, 29 ott 2026).
 * Una striscia da sinistra a destra racconta una vendita: comincia e
 * finisce. Il punto invece è che il giro **si chiude e riparte meglio**:
 * quello che si impara sul percorso di Giulia migliora la relazione con
 * lei — che da qui in poi è cliente — e insieme l'acquisizione della
 * prospect dopo. Il segmento fra l'ultimo passo e il primo è quindi
 * l'elemento più importante del disegno, non un dettaglio di chiusura:
 * è marcato `data-ritorno` e porta l'accento anche a giro spento.
 *
 * ⚠️ NIENTE TESTO DENTRO L'SVG. L'anello, le frecce e i nodi sono
 * geometria; le etichette sono HTML posizionato in percentuale sopra.
 * Un testo in un disegno non cresce con la radice e su una parete di sala
 * sparisce (famiglia `S` di `audit:ritmo`). Le etichette in HTML sì, e i
 * gate di contrasto le vedono.
 *
 * Due taglie:
 *   compatto  l'anello con i numeri e, al centro, il passo acceso. Sta
 *             sulle slide dei momenti, dove lo spazio è quello che è.
 *   grande    l'anello con tutte e sette le fermate scritte intorno, e
 *             per ognuna il verbo di Giulia e la funzione per il marketer.
 */
import { MOMENTI } from '../data/momenti';
import T from '@edf/core/blocks/i18n/T.astro';

interface Props {
  /** 1–7 = la fermata accesa. 0 = il giro intero, nessuna accesa. */
  attivo?: number;
  grande?: boolean;
  /** Le sette fermate compaiono una alla volta con la freccia in basso.
      Ogni passo è UN `data-substep`: arco, freccia, nodo ed etichetta
      stanno nello stesso elemento, se no servirebbero quattro passi per
      fermata e il racconto si spezzerebbe. */
  aPassi?: boolean;
  /** Il ritratto al centro del giro. Il suggerimento che l'ha prodotto:
      «mettete Giulia al centro» — e ha ragione, perché il giro è suo e
      non del sistema. */
  ritratto?: string;
  class?: string;
}
const { attivo = 0, grande = false, aPassi = false, ritratto, class: className } = Astro.props;

const N = MOMENTI.length;
const PASSO = 360 / N;
const ang = (i: number) => (-90 + i * PASSO) * (Math.PI / 180);

/* Il raggio dei nodi, in percentuale del riquadro. Nella versione grande
   l'anello si stringe per lasciare il bordo alle etichette. */
/* ⚠️ Raggio e posizione delle etichette in PERCENTUALE del riquadro, e
   le etichette larghe una percentuale anch'esse: una larghezza in rem
   dentro un contenitore che scala in percentuale esce dal riquadro ai
   viewport stretti, ed è esattamente il `c`/`j` che l'audit ha trovato. */
const R = grande ? 23 : 40;
/* ⚠️ `ETI` non è una scelta estetica: è vincolata dalla larghezza delle
   etichette. Un'etichetta a destra occupa `ex + 0,92 × larghezza`, e deve
   stare entro il 100%. Con etichette al 20% del riquadro il massimo è
   ETI = 31: a 38 uscivano di 37px, ed è il `c`/`j` che l'audit trovava a
   tutti e tre i viewport. Se si cambia la larghezza, si rifà questo conto. */
const ETI = grande ? 31 : 0;

const nodi = MOMENTI.map((m, i) => ({
  m, i,
  x: 50 + R * Math.cos(ang(i)),
  y: 50 + R * Math.sin(ang(i)),
  ex: 50 + ETI * Math.cos(ang(i)),
  ey: 50 + ETI * Math.sin(ang(i)),
}));

/* Un ARCO per segmento, del colore del gruppo da cui parte: così i
   quattro blocchi dell'offerta si leggono come quattro archi, e il
   ritorno 07→01 resta l'unico che porta il verde pieno anche a giro
   spento. Il tratto si disegna con `stroke-dasharray` su un cerchio
   ruotato: un segmento acceso e il resto vuoto. */
const CIRC = 2 * Math.PI * R;
const archi = MOMENTI.map((m, i) => ({
  i,
  gruppo: m.gruppo,
  rot: -90 + (i + 0.5) * PASSO,
  ritorno: i === N - 1,
}));

/* Le frecce: una per segmento, a metà strada fra due nodi, ruotata sulla
   tangente. L'ultima — da 07 a 01 — è il ritorno, e si vede. */
const frecce = MOMENTI.map((m, i) => {
  const a = (-90 + (i + 0.5) * PASSO) * (Math.PI / 180);
  return {
    i,
    gruppo: m.gruppo,
    x: 50 + R * Math.cos(a),
    y: 50 + R * Math.sin(a),
    rot: (-90 + (i + 0.5) * PASSO) + 90,
    ritorno: i === N - 1,
  };
});

/* La legenda: i quattro gruppi nell'ordine in cui si incontrano. Il
   colore non porta mai l'identità da solo. */
const LEGENDA = [
  { g: 'trovare', it: 'Farsi trovare', en: 'Brand visibility' },
  { g: 'contenuto', it: 'Content Factory', en: 'Content supply chain' },
  { g: 'engagement', it: 'Customer Engagement', en: 'Customer engagement' },
  { g: 'piattaforma', it: 'AI Platform e CX Analytics', en: 'AI Platform and CX Analytics' },
] as const;

const acceso = attivo > 0 ? MOMENTI[attivo - 1] : null;
---
<figure class:list={['im-cer', grande && 'im-cer--grande', aPassi && 'im-cer--passi', className]}>
  <div class="im-cer-campo">

    {/* L'anello di guida: c'è da subito, anche a passi spenti, così il
        giro si vede come giro prima che lo si percorra. */}
    <svg class="im-cer-svg im-cer-guida" viewBox="0 0 100 100" aria-hidden="true" preserveAspectRatio="xMidYMid meet">
      <circle cx="50" cy="50" r={R} />
    </svg>

    {/* ⚠️ L'ARCO CHE COMPARE COL NODO È QUELLO CHE CI ARRIVA, non quello
        che riparte. Prima ogni passo portava il proprio arco uscente, e
        al primo ↓ si vedeva il nodo 01 con una freccia che puntava a un
        punto ancora vuoto: una freccia orfana, che chiede a chi guarda
        di immaginare la destinazione. Con l'arco entrante il giro si
        costruisce come un percorso che avanza — prima la fermata, poi la
        strada che l'ha raggiunta — e non c'è mai una freccia che punta
        al nulla.
        Il ritorno 07→01 resta fuori da questo conto e diventa un passo a
        sé, l'ultimo: è il punto della slide, e merita il suo ↓. */}
    {nodi.map((n) => {
      const a = n.i > 0 ? archi[n.i - 1] : null;
      const f = n.i > 0 ? frecce[n.i - 1] : null;
      return (
        <div class="im-cer-passo" data-substep={aPassi ? '' : null} data-side={aPassi ? 'in' : null}>
          <svg class="im-cer-svg" viewBox="0 0 100 100" aria-hidden="true" preserveAspectRatio="xMidYMid meet">
            {a && f && (
              <>
                <circle class="im-cer-arco" data-gruppo={a.gruppo}
                        cx="50" cy="50" r={R}
                        style={`--dash:${CIRC};--seg:${CIRC / N};--rot:${a.rot}deg`} />
                <path class="im-cer-fre" data-gruppo={f.gruppo}
                      d="M -2.4 -1.7 L 1.6 0 L -2.4 1.7 Z"
                      style={`transform: translate(${f.x}px, ${f.y}px) rotate(${f.rot}deg)`} />
              </>
            )}
          </svg>

          <span class="im-cer-nodo" data-gruppo={n.m.gruppo}
                data-attivo={attivo === n.i + 1 ? '' : null}
                data-fatto={attivo > n.i + 1 ? '' : null}
                style={`left:${n.x}%;top:${n.y}%`}>
            <span class="im-cer-n">{n.m.n}</span>
          </span>

          {grande && (
            <span class="im-cer-eti-i" data-gruppo={n.m.gruppo}
                  data-lato={n.ex < 44 ? 'sx' : n.ex > 56 ? 'dx' : 'cen'}
                  style={`left:${n.ex}%;top:${n.ey}%`}>
              <T as="span" class="im-cer-verbo" it={n.m.short.it} en={n.m.short.en} />
              <T as="span" class="im-cer-can" it={n.m.canale.it} en={n.m.canale.en} />
              <T as="span" class="im-cer-fun" it={n.m.funzione.it} en={n.m.funzione.en} />
              <span class="im-cer-pro">{n.m.prodotto}</span>
            </span>
          )}
        </div>
      );
    })}

    {/* Il ritorno 07→01: l'ultimo passo, da solo. «Il settimo riporta al
        primo» è la frase che regge la slide, e qui si vede succedere. */}
    <div class="im-cer-passo" data-substep={aPassi ? '' : null} data-side={aPassi ? 'in' : null}>
      <svg class="im-cer-svg" viewBox="0 0 100 100" aria-hidden="true" preserveAspectRatio="xMidYMid meet">
        <circle class="im-cer-arco" data-gruppo={archi[N - 1].gruppo} data-ritorno
                cx="50" cy="50" r={R}
                style={`--dash:${CIRC};--seg:${CIRC / N};--rot:${archi[N - 1].rot}deg`} />
        <path class="im-cer-fre" data-gruppo={frecce[N - 1].gruppo} data-ritorno
              d="M -2.4 -1.7 L 1.6 0 L -2.4 1.7 Z"
              style={`transform: translate(${frecce[N - 1].x}px, ${frecce[N - 1].y}px) rotate(${frecce[N - 1].rot}deg)`} />
      </svg>
    </div>

    {/* Il centro: Giulia, quando c'è il ritratto. Il giro è suo. */}
    <div class="im-cer-cuore" data-con-ritratto={ritratto ? '' : null}>
      {ritratto ? (
        <>
          <img class="im-cer-volto" src={ritratto} alt="" width="320" height="320" loading="eager" />
          <span class="im-cer-cuore-v">Giulia</span>
          <T as="span" class="im-cer-cuore-c" it="Non ancora cliente" en="Not a customer yet" />
        </>
      ) : acceso ? (
        <>
          <span class="im-cer-cuore-n">{acceso.n}</span>
          <T as="span" class="im-cer-cuore-v" it={acceso.short.it} en={acceso.short.en} />
          <T as="span" class="im-cer-cuore-c" it={acceso.canale.it} en={acceso.canale.en} />
          {!grande && <T as="span" class="im-cer-cuore-f" it={acceso.funzione.it} en={acceso.funzione.en} />}
        </>
      ) : (
        <T as="span" class="im-cer-cuore-l"
           it="Ogni giro migliora il prossimo"
           en="Every loop improves the next" />
      )}
    </div>
  </div>

  {grande && (
    <ol class="im-cer-leg">
      {LEGENDA.map((l) => (
        <li class="im-cer-leg-i" data-gruppo={l.g}>
          <span class="im-cer-leg-p" aria-hidden="true"></span>
          <T as="span" class="im-cer-leg-l" it={l.it} en={l.en} />
        </li>
      ))}
    </ol>
  )}
</figure>
