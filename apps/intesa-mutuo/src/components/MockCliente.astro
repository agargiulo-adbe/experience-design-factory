---
/**
 * MockCliente — lo schermo di Giulia, in quattro chrome DIVERSI.
 *
 * Perché quattro e non uno: un assistente, un feed, l'app della banca e il
 * sistema di uno sportello non si somigliano per niente, e mostrarli tutti
 * dentro la stessa cornice fa sembrare che sia sempre la stessa cosa. La
 * cornice è metà del messaggio — dice DOVE sta succedendo.
 *
 *   assistente  telefono, nessun marchio di banca: non è un vostro canale
 *   feed        telefono, un post fra gli altri
 *   app         telefono, testata verde: è casa vostra
 *   filiale     desktop, cornice da gestionale: è il posto di lavoro di un
 *               vostro collega, non un canale del cliente
 *
 * Nessuna immagine: solo geometria e token, così scala con la radice e
 * resta nitido su una parete.
 *
 * ⚠️ Il marchio non è ricostruito: il nome sta in carattere display, come
 * il ripiego wordmark del co-brand. L'SVG ufficiale non lo abbiamo.
 */
import type { ChromeCliente } from '../data/momenti';

interface Props {
  chrome: ChromeCliente;
  /** Quale schermata, dentro il chrome. */
  scena: 'ricerca' | 'feed' | 'simulazione' | 'documenti' | 'ripresa' | 'firma' | 'sportello';
  class?: string;
}
const { chrome, scena, class: className } = Astro.props;

const ORA: Record<string, string> = {
  ricerca: '21:40', feed: '08:12', simulazione: '21:48',
  documenti: '22:05', ripresa: '08:02', firma: '18:40', sportello: '11:30',
};
const telefono = chrome !== 'filiale';
---

<figure class:list={['im-cli', `im-cli--${chrome}`, className]} data-chrome={chrome}>
  <div class="im-cli-corpo">

    {telefono && (
      <div class="im-cli-barra">
        <span>{ORA[scena]}</span>
        <span class="im-cli-segnale" aria-hidden="true"><i></i><i></i><i></i></span>
      </div>
    )}

    {chrome === 'app' && (
      <div class="im-cli-testa im-cli-testa--banca"><span class="im-cli-marchio">Intesa Sanpaolo</span></div>
    )}
    {chrome === 'assistente' && (
      <div class="im-cli-testa im-cli-testa--neutra"><span class="im-cli-neutro">Assistente</span></div>
    )}
    {chrome === 'feed' && (
      <div class="im-cli-testa im-cli-testa--feed"><span class="im-cli-neutro">Per te</span></div>
    )}
    {chrome === 'filiale' && (
      <div class="im-cli-testa im-cli-testa--gest">
        <span class="im-cli-gest-tab" data-attivo>Scheda cliente</span>
        <span class="im-cli-gest-tab">Pratiche</span>
        <span class="im-cli-gest-tab">Appuntamenti</span>
      </div>
    )}

    <div class="im-cli-in">
      {scena === 'ricerca' && (
        <>
          <div class="im-cli-chat">
            <p class="im-cli-bolla im-cli-bolla--in">Qual è il mutuo migliore per chi compra la prima casa?</p>
            <p class="im-cli-bolla im-cli-bolla--out">Dipende da durata e tasso. Fra i fissi a 25 anni, tre banche hanno condizioni confrontabili:</p>
          </div>
          <ul class="im-cli-citate">
            <li data-citata>Intesa Sanpaolo</li>
            <li>Seconda banca</li>
            <li>Terza banca</li>
          </ul>
          <p class="im-cli-nota">Le tre fonti che l’assistente ha trovato e saputo leggere.</p>
        </>
      )}

      {scena === 'feed' && (
        <>
          <div class="im-cli-post">
            <div class="im-cli-post-img" aria-hidden="true"><span>Torino</span></div>
            <p class="im-cli-post-t">Il mutuo per la prima casa, a Torino</p>
            <p class="im-cli-post-b">Tasso fisso, rata che non cambia. Simula in due minuti.</p>
            <p class="im-cli-post-info">Messaggio pubblicitario · Informazioni nei fogli informativi</p>
          </div>
          <p class="im-cli-nota">Una delle dodici varianti nate dallo stesso brief.</p>
        </>
      )}

      {scena === 'simulazione' && (
        <>
          <p class="im-cli-occhiello">Simulazione mutuo</p>
          <p class="im-cli-titolo">Prima casa · 25 anni</p>
          <div class="im-cli-cifra">
            <span class="im-cli-cifra-n">742</span><span class="im-cli-cifra-u">€ al mese</span>
          </div>
          <dl class="im-cli-righe">
            <div><dt>Importo</dt><dd>180.000 €</dd></div>
            <div><dt>Tasso fisso</dt><dd>3,10%</dd></div>
            <div><dt>Riservato ai clienti</dt><dd>−0,20%</dd></div>
          </dl>
          <p class="im-cli-cta">Salva e continua</p>{/* copy-audit-ignore V1 — messaggio dell'app ALLA cliente, non voce del deck. */}
        </>
      )}

      {scena === 'documenti' && (
        <>
          <p class="im-cli-occhiello">La tua richiesta</p>{/* copy-audit-ignore V1 — messaggio dell'app ALLA cliente. */}
          <p class="im-cli-titolo">Mancano i documenti</p>
          <ul class="im-cli-passi">
            <li data-stato="fatto">Dati anagrafici</li>
            <li data-stato="fatto">Immobile</li>
            <li data-stato="aperto">Ultime due buste paga</li>
            <li data-stato="attesa">Firma</li>
          </ul>
          <p class="im-cli-nota">Caricali entro 30 giorni per non perdere la simulazione.</p>{/* copy-audit-ignore V1 — messaggio dell'app ALLA cliente. */}
        </>
      )}

      {scena === 'ripresa' && (
        <>
          <div class="im-cli-notifica">
            <p class="im-cli-notifica-t">La tua richiesta è ancora valida</p>{/* copy-audit-ignore V1 — messaggio dell'app ALLA cliente. */}
            <p class="im-cli-notifica-b">Riprendi da dove eri: manca solo la busta paga.</p>{/* copy-audit-ignore V1 — messaggio dell'app ALLA cliente. */}
          </div>
          <p class="im-cli-occhiello">Ripresa</p>
          <p class="im-cli-titolo">Prima casa · 742 € al mese</p>
          <ul class="im-cli-passi">
            <li data-stato="fatto">Buste paga caricate</li>
            <li data-stato="aperto">Appuntamento col gestore</li>
          </ul>
        </>
      )}

      {scena === 'firma' && (
        <>
          <p class="im-cli-occhiello">La tua pratica</p>{/* copy-audit-ignore V1 — messaggio dell'app ALLA cliente. */}
          <p class="im-cli-titolo">Mutuo erogato</p>
          <dl class="im-cli-righe">
            <div><dt>Rata</dt><dd>742 €/mese</dd></div>
            <div><dt>Durata</dt><dd>25 anni</dd></div>
            <div><dt>Firmato il</dt><dd>18 nov</dd></div>
          </dl>
          <div class="im-cli-notifica">
            <p class="im-cli-notifica-t">Tutto fatto</p>
            <p class="im-cli-notifica-b">La documentazione è nell’area riservata.</p>
          </div>
        </>
      )}

      {scena === 'sportello' && (
        <div class="im-cli-gest">
          <div class="im-cli-gest-col">
            <p class="im-cli-occhiello">Cliente</p>
            <p class="im-cli-gest-nome">Giulia Marchetti</p>
            <dl class="im-cli-righe">
              <div><dt>Cliente dal</dt><dd>2020</dd></div>
              <div><dt>Appuntamento</dt><dd>oggi, 11:30</dd></div>
              <div><dt>Motivo</dt><dd>mutuo prima casa</dd></div>
            </dl>
          </div>
          <div class="im-cli-gest-col">
            <p class="im-cli-occhiello">Già fatto da lei</p>
            <ul class="im-cli-passi">
              <li data-stato="fatto">Simulazione · 742 €/mese</li>
              <li data-stato="fatto">Documenti caricati</li>
              <li data-stato="aperto">Da firmare in sede</li>
            </ul>
            <p class="im-cli-nota">Arriva dal profilo, via API. Nessun doppio inserimento.</p>
          </div>
        </div>
      )}
    </div>
  </div>

  <figcaption class="im-mock-cap">
    {chrome === 'assistente'
      ? 'Ricostruzione illustrativa di un assistente di terze parti: non è un vostro canale.'
      : chrome === 'feed'
        ? 'Ricostruzione illustrativa: il formato è della piattaforma, il contenuto è vostro.'
        : 'Ricostruzione illustrativa: il sistema è vostro, i numeri sono di esempio.'}
  </figcaption>
</figure>
