---
/**
 * MockAdobe — quello che vede chi prepara la campagna, dentro gli strumenti.
 *
 * Qui il prodotto è NOSTRO, quindi si può mostrare per quello che è: niente
 * «ricostruzione illustrativa» da dichiarare sull'interfaccia, solo la
 * cautela sui dati, che sono di esempio.
 *
 * I nomi di prodotto sono quelli veri e per esteso: il cliente li ritroverà
 * in un'offerta e su Experience League, e un nome inventato in pagina
 * sembrerebbe una cosa nascosta. «Offer Decisioning» è il nome corretto —
 * «AI Decisioning» non è un prodotto, è una capacità dentro Journey Optimizer.
 */
interface Props {
  scena: 'misura' | 'profilo' | 'decisione';
  class?: string;
}
const { scena, class: className } = Astro.props;

const TESTATA = {
  misura: 'Adobe Customer Journey Analytics',
  profilo: 'Adobe Real-Time CDP',
  decisione: 'Adobe Journey Optimizer · Offer Decisioning',
}[scena];

/* Il funnel della misura: quante pratiche arrivano a ogni passo. Le altezze
   sono percentuali del primo passo, così la barra dice il rapporto e non un
   numero assoluto che nessuno può verificare. */
const FUNNEL = [
  { l: 'Simulazioni avviate', v: 100, n: '12.400' },
  { l: 'Richieste salvate', v: 54, n: '6.700' },
  { l: 'Documenti caricati', v: 23, n: '2.900' },
  { l: 'Pratiche concluse', v: 17, n: '2.100' },
];

const OFFERTE = [
  { l: 'Email con la simulazione', s: 'scartata' },
  { l: 'Promemoria documenti', s: 'scartata' },
  { l: 'Richiamo del gestore, oggi', s: 'scelta' },
  { l: 'Offerta surroga', s: 'esclusa' },
  { l: 'Polizza casa', s: 'esclusa' },
];
---

<figure class:list={['im-ado', className]} data-scena={scena}>
  <div class="im-ado-corpo">
    <div class="im-ado-testa">
      <span class="im-ado-punti" aria-hidden="true"><i></i><i></i><i></i></span>
      <span class="im-ado-nome">{TESTATA}</span>
    </div>

    {scena === 'misura' && (
      <div class="im-ado-in">
        <p class="im-ado-occhiello">Percorso · richiesta di mutuo · ultimi 30 giorni</p>
        <div class="im-ado-funnel">
          {FUNNEL.map((f) => (
            <div class="im-ado-barra">
              <span class="im-ado-barra-l">{f.l}</span>
              <span class="im-ado-barra-t"><i style={`width:${f.v}%`}></i></span>
              <span class="im-ado-barra-n">{f.n}</span>
            </div>
          ))}
        </div>
        <p class="im-ado-rilievo">
          Fra «documenti caricati» e «pratiche concluse» si perde il passo più
          caro: qui la pratica è già pagata e non è ancora un cliente.
        </p>
      </div>
    )}

    {scena === 'profilo' && (
      <div class="im-ado-in">
        <p class="im-ado-occhiello">Profilo unico · aggiornato 2 secondi fa</p>
        <div class="im-ado-prof">
          <div class="im-ado-prof-id">
            <span class="im-ado-chip">app</span>
            <span class="im-ado-chip">sito</span>
            <span class="im-ado-chip">contact center</span>
            <span class="im-ado-chip">filiale</span>
          </div>
          <p class="im-ado-prof-t">Una persona sola, quattro tracce</p>
          <dl class="im-ado-righe">
            <div><dt>Consenso marketing</dt><dd>sì · 14 mar 2026</dd></div>
            <div><dt>Score dal vostro motore</dt><dd>propensione mutuo 0,78</dd></div>
            <div><dt>Ultimo evento</dt><dd>pratica ferma su reddito</dd></div>
          </dl>
        </div>
        <p class="im-ado-rilievo">
          Lo score resta vostro: il profilo lo riceve, non lo ricalcola.
        </p>
      </div>
    )}

    {scena === 'decisione' && (
      <div class="im-ado-in">
        <p class="im-ado-occhiello">Decisione · un contatto, cinque candidate</p>
        <ul class="im-ado-off">
          {OFFERTE.map((o) => (
            <li data-stato={o.s}>
              <span>{o.l}</span>
              <em>{o.s === 'scelta' ? 'parte' : o.s === 'esclusa' ? 'fuori tetto' : 'non ora'}</em>
            </li>
          ))}
        </ul>
        <p class="im-ado-rilievo">
          Il tetto di contatto è un vincolo dell’offerta, valutato qui: non un
          filtro applicato dopo, in attivazione.
        </p>
      </div>
    )}
  </div>
  <figcaption class="im-mock-cap">Dati di esempio.</figcaption>
</figure>
