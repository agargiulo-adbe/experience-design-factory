---
/**
 * La copertina della Storia — slide sequenziali.
 *
 * Il tipo di deliverable è la prima cosa che si legge, e la riga la rende
 * `EXPERIENCE_TYPES[type].coverLine`: mai una stringa a mano.
 * Il lockup co-brand `hero` sta sulla PRIMA e sull'ULTIMA slide del
 * percorso (qui e sulla slide-firma di `risultati`), ed è regola del motore.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import CoBrand from '../components/CoBrand.astro';
import LoopVideo from '@edf/core/blocks/immersive/LoopVideo.astro';
import T from '@edf/core/blocks/i18n/T.astro';
import { href } from '@edf/core/utils/url.js';
import { EXPERIENCE_TYPES } from '@edf/core/data/experienceTypes';
import { SITE } from '../data/site';
import { CHAPTERS } from '../data/chapters';
import { MOMENTI } from '../data/momenti';

const type = EXPERIENCE_TYPES[SITE.type];
const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;
const first = CHAPTERS[0];
/* La clip sta sul Release `media`, ricucita con `pnpm loop:seamless` perché
   il giro non faccia stacco. Il poster è in `public/`, così la copertina è
   già composta prima che la rete risponda. */
const CLIP = 'https://github.com/agargiulo-adbe/experience-design-factory/releases/download/media';
const last = CHAPTERS[CHAPTERS.length - 1];
---
<BaseLayout title={SITE.name}>
  <div class="fixed top-0 left-0 right-0 z-50">
    <Navigation currentPath={currentPath} base={base} />
  </div>

  <DeckContainer nextHref={href(base, '/' + first.slug)} prevHref={href(base, '/' + last.slug)}>

    <Slide id="slide-cover" bg="inverse" align="center"
           data-made-with="Adobe Firefly" data-made-with-for="clip" data-audio="loud">
      <LoopVideo slot="backdrop" src={`${CLIP}/innesto-cover.loop.mp4`}
                 poster={`${base}media/innesto-cover.poster.jpg`}
                 scrim="im-clip-scrim" opacity={1} />
      <div class="im-cov im-cov--grande" data-reveal>
        <CoBrand variant="hero" class="im-cov-lockup edf-cobrand--on-dark" data-reveal />
        {/* ⚠️ Da quando questo documento ingloba il deck del 5 novembre, la
            copertina non è più quella di una Storia dentro un incontro: è
            la copertina dell'INCONTRO. Quindi dice prima di tutto quando
            succede e fra chi — che è la prima cosa che cerca chi riapre il
            link due settimane dopo. */}
        <T as="p" class="im-cov-occ" it="Incontro del 5 novembre 2026" en="Meeting of 5 November 2026" data-reveal data-reveal-delay="0.06" />
        {/* ⚠️ Il titolo di copertina NON ripete il nome del percorso: in
            pagina quel nome sta già nella barra, due righe sopra, e
            leggerlo due volte fa sembrare la copertina un segnaposto.
            Qui sta la premessa, che è la notizia di questa versione. */}
        <T as="h1" class="im-cov-t" it="Il mutuo di una persona che non vi conosce ancora" en="The mortgage of someone who does not know you yet" data-reveal data-reveal-delay="0.1" />
        <T as="p" class="im-cov-l"
           it="Una persona che cerca casa e non è ancora vostra cliente, e chi deve decidere che cosa dirle. Gli stessi sette momenti, dalle due parti dello schermo."
           en="Someone looking for a home who is not your customer yet, and whoever decides what to tell her. The same seven moments, from both sides of the screen."
           data-reveal data-reveal-delay="0.18" />
        {/* Tre fatti e i quattro blocchi: la copertina dice che cosa c'è
            dentro prima che si entri, e si riempie di senso invece che
            di decorazione. */}
        <ul class="im-cov-meta" data-reveal data-reveal-delay="0.24">
          <li><strong>6</strong><T as="span" it="capitoli" en="chapters" /></li>
          <li><strong>7</strong><T as="span" it="momenti" en="moments" /></li>
          <li><strong>2</strong><T as="span" it="viste, sulla stessa slide" en="views, on the same slide" /></li>
        </ul>
        <ol class="im-cov-blocchi" data-stagger>
          <li data-gruppo="trovare"><span class="im-cov-p" aria-hidden="true"></span><T as="span" it="Farsi trovare nell’era dell’AI" en="Being found in the age of AI" /></li>
          <li data-gruppo="engagement"><span class="im-cov-p" aria-hidden="true"></span><T as="span" it="Ingaggiare il cliente" en="Engaging the customer" /></li>
          <li data-gruppo="contenuto"><span class="im-cov-p" aria-hidden="true"></span><T as="span" it="Content Factory" en="Content factory" /></li>
          <li data-gruppo="piattaforma"><span class="im-cov-p" aria-hidden="true"></span><T as="span" it="Analisi omnicanale" en="Omnichannel analytics" /></li>
        </ol>
        <T as="p" class="im-cov-n" it={type.coverLine.it} en={type.coverLine.en} data-reveal data-reveal-delay="0.3" />
        {/* ⚠️ Il credito è un FATTO, non una decorazione: si dichiara solo
            ciò che è stato davvero usato, e il `provenance.json` dice che
            le fotografie sono stock licenziato e che solo le due clip —
            apertura e chiusura — sono generate. Scrivere «Adobe Firefly»
            su tutto sarebbe una dichiarazione falsa. */}
        <T as="p" class="im-cov-cred" data-reveal data-reveal-delay="0.34"
           it="Clip di apertura e chiusura generate con Adobe Firefly, con Content Credentials. Fotografie da stock licenziato, autore e licenza in provenance.json. Schermate ricostruite a mano."
           en="Opening and closing clips generated with Adobe Firefly, with Content Credentials. Photographs from licensed stock, author and licence in provenance.json. Screens reconstructed by hand." />
      </div>
    </Slide>

    <Slide id="slide-percorso" bg="primary" align="center">
      <div class="im-perc" data-reveal>
        <T as="p" class="slide-eyebrow" it="Il percorso" en="The path" />
        <T as="h2" class="im-perc-t" it={type.question.it} en={type.question.en} data-reveal data-reveal-delay="0.08" />
        <T as="p" class="im-perc-l"
           it="Sei capitoli: chi è Adobe, una persona sola, e l’intero spettro dell’offerta. I momenti si vedono dalla piattaforma, non si raccontano a parole."
           en="Six chapters: who Adobe is, one person, and the full span of the offer. The moments are seen from the platform, not told in words."
           data-reveal data-reveal-delay="0.14" />
        <div class="im-indice" data-stagger>
          {CHAPTERS.map((c) => (
            <a href={href(base, '/' + c.slug)} class="im-indice-c">
              <p class="im-indice-n">{c.num}</p>
              <p class="im-indice-t"><span data-lang-it>{c.title.it}</span><span data-lang-en>{c.title.en}</span></p>
            </a>
          ))}
        </div>
      </div>
    </Slide>

  </DeckContainer>
</BaseLayout>
