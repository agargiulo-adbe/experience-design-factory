---
/**
 * La copertina della Storia — slide sequenziali.
 *
 * Il tipo di deliverable è la prima cosa che si legge, e la riga la rende
 * `EXPERIENCE_TYPES[type].coverLine`: mai una stringa a mano.
 * Il lockup co-brand `hero` sta sulla PRIMA e sull'ULTIMA slide del
 * percorso (qui e sulla slide-firma di `risultati`), ed è regola del motore.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import CoBrand from '../components/CoBrand.astro';
import T from '@edf/core/blocks/i18n/T.astro';
import { href } from '@edf/core/utils/url.js';
import { EXPERIENCE_TYPES } from '@edf/core/data/experienceTypes';
import { SITE } from '../data/site';
import { CHAPTERS } from '../data/chapters';

const type = EXPERIENCE_TYPES[SITE.type];
const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;
const first = CHAPTERS[0];
const last = CHAPTERS[CHAPTERS.length - 1];
---
<BaseLayout title={SITE.name}>
  <div class="fixed top-0 left-0 right-0 z-50">
    <Navigation currentPath={currentPath} base={base} />
  </div>

  <DeckContainer nextHref={href(base, '/' + first.slug)} prevHref={href(base, '/' + last.slug)}>

    <Slide id="slide-cover" bg="inverse" align="center">
      <div slot="backdrop" class="im-bg-notte"></div>
      <div class="im-cov" data-reveal>
        <CoBrand variant="hero" class="im-cov-lockup edf-cobrand--on-dark" data-reveal />
        <T as="h1" class="im-cov-t" it="Lo stesso mutuo, dai due lati" en="The same mortgage, from both sides" data-reveal data-reveal-delay="0.1" />
        <T as="p" class="im-cov-l"
           it="Una cliente che cerca casa, e chi deve decidere che cosa dirle. Gli stessi quattro momenti, dalle due parti dello schermo."
           en="A customer looking for a home, and whoever decides what to tell her. The same four moments, from both sides of the screen."
           data-reveal data-reveal-delay="0.18" />
        <T as="p" class="im-cov-n" it={type.coverLine.it} en={type.coverLine.en} data-reveal data-reveal-delay="0.26" />
      </div>
    </Slide>

    <Slide id="slide-percorso" bg="primary" align="center">
      <div class="im-perc" data-reveal>
        <T as="p" class="slide-eyebrow" it="Il percorso" en="The path" />
        <T as="h2" class="im-perc-t" it={type.question.it} en={type.question.en} data-reveal data-reveal-delay="0.08" />
        <T as="p" class="im-perc-l"
           it="Cinque capitoli, una persona sola. I momenti si vedono dalla piattaforma, non si raccontano a parole."
           en="Five chapters, one person. The moments are seen from the platform, not told in words."
           data-reveal data-reveal-delay="0.14" />
        <div class="im-indice" data-stagger>
          {CHAPTERS.map((c) => (
            <a href={href(base, '/' + c.slug)} class="im-indice-c">
              <p class="im-indice-n">{c.num}</p>
              <p class="im-indice-t"><span data-lang-it>{c.title.it}</span><span data-lang-en>{c.title.en}</span></p>
            </a>
          ))}
        </div>
      </div>
    </Slide>

  </DeckContainer>
</BaseLayout>
