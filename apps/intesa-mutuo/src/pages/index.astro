---
/**
 * La copertina della Storia — slide sequenziali.
 *
 * Il tipo di deliverable è la prima cosa che si legge, e la riga la rende
 * `EXPERIENCE_TYPES[type].coverLine`: mai una stringa a mano.
 * Il lockup co-brand `hero` sta sulla PRIMA e sull'ULTIMA slide del
 * percorso (qui e sulla slide-firma di `risultati`), ed è regola del motore.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import CoBrand from '../components/CoBrand.astro';
import LoopVideo from '@edf/core/blocks/immersive/LoopVideo.astro';
import T from '@edf/core/blocks/i18n/T.astro';
import { href } from '@edf/core/utils/url.js';
import { EXPERIENCE_TYPES } from '@edf/core/data/experienceTypes';
import { SITE } from '../data/site';
import { CHAPTERS } from '../data/chapters';
import { MOMENTI } from '../data/momenti';

const type = EXPERIENCE_TYPES[SITE.type];
const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;
const first = CHAPTERS[0];
/* La clip sta sul Release `media`, ricucita con `pnpm loop:seamless` perché
   il giro non faccia stacco. Il poster è in `public/`, così la copertina è
   già composta prima che la rete risponda. */
const CLIP = 'https://github.com/agargiulo-adbe/experience-design-factory/releases/download/media';
const last = CHAPTERS[CHAPTERS.length - 1];
---
<BaseLayout title={SITE.name}>
  <div class="fixed top-0 left-0 right-0 z-50">
    <Navigation currentPath={currentPath} base={base} />
  </div>

  <DeckContainer nextHref={href(base, '/' + first.slug)} prevHref={href(base, '/' + last.slug)}>

    {/* ⚠️ LA COPERTINA DELL'INCONTRO, NON DELLA SOLA STORIA.
        Da quando questo documento ingloba il deck del 5 novembre, la
        copertina ha un secondo mestiere: dire **che cosa c'è dentro**.
        Nel `.pptx` quel mestiere lo facevano otto slide «Agenda»
        ripetute fra un capitolo e l'altro — qui l'indice sta in
        copertina, una volta sola, ed è cliccabile.
        Il titolo resta quello della Storia perché è il filo che tiene
        insieme i sei capitoli: il capitolo su Adobe è la premessa, non
        il tema. */}
    <Slide id="slide-cover" bg="inverse" align="left"
           data-made-with="Adobe Firefly" data-made-with-for="clip" data-audio="loud">
      <LoopVideo slot="backdrop" src={`${CLIP}/innesto-cover.loop.mp4`}
                 poster={`${base}media/innesto-cover.poster.jpg`}
                 scrim="im-clip-scrim" opacity={1} />

      <div class="im-cop" data-reveal>
        <div class="im-cop-sx">
          <CoBrand variant="hero" class="im-cop-lockup edf-cobrand--on-dark" data-reveal />
          <T as="p" class="im-cov-occ" it="Incontro del 5 novembre 2026" en="Meeting of 5 November 2026" data-reveal data-reveal-delay="0.06" />
          <T as="h1" class="im-cop-t" it="Il mutuo di una persona che non vi conosce ancora" en="The mortgage of someone who does not know you yet" data-reveal data-reveal-delay="0.1" />
          <T as="p" class="im-cop-l"
             it="Una persona che cerca casa e non è ancora vostra cliente, e chi deve decidere che cosa dirle. Gli stessi sette momenti, dalle due parti dello schermo."
             en="Someone looking for a home who is not your customer yet, and whoever decides what to tell her. The same seven moments, from both sides of the screen."
             data-reveal data-reveal-delay="0.16" />
          <T as="p" class="im-cop-tipo" it={type.coverLine.it} en={type.coverLine.en} data-reveal data-reveal-delay="0.22" />
          {/* Il credito è un FATTO: solo le due clip sono generate, le
              fotografie vengono da stock licenziato. Scrivere «Firefly»
              su tutto sarebbe una dichiarazione falsa. */}
          <T as="p" class="im-cop-cred" data-reveal data-reveal-delay="0.28"
             it="Clip di apertura e chiusura generate con Adobe Firefly, con Content Credentials. Fotografie da stock licenziato, autore e licenza in provenance.json."
             en="Opening and closing clips generated with Adobe Firefly, with Content Credentials. Photographs from licensed stock, author and licence in provenance.json." />
        </div>

        <nav class="im-cop-dx" data-reveal data-reveal-delay="0.2" aria-label="Il percorso">
          <T as="p" class="im-cop-occ" it="Che cosa c’è dentro" en="What is inside" />
          <ol class="im-cop-indice" data-stagger>
            {CHAPTERS.map((c) => (
              <li>
                <a href={href(base, '/' + c.slug)} class="im-cop-cap">
                  <span class="im-cop-n">{c.num}</span>
                  <span class="im-cop-tit"><span data-lang-it>{c.title.it}</span><span data-lang-en>{c.title.en}</span></span>
                </a>
              </li>
            ))}
          </ol>
          <T as="p" class="im-cop-dom" it={type.question.it} en={type.question.en} />
        </nav>
      </div>

    </Slide>

  </DeckContainer>
</BaseLayout>
