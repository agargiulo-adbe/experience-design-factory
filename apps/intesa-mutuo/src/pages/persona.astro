---
/**
 * La persona — Giulia, e i sette momenti che seguiremo.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import T from '@edf/core/blocks/i18n/T.astro';
import { href } from '@edf/core/utils/url.js';
import { CHAPTERS, prevSlug, nextSlug } from '../data/chapters';
import { MOMENTI } from '../data/momenti';
import ritratto from '../assets/generated/persona-giulia.webp';

const SLUG = 'persona';
const ch = CHAPTERS.find((c) => c.slug === SLUG)!;
const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;
---
<BaseLayout title={ch.title.it}>
  <div class="fixed top-0 left-0 right-0 z-50">
    <Navigation currentPath={currentPath} base={base} />
  </div>

  <DeckContainer nextHref={href(base, nextSlug(SLUG))} prevHref={href(base, prevSlug(SLUG))}>

    <Slide id="slide-cover" bg="inverse" align="center">
      <div slot="backdrop" class="im-bg-notte"></div>
      <div class="im-ch" data-reveal>
        <p class="im-ch-num"><span data-lang-it>Capitolo {ch.num}</span><span data-lang-en>Chapter {ch.num}</span></p>
        <T as="h2" class="im-ch-t" it="Giulia, 34 anni, già vostra cliente" en="Giulia, 34, already your customer" data-reveal data-reveal-delay="0.08" />
        <T as="p" class="im-ch-l" it="Non è difficile da raggiungere: è già dentro. È il momento in cui vi chiede qualcosa di grosso." en="She is not hard to reach: she is already inside. This is when she asks you for something big." data-reveal data-reveal-delay="0.15" />
      </div>
    </Slide>

    <Slide id="slide-giulia" bg="primary" align="split">
      <div class="im-pers" data-reveal>
        <figure class="im-pers-foto">
          <img src={ritratto.src} width={ritratto.width} height={ritratto.height}
               alt="Giulia Marchetti, 34 anni, cliente Intesa Sanpaolo da sei anni"
               loading="eager" decoding="async" />
          <span class="im-pers-scrim" data-scrim aria-hidden="true"></span>
          <figcaption class="im-pers-meta">
            <span class="im-pers-nome">Giulia Marchetti</span>
            <span class="im-pers-sub"><span data-lang-it>34 anni · cliente da sei anni · Torino</span><span data-lang-en>34 · six years a customer · Turin</span></span>
          </figcaption>
        </figure>
        <div class="im-pan">
          <T as="p" class="im-pan-tag" it="La protagonista" en="The lead character" />
          <T as="p" class="im-pan-b"
             it="Conto da sei anni, stipendio accreditato, nessun prodotto oltre la carta. Non conosce nessuno dei sistemi che state per vedere: vive solo quello che fanno."
             en="Six years with the account, salary paid in, no product beyond the card. She knows none of the systems you are about to see: she only lives what they do." />
          <T as="p" class="im-pan-q"
             it="Sta comprando casa. Sette momenti in tre settimane, e in quattro di questi sette oggi non succede niente."
             en="She is buying a home. Seven moments across three weeks, and in four of those seven nothing happens today." />
          <ol class="im-passi" data-stagger>
            {MOMENTI.map((m) => (
              <li class="im-passi-i">
                <span class="im-passi-n">{m.n}</span>
                <T as="p" class="im-passi-l" it={m.short.it} en={m.short.en} />
              </li>
            ))}
          </ol>
        </div>
      </div>
    </Slide>

  </DeckContainer>
</BaseLayout>
