---
/**
 * La persona — Giulia, e i sette momenti che seguiremo.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import T from '@edf/core/blocks/i18n/T.astro';
import Divisore from '../components/Divisore.astro';
import { href } from '@edf/core/utils/url.js';
import { CHAPTERS, prevSlug, nextSlug } from '../data/chapters';
import CircoloJourney from '../components/CircoloJourney.astro';
import ritratto from '../assets/generated/persona-giulia.webp';

const SLUG = 'persona';
const ch = CHAPTERS.find((c) => c.slug === SLUG)!;
const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;
---
<BaseLayout title={ch.title.it}>
  <div class="fixed top-0 left-0 right-0 z-50">
    <Navigation currentPath={currentPath} base={base} />
  </div>

  <DeckContainer nextHref={href(base, nextSlug(SLUG))} prevHref={href(base, prevSlug(SLUG))}>

    <Slide id="slide-cover" bg="secondary" align="left">
      <div slot="backdrop" class="im-div-bg" style={`--foto: url(${ritratto.src}); --fuoco: center 20%`}></div>
      <Divisore num={ch.num}
        tIt="Giulia, 34 anni, non è vostra cliente" tEn="Giulia, 34, and not your customer"
        lIt="Non potete notificarla, non è nel CRM, e la stessa domanda l’ha fatta ad altre due banche." lEn="You cannot notify her, she is not in the CRM, and she asked two other banks the same question." />
    </Slide>

    {/* ⚠️ UNA SLIDE SOLA, con Giulia al centro del giro.
        Erano due: il ritratto con quello che di lei non avete, e il
        cerchio delle sette fermate. Separate, chi guardava doveva tenere
        a mente la prima mentre leggeva la seconda — e il giro sembrava
        del sistema invece che suo. Al centro dell'anello il ritratto dice
        di chi è il percorso prima di qualunque etichetta.
        Le sette fermate compaiono una alla volta con la freccia in basso:
        il giro si costruisce davanti a chi guarda. */}
    <Slide id="slide-giro-di-giulia" bg="inverse" align="center">
      <div slot="backdrop" class="im-bg-notte"></div>
      <div class="im-cerslide im-cerslide--persona" data-reveal>
        <header class="im-cerslide-testa">
          <T as="p" class="im-mom-blocco" it="La protagonista, e il suo giro" en="The lead character, and her loop" />
          <T as="h2" class="im-cerslide-t" it="Sette momenti in tre settimane, e il settimo riporta al primo" en="Seven moments across three weeks, and the seventh leads back to the first" data-reveal data-reveal-delay="0.08" />
        </header>

        {/* Quello che di lei NON avete: è la premessa del giro, e sta
            accanto all'anello invece che su una slide sua. */}
        <ul class="im-manca im-manca--lato" data-reveal data-reveal-delay="0.14">
          <li class="im-manca-i"><span class="im-manca-x" aria-hidden="true"></span><T as="span" class="im-manca-l" it="Nessun profilo nel CRM" en="No CRM record" /></li>
          <li class="im-manca-i"><span class="im-manca-x" aria-hidden="true"></span><T as="span" class="im-manca-l" it="Nessuna app da notificare" en="No app to notify" /></li>
          <li class="im-manca-i"><span class="im-manca-x" aria-hidden="true"></span><T as="span" class="im-manca-l" it="Nessuno storico su cui modellare" en="No history to model on" /></li>
          <li class="im-manca-i" data-si><span class="im-manca-v" aria-hidden="true"></span><T as="span" class="im-manca-l" it="Due sere di navigazione anonima" en="Two evenings browsing anonymously" /></li>
        </ul>

        <CircoloJourney grande aPassi ritratto={ritratto.src} data-reveal data-reveal-delay="0.16" />

        <T as="p" class="im-cerslide-l" it="Fino al settimo momento l’unico modo di raggiungerla è un indirizzo che deve ancora darvi." en="Until the seventh moment the only way to reach her is an address she has yet to give you." data-reveal data-reveal-delay="0.26" />
      </div>
    </Slide>

  </DeckContainer>
</BaseLayout>
