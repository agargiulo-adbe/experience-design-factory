---
/**
 * La persona — Giulia, e i sette momenti che seguiremo.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import T from '@edf/core/blocks/i18n/T.astro';
import { href } from '@edf/core/utils/url.js';
import { CHAPTERS, prevSlug, nextSlug } from '../data/chapters';
import CircoloJourney from '../components/CircoloJourney.astro';
import ritratto from '../assets/generated/persona-giulia.webp';

const SLUG = 'persona';
const ch = CHAPTERS.find((c) => c.slug === SLUG)!;
const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;
---
<BaseLayout title={ch.title.it}>
  <div class="fixed top-0 left-0 right-0 z-50">
    <Navigation currentPath={currentPath} base={base} />
  </div>

  <DeckContainer nextHref={href(base, nextSlug(SLUG))} prevHref={href(base, prevSlug(SLUG))}>

    <Slide id="slide-cover" bg="inverse" align="center">
      <div slot="backdrop" class="im-bg-notte"></div>
      <div class="im-ch" data-reveal>
        <p class="im-ch-num"><span data-lang-it>Capitolo {ch.num}</span><span data-lang-en>Chapter {ch.num}</span></p>
        <T as="h2" class="im-ch-t" it="Giulia, 34 anni, non è vostra cliente" en="Giulia, 34, and not your customer" data-reveal data-reveal-delay="0.08" />
        <T as="p" class="im-ch-l" it="Non potete notificarla, non è nel CRM, e la stessa domanda l’ha fatta ad altre due banche." en="You cannot notify her, she is not in the CRM, and she asked two other banks the same question." data-reveal data-reveal-delay="0.15" />
      </div>
    </Slide>

    <Slide id="slide-giulia" bg="primary" align="split">
      <div class="im-pers" data-reveal>
        <figure class="im-pers-foto">
          <img src={ritratto.src} width={ritratto.width} height={ritratto.height}
               alt="Giulia Marchetti, 34 anni, non ancora cliente di Intesa Sanpaolo"
               loading="eager" decoding="async" />
          <span class="im-pers-scrim" data-scrim aria-hidden="true"></span>
          <figcaption class="im-pers-meta">
            <span class="im-pers-nome">Giulia Marchetti</span>
            <span class="im-pers-sub"><span data-lang-it>34 anni · Torino · non ancora cliente</span><span data-lang-en>34 · Turin · not a customer yet</span></span>
          </figcaption>
        </figure>
        <div class="im-pan">
          <T as="p" class="im-pan-tag" it="La protagonista" en="The lead character" />
          <ul class="im-manca" data-stagger>
            <li class="im-manca-i"><span class="im-manca-x" aria-hidden="true"></span><T as="span" class="im-manca-l" it="Nessun profilo nel CRM" en="No CRM record" /></li>
            <li class="im-manca-i"><span class="im-manca-x" aria-hidden="true"></span><T as="span" class="im-manca-l" it="Nessuna app da notificare" en="No app to notify" /></li>
            <li class="im-manca-i"><span class="im-manca-x" aria-hidden="true"></span><T as="span" class="im-manca-l" it="Nessuno storico su cui modellare" en="No history to model on" /></li>
            <li class="im-manca-i" data-si><span class="im-manca-v" aria-hidden="true"></span><T as="span" class="im-manca-l" it="Due sere di navigazione anonima" en="Two evenings browsing anonymously" /></li>
          </ul>
          <T as="p" class="im-pan-q"
             it="Sta comprando casa. Sette momenti in tre settimane, e fino al settimo l’unico modo di raggiungerla è un indirizzo che deve ancora darvi."
             en="She is buying a home. Seven moments across three weeks, and until the seventh the only way to reach her is an address she has yet to give you." />
        </div>
      </div>
    </Slide>

    <Slide id="slide-giro-di-giulia" bg="inverse" align="center">
      <div slot="backdrop" class="im-bg-notte"></div>
      <div class="im-cerslide" data-reveal>
        <T as="p" class="im-mom-blocco" it="Il percorso, in un giro" en="The path, as one loop" />
        <T as="h2" class="im-cerslide-t" it="Sette momenti, e il settimo riporta al primo" en="Seven moments, and the seventh leads back to the first" data-reveal data-reveal-delay="0.08" />
        <CircoloJourney grande data-reveal data-reveal-delay="0.16" />
        <T as="p" class="im-cerslide-l" it="Sopra ogni fermata quello che fa lei, sotto quello che fate voi e con che cosa." en="Above each stop what she does, below what you do and with what." data-reveal data-reveal-delay="0.26" />
      </div>
    </Slide>

  </DeckContainer>
</BaseLayout>
