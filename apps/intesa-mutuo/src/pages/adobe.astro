---
/**
 * 01 · ADOBE PER INTESA SANPAOLO — il capitolo che viene dal deck.
 *
 * Innesta cinque slide del `.pptx` del 5 novembre: il team (02), chi è
 * Adobe (07), Adobe nei servizi finanziari (06), i Forrester Wave (08) e
 * Adobe CX Enterprise (11).
 *
 * ⚠️ È L'UNICO CAPITOLO IN CUI IL DESIGN SYSTEM NON È DI INTESA.
 * La regola «un artefatto, un design system» non è violata: qui Adobe
 * parla di sé, e il blocco sta dentro il documento come **citazione**
 * dichiarata — non ridisegnato in verde, non mimetizzato. I quadranti
 * Forrester restano le immagini originali, perché un grafico di un
 * analista terzo non si ricolora e non si ridisegna: o è il suo, o non
 * vale niente.
 *
 * Che cosa NON è stato innestato, e perché:
 *   - le otto slide «Agenda»: in un documento la navigazione è l'agenda;
 *   - la slide 10, che diceva la stessa cosa della 11 con meno disegno;
 *   - i numeri della 07, che la 06 ripeteva quasi uguali con il taglio
 *     FSI in più. Stanno in un posto solo (vedi «slide-numeri»).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import T from '@edf/core/blocks/i18n/T.astro';
import { href } from '@edf/core/utils/url.js';
import { CHAPTERS, prevSlug, nextSlug } from '../data/chapters';
import Divisore from '../components/Divisore.astro';
import fondo from '../assets/generated/lavoro-04-decisione.webp';
/* I quadranti, estratti dal deck ufficiale. Non ricostruiti: un Wave
   ridisegnato da noi non sarebbe più una fonte. */
import wCdp from '../assets/forrester/forrester-cdp.png';
import wAnalytics from '../assets/forrester/forrester-analytics.png';
import wOptimization from '../assets/forrester/forrester-optimization.png';
import wEmail from '../assets/forrester/forrester-email.png';
/* I sette ritratti del team. Ritagliati dalla slide 2 nella sua versione
   aggiornata — quella a sette persone, che nei file su disco non c'è:
   il deck a quattro era una versione precedente. */
import rGordiani from '../assets/team/gordiani.png';
import rEllena from '../assets/team/ellena.png';
import rGargiulo from '../assets/team/gargiulo.png';
import rSelmi from '../assets/team/selmi.png';
import rGrieco from '../assets/team/grieco.png';
import rDeMatteis from '../assets/team/dematteis.png';
import rMoretti from '../assets/team/moretti.png';

const SLUG = 'adobe';
const ch = CHAPTERS.find((c) => c.slug === SLUG)!;
const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;

/* Il team che è in sala il 5 novembre, nell'ordine della slide 2. */
const TEAM = [
  { n: 'Alex Gordiani', f: rGordiani, r: { it: 'Head of FSI', en: 'Head of FSI' } },
  { n: 'Francesca Ellena', f: rEllena, r: { it: 'Account Executive FSI', en: 'Account Executive FSI' } },
  { n: 'Antonio Gargiulo', f: rGargiulo, r: { it: 'Product Sales Specialist FSI', en: 'Product Sales Specialist FSI' } },
  { n: 'Giacomo Selmi', f: rSelmi, r: { it: 'Senior Solutions Consultant', en: 'Senior Solutions Consultant' } },
  { n: 'Matteo Grieco', f: rGrieco, r: { it: 'Solutions Consultant', en: 'Solutions Consultant' } },
  { n: 'Raffaele De Matteis', f: rDeMatteis, r: { it: 'Manager, Solutions Consulting', en: 'Manager, Solutions Consulting' } },
  { n: 'Barbara Moretti', f: rMoretti, r: { it: 'Principal Product Marketing Manager', en: 'Principal Product Marketing Manager' } },
];

/* I cinque numeri, con la fonte accanto. Dal deck, slide 6. */
const NUMERI = [
  { k: '1982', v: { it: 'fondata da J. Warnock e C. Geschke', en: 'founded by J. Warnock and C. Geschke' } },
  { k: '$23,77 mld', v: { it: 'ricavi nell’esercizio 2025', en: 'fiscal 2025 revenue' } },
  { k: '+11%', v: { it: 'crescita dei ricavi nell’esercizio 2025', en: 'revenue growth in fiscal 2025' } },
  { k: '31.360', v: { it: 'dipendenti, metà fuori dagli Stati Uniti', en: 'employees, half outside the United States' } },
  { k: '8.400', v: { it: 'clienti nei servizi finanziari nel mondo', en: 'financial services customers worldwide' } },
];

/* I quattro Wave. `pro` è **l'elemento distintivo che Forrester riconosce
   ad Adobe** in quel quadrante — uno solo, sintetico; `per` è che cosa
   vuol dire nel contesto di una banca. Senza la prima riga il quadrante
   è una medaglia; senza la seconda è una medaglia di qualcun altro.

   ⚠️ PROVENIENZA, perché queste righe finiscono davanti a un cliente.
   Customer Analytics ed Experience Optimization sono verificati sul
   materiale Adobe di Field Readiness (29 ott 2026): per il primo
   Forrester indica l'unificazione dei profili su scala enterprise con la
   ricucitura delle sessioni **anonime prima del login**; per il secondo
   l'integrazione nativa con Experience Platform, profili in tempo reale
   e identity resolution.
   Customer Data Platform ed Email Marketing NON sono stati ritrovati:
   le loro righe restano quelle già scritte nel deck e **vanno
   ricontrollate sul report prima del 5 novembre**. Non sono state
   arricchite con dettagli non verificati — che è il modo più rapido di
   farsi smentire da un CIO che il report ce l'ha. */
const WAVE = [
  {
    img: wCdp, cat: { it: 'Customer Data Platform', en: 'Customer Data Platform' },
    q: { it: 'Leader · 3° trim. 2026', en: 'Leader · Q3 2026' },
    per: { it: 'Una sola vista del cliente, pronta da usare su tutti i canali', en: 'One view of the customer, ready to use across every channel' },
    pro: { it: 'Per Forrester la forza è la gestione del dato: modelli di settore e regole di governance dentro la piattaforma', en: 'Forrester points to data management: industry models and governance rules inside the platform' },
  },
  {
    img: wAnalytics, cat: { it: 'Customer Analytics', en: 'Customer Analytics' },
    q: { it: 'Leader · 2° trim. 2026', en: 'Leader · Q2 2026' },
    per: { it: 'Capire dove i clienti si fermano, tra app, sito e filiale', en: 'Understand where customers stall, across app, site and branch' },
    pro: { it: 'Per Forrester unifica i profili su scala enterprise, e ricuce anche le sessioni anonime prima del login', en: 'Forrester points to unifying profiles at enterprise scale, stitching even anonymous sessions before login' },
  },
  {
    img: wOptimization, cat: { it: 'Experience Optimization', en: 'Experience Optimization' },
    q: { it: 'Leader · 3° trim. 2026', en: 'Leader · Q3 2026' },
    per: { it: 'Testare e personalizzare ogni esperienza, dal sito al singolo messaggio', en: 'Test and personalise every experience, from the site to a single message' },
    pro: { it: 'Per Forrester la personalizzazione nasce dai profili in tempo reale di Experience Platform, sul web e sugli altri canali', en: 'Forrester points to personalisation built on Experience Platform’s real-time profiles, on web and other channels' },
  },
  {
    img: wEmail, cat: { it: 'Email Marketing', en: 'Email Marketing' },
    q: { it: 'Leader · 1° trim. 2026', en: 'Leader · Q1 2026' },
    per: { it: 'Messaggi personalizzati e conformi, su email e sugli altri canali', en: 'Personalised, compliant messages over email and other channels' },
    pro: { it: 'Per Forrester l’AI di Adobe produce messaggi completi e coerenti con il marchio', en: 'Forrester points to Adobe’s AI producing complete, on-brand messages' },
  },
];

/* L'ARCHITETTURA — disegnata sullo schema che il team usa già.
   Tre blocchi in alto, una fascia sottile che li attraversa tutti, e
   sotto una fascia alta che fa da pavimento. Le taglie non sono uguali
   perché i ruoli non lo sono: i tre in alto sono canali, la fascia di
   mezzo è la misura che serve a tutti e tre, quella in basso è il modo
   in cui il lavoro si chiede.

   ⚠️ I DUE NOMI IN BASSO NON SONO NOMI DI PRODOTTO, ed è il punto.
   «Adobe CX Analytics» dice che cosa si compra, «Analisi omnicanale»
   dice che cosa fa; «CX Enterprise Coworker» è un listino, «AI
   conversazionale a supporto del vostro lavoro» è una promessa che in
   sala si capisce senza glossario. Il nome del prodotto resta accanto,
   piccolo: serve sapere di che cosa si parla, ma non è quello il titolo. */
const CANALI = [
  { g: 'trovare', t: { it: 'Farsi trovare nell’era dell’AI', en: 'Being found in the age of AI' },
    p: 'Adobe Brand Visibility',
    d: { it: 'Essere citati nelle risposte generate, non solo nei risultati di ricerca.', en: 'Being cited in generated answers, not only in search results.' } },
  { g: 'engagement', t: { it: 'Ingaggiare il cliente', en: 'Engaging the customer' },
    p: 'Adobe Experience Platform',
    d: { it: 'Profilo, decisione e regia del percorso sullo stesso dato.', en: 'Profile, decision and journey orchestration on the same data.' } },
  { g: 'contenuto', t: { it: 'Content Factory', en: 'Content factory' },
    p: 'Adobe GenStudio',
    d: { it: 'Le varianti che servono, già conformi, senza rifare il giro di approvazione.', en: 'The variants you need, already compliant, without redoing the approval round.' } },
];
const FASCE = [
  { g: 'piattaforma', alta: false,
    t: { it: 'Analisi omnicanale', en: 'Omnichannel analytics' },
    p: 'Adobe CX Analytics',
    d: { it: 'Una misura sola sotto i tre, dal primo contatto alla firma.', en: 'One measurement beneath all three, from first contact to signing.' } },
  { g: 'voce', alta: true,
    t: { it: 'AI conversazionale a supporto del vostro lavoro', en: 'Conversational AI supporting your work' },
    p: 'CX Enterprise Coworker',
    d: { it: 'Dall’obiettivo alla campagna senza passare da sei strumenti: si descrive quello che serve, e il sistema lo prepara.', en: 'From objective to campaign without going through six tools: you describe what you need, and the system prepares it.' } },
];
---
<BaseLayout title={ch.title.it}>
  <div class="fixed top-0 left-0 right-0 z-50">
    <Navigation currentPath={currentPath} base={base} />
  </div>

  <DeckContainer nextHref={href(base, nextSlug(SLUG))} prevHref={href(base, prevSlug(SLUG))}>

    <Slide id="slide-cover" bg="secondary" align="left">
      <div slot="backdrop" class="im-div-bg" style={`--foto: url(${fondo.src}); --fuoco: center 46%`}></div>
      <Divisore num={ch.num}
        tIt="Adobe per Intesa Sanpaolo" tEn="Adobe for Intesa Sanpaolo"
        lIt="Esperienza cliente e produzione di contenuti nello stesso sistema. Oggi parliamo del primo."
        lEn="Customer experience and content production in one system. Today we talk about the first." />
    </Slide>

    <Slide id="slide-team" bg="inverse" align="left">
      <div slot="backdrop" class="im-bg-notte"></div>
      <div class="im-ado-cap" data-reveal>
        <T as="p" class="im-ado-occ" it="Chi è in sala" en="Who is in the room" />
        <T as="h2" class="im-ado-t" it="Il team Adobe per i servizi finanziari" en="The Adobe team for financial services" />
        <ul class="im-team" data-substep data-side="in">
          {TEAM.map((p) => (
            <li class="im-team-i">
              <img class="im-team-f" src={p.f.src} alt="" width="360" height="360" loading="eager" />
              <span class="im-team-n">{p.n}</span>
              <T as="span" class="im-team-r" it={p.r.it} en={p.r.en} />
              <span class="im-team-s">Adobe Italia</span>
            </li>
          ))}
        </ul>
      </div>
    </Slide>

    <Slide id="slide-chi" bg="inverse" align="left">
      <div slot="backdrop" class="im-bg-notte"></div>
      <div class="im-ado-cap" data-reveal>
        <T as="p" class="im-ado-occ" it="Chi è Adobe" en="Who Adobe is" />
        <T as="h2" class="im-ado-t" it="Dare a tutti la possibilità di creare" en="Giving everyone the ability to create" />
        <T as="p" class="im-ado-l" it="Adobe sviluppa piattaforme e strumenti per la creatività, la produttività e le esperienze cliente personalizzate: dalla prima scintilla creativa alla distribuzione su ogni canale." en="Adobe builds platforms and tools for creativity, productivity and personalised customer experiences: from the first creative spark to delivery on every channel." />
        <div class="im-ado-due">
          <section class="im-ado-area" data-substep data-side="in" data-oggi>
            <T as="p" class="im-ado-area-t" it="Esperienza cliente" en="Customer experience" />
            <T as="p" class="im-ado-area-d" it="Experience Cloud: dati, contenuti e percorsi su web, app, assistenza e rete fisica." en="Experience Cloud: data, content and journeys across web, app, service and the branch network." />
            <T as="p" class="im-ado-area-q" it="È l’ambito di oggi" en="This is today’s scope" />
          </section>
          <section class="im-ado-area" data-substep data-side="in">
            <T as="p" class="im-ado-area-t" it="Creatività e documenti" en="Creativity and documents" />
            <T as="p" class="im-ado-area-d" it="Acrobat, Photoshop, Express, Firefly: produzione, approvazione e firma di contenuti e documenti." en="Acrobat, Photoshop, Express, Firefly: producing, approving and signing content and documents." />
          </section>
        </div>
      </div>
    </Slide>

    <Slide id="slide-fsi" bg="inverse" align="left">
      <div slot="backdrop" class="im-bg-notte"></div>
      <div class="im-ado-cap im-ado-cap--largo" data-reveal>
        <T as="p" class="im-ado-occ" it="Adobe nei servizi finanziari" en="Adobe in financial services" />
        <T as="h2" class="im-ado-t im-ado-t--stretto" it="Il settore finanziario è la prima industry di Adobe" en="Financial services is Adobe’s largest industry" />

        <ul class="im-num" data-substep data-side="in">
          {NUMERI.map((n) => (
            <li class="im-num-i">
              <span class="im-num-k">{n.k}</span>
              <T as="span" class="im-num-v" it={n.v.it} en={n.v.en} />
            </li>
          ))}
        </ul>

        <T as="p" class="im-ado-sott" data-substep data-side="in"
           it="E non lo diciamo solo noi: Leader nei quattro Forrester Wave del 2026 che riguardano questo tavolo."
           en="And it is not only us saying it: a Leader in the four 2026 Forrester Waves that matter at this table." />
        <ul class="im-wave">
          {WAVE.map((w) => (
            <li class="im-wave-i" data-substep data-side="in">
              <img class="im-wave-img" src={w.img.src} alt="" width="680" height="664" loading="eager" />
              <T as="span" class="im-wave-q" it={w.q.it} en={w.q.en} />
              <T as="span" class="im-wave-c" it={w.cat.it} en={w.cat.en} />
              <T as="span" class="im-wave-p" it={w.per.it} en={w.per.en} />
              <T as="span" class="im-wave-r" it={w.pro.it} en={w.pro.en} />
            </li>
          ))}
        </ul>
        <T as="p" class="im-fonte-riga" it="Fonti: Adobe Form 10-K esercizio 2025 · risultati Q4 e FY2025 · Adobe Fast Facts · Forrester Research, The Forrester Wave™, 2026." en="Sources: Adobe Form 10-K fiscal 2025 · Q4 and FY2025 results · Adobe Fast Facts · Forrester Research, The Forrester Wave™, 2026." />
      </div>
    </Slide>

    <Slide id="slide-cx" bg="inverse" align="left">
      <div slot="backdrop" class="im-bg-notte"></div>
      <div class="im-ado-cap im-ado-cap--largo" data-reveal>
        {/* La fascia d'apertura viene dalla slide 10 del deck, che diceva
            la stessa cosa con parole migliori: il titolo è un verbo —
            «orchestrare» — e il claim nomina il cliente e i suoi canali
            invece di restare astratto. */}
        <div class="im-orch">
          <T as="h2" class="im-orch-t" it="Orchestrare l’esperienza del cliente" en="Orchestrating the customer experience" />
          <T as="p" class="im-orch-c" it="Dati, contenuti e decisione nello stesso sistema: per servire i clienti di Intesa Sanpaolo uno per uno, in app, sul sito, al contact center e in filiale." en="Data, content and decisioning in one system: to serve Intesa Sanpaolo’s customers one by one, in the app, on the site, at the contact centre and in the branch." />
        </div>
        <T as="p" class="im-ado-l im-ado-l--sotto" it="Tre canali, una misura che li attraversa tutti e, sotto, il modo in cui il lavoro si chiede. Sono i blocchi che tornano in ogni momento del percorso di Giulia." en="Three channels, one measurement running across all of them and, underneath, the way the work gets asked for. These are the blocks that come back at every moment of Giulia’s journey." />
        <div class="im-arch" data-reveal data-reveal-delay="0.12">
          <ul class="im-arch-su">
            {CANALI.map((b) => (
              <li class="im-arch-b" data-gruppo={b.g}>
                <T as="span" class="im-arch-t" it={b.t.it} en={b.t.en} />
                <T as="span" class="im-arch-d" it={b.d.it} en={b.d.en} />
                <span class="im-arch-pro">{b.p}</span>
              </li>
            ))}
          </ul>
          {FASCE.map((f) => (
            <section class="im-arch-b im-arch-f" data-gruppo={f.g} data-alta={f.alta ? '' : undefined} data-substep data-side="in">
              <div class="im-arch-f-t">
                <T as="span" class="im-arch-t" it={f.t.it} en={f.t.en} />
                <span class="im-arch-pro">{f.p}</span>
              </div>
              <T as="span" class="im-arch-d" it={f.d.it} en={f.d.en} />
            </section>
          ))}
        </div>
      </div>
    </Slide>

  </DeckContainer>
</BaseLayout>
