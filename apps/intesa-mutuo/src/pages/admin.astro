---
import BaseLayout from '../layouts/BaseLayout.astro';
import AdminConsole from '@edf/core/blocks/admin/AdminConsole.astro';
import { href } from '@edf/core/utils/url.js';
import { SITE } from '../data/site';

const base = import.meta.env.BASE_URL;
const SUPABASE_URL = import.meta.env.PUBLIC_SUPABASE_URL ?? '';
const SUPABASE_ANON_KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY ?? '';

interface SlideEntry { id: string; label: string; }
interface PageEntry { slug: string; label: string; slides: SlideEntry[]; }

// Ogni slide del deck, pagina per pagina: è ciò che il tab «Capitoli e slide»
// accende e spegne. Ogni <Slide id> nuova va registrata qui.
const PAGE_REGISTRY: PageEntry[] = [
  { slug: 'index', label: 'Lo stesso mutuo, dai due lati (00)', slides: [
    { id: 'slide-cover',    label: 'Copertina — il lockup e la domanda del tipo' },
    { id: 'slide-percorso', label: 'Il percorso — i cinque capitoli' },
  ]},
  { slug: 'scenario', label: 'Scenario (01)', slides: [
    { id: 'slide-cover',      label: 'Cover — il mutuo è dove si gioca vent’anni' },
    { id: 'slide-segnale',    label: 'Il segnale c’è già, e si spegne da solo' },
    { id: 'slide-chi-decide', label: 'Chi decide che cosa dire, e quando' },
  ]},
  { slug: 'persona', label: 'La persona (02)', slides: [
    { id: 'slide-cover',  label: 'Cover — Giulia, 34 anni, già vostra cliente' },
    { id: 'slide-giulia', label: 'La protagonista, e i sei momenti' },
  ]},
  { slug: 'momenti', label: 'I sei momenti di Giulia — lato cliente (03)', slides: [
    { id: 'slide-cover', label: 'Cover — sei momenti in tre settimane' },
    { id: 'slide-cli-01', label: 'Momento 01 — lato cliente' },
    { id: 'slide-cli-02', label: 'Momento 02 — lato cliente' },
    { id: 'slide-cli-03', label: 'Momento 03 — lato cliente' },
    { id: 'slide-cli-04', label: 'Momento 04 — lato cliente' },
    { id: 'slide-cli-05', label: 'Momento 05 — lato cliente' },
    { id: 'slide-cli-06', label: 'Momento 06 — lato cliente' },
  ]},
  { slug: 'motore', label: 'Gli stessi sei, dall’altro lato (04)', slides: [
    { id: 'slide-cover', label: 'Cover — gli stessi sei, dall’altro lato' },
    { id: 'slide-int-01', label: 'Momento 01 — lato di chi prepara' },
    { id: 'slide-int-02', label: 'Momento 02 — lato di chi prepara' },
    { id: 'slide-int-03', label: 'Momento 03 — lato di chi prepara' },
    { id: 'slide-int-04', label: 'Momento 04 — lato di chi prepara' },
    { id: 'slide-int-05', label: 'Momento 05 — lato di chi prepara' },
    { id: 'slide-int-06', label: 'Momento 06 — lato di chi prepara' },
  ]},
  { slug: 'risultati', label: 'Risultati (05)', slides: [
    { id: 'slide-cover',   label: 'Cover — una banca che lo fa già' },
    { id: 'slide-tsb',     label: 'TSB — le quattro cifre, con la fonte' },
    { id: 'slide-italia',  label: 'Crédit Agricole Italia e Santander Brasil' },
    { id: 'slide-da-voi',  label: 'Che cosa misureremmo, dal giorno uno' },
    { id: 'slide-firma',   label: 'La firma — Adobe × Intesa Sanpaolo' },
  ]},
];

interface SolutionEntry {
  id: string; name: string; shortName: string;
  pillar: string; description: string; appearsIn: string[];
}

// Segnaposto: il deck generato non ha slide gated. Sostituire con le soluzioni
// Adobe che l'experience propone davvero (nomi verificati, vedi memoria
// adobe-product-naming-2026) e marcare le slide con `data-solution="<id>"`.
const SOLUTIONS: SolutionEntry[] = [
  { id: 'piattaforma', name: 'Adobe Experience Cloud — segnaposto', shortName: 'Adobe', pillar: 'piattaforma',
    description: 'Sostituire con i prodotti Adobe che il deck propone, uno per voce, con il nome per esteso.', appearsIn: ['Scenario', 'La persona', 'I momenti della storia', 'Il motore dietro la storia', 'Risultati'] },
];

const PILLAR_LABELS: Record<string, string> = { piattaforma: 'Piattaforma' };
const PILLAR_ORDER = ['piattaforma'];
const PILLAR_COLORS: Record<string, string> = { piattaforma: '#258900' };

const solutionGroups = PILLAR_ORDER
  .map((pillar) => ({ pillar, label: PILLAR_LABELS[pillar], color: PILLAR_COLORS[pillar], solutions: SOLUTIONS.filter((s) => s.pillar === pillar) }))
  .filter((g) => g.solutions.length > 0);

const allSolutionIds = SOLUTIONS.map((s) => s.id);
const deckHref = href(base, '/');
// I dossier interni di questa experience, se ne ha: la console è il posto dove
// chi presenta trova il deck e il documento che prepara la stanza. Quando nasce
// un `dossier.astro`, si aggiunge qui — restano gated, il link non li apre.
const DOSSIERS: { href: string; label?: string }[] = [
  // { href: href(base, '/dossier'), label: 'Dossier interno' },
];
---
<BaseLayout title={`Console — ${SITE.name} · ${SITE.client}`}>
  <AdminConsole
    projectSlug={SITE.slug}
    projectName={SITE.name}
    clientLabel={`Adobe × ${SITE.client}`}
    deckHref={deckHref}
    dossiers={DOSSIERS}
    pages={PAGE_REGISTRY}
    solutionGroups={solutionGroups}
    allSolutionIds={allSolutionIds}
    supabaseUrl={SUPABASE_URL}
    supabaseAnonKey={SUPABASE_ANON_KEY}
  />
</BaseLayout>
