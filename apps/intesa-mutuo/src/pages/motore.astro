---
/**
 * Il motore dietro la storia — che cosa resta vostro, che cosa si aggiunge.
 *
 * Formato: SLIDE SEQUENZIALI. Si avanza con le frecce, non si scorre.
 * Il racconto e i mockup restano quelli della Storia — cambia come ci si
 * muove dentro: una slide alla volta, dimensionata su 1920×1080.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import T from '@edf/core/blocks/i18n/T.astro';
import { href } from '@edf/core/utils/url.js';
import { CHAPTERS, prevSlug, nextSlug } from '../data/chapters';

const SLUG = 'motore';
const ch = CHAPTERS.find((c) => c.slug === SLUG)!;
const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;
---
<BaseLayout title={ch.title.it}>
  <div class="fixed top-0 left-0 right-0 z-50">
    <Navigation currentPath={currentPath} base={base} />
  </div>

  <DeckContainer nextHref={href(base, nextSlug(SLUG))} prevHref={href(base, prevSlug(SLUG))}>

    <Slide id="slide-cover" bg="inverse" align="center">
      <div slot="backdrop" class="im-bg-notte"></div>
      <div class="im-ch" data-reveal>
        <p class="im-ch-num"><span data-lang-it>Capitolo {ch.num}</span><span data-lang-en>Chapter {ch.num}</span></p>
        <T as="h2" class="im-ch-t" it="Quattro strati, e due restano vostri" en="Four layers, and two stay yours" data-reveal data-reveal-delay="0.08" />
        <T as="p" class="im-ch-l" it="Niente di quello che avete appena costruito viene buttato. Si aggiunge l’anello che manca." en="Nothing you have just built gets thrown away. We add the missing link." data-reveal data-reveal-delay="0.15" />
      </div>
    </Slide>

    <Slide id="slide-resta" bg="primary" align="left">
      <div class="im-sl" data-reveal>
        <div class="im-sl-head">
          <p class="im-n">01</p>
          <T as="h2" class="im-h2" it="Che cosa resta dov’è" en="What stays where it is" />
          <T as="p" class="im-sub" it="Il data warehouse, il motore di targeting che produce score e propensioni, e il CRM di filiale, costruito su misura." en="The data warehouse, the targeting engine producing scores, and the purpose-built branch CRM." />
        </div>
          <T as="p" class="im-chiusa" it="Il CRM riceve segnale e proposta via API, e rimanda l’esito. Non si sostituisce niente." en="The CRM receives signal and proposal via API, and returns the outcome. Nothing gets replaced." data-reveal data-reveal-delay="0.3" />
      </div>
    </Slide>

    <Slide id="slide-aggiunge" bg="inverse" align="left">
      <div class="im-sl" data-reveal>
        <div class="im-sl-head">
          <p class="im-n">02</p>
          <T as="h2" class="im-h2" it="Che cosa si aggiunge" en="What gets added" />
          <T as="p" class="im-sub" it="Il profilo in tempo reale su Adobe Real-Time CDP, la regia su Adobe Journey Optimizer, e l’arbitro: Offer Decisioning. Sotto, Customer Journey Analytics." en="The real-time profile on Adobe Real-Time CDP, orchestration on Adobe Journey Optimizer, and the arbiter: Offer Decisioning. Underneath, Customer Journey Analytics." />
        </div>
          <T as="p" class="im-chiusa" it="L’arbitro non è un altro target: decide fra target che si sovrappongono, dentro il tetto di contatto." en="The arbiter is not another target: it decides between overlapping targets, within the contact cap." data-reveal data-reveal-delay="0.3" />
      </div>
    </Slide>

    <Slide id="slide-domande" bg="primary" align="left">
      <div class="im-sl" data-reveal>
        <div class="im-sl-head">
          <p class="im-n">03</p>
          <T as="h2" class="im-h2" it="Le tre domande che faremo noi" en="The three questions we will ask" />
          <T as="p" class="im-sub" it="Dove va il dato quando esce dallo strumento di analisi e con che ritardo; quale CDN usate e se i log si inoltrano; chi governa l’arbitro." en="Where data goes when it leaves the analytics tool and with what delay; which CDN you use and whether logs forward; who governs the arbiter." />
        </div>
          <T as="p" class="im-chiusa" it="Sono incognite nostre, non vostre. Le dichiariamo prima perché è lì che un progetto si incaglia." en="These are our unknowns, not yours. We declare them upfront because that is where projects run aground." data-reveal data-reveal-delay="0.3" />
      </div>
    </Slide>

  </DeckContainer>
</BaseLayout>
