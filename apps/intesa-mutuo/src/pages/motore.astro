            <T as="h2" class="im-mom-t" it={MOMENTI[2].interno.titolo.it} en={MOMENTI[2].interno.titolo.en} data-reveal data-reveal-delay="0.08" />
            <T as="p" class="im-mom-b" it={MOMENTI[2].interno.corpo.it} en={MOMENTI[2].interno.corpo.en} data-reveal data-reveal-delay="0.16" />
            <a href={href(base, '/momenti')} class="im-mom-l" data-reveal data-reveal-delay="0.24">
              <span data-lang-it>↳ Lo stesso momento, dal lato di Giulia</span><span data-lang-en>↳ The same moment, from Giulia’s side</span>
            </a>
          </div>
          <div class="im-mom-schermo" data-reveal data-reveal-delay="0.2">
            <MockAdobe scena={MOMENTI[2].interno.mock} />
