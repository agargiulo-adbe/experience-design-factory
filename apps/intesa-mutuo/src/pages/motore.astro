          <div class="im-mom-testo">
            <T as="p" class="im-mom-k" it={`${MOMENTI[5].ora.it} · ${MOMENTI[5].dove.it}`} en={`${MOMENTI[5].ora.en} · ${MOMENTI[5].dove.en}`} />
            <T as="h2" class="im-mom-t" it={MOMENTI[5].interno.titolo.it} en={MOMENTI[5].interno.titolo.en} data-reveal data-reveal-delay="0.08" />
            <T as="p" class="im-mom-b" it={MOMENTI[5].interno.corpo.it} en={MOMENTI[5].interno.corpo.en} data-reveal data-reveal-delay="0.16" />
            <a href={href(base, '/momenti')} class="im-mom-l" data-reveal data-reveal-delay="0.24">
