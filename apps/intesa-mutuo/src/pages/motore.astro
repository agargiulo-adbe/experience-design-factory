      </div>
    </Slide>

    <Slide id="slide-int-04" bg="inverse" align="split" data-made-with="Adobe Firefly" data-made-with-for="sfondo">
      <div slot="backdrop" class="im-bg-storia" style={`--bg: url(${SFONDO[MOMENTI[3].bg]})`}></div>
      <div class="im-mom" data-verso="schermo-prima" data-reveal>
          <div class="im-mom-schermo" data-reveal data-reveal-delay="0.2">
