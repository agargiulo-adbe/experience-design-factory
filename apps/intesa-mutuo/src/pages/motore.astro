            <T as="p" class="im-mom-k" it={`${MOMENTI[3].ora.it} · ${MOMENTI[3].dove.it}`} en={`${MOMENTI[3].ora.en} · ${MOMENTI[3].dove.en}`} />
            <T as="h2" class="im-mom-t" it={MOMENTI[3].interno.titolo.it} en={MOMENTI[3].interno.titolo.en} data-reveal data-reveal-delay="0.08" />
            <T as="p" class="im-mom-b" it={MOMENTI[3].interno.corpo.it} en={MOMENTI[3].interno.corpo.en} data-reveal data-reveal-delay="0.16" />
            <a href={href(base, '/momenti')} class="im-mom-l" data-reveal data-reveal-delay="0.24">
              <span data-lang-it>↳ Lo stesso momento, dal lato di Giulia</span><span data-lang-en>↳ The same moment, from Giulia’s side</span>
            </a>
          </div>
      </div>
    </Slide>

    <Slide id="slide-int-05" bg="inverse" align="split" data-made-with="Adobe Firefly" data-made-with-for="sfondo">
      <div slot="backdrop" class="im-bg-storia" style={`--bg: url(${SFONDO[MOMENTI[4].bg]})`}></div>
      <div class="im-mom" data-reveal>
          <div class="im-mom-testo">
            <T as="p" class="im-mom-k" it={`${MOMENTI[4].ora.it} · ${MOMENTI[4].dove.it}`} en={`${MOMENTI[4].ora.en} · ${MOMENTI[4].dove.en}`} />
            <T as="h2" class="im-mom-t" it={MOMENTI[4].interno.titolo.it} en={MOMENTI[4].interno.titolo.en} data-reveal data-reveal-delay="0.08" />
            <T as="p" class="im-mom-b" it={MOMENTI[4].interno.corpo.it} en={MOMENTI[4].interno.corpo.en} data-reveal data-reveal-delay="0.16" />
            <a href={href(base, '/momenti')} class="im-mom-l" data-reveal data-reveal-delay="0.24">
              <span data-lang-it>↳ Lo stesso momento, dal lato di Giulia</span><span data-lang-en>↳ The same moment, from Giulia’s side</span>
            </a>
          </div>
          <div class="im-mom-schermo" data-reveal data-reveal-delay="0.2">
