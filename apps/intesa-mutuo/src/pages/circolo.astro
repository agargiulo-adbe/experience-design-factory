---
/**
 * Il circolo che si chiude — perché il giro non finisce con la firma.
 *
 * ⚠️ PERCHÉ ESISTE QUESTO CAPITOLO (feedback del team, 29 ott 2026).
 * Il capitolo che stava qui ripeteva i sette momenti dal lato di chi
 * prepara. Da quando le due viste stanno sulla stessa slide, quella
 * ripetizione non serve più — e lo spazio va dove manca l'argomento:
 * il giro **si chiude e riparte meglio**. Quello che si impara sul
 * percorso di Giulia torna indietro due volte: sulla relazione con lei,
 * che da qui in poi è cliente, e sull'acquisizione della prospect dopo.
 *
 * Senza questo capitolo la Storia racconta una vendita. Con questo
 * racconta un motore, ed è la differenza fra un progetto e una scelta.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import T from '@edf/core/blocks/i18n/T.astro';
import Divisore from '../components/Divisore.astro';
import { href } from '@edf/core/utils/url.js';
import { CHAPTERS, prevSlug, nextSlug } from '../data/chapters';
import CircoloJourney from '../components/CircoloJourney.astro';
import fondo from '../assets/generated/lavoro-07-misura.webp';
import scena from '../assets/generated/scena-07-casa.webp';
import lavoro from '../assets/generated/lavoro-03-dati.webp';

const SLUG = 'circolo';
const ch = CHAPTERS.find((c) => c.slug === SLUG)!;
const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;

/* Che cosa torna indietro, e dove va a finire. Due colonne, perché sono
   due destinatari diversi: lei, e la prospect che non conoscete ancora. */
const RITORNO = [
  {
    k: { it: 'Le domande che non vi citavano', en: 'The questions that did not cite you' },
    v: { it: 'diventano il piano dei contenuti del mese dopo', en: 'become next month’s content plan' },
  },
  {
    k: { it: 'La variante che ha funzionato a Torino', en: 'The variant that worked in Turin' },
    v: { it: 'è il punto di partenza per Milano e Bologna', en: 'is the starting point for Milan and Bologna' },
  },
  {
    k: { it: 'Il punto dove si è fermata', en: 'Where she stalled' },
    v: { it: 'è il passo da togliere a chi viene dopo', en: 'is the step to remove for whoever comes next' },
  },
  {
    k: { it: 'La proposta che ha accettato', en: 'The proposal she accepted' },
    v: { it: 'pesa nella decisione della prossima prospect', en: 'weighs in the next prospect’s decision' },
  },
];
---
<BaseLayout title={ch.title.it}>
  <div class="fixed top-0 left-0 right-0 z-50">
    <Navigation currentPath={currentPath} base={base} />
  </div>

  <DeckContainer nextHref={href(base, nextSlug(SLUG))} prevHref={href(base, prevSlug(SLUG))}>

    <Slide id="slide-cover" bg="secondary" align="left">
      <div slot="backdrop" class="im-div-bg" style={`--foto: url(${fondo.src}); --fuoco: center 42%`}></div>
      <Divisore num={ch.num}
        tIt="Il giro si chiude, e riparte meglio" tEn="The loop closes, and restarts better"
        lIt="Una campagna finisce. Un giro no: quello che avete imparato su Giulia lavora sulla prospect che non conoscete ancora." lEn="A campaign ends. A loop does not: what you learned about Giulia works on the prospect you do not know yet." />
    </Slide>

    <Slide id="slide-giro" bg="inverse" align="center">
      <div slot="backdrop" class="im-bg-doppia" style={`--bg: url(${lavoro.src})`}></div>
      <div class="im-cerslide" data-reveal>
        <T as="p" class="im-mom-blocco" it="Il circolo" en="The loop" />
        <T as="h2" class="im-cerslide-t" it="Dal settimo passo si torna al primo, con più informazioni" en="From the seventh step back to the first, with more information" data-reveal data-reveal-delay="0.08" />
        <CircoloJourney grande data-reveal data-reveal-delay="0.16" />
        <T as="p" class="im-cerslide-l" it="Alla firma il percorso di Giulia ha prodotto dati che prima non avevate. Tutto questo rientra nel giro: è la differenza fra fare una campagna e costruire un motore." en="By signature, Giulia’s path has produced data you did not have. All of it re-enters the loop: that is the difference between running a campaign and building an engine." data-reveal data-reveal-delay="0.26" />
      </div>
    </Slide>

    <Slide id="slide-ritorno" bg="inverse" align="left">
      <div slot="backdrop" class="im-bg-doppia" style={`--bg: url(${lavoro.src})`}></div>
      <div class="im-sl" data-reveal>
        <div class="im-sl-head">
          <T as="p" class="im-n" it="Che cosa torna indietro" en="What comes back" />
          <T as="h2" class="im-h2" it="Quattro cose che il giro lascia dietro di sé" en="Four things the loop leaves behind" />
          <T as="p" class="im-sub" it="Non sono report: sono ingressi del giro successivo, e arrivano dove servono senza che qualcuno li trascriva." en="These are not reports: they are inputs to the next loop, and they land where they are needed without anyone retyping them." />
        </div>
        <ul class="im-rit" data-stagger>
          {RITORNO.map((r) => (
            <li class="im-rit-i">
              <span class="im-rit-f" aria-hidden="true"></span>
              <T as="span" class="im-rit-k" it={r.k.it} en={r.k.en} />
              <T as="span" class="im-rit-v" it={r.v.it} en={r.v.en} />
            </li>
          ))}
        </ul>
      </div>
    </Slide>

    <Slide id="slide-due-ritorni" bg="inverse" align="split">
      <div slot="backdrop" class="im-bg-doppia" style={`--bg: url(${scena.src})`}></div>
      <div class="im-mom" data-reveal>
        <div class="im-mom-testo">
          <T as="p" class="im-mom-blocco" it="Due destinatari" en="Two recipients" />
          <T as="p" class="im-mom-k" it="Lei, e quella che non conoscete ancora" en="Her, and the one you do not know yet" />
          <T as="h2" class="im-mom-t" it="Lo stesso giro lavora su due fronti" en="The same loop works on two fronts" data-reveal data-reveal-delay="0.08" />
          <T as="p" class="im-mom-b" it="Su Giulia, che adesso è cliente, il giro decide quando ha senso parlarle della polizza casa: quando serve a lei, non quando chiude un trimestre. Sulla prossima prospect decide che cosa mostrarle prima ancora che vi conosca." en="For Giulia, now a customer, the loop decides when it makes sense to raise home cover: when she needs it, not when a quarter closes. For the next prospect it decides what to show before she even knows you." data-reveal data-reveal-delay="0.16" />
          <T as="p" class="im-mom-chiusa" it="Acquisire costa. Quello che viene dopo è margine, e dipende da quanto bene è andato il primo giro." en="Acquisition costs. What follows is margin, and it depends on how well the first loop went." data-reveal data-reveal-delay="0.24" />
        </div>
        <div class="im-mom-schermo" data-reveal data-reveal-delay="0.2">
          <div class="im-fronti">
            <div class="im-fronte" data-chi="lei">
              <T as="p" class="im-fronte-t" it="Giulia, da cliente" en="Giulia, as a customer" />
              <ul class="im-fronte-l">
                <li><T as="span" it="La polizza casa quando trasloca, non a dicembre" en="Home cover when she moves, not in December" /></li>
                <li><T as="span" it="Il conto per la famiglia quando cambia il nucleo" en="A family account when the household changes" /></li>
                <li><T as="span" it="Un tetto di contatto che vale su tutti i canali" en="A contact cap that holds across every channel" /></li>
              </ul>
            </div>
            <div class="im-fronte" data-chi="prossima">
              <T as="p" class="im-fronte-t" it="La prospect dopo" en="The next prospect" />
              <ul class="im-fronte-l">
                <li><T as="span" it="Contenuti scritti dove gli assistenti vi leggono" en="Content written where assistants can read you" /></li>
                <li><T as="span" it="La variante giusta già pronta per la sua città" en="The right variant already ready for her city" /></li>
                <li><T as="span" it="Il passo che faceva perdere, tolto prima" en="The step that lost people, removed in advance" /></li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </Slide>

  </DeckContainer>
</BaseLayout>
