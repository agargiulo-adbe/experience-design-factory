            <T as="p" class="im-mom-k" it={`${MOMENTI[1].ora.it} · ${MOMENTI[1].dove.it}`} en={`${MOMENTI[1].ora.en} · ${MOMENTI[1].dove.en}`} />
            <T as="h2" class="im-mom-t" it={MOMENTI[1].cliente.titolo.it} en={MOMENTI[1].cliente.titolo.en} data-reveal data-reveal-delay="0.08" />
            <T as="p" class="im-mom-b" it={MOMENTI[1].cliente.corpo.it} en={MOMENTI[1].cliente.corpo.en} data-reveal data-reveal-delay="0.16" />
            <a href={href(base, '/motore')} class="im-mom-l" data-reveal data-reveal-delay="0.24">
              <span data-lang-it>↳ Fra poco, lo stesso momento dall’altro lato</span><span data-lang-en>↳ Shortly, the same moment from the other side</span>
            </a>
          </div>
      </div>
    </Slide>

    <Slide id="slide-cli-03" bg="inverse" align="split" data-made-with="Adobe Firefly" data-made-with-for="sfondo">
