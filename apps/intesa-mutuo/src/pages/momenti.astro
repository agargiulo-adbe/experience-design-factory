---
/**
 * I sette momenti — LE DUE VISTE SULLA STESSA SLIDE.
 *
 * ⚠️ PERCHÉ UNA SOLA SLIDE PER PASSO (feedback del team, 29 ott 2026).
 * Prima erano due capitoli: sette slide con Giulia, poi sette con chi
 * prepara. Chi guardava doveva tenere a mente il momento 04 per sei
 * slide e ricollegarlo da solo — e in sala nessuno lo fa. Ora i due lati
 * dello stesso minuto stanno uno sopra l'altro: **in alto Giulia, in
 * basso chi prepara in Intesa Sanpaolo**, e il legame si vede invece di
 * essere affermato.
 *
 * A destra il CIRCOLO: dice a che punto del giro siamo, e che il giro si
 * chiude. Non è una barra di avanzamento, è l'argomento.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import T from '@edf/core/blocks/i18n/T.astro';
import { href } from '@edf/core/utils/url.js';
import { CHAPTERS, prevSlug, nextSlug } from '../data/chapters';
import { MOMENTI, DOMANDE_IN_SLIDE } from '../data/momenti';
import MockCliente from '../components/MockCliente.astro';
import MockAdobe from '../components/MockAdobe.astro';
import Divisore from '../components/Divisore.astro';
import fondoCap from '../assets/generated/lavoro-05-orchestrazione.webp';
import DaVerificare from '../components/DaVerificare.astro';
import Azione from '../components/Azione.astro';
import FiguraCap from '../components/FiguraCap.astro';

/* L'APPROFONDIMENTO SU «FARSI TROVARE», dopo il giro di Giulia.
   Lo schema è quello che il team usa già: due strati — i segnali e le
   ottimizzazioni — e quattro capacità che si sommano.
   Le voci vengono dal materiale Adobe di Field Readiness letto il 30 ott
   2026 (Brand Visibility per FSI B2C, il lavoro GEO per una banca
   europea, la guida GTM): traffico reale degli agenti dai log del CDN,
   come gli LLM citano il marchio, raccomandazioni prescrittive e
   distribuzione dei fix **al bordo, senza passare dal CMS**.
   ⚠️ Niente proiezioni di mercato in slide: le percentuali che girano su
   quel materiale sono riprese da terzi e non ho la fonte primaria. Un
   numero che un CIO va a cercare e non trova vale meno di nessun numero. */
const BV = [
  { strato: 'segnali', fig: 'grafo', t: { it: 'Dati di mercato', en: 'Market intelligence' },
    d: { it: 'Chi viene citato accanto a voi, su ChatGPT, Perplexity, Copilot.', en: 'Who gets cited next to you, on ChatGPT, Perplexity, Copilot.' } },
  { strato: 'segnali', fig: 'serie', t: { it: 'Segnali di casa vostra', en: 'Brand-owned signals' },
    d: { it: 'Il traffico degli agenti dai log del CDN: non una stima.', en: 'Agent traffic from CDN logs: not an estimate.' } },
  { strato: 'ottimizzazioni', fig: 'bordo', t: { it: 'Ottimizzazioni', en: 'Optimisations' },
    d: { it: 'I correttivi vanno in rete al bordo, senza toccare il CMS.', en: 'Fixes ship at the edge, without touching the CMS.' } },
  { strato: 'ottimizzazioni', fig: 'esito', t: { it: 'Esiti misurabili', en: 'Measurable outcomes' },
    d: { it: 'Dalla citazione alla pratica aperta, nella stessa misura.', en: 'From citation to opened application, in one measurement.' } },
];
/* Le scene vengono da Pexels, licenziate, con autore e URL in
   provenance.json. Sono LUOGHI senza volti: l'unico volto della Storia è
   il ritratto di Giulia, così la persona resta coerente per costruzione. */
import s0 from '../assets/generated/scena-01-divano.webp';
import s1 from '../assets/generated/scena-02-bar.webp';
import s2 from '../assets/generated/scena-03-tavolo.webp';
import s3 from '../assets/generated/scena-04-documenti.webp';
import s4 from '../assets/generated/scena-05-colazione.webp';
import s5 from '../assets/generated/scena-06-filiale.webp';
import s6 from '../assets/generated/scena-07-casa.webp';
/* L'unico volto della Storia. Sta nel CHIP in alto a sinistra di ogni
   banda di Giulia: è il device con cui l'XD Visa tiene la persona
   riconoscibile slide dopo slide, ed è la stessa regola che qui vieta
   sette volti diversi (`giulia-single-journey-portrait-reuse`). */
import ritratto from '../assets/generated/persona-giulia.webp';
const SCENA = [s0, s1, s2, s3, s4, s5, s6].map((x) => x.src);
const SCENE_CLI = ['ricerca','feed','simulazione','documenti','ripresa','sportello','firma'] as const;
/* Il punto di fuoco di ogni scena dentro la fascia 47%×56%: un ritaglio
   di default taglia dove capita, e su una fotografia di luogo il
   soggetto non sta quasi mai al centro.
   ⚠️ La 06 non è una preferenza estetica: quella scena porta il nome di
   uno studio di coworking in rilievo sul muro, al 62-76% della
   larghezza. Un marchio che non è né Adobe né Intesa dentro una slide di
   Intesa è la wrong-brand imagery che la Quality Bar vieta, e il
   ritaglio lo lascia fuori campo. Sostituire la foto resta la soluzione
   migliore, e richiede una chiave Pexels. */
const FUOCO = ['center 40%','center 44%','center 42%','center 38%','center 44%','6% 50%','center 36%'];
/* Lo zoom serve solo alla 06: con `cover` la fascia mostra l'84% della
   larghezza della foto, e il marchio dello studio — che sta al 62-76% —
   resta dentro QUALUNQUE sia il punto di fuoco. Al 180% la fascia mostra
   il 2-58%, e il marchio esce di campo. Verificato guardando la pagina,
   non calcolandolo soltanto.
   Due sostituzioni cercate su Pexels sono state scartate guardandole: un
   bancone da buffet e una scena con un secondo volto femminile, che la
   regola dell'unico volto vieta. */
const ZOOM = ['cover','cover','cover','cover','cover','180% auto','cover'];

const SLUG = 'momenti';
const ch = CHAPTERS.find((c) => c.slug === SLUG)!;
const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;

/* L'APPROFONDIMENTO SU «CONTENT FACTORY», dopo quello su farsi trovare.
   I quattro passi vengono dai sei pilastri del Content Supply Chain
   Maturity Assessment di Adobe (strategia e modello operativo, flussi e
   pianificazione, creazione e produzione, gestione degli asset, consegna
   e attivazione, misura e insight), raggruppati in quattro perché sei
   colonne su una slide non si leggono.
   La fascia sotto è il punto per una banca, e viene dal value prop per i
   servizi finanziari di GenStudio letto su Field Readiness il 30 ott
   2026 — «scalable, compliant campaign content»: la conformità non è un
   passaggio a valle, sta dentro la produzione. */
const CSC = [
  { fig: 'flusso', t: { it: 'Pianificare', en: 'Plan' },
    d: { it: 'Una campagna nasce con dentro le sue approvazioni.', en: 'A campaign is born with its approvals inside it.' } },
  { fig: 'varianti', t: { it: 'Produrre', en: 'Produce' },
    d: { it: 'Dodici varianti da un brief solo, già conformi.', en: 'Twelve variants from one brief, already compliant.' } },
  { fig: 'archivio', t: { it: 'Gestire', en: 'Manage' },
    d: { it: 'Si sa che cosa si può usare, dove e fino a quando.', en: 'You know what can be used, where and until when.' } },
  { fig: 'canali', t: { it: 'Attivare e misurare', en: 'Activate and measure' },
    d: { it: 'L’esito rientra nel brief successivo.', en: 'The outcome feeds the next brief.' } },
];
---
<BaseLayout title={ch.title.it}>
  <div class="fixed top-0 left-0 right-0 z-50">
    <Navigation currentPath={currentPath} base={base} />
  </div>

  <DeckContainer nextHref={href(base, nextSlug(SLUG))} prevHref={href(base, prevSlug(SLUG))}>

    {/* ⚠️ QUI C'ERANO LE DUE MAPPE AFFIANCATE, e sono state tolte.
        Elencavano i sette momenti con canale, ora e verbo a sinistra, e
        i blocchi con funzione e prodotti a destra: la prima è quello che
        il CERCHIO del capitolo 03 mostra già, con Giulia al centro e
        meglio; la seconda è quello che fa «Orchestrare l'esperienza del
        cliente» nel capitolo 01, dove sta anche la leggenda dei colori.
        Erano nate quando il cerchio era un ausilio in un angolo. Da
        quando è il centro del capitolo precedente, ripetevano due slide
        appena viste — e il capitolo 04 restava l'unico senza divisore. */}
    <Slide id="slide-cover" bg="secondary" align="left">
      <div slot="backdrop" class="im-div-bg" style={`--foto: url(${fondoCap.src}); --fuoco: center 42%`}></div>
      <Divisore num={ch.num}
        tIt="Sette momenti, e le due viste sullo stesso minuto" tEn="Seven moments, and both views of the same minute"
        lIt="Sopra quello che vede Giulia, sotto quello che fate voi nello stesso istante. Ogni momento si apre in tre passi, con la freccia in basso."
        lEn="Above, what Giulia sees; below, what you do at the same instant. Each moment opens in three steps, with the down arrow." />
    </Slide>

    {MOMENTI.map((m, i) => (
      <Slide id={`slide-m-${m.n}`} bg="inverse" align="left">
        <div slot="backdrop" class="im-bg-vx" style={`--foto: url(${SCENA[i]}); --fuoco: ${FUOCO[i]}; --zoom: ${ZOOM[i]}`}></div>

        <div class="im-due" data-reveal>
          <header class="im-due-testa">
            <T as="span" class="im-mom-blocco" data-gruppo={m.gruppo} it={m.blocco.it} en={m.blocco.en} />
            <T as="span" class="im-due-ora" it={`${m.ora.it} · ${m.dove.it}`} en={`${m.ora.en} · ${m.dove.en}`} />
            <span class="im-due-passo">
              <span class="im-due-passo-n">{m.n}</span>
              <span class="im-due-passo-d">/ {m.of}</span>
            </span>
          </header>

          <section class="im-due-banda" data-lato="cliente" data-substep data-side="in">
            <div class="im-due-txt">
              <p class="im-due-chi">
                <img class="im-due-chi-r" src={ritratto.src} alt="" width="120" height="120" loading="eager" />
                <span>
                  <T as="span" class="im-due-chi-n" it="Giulia" en="Giulia" />
                  <T as="span" class="im-due-chi-q" it="Non ancora cliente" en="Not a customer yet" />
                </span>
              </p>
              <T as="h2" class="im-due-t" it={m.cliente.titolo.it} en={m.cliente.titolo.en} />
              <T as="p" class="im-due-b" it={m.cliente.corpo.it} en={m.cliente.corpo.en} />
            </div>
            <div class="im-due-mock">
              <MockCliente chrome={m.cliente.chrome} scena={SCENE_CLI[i]} compatto />
              <Azione segno={m.cliente.chrome} />
            </div>
          </section>

          <section class="im-due-banda" data-lato="interno" data-substep data-side="in">
            <div class="im-due-txt">
              <p class="im-due-chi">
                <span class="im-due-chi-s" aria-hidden="true">IS</span>
                <span>
                  <T as="span" class="im-due-chi-n" it="In Intesa Sanpaolo" en="Inside Intesa Sanpaolo" />
                  <T as="span" class="im-due-chi-q" it="Perché è stato possibile" en="Why it was possible" />
                </span>
              </p>
              <T as="h2" class="im-due-t" it={m.interno.titolo.it} en={m.interno.titolo.en} />
              <T as="p" class="im-due-b" it={m.interno.corpo.it} en={m.interno.corpo.en} />
              <p class="im-due-pro">{m.prodotto}</p>
              {DOMANDE_IN_SLIDE && <DaVerificare it={m.verifica.it} en={m.verifica.en} />}
            </div>
            <div class="im-due-mock">
              <MockAdobe prodotto={m.interno.prodotto} compatto />
              <Azione segno={m.gruppo} />
            </div>
          </section>
        </div>
      </Slide>
    ))}

    {/* L'approfondimento arriva DOPO il giro di Giulia, non prima: il
        momento 01 ha già mostrato l'assistente che la banca c'è o non
        c'è. Qui si guarda come lo si governa. */}
    <Slide id="slide-brand-visibility" bg="inverse" align="left">
      <div slot="backdrop" class="im-bg-notte"></div>
      <div class="im-ado-cap im-ado-cap--largo" data-reveal>
        <T as="p" class="im-ado-occ" it="Approfondimento · farsi trovare" en="Deep dive · being found" />
        <T as="h2" class="im-ado-t im-ado-t--stretto" it="Il primo momento di Giulia, governato" en="Giulia’s first moment, under control" />
        <T as="p" class="im-ado-l" it="Due strati: prima si misura come comparite nelle risposte generate, poi si interviene. Senza il primo il secondo è un’opinione." en="Two layers: first you measure how you show up in generated answers, then you act. Without the first, the second is an opinion." />

        {/* ⚠️ Gli operatori sono COLONNE della griglia, non figli in
            posizione assoluta che sporgono dalla card: un figlio assoluto
            con `right` negativo gonfia lo `scrollWidth` del genitore, e
            il check `c` lo legge come overflow — un HARD. */}
        <div class="im-bv">
          {BV.map((c, i) => (
            <>
              <section class="im-bv-i" data-strato={c.strato} data-substep data-side="in">
                <FiguraCap segno={c.fig} />
                <T as="span" class="im-bv-t" it={c.t.it} en={c.t.en} />
                <T as="span" class="im-bv-d" it={c.d.it} en={c.d.en} />
              </section>
              {i < BV.length - 1 && <span class="im-bv-op" aria-hidden="true">{i === 1 ? '=' : '+'}</span>}
            </>
          ))}
        </div>

        <div class="im-bv-strati" data-substep data-side="in">
          <T as="span" class="im-bv-strato" data-strato="segnali" it="Strato dei segnali" en="Signal layer" />
          <T as="span" class="im-bv-strato" data-strato="ottimizzazioni" it="Strato delle ottimizzazioni" en="Optimisation layer" />
        </div>

        <T as="p" class="im-fonte-riga" it="Capacità verificate sul materiale Adobe di Field Readiness (Brand Visibility per i servizi finanziari, 30 ott 2026). Adobe Brand Visibility." en="Capabilities verified against Adobe Field Readiness material (Brand Visibility for financial services, 30 Oct 2026). Adobe Brand Visibility." />
      </div>
    </Slide>

    {/* Secondo approfondimento: la fabbrica di contenuti. Sta DOPO
        Brand Visibility perché è il blocco successivo nel giro di
        Giulia — prima vi trovano, poi quello che trovano deve parlare
        la sua lingua. */}
    <Slide id="slide-content-factory" bg="inverse" align="left">
      <div slot="backdrop" class="im-bg-notte"></div>
      <div class="im-ado-cap im-ado-cap--largo" data-reveal>
        <T as="p" class="im-ado-occ" it="Approfondimento · Content Factory" en="Deep dive · content factory" />
        <T as="h2" class="im-ado-t im-ado-t--stretto" it="La catena del contenuto, dal brief alla misura" en="The content chain, from brief to measurement" />
        <T as="p" class="im-ado-l" it="Quattro passi di un giro solo. Il tempo di una campagna non se ne va nel produrre: se ne va nell’approvare e nel ricominciare da capo." en="Four steps of one loop. A campaign’s time does not go into producing: it goes into approving, and into starting over." />

        <div class="im-bv im-csc">
          {CSC.map((c, i) => (
            <>
              <section class="im-bv-i" data-substep data-side="in">
                <FiguraCap segno={c.fig} />
                <T as="span" class="im-bv-t" it={c.t.it} en={c.t.en} />
                <T as="span" class="im-bv-d" it={c.d.it} en={c.d.en} />
              </section>
              {i < CSC.length - 1 && <span class="im-bv-op im-csc-op" aria-hidden="true">→</span>}
            </>
          ))}
        </div>

        {/* La riga che per una banca è il punto. */}
        <div class="im-csc-conf" data-substep data-side="in">
          <T as="span" class="im-csc-conf-t" it="La conformità sta dentro la produzione, non dopo" en="Compliance lives inside production, not after it" />
          <T as="span" class="im-csc-conf-d" it="È la differenza fra dodici varianti pronte e dodici varianti da far rivedere. Su una campagna di mutuo, è la differenza fra uscire questa settimana e uscire il mese prossimo." en="It is the difference between twelve variants ready and twelve variants to review. On a mortgage campaign, it is the difference between launching this week and launching next month." />
        </div>

        <T as="p" class="im-fonte-riga" it="Passi dai sei pilastri del Content Supply Chain Maturity Assessment di Adobe; la riga sulla conformità dal value prop per i servizi finanziari di Adobe GenStudio (Field Readiness, 30 ott 2026)." en="Steps from the six pillars of Adobe’s Content Supply Chain Maturity Assessment; the compliance line from Adobe GenStudio’s financial services value proposition (Field Readiness, 30 Oct 2026)." />
      </div>
    </Slide>

  </DeckContainer>
</BaseLayout>
