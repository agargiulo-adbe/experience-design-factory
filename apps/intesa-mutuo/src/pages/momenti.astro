            <T as="h2" class="im-mom-t" it={MOMENTI[3].cliente.titolo.it} en={MOMENTI[3].cliente.titolo.en} data-reveal data-reveal-delay="0.08" />
            <T as="p" class="im-mom-b" it={MOMENTI[3].cliente.corpo.it} en={MOMENTI[3].cliente.corpo.en} data-reveal data-reveal-delay="0.16" />
            <a href={href(base, '/motore')} class="im-mom-l" data-reveal data-reveal-delay="0.24">
              <span data-lang-it>↳ Fra poco, lo stesso momento dall’altro lato</span><span data-lang-en>↳ Shortly, the same moment from the other side</span>
            </a>
          </div>
      </div>
    </Slide>

    <Slide id="slide-cli-05" bg="inverse" align="split" data-made-with="Adobe Firefly" data-made-with-for="sfondo">
      <div slot="backdrop" class="im-bg-storia" style={`--bg: url(${SFONDO[MOMENTI[4].bg]})`}></div>
      <div class="im-mom" data-reveal>
          <div class="im-mom-testo">
            <T as="p" class="im-mom-k" it={`${MOMENTI[4].ora.it} · ${MOMENTI[4].dove.it}`} en={`${MOMENTI[4].ora.en} · ${MOMENTI[4].dove.en}`} />
            <T as="h2" class="im-mom-t" it={MOMENTI[4].cliente.titolo.it} en={MOMENTI[4].cliente.titolo.en} data-reveal data-reveal-delay="0.08" />
