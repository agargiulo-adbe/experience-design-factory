---
/**
 * I sette momenti di Giulia — la sua esperienza, scena per scena.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import T from '@edf/core/blocks/i18n/T.astro';
import { href } from '@edf/core/utils/url.js';
import { CHAPTERS, prevSlug, nextSlug } from '../data/chapters';
import { MOMENTI } from '../data/momenti';
import MockCliente from '../components/MockCliente.astro';
/* Le scene vengono da Pexels, licenziate, con autore e URL in
   provenance.json. Non sono decorazione: ognuna dice che cosa sta facendo
   la persona in quel momento, e sta nello SFONDO — così la pagina si
   riempie e il momento si capisce prima di leggere. */
import s0 from '../assets/generated/scena-01-divano.webp';
import s1 from '../assets/generated/scena-02-bar.webp';
import s2 from '../assets/generated/scena-03-tavolo.webp';
import s3 from '../assets/generated/scena-04-documenti.webp';
import s4 from '../assets/generated/scena-05-colazione.webp';
import s5 from '../assets/generated/scena-06-filiale.webp';
import s6 from '../assets/generated/scena-07-casa.webp';
import s7 from '../assets/generated/lavoro-01-ricerca.webp';
import s8 from '../assets/generated/lavoro-02-contenuti.webp';
import s9 from '../assets/generated/lavoro-03-dati.webp';
import s10 from '../assets/generated/lavoro-04-decisione.webp';
import s11 from '../assets/generated/lavoro-05-orchestrazione.webp';
import s12 from '../assets/generated/lavoro-06-filiale-back.webp';
import s13 from '../assets/generated/lavoro-07-misura.webp';
const SCENA: Record<string, string> = { 'scena-01-divano': s0.src, 'scena-02-bar': s1.src, 'scena-03-tavolo': s2.src, 'scena-04-documenti': s3.src, 'scena-05-colazione': s4.src, 'scena-06-filiale': s5.src, 'scena-07-casa': s6.src, 'lavoro-01-ricerca': s7.src, 'lavoro-02-contenuti': s8.src, 'lavoro-03-dati': s9.src, 'lavoro-04-decisione': s10.src, 'lavoro-05-orchestrazione': s11.src, 'lavoro-06-filiale-back': s12.src, 'lavoro-07-misura': s13.src };
const SCENE_CLI = ['ricerca','feed','simulazione','documenti','ripresa','sportello','firma'] as const;

const SLUG = 'momenti';
const ch = CHAPTERS.find((c) => c.slug === SLUG)!;
const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;
---
<BaseLayout title={ch.title.it}>
  <div class="fixed top-0 left-0 right-0 z-50">
    <Navigation currentPath={currentPath} base={base} />
  </div>

  <DeckContainer nextHref={href(base, nextSlug(SLUG))} prevHref={href(base, prevSlug(SLUG))}>

    <Slide id="slide-cover" bg="inverse" align="center">
      <div slot="backdrop" class="im-bg-notte"></div>
      <div class="im-ch" data-reveal>
        <p class="im-ch-num"><span data-lang-it>Capitolo {ch.num}</span><span data-lang-en>Chapter {ch.num}</span></p>
        <T as="h2" class="im-ch-t" it="Sette momenti, in tre settimane" en="Seven moments, across three weeks" data-reveal data-reveal-delay="0.08" />
        <T as="p" class="im-ch-l" it="Questo è quello che vede lei. Quattro superfici diverse — un assistente, un feed, l’app, lo sportello — e nessun nome di prodotto." en="This is what she sees. Four different surfaces — an assistant, a feed, the app, the branch desk — and no product names." data-reveal data-reveal-delay="0.15" />
      </div>
    </Slide>

    <Slide id="slide-cli-01" bg="inverse" align="split">
      <div slot="backdrop" class="im-bg-scena" style={`--bg: url(${SCENA[MOMENTI[0].cliente.scena]})`}></div>
      <div class="im-mom" data-reveal>
          <div class="im-mom-testo">
            <T as="p" class="im-mom-blocco" it={MOMENTI[0].blocco.it} en={MOMENTI[0].blocco.en} />
            <T as="p" class="im-mom-k" it={`${MOMENTI[0].ora.it} · ${MOMENTI[0].dove.it}`} en={`${MOMENTI[0].ora.en} · ${MOMENTI[0].dove.en}`} />
            <T as="h2" class="im-mom-t" it={MOMENTI[0].cliente.titolo.it} en={MOMENTI[0].cliente.titolo.en} data-reveal data-reveal-delay="0.08" />
            <T as="p" class="im-mom-b" it={MOMENTI[0].cliente.corpo.it} en={MOMENTI[0].cliente.corpo.en} data-reveal data-reveal-delay="0.16" />
            <a href={href(base, '/motore')} class="im-mom-l" data-reveal data-reveal-delay="0.24">
              <span data-lang-it>↳ Lo stesso momento, dal lato di chi prepara</span><span data-lang-en>↳ The same moment, from the preparer’s side</span>
            </a>
          </div>
          <div class="im-mom-schermo" data-reveal data-reveal-delay="0.2">
            <MockCliente chrome={MOMENTI[0].cliente.chrome} scena={SCENE_CLI[0]} />
          </div>
      </div>
    </Slide>

    <Slide id="slide-cli-02" bg="inverse" align="split">
      <div slot="backdrop" class="im-bg-scena" style={`--bg: url(${SCENA[MOMENTI[1].cliente.scena]})`}></div>
