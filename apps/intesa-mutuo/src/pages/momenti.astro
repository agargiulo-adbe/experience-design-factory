---
/**
 * I sette momenti — LE DUE VISTE SULLA STESSA SLIDE.
 *
 * ⚠️ PERCHÉ UNA SOLA SLIDE PER PASSO (feedback del team, 29 ott 2026).
 * Prima erano due capitoli: sette slide con Giulia, poi sette con chi
 * prepara. Chi guardava doveva tenere a mente il momento 04 per sei
 * slide e ricollegarlo da solo — e in sala nessuno lo fa. Ora i due lati
 * dello stesso minuto stanno uno sopra l'altro: **in alto Giulia, in
 * basso chi prepara in Intesa Sanpaolo**, e il legame si vede invece di
 * essere affermato.
 *
 * A destra il CIRCOLO: dice a che punto del giro siamo, e che il giro si
 * chiude. Non è una barra di avanzamento, è l'argomento.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import T from '@edf/core/blocks/i18n/T.astro';
import { href } from '@edf/core/utils/url.js';
import { CHAPTERS, prevSlug, nextSlug } from '../data/chapters';
import { MOMENTI, DOMANDE_IN_SLIDE } from '../data/momenti';
import MockCliente from '../components/MockCliente.astro';
import MockAdobe from '../components/MockAdobe.astro';
import Divisore from '../components/Divisore.astro';
import fondoCap from '../assets/generated/lavoro-05-orchestrazione.webp';
import DaVerificare from '../components/DaVerificare.astro';
import Azione from '../components/Azione.astro';
import FiguraCap from '../components/FiguraCap.astro';

/* L'APPROFONDIMENTO SU «FARSI TROVARE», dopo il giro di Giulia.
   Lo schema è quello che il team usa già: due strati — i segnali e le
   ottimizzazioni — e quattro capacità che si sommano.
   Le voci vengono dal materiale Adobe di Field Readiness letto il 30 ott
   2026 (Brand Visibility per FSI B2C, il lavoro GEO per una banca
   europea, la guida GTM): traffico reale degli agenti dai log del CDN,
   come gli LLM citano il marchio, raccomandazioni prescrittive e
   distribuzione dei fix **al bordo, senza passare dal CMS**.
   ⚠️ Niente proiezioni di mercato in slide: le percentuali che girano su
   quel materiale sono riprese da terzi e non ho la fonte primaria. Un
   numero che un CIO va a cercare e non trova vale meno di nessun numero. */
const BV = [
  { strato: 'segnali', fig: 'grafo', t: { it: 'Dati di mercato', en: 'Market intelligence' },
    d: { it: 'Chi viene citato accanto a voi, su ChatGPT, Perplexity, Copilot.', en: 'Who gets cited next to you, on ChatGPT, Perplexity, Copilot.' } },
  { strato: 'segnali', fig: 'serie', t: { it: 'Segnali di casa vostra', en: 'Brand-owned signals' },
    d: { it: 'Il traffico degli agenti dai log del CDN: non una stima.', en: 'Agent traffic from CDN logs: not an estimate.' } },
  { strato: 'ottimizzazioni', fig: 'bordo', t: { it: 'Ottimizzazioni', en: 'Optimisations' },
    d: { it: 'I correttivi vanno in rete al bordo, senza toccare il CMS.', en: 'Fixes ship at the edge, without touching the CMS.' } },
  { strato: 'ottimizzazioni', fig: 'esito', t: { it: 'Esiti misurabili', en: 'Measurable outcomes' },
    d: { it: 'Dalla citazione alla pratica aperta, nella stessa misura.', en: 'From citation to opened application, in one measurement.' } },
];
/* Le scene vengono da Pexels, licenziate, con autore e URL in
   provenance.json. Sono LUOGHI senza volti: l'unico volto della Storia è
   il ritratto di Giulia, così la persona resta coerente per costruzione. */
import s0 from '../assets/generated/scena-01-divano.webp';
import s1 from '../assets/generated/scena-02-bar.webp';
import s2 from '../assets/generated/scena-03-tavolo.webp';
import s3 from '../assets/generated/scena-04-documenti.webp';
import s4 from '../assets/generated/scena-05-colazione.webp';
import s5 from '../assets/generated/scena-06-filiale.webp';
import s6 from '../assets/generated/scena-07-casa.webp';
/* L'unico volto della Storia. Sta nel CHIP in alto a sinistra di ogni
   banda di Giulia: è il device con cui l'XD Visa tiene la persona
   riconoscibile slide dopo slide, ed è la stessa regola che qui vieta
   sette volti diversi (`giulia-single-journey-portrait-reuse`). */
import ritratto from '../assets/generated/persona-giulia.webp';
const SCENA = [s0, s1, s2, s3, s4, s5, s6].map((x) => x.src);
const SCENE_CLI = ['ricerca','feed','simulazione','documenti','ripresa','sportello','firma'] as const;
/* Il punto di fuoco di ogni scena dentro la fascia 47%×56%: un ritaglio
   di default taglia dove capita, e su una fotografia di luogo il
   soggetto non sta quasi mai al centro.
   ⚠️ La 06 non è una preferenza estetica: quella scena porta il nome di
   uno studio di coworking in rilievo sul muro, al 62-76% della
   larghezza. Un marchio che non è né Adobe né Intesa dentro una slide di
   Intesa è la wrong-brand imagery che la Quality Bar vieta, e il
   ritaglio lo lascia fuori campo. Sostituire la foto resta la soluzione
   migliore, e richiede una chiave Pexels. */
const FUOCO = ['center 40%','center 44%','center 42%','center 38%','center 44%','6% 50%','center 36%'];
/* Lo zoom serve solo alla 06: con `cover` la fascia mostra l'84% della
   larghezza della foto, e il marchio dello studio — che sta al 62-76% —
   resta dentro QUALUNQUE sia il punto di fuoco. Al 180% la fascia mostra
   il 2-58%, e il marchio esce di campo. Verificato guardando la pagina,
   non calcolandolo soltanto.
   Due sostituzioni cercate su Pexels sono state scartate guardandole: un
   bancone da buffet e una scena con un secondo volto femminile, che la
   regola dell'unico volto vieta. */
const ZOOM = ['cover','cover','cover','cover','cover','180% auto','cover'];

const SLUG = 'momenti';
const ch = CHAPTERS.find((c) => c.slug === SLUG)!;
const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;

/* L'APPROFONDIMENTO SU «INGAGGIARE IL CLIENTE» — tre slide.
   Il contenuto viene dalle due slide che il team ha già costruito nel
   deck («Quattro componenti che abilitano un ciclo di lavoro virtuoso»
   e «CJA + RT-CDP: una sola misura»), più la verifica su Field Readiness
   del 30 ott 2026 per le parti tecniche: il profilo si costruisce da uno
   schema dati comune (XDM) con **stitching** di identificatori diversi,
   l'**identity graph si aggiorna man mano che i dati arrivano**, e
   l'attribuzione in CJA usa modelli regolati, algoritmici e data-driven
   al posto dell'ultimo clic.
   ⚠️ Il limite si dichiara insieme al pregio: l'attribuzione non cattura
   gli impatti fuori dai canali misurati, e la finestra di osservazione è
   un vincolo. Dirlo prima vale più che scoprirlo dopo. */
const CICLO = [
  { n: '1', fig: 'misura', t: { it: 'La misura', en: 'Measurement' },
    s: { it: 'Analisi omnicanale', en: 'Omnichannel analytics' },
    d: { it: 'Percorsi, funnel, coorti e attribuzione su dati a livello di evento, su tutti i canali.', en: 'Journeys, funnels, cohorts and attribution on event-level data, across every channel.' },
    i: { it: 'Un solo dato per app, sito, contact center e filiale, per Controllo di Gestione e Advanced Analytics.', en: 'One dataset across app, site, contact centre and branch, for management control and advanced analytics.' } },
  { n: '2', fig: 'profilo', t: { it: 'Il profilo', en: 'The profile' },
    s: { it: 'Da audience a target', en: 'From audience to target' },
    d: { it: 'Identità, consenso e segmenti attivabili su ogni canale, su Experience Platform.', en: 'Identity, consent and segments activatable on every channel, on Experience Platform.' },
    i: { it: 'Riceve dal data lake e dagli eventi digitali, ed espone audience e attributi, compresi gli score del vostro motore di targeting.', en: 'Fed by the data lake and digital events, and exposes audiences and attributes, including your targeting engine’s scores.' } },
  { n: '3', fig: 'regia', t: { it: 'La regia', en: 'Orchestration' },
    s: { it: 'In tempo reale', en: 'In real time' },
    d: { it: 'Percorsi uno-a-uno su email, push, SMS, in-app e web, attivati da eventi, con consenso e regole di conformità.', en: 'One-to-one journeys over email, push, SMS, in-app and web, triggered by events, with consent and compliance rules.' },
    i: { it: 'Governa i canali digitali e passa segnali e proposte al CRM di filiale, che resta vostro.', en: 'Runs the digital channels and passes signals and proposals to the branch CRM, which stays yours.' } },
  { n: '4', fig: 'arbitro', t: { it: 'L’arbitro', en: 'The arbiter' },
    s: { it: 'L’ultimo strato decisionale', en: 'The last decision layer' },
    d: { it: 'Regole, vincoli e priorità per scegliere la prossima esperienza migliore, ogni volta.', en: 'Rules, constraints and priorities to pick the next best experience, every time.' },
    i: { it: 'Coesiste col motore di targeting: il motore produce score e audience, qui si arbitrano offerta e canale per ogni contatto.', en: 'It coexists with the targeting engine: the engine produces scores and audiences, here offer and channel are arbitrated per contact.' } },
];

/* Le fonti che entrano nella misura unica. Dal deck, slide «CJA + RT-CDP». */
const FONTI_DATO = [
  { it: 'App e home banking', en: 'App and online banking' },
  { it: 'Sito', en: 'Website' },
  { it: 'Contact center', en: 'Contact centre' },
  { it: 'CRM di filiale', en: 'Branch CRM' },
  { it: 'Data lake e core banking', en: 'Data lake and core banking' },
];
/* ⚠️ QUI C'ERANO TRE BLOCCHI, E DICEVANO LA COSA SBAGLIATA.
   Erano «Controllo di Gestione», «Advanced Analytics» e «Da definire
   insieme»: i primi due sono reparti, non domande, e il terzo non è un
   uso del dato — è una lista di cose da concordare, messa alla pari
   degli altri due come se CJA servisse a produrre questioni aperte.
   Il modo in cui Adobe presenta CJA a una banca retail è un altro, e si
   legge nel materiale di Field Readiness (business case CJA per banche
   retail nordamericane, letti il 30 ott 2026): **una domanda per area
   operativa**, con chi la fa e che cosa la rende rispondibile. Le aree
   che tornano sono acquisizione, legame fra digitale e filiale, share of
   wallet e abbandono — e sono esattamente le quattro di una banca
   italiana che vende mutui.
   ⚠️ Niente nomi di quelle banche in slide: quel materiale è interno. Lo
   schema si riusa, i clienti citati no.
   Le cose da concordare restano, ma dove vanno: nella riga di chiusura,
   non in un blocco che finge di essere un beneficio. */
const DOMANDE_CJA = [
  { q: { it: 'Quale canale porta davvero clienti nuovi?', en: 'Which channel actually brings new customers?' },
    chi: { it: 'Marketing e Controllo di Gestione', en: 'Marketing and management control' },
    d: { it: 'Attribuzione su dati a livello di evento al posto dell’ultimo clic, con la finestra di osservazione dichiarata.', en: 'Attribution on event-level data instead of last click, with the lookback window stated.' } },
  { q: { it: 'Quanto il digitale porta in filiale?', en: 'How much does digital bring into the branch?' },
    chi: { it: 'Direzione commerciale e rete', en: 'Commercial division and the network' },
    d: { it: 'Il percorso online e l’esito allo sportello nello stesso dato: prodotti per cliente, tempo per acquisire.', en: 'The online path and the counter outcome in one dataset: products per customer, time to acquire.' } },
  { q: { it: 'Dove si perde il cross-sell?', en: 'Where is cross-sell lost?' },
    chi: { it: 'Prodotto', en: 'Product' },
    d: { it: 'Coorti e punti di abbandono per segmento, dentro Analysis Workspace, senza aprire una richiesta all’IT.', en: 'Cohorts and drop-off points per segment, inside Analysis Workspace, without raising an IT request.' } },
  { q: { it: 'Chi sta per andarsene, e da dove si vede?', en: 'Who is about to leave, and where does it show?' },
    chi: { it: 'CRM e retention', en: 'CRM and retention' },
    d: { it: 'I punti in cui il percorso si rompe, e i segmenti a rischio che ne derivano, su eventi di tutti i canali.', en: 'The points where the journey breaks, and the at-risk segments that result, on events from every channel.' } },
];

/* ══════════════════════════════════════════════════════════════════════
   IL PROFILO — Real-Time CDP. Quattro passaggi e UNA scelta di disegno.
   La scelta è la slide 56 del deck del 5 novembre («duplicare o federare
   il profilo»), e la verifica sta su due fonti: la guida GTM di
   Real-Time CDP su Field Readiness (30 ott 2026) e la documentazione
   pubblica di Federated Audience Composition.
   ⚠️ IL LIMITE SI DICHIARA COL PREGIO, e qui è preciso: un'audience
   federata è una composizione STATICA, aggiornata a ogni esecuzione
   pianificata, e non si usa nella qualificazione a evento. Venderla come
   «tempo reale» è il modo più rapido di perdere credibilità col loro IT
   al secondo incontro. Richiede inoltre i pacchetti Prime o Ultimate e
   l'acquisto del modulo: sta nella riga di fonte, non in slide.
   ══════════════════════════════════════════════════════════════════════ */
const PROFILO = [
  { fig: 'archivio', t: { it: 'Uno schema dati comune', en: 'One common data schema' },
    d: { it: 'Eventi e attributi scritti nello stesso modo, da qualunque canale arrivino.', en: 'Events and attributes written the same way, whichever channel they come from.' } },
  { fig: 'grafo', t: { it: 'Gli identificativi si cuciono', en: 'Identifiers get stitched' },
    d: { it: 'Cookie, ID dell’app, email, codice cliente: lo stitching li riporta alla stessa persona.', en: 'Cookie, app ID, email, customer number: stitching ties them back to one person.' } },
  { fig: 'serie', t: { it: 'Il grafo si aggiorna da sé', en: 'The graph updates itself' },
    d: { it: 'Man mano che i dati arrivano, non al ricarico della notte.', en: 'As data arrives, not at the nightly reload.' } },
  { fig: 'bordo', t: { it: 'Il consenso viaggia col profilo', en: 'Consent travels with the profile' },
    d: { it: 'Vale su ogni canale, e si revoca in un posto solo.', en: 'It holds on every channel, and is revoked in one place.' } },
];
const SCELTA_PROFILO = [
  { t: { it: 'Portare il dato in piattaforma', en: 'Bring the data into the platform' },
    d: { it: 'Il profilo si costruisce qui: segmentazione libera e qualificazione nel momento in cui l’evento arriva.', en: 'The profile is built here: free segmentation and qualification the moment the event lands.' },
    q: { it: 'Serve una copia del dato', en: 'A copy of the data is needed' } },
  { t: { it: 'Lasciarlo dov’è, e interrogarlo', en: 'Leave it where it is, and query it' },
    d: { it: 'Le audience si compongono sul vostro data warehouse senza copiare il dato. Si ricompongono a ogni esecuzione pianificata, non a evento.', en: 'Audiences are composed on your data warehouse without copying the data. They recompose at each scheduled run, not on an event.' },
    q: { it: 'Il dato regolamentato non si muove', en: 'Regulated data does not move' } },
];

/* ══════════════════════════════════════════════════════════════════════
   LA REGIA — tre modi di eseguire la stessa decisione.
   Dal materiale di affiancamento su Decisioning per una grande banca
   nordamericana (Field Readiness, letto il 30 ott 2026), che li chiama
   «tre gruppi di esecuzione»: SDK al bordo, dentro il percorso, e
   chiamata dal backend del cliente.
   ⚠️ È LA SLIDE CHE PARLA AL LORO STACK REALE, e per questo il terzo
   modo non è un dettaglio tecnico: dice che l'orchestrazione può restare
   dove è oggi e cambiare solo chi decide. Senza quella frase, la
   proposta suona come «sostituite tutto».
   ⚠️ Niente nomi di quella banca in slide: il materiale è interno.
   ══════════════════════════════════════════════════════════════════════ */
const ESEC = [
  { fig: 'bordo', t: { it: 'Al bordo, in sessione', en: 'At the edge, in session' },
    chi: { it: 'SDK web e app, o Edge API', en: 'Web and app SDK, or Edge API' },
    d: { it: 'L’offerta compare sulla pagina o nella schermata mentre la persona è lì.', en: 'The offer appears on the page or screen while the person is there.' } },
  { fig: 'regia', t: { it: 'Dentro il percorso', en: 'Inside the journey' },
    chi: { it: 'Journey Optimizer', en: 'Journey Optimizer' },
    d: { it: 'Il percorso decide quando, e la decisione entra nel messaggio al momento dell’invio.', en: 'The journey decides when, and the decision enters the message at send time.' } },
  { fig: 'canali', t: { it: 'Dai vostri sistemi', en: 'From your own systems' },
    chi: { it: 'API di decisioning', en: 'Decisioning API' },
    d: { it: 'Il vostro backend resta il motore di campagna e chiede solo quale offerta. La postazione del contact center fa la stessa chiamata.', en: 'Your backend stays the campaign engine and only asks which offer. The contact-centre desktop makes the same call.' } },
];

/* ══════════════════════════════════════════════════════════════════════
   L'ARBITRO — come ragiona una decisione, in cinque passaggi.
   Dalla mappatura fra caso d'uso e capacità AJO per una banca (Field
   Readiness, 30 ott 2026): catalogo delle risoluzioni, regole di
   eleggibilità, vincoli, formula di ranking, esito di ripiego.
   ⚠️ IL CONFINE È CITATO, non addolcito: quel materiale dice che il
   motore «non deve essere il sistema di record per eleggibilità
   creditizia, saldi e approvazioni». In una banca è la frase che fa
   passare la slide, perché è la paura che ha chi la guarda.
   ══════════════════════════════════════════════════════════════════════ */
const DECIDE = [
  { n: '1', t: { it: 'Il catalogo', en: 'The catalogue' },
    d: { it: 'Le offerte che esistono, con le loro date e i canali su cui possono uscire.', en: 'The offers that exist, with their dates and the channels they may go out on.' } },
  { n: '2', t: { it: 'L’eleggibilità', en: 'Eligibility' },
    d: { it: 'Chi può ricevere che cosa. Sul credito la dichiara il core, non il motore.', en: 'Who can receive what. On credit the core declares it, not the engine.' } },
  { n: '3', t: { it: 'I vincoli', en: 'The constraints' },
    d: { it: 'Tetto di contatto, consenso, capienza di un’offerta, esclusioni.', en: 'Contact cap, consent, an offer’s capacity, exclusions.' } },
  { n: '4', t: { it: 'La classifica', en: 'The ranking' },
    d: { it: 'Fra le ammesse, l’ordine: quanto vale per la persona e quanto per la banca.', en: 'Among those allowed, the order: what it is worth to the person and to the bank.' } },
  { n: '5', t: { it: 'Il ripiego', en: 'The fallback' },
    d: { it: 'Che cosa esce quando nessuna è ammessa. Dichiarato, non lasciato al caso.', en: 'What goes out when none is allowed. Declared, not left to chance.' } },
];

/* ══════════════════════════════════════════════════════════════════════
   I CASI D'USO — RIFATTI (revisione critica, 30 ott 2026).
   ⚠️ I quattro precedenti erano giusti e piccoli: continuità operativa
   (la simulazione che riparte, l'appuntamento che prosegue, il
   promemoria del documento). Raccontavano che l'esperienza è più comoda,
   e un cliente che ha già pezzi di un altro stack risponde «anche noi
   facciamo così». Non è quello che serve dimostrare: serve mostrare che
   cosa **non si può fare** quando profilo, decisione e misura stanno in tre sistemi diversi.
   Quindi ogni caso d'uso porta due righe nuove: che cosa SERVE perché
   funzioni, e che cosa succede quando quei pezzi sono separati. È lì che
   si vede la differenza fra una somma di strumenti e uno stack.
   ⚠️ Nessun fornitore si nomina: la frase «quando i pezzi stanno in
   sistemi diversi» dice la stessa cosa e non obbliga nessuno in sala a
   difendere una scelta fatta da altri.
   ══════════════════════════════════════════════════════════════════════ */
const CASI = [
  { da: { it: 'Simulazione sul sito', en: 'Simulation on the site' }, a: { it: 'Gestore in filiale', en: 'Adviser in the branch' },
    t: { it: 'Chi non vi conosce, riconosciuto in filiale', en: 'Someone who does not know you, recognised in the branch' },
    serve: { it: 'Un’identità che parte da una visita anonima, una decisione presa in sessione, e una misura che tiene insieme digitale e sportello.', en: 'An identity that starts from an anonymous visit, a decision taken in session, and one measurement holding digital and counter together.' },
    pezzi: { it: 'A pezzi separati: il sito non sa chi è, la filiale ignora la simulazione, e nessuno dei due sa dell’altro.', en: 'With the pieces apart: the site does not know who it is, the branch is unaware of the simulation, and neither knows about the other.' } },
  { da: { it: 'Quattro proposte', en: 'Four proposals' }, a: { it: 'Una, sul canale giusto', en: 'One, on the right channel' },
    t: { it: 'Un tetto di contatto che vale su tutto', en: 'A contact cap that holds everywhere' },
    serve: { it: 'Un arbitro sopra i canali, con tetto di contatto e consenso condivisi fra email, push, SMS, in-app, web e rete.', en: 'One arbiter above the channels, with contact cap and consent shared across email, push, SMS, in-app, web and the network.' },
    pezzi: { it: 'A pezzi separati: ogni canale ha il suo tetto, e la stessa persona riceve tre cose in un giorno e niente la settimana dopo.', en: 'With the pieces apart: each channel has its own cap, and the same person gets three things in a day and nothing the week after.' } },
  { da: { it: 'I vostri sistemi', en: 'Your own systems' }, a: { it: 'La stessa decisione', en: 'The same decision' },
    t: { it: 'La decisione chiesta da chi ce l’ha già', en: 'The decision asked for by whoever already has one' },
    serve: { it: 'Un motore interrogabile via API dal vostro backend e dalla postazione del contact center, senza spostare l’orchestrazione.', en: 'An engine callable over API from your backend and from the contact-centre desktop, without moving the orchestration.' },
    pezzi: { it: 'A pezzi separati: la regola si riscrive in ogni canale, e due canali danno due risposte diverse alla stessa persona.', en: 'With the pieces apart: the rule gets rewritten in every channel, and two channels give the same person two different answers.' } },
  { da: { it: 'Un evento di vita', en: 'A life event' }, a: { it: 'La proposta, quando serve', en: 'The proposal, when it is needed' },
    t: { it: 'Il cross-sell dopo la firma, non a fine trimestre', en: 'Cross-sell after signature, not at quarter end' },
    serve: { it: 'L’evento, l’eleggibilità che arriva dal core, e l’uplift misurato su un gruppo di controllo.', en: 'The event, eligibility coming from the core, and uplift measured against a control group.' },
    pezzi: { it: 'A pezzi separati: la proposta parte quando chiude il trimestre, e di quanto sia servita non si sa dire.', en: 'With the pieces apart: the proposal goes out when the quarter closes, and nobody can say how much it helped.' } },
];

/* L'APPROFONDIMENTO SU «CONTENT FACTORY», dopo quello su farsi trovare.
   I quattro passi vengono dai sei pilastri del Content Supply Chain
   Maturity Assessment di Adobe (strategia e modello operativo, flussi e
   pianificazione, creazione e produzione, gestione degli asset, consegna
   e attivazione, misura e insight), raggruppati in quattro perché sei
   colonne su una slide non si leggono.
   La fascia sotto è il punto per una banca, e viene dal value prop per i
   servizi finanziari di GenStudio letto su Field Readiness il 30 ott
   2026 — «scalable, compliant campaign content»: la conformità non è un
   passaggio a valle, sta dentro la produzione. */
const CSC = [
  { fig: 'flusso', t: { it: 'Pianificare', en: 'Plan' },
    d: { it: 'Una campagna nasce con dentro le sue approvazioni.', en: 'A campaign is born with its approvals inside it.' } },
  { fig: 'varianti', t: { it: 'Produrre', en: 'Produce' },
    d: { it: 'Dodici varianti da un brief solo, già conformi.', en: 'Twelve variants from one brief, already compliant.' } },
  { fig: 'archivio', t: { it: 'Gestire', en: 'Manage' },
    d: { it: 'Si sa che cosa si può usare, dove e fino a quando.', en: 'You know what can be used, where and until when.' } },
  { fig: 'canali', t: { it: 'Attivare e misurare', en: 'Activate and measure' },
    d: { it: 'L’esito rientra nel brief successivo.', en: 'The outcome feeds the next brief.' } },
];
---
<BaseLayout title={ch.title.it}>
  <div class="fixed top-0 left-0 right-0 z-50">
    <Navigation currentPath={currentPath} base={base} />
  </div>

  <DeckContainer nextHref={href(base, nextSlug(SLUG))} prevHref={href(base, prevSlug(SLUG))}>

    {/* ⚠️ QUI C'ERANO LE DUE MAPPE AFFIANCATE, e sono state tolte.
        Elencavano i sette momenti con canale, ora e verbo a sinistra, e
        i blocchi con funzione e prodotti a destra: la prima è quello che
        il CERCHIO del capitolo 03 mostra già, con Giulia al centro e
        meglio; la seconda è quello che fa «Orchestrare l'esperienza del
        cliente» nel capitolo 01, dove sta anche la leggenda dei colori.
        Erano nate quando il cerchio era un ausilio in un angolo. Da
        quando è il centro del capitolo precedente, ripetevano due slide
        appena viste — e il capitolo 04 restava l'unico senza divisore. */}
    <Slide id="slide-cover" bg="secondary" align="left">
      <div slot="backdrop" class="im-div-bg" style={`--foto: url(${fondoCap.src}); --fuoco: center 42%`}></div>
      <Divisore num={ch.num}
        tIt="Sette momenti, e le due viste sullo stesso minuto" tEn="Seven moments, and both views of the same minute"
        lIt="Sopra quello che vede Giulia, sotto quello che fate voi nello stesso istante. Ogni momento si apre in tre passi, con la freccia in basso."
        lEn="Above, what Giulia sees; below, what you do at the same instant. Each moment opens in three steps, with the down arrow." />
    </Slide>

    {MOMENTI.map((m, i) => (
      <Slide id={`slide-m-${m.n}`} bg="inverse" align="left">
        <div slot="backdrop" class="im-bg-vx" style={`--foto: url(${SCENA[i]}); --fuoco: ${FUOCO[i]}; --zoom: ${ZOOM[i]}`}></div>

        <div class="im-due" data-reveal>
          <header class="im-due-testa">
            <T as="span" class="im-mom-blocco" data-gruppo={m.gruppo} it={m.blocco.it} en={m.blocco.en} />
            <T as="span" class="im-due-ora" it={`${m.ora.it} · ${m.dove.it}`} en={`${m.ora.en} · ${m.dove.en}`} />
            <span class="im-due-passo">
              <span class="im-due-passo-n">{m.n}</span>
              <span class="im-due-passo-d">/ {m.of}</span>
            </span>
          </header>

          <section class="im-due-banda" data-lato="cliente" data-substep data-side="in">
            <div class="im-due-txt">
              <p class="im-due-chi">
                <img class="im-due-chi-r" src={ritratto.src} alt="" width="120" height="120" loading="eager" />
                <span>
                  <T as="span" class="im-due-chi-n" it="Giulia" en="Giulia" />
                  <T as="span" class="im-due-chi-q" it="Non ancora cliente" en="Not a customer yet" />
                </span>
              </p>
              <T as="h2" class="im-due-t" it={m.cliente.titolo.it} en={m.cliente.titolo.en} />
              <T as="p" class="im-due-b" it={m.cliente.corpo.it} en={m.cliente.corpo.en} />
            </div>
            <div class="im-due-mock">
              <MockCliente chrome={m.cliente.chrome} scena={SCENE_CLI[i]} compatto />
              <Azione segno={m.cliente.chrome} />
            </div>
          </section>

          <section class="im-due-banda" data-lato="interno" data-substep data-side="in">
            <div class="im-due-txt">
              <p class="im-due-chi">
                <span class="im-due-chi-s" aria-hidden="true">IS</span>
                <span>
                  <T as="span" class="im-due-chi-n" it="In Intesa Sanpaolo" en="Inside Intesa Sanpaolo" />
                  <T as="span" class="im-due-chi-q" it="Perché è stato possibile" en="Why it was possible" />
                </span>
              </p>
              <T as="h2" class="im-due-t" it={m.interno.titolo.it} en={m.interno.titolo.en} />
              <T as="p" class="im-due-b" it={m.interno.corpo.it} en={m.interno.corpo.en} />
              <p class="im-due-pro">{m.prodotto}</p>
              {DOMANDE_IN_SLIDE && <DaVerificare it={m.verifica.it} en={m.verifica.en} />}
            </div>
            <div class="im-due-mock">
              <MockAdobe prodotto={m.interno.prodotto} compatto />
              <Azione segno={m.gruppo} />
            </div>
          </section>
        </div>
      </Slide>
    ))}

    {/* L'approfondimento arriva DOPO il giro di Giulia, non prima: il
        momento 01 ha già mostrato l'assistente che la banca c'è o non
        c'è. Qui si guarda come lo si governa. */}
    <Slide id="slide-brand-visibility" bg="inverse" align="left">
      <div slot="backdrop" class="im-bg-notte"></div>
      <div class="im-ado-cap im-ado-cap--largo" data-reveal>
        <T as="p" class="im-ado-occ" it="Approfondimento · farsi trovare" en="Deep dive · being found" />
        <T as="h2" class="im-ado-t im-ado-t--stretto" it="Il primo momento di Giulia, governato" en="Giulia’s first moment, under control" />
        <T as="p" class="im-ado-l" it="Due strati: prima si misura come comparite nelle risposte generate, poi si interviene. Senza il primo il secondo è un’opinione." en="Two layers: first you measure how you show up in generated answers, then you act. Without the first, the second is an opinion." />

        {/* ⚠️ Gli operatori sono COLONNE della griglia, non figli in
            posizione assoluta che sporgono dalla card: un figlio assoluto
            con `right` negativo gonfia lo `scrollWidth` del genitore, e
            il check `c` lo legge come overflow — un HARD. */}
        <div class="im-bv">
          {BV.map((c, i) => (
            <>
              <section class="im-bv-i" data-strato={c.strato} data-substep data-side="in">
                <FiguraCap segno={c.fig} />
                <T as="span" class="im-bv-t" it={c.t.it} en={c.t.en} />
                <T as="span" class="im-bv-d" it={c.d.it} en={c.d.en} />
              </section>
              {i < BV.length - 1 && <span class="im-bv-op" aria-hidden="true">{i === 1 ? '=' : '+'}</span>}
            </>
          ))}
        </div>

        <div class="im-bv-strati" data-substep data-side="in">
          <T as="span" class="im-bv-strato" data-strato="segnali" it="Strato dei segnali" en="Signal layer" />
          <T as="span" class="im-bv-strato" data-strato="ottimizzazioni" it="Strato delle ottimizzazioni" en="Optimisation layer" />
        </div>

        <T as="p" class="im-fonte-riga" it="Capacità verificate sul materiale Adobe di Field Readiness (Brand Visibility per i servizi finanziari, 30 ott 2026). Adobe Brand Visibility." en="Capabilities verified against Adobe Field Readiness material (Brand Visibility for financial services, 30 Oct 2026). Adobe Brand Visibility." />
      </div>
    </Slide>

    {/* Secondo approfondimento: la fabbrica di contenuti. Sta DOPO
        Brand Visibility perché è il blocco successivo nel giro di
        Giulia — prima vi trovano, poi quello che trovano deve parlare
        la sua lingua. */}
    <Slide id="slide-content-factory" bg="inverse" align="left">
      <div slot="backdrop" class="im-bg-notte"></div>
      <div class="im-ado-cap im-ado-cap--largo" data-reveal>
        <T as="p" class="im-ado-occ" it="Approfondimento · Content Factory" en="Deep dive · content factory" />
        <T as="h2" class="im-ado-t im-ado-t--stretto" it="La catena del contenuto, dal brief alla misura" en="The content chain, from brief to measurement" />
        <T as="p" class="im-ado-l" it="Quattro passi di un giro solo. Il tempo di una campagna non se ne va nel produrre: se ne va nell’approvare e nel ricominciare da capo." en="Four steps of one loop. A campaign’s time does not go into producing: it goes into approving, and into starting over." />

        <div class="im-bv im-csc">
          {CSC.map((c, i) => (
            <>
              <section class="im-bv-i" data-substep data-side="in">
                <FiguraCap segno={c.fig} />
                <T as="span" class="im-bv-t" it={c.t.it} en={c.t.en} />
                <T as="span" class="im-bv-d" it={c.d.it} en={c.d.en} />
              </section>
              {i < CSC.length - 1 && <span class="im-bv-op im-csc-op" aria-hidden="true">→</span>}
            </>
          ))}
        </div>

        {/* La riga che per una banca è il punto. */}
        <div class="im-csc-conf" data-substep data-side="in">
          <T as="span" class="im-csc-conf-t" it="La conformità sta dentro la produzione, non dopo" en="Compliance lives inside production, not after it" />
          <T as="span" class="im-csc-conf-d" it="È la differenza fra dodici varianti pronte e dodici varianti da far rivedere. Su una campagna di mutuo, è la differenza fra uscire questa settimana e uscire il mese prossimo." en="It is the difference between twelve variants ready and twelve variants to review. On a mortgage campaign, it is the difference between launching this week and launching next month." />
        </div>

        <T as="p" class="im-fonte-riga" it="Passi dai sei pilastri del Content Supply Chain Maturity Assessment di Adobe; la riga sulla conformità dal value prop per i servizi finanziari di Adobe GenStudio (Field Readiness, 30 ott 2026)." en="Steps from the six pillars of Adobe’s Content Supply Chain Maturity Assessment; the compliance line from Adobe GenStudio’s financial services value proposition (Field Readiness, 30 Oct 2026)." /> {/* copy-audit-ignore · L1 — riga di fonte: nome del framework, prodotto e data di verifica. Una fonte non si legge in sala, si apre dopo: accorciarla la rende inverificabile. */}
      </div>
    </Slide>

    {/* ── Ingaggiare il cliente, in tre tempi ──────────────────────── */}
    <Slide id="slide-ingaggio-ciclo" bg="inverse" align="left">
      <div slot="backdrop" class="im-bg-notte"></div>
      <div class="im-ado-cap im-ado-cap--largo" data-reveal>
        <T as="p" class="im-ado-occ" it="Approfondimento · parlare a uno per uno" en="Deep dive · speaking one to one" />
        <T as="h2" class="im-ado-t im-ado-t--stretto" it="Quattro componenti di un ciclo che si chiude" en="Four components of a loop that closes" />

        <ul class="im-ciclo">
          {CICLO.map((c) => (
            <li class="im-ciclo-i" data-substep data-side="in">
              <div class="im-ciclo-su">
                <span class="im-ciclo-n">{c.n}</span>
                <FiguraCap segno={c.fig} class="im-ciclo-fig" />
                <T as="span" class="im-bv-t" it={c.t.it} en={c.t.en} />
                <T as="span" class="im-bv-s" it={c.s.it} en={c.s.en} />
                <T as="span" class="im-bv-d" it={c.d.it} en={c.d.en} />
              </div>
              <T as="p" class="im-ciclo-giu" it={c.i.it} en={c.i.en} />
            </li>
          ))}
        </ul>
        <T as="p" class="im-ciclo-base" data-substep data-side="in" it="Sotto tutti e quattro, Adobe Experience Platform." en="Beneath all four, Adobe Experience Platform." />
        <T as="p" class="im-fonte-riga" it="La riga verde è quello che succederebbe nel vostro perimetro, e va confermata con voi." en="The green line is what would happen inside your perimeter, and is to be confirmed with you." />
      </div>
    </Slide>

    <Slide id="slide-ingaggio-dato" bg="inverse" align="left">
      <div slot="backdrop" class="im-bg-notte"></div>
      <div class="im-ado-cap im-ado-cap--largo" data-reveal>
        <T as="p" class="im-ado-occ" it="Approfondimento · la misura unica" en="Deep dive · one measurement" />
        <T as="h2" class="im-ado-t im-ado-t--stretto" it="Una sola misura di app, sito, contact center e filiale" en="One measurement across app, site, contact centre and branch" />

        <div class="im-flusso">
          <ul class="im-flusso-fonti" data-substep data-side="in">
            {FONTI_DATO.map((f) => <li><span data-lang-it>{f.it}</span><span data-lang-en>{f.en}</span></li>)}
          </ul>
          <span class="im-flusso-fr" aria-hidden="true">→</span>
          <section class="im-flusso-aep" data-substep data-side="in">
            <span class="im-flusso-t">Experience Platform</span>
            <T as="span" class="im-flusso-d" it="Identità cross-canale, consenso e schema dati comune. Il grafo si aggiorna man mano che i dati arrivano." en="Cross-channel identity, consent and a common data schema. The graph updates as data arrives." />
          </section>
          <span class="im-flusso-fr" aria-hidden="true">→</span>
          <section class="im-flusso-cja" data-substep data-side="in">
            <span class="im-flusso-t">Customer Journey Analytics</span>
            <T as="span" class="im-flusso-d" it="Percorsi, funnel, coorti e attribuzione su dati a livello di evento." en="Journeys, funnels, cohorts and attribution on event-level data." />
          </section>
        </div>

        {/* Quattro DOMANDE, non tre reparti: una per area operativa, con
            chi la fa e che cosa la rende rispondibile. Vedi il commento
            su `DOMANDE_CJA` per il perché del cambio. */}
        <ul class="im-dom" data-substep data-side="in">
          {DOMANDE_CJA.map((d) => (
            <li class="im-dom-i">
              <T as="span" class="im-dom-chi" it={d.chi.it} en={d.chi.en} />
              <T as="span" class="im-dom-q" it={d.q.it} en={d.q.en} />
              <T as="span" class="im-dom-d" it={d.d.it} en={d.d.en} />
            </li>
          ))}
        </ul>

        <T as="p" class="im-fonte-riga" it="Tre cose si concordano prima: quali identificativi compongono il grafo, la tassonomia degli eventi (anche in filiale), i KPI con i gruppi di controllo dal giorno uno. L’attribuzione sostituisce la congettura sull’ultimo clic con modelli regolati, algoritmici o data-driven. Il limite si dichiara, perché non misura quello che succede fuori dai canali osservati e la finestra di osservazione è una scelta. Schema delle domande e capacità verificati sul materiale Adobe di Field Readiness, 30 ott 2026." en="Three things get agreed first: which identifiers build the graph, the event taxonomy (in the branch too), KPIs with control groups from day one. Attribution replaces last-click guesswork with rule-based, algorithmic or data-driven models. The limit is stated, because it does not measure what happens outside the observed channels and the lookback window is a choice. Question framing and capabilities verified against Adobe Field Readiness material, 30 Oct 2026." />
      </div>
    </Slide>

    {/* ── Il profilo · Real-Time CDP ───────────────────────────────── */}
    <Slide id="slide-ingaggio-profilo" bg="inverse" align="left">
      <div slot="backdrop" class="im-bg-notte"></div>
      <div class="im-ado-cap im-ado-cap--largo" data-reveal>
        <T as="p" class="im-ado-occ" it="Approfondimento · il profilo" en="Deep dive · the profile" />
        <T as="h2" class="im-ado-t im-ado-t--stretto" it="Una persona sola, da identificativi che non si parlano" en="One single person, from identifiers that do not talk to each other" />
        <T as="p" class="im-ado-l" it="Giulia è un cookie sul sito, un numero di telefono al contact center e un codice cliente dopo la firma. Il profilo è il posto in cui diventa una." en="Giulia is a cookie on the site, a phone number at the call centre and a customer number after signature. The profile is where she becomes one." />

        <div class="im-bv im-cat">
          {PROFILO.map((c, i) => (
            <>
              <section class="im-bv-i" data-substep data-side="in">
                <FiguraCap segno={c.fig} />
                <T as="span" class="im-bv-t" it={c.t.it} en={c.t.en} />
                <T as="span" class="im-bv-d" it={c.d.it} en={c.d.en} />
              </section>
              {i < PROFILO.length - 1 && <span class="im-bv-op im-cat-op" aria-hidden="true">→</span>}
            </>
          ))}
        </div>

        {/* La scelta di disegno. Due strade, entrambe legittime: è la
            domanda che il loro IT fa per primo, e arrivarci prima di
            loro vale più che rispondere dopo. */}
        <div class="im-scelta" data-substep data-side="in">
          <T as="p" class="im-scelta-k" it="Una scelta di disegno, da fare insieme" en="One design choice, to make together" />
          <div class="im-scelta-g">
            {SCELTA_PROFILO.map((o) => (
              <section class="im-scelta-i">
                <T as="span" class="im-scelta-t" it={o.t.it} en={o.t.en} />
                <T as="span" class="im-scelta-d" it={o.d.it} en={o.d.en} />
                <T as="span" class="im-scelta-q" it={o.q.it} en={o.q.en} />
              </section>
            ))}
          </div>
        </div>

        <p class="im-fonte-riga">
          <span data-lang-it>La seconda strada è </span><span data-lang-en>The second route is </span>
          <a href="https://experienceleague.adobe.com/en/docs/federated-audience-composition/using/overview" target="_blank" rel="noopener">Federated Audience Composition</a><span
            data-lang-it>: un modulo di Real-Time CDP e Journey Optimizer, con i suoi prerequisiti di pacchetto. Compone audience sul data warehouse senza copiarne il dato, e quelle audience si aggiornano a ogni esecuzione pianificata, non alla qualificazione a evento. Capacità verificate sulla guida GTM di Real-Time CDP (Field Readiness, 30 ott 2026) e sulla documentazione pubblica.</span>
          <span data-lang-en>: a module of Real-Time CDP and Journey Optimizer, with its own package prerequisites. It composes audiences on the data warehouse without copying the data, and those audiences refresh at each scheduled run, not on event qualification. Capabilities verified against the Real-Time CDP GTM guide (Field Readiness, 30 Oct 2026) and the public documentation.</span>
        </p>
      </div>
    </Slide>

    {/* ── La regia · Journey Optimizer ─────────────────────────────── */}
    <Slide id="slide-ingaggio-regia" bg="inverse" align="left">
      <div slot="backdrop" class="im-bg-notte"></div>
      <div class="im-ado-cap im-ado-cap--largo" data-reveal>
        <T as="p" class="im-ado-occ" it="Approfondimento · la regia" en="Deep dive · orchestration" />
        <T as="h2" class="im-ado-t im-ado-t--stretto" it="Tre modi di eseguire la stessa decisione" en="Three ways to execute the same decision" />
        <T as="p" class="im-ado-l" it="La decisione si configura una volta. Dove viene eseguita è una scelta, e le tre strade convivono." en="The decision is configured once. Where it runs is a choice, and the three routes coexist." />

        <div class="im-esec">
          {ESEC.map((e) => (
            <section class="im-esec-i" data-substep data-side="in">
              <FiguraCap segno={e.fig} class="im-esec-fig" />
              <T as="span" class="im-bv-t" it={e.t.it} en={e.t.en} />
              <T as="span" class="im-esec-chi" it={e.chi.it} en={e.chi.en} />
              <T as="span" class="im-bv-d" it={e.d.it} en={e.d.en} />
            </section>
          ))}
        </div>

        <div class="im-csc-conf im-csc-conf--eng" data-substep data-side="in">
          <T as="span" class="im-csc-conf-t" it="Il terzo modo è la risposta a «e quello che abbiamo già?»" en="The third route is the answer to «and what we already have?»" />
          <T as="span" class="im-csc-conf-d" it="L’orchestrazione può restare dove è oggi: cambia solo chi decide quale offerta esce. E il tetto di contatto resta lo stesso per tutte e tre le strade, perché l’arbitro è uno." en="The orchestration can stay where it is today: only who decides which offer goes out changes. And the contact cap stays the same across all three routes, because there is one arbiter." />
        </div>

        <T as="p" class="im-fonte-riga" it="I tre gruppi di esecuzione vengono dal materiale Adobe di Field Readiness sul decisioning per una grande banca retail, letto il 30 ott 2026. Adobe Journey Optimizer." en="The three execution groups come from Adobe Field Readiness material on decisioning for a large retail bank, read 30 Oct 2026. Adobe Journey Optimizer." />
      </div>
    </Slide>

    {/* ── L'arbitro · AI Decisioning ───────────────────────────────── */}
    <Slide id="slide-ingaggio-arbitro" bg="inverse" align="left">
      <div slot="backdrop" class="im-bg-notte"></div>
      <div class="im-ado-cap im-ado-cap--largo" data-reveal>
        <T as="p" class="im-ado-occ" it="Approfondimento · l’arbitro" en="Deep dive · the arbiter" />
        <T as="h2" class="im-ado-t im-ado-t--stretto" it="Come ragiona una decisione, in cinque passaggi" en="How a decision reasons, in five steps" />
        <T as="p" class="im-ado-l" it="Le quattro candidate della slide d’apertura passano da qui, e una sola esce. Questi sono i cinque passaggi che la scelgono." en="The four candidates from the opening slide pass through here, and only one goes out. These are the five steps that pick it." />

        <ol class="im-dec">
          {DECIDE.map((d) => (
            <li class="im-dec-i" data-substep data-side="in">
              <span class="im-dec-n">{d.n}</span>
              <T as="span" class="im-bv-t" it={d.t.it} en={d.t.en} />
              <T as="span" class="im-bv-d" it={d.d.it} en={d.d.en} />
            </li>
          ))}
        </ol>

        {/* Il confine. Si dice prima, perché è la paura di chi guarda. */}
        <div class="im-confine" data-substep data-side="in">
          <T as="span" class="im-confine-t" it="Dove si fermano le nostre regole" en="Where our rules stop" />
          <T as="span" class="im-confine-d" it="Il motore non è il sistema di record dell’eleggibilità creditizia, dei saldi e delle approvazioni: quelli restano nel core banking. Qui si scelgono offerta, canale e momento fra ciò che il core ha già dichiarato ammissibile." en="The engine is not the system of record for credit eligibility, balances or approvals: those stay in core banking. Here offer, channel and timing are chosen among what the core has already declared eligible." />
        </div>

        <T as="p" class="im-fonte-riga" it="Passaggi e confine dalla mappatura fra caso d’uso e capacità di Journey Optimizer per una banca, materiale Adobe di Field Readiness letto il 30 ott 2026." en="Steps and boundary from a use-case-to-capability mapping of Journey Optimizer for a bank, Adobe Field Readiness material read 30 Oct 2026." />
      </div>
    </Slide>

    <Slide id="slide-ingaggio-casi" bg="inverse" align="left">
      <div slot="backdrop" class="im-bg-notte"></div>
      <div class="im-ado-cap im-ado-cap--largo" data-reveal>
        <T as="p" class="im-ado-occ" it="Approfondimento · casi d’uso" en="Deep dive · use cases" />
        <T as="h2" class="im-ado-t im-ado-t--stretto" it="Quattro cose che riescono solo se i pezzi stanno insieme" en="Four things that only work when the pieces hold together" />
        <T as="p" class="im-ado-l" it="Omnicanale non vuol dire essere su tutti i canali. Vuol dire che chi arriva dopo non chiede di nuovo." en="Omnichannel does not mean being on every channel. It means whoever comes next does not ask again." />

        <ul class="im-casi">
          {CASI.map((c) => (
            <li class="im-casi-i" data-substep data-side="in">
              <p class="im-casi-rotta">
                <T as="span" class="im-casi-da" it={c.da.it} en={c.da.en} />
                <span class="im-casi-fr" aria-hidden="true">→</span>
                <T as="span" class="im-casi-a" it={c.a.it} en={c.a.en} />
              </p>
              <T as="span" class="im-bv-t" it={c.t.it} en={c.t.en} />
              <T as="span" class="im-bv-d" it={c.serve.it} en={c.serve.en} />
              <T as="span" class="im-casi-pezzi" it={c.pezzi.it} en={c.pezzi.en} />
            </li>
          ))}
        </ul>
        <T as="p" class="im-fonte-riga" it="Casi d’uso proposti sul vostro perimetro, da prioritizzare insieme: la fattibilità di ciascuno dipende da quali dati sono già in piattaforma. La riga in basso di ogni caso dice che cosa resta fuori portata quando profilo, decisione e misura stanno in sistemi diversi." en="Use cases proposed for your perimeter, to be prioritised together: the feasibility of each depends on which data is already on the platform. The bottom line of each case says what stays out of reach when profile, decision and measurement live in different systems." />
      </div>
    </Slide>

  </DeckContainer>
