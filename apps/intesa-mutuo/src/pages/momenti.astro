---
/**
 * I sette momenti — LE DUE VISTE SULLA STESSA SLIDE.
 *
 * ⚠️ PERCHÉ UNA SOLA SLIDE PER PASSO (feedback del team, 29 ott 2026).
 * Prima erano due capitoli: sette slide con Giulia, poi sette con chi
 * prepara. Chi guardava doveva tenere a mente il momento 04 per sei
 * slide e ricollegarlo da solo — e in sala nessuno lo fa. Ora i due lati
 * dello stesso minuto stanno uno sopra l'altro: **in alto Giulia, in
 * basso chi prepara in Intesa Sanpaolo**, e il legame si vede invece di
 * essere affermato.
 *
 * A destra il CIRCOLO: dice a che punto del giro siamo, e che il giro si
 * chiude. Non è una barra di avanzamento, è l'argomento.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import T from '@edf/core/blocks/i18n/T.astro';
import { href } from '@edf/core/utils/url.js';
import { CHAPTERS, prevSlug, nextSlug } from '../data/chapters';
import { MOMENTI, DOMANDE_IN_SLIDE } from '../data/momenti';
import MockCliente from '../components/MockCliente.astro';
import MockAdobe from '../components/MockAdobe.astro';
import MappaDoppia from '../components/MappaDoppia.astro';
import DaVerificare from '../components/DaVerificare.astro';
import Azione from '../components/Azione.astro';
/* Le scene vengono da Pexels, licenziate, con autore e URL in
   provenance.json. Sono LUOGHI senza volti: l'unico volto della Storia è
   il ritratto di Giulia, così la persona resta coerente per costruzione. */
import s0 from '../assets/generated/scena-01-divano.webp';
import s1 from '../assets/generated/scena-02-bar.webp';
import s2 from '../assets/generated/scena-03-tavolo.webp';
import s3 from '../assets/generated/scena-04-documenti.webp';
import s4 from '../assets/generated/scena-05-colazione.webp';
import s5 from '../assets/generated/scena-06-filiale.webp';
import s6 from '../assets/generated/scena-07-casa.webp';
/* L'unico volto della Storia. Sta nel CHIP in alto a sinistra di ogni
   banda di Giulia: è il device con cui l'XD Visa tiene la persona
   riconoscibile slide dopo slide, ed è la stessa regola che qui vieta
   sette volti diversi (`giulia-single-journey-portrait-reuse`). */
import ritratto from '../assets/generated/persona-giulia.webp';
const SCENA = [s0, s1, s2, s3, s4, s5, s6].map((x) => x.src);
const SCENE_CLI = ['ricerca','feed','simulazione','documenti','ripresa','sportello','firma'] as const;
/* Il punto di fuoco di ogni scena dentro la fascia 47%×56%: un ritaglio
   di default taglia dove capita, e su una fotografia di luogo il
   soggetto non sta quasi mai al centro.
   ⚠️ La 06 non è una preferenza estetica: quella scena porta il nome di
   uno studio di coworking in rilievo sul muro, al 62-76% della
   larghezza. Un marchio che non è né Adobe né Intesa dentro una slide di
   Intesa è la wrong-brand imagery che la Quality Bar vieta, e il
   ritaglio lo lascia fuori campo. Sostituire la foto resta la soluzione
   migliore, e richiede una chiave Pexels. */
const FUOCO = ['center 40%','center 44%','center 42%','center 38%','center 44%','6% 50%','center 36%'];
/* Lo zoom serve solo alla 06: con `cover` la fascia mostra l'84% della
   larghezza della foto, e il marchio dello studio — che sta al 62-76% —
   resta dentro QUALUNQUE sia il punto di fuoco. Al 180% la fascia mostra
   il 2-58%, e il marchio esce di campo. Verificato guardando la pagina,
   non calcolandolo soltanto.
   Due sostituzioni cercate su Pexels sono state scartate guardandole: un
   bancone da buffet e una scena con un secondo volto femminile, che la
   regola dell'unico volto vieta. */
const ZOOM = ['cover','cover','cover','cover','cover','180% auto','cover'];

const SLUG = 'momenti';
const ch = CHAPTERS.find((c) => c.slug === SLUG)!;
const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;
---
<BaseLayout title={ch.title.it}>
  <div class="fixed top-0 left-0 right-0 z-50">
    <Navigation currentPath={currentPath} base={base} />
  </div>

  <DeckContainer nextHref={href(base, nextSlug(SLUG))} prevHref={href(base, prevSlug(SLUG))}>

    <Slide id="slide-cover" bg="inverse" align="center">
      <div slot="backdrop" class="im-bg-notte"></div>
      <div class="im-ch im-ch--map" data-reveal>
        <p class="im-ch-num"><span data-lang-it>Capitolo {ch.num}</span><span data-lang-en>Chapter {ch.num}</span></p>
        <T as="h2" class="im-ch-t" it="Sette momenti, e le due viste sullo stesso minuto" en="Seven moments, and both views of the same minute" data-reveal data-reveal-delay="0.08" />
      </div>
      <MappaDoppia data-reveal data-reveal-delay="0.16" />
      <T as="p" class="im-guida" data-reveal data-reveal-delay="0.3"
         it="Ogni momento si apre in tre passi, con la freccia in basso: ↓ Giulia · ↓ Intesa Sanpaolo · ↓ la riga «da verificare con voi», che è il punto dove questa meccanica cambia le cose."
         en="Each moment opens in three steps, with the down arrow: ↓ Giulia · ↓ Intesa Sanpaolo · ↓ the “to check with you” line, which is where this mechanic changes things." />
    </Slide>

    {MOMENTI.map((m, i) => (
      <Slide id={`slide-m-${m.n}`} bg="inverse" align="left">
        <div slot="backdrop" class="im-bg-vx" style={`--foto: url(${SCENA[i]}); --fuoco: ${FUOCO[i]}; --zoom: ${ZOOM[i]}`}></div>

        <div class="im-due" data-reveal>
          <header class="im-due-testa">
            <T as="span" class="im-mom-blocco" data-gruppo={m.gruppo} it={m.blocco.it} en={m.blocco.en} />
            <T as="span" class="im-due-ora" it={`${m.ora.it} · ${m.dove.it}`} en={`${m.ora.en} · ${m.dove.en}`} />
            <span class="im-due-passo">
              <span class="im-due-passo-n">{m.n}</span>
              <span class="im-due-passo-d">/ {m.of}</span>
            </span>
          </header>

          <section class="im-due-banda" data-lato="cliente" data-substep data-side="in">
            <div class="im-due-txt">
              <p class="im-due-chi">
                <img class="im-due-chi-r" src={ritratto.src} alt="" width="120" height="120" loading="eager" />
                <span>
                  <T as="span" class="im-due-chi-n" it="Giulia" en="Giulia" />
                  <T as="span" class="im-due-chi-q" it="Non ancora cliente" en="Not a customer yet" />
                </span>
              </p>
              <T as="h2" class="im-due-t" it={m.cliente.titolo.it} en={m.cliente.titolo.en} />
              <T as="p" class="im-due-b" it={m.cliente.corpo.it} en={m.cliente.corpo.en} />
            </div>
            <div class="im-due-mock">
              <MockCliente chrome={m.cliente.chrome} scena={SCENE_CLI[i]} compatto />
              <Azione segno={m.cliente.chrome} />
            </div>
          </section>

          <section class="im-due-banda" data-lato="interno" data-substep data-side="in">
            <div class="im-due-txt">
              <p class="im-due-chi">
                <span class="im-due-chi-s" aria-hidden="true">IS</span>
                <span>
                  <T as="span" class="im-due-chi-n" it="In Intesa Sanpaolo" en="Inside Intesa Sanpaolo" />
                  <T as="span" class="im-due-chi-q" it="Perché è stato possibile" en="Why it was possible" />
                </span>
              </p>
              <T as="h2" class="im-due-t" it={m.interno.titolo.it} en={m.interno.titolo.en} />
              <T as="p" class="im-due-b" it={m.interno.corpo.it} en={m.interno.corpo.en} />
              <p class="im-due-pro">{m.prodotto}</p>
              {DOMANDE_IN_SLIDE && <DaVerificare it={m.verifica.it} en={m.verifica.en} />}
            </div>
            <div class="im-due-mock">
              <MockAdobe prodotto={m.interno.prodotto} compatto />
              <Azione segno={m.gruppo} />
            </div>
          </section>
        </div>
      </Slide>
    ))}

  </DeckContainer>
</BaseLayout>
