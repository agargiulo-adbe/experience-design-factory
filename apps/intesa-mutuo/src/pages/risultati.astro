---
/**
 * Risultati — che cosa cambia, e chi lo ha già fatto.
 *
 * Ogni cifra porta la banca che l'ha prodotta e il link che la regge: non
 * sono promesse su Intesa Sanpaolo, sono risultati di altri, e la pagina lo
 * dice invece di lasciarlo capire. Fonti aperte e lette il 29 ott 2026.
 *
 * L'ultima slide è la slide-FIRMA: lockup grande e CTA di ritorno. Per
 * contratto è una slide a sé — la chiusura densa più il lockup sborda.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import CoBrand from '../components/CoBrand.astro';
import T from '@edf/core/blocks/i18n/T.astro';
import { href } from '@edf/core/utils/url.js';
import { CHAPTERS, prevSlug } from '../data/chapters';
import LoopVideo from '@edf/core/blocks/immersive/LoopVideo.astro';
/* Numeri, misure e ask vengono dalla FONTE UNICA: il taglio «In dieci
   minuti» legge gli stessi oggetti, e due copie a mano divergono. */
import { FONTI, CIFRE_TSB, MISURE, ASK } from '../data/referenze';
import fondo from '../assets/generated/fondo-risultati.webp';
import fondoTsb from '../assets/generated/fondo-tsb.webp';
import MarchioRef from '../components/MarchioRef.astro';

/* La clip sta sul Release `media`, ricucita con `pnpm loop:seamless`. */
const CLIP = 'https://github.com/agargiulo-adbe/experience-design-factory/releases/download/media';

const SLUG = 'risultati';
const ch = CHAPTERS.find((c) => c.slug === SLUG)!;
const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;

const TSB = FONTI.tsb;
const SAN = FONTI.santander;

---
<BaseLayout title={ch.title.it}>
  <div class="fixed top-0 left-0 right-0 z-50">
    <Navigation currentPath={currentPath} base={base} />
  </div>

  <DeckContainer nextHref={href(base, '/')} prevHref={href(base, prevSlug(SLUG))}>

    <Slide id="slide-cover" bg="inverse" align="center">
      <div slot="backdrop" class="im-bg-scena" style={`--bg: url(${fondo.src})`}></div>
      <div class="im-ch" data-reveal>
        <p class="im-ch-num"><span data-lang-it>Capitolo {ch.num}</span><span data-lang-en>Chapter {ch.num}</span></p>
        <T as="h2" class="im-ch-t" it="Una banca che lo fa già, e lo dice in pubblico" en="A bank already doing it, and saying so publicly" data-reveal data-reveal-delay="0.08" />
        <T as="p" class="im-ch-l" it="Non sono promesse su di voi. Sono risultati di altre banche, con la pagina che li regge." en="Not promises about you. Other banks’ results, with the page that backs them." data-reveal data-reveal-delay="0.15" />
      </div>
    </Slide>

    <Slide id="slide-tsb" bg="inverse" align="left">
      <div slot="backdrop" class="im-bg-doppia" style={`--bg: url(${fondoTsb.src})`}></div>
      <div class="im-sl" data-reveal>
        <div class="im-sl-head">
          <p class="im-sl-marchio"><MarchioRef slug="tsb" nome="TSB" /></p>
          <T as="h2" class="im-h2" it="La prima banca britannica su Experience Platform" en="The first UK bank on Experience Platform" />
          <T as="p" class="im-sub" it="È l’unica referenza pubblica in cui Offer Decisioning è nominato. E l’esempio che racconta è una pratica di mutuo lasciata a metà in app: parole loro." en="The only public reference naming Offer Decisioning. And the example it tells is a mortgage left half-done in the app: their words." />
        </div>
        <div class="im-cifre" data-stagger>
          {CIFRE_TSB.map((c) => (
            <div class="im-cifra">
              <p class="im-cifra-n" data-display>{c.n}</p>
              <T as="p" class="im-cifra-l" it={c.l.it} en={c.l.en} />
            </div>
          ))}
        </div>
        <p class="im-fonte" data-reveal data-reveal-delay="0.3">
          <span data-lang-it>Fonte: </span><span data-lang-en>Source: </span>
          <a href={TSB} target="_blank" rel="noopener">business.adobe.com · TSB</a>
          <span data-lang-it> · verificata il 29 ottobre 2026</span><span data-lang-en> · checked 29 October 2026</span>
        </p>
      </div>
    </Slide>

    <Slide id="slide-italia" bg="secondary" align="left">
      <div class="im-sl" data-reveal>
        <div class="im-sl-head">
          <p class="im-n">E vicino a voi</p>
          <T as="h2" class="im-h2" it="Due banche, due numeri diversi" en="Two banks, two different numbers" />
          <T as="p" class="im-sub" it="Perché la domanda che arriva sempre è «sì, ma da noi?». Nessuna delle due è una banca come la vostra: dicono che cosa si misura, non quanto. Il primo numero è proprio sul primo acquisto." en="Because the question always comes: «yes, but here?». Neither is a bank like yours: they say what gets measured, not how much. The first number is about first purchase." />
        </div>
        <div class="im-ref" data-stagger>
          <div class="im-ref-b">
            <MarchioRef slug="credit-agricole" nome="Crédit Agricole Italia" />
            <T as="p" class="im-ref-f" it="+15% sul primo acquisto e +20% di cross-sell, con percorsi in tempo reale sui canali digitali e fisici." en="+15% on first purchase and +20% cross-sell, with real-time journeys across digital and physical channels." />
          </div>
          <div class="im-ref-b">
            <MarchioRef slug="santander" nome="Santander Brasil" />
            <T as="p" class="im-ref-f" it="Oltre 100 milioni di profili in una vista sola, con Real-Time CDP, Journey Optimizer e Customer Journey Analytics." en="Over 100 million profiles in a single view, with Real-Time CDP, Journey Optimizer and Customer Journey Analytics." />
          </div>
        </div>
        <p class="im-fonte" data-reveal data-reveal-delay="0.3">
          <span data-lang-it>Fonti: </span><span data-lang-en>Sources: </span>
          <a href={SAN} target="_blank" rel="noopener">business.adobe.com · Santander</a>
          <span data-lang-it> · Crédit Agricole Italia: caso cliente Adobe non pubblicato, si cita a voce</span>
          <span data-lang-en> · Crédit Agricole Italia: unpublished Adobe case, cited verbally</span>
        </p>
      </div>
    </Slide>

    <Slide id="slide-da-voi" bg="inverse" align="left">
      <div class="im-sl" data-reveal>
        <div class="im-sl-head">
          <p class="im-n">Da voi</p>
          <T as="h2" class="im-h2" it="Che cosa misureremmo, dal giorno uno" en="What we would measure, from day one" />
          <T as="p" class="im-sub" it="Non un numero promesso, ma il modo di saperlo: un gruppo di controllo fin dall’inizio, su un percorso solo. Quattro misure di acquisizione, e tre oggi non si sanno." en="Not a promised number, but the way to know it: a control group from the start, on a single journey. Four acquisition measures, and three are unknown today." />
        </div>
        <div class="im-mis" data-stagger>
          {MISURE.map((m) => (
            <div class="im-mis-b" data-chiave={m.chiave ? '' : null}>
              <T as="p" class="im-mis-l" it={m.l.it} en={m.l.en} />
              <p class="im-mis-r">
                <span class="im-mis-oggi"><span data-lang-it>{m.oggi.it}</span><span data-lang-en>{m.oggi.en}</span></span>
                <span class="im-mis-f" aria-hidden="true"></span>
                <span class="im-mis-poi"><span data-lang-it>{m.poi.it}</span><span data-lang-en>{m.poi.en}</span></span>
              </p>
            </div>
          ))}
        </div>
        <T as="p" class="im-chiusa" it={ASK.it} en={ASK.en} data-reveal data-reveal-delay="0.3" />
      </div>
    </Slide>

    <Slide id="slide-firma" bg="inverse" align="center"
           data-made-with="Adobe Firefly" data-made-with-for="clip" data-audio="loud">
      <LoopVideo slot="backdrop" src={`${CLIP}/innesto-chiusura.loop.mp4`}
                 poster={`${base}media/innesto-chiusura.poster.jpg`}
                 scrim="im-clip-scrim" opacity={1} />
      <div class="im-firma" data-reveal>
        <CoBrand variant="hero" class="im-cov-lockup edf-cobrand--on-dark" />
        <T as="p" class="im-firma-l" it="Il segnale ce l’avete già. Manca il posto dove si decide che farne." en="You already have the signal. What is missing is where to decide what to do with it." data-reveal data-reveal-delay="0.14" />
        <a href={href(base, '/')} class="edf-sig-cta">
          <span data-lang-it>Torna all’inizio</span><span data-lang-en>Back to the start</span>
        </a>
      </div>
    </Slide>

  </DeckContainer>
</BaseLayout>
