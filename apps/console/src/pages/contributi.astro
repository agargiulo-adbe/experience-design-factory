---
/**
 * Contributi — la curatela della versione B delle edizioni da distribuire
 * (spec 2026-11-19, §8-§9 e «Revisione del 19 nov sera»; migrazione 0041).
 * Qui si legge ciò che è arrivato dal modulo anonimo, si approva o si esclude,
 * si assegna l'area evolutiva, si riformula chi si è reso riconoscibile nel
 * testo (l'originale resta), si scrive la risposta, e si vede il riepilogo con
 * le stesse soglie che vede la banca. Le righe le leggono solo i membri del
 * progetto (`progetto_membri`) e i super admin: lo fa la RLS, non questa pagina.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { FUNZIONI, LIVELLI } from '@edf/core/utils/contributi';
---
<BaseLayout title="Contributi" active="contributi">
  <div class="page-head">
    <div>
      <h1 class="page-title">Contributi</h1>
      <p class="page-sub">Le domande arrivate dal modulo anonimo delle edizioni da distribuire, e il riepilogo per la banca.</p>
    </div>
    <label class="ct-prog">Progetto <select data-ct-prog></select></label>
  </div>

  <section class="ct-testa" data-ct-testa hidden>
    <div class="ct-card">
      <h2 class="ct-h">Il riepilogo</h2>
      <p data-ct-stato></p>
      <p class="ct-link"><a data-ct-link target="_blank" rel="noopener">Apri come lo vede la banca</a> · <button type="button" class="ct-btn ct-btn--2" data-ct-copia>Copia il link</button></p>
      <p class="ct-az">
        <button type="button" class="ct-btn" data-ct-approva>Segna approvato dal referente</button>
        <button type="button" class="ct-btn ct-btn--2" data-ct-aperto></button>
      </p>
      <p class="ct-nota">L’approvazione la dà il referente a voce o per mail; qui la si registra. Un contributo curato dopo la riporta in bozza.</p>
    </div>
    <div class="ct-card">
      <h2 class="ct-h">Aperture</h2>
      <p class="ct-nota">Copertina e pagina breve, per giorno. Nessun dato su chi apre.</p>
      <table class="ct-tab" data-ct-aperture></table>
    </div>
  </section>

  <div class="ct-filtri" data-ct-filtri hidden>
    <button type="button" class="ct-f is-on" data-f="nuovo">Nuovi</button>
    <button type="button" class="ct-f" data-f="approvato">Approvati</button>
    <button type="button" class="ct-f" data-f="escluso">Esclusi</button>
    <button type="button" class="ct-f" data-f="">Tutti</button>
  </div>
  <div class="ct-lista" data-ct-lista><p class="ct-nota">Caricamento…</p></div>
  <datalist id="ct-aree"></datalist>

  <script define:vars={{ FUNZIONI, LIVELLI }} is:inline>
    window.__CT = { FUNZIONI, LIVELLI };
  </script>
  <script>
    import { requireAuth } from '../lib/guard';
    import { rest } from '../lib/supabase';

    type C = { id: string; progetto: string; sezione: string; testo: string; funzione: string | null; livello: string | null;
      ok_riepilogo: boolean; stato: string; area: string | null; testo_curato: string | null; risposta: string | null; ts: string };
    const { FUNZIONI, LIVELLI } = (window as any).__CT as { FUNZIONI: { k: string; l: string }[]; LIVELLI: { k: string; l: string }[] };
    const eti = (l: { k: string; l: string }[], k: string | null) => (k ? l.find((x) => x.k === k)?.l ?? k : 'non indicata');
    const esc = (s: unknown) => String(s ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]!));
    const q = <T extends HTMLElement>(s: string) => document.querySelector<T>(s)!;
    const PAGES = 'https://agargiulo-adbe.github.io/experience-design-factory';

    (async () => {
      const ctx = await requireAuth();
      if (!ctx) return;
      const { session } = ctx;
      let riep: { progetto: string; share_token: string | null; aperto: boolean; approvato_il: string | null }[] = [];
      try { riep = await rest('riepiloghi?select=*&order=progetto', {}, session); } catch { /* sotto */ }
      const sel = q<HTMLSelectElement>('[data-ct-prog]');
      if (!riep.length) { q('[data-ct-lista]').innerHTML = '<p class="ct-nota">Nessun progetto che raccoglie contributi, o non sei fra i membri di nessuno.</p>'; return; }
      sel.innerHTML = riep.map((r) => `<option value="${esc(r.progetto)}">${esc(r.progetto)}</option>`).join('');
      let filtro = 'nuovo';

      async function testa() {
        const r = riep.find((x) => x.progetto === sel.value)!;
        q('[data-ct-testa]').hidden = false;
        q('[data-ct-filtri]').hidden = false;
        const link = r.share_token ? `${PAGES}/${r.progetto}/riepilogo/?t=${r.share_token}` : '';
        const a = q<HTMLAnchorElement>('[data-ct-link]');
        a.href = link || '#';
        q('[data-ct-copia]').onclick = () => navigator.clipboard.writeText(link);
        const ap = q<HTMLButtonElement>('[data-ct-aperto]');
        ap.textContent = r.aperto ? 'Chiudi la raccolta' : 'Riapri la raccolta';
        ap.onclick = async () => { await rest(`riepiloghi?progetto=eq.${encodeURIComponent(r.progetto)}`, { method: 'PATCH', body: JSON.stringify({ aperto: !r.aperto }) }, session); r.aperto = !r.aperto; testa(); };
        q('[data-ct-approva]').onclick = async () => {
          if (!confirm('Il referente ha approvato il riepilogo così com’è adesso?')) return;
          const now = new Date().toISOString();
          await rest(`riepiloghi?progetto=eq.${encodeURIComponent(r.progetto)}`, { method: 'PATCH', body: JSON.stringify({ approvato_il: now }) }, session);
          r.approvato_il = now; testa();
        };
        try {
          const p = await rest('rpc/riepilogo_anteprima', { method: 'POST', body: JSON.stringify({ p_progetto: r.progetto }) }, session);
          const STATI: Record<string, string> = { in_preparazione: 'In preparazione: la banca vede solo che la raccolta è aperta (servono almeno tre funzioni).', bozza: 'Bozza: la banca la vede con la filigrana «Bozza».', approvato: 'Approvato: la banca lo vede pulito.' };
          const liv = (p.livelli as { livelli: string[]; n: number }[]).map((g) => `${g.n} ${g.livelli.join('+')}`).join(', ') || 'nessun livello sopra soglia';
          q('[data-ct-stato]').innerHTML = `<strong>${esc(STATI[p.stato] ?? p.stato)}</strong><br>${esc(p.totale)} contributi nel riepilogo da ${esc(p.funzioni)} funzioni · livelli: ${esc(liv)}`;
        } catch (e) { q('[data-ct-stato]').textContent = 'Anteprima non disponibile: ' + (e as Error).message; }
        try {
          const ap2: { giorno: string; pagina: string; aperture: number }[] = await rest(`aperture_per_giorno?progetto=eq.${encodeURIComponent(r.progetto)}&order=giorno.desc&limit=60`, {}, session);
          const giorni = [...new Set(ap2.map((x) => x.giorno))];
          q('[data-ct-aperture]').innerHTML = giorni.length
            ? '<tr><th>Giorno</th><th>Copertina</th><th>Breve</th></tr>' + giorni.map((g) => `<tr><td>${esc(g)}</td><td>${ap2.find((x) => x.giorno === g && x.pagina === 'copertina')?.aperture ?? 0}</td><td>${ap2.find((x) => x.giorno === g && x.pagina === 'breve')?.aperture ?? 0}</td></tr>`).join('')
            : '<tr><td>Nessuna apertura registrata.</td></tr>';
        } catch { q('[data-ct-aperture]').innerHTML = '<tr><td>Aperture non disponibili.</td></tr>'; }
      }

      async function lista() {
        const el = q('[data-ct-lista]');
        let righe: C[] = [];
        try {
          righe = await rest(`contributi?progetto=eq.${encodeURIComponent(sel.value)}${filtro ? `&stato=eq.${filtro}` : ''}&order=ts.desc`, {}, session);
        } catch (e) { el.innerHTML = `<p class="ct-nota">Non riesco a leggere i contributi: ${esc((e as Error).message)}</p>`; return; }
        const aree = [...new Set(righe.map((r) => r.area).filter(Boolean))];
        q('#ct-aree').innerHTML = aree.map((a) => `<option value="${esc(a)}">`).join('');
        if (!righe.length) { el.innerHTML = '<p class="ct-nota">Niente qui.</p>'; return; }
        el.innerHTML = righe.map((r) => `
          <article class="ct-card ct-c" data-id="${esc(r.id)}">
            <p class="ct-meta">${esc(new Date(r.ts).toLocaleString('it-IT'))} · <strong>${esc(r.sezione)}</strong> · funzione ${esc(eti(FUNZIONI, r.funzione))} · livello ${esc(eti(LIVELLI, r.livello))} · ${r.ok_riepilogo ? '<span class="ct-si">può entrare nel riepilogo</span>' : '<span class="ct-no">solo per noi: non entra nel riepilogo</span>'}</p>
            <blockquote class="ct-testo">${esc(r.testo)}</blockquote>
            <div class="ct-campi">
              <label>Stato <select name="stato">${['nuovo', 'approvato', 'escluso'].map((s) => `<option ${s === r.stato ? 'selected' : ''}>${s}</option>`).join('')}</select></label>
              <label>Area evolutiva <input name="area" list="ct-aree" maxlength="80" value="${esc(r.area)}" placeholder="es. Dati e misura"></label>
              <label class="ct-largo">Testo per il riepilogo <span class="ct-nota">(vuoto = il testo originale; riformulare se chi scrive è riconoscibile)</span><textarea name="testo_curato" rows="3" maxlength="2000">${esc(r.testo_curato)}</textarea></label>
              <label class="ct-largo">Risposta di Adobe <span class="ct-nota">(verificata alla fonte prima di scriverla)</span><textarea name="risposta" rows="3" maxlength="3000">${esc(r.risposta)}</textarea></label>
            </div>
            <p class="ct-az"><button type="button" class="ct-btn" data-salva>Salva</button> <span class="ct-esito" data-esito></span></p>
          </article>`).join('');
        el.querySelectorAll<HTMLElement>('.ct-c').forEach((card) => {
          card.querySelector<HTMLButtonElement>('[data-salva]')!.onclick = async () => {
            const v = (n: string) => (card.querySelector(`[name=${n}]`) as HTMLInputElement).value.trim();
            const out = card.querySelector<HTMLElement>('[data-esito]')!;
            try {
              await rest(`contributi?id=eq.${card.dataset.id}`, { method: 'PATCH', headers: { Prefer: 'return=minimal' },
                body: JSON.stringify({ stato: v('stato'), area: v('area') || null, testo_curato: v('testo_curato') || null, risposta: v('risposta') || null }) }, session);
              out.textContent = 'Salvato.';
              testa();
            } catch (e) { out.textContent = 'Non salvato: ' + (e as Error).message; }
          };
        });
      }

      document.querySelectorAll<HTMLButtonElement>('.ct-f').forEach((b) => b.onclick = () => {
        document.querySelectorAll('.ct-f').forEach((x) => x.classList.toggle('is-on', x === b));
        filtro = b.dataset.f ?? ''; lista();
      });
      sel.onchange = () => { testa(); lista(); };
      testa(); lista();
    })();
  </script>

  <style>
    .ct-prog { display: flex; gap: 0.5rem; align-items: center; color: var(--ink-secondary); }
    .ct-prog select, .ct-campi select, .ct-campi input, .ct-campi textarea { font: inherit; color: var(--ink-primary); background: var(--bg-card); border: 1px solid var(--border); border-radius: 8px; padding: 0.5rem 0.65rem; }
    .ct-testa { display: grid; grid-template-columns: repeat(auto-fit, minmax(22rem, 1fr)); gap: 1rem; margin: 1.5rem 0; }
    .ct-card { background: var(--bg-panel); border: 1px solid var(--border); border-radius: 12px; padding: 1.1rem 1.25rem; }
    .ct-h { margin: 0 0 0.5rem; font-size: 1.05rem; }
    .ct-nota { color: var(--ink-tertiary); font-size: 0.9rem; }
    .ct-az { display: flex; gap: 0.6rem; flex-wrap: wrap; align-items: center; }
    .ct-btn { font: inherit; font-weight: 600; cursor: pointer; padding: 0.45rem 1rem; border-radius: 999px; border: 1px solid transparent; background: var(--accent-red); color: var(--bg-canvas); }
    .ct-btn--2 { background: transparent; color: var(--ink-primary); border-color: var(--border-strong); }
    .ct-tab { border-collapse: collapse; font-size: 0.9rem; }
    .ct-tab td, .ct-tab th { padding: 0.2rem 0.8rem 0.2rem 0; text-align: left; }
    .ct-filtri { display: flex; gap: 0.5rem; margin: 0 0 1rem; }
    .ct-f { font: inherit; cursor: pointer; padding: 0.35rem 0.9rem; border-radius: 999px; border: 1px solid var(--border); background: transparent; color: var(--ink-secondary); }
    .ct-f.is-on { background: var(--accent-red-soft); color: var(--accent-red); border-color: transparent; }
    .ct-lista { display: grid; gap: 1rem; }
    .ct-meta { margin: 0 0 0.5rem; font-size: 0.9rem; color: var(--ink-secondary); }
    .ct-si { color: var(--accent-green); } .ct-no { color: var(--accent-gold); }
    .ct-testo { margin: 0 0 0.9rem; padding-left: 0.9rem; border-left: 3px solid var(--border-strong); font-size: 1rem; }
    .ct-campi { display: grid; grid-template-columns: 12rem 1fr; gap: 0.75rem; }
    .ct-campi label { display: grid; gap: 0.3rem; font-size: 0.9rem; color: var(--ink-secondary); }
    .ct-largo { grid-column: 1 / -1; }
  </style>
</BaseLayout>
