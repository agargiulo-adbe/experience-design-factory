---
import BaseLayout from '../layouts/BaseLayout.astro';
import ApNavigation from '../components/ApNavigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import T from '@edf/core/blocks/i18n/T.astro';
import { href } from '@edf/core/utils/url.js';

const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;

const pageSolutions = ['design'];

const decisioni = [
  { n: '1', mark: 'ap-mark', tIt: 'Cosa misuro, e con che cosa', tEn: 'What I measure, and with what', bIt: 'Il pixel di apertura è uno strumento, non un obbligo del canale. Dodici brand del campione fanno email senza. Dove manca, i KPI si spostano su clic, conversioni ed eventi sul sito o nell\'app, che restano misurabili. Decidere prima cosa serve davvero evita di difendere un numero che, con i client di posta che precaricano le immagini, vale già poco.', bEn: 'The open pixel is a tool, not an obligation of the channel. Twelve brands in the sample do email without it. Where it is missing, KPIs move to clicks, conversions and site or app events, which stay measurable. Deciding first what you really need avoids defending a number that, with mail clients pre-loading images, is already worth little.' },
  { n: '2', mark: 'ap-mark ap-mark--ambra', tIt: 'Dove registro la scelta', tEn: 'Where I record the choice', bIt: 'Nel campione la misurazione, il consenso commerciale e l\'informativa vivono in posti diversi e cambiano in momenti diversi. Un attributo di profilo dedicato alla misurazione, distinto dal consenso marketing e con la data dell\'ultima informativa mostrata, permette di segmentare, biforcare i journey e riferire senza ricostruzioni a posteriori.', bEn: 'In the sample, measurement, marketing consent and the notice live in different places and change at different times. A profile attribute dedicated to measurement, separate from marketing consent and carrying the date of the last notice shown, lets you segment, branch journeys and report without after-the-fact reconstruction.' },
  { n: '3', mark: 'ap-mark ap-mark--corallo', tIt: 'Come lo dico', tEn: 'How I say it', bIt: 'Tredici email di aggiornamento dell\'informativa e una sola che nomina il pixel. Il messaggio di trasparenza è un invio a sé: breve, senza promozioni, con la tecnologia chiamata per nome e un link diretto alle scelte. È l\'unico pattern che il campione mostra già funzionante.', bEn: 'Thirteen notice-update emails and a single one that names the pixel. The transparency message is a send of its own: short, no promotions, the technology called by name and a direct link to the choices. It is the only pattern the sample already shows working.' },
];

const checklist = [
  { lIt: 'Flussi separati', lEn: 'Separate streams', bIt: 'Email di servizio e commerciali su configurazioni distinte, con header e tracciamento decisi per flusso. Nel campione 133 brand tracciano le conferme come le promozioni.', bEn: 'Service and marketing emails on distinct configurations, with headers and tracking decided per stream. In the sample 133 brands track confirmations like promotions.' },
  { lIt: 'Tracking come attributo', lEn: 'Tracking as an attribute', bIt: 'Il pixel acceso o spento come conseguenza di un dato del profilo, non di un template scelto a mano. Le rimozioni "a fasi" del campione nascono da flussi e piattaforme diverse, non da una scelta.', bEn: 'Pixel on or off as a consequence of a profile attribute, not of a hand-picked template. The sample\'s "phased" removals come from different streams and platforms, not from a choice.' },
  { lIt: 'Una scelta intermedia', lEn: 'A middle choice', bIt: 'Un centro preferenze che distingua "non ricevere più" da "ricevere senza misurazione". Nel mio campione nessun brand la espone ancora; per le banche il centro preferenze nelle email è a zero.', bEn: 'A preference centre that separates "stop receiving" from "receive without measurement". In my sample no brand exposes it yet; for banks the preference centre in emails sits at zero.' },
  { lIt: 'KPI oltre l\'apertura', lEn: 'KPIs beyond the open', bIt: 'Clic, conversioni, eventi di profilo. Il tasso di apertura è già distorto dai client che precaricano le immagini; costruire la reportistica sul resto rende indifferente la presenza del pixel.', bEn: 'Clicks, conversions, profile events. Open rate is already distorted by clients that pre-load images; building reporting on the rest makes the pixel\'s presence irrelevant.' },
  { lIt: 'Rileggere l\'informativa dal canale', lEn: 'Re-read the notice from the channel', bIt: 'Le informative aggiornate del campione parlano di dati in generale. Leggere la propria dal punto di vista dell\'email, riga per riga, è la verifica più economica che esista.', bEn: 'The sample\'s updated notices talk about data in general. Reading your own from the email channel\'s point of view, line by line, is the cheapest check there is.' },
];

const fontiA = [
  { tIt: 'Garante per la protezione dei dati personali', tEn: 'Italian Data Protection Authority (Garante)', dIt: 'Provvedimento del 17 aprile 2026 · Linee Guida in materia di utilizzo di tracking pixel nelle comunicazioni di posta elettronica · Registro provvedimenti n. 284 · GU Serie Generale n. 98 del 29 aprile 2026', dEn: 'Decision of 17 April 2026 · Guidelines on the use of tracking pixels in electronic mail communications · Register no. 284 · Official Journal no. 98, 29 April 2026', url: 'https://www.garanteprivacy.it/home/docweb/-/docweb-display/docweb/10241943', l: 'doc. web 10241943' },
  { tIt: 'Garante, comunicato stampa del 21 aprile 2026', tEn: 'Garante, press release of 21 April 2026', dIt: '"Tracking pixel nelle email: pubblicate le linee guida del Garante privacy"', dEn: '"Tracking pixels in email: the Garante publishes its guidelines"', url: 'https://www.garanteprivacy.it/home/docweb/-/docweb-display/docweb/10241977', l: 'doc. web 10241977' },
  { tIt: 'CNIL', tEn: 'CNIL', dIt: 'Recommandation relative aux pixels de suivi dans les courriers électroniques · 14 aprile 2026 (consultazione pubblica giugno-luglio 2025)', dEn: 'Recommandation relative aux pixels de suivi dans les courriers électroniques · 14 April 2026 (public consultation June-July 2025)', url: 'https://www.cnil.fr/fr/recommandation-pixel-suivi-courriels', l: 'cnil.fr' },
  { tIt: 'European Data Protection Board', tEn: 'European Data Protection Board', dIt: 'Guidelines 2/2023 on Technical Scope of Art. 5(3) of ePrivacy Directive · versione 2.0 adottata il 7 ottobre 2024', dEn: 'Guidelines 2/2023 on Technical Scope of Art. 5(3) of ePrivacy Directive · version 2.0 adopted 7 October 2024', url: 'https://www.edpb.europa.eu/system/files/2024-10/edpb_guidelines_202302_technical_scope_art_53_eprivacydirective_v2_en_0.pdf', l: 'edpb.europa.eu' },
];
const fontiB = [
  { tIt: 'Google · Email sender guidelines', tEn: 'Google · Email sender guidelines', dIt: 'Requisiti per chi invia oltre 5.000 messaggi al giorno, in vigore da febbraio 2024 (disiscrizione one-click, RFC 8058)', dEn: 'Requirements for senders of over 5,000 messages a day, in force since February 2024 (one-click unsubscribe, RFC 8058)', url: 'https://support.google.com/a/answer/81126', l: 'support.google.com' },
  { tIt: 'IETF · RFC 8058', tEn: 'IETF · RFC 8058', dIt: 'Signaling One-Click Functionality for List Email Headers · gennaio 2017', dEn: 'Signaling One-Click Functionality for List Email Headers · January 2017', url: 'https://www.rfc-editor.org/rfc/rfc8058', l: 'rfc-editor.org' },
  { tIt: 'Litmus · Email Client Market Share', tEn: 'Litmus · Email Client Market Share', dIt: 'Aggiornamento mensile sulla quota di aperture per client di posta; Apple Mail resta il primo client e precarica le immagini con Mail Privacy Protection dal 2021', dEn: 'Monthly update on the share of opens by mail client; Apple Mail remains the first client and pre-loads images with Mail Privacy Protection since 2021', url: 'https://www.litmus.com/email-client-market-share', l: 'litmus.com' },
];
---
<BaseLayout
  title="Cosa ne ricavo"
  description="Tre decisioni di design per chi costruisce programmi email attenti al consenso, una checklist, le fonti e un invito."
  pageSolutions={pageSolutions}
>
  <div class="fixed top-0 left-0 right-0 z-50">
    <ApNavigation currentPath={currentPath} base={base} />
  </div>

  <DeckContainer nextHref={href(base, '/')} prevHref={href(base, '/banche')}>

    <!-- ── SLIDE 0: Cover ─────────────────────────────────────────── -->
    <Slide id="slide-cover" bg="primary" align="center" data-solution="design">
      <div slot="backdrop" class="ap-bg"><div class="ap-grid"></div></div>
      <T as="p" class="slide-eyebrow text-center text-[var(--accent-primary)] mb-4 block" data-reveal it="CAPITOLO 06 · COSA NE RICAVO" en="CHAPTER 06 · WHAT I TAKE AWAY" />
      <T
        as="h2"
        class="text-[var(--ink-primary)] mb-5 font-[family-name:var(--font-display)] text-center mx-auto block"
        style="font-size: clamp(2.2rem, 4vw, 3.8rem); font-weight: 600; line-height: 1.05; letter-spacing: -0.02em; max-width: 16ch;"
        data-reveal data-reveal-delay="0.08"
        it="Tre decisioni, non una"
        en="Three decisions, not one"
      />
      <T
        as="p"
        class="text-[var(--ink-secondary)] leading-normal max-w-2xl mx-auto text-center block"
        style="font-size: clamp(1.05rem, 1.3vw, 1.3rem);"
        data-reveal data-reveal-delay="0.15"
        it="Da qui in poi non è più osservazione: è quello che ne ricavo per chi disegna un programma email. Nessun prodotto, nessuna promessa, nessuna lettura giuridica. Solo tre decisioni che nel campione quasi nessuno ha preso insieme."
        en="From here on this is no longer observation: it is what I take away for whoever designs an email programme. No product, no promise, no legal reading. Just three decisions that in the sample almost nobody took together."
      />
    </Slide>

    <!-- ── SLIDE 1: Le tre decisioni ──────────────────────────────── -->
    <Slide id="slide-decisioni" bg="primary" align="center" data-solution="design">
      <div slot="backdrop" class="ap-bg-soft"></div>
      <T as="p" class="slide-eyebrow text-center text-[var(--accent-primary)] mb-4 block" data-reveal it="LE TRE DECISIONI" en="THE THREE DECISIONS" />
      <T
        as="h2"
        class="text-[var(--ink-primary)] mb-5 font-[family-name:var(--font-display)] text-center mx-auto block"
        style="font-size: clamp(1.9rem, 3vw, 2.8rem); font-weight: 600; line-height: 1.07; letter-spacing: -0.02em; max-width: 26ch;"
        data-reveal data-reveal-delay="0.08"
        it="Misurazione, registro, messaggio"
        en="Measurement, record, message"
      />
      <div class="w-full max-w-6xl mx-auto grid md:grid-cols-3 gap-4" data-reveal data-reveal-delay="0.16">
        {decisioni.map((d) => (
          <div class="ap-card">
            <span class={d.mark} aria-hidden="true">{d.n}</span>
            <T as="p" class="ap-card-title block" it={d.tIt} en={d.tEn} />
            <T as="p" class="ap-card-body block" it={d.bIt} en={d.bEn} />
          </div>
        ))}
      </div>
    </Slide>

    <!-- ── SLIDE 2: Checklist ─────────────────────────────────────── -->
    <Slide id="slide-checklist" bg="primary" align="center" data-solution="design">
      <div slot="backdrop" class="ap-bg"></div>
      <T as="p" class="slide-eyebrow text-center text-[var(--accent-primary)] mb-4 block" data-reveal it="CINQUE COSE DA GUARDARE PRIMA DEL 29 OTTOBRE" en="FIVE THINGS TO LOOK AT BEFORE 29 OCTOBER" />
      <T
        as="h2"
        class="text-[var(--ink-primary)] mb-5 font-[family-name:var(--font-display)] text-center mx-auto block"
        style="font-size: clamp(1.9rem, 3vw, 2.8rem); font-weight: 600; line-height: 1.07; letter-spacing: -0.02em; max-width: 26ch;"
        data-reveal data-reveal-delay="0.08"
        it="Una checklist senza fornitori"
        en="A vendor-free checklist"
      />
      <div class="w-full max-w-5xl mx-auto" data-reveal data-reveal-delay="0.16">
        {checklist.map((c) => (
          <div class="ap-row">
            <div>
              <T as="p" class="ap-row-label block" it={c.lIt} en={c.lEn} />
            </div>
            <T as="p" class="ap-row-body block" it={c.bIt} en={c.bEn} />
          </div>
        ))}
      </div>
    </Slide>

    <!-- ── SLIDE 3: Fonti normative ───────────────────────────────── -->
    <Slide id="slide-fonti" bg="primary" align="center" data-solution="design">
      <div slot="backdrop" class="ap-bg-soft"></div>
      <T as="p" class="slide-eyebrow text-center text-[var(--accent-primary)] mb-4 block" data-reveal it="FONTI · 1 DI 2 · I DOCUMENTI DELLE AUTORITÀ" en="SOURCES · 1 OF 2 · THE AUTHORITIES' DOCUMENTS" />
      <T
        as="h2"
        class="text-[var(--ink-primary)] mb-4 font-[family-name:var(--font-display)] text-center mx-auto block"
        style="font-size: clamp(1.8rem, 2.8vw, 2.6rem); font-weight: 600; line-height: 1.07; letter-spacing: -0.02em; max-width: 26ch;"
        data-reveal data-reveal-delay="0.08"
        it="Citati come riferimento, non interpretati"
        en="Cited as references, not interpreted"
      />
      <div class="w-full max-w-6xl mx-auto grid md:grid-cols-2 gap-4" data-reveal data-reveal-delay="0.16">
        {fontiA.map((f) => (
          <div class="ap-panel ap-panel--segnale">
            <T as="p" class="ap-row-label block mb-1" it={f.tIt} en={f.tEn} />
            <T as="p" class="ap-panel-body block" it={f.dIt} en={f.dEn} />
            <p class="ap-src mt-2"><a href={f.url} target="_blank" rel="noopener noreferrer">{f.l}</a></p>
          </div>
        ))}
      </div>
    </Slide>

    <!-- ── SLIDE 3b: Riferimenti tecnici ──────────────────────────── -->
    <Slide id="slide-fonti-2" bg="primary" align="center" data-solution="design">
      <div slot="backdrop" class="ap-bg"></div>
      <T as="p" class="slide-eyebrow text-center text-[var(--accent-primary)] mb-4 block" data-reveal it="FONTI · 2 DI 2 · RIFERIMENTI TECNICI E DATI" en="SOURCES · 2 OF 2 · TECHNICAL REFERENCES AND DATA" />
      <T
        as="h2"
        class="text-[var(--ink-primary)] mb-4 font-[family-name:var(--font-display)] text-center mx-auto block"
        style="font-size: clamp(1.8rem, 2.8vw, 2.6rem); font-weight: 600; line-height: 1.07; letter-spacing: -0.02em; max-width: 26ch;"
        data-reveal data-reveal-delay="0.08"
        it="Gli standard e i numeri di contesto"
        en="The standards and the context numbers"
      />
      <div class="w-full max-w-6xl mx-auto grid md:grid-cols-3 gap-4" data-reveal data-reveal-delay="0.16">
        {fontiB.map((f) => (
          <div class="ap-panel ap-panel--ambra">
            <T as="p" class="ap-row-label block mb-1" it={f.tIt} en={f.tEn} />
            <T as="p" class="ap-panel-body block" it={f.dIt} en={f.dEn} />
            <p class="ap-src mt-2"><a href={f.url} target="_blank" rel="noopener noreferrer">{f.l}</a></p>
          </div>
        ))}
      </div>
      <T
        as="p"
        class="mt-5 text-center ap-src block max-w-4xl mx-auto"
        data-reveal data-reveal-delay="0.26"
        it="Dati dell'osservatorio: archivio Gmail personale letto con una pipeline Python in streaming (indice SQLite, estrazione dal corpo HTML, revisione manuale). Le citazioni dalle email sono testuali."
        en="Observatory data: personal Gmail archive read with a streaming Python pipeline (SQLite index, HTML body extraction, manual review). Quotes from emails are verbatim."
      />
    </Slide>

    <!-- ── SLIDE 4: Invito ────────────────────────────────────────── -->
    <Slide id="slide-invito" bg="primary" align="center" data-solution="design">
      <div slot="backdrop" class="ap-bg"><div class="ap-grid"></div></div>
      <T as="p" class="slide-eyebrow text-center text-[var(--accent-primary)] mb-4 block" data-reveal it="PER CONTINUARE" en="TO CONTINUE" />
      <T
        as="h2"
        class="text-[var(--ink-primary)] mb-5 font-[family-name:var(--font-display)] text-center mx-auto block"
        style="font-size: clamp(2rem, 3.4vw, 3.2rem); font-weight: 600; line-height: 1.06; letter-spacing: -0.02em; max-width: 20ch;"
        data-reveal data-reveal-delay="0.08"
        it="Aggiornerò l'osservatorio dopo il 29 ottobre"
        en="I will update the observatory after 29 October"
      />
      <T
        as="p"
        class="text-[var(--ink-secondary)] max-w-2xl mx-auto mb-6 text-center block"
        style="font-size: clamp(1rem, 1.2vw, 1.2rem);"
        data-reveal data-reveal-delay="0.14"
        it="Stessa casella, stessi criteri, un mese dopo la fine dei sei mesi. Se gestite un programma email e volete confrontare i vostri numeri con questi, o se avete un archivio da leggere con lo stesso metodo, scrivetemi. Il metodo è ripetibile e lo condivido volentieri."
        en="Same inbox, same criteria, one month after the six months end. If you run an email programme and want to compare your numbers with these, or if you have an archive to read with the same method, write to me. The method is repeatable and I am happy to share it."
      />
      <div class="ap-cobrand" data-reveal data-reveal-delay="0.22">
        <span class="ap-cobrand-a">Antonio Gargiulo</span>
        <span class="ap-cobrand-x">·</span>
        <T as="span" class="ap-cobrand-b" it="ricerca individuale · settembre 2026" en="independent research · September 2026" />
      </div>
      <T
        as="p"
        class="mt-4 text-center text-[0.78rem] tracking-widest uppercase text-[var(--color-grigio-300)] block"
        data-reveal data-reveal-delay="0.28"
        it="Lavoro in Adobe · le opinioni qui espresse sono personali"
        en="I work at Adobe · the opinions expressed here are my own"
      />
    </Slide>

  </DeckContainer>

  <style>
    .ap-cobrand { display: inline-flex; align-items: center; gap: 0.7rem; font-family: var(--font-display); font-weight: 600; font-size: clamp(1rem, 1.3vw, 1.2rem); letter-spacing: 0.02em; }
    .ap-cobrand-a { color: var(--ink-primary); }
    .ap-cobrand-x { color: var(--color-segnale); font-weight: 400; }
    .ap-cobrand :global(.ap-cobrand-b) { color: var(--color-grigio-200); font-weight: 500; }
  </style>
</BaseLayout>
