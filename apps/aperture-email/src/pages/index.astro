---
import BaseLayout from '../layouts/BaseLayout.astro';
import ApNavigation from '../components/ApNavigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import T from '@edf/core/blocks/i18n/T.astro';
import { href } from '@edf/core/utils/url.js';

const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;

const journey = [
  { num: '01', it: 'Il metodo',          en: 'The method',         subIt: 'Una casella, 27.273 messaggi, uno script',              subEn: 'One inbox, 27,273 messages, one script',                 href: '/metodo',       solution: null },
  { num: '02', it: 'I numeri',           en: 'The numbers',        subIt: 'Pixel, disiscrizione, preferenze, per paese e settore', subEn: 'Pixels, unsubscribe, preferences, by country and sector', href: '/numeri',       solution: null },
  { num: '03', it: 'I pattern',          en: 'The patterns',       subIt: 'Nove comportamenti osservati, con esempi',              subEn: 'Nine observed behaviours, with examples',                 href: '/pattern',      solution: null },
  { num: '04', it: 'Prima e dopo',       en: 'Before and after',   subIt: 'Cinque mesi dopo il 17 aprile 2026',                    subEn: 'Five months after 17 April 2026',                         href: '/prima-dopo',   solution: null },
  { num: '05', it: 'Financial services', en: 'Financial services', subIt: 'Dodici banche e assicurazioni, viste dalla casella',    subEn: 'Twelve banks and insurers, seen from the inbox',          href: '/banche',       solution: 'fsi' },
  { num: '06', it: 'Cosa ne ricavo',     en: 'What I take away',   subIt: 'Tre decisioni di design e le fonti',                    subEn: 'Three design decisions and the sources',                  href: '/implicazioni', solution: 'design' },
];

const momento = [
  { v: '14 apr 2026', lIt: 'la CNIL pubblica la sua raccomandazione sui pixel di tracciamento nelle email', lEn: 'the CNIL publishes its recommendation on tracking pixels in email', sIt: 'Recommandation relative aux pixels de suivi dans les courriers électroniques', sEn: 'Recommandation relative aux pixels de suivi dans les courriers électroniques' },
  { v: '17 apr 2026', lIt: 'il Garante adotta le Linee Guida sui tracking pixel nella posta elettronica', lEn: 'the Italian Garante adopts its Guidelines on tracking pixels in email', sIt: 'Registro provvedimenti n. 284 · GU Serie Generale n. 98 del 29 aprile 2026', sEn: 'Register of decisions no. 284 · Official Journal no. 98, 29 April 2026' },
  { v: '29 ott 2026', lIt: 'fine dei sei mesi di adeguamento indicati dalle Linee Guida', lEn: 'end of the six-month adaptation period stated in the Guidelines', sIt: 'sei mesi dalla pubblicazione in Gazzetta Ufficiale', sEn: 'six months from publication in the Official Journal' },
];
---
<BaseLayout
  title="Aperture"
  description="Osservatorio sul tracciamento nelle email dei brand: 11.339 email da 554 mittenti, lette con uno script. Ricerca individuale."
>
  <div class="fixed top-0 left-0 right-0 z-50">
    <ApNavigation currentPath={currentPath} base={base} />
  </div>

  <DeckContainer nextHref={href(base, '/metodo')} hint>

    <!-- ── SLIDE 0: Cover ─────────────────────────────────────────── -->
    <Slide id="slide-cover" bg="primary" align="center">
      <div slot="backdrop" class="ap-bg"><div class="ap-grid"></div></div>

      <div class="ap-cover" data-reveal>
        <T
          as="p"
          class="ap-cover-eyebrow"
          it="Osservatorio · ricerca individuale · settembre 2026"
          en="Observatory · independent research · September 2026"
        />

        <div class="ap-pixels" aria-hidden="true" data-reveal data-reveal-delay="0.12">
          <svg viewBox="0 0 320 96" preserveAspectRatio="xMidYMid meet" class="ap-pixels-svg">
            <g fill="rgba(243,239,230,0.14)">
              <rect x="8" y="8" width="16" height="16"/><rect x="40" y="8" width="16" height="16"/><rect x="72" y="8" width="16" height="16"/><rect x="104" y="8" width="16" height="16"/><rect x="136" y="8" width="16" height="16"/><rect x="168" y="8" width="16" height="16"/><rect x="200" y="8" width="16" height="16"/><rect x="232" y="8" width="16" height="16"/><rect x="264" y="8" width="16" height="16"/><rect x="296" y="8" width="16" height="16"/>
              <rect x="8" y="40" width="16" height="16"/><rect x="40" y="40" width="16" height="16"/><rect x="72" y="40" width="16" height="16"/><rect x="104" y="40" width="16" height="16"/><rect x="168" y="40" width="16" height="16"/><rect x="200" y="40" width="16" height="16"/><rect x="232" y="40" width="16" height="16"/><rect x="264" y="40" width="16" height="16"/><rect x="296" y="40" width="16" height="16"/>
              <rect x="8" y="72" width="16" height="16"/><rect x="40" y="72" width="16" height="16"/><rect x="72" y="72" width="16" height="16"/><rect x="104" y="72" width="16" height="16"/><rect x="136" y="72" width="16" height="16"/><rect x="168" y="72" width="16" height="16"/><rect x="200" y="72" width="16" height="16"/><rect x="232" y="72" width="16" height="16"/><rect x="264" y="72" width="16" height="16"/><rect x="296" y="72" width="16" height="16"/>
            </g>
            <rect x="136" y="40" width="16" height="16" fill="#2EE6A6"/>
            <rect x="132" y="36" width="24" height="24" fill="none" stroke="rgba(46,230,166,0.45)" stroke-width="1.2"/>
          </svg>
        </div>

        <h1 class="ap-cover-title" data-reveal data-reveal-delay="0.18">Aperture</h1>

        <T
          as="p"
          class="ap-cover-lead"
          data-reveal
          data-reveal-delay="0.24"
          it="Ho letto con uno script la mia casella di posta: 27.273 messaggi, 11.339 email di brand da 554 mittenti, dal 2013 al 7 settembre 2026. Racconto qui come i brand italiani, francesi e americani si comportano davvero su pixel di apertura, disiscrizione e consenso, nei mesi in cui le autorità europee hanno pubblicato le loro indicazioni sui pixel nelle email."
          en="I read my own inbox with a script: 27,273 messages, 11,339 brand emails from 554 senders, from 2013 to 7 September 2026. This is how Italian, French and American brands actually behave on open pixels, unsubscribe and consent, in the months when European authorities published their guidance on pixels in email."
        />

        <div class="ap-cobrand" data-reveal data-reveal-delay="0.3">
          <span class="ap-cobrand-a">Antonio Gargiulo</span>
          <span class="ap-cobrand-x">·</span>
          <T as="span" class="ap-cobrand-b" it="ricerca individuale" en="independent research" />
        </div>

        <T
          as="p"
          class="ap-cover-note"
          data-reveal
          data-reveal-delay="0.34"
          it="Lavoro in Adobe · osservazioni personali su una casella privata · dati citati alle fonti · nessuna lettura giuridica"
          en="I work at Adobe · personal observations on a private inbox · data cited to source · no legal reading"
        />
      </div>
    </Slide>

    <!-- ── SLIDE 1: Il momento ────────────────────────────────────── -->
    <Slide id="slide-momento" bg="primary" align="center">
      <div slot="backdrop" class="ap-bg-soft"></div>
      <T as="p" class="slide-eyebrow text-center text-[var(--accent-primary)] mb-4" data-reveal it="IL MOMENTO" en="THE MOMENT" />
      <T
        as="h2"
        class="text-[var(--ink-primary)] mb-4 font-[family-name:var(--font-display)] text-center mx-auto"
        style="font-size: clamp(2rem, 3.6vw, 3.4rem); font-weight: 600; line-height: 1.06; letter-spacing: -0.02em; max-width: 22ch;"
        data-reveal data-reveal-delay="0.08"
        it="Tre date, una primavera"
        en="Three dates, one spring"
      />
      <T
        as="p"
        class="text-[var(--ink-secondary)] leading-snug max-w-2xl mx-auto mb-6"
        style="font-size: clamp(1rem, 1.25vw, 1.25rem);"
        data-reveal data-reveal-delay="0.15"
        it="In tre giorni di aprile 2026 le autorità francese e italiana hanno pubblicato i loro documenti sui pixel di tracciamento nelle email. Il mio archivio copre i cinque mesi successivi. Questo osservatorio cita i documenti come riferimento e non ne propone un'interpretazione: guarda solo cosa i brand hanno fatto."
        en="Within three days of April 2026 the French and Italian authorities published their documents on tracking pixels in email. My archive covers the five months that followed. This observatory cites the documents as references and does not interpret them: it only looks at what brands did."
      />

      <div class="w-full max-w-5xl mx-auto grid grid-cols-3 gap-5" data-reveal data-reveal-delay="0.22">
        {momento.map((m) => (
          <div class="text-center p-4 bg-[var(--surface-secondary)] border border-[var(--line-subtle)] rounded-sm">
            <p class="font-[family-name:var(--font-display)] font-bold text-[var(--accent-primary)] leading-none mb-2" style="font-size: clamp(1.5rem, 2.6vw, 2.3rem);">{m.v}</p>
            <T as="p" class="text-[1rem] font-medium text-[var(--ink-primary)] mb-1" it={m.lIt} en={m.lEn} />
            <T as="p" class="text-[0.82rem] text-[var(--color-grigio-300)]" it={m.sIt} en={m.sEn} />
          </div>
        ))}
      </div>
      <p class="mt-5 text-center text-[0.75rem] tracking-widest uppercase text-[var(--color-grigio-300)]">
        <T it="Fonti:" en="Sources:" />&nbsp;
        <a href="https://www.cnil.fr/fr/recommandation-pixel-suivi-courriels" target="_blank" rel="noopener noreferrer" class="underline underline-offset-2">CNIL, 14 apr 2026</a>
        &nbsp;·&nbsp;
        <a href="https://www.garanteprivacy.it/home/docweb/-/docweb-display/docweb/10241943" target="_blank" rel="noopener noreferrer" class="underline underline-offset-2">Garante, doc. web 10241943</a>
        &nbsp;·&nbsp;
        <a href="https://www.garanteprivacy.it/home/docweb/-/docweb-display/docweb/10241977" target="_blank" rel="noopener noreferrer" class="underline underline-offset-2"><T it="Comunicato stampa, 21 apr 2026" en="Press release, 21 Apr 2026" /></a>
      </p>
    </Slide>

    <!-- ── SLIDE 2: Il percorso ───────────────────────────────────── -->
    <Slide id="slide-percorso" bg="primary" align="center">
      <div slot="backdrop" class="ap-bg"></div>
      <T as="p" class="slide-eyebrow text-center text-[var(--accent-primary)] mb-4" data-reveal it="IL PERCORSO" en="THE JOURNEY" />
      <T
        as="h2"
        class="font-[family-name:var(--font-display)] text-[var(--ink-primary)] mb-4 max-w-3xl mx-auto text-center block"
        style="font-size: clamp(1.9rem, 3vw, 2.6rem); font-weight: 600; line-height: 1.08; letter-spacing: -0.02em;"
        data-reveal data-reveal-delay="0.08"
        it="Sei capitoli, dal metodo alle decisioni"
        en="Six chapters, from method to decisions"
      />
      <T
        as="p"
        class="text-[clamp(0.9rem,1.05vw,1.05rem)] text-[var(--ink-secondary)] max-w-2xl mx-auto mb-4 text-center"
        data-reveal data-reveal-delay="0.15"
        it="Ogni capitolo regge da solo. I primi quattro sono pura osservazione; gli ultimi due sono la mia lettura e si possono spegnere dalla console."
        en="Each chapter stands on its own. The first four are pure observation; the last two are my reading and can be switched off from the console."
      />

      <div class="w-full max-w-5xl mx-auto grid grid-cols-2 md:grid-cols-3 auto-rows-fr gap-2 mb-3" data-reveal data-reveal-delay="0.22">
        {journey.map((step) => (
          <a
            href={href(base, step.href)}
            data-nav-solution={step.solution ?? undefined}
            data-edf-journey-card
            class="journey-card h-full px-4 py-2 border border-[var(--line-subtle)] rounded-sm text-left transition-colors no-underline group"
          >
            <p class="text-xs font-semibold text-[var(--color-grigio-400)] mb-0.5 font-[family-name:var(--font-display)] tabular-nums" data-edf-cardnum>{step.num}</p>
            <T as="p" class="text-[1.02rem] font-semibold text-[var(--ink-primary)] mb-0.5 font-[family-name:var(--font-display)] block" it={step.it} en={step.en} />
            <T as="p" class="text-[0.84rem] text-[var(--color-grigio-300)] block" it={step.subIt} en={step.subEn} />
          </a>
        ))}
      </div>

      <div data-reveal data-reveal-delay="0.35" class="text-center">
        <a
          href={href(base, '/metodo')}
          class="inline-flex items-center gap-3 px-9 py-2 text-[clamp(1rem,1.2vw,1.15rem)] font-semibold tracking-wide bg-[var(--accent-primary)] text-[var(--color-notte)] hover:bg-[var(--color-segnale-scuro)] transition-colors duration-300 focus-visible:outline-2 focus-visible:outline-[var(--accent-primary)] focus-visible:outline-offset-4 font-[family-name:var(--font-display)] no-underline"
        >
          <T it="Inizia dal metodo" en="Start with the method" />
          <svg width="20" height="20" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>
    </Slide>

  </DeckContainer>

  <style>
    .ap-cover { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 1.1rem; width: 100%; max-width: 60rem; margin-inline: auto; }
    .ap-cover :global(.ap-cover-eyebrow) { font-family: var(--font-body); font-weight: 600; font-size: clamp(0.75rem, 0.9vw, 0.9rem); letter-spacing: 0.16em; text-transform: uppercase; color: var(--color-segnale); margin: 0; }
    .ap-pixels { width: min(20rem, 56vw); }
    .ap-pixels-svg { width: 100%; height: auto; display: block; }
    .ap-cover-title { font-family: var(--font-display); font-weight: 700; font-size: clamp(3rem, 7vw, 6rem); line-height: 1; letter-spacing: -0.03em; color: var(--ink-primary); margin: 0.1rem 0 0; }
    .ap-cover :global(.ap-cover-lead) { font-size: clamp(1rem, 1.2vw, 1.15rem); line-height: 1.55; color: var(--color-grigio-200); max-width: 48rem; margin: 0 auto; display: block; }
    .ap-cobrand { display: inline-flex; align-items: center; gap: 0.7rem; font-family: var(--font-display); font-weight: 600; font-size: clamp(1rem, 1.3vw, 1.2rem); letter-spacing: 0.02em; margin-top: 0.1rem; }
    .ap-cobrand-a { color: var(--ink-primary); }
    .ap-cobrand-x { color: var(--color-segnale); font-weight: 400; }
    .ap-cobrand :global(.ap-cobrand-b) { color: var(--color-grigio-200); font-weight: 500; }
    .ap-cover :global(.ap-cover-note) { font-size: 0.75rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-grigio-300); max-width: 46rem; margin: 0 auto; display: block; }
  </style>
</BaseLayout>
