---
import { href } from '@edf/core/utils/url.js';
import T from '@edf/core/blocks/i18n/T.astro';
import LangToggle from '@edf/core/blocks/i18n/LangToggle.astro';

interface Props {
  currentPath: string;
  base: string;
}

const { currentPath, base } = Astro.props;

const sections = [
  { slug: 'metodo',       it: 'Il metodo',           en: 'The method',        solution: null },
  { slug: 'numeri',       it: 'I numeri',            en: 'The numbers',       solution: null },
  { slug: 'pattern',      it: 'I pattern',           en: 'The patterns',      solution: null },
  { slug: 'prima-dopo',   it: 'Prima e dopo',        en: 'Before and after',  solution: null },
  { slug: 'banche',       it: 'Financial services',  en: 'Financial services', solution: 'fsi' },
  { slug: 'implicazioni', it: 'Cosa ne ricavo',      en: 'What I take away',  solution: 'design' },
];

function isActive(slug: string) {
  const norm = currentPath.replace(/\/+$/, '');
  if (slug === '') return norm.endsWith('/aperture-email') || norm.endsWith('/index');
  return norm.endsWith('/' + slug);
}
---
<nav
  class="flex items-center justify-between px-6 py-3 bg-[var(--color-notte)]/95 backdrop-blur-sm border-b border-[var(--color-fumo)]"
  aria-label="Navigazione osservatorio"
>
  <a
    href={href(base, '/')}
    class="flex items-center gap-2.5 no-underline group flex-shrink-0"
    aria-label="Home — Aperture"
  >
    <span class="inline-flex items-center justify-center w-7 h-7 rounded bg-[var(--color-ardesia)] flex-shrink-0" aria-hidden="true">
      <svg width="18" height="18" viewBox="0 0 32 32" fill="none">
        <g fill="#4F5563"><rect x="6" y="6" width="4" height="4"/><rect x="14" y="6" width="4" height="4"/><rect x="22" y="6" width="4" height="4"/><rect x="6" y="14" width="4" height="4"/><rect x="22" y="14" width="4" height="4"/><rect x="6" y="22" width="4" height="4"/><rect x="14" y="22" width="4" height="4"/><rect x="22" y="22" width="4" height="4"/></g>
        <rect x="14" y="14" width="4" height="4" fill="#2EE6A6"/>
      </svg>
    </span>
    <span class="text-sm font-semibold text-[var(--color-avorio)] group-hover:text-white transition-colors font-[family-name:var(--font-display)] whitespace-nowrap">
      Aperture
    </span>
    <span class="hidden 2xl:inline text-[0.6rem] font-bold tracking-widest uppercase text-[var(--color-grigio-400)] ml-1 whitespace-nowrap">
      <T it="Osservatorio email" en="Email observatory" />
    </span>
  </a>

  <ol class="hidden md:flex flex-nowrap items-center gap-0.5 min-w-0 overflow-x-auto [scrollbar-width:none] [-ms-overflow-style:none] [&::-webkit-scrollbar]:hidden" role="list">
    {sections.map((s, i) => (
      <li data-nav-solution={s.solution ?? undefined} role="listitem" class="flex-shrink-0">
        <a
          href={href(base, '/' + s.slug)}
          class={[
            'block whitespace-nowrap px-2.5 py-1.5 text-xs font-medium rounded-sm transition-colors no-underline',
            isActive(s.slug)
              ? 'bg-[var(--accent-primary)]/15 text-[var(--accent-primary)] border border-[var(--accent-primary)]/30'
              : 'text-[var(--color-grigio-300)] hover:text-[var(--color-avorio)] hover:bg-[var(--color-fumo)]',
          ].join(' ')}
          aria-current={isActive(s.slug) ? 'page' : undefined}
        >
          <span class="text-[var(--color-grigio-500)] mr-1 tabular-nums">{String(i + 1).padStart(2, '0')}</span>
          <T it={s.it} en={s.en} />
        </a>
      </li>
    ))}
  </ol>

  <div class="flex items-center gap-3 flex-shrink-0">
    <LangToggle langs={['en', 'it']} />
    <span class="hidden 2xl:inline text-[0.65rem] tracking-widest uppercase text-[var(--color-grigio-500)] whitespace-nowrap">
      <T it="Ricerca individuale" en="Independent research" />
    </span>
    <a
      href={href(base, '/admin')}
      class="text-[0.7rem] font-semibold tracking-wider uppercase px-3 py-1.5 border border-[var(--color-fumo)] text-[var(--color-grigio-400)] hover:text-[var(--color-avorio)] hover:border-[var(--color-grigio-500)] rounded-sm transition-colors no-underline"
      data-admin-only
    >
      Admin
    </a>
  </div>
</nav>
