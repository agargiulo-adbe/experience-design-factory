---
import BaseLayout from '../layouts/BaseLayout.astro';
import AdminConsole from '@edf/core/blocks/admin/AdminConsole.astro';
import { href } from '@edf/core/utils/url.js';
import { SITE } from '../data/site';

const base = import.meta.env.BASE_URL;
const SUPABASE_URL = import.meta.env.PUBLIC_SUPABASE_URL ?? '';
const SUPABASE_ANON_KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY ?? '';

interface SlideEntry { id: string; label: string; }
interface PageEntry { slug: string; label: string; slides: SlideEntry[]; }

// Ogni slide del deck, pagina per pagina: è ciò che il tab «Capitoli e slide»
// accende e spegne. Ogni <Slide id> nuova va registrata qui.
const PAGE_REGISTRY: PageEntry[] = [
  { slug: 'index', label: 'Una campagna, molti formati (00)', slides: [
    { id: 'slide-cover',    label: 'Cover — Una campagna, molti formati' },
    { id: 'slide-percorso', label: 'Il percorso — 4 capitoli' },
  ]},
  { slug: 'apertura', label: 'Il vostro anno, visto da fuori (01)', slides: [
    { id: 'slide-cover',     label: 'Cover — Il vostro anno, visto da fuori' },
    { id: 'slide-contenuto', label: 'Il vostro anno, visto da fuori — contenuto' },
  ]},
  { slug: 'domanda', label: 'La domanda (02)', slides: [
    { id: 'slide-cover',     label: 'Cover — La domanda' },
    { id: 'slide-contenuto', label: 'La domanda — contenuto' },
  ]},
  { slug: 'idee', label: 'Le idee (03)', slides: [
    { id: 'slide-cover',     label: 'Cover — Le idee' },
    { id: 'slide-contenuto', label: 'Le idee — contenuto' },
  ]},
  { slug: 'rotta', label: 'La rotta (04)', slides: [
    { id: 'slide-cover',     label: 'Cover — La rotta' },
    { id: 'slide-contenuto', label: 'La rotta — contenuto' },
    { id: 'slide-signature', label: 'La firma — Adobe × TIM' },
  ]},
];

interface SolutionEntry {
  id: string; name: string; shortName: string;
  pillar: string; description: string; appearsIn: string[];
}

// Segnaposto: il deck generato non ha slide gated. Sostituire con le soluzioni
// Adobe che l'experience propone davvero (nomi verificati, vedi memoria
// adobe-product-naming-2026) e marcare le slide con `data-solution="<id>"`.
const SOLUTIONS: SolutionEntry[] = [
  { id: 'piattaforma', name: 'Adobe Experience Cloud — segnaposto', shortName: 'Adobe', pillar: 'piattaforma',
    description: 'Sostituire con i prodotti Adobe che il deck propone, uno per voce, con il nome per esteso.', appearsIn: ['Il vostro anno, visto da fuori', 'La domanda', 'Le idee', 'La rotta'] },
];

const PILLAR_LABELS: Record<string, string> = { piattaforma: 'Piattaforma' };
const PILLAR_ORDER = ['piattaforma'];
const PILLAR_COLORS: Record<string, string> = { piattaforma: '#004691' };

const solutionGroups = PILLAR_ORDER
  .map((pillar) => ({ pillar, label: PILLAR_LABELS[pillar], color: PILLAR_COLORS[pillar], solutions: SOLUTIONS.filter((s) => s.pillar === pillar) }))
  .filter((g) => g.solutions.length > 0);

const allSolutionIds = SOLUTIONS.map((s) => s.id);
const deckHref = href(base, '/');
---
<BaseLayout title={`Console — ${SITE.name} · ${SITE.client}`}>
  <AdminConsole
    projectSlug={SITE.slug}
    projectName={SITE.name}
    clientLabel={`Adobe × ${SITE.client}`}
    deckHref={deckHref}
    pages={PAGE_REGISTRY}
    solutionGroups={solutionGroups}
    allSolutionIds={allSolutionIds}
    supabaseUrl={SUPABASE_URL}
    supabaseAnonKey={SUPABASE_ANON_KEY}
  />
</BaseLayout>
