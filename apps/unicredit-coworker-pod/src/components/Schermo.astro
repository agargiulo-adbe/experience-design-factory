---
/**
 * UNA SCHERMATA VERA DI COWORKER, in una cornice di browser (19 nov 2026).
 *
 * L'owner: «il design system mi sembra scarno». Il deck parlava per 24 slide
 * di un assistente in chat senza mai mostrarne l'interfaccia fuori dai video.
 * Qui c'è un fotogramma delle registrazioni del 17-18 nov 2026 (ambiente
 * dimostrativo Adobe, sandbox di una banca fittizia), ritagliato sopra la
 * casella del prompt: niente avatar, niente dati di persone.
 *
 * ⚠️ Solo fotogrammi che non mostrano la sigla CJA (il nome della report suite
 * di prova): il deck parla di funzioni di Analytics (owner, 19 nov 2026).
 */
interface Props {
  src: { src: string; width: number; height: number };
  alt: string;
  didascalia: string;
}
const { src, alt, didascalia } = Astro.props;
---
<figure class="uc-schermo">
  <div class="uc-schermo-win">
    <div class="uc-schermo-bar" aria-hidden="true">
      <span class="uc-schermo-dot"></span><span class="uc-schermo-dot"></span><span class="uc-schermo-dot"></span>
      <span class="uc-schermo-url">experience.adobe.com · Coworker</span>
    </div>
    <img src={src.src} width={src.width} height={src.height} alt={alt} loading="lazy" decoding="async" />
  </div>
  <figcaption class="uc-schermo-cap">{didascalia.split(/(?<=\.) /).map((f, i) => <>{i > 0 && " "}<span class="ex-frase">{f}</span></>)}</figcaption>
</figure>
