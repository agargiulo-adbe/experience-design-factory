---
/**
 * Figura — i micro-diagrammi che stanno dentro un «Scopri come».
 *
 * Questo file è il VOCABOLARIO di questa experience: solo geometria. Lo
 * spessore del tratto, la regola dell'accento e la curva dell'animazione
 * arrivano dal motore (`@edf/core/blocks/Dettaglio.astro`), così due deck non
 * disegnano con due mani diverse.
 *
 * Come si aggiunge un disegno:
 *  1. un nome nel tipo `k` che dica il MECCANISMO, non la forma — `tetto`,
 *     non `linea-con-barre`: il nome va letto fra sei mesi;
 *  2. un ramo qui sotto, nello stesso viewBox 120 × 72;
 *  3. niente parole dentro l'SVG. L'ancora sotto la figura la nomina, e un
 *     testo dentro un disegno non cresce con la radice: sulla parete
 *     diventa illeggibile (famiglia `S` di `audit:ritmo`).
 *
 * Le classi del motore, in breve:
 *   `fg-s` tratto neutro (eredita `currentColor`, si ribalta col fondo)
 *   `fg-f` / `fg-f-soft` pieno neutro · `fg-d` / `fg-d-fine` tratteggio
 *   `fg-a` / `fg-a-f` / `fg-a-f-soft` l'ACCENTO — solo sull'elemento che
 *       porta il significato, mai su tutto il disegno
 *   movimento: `fg-draw` (si disegna) · `fg-in` (entra) · `fg-rise` (cresce
 *       dal basso) · `fg-grow` (cresce da sinistra) · `fg-drop` (cade
 *       dall'alto) · `fg-slide` (scorre) · `style="--i:N"` per lo sfasamento
 *
 * Il vocabolario di QUESTO deck: Coworker su Analytics e su Target.
 */
interface Props {
  k:
    | 'chiedi' | 'causa' | 'riapri' | 'permessi' | 'previsione'
    | 'inventario' | 'calcolo' | 'costruire' | 'collisione' | 'sintesi';
}
const { k } = Astro.props;
---
{/* aria-hidden: l'ancora e la riga sotto dicono la stessa cosa a parole. */}
<svg class="fg dett-fig" viewBox="0 0 120 72" aria-hidden="true">
  {k === 'chiedi' && (
    <g>
      {/* Una domanda in chat diventa un grafico: la risposta al volo. */}
      <path class="fg-s" d="M8 12 H50 a4 4 0 0 1 4 4 V30 a4 4 0 0 1 -4 4 H22 L14 41 V34 H8 a4 4 0 0 1 -4 -4 V16 a4 4 0 0 1 4 -4 Z" />
      <path class="fg-s fg-d" d="M58 24 H70" />
      {[[76, 22], [90, 34], [104, 14]].map(([x, h], i) => (
        <rect class="fg-a-f fg-rise" style={`--i:${i + 1}`} x={x} y={60 - h} width="10" height={h} rx="2" />
      ))}
      <path class="fg-s" d="M72 60 H116" />
    </g>
  )}
  {k === 'causa' && (
    <g>
      {/* Un numero che cala, e le dimensioni che lo spiegano: una pesa di più. */}
      <path class="fg-s fg-draw" d="M6 20 L22 18 L34 22 L44 44 L54 42" />
      <circle class="fg-a-f" cx="44" cy="44" r="3.4" />
      <path class="fg-s fg-d" d="M60 36 H70" />
      <rect class="fg-a-f fg-grow" style="--i:1" x="74" y="14" width="40" height="9" rx="2" />
      <rect class="fg-f-soft fg-grow" style="--i:2" x="74" y="31" width="22" height="9" rx="2" />
      <rect class="fg-f-soft fg-grow" style="--i:3" x="74" y="48" width="12" height="9" rx="2" />
    </g>
  )}
  {k === 'riapri' && (
    <g>
      {/* La risposta della chat si riapre in Workspace, dove si lavora a mano. */}
      <rect class="fg-s" x="6" y="18" width="40" height="34" rx="4" />
      {[26, 34, 42].map((y, i) => (<path class="fg-s fg-in" style={`--i:${i}`} d={`M12 ${y} H${40 - i * 8}`} />))}
      <path class="fg-s fg-a fg-draw" style="--i:3" d="M50 35 H70 M64 29 L70 35 L64 41" />
      <rect class="fg-s fg-a" x="74" y="8" width="42" height="56" rx="4" />
      <path class="fg-s" d="M74 18 H116" />
      <rect class="fg-a-f-soft fg-rise" style="--i:4" x="80" y="26" width="30" height="30" rx="2" />
    </g>
  )}
  {k === 'permessi' && (
    <g>
      {/* Gli stessi permessi di Workspace: si vede quello che si vedeva già. */}
      {[10, 30, 50].map((y, i) => (<rect class="fg-f-soft fg-in" style={`--i:${i}`} x="8" y={y} width="30" height="12" rx="2" />))}
      <rect class="fg-a-f" x="8" y="30" width="30" height="12" rx="2" />
      <path class="fg-s fg-d" d="M44 36 H64" />
      <rect class="fg-s fg-a" x="70" y="30" width="34" height="28" rx="4" />
      <path class="fg-s fg-a" d="M78 30 V22 a9 9 0 0 1 18 0 V30" />
      <circle class="fg-a-f" cx="87" cy="44" r="3" />
    </g>
  )}
  {k === 'previsione' && (
    <g>
      {/* Dove si arriva: la serie vera, la proiezione, la linea dell'obiettivo. */}
      <path class="fg-s" d="M6 58 L22 50 L36 52 L52 40 L64 38" />
      <path class="fg-s fg-a fg-d fg-draw" style="--i:1" d="M64 38 L84 30 L104 24" />
      <path class="fg-s fg-d" d="M6 18 H114" />
      <circle class="fg-a-f" cx="104" cy="24" r="3.4" />
    </g>
  )}
  {k === 'inventario' && (
    <g>
      {/* Che cosa è attivo, e se un test si può chiudere. */}
      {[10, 26, 42, 58].map((y, i) => (<rect class="fg-f-soft fg-in" style={`--i:${i}`} x="8" y={y - 4} width="70" height="10" rx="2" />))}
      <circle class="fg-s fg-a" cx="98" cy="37" r="14" />
      <path class="fg-s fg-a fg-draw" style="--i:4" d="M91 37 L96 42 L106 31" />
    </g>
  )}
  {k === 'calcolo' && (
    <g>
      {/* Quanto traffico e quanti giorni servono per vedere una differenza. */}
      <path class="fg-s" d="M8 60 H112" />
      {[0, 1, 2, 3, 4, 5].map((i) => (<rect class="fg-f-soft fg-rise" style={`--i:${i}`} x={12 + i * 16} y={60 - (10 + i * 7)} width="10" height={10 + i * 7} rx="2" />))}
      <path class="fg-s fg-a" d="M8 26 H112" />
      <rect class="fg-a-f" x="76" y={60 - 38} width="10" height="38" rx="2" />
    </g>
  )}
  {k === 'costruire' && (
    <g>
      {/* L'attività si compone: esperienza, pubblico, link di prova. */}
      <rect class="fg-f-soft fg-drop" style="--i:0" x="10" y="44" width="44" height="16" rx="3" />
      <rect class="fg-f-soft fg-drop" style="--i:1" x="10" y="26" width="44" height="16" rx="3" />
      <rect class="fg-a-f fg-drop" style="--i:2" x="10" y="8" width="44" height="16" rx="3" />
      <path class="fg-s fg-d" d="M60 34 H74" />
      <rect class="fg-s fg-a" x="78" y="14" width="34" height="40" rx="4" />
      <path class="fg-s fg-a fg-draw" style="--i:3" d="M87 34 L93 40 L104 28" />
    </g>
  )}
  {k === 'collisione' && (
    <g>
      {/* Due attività sulla stessa pagina e sullo stesso pubblico si pestano. */}
      <rect class="fg-s fg-in" x="14" y="14" width="50" height="40" rx="4" />
      <rect class="fg-s fg-in" style="--i:1" x="46" y="22" width="50" height="40" rx="4" />
      <rect class="fg-a-f-soft" x="46" y="22" width="18" height="32" />
      <path class="fg-s fg-a" d="M46 22 H64 V54 H46 Z" />
      <path class="fg-s fg-a fg-draw" style="--i:2" d="M104 18 L112 26 M112 18 L104 26" />
    </g>
  )}
  {k === 'sintesi' && (
    <g>
      {/* Il mese in una pagina: tanti numeri, una sintesi da portare in riunione. */}
      {[8, 20, 32, 44, 56].map((y, i) => (<path class="fg-s fg-in" style={`--i:${i}`} d={`M8 ${y} H${30 + (i % 2) * 10}`} />))}
      <path class="fg-s fg-d" d="M50 32 H64" />
      <rect class="fg-s fg-a" x="70" y="6" width="42" height="58" rx="4" />
      <path class="fg-s fg-a" d="M78 18 H104" />
      <path class="fg-s" d="M78 30 H104 M78 40 H98 M78 50 H102" />
    </g>
  )}
</svg>
