---
/**
 * LA LINEA DEL TEMPO del programma — cinque tappe, disegnate.
 *
 * Una sola fonte per le due slide che la mostrano (capitolo 01, «Come ci
 * arriviamo», e capitolo 04, «I prossimi passi»): se le tappe vivessero in due
 * pagine, divergerebbero alla prima correzione.
 *
 * `fatte` = quante tappe sono già passate. Nel capitolo 01 è 0 (la prima è
 * «oggi» e si accende), nel 05 è 1: la prima porta la spunta, e si accende la
 * seconda. Le tappe entrano una alla volta sotto le frecce del deck
 * (`data-substep`): chi presenta si ferma su quella di cui sta parlando.
 *
 * Date: nessun giorno. La quarta tappa è «circa tre settimane dopo» il kickoff
 * (accordo interno Adobe, 17 nov 2026), la quinta è «fine gennaio, inizio
 * febbraio» (mail dell'AE del 6 nov 2026). Sulle altre una data sarebbe nostra.
 * ⚠️ Il nome del referente non sta in slide: il deck parla all'organizzazione,
 * e il repo è pubblico. Chi partecipa al punto della situazione lo dice chi presenta.
 */
import { TAPPE } from '../data/contenuti';
interface Props { fatte?: number; figura?: boolean }
/* `figura={false}` rende un <div>: solo per il ritmo del capitolo 04, dove
   la slide prima è già una figura (audit:ritmo legge `figure svg`). */
const { fatte = 0, figura = true } = Astro.props;
const Tag = figura ? 'figure' : 'div';
const N = TAPPE.length;
const c = (i: number) => ((i + 0.5) / N) * 1000;
---
{/* Le tappe stanno in colonne uguali: il centro della colonna i è a
    (i + 0,5) / N della larghezza, e la linea va dal primo all'ultimo centro. */}
<Tag class="uc-tempo" data-fatte={fatte} style={`--n:${N}`}>
  <svg class="uc-tempo-linea" viewBox="0 0 1000 40" preserveAspectRatio="none" aria-hidden="true">
    <line class="uc-tempo-tr" x1={c(0)} y1="20" x2={c(N - 1)} y2="20" />
    {fatte > 0 && <line class="uc-tempo-tr-fatto" x1={c(0)} y1="20" x2={c(fatte)} y2="20" />}
  </svg>
  <ol class="uc-tempo-g" role="list">
  {TAPPE.map((x, i) => (
    <li class="uc-tempo-i"
        data-stato={i < fatte ? 'fatta' : i === fatte ? 'ora' : 'poi'}
        data-substep={i === 0 ? null : ''}>
      <span class="uc-tempo-nodo" aria-hidden="true">
        {i < fatte
          ? <svg viewBox="0 0 24 24"><path d="M6 12.5l4 4 8-9" /></svg>
          : <span>{i + 1}</span>}
      </span>
      <p class="uc-tempo-k">{x.k}</p>
      <p class="uc-tempo-t">{x.t}</p>
    </li>
  ))}
  </ol>
</Tag>
