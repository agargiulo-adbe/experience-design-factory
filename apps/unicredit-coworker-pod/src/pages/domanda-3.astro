---
/**
 * 03 · ANALYTICS E TARGET — il secondo approfondimento.
 *
 * Giro del 17 nov 2026: il capitolo su Target da solo (`domanda-2`) è
 * confluito qui, perché il POD parte su Analytics e Target si aggancia circa
 * tre settimane dopo. Prima i quattro momenti di un test con Coworker su
 * Target (le skill dietro «Scopri come»), poi il giro dal numero al test, poi
 * due casi dal campo, poi la domanda alla sala.
 *
 * Fonti Target: Experience League, «Coworker skills for Adobe Target»
 * (aggiornata al 27 ott 2026): le skill, gli esempi di prompt, e la tabella
 * dove Coworker NON crea attività di Automated Personalization.
 *
 * Il giro si costruisce sotto le frecce: prima Analytics, che il team conosce,
 * poi un passo alla volta fino al risultato che torna nella stessa
 * conversazione. Sotto il disegno, la marcatura onesta: ogni passo esiste, il
 * passaggio fra un passo e l'altro è quello che il programma serve a provare.
 * ⚠️ Non si scrive che il giro è documentato: non lo è, come giro.
 *
 * I due casi sono «dal campo», da fonti interne Adobe, anonimizzati: niente
 * nomi, niente numeri, niente link.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import HowItWorks from '@edf/core/blocks/HowItWorks.astro';
import Dettaglio from '@edf/core/blocks/Dettaglio.astro';
import DettaglioVoce from '@edf/core/blocks/DettaglioVoce.astro';
import Figura from '../components/Figura.astro';
import Divisore from '../components/Divisore.astro';
import fotoDiv from '../assets/generated/bg/div-target.webp';
import Giro from '../components/Giro.astro';
import VideoDemo from '../components/VideoDemo.astro';
import Schermo from '../components/Schermo.astro';
import schermoAT from '../assets/schermi/at-test.webp';
import { href } from '@edf/core/utils/url.js';
import { CHAPTERS, prevSlug, nextSlug } from '../data/chapters';
import { MOMENTI } from '../data/contenuti';

const SLUG = 'domanda-3';
const ch = CHAPTERS.find((c) => c.slug === SLUG)!;
const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;

const EL_AA = 'https://experienceleague.adobe.com/en/docs/coworker/content/chat/use-cases/data-insights/analytics-overview';
const EL_TGT = 'https://experienceleague.adobe.com/en/docs/target/using/introduction/coworker-skills';

/* La demo su Dynamic Media; vuota, il `.mp4` locale git-ignorato in `public/media/`. */
const VIDEO_AT = '';

/* I prompt dei momenti sono quelli d'esempio della pagina di Experience League,
   resi in italiano («+5%» è l'esempio della skill Test Calculator). */
const chev = (i: number) => i === 0
  ? 'M0 0 H176 L200 30 L176 60 H0 Z'
  : 'M0 0 H176 L200 30 L176 60 H0 L24 30 Z';
---
<BaseLayout title={ch.title}>
  <div class="fixed top-0 left-0 right-0 z-50">
    <Navigation currentPath={currentPath} base={base} />
  </div>

  <DeckContainer nextHref={href(base, nextSlug(SLUG))} prevHref={href(base, prevSlug(SLUG))}>

    <Slide id="slide-cover" bg="secondary" align="left" data-made-with="Adobe Stock" data-made-with-for="fotografia">
      <div slot="backdrop" class="xd-div-bg" style={`--foto: url('${fotoDiv.src}')`}></div>
      <Divisore num={ch.num} conFoto titolo={ch.title} punto={ch.punto} occhiello="Analytics e Target" />
    </Slide>

    {/* ── I quattro momenti di un test, con Coworker su Target ────────────── */}
    <Slide id="slide-momenti" bg="primary" align="left">
      <div slot="backdrop" class="ex-bg-paper"></div>
      <div class="xd-sl uc-sl-largo" data-reveal>
        <div class="xd-sl-head">
          <p class="xd-n">Adobe Target</p>
          <h2 class="xd-h2">In Target, Coworker c’è in ogni momento di un test</h2>
        </div>
        <figure class="uc-momenti-fig">
          <ol class="uc-momenti" role="list">
            {MOMENTI.map((m, i) => (
              <li class="uc-mom" data-substep={i === 0 ? null : ''}>
                <div class="uc-mom-box">
                  <svg class="uc-mom-chev" viewBox="0 0 200 60" preserveAspectRatio="none" aria-hidden="true"><path d={chev(i)} /></svg>
                  <p class="uc-mom-a">{m.a}</p>
                </div>
                <p class="uc-mom-r">{m.r}</p>
                <p class="uc-prompt">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h16v10H9l-5 4z" /></svg>
                  «{m.p}»
                </p>
              </li>
            ))}
          </ol>
        </figure>
        <p class="uc-nota">Le attività di Automated Personalization si creano ancora in Target.</p>
        <p class="xd-chiusa uc-chiusa-dom">Oggi, in un test, il tempo va più a decidere che cosa provare o a costruirlo?</p>
        <HowItWorks title="Le skill, momento per momento" tone="onLight" class="ex-dett">
          <Dettaglio>
            <DettaglioVoce>
              <Figura k="inventario" />
              <p slot="ancora">Capire</p>
              <p slot="riga">Target Browse, Target Activity Verdict, Target Portfolio Report.</p>
            </DettaglioVoce>
            <DettaglioVoce>
              <Figura k="calcolo" />
              <p slot="ancora">Decidere</p>
              <p slot="riga">Target Strategist, Target Test Calculator.</p>
            </DettaglioVoce>
            <DettaglioVoce>
              <Figura k="costruire" />
              <p slot="ancora">Costruire</p>
              <p slot="riga">Target Design, Target VEC, Target Setup, Target Audience Composer.</p>
            </DettaglioVoce>
            <DettaglioVoce>
              <Figura k="collisione" />
              <p slot="ancora">Tenere in ordine</p>
              <p slot="riga">Target Intelligence, Target Recommendations, Target Recommendations Diagnose.</p>
            </DettaglioVoce>
          </Dettaglio>
        </HowItWorks>
        <p class="xd-fonte">Fonte: <a href={EL_TGT} target="_blank" rel="noopener">Experience League, le skill di Coworker per Adobe Target</a></p>
      </div>
    </Slide>

    {/* ── La proposta di test, com'è sullo schermo (19 nov 2026) ─────────
        Fotogramma vero della registrazione da Analytics a Target: Coworker
        propone il test partendo dal calo, e dice da sé che è un'ipotesi da
        verificare. */}
    <Slide id="slide-schermo" bg="primary" align="left">
      <div slot="backdrop" class="ex-bg-paper"></div>
      <div class="uc-prova" data-reveal>
        <Schermo src={schermoAT} alt="Coworker propone un test A/B sullo Step 1 del modulo di richiesta, con i numeri del calo trovato in Analytics, l'ipotesi e la variante da provare"
                 didascalia="Schermata reale di Coworker, novembre 2026. Ambiente dimostrativo Adobe, dati di una banca fittizia." />
        <div class="uc-prova-dx">
          <p class="xd-n">«Che test proporresti?»</p>
          <h2 class="xd-h2">Coworker parte dal calo trovato in Analytics</h2>
          <ul class="uc-ancore-v uc-ancore-v--chiaro" data-stagger>
            <li>Ipotesi, variante e metrica</li>
            <li>I numeri del calo, citati</li>
            <li>Dice che cosa va verificato</li>
          </ul>
        </div>
      </div>
    </Slide>

    {/* ── Il giro, a fasi ──────────────────────────────────────────────── */}
    <Slide id="slide-giro" bg="inverse" align="left">
      <div slot="backdrop" class="xd-bg-piano"></div>
      <div class="uc-giro-sl" data-reveal>
        <div class="uc-giro-sx">
          <p class="uc-dom-k">Analytics e Target</p>
          <h2 class="xd-h2 uc-firma-t">Da un calo in Analytics a un test in Target, e ritorno</h2>
          <p class="xd-chiusa uc-giro-marca">Ogni step esiste già, da solo. Il tratteggio indica che cosa si prova nel programma: farli lavorare in fila, nella stessa chat.</p>
          <p class="uc-giro-appr-r"><svg viewBox="-20 -20 40 40" aria-hidden="true"><rect x="-17" y="-17" width="34" height="34" rx="8" /><path d="M-8 0 l5 5 10 -11" /></svg><span>Contenuti, compliance e brand li approva il vostro team, prima che un test parta.</span></p>
          <HowItWorks title="Quale skill c’è dietro ogni step" tone="onDark" class="ex-dett ex-dett--scuro">
            <Dettaglio>
              <DettaglioVoce>
                <Figura k="causa" />
                <p slot="ancora">1 · Dove si perde</p>
                <p slot="riga">aa, per funnel e fallout, e aa-root-cause-analysis per la causa.</p>
              </DettaglioVoce>
              <DettaglioVoce>
                <Figura k="calcolo" />
                <p slot="ancora">2 e 3 · Che cosa e quanto</p>
                <p slot="riga">Target Strategist propone il test, Target Test Calculator lo dimensiona.</p>
              </DettaglioVoce>
              <DettaglioVoce>
                <Figura k="costruire" />
                <p slot="ancora">4 · L’attività preparata</p>
                <p slot="riga">Target Design, Target VEC e Target Setup preparano l’attività, e Target Setup può anche attivarla con il ruolo di Approver. Nel programma proponiamo che l’attivazione resti al vostro team, dopo le vostre approvazioni.</p>
              </DettaglioVoce>
              <p slot="nota">Il passaggio da Analytics a Target e la lettura del risultato con Analytics for Target dentro Coworker non sono documentati come giro: si provano nel programma.</p>
            </Dettaglio>
          </HowItWorks>
          <p class="xd-fonte">Fonti: <a href={EL_AA} target="_blank" rel="noopener">Coworker su Analytics</a> · <a href={EL_TGT} target="_blank" rel="noopener">le skill di Coworker per Target</a></p>
        </div>
        <Giro />
      </div>
    </Slide>

    {/* ── La demo del giro: da un calo in Analytics a un test in Target ─────
        19 nov 2026: un minuto e venti, sulla domanda del capitolo 02 («Dove
        perdiamo le richieste?») fino all'attività preparata. Coworker dice da
        sé che non crea niente finché il team non conferma: nell'ambiente
        condiviso nessuna attività è stata creata. Il ritorno del risultato in
        chat non è nel video, e resta da provare (R12). */}
    <Slide id="slide-video-giro" bg="inverse" align="left">
      <div slot="backdrop" class="xd-bg-piano"></div>
      <div class="xd-sl xd-sl--dark uc-sl-largo" data-reveal>
        <VideoDemo id="uc-video-at" play={VIDEO_AT} locale="media/coworker-analytics-target.mp4"
                   etichetta="Video introduttivo di Coworker da Adobe Analytics ad Adobe Target, ambiente dimostrativo">
          <span slot="didascalia"><span class="ex-frase">Ambiente dimostrativo Adobe su una banca fittizia, con le attese accelerate.</span> <span class="ex-frase">L’attività non è stata creata: la conferma resta al team.</span></span>
          <p class="xd-n">Coworker su Analytics e Target</p>
          <h2 class="xd-h2 uc-firma-t">Dal calo trovato in Analytics al piano di un test in Target, nella stessa chat</h2>
          <ul class="uc-ancore-v" data-stagger>
            <li>Trova dove si perde</li>
            <li>Propone e dimensiona il test</li>
            <li>Non crea niente senza conferma</li>
          </ul>
          <p class="uc-nota">La lettura del risultato in chat non è nel video: si prova nel programma.</p>
          <p class="xd-fonte">Fonti: <a href={EL_AA} target="_blank" rel="noopener">Coworker su Analytics</a> · <a href={EL_TGT} target="_blank" rel="noopener">le skill di Coworker per Target</a></p>
        </VideoDemo>
      </div>
    </Slide>

    {/* ── Due casi dal campo ──────────────────────────────────────────── */}
    <Slide id="slide-campo" bg="primary" align="left">
      <div slot="backdrop" class="ex-bg-paper"></div>
      <div class="xd-sl uc-sl-largo" data-reveal>
        <div class="xd-sl-head">
          <p class="uc-campo-tag">Dal campo · clienti Adobe anonimizzati</p>
          <h2 class="xd-h2">Altri clienti hanno cominciato dalla sintesi dei KPI o da test A/B controllati</h2>
        </div>
        <figure class="uc-casi-fig">
        <ul class="uc-casi" data-stagger>
          <li class="uc-caso">
            {/* Tante righe di KPI per prodotto diventano una sintesi; la spunta è della persona. */}
            <svg class="uc-caso-fig" viewBox="0 0 320 100" preserveAspectRatio="xMinYMid meet" aria-hidden="true">
              {[14, 34, 54, 74].map((y, i) => (<rect class="sf" x="8" y={y} width={70 + (i % 2) * 30} height="10" rx="3" />))}
              <path class="s" d="M128 50 H158 M150 42 L158 50 L150 58" />
              <rect class="a" x="176" y="12" width="76" height="76" rx="8" />
              <path class="s" d="M190 32 H238 M190 46 H232 M190 60 H226" />
              <circle class="af" cx="282" cy="50" r="18" />
              <path d="M273 50 L280 57 L292 44" fill="none" stroke="#ffffff" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <p class="uc-caso-chi">Un assicuratore europeo</p>
            <p class="uc-caso-a">La sintesi settimanale dei KPI per prodotto</p>
            <p class="uc-caso-r"><span class="ex-frase">Sostituisce il report a mano;</span> <span class="ex-frase">il team valida i numeri e sceglie le azioni.</span></p>
          </li>
          <li class="uc-caso">
            {/* Un test A/B: due varianti, Coworker prepara e legge, il team approva. */}
            <svg class="uc-caso-fig" viewBox="0 0 320 100" preserveAspectRatio="xMinYMid meet" aria-hidden="true">
              <path class="s" d="M8 50 H52" />
              <path class="s" d="M52 50 C76 50, 76 22, 100 22 H150 M52 50 C76 50, 76 78, 100 78 H150" />
              <rect class="sf" x="150" y="12" width="56" height="20" rx="4" />
              <rect class="a" x="150" y="68" width="56" height="20" rx="4" />
              <path class="s" d="M216 50 H246 M238 42 L246 50 L238 58" />
              <circle class="af" cx="282" cy="50" r="18" />
              <path d="M273 50 L280 57 L292 44" fill="none" stroke="#ffffff" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <p class="uc-caso-chi">Un fondo pensione europeo</p>
            <p class="uc-caso-a">Partire da test A/B controllati</p>
            <p class="uc-caso-r"><span class="ex-frase">Coworker prepara e legge il test;</span> <span class="ex-frase">l’approvazione resta al team.</span></p>
          </li>
        </ul>
        </figure>
        <p class="xd-fonte">Fonte: dal campo, clienti Adobe anonimizzati (fonti interne Adobe).</p>
      </div>
    </Slide>

    {/* ── La domanda per voi ──────────────────────────────────────────── */}
    <Slide id="slide-domanda" bg="brand" align="left">
      <div slot="backdrop" class="uc-bg-petrolio"></div>
      <div class="uc-dom uc-dom--petrolio uc-on-brand" data-reveal>
        <div class="uc-dom-sx">
          <p class="uc-dom-k">La domanda per voi</p>
          <h2 class="uc-dom-t uc-firma-t">Oggi, quando un numero si muove, il test lo propone l’analista o il marketing?</h2>
        </div>
        {/* Una serie che cala, e dal punto del calo parte un test. */}
        <svg class="uc-dom-fig" viewBox="0 0 360 200" aria-hidden="true">
          <path class="s" d="M10 60 L60 52 L110 64 L150 120" />
          <circle class="af" cx="150" cy="120" r="7" />
          <path class="a" d="M150 120 C190 120, 200 70, 240 70 H250 M150 120 C190 120, 200 170, 240 170 H250" />
          <rect class="s sf" x="250" y="56" width="90" height="28" rx="6" />
          <rect class="a" x="250" y="156" width="90" height="28" rx="6" />
        </svg>
      </div>
    </Slide>

  </DeckContainer>
</BaseLayout>
