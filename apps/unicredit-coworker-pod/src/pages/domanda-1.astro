---
/**
 * 02 · ANALYTICS — il primo approfondimento: Coworker su Adobe Analytics.
 *
 * Sei famiglie di domande, scritte come messaggi in chat: è la voce del
 * cliente, e si vede (giro del 17 nov 2026: non più sei card uguali). Poi le
 * stesse sei «oggi» e «con Coworker», in due slide di forma diversa — tre
 * righe su carta, tre conversazioni sul fondo scuro — perché due slide uguali di
 * fila sono un formato, non una partitura. Poi dove Coworker su Analytics oggi
 * si ferma, e dove va la cosa. Si chiude su una domanda alla sala.
 *
 * ⚠️ La colonna «oggi» è un'IPOTESI nostra su come lavora il team, e la slide
 * lo dice: chi usa Analytics da diciotto anni la correggerà, ed è il punto.
 *
 * Fonte unica per ciò che Coworker fa su Analytics: Experience League,
 * «Analyze Analytics Data with Coworker Chat» (aggiornata al 4 nov 2026), che
 * elenca le skill `aa` e `aa-root-cause-analysis`, i permessi ereditati e i
 * limiti (niente anomalie non richieste né alert). Dal 19 nov 2026 il deck
 * parla SOLO di funzioni di Analytics: niente confronti con Customer Journey
 * Analytics (decisione dell'owner). La sintesi per il management e il
 * salvataggio di un flusso come skill: la pagina «workflows» (agg. 12 nov
 * 2026) li indica anche per Analytics, e si provano sui dati del cliente.
 * L'attivazione dell'organizzazione (IMS Org) entro il kickoff e il pannello in Workspace «annunciato»
 * vengono dal brief interno del 17 nov 2026, non da quella pagina.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import HowItWorks from '@edf/core/blocks/HowItWorks.astro';
import Dettaglio from '@edf/core/blocks/Dettaglio.astro';
import DettaglioVoce from '@edf/core/blocks/DettaglioVoce.astro';
import Figura from '../components/Figura.astro';
import Divisore from '../components/Divisore.astro';
import fotoDiv from '../assets/generated/bg/div-analytics.webp';
import VideoDemo from '../components/VideoDemo.astro';
import Schermo from '../components/Schermo.astro';
import schermoAA from '../assets/schermi/aa-funnel.webp';
import { href } from '@edf/core/utils/url.js';
import { CHAPTERS, prevSlug, nextSlug } from '../data/chapters';
import { CATEGORIE } from '../data/contenuti';

const SLUG = 'domanda-1';
const ch = CHAPTERS.find((c) => c.slug === SLUG)!;
const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;

const EL_AA = 'https://experienceleague.adobe.com/en/docs/coworker/content/chat/use-cases/data-insights/analytics-overview';
const EL_UI = 'https://experienceleague.adobe.com/en/docs/coworker/content/chat/ui-guide';
const EL_WF = 'https://experienceleague.adobe.com/en/docs/coworker/content/chat/use-cases/workflows';

/* La demo da 1:32 nella release `media` del repo (20 nov 2026: Dynamic Media
   non attivo sull'istanza AEM accessibile). Un link `/play` di Dynamic Media
   funziona allo stesso modo; vuota, il `.mp4` locale git-ignorato. */
const VIDEO_AA = 'https://github.com/agargiulo-adbe/experience-design-factory/releases/download/media/uc-coworker-analytics.mp4';
/* La prima registrazione, 3:40 a tempo reale (Dynamic Media, 17 nov 2026): fuori
   dal percorso proiettato (ritorno di un collega: «molto lento»), resta come
   riserva nel drill-down per chi riceve il deck inoltrato. */
const VIDEO_INTEGRALE = 'https://delivery-p97303-e890303.adobeaemcloud.com/adobe/assets/urn:aaid:aem:c78cf9a8-0020-43b7-adf1-252d32fb76d6/play';

/* Le sei categorie: un nome e un prompt. Il prompt è al singolare perché è
   una chat (eccezione dichiarata alla voce istituzionale). */
const PRIMA = CATEGORIE.slice(0, 3);
const SECONDA = CATEGORIE.slice(3);
---
<BaseLayout title={ch.title}>
  <div class="fixed top-0 left-0 right-0 z-50">
    <Navigation currentPath={currentPath} base={base} />
  </div>

  <DeckContainer nextHref={href(base, nextSlug(SLUG))} prevHref={href(base, prevSlug(SLUG))}>

    <Slide id="slide-cover" bg="secondary" align="left" data-made-with="Adobe Stock" data-made-with-for="fotografia">
      <div slot="backdrop" class="xd-div-bg" style={`--foto: url('${fotoDiv.src}')`}></div>
      <Divisore num={ch.num} conFoto titolo={ch.title} punto={ch.punto} occhiello="Adobe Analytics" />
    </Slide>

    {/* ── Le sei famiglie, come domande in chat: la voce del cliente ─────── */}
    <Slide id="slide-categorie" bg="primary" align="left">
      <div slot="backdrop" class="ex-bg-paper"></div>
      <div class="xd-sl uc-sl-largo" data-reveal>
        <div class="xd-sl-head">
          <p class="xd-n">Adobe Analytics</p>
          <h2 class="xd-h2">Domande che si possono fare a Coworker su Analytics</h2>
          <p class="xd-sub">Diteci quali vi capitano davvero, e quali aggiungereste.</p>
        </div>
        <figure class="uc-chat">
          <ol class="uc-chat-g" role="list" data-stagger>
            {CATEGORIE.map((c, i) => (
              <li class="uc-chat-i" style={`--i:${i}`}>
                <p class="uc-chat-a">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h16v10H9l-5 4z" /></svg>
                  {c.a}
                </p>
                <p class="uc-chat-b">{c.p}</p>
              </li>
            ))}
          </ol>
        </figure>
      </div>
    </Slide>

    {/* ── La risposta, com'è sullo schermo (19 nov 2026) ─────────────────
        Una schermata vera, dalla registrazione del video introduttivo: la
        seconda domanda della tavola, con il grafico già fatto e il pulsante
        che la riapre in Workspace. */}
    <Slide id="slide-schermo" bg="primary" align="left">
      <div slot="backdrop" class="ex-bg-paper"></div>
      <div class="uc-prova" data-reveal>
        <Schermo src={schermoAA} alt="Coworker risponde a «Dove perdiamo le persone nel percorso di richiesta?» con un grafico a barre del funnel diviso tra sito e mobile web, e il pulsante Analyze in Analytics Workspace"
                 didascalia="Schermata reale di Coworker, novembre 2026. Ambiente dimostrativo Adobe Analytics, dati di una banca fittizia." />
        <div class="uc-prova-dx">
          <p class="xd-n">«Dove perdiamo le richieste?»</p>
          <h2 class="xd-h2">Le risposte sono presentate come grafici di Analytics</h2>
          <ul class="uc-ancore-v uc-ancore-v--chiaro" data-stagger>
            <li>Il funnel, diviso per canale</li>
            <li>I numeri anche in tabella</li>
            <li>Si riapre in Workspace</li>
          </ul>
        </div>
      </div>
    </Slide>

    {/* ── Oggi e con Coworker, 1 di 2 ──────────────────────────────────── */}
    <Slide id="slide-oggi-1" bg="primary" align="left">
      <div slot="backdrop" class="ex-bg-paper"></div>
      <div class="xd-sl" data-reveal>
        <div class="xd-sl-head">
          <p class="xd-n">Confronto tra oggi e domani con Coworker</p>
          <h2 class="xd-h2">Basta una domanda in chat per ottenere ripartizione, funnel e cause</h2>
          <p class="xd-sub">La colonna «oggi» è una nostra ipotesi, da correggere con voi.</p>
        </div>
        <div class="uc-confronto">
          <div class="uc-conf-testa" aria-hidden="true">
            <p>La domanda</p><p>Oggi</p><span></span><p class="uc-conf-cw">Con Coworker</p>
          </div>
          {PRIMA.map((c) => (
            <div class="uc-conf-riga" data-substep>
              <p class="uc-conf-cat">{c.a}</p>
              <p class="uc-conf-oggi">{c.oggi}</p>
              <svg class="uc-conf-freccia" viewBox="0 0 36 20" aria-hidden="true"><path d="M2 10h30M25 3l7 7-7 7" /></svg>
              <p class="uc-conf-con">{c.con}</p>
            </div>
          ))}
        </div>
        <HowItWorks title="Le skill dietro queste tre risposte" tone="onLight" class="ex-dett">
          <Dettaglio>
            <DettaglioVoce>
              <Figura k="chiedi" />
              <p slot="ancora">Domande sui dati</p>
              <p slot="riga">Coworker interroga le report suite in tempo reale: metriche, dimensioni, segmenti, funnel e fallout.</p>
            </DettaglioVoce>
            <DettaglioVoce>
              <Figura k="causa" />
              <p slot="ancora">La causa di una variazione</p>
              <p slot="riga">Coworker indaga perché una metrica è cambiata in un periodo, e che cosa ha contribuito.</p>
            </DettaglioVoce>
            <DettaglioVoce>
              <Figura k="permessi" />
              <p slot="ancora">Come si controlla una risposta</p>
              <p slot="riga">Coworker usa i permessi dell’utente, e ogni grafico si riapre in Workspace per il controllo.</p>
            </DettaglioVoce>
            <p slot="nota">Quale metrica sceglie fra le vostre calcolate non è documentato: lo proviamo nel programma.</p>
          </Dettaglio>
        </HowItWorks>
        <p class="xd-fonte">Fonte: <a href={EL_AA} target="_blank" rel="noopener">Experience League, analisi dei dati con Coworker Chat</a></p>
      </div>
    </Slide>

    {/* ── Oggi e con Coworker, le altre tre: tre conversazioni ─────────────
        18 nov 2026: erano tre colonne a sei livelli (categoria, «oggi», testo,
        freccia, «con Coworker», risposta) più due righe di lead e una nota, e
        «quasi impossibile da seguire». Ora ogni colonna si legge dall'alto come
        una chat: la vostra domanda, la risposta di Coworker, e in fondo, piccolo,
        com'è oggi. La frase promessa dal titolo è in pagina. */}
    <Slide id="slide-oggi-2" bg="inverse" align="left">
      <div slot="backdrop" class="xd-bg-piano"></div>
      <div class="xd-sl xd-sl--dark uc-sl-largo" data-reveal>
        <div class="xd-sl-head">
          <p class="xd-n">Confronto tra oggi e domani con Coworker</p>
          <h2 class="xd-h2 uc-firma-t">Anche confronto, previsione e sintesi partono da una conversazione</h2>
          <p class="xd-sub">La riga «oggi» è una nostra ipotesi, da correggere con voi.</p>
        </div>
        <figure class="uc-conv3">
          {SECONDA.map((c) => (
            <div class="uc-conv" data-substep>
              <p class="uc-conv-voi">{c.p}</p>
              <p class="uc-conv-cw"><span class="uc-conv-chi">Coworker</span>{c.con}</p>
              <p class="uc-conv-oggi"><span class="uc-conv-k">Oggi</span>{c.oggi}</p>
            </div>
          ))}
        </figure>
        <p class="uc-nota">Ogni visualizzazione si riapre in Analysis Workspace, dove l’analista controlla i numeri prima che una sintesi esca dal team.</p>
        <HowItWorks title="Le skill dietro queste tre risposte" tone="onDark" class="ex-dett ex-dett--scuro">
          <Dettaglio>
            <DettaglioVoce>
              <Figura k="chiedi" />
              <p slot="ancora">Il confronto fra segmenti</p>
              <p slot="riga">Coworker mette a confronto canali, periodi o segmenti, fianco a fianco.</p>
            </DettaglioVoce>
            <DettaglioVoce>
              <Figura k="previsione" />
              <p slot="ancora">La previsione</p>
              <p slot="riga">Coworker proietta una metrica sull’andamento storico. I modelli predittivi restano fuori.</p>
            </DettaglioVoce>
            <DettaglioVoce>
              <Figura k="sintesi" />
              <p slot="ancora">La sintesi del periodo</p>
              <p slot="riga">Si chiede in chat. Per la sintesi destinata al management c’è anche una skill dedicata, da provare sui vostri dati.</p>
            </DettaglioVoce>
          </Dettaglio>
        </HowItWorks>
        <p class="xd-fonte">Fonte: <a href={EL_AA} target="_blank" rel="noopener">Experience League, analisi dei dati con Coworker Chat</a></p>
      </div>
    </Slide>

    {/* ── La demo, sulle stesse domande ─────────────────────────────────
        19 nov 2026: era nel capitolo 01, tre minuti e quaranta, prima che la
        sala avesse detto qualcosa. Ora viene dopo le sei domande, e il video
        ne fa quattro: un minuto e mezzo, con un cartello per domanda e uno per
        risposta, le attese di Coworker accelerate e dichiarate. */}
    <Slide id="slide-video" bg="inverse" align="left">
      <div slot="backdrop" class="xd-bg-piano"></div>
      <div class="xd-sl xd-sl--dark uc-sl-largo" data-reveal>
        <VideoDemo id="uc-video-aa" play={VIDEO_AA} poster="media/uc-coworker-analytics.poster.jpg" locale="media/coworker-analytics.mp4"
                   etichetta="Video introduttivo di Coworker su Adobe Analytics, ambiente dimostrativo"
                   didascalia="Ambiente dimostrativo Adobe Analytics, dati di una banca fittizia, attese accelerate. La report suite di prova ha «CJA» nel nome solo come etichetta dell’ambiente: dati, skill e pulsante sono di Analytics.">
          <p class="xd-n">Coworker su Analytics</p>
          <h2 class="xd-h2 uc-firma-t">Un esempio di utilizzo di Coworker su una banca fittizia</h2>
          <ul class="uc-ancore-v" data-stagger>
            <li>Si chiede in italiano</li>
            <li>Risponde sui dati Analytics</li>
            <li>Con i permessi che avete già</li>
          </ul>
          <HowItWorks title="Che cosa vuol dire, una per una" tone="onDark" class="ex-dett ex-dett--scuro">
            <Dettaglio>
              <DettaglioVoce>
                <Figura k="permessi" />
                <p slot="ancora">Gli stessi permessi di Workspace</p>
                <p slot="riga">Coworker eredita i permessi di Analytics: vede solo le report suite, le metriche e i segmenti che l’utente vede già.</p>
              </DettaglioVoce>
              <DettaglioVoce>
                <Figura k="riapri" />
                <p slot="ancora">Si riapre in Workspace</p>
                <p slot="riga">Ogni visualizzazione creata in chat si apre in Analysis Workspace, per lavorarla a mano.</p>
              </DettaglioVoce>
            </Dettaglio>
            <p class="uc-integrale"><a href={VIDEO_INTEGRALE} target="_blank" rel="noopener">La registrazione integrale, a tempo reale (3:40)</a></p>
          </HowItWorks>
          <p class="xd-fonte">Fonte: <a href={EL_AA} target="_blank" rel="noopener">Experience League, analisi dei dati con Coworker Chat</a></p>
        </VideoDemo>
      </div>
    </Slide>

    {/* ── Dove Coworker su Analytics oggi si ferma, e dove va la cosa ────── */}
    <Slide id="slide-limiti" bg="primary" align="left">
      <div slot="backdrop" class="ex-bg-paper"></div>
      <div class="xd-sl" data-reveal>
        <div class="xd-sl-head">
          <p class="xd-n">I confini, oggi</p>
          <h2 class="xd-h2">Le potenzialità e i limiti di Coworker su Analytics</h2>
        </div>
        <ul class="uc-limiti uc-limiti--tre" data-stagger>
          <li class="uc-limite">
            <svg viewBox="0 0 32 32" aria-hidden="true"><circle cx="16" cy="16" r="12" stroke-dasharray="4 4" /><path d="M10 20l4-5 3 3 5-7" /></svg>
            <p class="uc-limite-a">Anomalie e alert restano in Workspace</p>
            <p class="uc-limite-r">La funzione Contribution Analysis di Workspace, le anomalie automatiche e gli alert non passano da Coworker. L’analisi delle cause su una metrica nota sì.</p>
          </li>
          <li class="uc-limite">
            <svg viewBox="0 0 32 32" aria-hidden="true"><circle cx="16" cy="16" r="12" stroke-dasharray="4 4" /><rect x="10" y="11" width="12" height="10" rx="1.5" /></svg>
            <p class="uc-limite-a">Non ancora dentro Workspace</p>
            <p class="uc-limite-r">Oggi Coworker si usa dalla sua chat. Adobe ha annunciato che arriverà anche dentro Analysis Workspace.</p>
          </li>
          <li class="uc-limite">
            <svg viewBox="0 0 32 32" aria-hidden="true"><circle cx="16" cy="16" r="12" stroke-dasharray="4 4" /><path d="M11 12h10M11 16h10M11 20h6" /></svg>
            <p class="uc-limite-a">Le skill salvate, da provare</p>
            <p class="uc-limite-r">Un flusso che funziona si salva come skill e si riusa. Su Analytics è documentato: lo proviamo sui vostri dati nel programma.</p>
          </li>
        </ul>
        <p class="xd-chiusa">Quali di questi limiti vi pesano? Nel programma diventano richieste al prodotto Adobe.</p>
        <p class="xd-fonte">Fonte: <a href={EL_AA} target="_blank" rel="noopener">Experience League, skill e limiti di Coworker su Analytics</a> · <a href={EL_WF} target="_blank" rel="noopener">i workflow di Coworker</a> · <a href={EL_UI} target="_blank" rel="noopener">dove è disponibile Coworker (Analytics, nel prodotto: «Coming soon»)</a> · Contribution Analysis: fonti interne Adobe, novembre 2026</p>
      </div>
    </Slide>

    {/* ── La domanda per voi: due alternative concrete, mai sì o no ─────── */}
    <Slide id="slide-domanda" bg="brand" align="left">
      <div slot="backdrop" class="uc-bg-petrolio"></div>
      <div class="uc-dom uc-dom--petrolio uc-on-brand" data-reveal>
        <div class="uc-dom-sx">
          <p class="uc-dom-k">La domanda per voi</p>
          <h2 class="uc-dom-t uc-firma-t">Quanto tempo passa oggi il vostro team a preparare report?<br /> E quanto a capire i numeri?</h2>
        </div>
        {/* Le due alternative, una accanto all'altra: il numero, e la sua causa. */}
        <figure class="uc-dom-figura">
          <svg class="uc-dom-fig" viewBox="0 0 360 200" aria-hidden="true">
            <rect class="s sf" x="8" y="20" width="150" height="160" rx="14" />
            {[[36, 60], [70, 96], [104, 40]].map(([x, h]) => (<rect class="sf2" x={x} y={150 - h} width="24" height={h} rx="3" />))}
            <path class="s" d="M28 150 H140" />
            <path class="s" d="M172 160 L188 40" />
            <rect class="a" x="202" y="20" width="150" height="160" rx="14" />
            <path class="a" d="M222 70 L254 64 L282 76 L304 124" />
            <circle class="af" cx="304" cy="124" r="7" />
            <path class="a" d="M304 124 L332 152" />
          </svg>
        </figure>
      </div>
    </Slide>

  </DeckContainer>
</BaseLayout>
