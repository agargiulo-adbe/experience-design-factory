---
/**
 * 02 · ANALYTICS — il primo approfondimento: Coworker su Adobe Analytics.
 *
 * Sei famiglie di domande, scritte come messaggi in chat: è la voce del
 * cliente, e si vede (giro del 17 nov 2026: non più sei card uguali). Poi le
 * stesse sei «oggi» e «con Coworker», in due slide di forma diversa — tre
 * righe su carta, tre colonne sul fondo scuro — perché due slide uguali di
 * fila sono un formato, non una partitura. Poi dove Coworker su Analytics oggi
 * si ferma, e dove va la cosa. Si chiude su una domanda alla sala.
 *
 * ⚠️ La colonna «oggi» è un'IPOTESI nostra su come lavora il team, e la slide
 * lo dice: chi usa Analytics da diciotto anni la correggerà, ed è il punto.
 *
 * Fonte unica per ciò che Coworker fa su Analytics: Experience League,
 * «Analyze Analytics Data with Coworker Chat» (aggiornata al 4 nov 2026), che
 * elenca le skill `aa` e `aa-root-cause-analysis`, i permessi ereditati e i
 * limiti (niente anomalie non richieste né alert; sintesi esecutiva e
 * creazione di skill solo su Customer Journey Analytics).
 * L'accensione per gruppi di clienti e il pannello in Workspace «annunciato»
 * vengono dal brief interno del 17 nov 2026, non da quella pagina.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import HowItWorks from '@edf/core/blocks/HowItWorks.astro';
import Dettaglio from '@edf/core/blocks/Dettaglio.astro';
import DettaglioVoce from '@edf/core/blocks/DettaglioVoce.astro';
import Figura from '../components/Figura.astro';
import Divisore from '../components/Divisore.astro';
import Motivo from '../components/Motivo.astro';
import { href } from '@edf/core/utils/url.js';
import { CHAPTERS, prevSlug, nextSlug } from '../data/chapters';
import { CATEGORIE } from '../data/contenuti';

const SLUG = 'domanda-1';
const ch = CHAPTERS.find((c) => c.slug === SLUG)!;
const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;

const EL_AA = 'https://experienceleague.adobe.com/en/docs/coworker/content/chat/use-cases/data-insights/analytics-overview';
const EL_UI = 'https://experienceleague.adobe.com/en/docs/coworker/content/chat/ui-guide';
const EL_WF = 'https://experienceleague.adobe.com/en/docs/coworker/content/chat/use-cases/workflows';

/* Le sei categorie: un nome e un prompt. Il prompt è al singolare perché è
   una chat (eccezione dichiarata alla voce istituzionale). */
const PRIMA = CATEGORIE.slice(0, 3);
const SECONDA = CATEGORIE.slice(3);
---
<BaseLayout title={ch.title}>
  <div class="fixed top-0 left-0 right-0 z-50">
    <Navigation currentPath={currentPath} base={base} />
  </div>

  <DeckContainer nextHref={href(base, nextSlug(SLUG))} prevHref={href(base, prevSlug(SLUG))}>

    <Slide id="slide-cover" bg="secondary" align="left">
      <div slot="backdrop" class="xd-div-bg" data-senza-foto><Motivo k="chat" /></div>
      <Divisore num={ch.num} titolo={ch.title} punto={ch.punto} occhiello="Adobe Analytics" />
    </Slide>

    {/* ── Le sei famiglie, come domande in chat: la voce del cliente ─────── */}
    <Slide id="slide-categorie" bg="primary" align="left">
      <div slot="backdrop" class="ex-bg-paper"></div>
      <div class="xd-sl uc-sl-largo" data-reveal>
        <div class="xd-sl-head">
          <p class="xd-n">Adobe Analytics</p>
          <h2 class="xd-h2">Le domande che fate già, scritte come in chat</h2>
        </div>
        <figure class="uc-chat">
          <ol class="uc-chat-g" role="list" data-stagger>
            {CATEGORIE.map((c, i) => (
              <li class="uc-chat-i" style={`--i:${i}`}>
                <p class="uc-chat-a">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h16v10H9l-5 4z" /></svg>
                  {c.a}
                </p>
                <p class="uc-chat-b">{c.p}</p>
              </li>
            ))}
          </ol>
        </figure>
      </div>
    </Slide>

    {/* ── Oggi e con Coworker, 1 di 2 ──────────────────────────────────── */}
    <Slide id="slide-oggi-1" bg="primary" align="left">
      <div slot="backdrop" class="ex-bg-paper"></div>
      <div class="xd-sl" data-reveal>
        <div class="xd-sl-head">
          <p class="xd-n">Oggi e con Coworker</p>
          <h2 class="xd-h2">Tre domande che oggi chiedono un progetto Workspace, e in chat una frase</h2>
          <p class="xd-sub">La colonna «oggi» è una nostra ipotesi, da correggere con voi.</p>
        </div>
        <div class="uc-confronto">
          <div class="uc-conf-testa" aria-hidden="true">
            <p>La domanda</p><p>Oggi</p><span></span><p class="uc-conf-cw">Con Coworker</p>
          </div>
          {PRIMA.map((c) => (
            <div class="uc-conf-riga" data-substep>
              <p class="uc-conf-cat">{c.a}</p>
              <p class="uc-conf-oggi">{c.oggi}</p>
              <svg class="uc-conf-freccia" viewBox="0 0 36 20" aria-hidden="true"><path d="M2 10h30M25 3l7 7-7 7" /></svg>
              <p class="uc-conf-con">{c.con}</p>
            </div>
          ))}
        </div>
        <HowItWorks title="Le skill dietro queste tre risposte" tone="onLight" class="ex-dett">
          <Dettaglio>
            <DettaglioVoce>
              <Figura k="chiedi" />
              <p slot="ancora">Domande sui dati</p>
              <p slot="riga">La skill aa interroga le report suite in tempo reale: metriche, dimensioni, segmenti, confronti, funnel e fallout.</p>
            </DettaglioVoce>
            <DettaglioVoce>
              <Figura k="causa" />
              <p slot="ancora">La causa di una variazione</p>
              <p slot="riga">La skill aa-root-cause-analysis indaga perché una metrica è cambiata in un periodo noto, e che cosa ha contribuito.</p>
            </DettaglioVoce>
            <DettaglioVoce>
              <Figura k="permessi" />
              <p slot="ancora">Come si controlla una risposta</p>
              <p slot="riga">I permessi sono quelli dell’utente, e la visualizzazione si riapre in Workspace per il confronto col numero certificato.</p>
            </DettaglioVoce>
            <p slot="nota">Quale metrica sceglie fra le vostre calcolate non è documentato: lo proviamo nel programma.</p>
          </Dettaglio>
        </HowItWorks>
        <p class="xd-fonte">Fonte: <a href={EL_AA} target="_blank" rel="noopener">Experience League, analisi dei dati con Coworker Chat</a></p>
      </div>
    </Slide>

    {/* ── Oggi e con Coworker, le altre tre: colonne sul fondo scuro ─────── */}
    <Slide id="slide-oggi-2" bg="inverse" align="left">
      <div slot="backdrop" class="xd-bg-piano"></div>
      <div class="xd-sl xd-sl--dark uc-sl-largo" data-reveal>
        <div class="xd-sl-head">
          <p class="xd-n">Oggi e con Coworker</p>
          <h2 class="xd-h2 uc-firma-t">Anche il confronto, la previsione e la sintesi partono da una frase</h2>
          <p class="xd-sub"><span class="ex-frase">Ogni visualizzazione si riapre in Analysis Workspace, per lavorarla a mano.</span> <span class="ex-frase">La colonna «oggi» è una nostra ipotesi, da correggere con voi.</span></p>
        </div>
        <figure class="uc-col3">
          {SECONDA.map((c) => (
            <div class="uc-col" data-substep>
              <p class="uc-col-cat">{c.a}</p>
              <p class="uc-col-k">Oggi</p>
              <p class="uc-col-oggi">{c.oggi}</p>
              <svg class="uc-col-freccia" viewBox="0 0 40 40" aria-hidden="true"><path d="M20 4v30M11 25l9 9 9-9" /></svg>
              <p class="uc-col-k uc-col-k--cw">Con Coworker</p>
              <p class="uc-col-con">{c.con}</p>
            </div>
          ))}
        </figure>
        <p class="uc-nota">Prima che una sintesi vada in direzione, l’analista riapre le visualizzazioni in Workspace e controlla i numeri.</p>
        <HowItWorks title="Le skill dietro queste tre risposte" tone="onDark" class="ex-dett ex-dett--scuro">
          <Dettaglio>
            <DettaglioVoce>
              <Figura k="chiedi" />
              <p slot="ancora">Il confronto fra segmenti</p>
              <p slot="riga">La skill aa mette a confronto canali, periodi o segmenti, fianco a fianco.</p>
            </DettaglioVoce>
            <DettaglioVoce>
              <Figura k="previsione" />
              <p slot="ancora">La previsione</p>
              <p slot="riga">La skill aa proietta una metrica sull’andamento storico. Modelli predittivi oltre la previsione restano fuori.</p>
            </DettaglioVoce>
            <DettaglioVoce>
              <Figura k="sintesi" />
              <p slot="ancora">La sintesi del periodo</p>
              <p slot="riga">Si chiede in chat. La skill dedicata alla sintesi per il management, oggi, c’è solo su Customer Journey Analytics.</p>
            </DettaglioVoce>
          </Dettaglio>
        </HowItWorks>
        <p class="xd-fonte">Fonte: <a href={EL_AA} target="_blank" rel="noopener">Experience League, analisi dei dati con Coworker Chat</a></p>
      </div>
    </Slide>

    {/* ── Dove Coworker su Analytics oggi si ferma, e dove va la cosa ────── */}
    <Slide id="slide-limiti" bg="primary" align="left">
      <div slot="backdrop" class="ex-bg-paper"></div>
      <div class="xd-sl" data-reveal>
        <div class="xd-sl-head">
          <p class="xd-n">I confini, oggi</p>
          <h2 class="xd-h2">Dove Coworker su Analytics oggi si ferma, e dove resta il lavoro</h2>
        </div>
        <ul class="uc-limiti" data-stagger>
          <li class="uc-limite">
            <svg viewBox="0 0 32 32" aria-hidden="true"><circle cx="16" cy="16" r="12" stroke-dasharray="4 4" /><path d="M16 9v7l4 3" /></svg>
            <p class="uc-limite-a">Si accende per gruppi di clienti</p>
            <p class="uc-limite-r">L’abilitazione della vostra organizzazione è una condizione per fissare il kickoff.</p>
          </li>
          <li class="uc-limite">
            <svg viewBox="0 0 32 32" aria-hidden="true"><circle cx="16" cy="16" r="12" stroke-dasharray="4 4" /><path d="M10 20l4-5 3 3 5-7" /></svg>
            <p class="uc-limite-a">Anomalie e alert restano in Workspace</p>
            <p class="uc-limite-r">La funzione Contribution Analysis di Workspace, le anomalie automatiche e gli alert non passano da Coworker. L’analisi delle cause su una metrica nota sì.</p>
          </li>
          <li class="uc-limite">
            <svg viewBox="0 0 32 32" aria-hidden="true"><circle cx="16" cy="16" r="12" stroke-dasharray="4 4" /><rect x="10" y="11" width="12" height="10" rx="1.5" /></svg>
            <p class="uc-limite-a">Il pannello in Workspace è annunciato</p>
            <p class="uc-limite-r">Su Analytics oggi Coworker si usa in chat; dentro Analysis Workspace è annunciato.</p>
          </li>
          <li class="uc-limite">
            <svg viewBox="0 0 32 32" aria-hidden="true"><circle cx="16" cy="16" r="12" stroke-dasharray="4 4" /><path d="M11 12h10M11 16h10M11 20h6" /></svg>
            <p class="uc-limite-a">Due skill, per ora solo su CJA</p>
            <p class="uc-limite-r">La sintesi si chiede in chat; la skill dedicata e il salvataggio di un’analisi come skill oggi stanno su Customer Journey Analytics.</p>
          </li>
        </ul>
        <p class="xd-chiusa">Nel programma possiamo portarle come richieste al prodotto, e provarle con il team di sviluppo Adobe.</p>
        <p class="xd-fonte">Fonte: <a href={EL_AA} target="_blank" rel="noopener">Experience League, skill e limiti di Coworker su Analytics</a> · <a href={EL_WF} target="_blank" rel="noopener">i workflow di Coworker</a> · <a href={EL_UI} target="_blank" rel="noopener">dove è disponibile Coworker (Analytics, nel prodotto: «Coming soon»)</a> · accensione per gruppi e Contribution Analysis: fonti interne Adobe, novembre 2026</p>
      </div>
    </Slide>

    {/* ── La domanda per voi: due alternative concrete, mai sì o no ─────── */}
    <Slide id="slide-domanda" bg="inverse" align="left">
      <div slot="backdrop" class="xd-bg-piano"></div>
      <div class="uc-dom" data-reveal>
        <div class="uc-dom-sx">
          <p class="uc-dom-k">La domanda per voi</p>
          <h2 class="uc-dom-t uc-firma-t">Oggi vi costa più tempo trovare il numero, o capire perché si è mosso?</h2>
        </div>
        {/* Le due alternative, una accanto all'altra: il numero, e la sua causa. */}
        <figure class="uc-dom-figura">
          <svg class="uc-dom-fig" viewBox="0 0 360 200" aria-hidden="true">
            <rect class="s sf" x="8" y="20" width="150" height="160" rx="14" />
            {[[36, 60], [70, 96], [104, 40]].map(([x, h]) => (<rect class="sf2" x={x} y={150 - h} width="24" height={h} rx="3" />))}
            <path class="s" d="M28 150 H140" />
            <path class="s" d="M172 160 L188 40" />
            <rect class="a" x="202" y="20" width="150" height="160" rx="14" />
            <path class="a" d="M222 70 L254 64 L282 76 L304 124" />
            <circle class="af" cx="304" cy="124" r="7" />
            <path class="a" d="M304 124 L332 152" />
          </svg>
        </figure>
      </div>
    </Slide>

  </DeckContainer>
</BaseLayout>
