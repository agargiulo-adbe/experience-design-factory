---
/**
 * 01 · IL QUADRO — la visione d'insieme, prima dei due approfondimenti.
 *
 * Giro del 17 nov 2026 (richiesta dell'owner): prima il quadro, poi Analytics,
 * poi Analytics e Target. Giro del 19 nov 2026, dopo il ritorno di un collega
 * («mostrarlo in una riunione che è di fatto discovery è controproducente»):
 *   · si apre con una domanda alla sala, prima di dire una parola su Adobe;
 *   · il Customer POD, su petrolio pieno: la cifra e le tre cose che dà;
 *   · LA MAPPA, sul fondo scuro: tutto il programma in una pagina, a fasi
 *     (`Mappa.astro`): è la slide-firma del deck;
 *   (dati e approvazioni tolta il 19 nov 2026: il GenAI rider è già firmato,
 *   e l'IMS Org per l'attivazione è fra le risposte del capitolo 04).
 * Le tappe stanno solo nel capitolo 04 (prima erano qui e lì, uguali); la
 * demo è scesa nei due capitoli che fanno le sue domande (`VideoDemo.astro`).
 *
 * Il POD è RICOMPOSTO dalla slide 7 del deck presentato il 6 nov 2026, che
 * diceva esattamente questo: nessuna promessa in più. Il programma parte su
 * Adobe Analytics e Adobe Target si aggancia circa tre settimane dopo (accordo
 * interno Adobe del 17 nov 2026): mai un giorno preciso in pagina.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import Divisore from '../components/Divisore.astro';
import fotoDiv from '../assets/generated/bg/div-quadro.webp';
import Mappa from '../components/Mappa.astro';
import { href } from '@edf/core/utils/url.js';
import { CHAPTERS, prevSlug, nextSlug } from '../data/chapters';

const SLUG = 'partenza';
const ch = CHAPTERS.find((c) => c.slug === SLUG)!;
const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;

/* Il righello dei novanta giorni: un trattino al giorno, uno più lungo a
   settimana. Le prime tre settimane, solo Analytics, sono quelle accese. */
const GIORNI = Array.from({ length: 90 }, (_, i) => i);
---
<BaseLayout title={ch.title}>
  <div class="fixed top-0 left-0 right-0 z-50">
    <Navigation currentPath={currentPath} base={base} />
  </div>

  <DeckContainer nextHref={href(base, nextSlug(SLUG))} prevHref={href(base, prevSlug(SLUG))}>

    <Slide id="slide-cover" bg="secondary" align="left" data-made-with="Adobe Firefly" data-made-with-for="sfondo">
      <div slot="backdrop" class="xd-div-bg" style={`--foto: url('${fotoDiv.src}')`}></div>
      <Divisore num={ch.num} conFoto titolo={ch.title} punto={ch.punto} />
    </Slide>

    {/* ── Prima di tutto, la sala: una domanda prima di parlare di Adobe ────
        Ritorno di un collega del 18 nov 2026: in una sessione di discovery il
        deck apriva con quattro slide di Adobe, e la prima domanda alla sala
        arrivava all'undicesima. Ora si apre ascoltando (R3: «Oggi», due
        alternative legittime, nessun difetto presupposto). */}
    <Slide id="slide-apertura" bg="brand" align="left">
      <div slot="backdrop" class="uc-bg-petrolio"></div>
      <div class="uc-dom uc-dom--petrolio uc-on-brand" data-reveal>
        <div class="uc-dom-sx">
          <p class="uc-dom-k">Prima di tutto</p>
          <h2 class="uc-dom-t uc-firma-t">Oggi, quando vi chiedono un dato sui canali digitali, quanto ci mettete a rispondere?</h2>
        </div>
        {/* Dalla richiesta alla risposta, con il tempo in mezzo: è la cosa che si
            chiede (19 nov 2026: la versione a due alternative non si capiva). */}
        <figure class="uc-dom-figura">
          <svg class="uc-dom-fig" viewBox="0 0 360 200" aria-hidden="true">
            <rect class="s sf" x="8" y="40" width="112" height="120" rx="12" />
            <path class="s" d="M30 78 H98 M30 100 H86 M30 122 H94" />
            <path class="s" d="M132 100 H160" stroke-dasharray="2 8" />
            <circle class="a" cx="180" cy="100" r="22" />
            <path class="a" d="M180 88 V100 L189 106" />
            <path class="s" d="M202 100 H228" stroke-dasharray="2 8" />
            <rect class="a" x="240" y="40" width="112" height="120" rx="12" />
            {[[262, 36], [290, 62], [318, 84]].map(([x, h]) => (<rect class="af" x={x} y={142 - h} width="18" height={h} rx="3" />))}
          </svg>
        </figure>
      </div>
    </Slide>

    {/* ── Il Customer POD: la cifra, e le tre cose che il programma dà ────── */}
    <Slide id="slide-pod" bg="brand" align="left">
      <div slot="backdrop" class="uc-bg-petrolio"></div>
      <div class="uc-pod ex-on-dark uc-on-brand" data-reveal>
        <figure class="uc-pod-cifra">
          <p class="uc-pod-n" data-display><span>90</span><span class="uc-pod-u">giorni</span></p>
          <svg class="uc-pod-righello" viewBox="0 0 900 60" preserveAspectRatio="none" aria-hidden="true">
            {GIORNI.map((g) => (
              <line x1={g * 10 + 5} x2={g * 10 + 5} y1={g % 7 === 0 ? 4 : 24} y2="56" class={g % 7 === 0 ? 'p' : ''} />
            ))}
          </svg>
          <figcaption class="uc-pod-cap"><span>Kickoff</span><span>Giorno 90</span></figcaption>
        </figure>
        <div class="uc-pod-dx">
          <p class="uc-pod-k">Customer POD</p>
          <h2 class="uc-pod-t">Novanta giorni con il team di prodotto Adobe sui vostri casi</h2>
          <ul class="uc-pod-lista" data-stagger>
            <li class="uc-pod-i">
              <p class="uc-pod-a">Prodotto e ingegneria Adobe</p>
              <p class="uc-pod-r">Lavorano con voi sui casi scelti insieme, dentro il perimetro del programma.</p>
            </li>
            <li class="uc-pod-i">
              <p class="uc-pod-a">Accesso a Coworker per tutto il programma</p>
              <p class="uc-pod-r">Per i novanta giorni, sui casi del programma.</p>
            </li>
            <li class="uc-pod-i">
              <p class="uc-pod-a">Le vostre richieste, al prodotto</p>
              <p class="uc-pod-r"><span class="ex-frase">Il team di prodotto Adobe le riceve e decide che cosa sviluppare.</span> <span class="ex-frase">Nessuna promessa di roadmap.</span></p>
            </li>
          </ul>
          <p class="uc-pod-accordo">I novanta giorni contano dal kickoff.</p>
          <p class="uc-nota">Un programma esclusivo, riservato a pochi clienti Adobe.</p>
        </div>
      </div>
    </Slide>

    {/* ── LA MAPPA: tutto il programma in una pagina, a fasi ─────────────── */}
    <Slide id="slide-mappa" bg="inverse" align="left">
      <div slot="backdrop" class="xd-bg-piano"></div>
      <div class="xd-sl xd-sl--dark uc-sl-largo" data-reveal>
        <div class="xd-sl-head">
          <p class="xd-n">Il programma in una pagina</p>
          <h2 class="xd-h2 uc-mappa-titolo">Si parte da Analytics, e Target entra circa tre settimane dopo</h2>
        </div>
        <Mappa />
      </div>
    </Slide>

  </DeckContainer>
</BaseLayout>
