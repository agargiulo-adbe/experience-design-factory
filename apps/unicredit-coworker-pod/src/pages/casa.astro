---
/**
 * 04 · DA DOVE SI COMINCIA — le tre risposte che servono dal team, con chi
 * le porta («da chiedere» dove non lo sappiamo), la linea del tempo con la
 * prima tappa spuntata, e la slide-firma.
 *
 * La linea del tempo è la STESSA del capitolo 01 (`LineaTempo.astro`, una
 * fonte sola), con `fatte={1}`: la sessione di oggi è la tappa passata.
 *
 * L'ultima slide è la slide-FIRMA, e chiude il PERCORSO: per contratto è una
 * slide a sé. Fallisce il check SOFT `i` di proposito (il lockup è un SVG e il
 * parser non lo conta): non si aggiusta rimpicciolendo.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import CoBrand from '../components/CoBrand.astro';
import Divisore from '../components/Divisore.astro';
import fotoDiv from '../assets/generated/bg/div-comincia.webp';
import LineaTempo from '../components/LineaTempo.astro';
import { href } from '@edf/core/utils/url.js';
import { CHAPTERS, prevSlug } from '../data/chapters';
import { SERVONO, SERVONO_2, CATEGORIE, TEMI_TARGET } from '../data/contenuti';

const SLUG = 'casa';
const ch = CHAPTERS.find((c) => c.slug === SLUG)!;
const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;
---
<BaseLayout title={ch.title}>
  <div class="fixed top-0 left-0 right-0 z-50">
    <Navigation currentPath={currentPath} base={base} />
  </div>

  <DeckContainer nextHref={href(base, '/')} prevHref={href(base, prevSlug(SLUG))}>

    <Slide id="slide-cover" bg="secondary" align="left" data-made-with="Adobe Firefly" data-made-with-for="sfondo">
      <div slot="backdrop" class="xd-div-bg" style={`--foto: url('${fotoDiv.src}')`}></div>
      <Divisore num={ch.num} conFoto titolo={ch.title} punto={ch.punto} />
    </Slide>

    {/* ── Da dove vi piacerebbe partire? (19 nov 2026) ──────────────────
        Le priorità si raccolgono in sala, sullo stesso meccanismo della slide
        di Intesa: un tocco su una domanda le dà il numero successivo, un
        secondo tocco lo toglie e fa scalare le altre. Due gruppi per prodotto,
        con il rimando al capitolo dove se n'è parlato. */}
    <Slide id="slide-priorita" bg="inverse" align="left">
      <div slot="backdrop" class="xd-bg-piano"></div>
      <div class="uc-pri" data-reveal>
        <div class="uc-pri-testa">
          <h2 class="uc-pri-t">Da dove vi piacerebbe partire?</h2>
          <p class="uc-pri-l">Qui ritrovate le domande di oggi. Mettiamole in ordine insieme, partendo da quella che vi serve di più.</p>
        </div>
        {[
          { k: 'Su Analytics', url: '/domanda-1', dove: 'Capitolo 02', g: 'aa', temi: CATEGORIE.map((c) => ({ a: c.a, q: c.chiedi })) },
          { k: 'Da Analytics a Target', url: '/domanda-3', dove: 'Capitolo 03', g: 'tgt', temi: TEMI_TARGET },
        ].map((gr) => (
          <section class="uc-pri-gr" data-g={gr.g} aria-label={gr.k}>
            <div class="uc-pri-riga">
              <h3 class="uc-pri-k">{gr.k}</h3>
              <a class="uc-pri-dove" href={href(base, gr.url)}>Rivedi il {gr.dove.toLowerCase()}</a>
            </div>
            <ol class="uc-pri-tg" role="list" style={`--n:${gr.temi.length}`}>
              {gr.temi.map((x) => (
                <li class="uc-pri-tema">
                  <button type="button" class="uc-pri-b" aria-pressed="false">
                    <span class="uc-pri-ord" aria-hidden="true"></span>
                    <span class="uc-pri-a">{x.a}</span>
                    <span class="uc-pri-q">{x.q}</span>
                  </button>
                </li>
              ))}
            </ol>
          </section>
        ))}
        <p class="uc-pri-aiuto">Un tocco per dare il numero, un secondo per toglierlo.</p>
      </div>
    </Slide>

    {/* ── Per partire, tre risposte dal vostro team ─────────────────────── */}
    <Slide id="slide-servono" bg="inverse" align="left">
      <div slot="backdrop" class="xd-bg-piano"></div>
      <div class="xd-sl xd-sl--dark uc-sl-largo" data-reveal>
        <div class="xd-sl-head">
          <p class="xd-n">Da dove si comincia</p>
          <h2 class="xd-h2 uc-firma-t">Per partire, tre risposte dal vostro team</h2>
        </div>
        <ol class="uc-servono" role="list">
          {SERVONO.map((x, i) => (
            <li class="uc-serve" data-substep={i === 0 ? null : ''}>
              <p class="uc-serve-n" aria-hidden="true">{i + 1}</p>
              <p class="uc-serve-a">{x.a}</p>
              <p class="uc-serve-r">{x.r}</p>
              <p class="uc-serve-chi" data-da-chiedere={x.chi.includes('da chiedere') ? '' : null}>{x.chi}</p>
            </li>
          ))}
        </ol>
      </div>
    </Slide>

    {/* ── Le altre due risposte: la misura, e le persone (panel, 17 nov) ─── */}
    <Slide id="slide-misure" bg="primary" align="left">
      <div slot="backdrop" class="ex-bg-paper"></div>
      <div class="xd-sl uc-sl-largo" data-reveal>
        <div class="xd-sl-head">
          <p class="xd-n">Da dove si comincia</p>
          <h2 class="xd-h2">E due cose da cominciare a definire: la misura e le persone</h2>
        </div>
        <figure class="uc-servono uc-servono--due">
          {SERVONO_2.map((x, i) => (
            <div class="uc-serve" data-substep={i === 0 ? null : ''}>
              <p class="uc-serve-n" aria-hidden="true">{i + 4}</p>
              {i === 0
                ? <svg class="uc-serve-fig" viewBox="0 0 64 40" aria-hidden="true"><path d="M4 36 H60" /><rect x="8" y="22" width="9" height="14" rx="2" /><rect x="24" y="14" width="9" height="22" rx="2" /><rect class="a" x="40" y="6" width="9" height="30" rx="2" /></svg>
                : <svg class="uc-serve-fig" viewBox="0 0 64 40" aria-hidden="true"><circle cx="14" cy="12" r="6" /><path d="M4 36 c0-9 5-14 10-14 s10 5 10 14" /><circle cx="32" cy="12" r="6" /><path d="M22 36 c0-9 5-14 10-14 s10 5 10 14" /><circle class="a" cx="50" cy="12" r="6" /><path class="a" d="M40 36 c0-9 5-14 10-14 s10 5 10 14" /></svg>}
              <p class="uc-serve-a">{x.a}</p>
              <p class="uc-serve-r">{x.r}</p>
              <p class="uc-serve-chi">{x.chi}</p>
            </div>
          ))}
        </figure>
      </div>
    </Slide>

    {/* ── I prossimi passi: la stessa linea, con la prima tappa spuntata ─ */}
    <Slide id="slide-passi" bg="primary" align="left">
      <div slot="backdrop" class="ex-bg-paper"></div>
      <div class="xd-sl uc-sl-largo" data-reveal>
        <div class="xd-sl-head">
          <p class="xd-n">I prossimi step</p>
          <h2 class="xd-h2">Dopo questa sessione, il kickoff su Analytics e poi Target</h2>
        </div>
        <LineaTempo fatte={1} figura={false} />
        <p class="uc-nota">Le date le conferma il team Adobe.</p>
      </div>
    </Slide>

    {/* ── La firma ─────────────────────────────────────────────────────── */}
    <Slide id="slide-signature" bg="inverse" align="center">
      <div slot="backdrop" class="xd-bg-piano"></div>
      <div class="xd-firma" data-reveal>
        <CoBrand variant="hero" class="edf-cobrand--on-dark" />
        <p class="xd-firma-l" data-reveal data-reveal-delay="0.1">Il programma parte dalle priorità che scegliete voi.</p>
        <p class="xd-firma-n" data-reveal data-reveal-delay="0.16">Il Customer POD di Coworker su Adobe Analytics e Adobe Target.</p>
        <a href={href(base, '/')} class="edf-sig-cta" data-reveal data-reveal-delay="0.22">Torna all’inizio</a>
      </div>
    </Slide>
  </DeckContainer>
</BaseLayout>

<script>
  /* L'ORDINE, deciso in sala: ogni tocco dà il numero successivo, un secondo
     tocco lo toglie e fa scalare gli altri. Un solo ordine per tutta la
     tavola, Analytics e Target insieme. Il clic non arriva al deck (che
     altrimenti cambierebbe slide) e il bottone perde il fuoco, così le frecce
     restano al deck. Si ricollega a ogni pagina. */
  function prepara() {
    const slide = document.getElementById('slide-priorita');
    if (!slide || slide.dataset.pronta) return;
    slide.dataset.pronta = '1';
    const bottoni = [...slide.querySelectorAll<HTMLButtonElement>('.uc-pri-b')];
    let ordine: HTMLButtonElement[] = [];
    const scrivi = () => bottoni.forEach((b) => {
      const i = ordine.indexOf(b);
      b.setAttribute('aria-pressed', String(i >= 0));
      b.closest('li')!.toggleAttribute('data-scelto', i >= 0);
      b.querySelector('.uc-pri-ord')!.textContent = i >= 0 ? String(i + 1) : '';
    });
    bottoni.forEach((b) => b.addEventListener('click', (e) => {
      e.stopPropagation();
      ordine = ordine.includes(b) ? ordine.filter((x) => x !== b) : [...ordine, b];
      scrivi(); b.blur();
    }));
  }
  prepara();
  document.addEventListener('astro:page-load', prepara);
</script>
