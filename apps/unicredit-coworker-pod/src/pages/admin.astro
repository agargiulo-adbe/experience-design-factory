---
import BaseLayout from '../layouts/BaseLayout.astro';
import AdminConsole from '@edf/core/blocks/admin/AdminConsole.astro';
import { href } from '@edf/core/utils/url.js';
import { SITE } from '../data/site';

const base = import.meta.env.BASE_URL;
const SUPABASE_URL = import.meta.env.PUBLIC_SUPABASE_URL ?? '';
const SUPABASE_ANON_KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY ?? '';

interface SlideEntry { id: string; label: string; }
interface PageEntry { slug: string; label: string; slides: SlideEntry[]; }

// Ogni slide del deck, pagina per pagina: è ciò che il tab «Capitoli e slide»
// accende e spegne. Ogni <Slide id> nuova va registrata qui.
const PAGE_REGISTRY: PageEntry[] = [
  { slug: 'index', label: 'Da dove partiamo (00)', slides: [
    { id: 'slide-cover', label: 'Copertina e percorso' },
  ]},
  { slug: 'partenza', label: 'Il programma (01)', slides: [
    { id: 'slide-cover',    label: 'Copertina — Il programma' },
    { id: 'slide-pod',      label: 'Il Customer POD di Coworker' },
    { id: 'slide-percorso', label: 'Come ci arriviamo — quattro tappe' },
    { id: 'slide-video',    label: 'Coworker al lavoro, in quattro minuti — la demo' },
  ]},
  { slug: 'domanda-1', label: 'Che cosa chiedereste ai vostri dati? (02)', slides: [
    { id: 'slide-cover',      label: 'Copertina — Adobe Analytics' },
    { id: 'slide-categorie',  label: 'Le sei categorie' },
    { id: 'slide-oggi-1',     label: 'Oggi e con Coworker, 1 di 2' },
    { id: 'slide-oggi-2',     label: 'Oggi e con Coworker, 2 di 2' },
    { id: 'slide-limiti',     label: 'Quello che oggi non promettiamo' },
    { id: 'slide-domanda',    label: 'La domanda per voi' },
  ]},
  { slug: 'domanda-2', label: 'Dove si fermano i vostri test? (03)', slides: [
    { id: 'slide-cover',   label: 'Copertina — Adobe Target' },
    { id: 'slide-momenti', label: 'Quattro momenti di un test' },
    { id: 'slide-domanda', label: 'La domanda per voi' },
  ]},
  { slug: 'domanda-3', label: 'Dal numero al test, e ritorno (04)', slides: [
    { id: 'slide-cover',   label: 'Copertina — Analytics e Target' },
    { id: 'slide-giro',    label: 'Il giro, in cinque passi' },
    { id: 'slide-campo',   label: 'Due casi dal campo' },
    { id: 'slide-domanda', label: 'La domanda per voi' },
  ]},
  { slug: 'casa', label: 'Che cosa portiamo al PM (05)', slides: [
    { id: 'slide-cover',     label: 'Copertina — Che cosa portiamo al PM' },
    { id: 'slide-servono',   label: 'Tre cose che ci servono da voi' },
    { id: 'slide-passi',     label: 'I prossimi passi' },
    { id: 'slide-signature', label: 'La firma — Adobe × UniCredit' },
  ]},
];

interface SolutionEntry {
  id: string; name: string; shortName: string;
  pillar: string; description: string; appearsIn: string[];
}

// Segnaposto: il deck generato non ha slide gated. Sostituire con le soluzioni
// Adobe che l'experience propone davvero (nomi verificati, vedi memoria
// adobe-product-naming-2026) e marcare le slide con `data-solution="<id>"`.
// Le soluzioni che il deck tratta. Nessuna slide è gated: il deck è corto e
// ogni capitolo serve alla sessione; le voci servono alla console per dire
// che cosa c'è dentro.
const SOLUTIONS: SolutionEntry[] = [
  { id: 'coworker', name: 'Adobe CX Enterprise Coworker', shortName: 'Coworker', pillar: 'agenti',
    description: 'Il programma Customer POD e la chat di Coworker sui prodotti dell’organizzazione.', appearsIn: ['Il programma', 'Che cosa portiamo al PM'] },
  { id: 'analytics', name: 'Adobe Analytics', shortName: 'Analytics', pillar: 'dati',
    description: 'Le sei categorie di domande, oggi e con Coworker.', appearsIn: ['Che cosa chiedereste ai vostri dati?', 'Dal numero al test, e ritorno'] },
  { id: 'target', name: 'Adobe Target', shortName: 'Target', pillar: 'dati',
    description: 'I quattro momenti di un test, con le skill di Coworker per Target.', appearsIn: ['Dove si fermano i vostri test?', 'Dal numero al test, e ritorno'] },
];

const PILLAR_LABELS: Record<string, string> = { agenti: 'Agenti', dati: 'Analisi e test' };
const PILLAR_ORDER = ['agenti', 'dati'];
const PILLAR_COLORS: Record<string, string> = { agenti: '#006375', dati: '#007a91' };

const solutionGroups = PILLAR_ORDER
  .map((pillar) => ({ pillar, label: PILLAR_LABELS[pillar], color: PILLAR_COLORS[pillar], solutions: SOLUTIONS.filter((s) => s.pillar === pillar) }))
  .filter((g) => g.solutions.length > 0);

const allSolutionIds = SOLUTIONS.map((s) => s.id);
const deckHref = href(base, '/');
// I dossier interni di questa experience, se ne ha: la console è il posto dove
// chi presenta trova il deck e il documento che prepara la stanza. Quando nasce
// un `dossier.astro`, si aggiunge qui — restano gated, il link non li apre.
const DOSSIERS: { href: string; label?: string }[] = [
  // { href: href(base, '/dossier'), label: 'Dossier interno' },
];
---
<BaseLayout title={`Console — ${SITE.name} · ${SITE.client}`}>
  <AdminConsole
    projectSlug={SITE.slug}
    projectName={SITE.name}
    clientLabel={`Adobe × ${SITE.client}`}
    deckHref={deckHref}
    dossiers={DOSSIERS}
    pages={PAGE_REGISTRY}
    solutionGroups={solutionGroups}
    allSolutionIds={allSolutionIds}
    supabaseUrl={SUPABASE_URL}
    supabaseAnonKey={SUPABASE_ANON_KEY}
  />
</BaseLayout>
