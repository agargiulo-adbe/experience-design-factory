---
import BaseLayout from '../layouts/BaseLayout.astro';
import SdNavigation from '../components/SdNavigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import CoBrand from '../components/CoBrand.astro';
import T from '@edf/core/blocks/i18n/T.astro';
import { href } from '@edf/core/utils/url.js';
import { CHAPTERS, QUESTIONS } from '../data/chapters';
import { SOURCES } from '../data/sources';
import LoopVideo from '@edf/core/blocks/immersive/LoopVideo.astro';
import { EXPERIENCE_TYPES } from '@edf/core/data/experienceTypes';
// Tipo di deliverable (tassonomia Factory, 1 ott 2026): la copertina lo rende da experienceTypes.ts.
const TYPE = 'playbook' as const;
// Clip Firefly Video Model (5 s, ricucita con `pnpm loop:seamless`): MP4 sul Release `media`, poster qui.
const COVER_VIDEO = 'https://github.com/agargiulo-adbe/experience-design-factory/releases/download/media/sd-cover.loop.mp4';
import bgNumeri from '../assets/generated/bg/carta-1.webp';
import bgPain from '../assets/generated/bg/carta-2.webp';
import bgPercorso from '../assets/generated/bg/notte-4.webp';

const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;

// Dati del cliente (dashboard di utilizzo Adobe Analytics, gen 2023 → set 2026):
// nessun commit, nessun euro. Il pubblico è l'Admin: sono i suoi numeri.
const numeri = [
  { v: '18,2 mln', l: { it: 'utenti dell’App Poste Italiane', en: 'Poste Italiane App users' }, s: { it: 'oltre 18 milioni · TG Poste, 23 set 2026', en: 'past 18 million · TG Poste, 23 Sep 2026' }, tone: '' },
  { v: '99%', l: { it: 'delle chiamate da una sola report suite', en: 'of server calls from one report suite' }, s: { it: 'la SuperApp è il canale che misurate', en: 'the SuperApp is the channel you measure' }, tone: '' },
  { v: '9 su 10', l: { it: 'chiamate dal mobile', en: 'calls from mobile' }, s: { it: 'anche il web di poste.it finisce nella stessa suite', en: 'poste.it’s web traffic lands in the same suite too' }, tone: '' },
  { v: '+50%', l: { it: 'di volume in tre anni', en: 'volume growth in three years' }, s: { it: 'server call, media mensile 2023 → 2026', en: 'server calls, monthly average 2023 → 2026' }, tone: '' },
];
---
<BaseLayout title="Sei domande · Adobe × Poste Italiane" preloadImage={`${base.replace(/\/?$/, "/")}media/sd-cover.poster.jpg`}>
  <div class="fixed top-0 left-0 right-0 z-50">
    <SdNavigation currentPath={currentPath} base={base} />
  </div>

  <DeckContainer nextHref={href(base, '/' + CHAPTERS[0].slug)}>

    <!-- ── 0 · Cover ─────────────────────────────────────────────────────── -->
    <Slide id="slide-cover" bg="inverse" align="center" data-made-with="Firefly" data-made-with-for="clip">
      <LoopVideo slot="backdrop" src={COVER_VIDEO} poster={`${base.replace(/\/?$/, '/')}media/sd-cover.poster.jpg`} scrim="sd-scrim-notte" opacity={1} />
      <div class="sd-cover" data-reveal>
        <CoBrand variant="hero" class="sd-cover-lockup" data-reveal />
        <T as="h1" class="sd-cover-title" it="Sei domande" en="Six questions" data-reveal data-reveal-delay="0.1" />
        <T
          as="p"
          class="sd-cover-tag"
          it="Le domande che il business fa al monitoraggio dei canali digitali ogni settimana. E come si risponde da ottobre, dentro Adobe Analytics."
          en="The questions the business asks digital-channel monitoring every week. And how they get answered from October, inside Adobe Analytics."
          data-reveal data-reveal-delay="0.16"
        />
        <T
          as="p"
          class="sd-cover-lead"
          it="Adobe CX Enterprise Coworker legge le vostre report suite con i permessi Analytics, più uno, risponde in linguaggio naturale e il risultato si riprende in Analysis Workspace. I dati restano dove sono: per Analytics non serve nessuna licenza in più. Adobe mette dei crediti per la prova: vederlo all’opera non costa nulla. Che cosa serve per tenerlo ve lo scriviamo prima. Sei domande, una per capitolo, ognuna con l’oggi e il dopo."
          en="Adobe CX Enterprise Coworker reads your report suites with the Analytics permissions, plus one, answers in plain language, and the result is picked up in Analysis Workspace. Data stays put: Analytics needs no extra licence. Adobe provides credits for the trial: seeing it at work costs nothing. What it takes to keep it, we put in writing first. Six questions, one per chapter, each with the before and the after."
          data-reveal data-reveal-delay="0.22"
        />
        <T
          as="p"
          class="sd-cover-note"
          it={`${EXPERIENCE_TYPES[TYPE].coverLine.it} · fonti pubbliche citate slide per slide · dati delle demo illustrativi · sfondi e clip generati con Adobe Firefly, firmati con Content Credentials`}
          en={`${EXPERIENCE_TYPES[TYPE].coverLine.en} · public sources cited slide by slide · demo data illustrative · backdrops and clips generated with Adobe Firefly, signed with Content Credentials`}
          data-reveal data-reveal-delay="0.3"
        />
      </div>
    </Slide>

    <!-- ── 1 · Il vostro tracciamento ────────────────────────────────────── -->
    <Slide id="slide-numeri" bg="primary" align="center">
      <div slot="backdrop" class="sd-bg-carta" style={`--bg-src: url(${bgNumeri.src})`}></div>
      <div class="sd-head" data-reveal>
        <T as="p" class="slide-eyebrow mb-3" it="Il punto di partenza" en="Where we start" />
        <T as="h2" class="sd-head-title" it="Un’app che è diventata il canale" en="An app that became the channel" />
        <T
          as="p"
          class="sd-head-lead"
          it="L’App Poste Italiane ha superato i 18 milioni di utenti e i dati di utilizzo della vostra istanza di Adobe Analytics lo raccontano da soli: una report suite raccoglie quasi tutto, il mobile fa nove chiamate su dieci, il volume è cresciuto di metà in tre anni. Chi monitora questo canale riceve domande ogni giorno, e viene giudicato su quanto ci mette a rispondere."
          en="The Poste Italiane App has passed 18 million users, and your Adobe Analytics usage data tells the story on its own: one report suite collects almost everything, mobile makes nine calls out of ten, volume has grown by half in three years. Whoever monitors this channel gets questions every day, and is judged on how long the answer takes."
        />
      </div>
      <div class="sd-figures" data-reveal data-reveal-delay="0.16">
        {numeri.map((n) => (
          <div class="sd-figure">
            <p class:list={['sd-figure-v', n.tone === 'giallo' && 'sd-figure-v--giallo']}>{n.v}</p>
            <T as="p" class="sd-figure-l" it={n.l.it} en={n.l.en} />
            <T as="p" class="sd-figure-s" it={n.s.it} en={n.s.en} />
          </div>
        ))}
      </div>
      <p class="sd-src" data-reveal data-reveal-delay="0.26">
        <span data-lang-it>Fonti:&nbsp;</span><span data-lang-en>Sources:&nbsp;</span>
        <a href={SOURCES.posteApp.url} target="_blank" rel="noopener noreferrer"><span data-lang-it>{SOURCES.posteApp.label.it}</span><span data-lang-en>{SOURCES.posteApp.label.en}</span></a>
        &nbsp;·&nbsp;<span data-lang-it>volumi: dati di utilizzo della vostra istanza Adobe Analytics, gen 2023 – set 2026, da confermare con l’Admin</span><span data-lang-en>volumes: usage data of your Adobe Analytics instance, Jan 2023 – Sep 2026, to be confirmed with the Admin</span>
      </p>
    </Slide>

    <!-- ── 2 · Le domande aperte ─────────────────────────────────────────── -->
    <Slide id="slide-pain" bg="secondary" align="center">
      <div slot="backdrop" class="sd-bg-azzurro" style={`--bg-src: url(${bgPain.src})`}></div>
      <div class="sd-head" data-reveal>
        <T as="p" class="slide-eyebrow mb-3" it="Quello che ci avete detto" en="What you told us" />
        <T as="h2" class="sd-head-title" it="Due criteri del 2024, ancora aperti" en="Two criteria from 2024, still open" />
      </div>
      <div class="sd-split sd-split--even" data-reveal data-reveal-delay="0.14">
        <div class="sd-panel sd-panel--blu">
          <div class="sd-panel-head"><T as="span" class="sd-tag" it="Due dei criteri di successo che avete approvato nel 2024" en="Two of the success criteria you approved in 2024" /></div>
          <ul class="sd-ul">
            <li class="sd-li"><span class="sd-dot"></span><T as="span" it="<strong>«Ridurre il tempo dalla richiesta di analisi alla consegna dell’insight.»</strong> Nel 2024 passavano giorni: una richiesta, un progetto Workspace, una verifica, una slide." en="<strong>“Reduce the time from analysis request to insight delivery.”</strong> In 2024 it took days: a request, a Workspace project, a check, a slide." /></li>
            <li class="sd-li"><span class="sd-dot"></span><T as="span" it="<strong>«Facilità d’uso: un’interfaccia semplice per analizzare i dati.»</strong> Semplice vuol dire che chi ha la domanda se la risponde da sé. Oggi passa da chi sa costruire l’analisi, e ogni analisi ha una coda." en="<strong>“Ease of use: a user-friendly interface for data analysis.”</strong> Friendly means the person with the question can answer it themselves. Today it goes through whoever can build the analysis, and every analysis has a queue." /></li>
          </ul>
        </div>
        <div class="sd-panel sd-panel--grigio">
          <div class="sd-panel-head"><T as="span" class="sd-tag sd-tag--grigio" it="Quello che pesa ogni giorno" en="What weighs every day" /></div>
          <ul class="sd-ul">
            <li class="sd-li"><span class="sd-dot sd-dot--grigio"></span><T as="span" it="<strong>Il tracciamento passa dall’IT.</strong> Ogni modifica ha i suoi tempi: questo deck non li tocca, lavora su ciò che Analytics riceve già." en="<strong>Tracking goes through IT.</strong> Every change has its lead time: this deck does not touch it, it works on what Analytics already receives." /></li>
            <li class="sd-li"><span class="sd-dot sd-dot--grigio"></span><T as="span" it="<strong>Le dashboard costano.</strong> Crearle e tenerle vive è lavoro di analista, non scala verso il business." en="<strong>Dashboards cost.</strong> Building and maintaining them is analyst work, it does not scale to the business." /></li>
            <li class="sd-li"><span class="sd-dot sd-dot--grigio"></span><T as="span" it="<strong>I numeri arrivano puntuali; le decisioni, molto meno.</strong> Fra la raccolta e l’azione c’è uno spazio che nessuno presidia." en="<strong>The numbers come in on time; the decisions, far less.</strong> Between collection and action there is a gap nobody owns." /></li>
          </ul>
        </div>
      </div>
      <T as="p" class="sd-src sd-src--center" it="Criteri di successo del PoC 2024 e conversazioni Adobe × Poste Italiane 2024–2026. Questo deck risponde ai due criteri dentro Analytics, per i dati che Analytics già riceve, senza toccare lo stack." en="Success criteria of the 2024 PoC and Adobe × Poste Italiane conversations 2024–2026. This deck answers the two criteria inside Analytics, for the data Analytics already receives, without touching the stack." data-reveal data-reveal-delay="0.24" />
    </Slide>

    <!-- ── 3 · Il percorso ───────────────────────────────────────────────── -->
    <Slide id="slide-percorso" bg="inverse" align="center">
      <div slot="backdrop" class="sd-bg-notte" style={`--bg-src: url(${bgPercorso.src})`}></div>
      <T as="p" class="slide-eyebrow text-center mb-3 sd-on-dark" it="Il percorso" en="The path" data-reveal />
      <T as="h2" class="sd-percorso-title" it="Sei capitoli, sei domande" en="Six chapters, six questions" data-reveal data-reveal-delay="0.08" data-edf-chapters />
      <T
        as="p"
        class="sd-percorso-lead"
        it="Ogni capitolo parte da una domanda che il team riceve davvero. Prima come si risponde oggi, in Workspace. Poi come risponde Coworker. In chiusura, cosa cambia per chi fa il lavoro."
        en="Each chapter starts from a question the team really gets. First how it is answered today, in Workspace. Then how Coworker answers. At the end, what changes for the people doing the work."
        data-reveal data-reveal-delay="0.15"
      />
      <div class="w-full max-w-6xl mx-auto grid grid-cols-3 auto-rows-fr gap-3 mb-5" data-reveal data-reveal-delay="0.22">
        {QUESTIONS.map((c, qi) => (
          <a href={href(base, '/' + c.slug)} data-edf-journey-card class="sd-journey-card h-full px-5 py-4 text-left no-underline group">
            <p class="text-xs font-semibold text-[var(--color-grigio-600)] mb-1 tabular-nums" data-edf-cardnum>{String(qi + 1).padStart(2, '0')}</p>
            <p class="text-[1.1rem] font-bold text-[var(--ink-primary)] mb-1 block"><span data-lang-it>{c.label.it}</span><span data-lang-en>{c.label.en}</span></p>
            <p class="text-[0.92rem] text-[var(--color-grigio-600)] block"><span data-lang-it>{c.question.it}</span><span data-lang-en>{c.question.en}</span></p>
          </a>
        ))}
      </div>
      <div data-reveal data-reveal-delay="0.35" class="text-center">
        <a href={href(base, '/' + CHAPTERS[0].slug)} class="sd-cta">
          <span data-lang-it>Prima domanda</span><span data-lang-en>First question</span>
          <svg width="20" height="20" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>
    </Slide>

  </DeckContainer>

  <style>
    .sd-cover { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 1.05rem; width: 100%; max-width: 62rem; margin-inline: auto; }
    .sd-cover-lockup { margin-bottom: clamp(1.4rem, 3vh, 2.6rem); }
    .sd-cover-title { font-family: var(--font-display); font-weight: 800; font-size: clamp(3rem, 7vw, 6.2rem); line-height: 0.98; letter-spacing: -0.04em; color: #fff; margin: 0; }
    :global(.sd-cover-tag) { font-weight: 500; font-size: clamp(1.1rem, 1.6vw, 1.55rem); line-height: 1.35; color: var(--color-giallo); max-width: 40ch; margin: 0 auto; display: block; }
    :global(.sd-cover-lead) { font-size: clamp(1rem, 1.2vw, 1.15rem); line-height: 1.6; color: var(--color-grigio-200); max-width: 66ch; margin: 0 auto; display: block; }
    :global(.sd-cover-note) { font-size: 0.76rem; letter-spacing: 0.1em; text-transform: uppercase; line-height: 1.7; color: var(--color-grigio-400); max-width: 70ch; margin: 0 auto; display: block; }
    :global(.sd-percorso-title) { font-family: var(--font-display); font-weight: 800; font-size: clamp(1.9rem, 3.2vw, 2.8rem); line-height: 1.06; letter-spacing: -0.03em; color: #fff; text-align: center; margin: 0 auto 0.8rem; display: block; }
    :global(.sd-percorso-lead) { font-size: clamp(0.95rem, 1.1vw, 1.08rem); line-height: 1.55; color: var(--color-grigio-200); max-width: 64ch; margin: 0 auto 1.2rem; text-align: center; display: block; }
    .sd-cta {
      display: inline-flex; align-items: center; gap: 0.75rem; padding: 0.7rem 2.1rem; border-radius: 6px;
      font-size: clamp(1rem, 1.15vw, 1.12rem); font-weight: 600; letter-spacing: 0.02em; text-decoration: none;
      background: var(--color-giallo); color: var(--color-inchiostro); transition: background 200ms ease;
    }
    .sd-cta:hover { background: #fff; color: var(--color-inchiostro); }
  </style>
</BaseLayout>
