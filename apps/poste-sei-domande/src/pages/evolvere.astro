---
import BaseLayout from '../layouts/BaseLayout.astro';
import SdNavigation from '../components/SdNavigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import CoBrand from '../components/CoBrand.astro';
import T from '@edf/core/blocks/i18n/T.astro';
import { href } from '@edf/core/utils/url.js';
import { CHAPTERS, prevSlug } from '../data/chapters';
import { SOURCES } from '../data/sources';
import bgCover from '../assets/generated/bg/notte-6.webp';
import bgEvo from '../assets/generated/bg/carta-4.webp';
import bgPilota from '../assets/generated/bg/carta-1.webp';
import bgChiusura from '../assets/generated/bg/notte-2.webp';
import LoopVideo from '@edf/core/blocks/immersive/LoopVideo.astro';
// Clip Firefly Video Model (5 s, ricucita): MP4 sul Release `media`, poster in public/media.
const FIRMA_VIDEO = 'https://github.com/agargiulo-adbe/experience-design-factory/releases/download/media/sd-firma.loop.mp4';

const SLUG = 'evolvere';
const ch = CHAPTERS.find((c) => c.slug === SLUG)!;
const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;

const evolutive = [
  {
    k: { it: 'Il Workspace che si scrive da sé', en: 'The Workspace that writes itself' },
    tag: { it: 'Tua · dal 2 ottobre', en: 'Yours · from 2 October' },
    b: { it: 'Ogni analisi fatta in chat si apre in Analysis Workspace per continuare a mano. Le skill del team generano i progetti ricorrenti. È la parte di Coworker più vicina al vostro lavoro, ed è tutta dentro Analytics.', en: 'Every analysis done in chat opens in Analysis Workspace to continue by hand. The team’s skills generate the recurring projects. It is the part of Coworker closest to your daily work, and it all sits inside Analytics.' },
    tone: 'giallo',
  },
  {
    k: { it: 'Le domande del business', en: 'The business questions' },
    tag: { it: 'Tua, con chi fa campagne', en: 'Yours, with the campaign side' },
    b: { it: 'Operazioni concluse e abbandonate per prodotto dalle pagine di conferma già tracciate (bollettino, ricarica, bonifico, postagiro), ricariche dopo una push contro un martedì senza (se l’apertura della push è tracciata), dove si perde il cliente fra la sezione e la conferma. Sono le domande che il business fa a voi: dalla settimana cinque, con una skill scritta insieme, le può fare a Coworker.', en: 'Operations completed and abandoned by product from the confirmation pages already tracked (payment slip, top-up, transfer, postagiro), top-ups after a push against a Tuesday without one (if the push open is tracked), where the customer is lost between the section and the confirmation. These are the questions the business asks you: from week five, with a skill written together, it can ask Coworker.' },
    tone: '',
  },
  {
    k: { it: 'Altre integrazioni di Coworker', en: 'Other Coworker integrations' },
    tag: { it: 'Fuori da questo pilota', en: 'Outside this pilot' },
    b: { it: 'Coworker parla anche con altre applicazioni Adobe, e lo stesso server MCP si collega a client di terzi: nel pilota MCP Access serve solo a Coworker. Ognuna è una valutazione a sé, con chi governa i dati e con il Comitato IA, e non è oggetto di questo deck.', en: 'Coworker also talks to other Adobe applications, and the same MCP server connects to third-party clients: in the pilot MCP Access serves Coworker only. Each is a separate assessment, with whoever governs the data and with the AI Committee, and not the subject of this deck.' },
    tone: 'grigio',
  },
  {
    k: { it: 'Il tracciamento', en: 'Tracking' },
    tag: { it: 'Fuori perimetro, oggi', en: 'Out of scope, today' },
    b: { it: 'Le novità di Analytics che chiedono un cambio al tracciamento passano dal Web SDK e dall’SDK mobile. Non è la domanda di oggi: si riapre quando la SuperApp avrà un rilascio del tracciamento in agenda.', en: 'The Analytics features that need a tracking change go through the Web SDK and the mobile SDK. Not today’s question: it reopens when the SuperApp has a tracking release on the agenda.' },
    tone: 'grigio',
  },
];

const pilota = [
  { t: { it: 'Settimana 0 · Autorizzare e misurare', en: 'Week 0 · Authorise and measure' }, b: { it: 'Verifica interna e attivazione ad Adobe, scheda per il Comitato IA e il DPO (DPIA se la chiede), inventario delle variabili con identificativi: dura quanto serve. Intanto il team conta le domande che riceve e il tempo mediano di risposta: la baseline.', en: 'Internal check and enablement with Adobe, file for the AI Committee and the DPO (DPIA if requested), inventory of variables carrying identifiers: it takes as long as it takes. Meanwhile the team counts the questions it receives and the median time to answer: the baseline.' } },
  { t: { it: 'Settimana 1 · Accendere', en: 'Week 1 · Switch on' }, b: { it: 'Parte dalla conferma scritta. MCP Access a tre persone nominate, test negativo sui permessi, prime domande in italiano con i nomi dei vostri componenti sulla suite di sviluppo.', en: 'Starts from the written confirmation. MCP Access for three named people, a negative test on permissions, first questions in Italian with your component names on the development suite.' } },
  { t: { it: 'Settimane 2–3 · Le domande', en: 'Weeks 2–3 · The questions' }, b: { it: 'Le tre domande del deck sulla suite di produzione, più tre vostre, una scritta da chi fa campagne digitali. Ogni risposta riaperta in Workspace e confrontata col report certificato.', en: 'The deck’s three questions on the production suite, plus three of yours, one written by the digital campaign side. Every answer reopened in Workspace and compared with the certified report.' } },
  { t: { it: 'Settimana 4 · Decidere', en: 'Week 4 · Decide' }, b: { it: 'Tempo mediano alla risposta contro la baseline, risposte che tornano entro la tolleranza concordata col report certificato, domande chiuse senza il team. Costo di Coworker dopo i crediti sul tavolo. Poi si apre al business con due skill vostre, o ci si ferma.', en: 'Median time to answer against the baseline, answers matching the certified report within the agreed tolerance, questions closed without the team. Coworker’s cost after the credits on the table. Then open up to the business with two skills of yours, or stop.' } },
];
---
<BaseLayout title={ch.label.it} preloadImage={bgCover.src}>
  <div class="fixed top-0 left-0 right-0 z-50">
    <SdNavigation currentPath={currentPath} base={base} />
  </div>

  <DeckContainer nextHref={href(base, '/')} prevHref={href(base, prevSlug(SLUG))}>

    <!-- ── Cover ─────────────────────────────────────────────────────────── -->
    <Slide id="slide-cover" bg="inverse" align="center">
      <div slot="backdrop" class="sd-bg-notte" style={`--bg-src: url(${bgCover.src})`}></div>
      <div class="sd-q" data-reveal>
        <p class="sd-q-num"><span data-lang-it>Domanda {ch.num} · {ch.label.it}</span><span data-lang-en>Question {ch.num} · {ch.label.en}</span></p>
        <span class="sd-q-mark" aria-hidden="true"></span>
        <T as="h2" class="sd-q-title" it={`«${ch.question.it}»`} en={`“${ch.question.en}”`} data-reveal data-reveal-delay="0.08" />
        <T
          as="p"
          class="sd-q-lead"
          it="Le prime cinque domande stanno nel perimetro del monitoraggio e si chiudono senza cambiare nulla. La sesta guarda avanti: due cose tue, una del business con te, due fuori perimetro. Ognuna detta per quello che è."
          en="The first five questions sit inside monitoring’s remit and close without changing anything. The sixth looks ahead: two things that are yours, one the business shares with you, two out of scope. Each one called what it is."
          data-reveal data-reveal-delay="0.15"
        />
      </div>
    </Slide>

    <!-- ── Le quattro evolutive ──────────────────────────────────────────── -->
    <Slide id="slide-evolutive" bg="primary" align="center">
      <div slot="backdrop" class="sd-bg-carta" style={`--bg-src: url(${bgEvo.src})`}></div>
      <div class="sd-head" data-reveal>
        <T as="p" class="slide-eyebrow mb-3" it="E domani" en="And tomorrow" />
        <T as="h2" class="sd-head-title" it="Quattro evolutive, ognuna con chi decide" en="Four next steps, each with who decides" />
      </div>
      <div class="sd-steps sd-steps--2" data-reveal data-reveal-delay="0.14">
        {evolutive.map((e) => (
          <div class:list={['sd-panel', e.tone === 'giallo' ? 'sd-panel--giallo' : e.tone === 'grigio' ? 'sd-panel--grigio' : 'sd-panel--blu']}>
            <div class="sd-panel-head">
              <T as="span" class="sd-step-title mb-0" it={e.k.it} en={e.k.en} />
              <T as="span" class:list={['sd-tag whitespace-nowrap', e.tone === 'giallo' && 'sd-tag--giallo', e.tone === 'grigio' && 'sd-tag--grigio']} it={e.tag.it} en={e.tag.en} />
            </div>
            <T as="p" class="sd-panel-body" it={e.b.it} en={e.b.en} />
          </div>
        ))}
      </div>
      <p class="sd-src" data-reveal data-reveal-delay="0.24">
        <span data-lang-it>Fonti:&nbsp;</span><span data-lang-en>Sources:&nbsp;</span>
        <a href={SOURCES.aaRelease.url} target="_blank" rel="noopener noreferrer"><span data-lang-it>{SOURCES.aaRelease.label.it}</span><span data-lang-en>{SOURCES.aaRelease.label.en}</span></a>
        &nbsp;·&nbsp;<a href={SOURCES.mcpDocs.url} target="_blank" rel="noopener noreferrer"><span data-lang-it>{SOURCES.mcpDocs.label.it}</span><span data-lang-en>{SOURCES.mcpDocs.label.en}</span></a>
      </p>
    </Slide>

    <!-- ── Il pilota ─────────────────────────────────────────────────────── -->
    <Slide id="slide-pilota" bg="secondary" align="center">
      <div slot="backdrop" class="sd-bg-azzurro" style={`--bg-src: url(${bgPilota.src})`}></div>
      <div class="sd-head" data-reveal>
        <T as="p" class="slide-eyebrow mb-3" it="Quello che proponiamo" en="What we propose" />
        <T as="h2" class="sd-head-title" it="Una settimana zero, quattro settimane, poi si decide" en="A week zero, four weeks, then you decide" />
        <T
          as="p"
          class="sd-head-lead"
          it="Niente da firmare, niente da installare. Un pilota sul vostro Analytics, con il vostro team e le vostre domande, misurato su tre cose: quanto prima arriva la risposta, se i numeri tornano, quante domande si chiudono senza il team."
          en="Nothing to sign, nothing to install. A pilot on your Analytics, with your team and your questions, measured on three things: how much sooner the answer arrives, whether the numbers match, how many questions get closed without the team."
        />
      </div>
      <div class="sd-steps" data-reveal data-reveal-delay="0.14">
        {pilota.map((p, i) => (
          <div class="sd-step">
            <span class:list={['sd-step-n', i === 3 && 'sd-step-n--giallo']}>{i}</span>
            <T as="p" class="sd-step-title" it={p.t.it} en={p.t.en} />
            <T as="p" class="sd-step-body" it={p.b.it} en={p.b.en} />
          </div>
        ))}
      </div>
      <T as="p" class="sd-src" it="Da parte nostra: la richiesta di attivazione ad Adobe, un pomeriggio insieme per le prime skill, la demo sull’organizzazione dimostrativa Adobe prima di toccare la vostra." en="On our side: the enablement request to Adobe, an afternoon together for the first skills, the demo on Adobe’s demo organisation before touching yours." data-reveal data-reveal-delay="0.24" />
    </Slide>

    <!-- ── Chiusura ──────────────────────────────────────────────────────── -->
    <Slide id="slide-chiusura" bg="inverse" align="center">
      <div slot="backdrop" class="sd-bg-notte" style={`--bg-src: url(${bgChiusura.src})`}></div>
      <div class="sd-take" data-reveal>
        <T as="p" class="slide-eyebrow mb-3 sd-on-dark" it="Per chiudere" en="To close" />
        <T as="h2" class="sd-take-title" it="Le risposte erano già lì. Cambia chi le può chiedere." en="The answers were already there. What changes is who can ask." />
        <div class="sd-take-grid" data-reveal data-reveal-delay="0.14">
          <div class="sd-take-item">
            <T as="p" class="sd-take-k" it="I due criteri del 2024" en="The two 2024 criteria" />
            <T as="p" class="sd-take-t" it="Il tempo alla risposta e l’indipendenza dal team: <strong>sono le due cose che questo cambia</strong>, senza toccare lo stack." en="Time to answer and independence from the team: <strong>those are the two things this changes</strong>, without touching the stack." />
          </div>
          <div class="sd-take-item">
            <T as="p" class="sd-take-k" it="Il ruolo del team" en="The team’s role" />
            <T as="p" class="sd-take-t" it="Da chi costruisce ogni risposta a chi <strong>scrive le regole</strong> con cui le risposte si costruiscono da sole, e a chi le porta al tavolo del lunedì con chi fa campagne." en="From building every answer to <strong>writing the rules</strong> by which answers build themselves, and bringing them to the Monday table with the campaign side." />
          </div>
          <div class="sd-take-item">
            <T as="p" class="sd-take-k" it="Il prossimo passo" en="The next step" />
            <T as="p" class="sd-take-t" it="La scheda per il Comitato IA e una data per la suite di sviluppo. <strong>Il resto lo decidono i numeri</strong> della settimana quattro." en="The file for the AI Committee and a date for the development suite. <strong>The numbers of week four</strong> decide the rest." />
          </div>
        </div>
      </div>
    </Slide>

    <!-- ── Firma ─────────────────────────────────────────────────────────── -->
    <Slide id="slide-signature" bg="inverse" align="center" data-made-with="Firefly" data-made-with-for="clip">
      <LoopVideo slot="backdrop" src={FIRMA_VIDEO} poster={`${base.replace(/\/?$/, '/')}media/sd-firma.poster.jpg`} scrim="sd-scrim-giallo" opacity={1} />
      <CoBrand variant="hero" data-reveal />
      <T as="p" class="sd-sig-line" it="Sei domande. Le risposte, da ottobre, dentro Adobe Analytics." en="Six questions. The answers, from October, inside Adobe Analytics." data-reveal data-reveal-delay="0.1" />
      <a href={href(base, '/')} class="edf-sig-cta" data-reveal data-reveal-delay="0.18"><span data-lang-it>Torna all’inizio →</span><span data-lang-en>Back to the start →</span></a>
    </Slide>

  </DeckContainer>

  <style>
    :global(.sd-sig-line) { margin-top: clamp(1.4rem, 3vh, 2.4rem); font-size: clamp(1.05rem, 1.4vw, 1.35rem); line-height: 1.5; color: var(--color-grigio-200); text-align: center; max-width: 44ch; display: block; margin-inline: auto; }
  </style>
</BaseLayout>
