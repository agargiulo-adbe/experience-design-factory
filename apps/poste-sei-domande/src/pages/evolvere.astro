---
import BaseLayout from '../layouts/BaseLayout.astro';
import SdNavigation from '../components/SdNavigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import CoBrand from '../components/CoBrand.astro';
import T from '@edf/core/blocks/i18n/T.astro';
import { href } from '@edf/core/utils/url.js';
import { CHAPTERS, prevSlug } from '../data/chapters';
import { SOURCES } from '../data/sources';
import bgCover from '../assets/generated/bg/notte-6.webp';
import bgAvvio from '../assets/generated/bg/carta-1.webp';
import bgChi from '../assets/generated/bg/carta-2.webp';
import bgNoi from '../assets/generated/bg/carta-3.webp';
import bgEvo from '../assets/generated/bg/carta-4.webp';
import bgChiusura from '../assets/generated/bg/notte-2.webp';
import LoopVideo from '@edf/core/blocks/immersive/LoopVideo.astro';
// Clip Firefly Video Model (5 s, ricucita): MP4 sul Release `media`, poster in public/media.
const FIRMA_VIDEO = 'https://github.com/agargiulo-adbe/experience-design-factory/releases/download/media/sd-firma.loop.mp4';

const SLUG = 'evolvere';
const ch = CHAPTERS.find((c) => c.slug === SLUG)!;
const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;

// Come si parte. Nessun numero di settimana: questa è una prima sessione di
// introduzione, e il calendario lo detta l'istruttoria che apre Poste.
const avvio = [
  {
    t: { it: 'Si accende', en: 'Switch it on' },
    b: {
      it: 'La richiesta di attivazione della vostra IMS org la facciamo noi: siete fra i primi gruppi, si parla di giorni. Da lì gli accessi ve li date voi in Admin Console — <code>MCP Access</code> su un profilo dedicato, poche persone nominate — e i crediti di prova sono già lì.',
      en: 'We file the request to enable your IMS org: you are in the first groups, a matter of days. From there you grant access yourself in Admin Console — <code>MCP Access</code> on a dedicated profile, a few named people — and the trial credits are already there.',
    },
  },
  {
    t: { it: 'Si misura il prima', en: 'Measure the before' },
    b: {
      it: 'Il team conta le domande che riceve e il tempo con cui risponde oggi. È la riga più noiosa e la più importante: senza, alla fine la decisione torna a essere un’impressione.',
      en: 'The team counts the questions it receives and how long it takes to answer today. The dullest line and the most important: without it, the decision at the end goes back to being an impression.',
    },
  },
  {
    t: { it: 'Si prova sulle vostre domande', en: 'Try it on your questions' },
    b: {
      it: 'Le domande di questo deck, più le vostre: in cima la verifica di un rilascio, con i requisiti di tracciamento caricati come skill. Ogni risposta si riapre in Analysis Workspace e si confronta con il report certificato: se i numeri tornano, il metodo regge.',
      en: 'The questions in this deck, plus yours: first among them checking a release, with the tracking requirements loaded as a skill. Every answer is reopened in Analysis Workspace and checked against the certified report: if the numbers match, the method holds.',
    },
  },
  {
    t: { it: 'Si decide', en: 'Decide' },
    b: {
      it: 'Tempo alla risposta contro il prima, risposte che tornano, domande chiuse senza il team. E un quarto numero, quello che serve per decidere sul serio: <strong>quanto ha consumato</strong>. Se i conti tornano si allarga; se non tornano ci si ferma, e si è speso solo il tempo.',
      en: 'Time to answer against the before, answers that match, questions closed without the team. And a fourth number, the one you actually decide on: <strong>how much it consumed</strong>. If it adds up you widen; if it does not you stop, having spent only time.',
    },
  },
];

// Chi serve al tavolo. L'ordine non è gerarchico: è l'ordine in cui entrano.
const chi = [
  {
    k: { it: 'Il team di monitoraggio', en: 'The monitoring team' },
    b: {
      it: 'Possiede le report suite e le convenzioni con cui si leggono. Prova le domande per primo e scrive le prime skill: il suo mestiere, messo per iscritto una volta sola.',
      en: 'Owns the report suites and the conventions for reading them. Tries the questions first and writes the first skills: its craft, written down once.',
    },
  },
  {
    k: { it: 'L’Admin di Adobe Analytics', en: 'The Adobe Analytics Admin' },
    b: {
      it: 'Dà <code>MCP Access</code> sul profilo di prodotto e decide quali report suite si vedono. È il freno a mano, e resta in mano vostra per tutta la prova.',
      en: 'Grants <code>MCP Access</code> on the product profile and decides which report suites are visible. The handbrake, and it stays in your hands throughout.',
    },
  },
  {
    k: { it: 'Chi fa campagne digitali', en: 'The digital campaign side' },
    b: {
      it: 'Porta le domande vere, quelle che oggi arrivano al monitoraggio per mail. Entra dopo la prova, con una domanda scritta insieme: così la prima volta funziona.',
      en: 'Brings the real questions, the ones that reach monitoring by email today. Joins after the trial, with a question written together: that way the first time works.',
    },
  },
  {
    k: { it: 'Un senior che scrive le skill', en: 'A senior who writes the skills' },
    b: {
      it: 'È il passaggio che fa la differenza: la persona che conosce il mestiere scrive una volta il modo giusto di chiedere, e da lì in poi lo può eseguire anche chi è arrivato da poco.',
      en: 'This is the step that makes the difference: the person who knows the craft writes the right way to ask once, and from then on someone new can run it.',
    },
  },
  {
    k: { it: 'Adobe', en: 'Adobe' },
    b: {
      it: 'Un referente di prodotto e un punto fisso ogni settimana, dentro il programma di affiancamento. Più la demo sull’organizzazione dimostrativa, prima di toccare la vostra.',
      en: 'A product contact and a fixed weekly slot, inside the high-touch programme. Plus the demo on Adobe’s demo organisation, before touching yours.',
    },
  },
];

// Il programma di affiancamento (high touch). Oggi è attivo su CJA; per Poste
// lo chiediamo su Adobe Analytics: si apre su richiesta, non è automatico.
const noi = [
  {
    k: { it: 'Che cosa mettiamo', en: 'What we bring' },
    b: {
      it: 'Un referente di prodotto Adobe dentro il programma, le prime skill scritte insieme a voi, la demo sull’organizzazione dimostrativa prima di toccare la vostra. E le domande che non funzionano tornano al team di prodotto, non restano nel vostro backlog.',
      en: 'An Adobe product contact inside the programme, the first skills written together with you, the demo on Adobe’s demo organisation before touching yours. And the questions that do not work go back to the product team, instead of sitting in your backlog.',
    },
  },
  {
    k: { it: 'Che cosa chiediamo', en: 'What we ask' },
    b: {
      it: 'Due persone e un’ora a settimana, per il tempo della prova. E domande vere: il programma vive di quelle, se no diventa una demo lunga.',
      en: 'Two people and one hour a week, for the length of the trial. And real questions: the programme runs on those, otherwise it becomes a long demo.',
    },
  },
  {
    k: { it: 'Che cosa costa', en: 'What it costs' },
    b: {
      it: 'Niente, per i due mesi. Il punto non è il prezzo: è non scoprire a metà strada che il consumo è più alto di quanto si pensava. Per questo i due mesi servono a <strong>misurarlo</strong>, e la conversazione commerciale viene dopo, con un numero vostro in mano.',
      en: 'Nothing, for the two months. The point is not the price: it is not discovering halfway that consumption is higher than you thought. That is what the two months are for — to <strong>measure it</strong> — and the commercial conversation comes after, with a number of your own.',
    },
  },
];

// Dove può andare. Il perimetro di oggi è uno solo; il perimetro possibile
// si dice, perché la domanda arriva comunque — ma con chi decide accanto.
const evolutive = [
  {
    k: { it: 'Il Workspace che si scrive da sé', en: 'The Workspace that writes itself' },
    tag: { it: 'Vostra · in rollout', en: 'Yours · rolling out' },
    b: {
      it: 'Un’analisi fatta in chat diventa un progetto in Analysis Workspace, da riprendere a mano. Le skill del team generano i progetti ricorrenti. È la parte di Coworker più vicina al vostro lavoro, ed è tutta dentro Analytics.',
      en: 'An analysis done in chat becomes an Analysis Workspace project to pick up by hand. The team’s skills generate the recurring projects. It is the part of Coworker closest to your daily work, and it all sits inside Analytics.',
    },
    tone: 'giallo',
  },
  {
    k: { it: 'Le domande del business', en: 'The business questions' },
    tag: { it: 'Vostra, con chi fa campagne', en: 'Yours, with the campaign side' },
    b: {
      it: 'Operazioni concluse e abbandonate per prodotto dalle pagine di conferma già tracciate (bollettino, ricarica, bonifico, postagiro), ricariche dopo una push contro un martedì senza (se l’apertura della push è tracciata), dove si perde il cliente fra la sezione e la conferma. Sono le domande che il business fa a voi: dopo la prova, con una skill scritta insieme, le può fare a Coworker.',
      en: 'Operations completed and abandoned by product from the confirmation pages already tracked (payment slip, top-up, transfer, postagiro), top-ups after a push against a Tuesday without one (if the push open is tracked), where the customer is lost between the section and the confirmation. These are the questions the business asks you: after the trial, with a skill written together, it can ask Coworker.',
    },
    tone: '',
  },
  {
    k: { it: 'Gli altri MCP di Coworker', en: 'Coworker’s other MCP servers' },
    tag: { it: 'Fuori dal pilota', en: 'Outside the pilot' },
    b: {
      it: 'Oggi il perimetro è uno: Adobe Analytics. Lo stesso meccanismo però collega Coworker agli altri prodotti Adobe — AEM già supportato, Workfront in preview, Target, Journey Optimizer, Real-Time CDP ed Experience Platform in beta — e accetta anche server MCP vostri, verso sistemi non Adobe. Il Gruppo ha già AEM Forms e Adobe Commerce, ma in altre divisioni: allargare il perimetro è una decisione loro e del Comitato IA, non di questo pilota.',
      en: 'Today the scope is one: Adobe Analytics. The same mechanism, though, connects Coworker to the other Adobe applications — AEM already supported, Workfront in preview, Target, Journey Optimizer, Real-Time CDP and Experience Platform in beta — and it also accepts MCP servers of your own, towards non-Adobe systems. The Group already has AEM Forms and Adobe Commerce, but in other divisions: widening the scope is their decision and the AI Committee’s, not this pilot’s.',
    },
    tone: 'grigio',
  },
  {
    k: { it: 'Il tracciamento', en: 'Tracking' },
    tag: { it: 'Fuori perimetro, oggi', en: 'Out of scope, today' },
    b: {
      it: 'Le novità di Analytics che chiedono un cambio al tracciamento passano dal Web SDK e dall’SDK mobile. Non è la domanda di oggi: si riapre quando la SuperApp avrà un rilascio del tracciamento in agenda.',
      en: 'The Analytics features that need a tracking change go through the Web SDK and the mobile SDK. Not today’s question: it reopens when the SuperApp has a tracking release on the agenda.',
    },
    tone: 'grigio',
  },
];
---
<BaseLayout title={ch.label.it} preloadImage={bgCover.src}>
  <div class="fixed top-0 left-0 right-0 z-50">
    <SdNavigation currentPath={currentPath} base={base} />
  </div>

  <DeckContainer wallScale nextHref={href(base, '/')} prevHref={href(base, prevSlug(SLUG))}>

    <!-- ── Cover ─────────────────────────────────────────────────────────── -->
    <Slide id="slide-cover" bg="inverse" align="center">
      <div slot="backdrop" class="sd-bg-notte" style={`--bg-src: url(${bgCover.src})`}></div>
      <div class="sd-q" data-reveal>
        <p class="sd-q-num"><span data-lang-it>Domanda {ch.num} · {ch.label.it}</span><span data-lang-en>Question {ch.num} · {ch.label.en}</span></p>
        <span class="sd-q-mark" aria-hidden="true"></span>
        <T as="h2" class="sd-q-title" it={`«${ch.question.it}»`} en={`“${ch.question.en}”`} data-reveal data-reveal-delay="0.08" />
        <T
          as="p"
          class="sd-q-lead"
          it="Le prime cinque domande stanno nel perimetro del monitoraggio e si chiudono senza cambiare nulla. La sesta è quella che resta quando la riunione finisce: come si parte, chi serve al tavolo, che cosa mette Adobe, e dove può arrivare."
          en="The first five questions sit inside monitoring’s remit and close without changing anything. The sixth is the one left when the meeting ends: how to start, who is needed at the table, what Adobe brings, and where it can go."
          data-reveal data-reveal-delay="0.15"
        />
      </div>
    </Slide>

    <!-- ── Come si parte ─────────────────────────────────────────────────── -->
    <Slide id="slide-avvio" bg="secondary" align="center">
      <div slot="backdrop" class="sd-bg-azzurro" style={`--bg-src: url(${bgAvvio.src})`}></div>
      <div class="sd-head" data-reveal>
        <T as="p" class="slide-eyebrow mb-3" it="Quello che proponiamo" en="What we propose" />
        <T as="h2" class="sd-head-title" it="Si parte piccolo, su una suite di prova, e si misura" en="Start small, on a test suite, and measure" />
        <T
          as="p"
          class="sd-head-lead"
          it="Niente da firmare, niente da installare, nessun rilascio sull’app. Una prova sul vostro Analytics, con il vostro team e le vostre domande, misurata su tre cose: quanto prima arriva la risposta, se i numeri tornano, quante domande si chiudono senza il team."
          en="Nothing to sign, nothing to install, no app release. A trial on your Analytics, with your team and your questions, measured on three things: how much sooner the answer arrives, whether the numbers match, how many questions get closed without the team."
        />
      </div>
      <div class="sd-steps" data-reveal data-reveal-delay="0.14">
        {avvio.map((p, i) => (
          <div class="sd-step">
            <span class:list={['sd-step-n', i === 3 && 'sd-step-n--giallo']}>{i + 1}</span>
            <T as="p" class="sd-step-title" it={p.t.it} en={p.t.en} />
            <T as="p" class="sd-step-body" it={p.b.it} en={p.b.en} />
          </div>
        ))}
      </div>
      <T as="p" class="sd-src" it="Conviene partire presto: due mesi pieni di prova vogliono dire cominciare prima delle feste, non dopo. Dalla conferma di Adobe all’accensione passano giorni, non settimane." en="Starting early pays: two full months of trial means beginning before the holidays, not after. From Adobe’s confirmation to switch-on it is days, not weeks." data-reveal data-reveal-delay="0.24" />
    </Slide>

    <!-- ── Chi serve al tavolo ───────────────────────────────────────────── -->
    <Slide id="slide-chi" bg="primary" align="center">
      <div slot="backdrop" class="sd-bg-carta" style={`--bg-src: url(${bgChi.src})`}></div>
      <div class="sd-head" data-reveal>
        <T as="p" class="slide-eyebrow mb-3" it="Chi coinvolgere" en="Who to involve" />
        <T as="h2" class="sd-head-title" it="Cinque ruoli, nell’ordine in cui entrano" en="Five roles, in the order they join" />
      </div>
      <div class="w-full max-w-6xl mx-auto flex flex-col" data-reveal data-reveal-delay="0.14">
        {chi.map((r, i) => (
          <div class="sd-row">
            <div>
              <p class="sd-row-label"><span class="sd-row-n">0{i + 1}</span><span class="sd-row-t"><span data-lang-it>{r.k.it}</span><span data-lang-en>{r.k.en}</span></span></p>
            </div>
            <T as="p" class="sd-row-body" it={r.b.it} en={r.b.en} />
          </div>
        ))}
      </div>
    </Slide>

    <!-- ── Quello che mettiamo noi ───────────────────────────────────────── -->
    <Slide id="slide-noi" bg="secondary" align="center">
      <div slot="backdrop" class="sd-bg-azzurro" style={`--bg-src: url(${bgNoi.src})`}></div>
      <div class="sd-head" data-reveal>
        <T as="p" class="slide-eyebrow mb-3" it="Da parte nostra" en="On our side" />
        <T as="h2" class="sd-head-title" it="Un affiancamento, non una licenza in più" en="A programme alongside you, not another licence" />
        <T
          as="p"
          class="sd-head-lead"
          it="Su alcuni clienti Adobe apre un programma di affiancamento su Coworker — lo chiamano <strong>iTouch</strong> — con un avvio insieme, un referente di prodotto e un punto fisso ogni settimana. Dura circa due mesi e <strong>non è una licenza</strong>: serve a usarlo sul serio senza consumare i crediti di prova, e quindi a capire quanto costerebbe davvero prima di impegnarsi."
          en="On selected customers Adobe opens a high-touch programme on Coworker — they call it <strong>iTouch</strong> — with a kickoff together, a product contact and a fixed weekly slot. It runs about two months and <strong>it is not a licence</strong>: it exists to use the tool properly without burning the trial credits, and so to learn what it would really cost before committing."
        />
      </div>
      <div class="sd-steps sd-steps--3" data-reveal data-reveal-delay="0.14">
        {noi.map((n, i) => (
          <div class="sd-step">
            <span class="sd-step-n">{i + 1}</span>
            <T as="p" class="sd-step-title" it={n.k.it} en={n.k.en} />
            <T as="p" class="sd-step-body" it={n.b.it} en={n.b.en} />
          </div>
        ))}
      </div>
      <T as="p" class="sd-src" it="Il programma si apre su richiesta e la richiesta la facciamo noi: non è automatico, e la conferma arriva da Adobe per iscritto. · Fuori dal programma Coworker è licenziato in crediti di IA (Product Description, in vigore dal 30 lug 2026), e l’organizzazione ne ha già un pacchetto di prova." en="The programme opens on request and we file the request: it is not automatic, and confirmation comes from Adobe in writing. · Outside the programme Coworker is licensed in AI Credits (Product Description, effective 30 Jul 2026), and the organisation already has a trial pack." data-reveal data-reveal-delay="0.24" />
    </Slide>

    <!-- ── Le quattro evolutive ──────────────────────────────────────────── -->
    <Slide id="slide-evolutive" bg="primary" align="center">
      <div slot="backdrop" class="sd-bg-carta" style={`--bg-src: url(${bgEvo.src})`}></div>
      <div class="sd-head" data-reveal>
        <T as="p" class="slide-eyebrow mb-3" it="E poi" en="And then" />
        <T as="h2" class="sd-head-title" it="Quattro evolutive, ognuna con chi decide" en="Four next steps, each with who decides" />
      </div>
      <div class="sd-steps sd-steps--2" data-reveal data-reveal-delay="0.14">
        {evolutive.map((e) => (
          <div class:list={['sd-panel', e.tone === 'giallo' ? 'sd-panel--giallo' : e.tone === 'grigio' ? 'sd-panel--grigio' : 'sd-panel--blu']}>
            <div class="sd-panel-head">
              <T as="span" class="sd-step-title mb-0" it={e.k.it} en={e.k.en} />
              <T as="span" class:list={['sd-tag whitespace-nowrap', e.tone === 'giallo' && 'sd-tag--giallo', e.tone === 'grigio' && 'sd-tag--grigio']} it={e.tag.it} en={e.tag.en} />
            </div>
            <T as="p" class="sd-panel-body" it={e.b.it} en={e.b.en} />
          </div>
        ))}
      </div>
      <p class="sd-src" data-reveal data-reveal-delay="0.24">
        <span data-lang-it>Fonti:&nbsp;</span><span data-lang-en>Sources:&nbsp;</span>
        <a href={SOURCES.coworkerGateway.url} target="_blank" rel="noopener noreferrer"><span data-lang-it>{SOURCES.coworkerGateway.label.it}</span><span data-lang-en>{SOURCES.coworkerGateway.label.en}</span></a>
        &nbsp;·&nbsp;<a href={SOURCES.aemMcp.url} target="_blank" rel="noopener noreferrer"><span data-lang-it>{SOURCES.aemMcp.label.it}</span><span data-lang-en>{SOURCES.aemMcp.label.en}</span></a>
        &nbsp;·&nbsp;<a href={SOURCES.coworkerChat.url} target="_blank" rel="noopener noreferrer"><span data-lang-it>{SOURCES.coworkerChat.label.it}</span><span data-lang-en>{SOURCES.coworkerChat.label.en}</span></a>
      </p>
    </Slide>

    <!-- ── Chiusura ──────────────────────────────────────────────────────── -->
    <Slide id="slide-chiusura" bg="inverse" align="center">
      <div slot="backdrop" class="sd-bg-notte" style={`--bg-src: url(${bgChiusura.src})`}></div>
      <div class="sd-take" data-reveal>
        <T as="p" class="slide-eyebrow mb-3 sd-on-dark" it="Per chiudere" en="To close" />
        <T as="h2" class="sd-take-title" it="Le risposte erano già lì. Cambia chi le può chiedere." en="The answers were already there. What changes is who can ask." />
        <div class="sd-take-grid" data-reveal data-reveal-delay="0.14">
          <div class="sd-take-item">
            <T as="p" class="sd-take-k" it="I due criteri del 2024" en="The two 2024 criteria" />
            <T as="p" class="sd-take-t" it="Il tempo dalla richiesta all’insight e un’interfaccia che chi ha la domanda sa usare: <strong>sono le due cose che questo cambia</strong>, senza toccare lo stack." en="Time from request to insight, and an interface the person with the question can use: <strong>those are the two things this changes</strong>, without touching the stack." />
          </div>
          <div class="sd-take-item">
            <T as="p" class="sd-take-k" it="Il ruolo del team" en="The team’s role" />
            <T as="p" class="sd-take-t" it="Da chi costruisce ogni risposta a chi <strong>scrive le regole</strong> con cui la risposta si ripete da sé, e a chi la porta al tavolo del lunedì con chi fa campagne." en="From building every answer to <strong>writing the rules</strong> by which the answer repeats itself, and bringing it to the Monday table with the campaign side." />
          </div>
          <div class="sd-take-item">
            <T as="p" class="sd-take-k" it="Il prossimo passo" en="The next step" />
            <T as="p" class="sd-take-t" it="Da parte vostra l’istruttoria e una data per la suite di sviluppo; da parte nostra la richiesta ad Adobe. <strong>Il resto lo decidono i numeri</strong> della prova." en="On your side the assessment and a date for the development suite; on ours the request to Adobe. <strong>The numbers of the trial</strong> decide the rest." />
          </div>
        </div>
      </div>
    </Slide>

    <!-- ── Firma ─────────────────────────────────────────────────────────── -->
    <Slide id="slide-signature" bg="inverse" align="center" data-made-with="Firefly" data-made-with-for="clip">
      <LoopVideo slot="backdrop" src={FIRMA_VIDEO} poster={`${base.replace(/\/?$/, '/')}media/sd-firma.poster.jpg`} scrim="sd-scrim-giallo" opacity={1} />
      <CoBrand variant="hero" data-reveal />
      <T as="p" class="sd-sig-line" it="Sei domande. Le risposte, da ottobre, dentro Adobe Analytics." en="Six questions. The answers, from October, inside Adobe Analytics." data-reveal data-reveal-delay="0.1" />
      <a href={href(base, '/')} class="edf-sig-cta" data-reveal data-reveal-delay="0.18"><span data-lang-it>Torna all’inizio →</span><span data-lang-en>Back to the start →</span></a>
    </Slide>

  </DeckContainer>

  <style>
    :global(.sd-sig-line) { margin-top: clamp(1.4rem, 3vh, 2.4rem); font-size: clamp(1.05rem, 1.4vw, 1.35rem); line-height: 1.5; color: var(--color-grigio-200); text-align: center; max-width: 44ch; display: block; margin-inline: auto; }
  </style>
</BaseLayout>
