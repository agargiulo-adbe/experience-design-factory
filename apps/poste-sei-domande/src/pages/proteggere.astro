---
import BaseLayout from '../layouts/BaseLayout.astro';
import SdNavigation from '../components/SdNavigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import T from '@edf/core/blocks/i18n/T.astro';
import { href } from '@edf/core/utils/url.js';
import { CHAPTERS, prevSlug, nextSlug } from '../data/chapters';
import { SOURCES } from '../data/sources';
import bgCover from '../assets/generated/bg/notte-5.webp';
import bgArch from '../assets/generated/bg/carta-1.webp';
import bgNon from '../assets/generated/bg/carta-3.webp';
import bgRegole from '../assets/generated/bg/carta-2.webp';
import bgTake from '../assets/generated/bg/notte-6.webp';

const SLUG = 'proteggere';
const ch = CHAPTERS.find((c) => c.slug === SLUG)!;
const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;

const nonFa = [
  { k: { it: 'Non raccoglie', en: 'Does not collect' }, b: { it: 'Nessun tag nuovo, nessun evento in più sull’app o sul sito. Coworker legge ciò che Analytics riceve già da AppMeasurement e dall’SDK mobile via Tags (Launch), come Workspace.', en: 'No new tag, no extra event on the app or site. Coworker reads what Analytics already receives from AppMeasurement and the mobile SDK via Tags (Launch), like Workspace.' } },
  { k: { it: 'Non profila', en: 'Does not profile' }, b: { it: 'Lavora sui report aggregati delle report suite: visite, sezioni, piattaforme, segmenti. Non unisce profili né decodifica identificativi. Le variabili con identificativi pseudonimi le vede come Workspace: l’inventario si fa prima di partire, e i permessi si sommano fra profili.', en: 'It works on the aggregated reports of the report suites: visits, sections, platforms, segments. It stitches no profiles and decodes no identifiers. Variables carrying pseudonymous identifiers it sees as Workspace does: the inventory is done before starting, and permissions add up across profiles.' } },
  { k: { it: 'Non decide', en: 'Does not decide' }, b: { it: 'Non attiva campagne, non tocca contenuti, non personalizza niente per il cliente finale. Risponde a chi chiede, dentro l’organizzazione.', en: 'It triggers no campaigns, touches no content, personalises nothing for the end customer. It answers whoever asks, inside the organisation.' } },
  { k: { it: 'Non sorveglia', en: 'Does not monitor' }, b: { it: 'Sulla vostra Analytics risponde alle domande che riceve: non gira alert per conto suo. Il primo segnale resta un alert di Analytics o un reclamo.', en: 'On your Analytics it answers the questions it receives: it runs no alerts of its own. The first signal is still an Analytics alert or a complaint.' } },
];

const regole = [
  { t: { it: 'Un profilo per il pilota', en: 'A profile for the pilot' }, b: { it: 'MCP Access segue i diritti Analytics: per il pilota un profilo di prodotto dedicato, senza authoring, con la conferma richiesta su ogni scrittura, per convenzione del pilota. Le scritture in produzione, se servono, a quattro occhi.', en: 'MCP Access follows Analytics rights: for the pilot a dedicated product profile, without authoring, with confirmation required on every write, as a pilot convention. Writes in production, if needed, with a second pair of eyes.' } },
  { t: { it: 'Una suite di prova', en: 'A test suite' }, b: { it: 'Si parte dalla suite di sviluppo della SuperApp, che avete già. Si passa a quella di produzione quando le prime domande tornano.', en: 'Start on the SuperApp development suite you already have. Move to the production one when the first questions check out.' } },
  { t: { it: 'Validare sul report certificato', en: 'Validate on the certified report' }, b: { it: 'Ogni risposta usata per una decisione si confronta il primo mese col report certificato. Se i numeri tornano, il metodo regge.', en: 'Every answer used for a decision is checked against the certified report during the first month. If the numbers match, the method holds.' } },
  { t: { it: 'Si apre per gradi, non «apri tutto»', en: 'It opens step by step, not “open to everyone”' }, b: { it: 'Il rischio non è tecnico: è che una risposta giusta venga letta male da chi non ha la sensibilità di quel dato. Per questo si parte da poche persone nominate, e le domande ricorrenti si fissano in skill scritte da chi il mestiere lo conosce: chi arriva dopo le usa senza doverle reinventare. Allargare resta una vostra decisione, una suite e un gruppo alla volta.', en: 'The risk is not technical: it is a correct answer read badly by someone without a feel for that data. So it starts with a few named people, and recurring questions get fixed into skills written by those who know the craft: whoever comes next uses them without reinventing them. Widening stays your decision, one suite and one group at a time.' } },
];
---
<BaseLayout title={ch.label.it} preloadImage={bgCover.src}>
  <div class="fixed top-0 left-0 right-0 z-50">
    <SdNavigation currentPath={currentPath} base={base} />
  </div>

  <DeckContainer wallScale nextHref={href(base, nextSlug(SLUG))} prevHref={href(base, prevSlug(SLUG))}>

    <!-- ── Cover ─────────────────────────────────────────────────────────── -->
    <Slide id="slide-cover" bg="inverse" align="center">
      <div slot="backdrop" class="sd-bg-notte" style={`--bg-src: url(${bgCover.src})`}></div>
      <div class="sd-q" data-reveal>
        <p class="sd-q-num"><span data-lang-it>Domanda {ch.num} · {ch.label.it}</span><span data-lang-en>Question {ch.num} · {ch.label.en}</span></p>
        <span class="sd-q-mark" aria-hidden="true"></span>
        <T as="h2" class="sd-q-title" it={`«${ch.question.it}»`} en={`“${ch.question.en}”`} data-reveal data-reveal-delay="0.08" />
        <T
          as="p"
          class="sd-q-lead"
          it="È la domanda che vi faranno per prima, e giustamente. Coworker interroga le vostre report suite con i permessi di chi chiede e riporta il risultato nella conversazione: la raccolta dei dati non cambia e non si uniscono dati fra prodotti. Che cosa resti della conversazione, dove e per quanto, è una domanda per l’istruttoria: la risposta sta nei termini Adobe, non in una slide."
          en="It is the question you will be asked first, and rightly so. Coworker queries your report suites with the permissions of whoever asks and brings the result back into the conversation: collection does not change and no data is joined across products. What is kept of the conversation, where and for how long, is a question for the assessment: the answer is in Adobe’s terms, not on a slide."
          data-reveal data-reveal-delay="0.15"
        />
      </div>
    </Slide>

    <!-- ── Architettura ──────────────────────────────────────────────────── -->
    <Slide id="slide-arch" bg="primary" align="center">
      <div slot="backdrop" class="sd-bg-carta" style={`--bg-src: url(${bgArch.src})`}></div>
      <div class="sd-head" data-reveal>
        <T as="p" class="slide-eyebrow mb-3" it="Com’è fatto il collegamento" en="How the connection is made" />
        <T as="h2" class="sd-head-title" it="Tre pezzi, e che cosa tocca ciascuno" en="Three pieces, and what each one touches" />
      </div>
      <div class="sd-arch" data-reveal data-reveal-delay="0.14">
        <div class="sd-arch-node sd-arch-node--giallo">
          <T as="p" class="sd-arch-sub" it="Chi chiede" en="Who asks" />
          <T as="p" class="sd-arch-title" it="Coworker Chat" en="Coworker Chat" />
          <T as="p" class="sd-arch-body" it="Si entra con la login aziendale, sull’organizzazione Poste Italiane. È qui che vivono la conversazione, la cronologia delle chat, la memoria e le skill del team. Qui sta anche il modello: Coworker è dichiarato da Adobe come funzionalità di IA generativa." en="You sign in with the company login, on the Poste Italiane organisation. This is where the conversation, the chat history, the memory and the team’s skills live. The model is here too: Adobe declares Coworker a Generative AI Feature." />
        </div>
        <div class="sd-arch-link"><span class="sd-arch-link-line"></span><span data-lang-it>permessi Analytics + MCP Access</span><span data-lang-en>Analytics permissions + MCP Access</span></div>
        <div class="sd-arch-node sd-arch-node--blu">
          <T as="p" class="sd-arch-sub" it="Il passaggio" en="The passage" />
          <T as="p" class="sd-arch-title" it="Server MCP Analytics" en="Analytics MCP server" />
          <T as="p" class="sd-arch-body" it="Ospitato da Adobe. È il collegamento agli strumenti di Analytics: cercare report suite e componenti, eseguire report, e scrivere su alcuni componenti — segmenti, metriche calcolate, intervalli di date, progetti Workspace. Espone solo gli strumenti a cui l’organizzazione e la persona sono abilitate." en="Hosted by Adobe. It is the link to the Analytics tools: find report suites and components, run reports, and write on selected components — segments, calculated metrics, date ranges, Workspace projects. It exposes only the tools the organisation and the person are entitled to." />
        </div>
        <div class="sd-arch-link"><span class="sd-arch-link-line"></span><span data-lang-it>strumenti di Analytics</span><span data-lang-en>Analytics tools</span></div>
        <div class="sd-arch-node sd-arch-node--blu">
          <T as="p" class="sd-arch-sub" it="Dove stanno i dati" en="Where the data lives" />
          <T as="p" class="sd-arch-title" it="Adobe Analytics" en="Adobe Analytics" />
          <T as="p" class="sd-arch-body" it="Le vostre report suite, come sono. Questo è un livello di accesso e di analisi: non sostituisce l’implementazione. AppMeasurement, l’SDK mobile e le property in Tags non cambiano, e la fine vita delle API 1.4 non ferma la raccolta." en="Your report suites, as they are. This is an access and analysis layer: it does not replace the implementation. AppMeasurement, the mobile SDK and the Tags properties do not change, and the end of life of the 1.4 APIs does not stop collection." />
        </div>
      </div>
      <T as="p" class="sd-arch-note" it="<strong>Quello che questa slide non dice.</strong> Dove sono conservate le conversazioni, per quanto tempo e a quali condizioni Adobe può usare domande e risposte: sono clausole, non architettura. Stanno nei termini Adobe sulle funzionalità di IA generativa e nella documentazione contrattuale, e vanno nell’istruttoria con la loro fonte." en="<strong>What this slide does not say.</strong> Where conversations are kept, for how long, and on what terms Adobe may use inputs and outputs: those are contract clauses, not architecture. They sit in Adobe’s Generative AI Features terms and in the contractual documentation, and they belong in the assessment with their source." data-reveal data-reveal-delay="0.22" />
      <p class="sd-src" data-reveal data-reveal-delay="0.28">
        <span data-lang-it>Fonti:&nbsp;</span><span data-lang-en>Sources:&nbsp;</span>
        <a href={SOURCES.coworkerGateway.url} target="_blank" rel="noopener noreferrer"><span data-lang-it>{SOURCES.coworkerGateway.label.it}</span><span data-lang-en>{SOURCES.coworkerGateway.label.en}</span></a>
        &nbsp;·&nbsp;<a href={SOURCES.coworkerAnalytics.url} target="_blank" rel="noopener noreferrer"><span data-lang-it>{SOURCES.coworkerAnalytics.label.it}</span><span data-lang-en>{SOURCES.coworkerAnalytics.label.en}</span></a>
        &nbsp;·&nbsp;<a href={SOURCES.genaiTerms.url} target="_blank" rel="noopener noreferrer"><span data-lang-it>{SOURCES.genaiTerms.label.it}</span><span data-lang-en>{SOURCES.genaiTerms.label.en}</span></a>
      </p>
    </Slide>

    <!-- ── Cosa non fa ───────────────────────────────────────────────────── -->
    <Slide id="slide-nonfa" bg="secondary" align="center">
      <div slot="backdrop" class="sd-bg-azzurro" style={`--bg-src: url(${bgNon.src})`}></div>
      <div class="sd-head" data-reveal>
        <T as="p" class="slide-eyebrow mb-3" it="Per essere chiari" en="To be clear" />
        <T as="h2" class="sd-head-title" it="Quattro cose che Coworker non fa" en="Four things Coworker does not do" />
      </div>
      <div class="w-full max-w-6xl mx-auto flex flex-col" data-reveal data-reveal-delay="0.14">
        {nonFa.map((r, i) => (
          <div class="sd-row">
            <div>
              <p class="sd-row-label"><span class="text-[var(--ink-mark)] mr-2 tabular-nums">0{i + 1}</span><span data-lang-it>{r.k.it}</span><span data-lang-en>{r.k.en}</span></p>
            </div>
            <T as="p" class="sd-row-body" it={r.b.it} en={r.b.en} />
          </div>
        ))}
      </div>
      <p class="sd-src" data-reveal data-reveal-delay="0.24">
        <span data-lang-it>Fonti:&nbsp;</span><span data-lang-en>Sources:&nbsp;</span>
        <a href={SOURCES.mcpFaq.url} target="_blank" rel="noopener noreferrer"><span data-lang-it>{SOURCES.mcpFaq.label.it}</span><span data-lang-en>{SOURCES.mcpFaq.label.en}</span></a>
        &nbsp;·&nbsp;<a href={SOURCES.mcpTools.url} target="_blank" rel="noopener noreferrer"><span data-lang-it>{SOURCES.mcpTools.label.it}</span><span data-lang-en>{SOURCES.mcpTools.label.en}</span></a>
      </p>
    </Slide>

    <!-- ── Regole d'uso ──────────────────────────────────────────────────── -->
    <Slide id="slide-regole" bg="primary" align="center">
      <div slot="backdrop" class="sd-bg-carta" style={`--bg-src: url(${bgRegole.src})`}></div>
      <div class="sd-head" data-reveal>
        <T as="p" class="slide-eyebrow mb-3" it="Le regole che proponiamo" en="The rules we propose" />
        <T as="h2" class="sd-head-title" it="Quattro regole, prima di accendere e durante la prova" en="Four rules, before switching on and during the trial" />
        <T
          as="p"
          class="sd-head-lead"
          it="La domanda non è se lo strumento è sicuro: è chi lo usa e che cosa può chiedere. Queste quattro regole tengono stretto il perimetro della prova — poche persone nominate, una suite che non è la produzione, ogni risposta confrontata con il report certificato — così si apre per gradi invece che tutto insieme."
          en="The question is not whether the tool is safe: it is who uses it and what they can ask. These four rules keep the trial’s perimeter tight — a few named people, a suite that is not production, every answer checked against the certified report — so it opens step by step instead of all at once."
        />
      </div>
      <div class="sd-steps" data-reveal data-reveal-delay="0.14">
        {regole.map((r, i) => (
          <div class="sd-step">
            <span class="sd-step-n">{i + 1}</span>
            <T as="p" class="sd-step-title" it={r.t.it} en={r.t.en} />
            <T as="p" class="sd-step-body" it={r.b.it} en={r.b.en} />
          </div>
        ))}
      </div>
      <p class="sd-src" data-reveal data-reveal-delay="0.24">
        <span data-lang-it>Fonte:&nbsp;</span><span data-lang-en>Source:&nbsp;</span>
        <a href={SOURCES.posteManifesto.url} target="_blank" rel="noopener noreferrer"><span data-lang-it>{SOURCES.posteManifesto.label.it}</span><span data-lang-en>{SOURCES.posteManifesto.label.en}</span></a>
      </p>
    </Slide>

    <!-- ── Take ──────────────────────────────────────────────────────────── -->
    <Slide id="slide-take" bg="inverse" align="center">
      <div slot="backdrop" class="sd-bg-notte" style={`--bg-src: url(${bgTake.src})`}></div>
      <div class="sd-take" data-reveal>
        <T as="p" class="slide-eyebrow mb-3 sd-on-dark" it="Cosa vi portate a casa" en="What you take home" />
        <T as="h2" class="sd-take-title" it="Una risposta che potete dare voi, in una riga" en="An answer you can give yourself, in one line" />
        <div class="sd-take-grid" data-reveal data-reveal-delay="0.14">
          <div class="sd-take-item">
            <T as="p" class="sd-take-k" it="Dati" en="Data" />
            <T as="p" class="sd-take-t" it="Restano in Analytics, <strong>senza copie dei dati grezzi né dati nuovi</strong>, e senza profili." en="They stay in Analytics, <strong>with no copy of the raw data and no new data</strong>, and no profile built." />
          </div>
          <div class="sd-take-item">
            <T as="p" class="sd-take-k" it="Accesso" en="Access" />
            <T as="p" class="sd-take-t" it="Un permesso che <strong>date e togliete voi</strong>, per persona, in Admin Console." en="A permission <strong>you grant and revoke</strong>, per person, in Admin Console." />
          </div>
          <div class="sd-take-item">
            <T as="p" class="sd-take-k" it="Registro" en="Log" />
            <T as="p" class="sd-take-t" it="Le scritture lasciano <strong>le stesse voci</strong> che lascia Workspace negli audit log di Analytics: non c’è un registro separato delle azioni via MCP. Come si esporta sta nella scheda, prima del pilota." en="Writes leave <strong>the same entries</strong> Workspace leaves in the Analytics audit logs: there is no separate register of MCP actions. How it exports sits in the file, before the pilot." />
          </div>
        </div>
        <T as="p" class="sd-caveat" it="<strong>Il perimetro.</strong> Questo deck resta dentro Adobe Analytics, su dati aggregati, con i permessi che avete già. Il giorno in cui il perimetro si allarga — altri sistemi, altri dati, molte più persone — entrano in gioco il Manifesto per l’uso etico dell’IA e il Comitato che Poste si è data: è una valutazione nuova, non un’estensione di questa." en="<strong>The scope.</strong> This deck stays inside Adobe Analytics, on aggregated data, with the permissions you already have. The day the perimeter widens — other systems, other data, many more people — Poste’s Manifesto for the ethical use of AI and its Committee come into play: that is a new assessment, not an extension of this one." data-reveal data-reveal-delay="0.24" />
      </div>
    </Slide>

  </DeckContainer>
</BaseLayout>
