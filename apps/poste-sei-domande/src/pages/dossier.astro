---
import BaseLayout from '../layouts/BaseLayout.astro';
import DossierPage from '@edf/core/blocks/doc/DossierPage.astro';

// ── Pagina RISERVATA (Adobe internal) ──────────────────────────────────────
// Orfana (fuori nav) + noindex. Il contenuto confidenziale NON è nel bundle
// statico: vive in Supabase (tabella restricted_docs, RLS) e si carica solo
// dopo login oppure via secret-link ?t=<uuid> (RPC get_shared_doc).
//
// Il rendering è del motore condiviso `@edf/core/blocks/doc/DossierPage.astro`.
// Qui restano lo slug, il guscio dell'app e la mappatura della palette sul
// contratto `--dw-*`. Migliorare il motore migliora tutti i dossier.
const base = import.meta.env.BASE_URL;
---
<BaseLayout
  title="Dossier — Poste Italiane"
  description="Adobe internal — dossier riservato (accesso ristretto)."
  noindex={true}
>
  <DossierPage
    docSlug="poste-sei-domande"
    title="Dossier — Poste Italiane"
    base={base}
    supabaseUrl={import.meta.env.PUBLIC_SUPABASE_URL ?? ''}
    supabaseAnon={import.meta.env.PUBLIC_SUPABASE_ANON_KEY ?? ''}
    deckHref={base}
    deckLabel="Deck →"
  />

  <style is:global>
    /* Palette Poste (letta da poste.it con brand:tokens, 29 set 2026). Il dossier
         gira su fondo scuro anche se l'experience è chiara: è un documento di
         lavoro, non un artefatto cliente. Il giallo di marchio #eedc00 fa
         l'accento (14,8:1 sull'inchiostro), il blu di sistema fa i pieni.
         Prima della migrazione questi valori stavano qui sotto nomi presi in
         prestito da un'altra app — «menta» per il giallo, «arancio» per il blu. */
    :root {
      --dw-bg: var(--color-inchiostro);
      --dw-tint: rgba(0, 71, 187, 0.18);
      --dw-surface: rgba(51, 51, 51, 0.45);
      --dw-surface-2: rgba(66, 112, 228, 0.22);
      --dw-line: #3a3d42;
      --dw-ink: #e2e2e6;
      --dw-ink-soft: #c6c6c9;
      --dw-ink-faint: #9a9da3;
      --dw-ink-strong: #ffffff;
      --dw-accent: var(--color-giallo);
      --dw-fill: var(--color-blu-chiaro);
      --dw-on-fill: #0b1226;
      --dw-warn: var(--color-giallo);
      --dw-on-warn: #1a1c1e;
      --dw-alt: #8fb1ff;
      --dw-font-display: var(--font-display);
      --dw-font-body: var(--font-body);
    }
  </style>
</BaseLayout>
