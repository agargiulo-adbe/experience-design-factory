---
import BaseLayout from '../layouts/BaseLayout.astro';
import SdNavigation from '../components/SdNavigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import T from '@edf/core/blocks/i18n/T.astro';
import { href } from '@edf/core/utils/url.js';
import { CHAPTERS, prevSlug, nextSlug } from '../data/chapters';
import { SOURCES } from '../data/sources';
import bgCover from '../assets/generated/bg/notte-1.webp';
import bgCosa from '../assets/generated/bg/carta-3.webp';
import bgPassi from '../assets/generated/bg/carta-1.webp';
import bgChi from '../assets/generated/bg/carta-2.webp';
import bgTake from '../assets/generated/bg/notte-5.webp';

const SLUG = 'accendere';
const ch = CHAPTERS.find((c) => c.slug === SLUG)!;
const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;

const passi = [
  { t: { it: 'L’attivazione della vostra org', en: 'Enabling your org' }, b: { it: 'Coworker si accende per organizzazione. La richiesta per la vostra IMS org la inoltriamo noi ad Adobe, con l’elenco delle applicazioni che avete in licenza. Per il settore finanziario serve una verifica interna Adobe (chi la firma e in quanti giorni lo scriviamo nella conferma): è il primo passo, non l’ultimo.', en: 'Coworker is enabled per organisation. We file the request for your IMS org with Adobe, listing the applications you license. For financial services an internal Adobe check is needed (who signs it and in how many days goes in the confirmation): it is the first step, not the last.' } },
  { t: { it: 'Il permesso in Admin Console', en: 'The permission in Admin Console' }, b: { it: 'Nel profilo di prodotto Analytics si accende <code>MCP Access</code> per le persone che useranno Coworker, insieme alle report suite che possono vedere. È un permesso separato da Workspace: senza, le domande falliscono anche se Workspace funziona.', en: 'In the Analytics product profile switch on <code>MCP Access</code> for the people who will use Coworker, together with the report suites they may see. It is separate from Workspace: without it, questions fail even though Workspace works.' } },
  { t: { it: 'L’accesso', en: 'Signing in' }, b: { it: 'Si entra da <code>experience.adobe.com/#/coworker</code> con la login aziendale e si sceglie l’organizzazione Poste Italiane. Niente da installare, niente da configurare sul tracciamento.', en: 'Open <code>experience.adobe.com/#/coworker</code> with the company login and pick the Poste Italiane organisation. Nothing to install, nothing to change in the tracking.' } },
  { t: { it: 'La prima domanda', en: 'The first question' }, b: { it: 'Si indica la report suite e si chiede. Coworker tiene la suite preferita nella memoria dell’utente e ricorda le convenzioni del team.', en: 'Name the report suite and ask. Coworker keeps the preferred suite in the user’s memory and remembers the team’s conventions.' } },
];

const chi = [
  { k: { it: 'I permessi', en: 'Permissions' }, b: { it: 'Coworker vede le report suite, i segmenti e le metriche che l’utente vede in Workspace. Non di più. Chi non ha accesso a una suite non la troverà nemmeno chiedendo.', en: 'Coworker sees the report suites, segments and metrics the user sees in Workspace. No more. Someone without access to a suite will not find it by asking.' } },
  { k: { it: 'Lettura e scrittura', en: 'Read and write' }, b: { it: 'Dei ventitré strumenti del server MCP Analytics, diciannove non scrivono nulla. Quattro scrivono: segmenti, metriche calcolate, intervalli di date, progetti Workspace. Scrive solo chi ha già i diritti di authoring in Analytics, e ogni scrittura si può mettere dietro un’approvazione.', en: 'Of the twenty-three tools in the Analytics MCP server, nineteen write nothing. Four write: segments, calculated metrics, date ranges, Workspace projects. Only users who already hold authoring rights in Analytics can write, and every write can sit behind an approval.' } },
  { k: { it: 'Chi dovrebbe iniziare', en: 'Who should start' }, b: { it: 'Il vostro team, su una suite di sviluppo prima e su quella della SuperApp poi. Il business dalla settimana cinque, se la settimana quattro dice di sì: profilo Analytics, permesso e domande già provate da voi.', en: 'Your team, on a development suite first and on the SuperApp suite next. The business from week five, if week four says yes: an Analytics profile, the permission and questions you have already tested.' } },
];
---
<BaseLayout title={ch.label.it} preloadImage={bgCover.src}>
  <div class="fixed top-0 left-0 right-0 z-50">
    <SdNavigation currentPath={currentPath} base={base} />
  </div>

  <DeckContainer nextHref={href(base, nextSlug(SLUG))} prevHref={href(base, prevSlug(SLUG))}>

    <!-- ── Cover: la domanda ────────────────────────────────────────────── -->
    <Slide id="slide-cover" bg="inverse" align="center">
      <div slot="backdrop" class="sd-bg-notte" style={`--bg-src: url(${bgCover.src})`}></div>
      <div class="sd-q" data-reveal>
        <p class="sd-q-num"><span data-lang-it>Domanda {ch.num} · {ch.label.it}</span><span data-lang-en>Question {ch.num} · {ch.label.en}</span></p>
        <span class="sd-q-mark" aria-hidden="true"></span>
        <T as="h2" class="sd-q-title" it={`«${ch.question.it}»`} en={`“${ch.question.en}”`} data-reveal data-reveal-delay="0.08" />
        <T
          as="p"
          class="sd-q-lead"
          it="Coworker è disponibile da giugno 2026. La lettura delle report suite di Adobe Analytics è in rollout dal 2 ottobre, con la GA ancora dichiarata TBD. Accenderlo è un’attivazione, un permesso e un accesso: nessun rilascio sull’app, nessun tag da toccare."
          en="Coworker has been available since June 2026. Reading Adobe Analytics report suites has been rolling out since 2 October, with GA still declared TBD. Switching it on is an enablement, a permission and a sign-in: no app release, no tag to touch."
          data-reveal data-reveal-delay="0.15"
        />
        <p class="sd-src sd-src--center sd-on-dark" data-reveal data-reveal-delay="0.22">
          <span data-lang-it>Fonti:&nbsp;</span><span data-lang-en>Sources:&nbsp;</span>
          <a href={SOURCES.coworkerNews.url} target="_blank" rel="noopener noreferrer"><span data-lang-it>{SOURCES.coworkerNews.label.it}</span><span data-lang-en>{SOURCES.coworkerNews.label.en}</span></a>
          &nbsp;·&nbsp;<a href={SOURCES.aaRelease.url} target="_blank" rel="noopener noreferrer"><span data-lang-it>{SOURCES.aaRelease.label.it}</span><span data-lang-en>{SOURCES.aaRelease.label.en}</span></a>
        </p>
      </div>
    </Slide>

    <!-- ── Cos'è Coworker ────────────────────────────────────────────────── -->
    <Slide id="slide-cosa" bg="primary" align="center">
      <div slot="backdrop" class="sd-bg-carta" style={`--bg-src: url(${bgCosa.src})`}></div>
      <div class="sd-head" data-reveal>
        <T as="p" class="slide-eyebrow mb-3" it="Prima di accenderlo" en="Before switching it on" />
        <T as="h2" class="sd-head-title" it="Un assistente che legge Adobe Analytics" en="An assistant that reads Adobe Analytics" />
        <T
          as="p"
          class="sd-head-lead"
          it="Adobe CX Enterprise Coworker è l’assistente in chat di Adobe CX Enterprise. Si usa in chat, in linguaggio naturale (oggi in inglese), e lavora con le applicazioni che avete già. Per Analytics passa dal server MCP di Adobe (Model Context Protocol, lo standard con cui un assistente chiama le API): legge le report suite dove stanno, senza spostare un dato."
          en="Adobe CX Enterprise Coworker is Adobe CX Enterprise’s chat assistant. You use it in chat, in natural language (English today), and it works with the applications you already have. For Analytics it goes through Adobe’s MCP server (Model Context Protocol, the standard an assistant uses to call APIs): it reads report suites where they are, without moving any data."
        />
      </div>
      <div class="sd-steps sd-steps--3" data-reveal data-reveal-delay="0.14">
        <div class="sd-step">
          <span class="sd-step-n">1</span>
          <T as="p" class="sd-step-title" it="Chat" en="Chat" />
          <T as="p" class="sd-step-body" it="Domande in linguaggio naturale, risposte con tabelle e grafici, conversazione a più turni. Dal 2 ottobre ogni analisi si apre in Analysis Workspace per continuare a mano." en="Natural-language questions, answers with tables and charts, multi-turn conversation. From 2 October every analysis opens in Analysis Workspace to continue by hand." />
        </div>
        <div class="sd-step">
          <span class="sd-step-n">2</span>
          <T as="p" class="sd-step-title" it="Skill" en="Skills" />
          <T as="p" class="sd-step-body" it="Procedure ripetibili scritte in un file di testo: «il riepilogo del lunedì», «il controllo delle suite». Le scrive il team, le usa chiunque abbia il profilo Analytics e il permesso." en="Repeatable procedures written in a text file: “the Monday summary”, “the suite check”. The team writes them, anyone with the Analytics profile and the permission uses them." />
        </div>
        <div class="sd-step">
          <span class="sd-step-n">3</span>
          <T as="p" class="sd-step-title" it="Memoria e approvazioni" en="Memory and approvals" />
          <T as="p" class="sd-step-body" it="Ricorda la report suite e le convenzioni del team. Le scritture in Analytics si mettono dietro un’approvazione: le modifiche restano una vostra decisione." en="Remembers the report suite and the team’s conventions. Writes to Analytics sit behind an approval: changes remain your decision." />
        </div>
      </div>
      <p class="sd-src" data-reveal data-reveal-delay="0.24">
        <span data-lang-it>Fonti:&nbsp;</span><span data-lang-en>Sources:&nbsp;</span>
        <a href={SOURCES.coworkerChat.url} target="_blank" rel="noopener noreferrer"><span data-lang-it>{SOURCES.coworkerChat.label.it}</span><span data-lang-en>{SOURCES.coworkerChat.label.en}</span></a>
        &nbsp;·&nbsp;<a href={SOURCES.mcpDocs.url} target="_blank" rel="noopener noreferrer"><span data-lang-it>{SOURCES.mcpDocs.label.it}</span><span data-lang-en>{SOURCES.mcpDocs.label.en}</span></a>
      </p>
    </Slide>

    <!-- ── I quattro passi ───────────────────────────────────────────────── -->
    <Slide id="slide-passi" bg="secondary" align="center">
      <div slot="backdrop" class="sd-bg-azzurro" style={`--bg-src: url(${bgPassi.src})`}></div>
      <div class="sd-head" data-reveal>
        <T as="p" class="slide-eyebrow mb-3" it="Come lo accendo" en="How to switch it on" />
        <T as="h2" class="sd-head-title" it="Quattro passi, nessun rilascio" en="Four steps, no release" />
      </div>
      <div class="sd-steps" data-reveal data-reveal-delay="0.14">
        {passi.map((p, i) => (
          <div class="sd-step">
            <span class="sd-step-n">{i + 1}</span>
            <T as="p" class="sd-step-title" it={p.t.it} en={p.t.en} />
            <T as="p" class="sd-step-body" it={p.b.it} en={p.b.en} />
          </div>
        ))}
      </div>
      <p class="sd-src" data-reveal data-reveal-delay="0.24">
        <span data-lang-it>Fonti:&nbsp;</span><span data-lang-en>Sources:&nbsp;</span>
        <a href={SOURCES.mcpGuides.url} target="_blank" rel="noopener noreferrer"><span data-lang-it>{SOURCES.mcpGuides.label.it}</span><span data-lang-en>{SOURCES.mcpGuides.label.en}</span></a>
        &nbsp;·&nbsp;<a href={SOURCES.coworkerDocs.url} target="_blank" rel="noopener noreferrer"><span data-lang-it>{SOURCES.coworkerDocs.label.it}</span><span data-lang-en>{SOURCES.coworkerDocs.label.en}</span></a>
      </p>
    </Slide>

    <!-- ── Per chi ───────────────────────────────────────────────────────── -->
    <Slide id="slide-chi" bg="primary" align="center">
      <div slot="backdrop" class="sd-bg-carta" style={`--bg-src: url(${bgChi.src})`}></div>
      <div class="sd-head" data-reveal>
        <T as="p" class="slide-eyebrow mb-3" it="E per chi" en="And for whom" />
        <T as="h2" class="sd-head-title" it="Gli stessi dati di Workspace. Un permesso in più per entrare" en="The same data as Workspace. One extra permission to get in" />
      </div>
      <div class="w-full max-w-6xl mx-auto flex flex-col" data-reveal data-reveal-delay="0.14">
        {chi.map((r, i) => (
          <div class="sd-row">
            <div>
              <p class="sd-row-label"><span class="text-[var(--ink-mark)] mr-2 tabular-nums">0{i + 1}</span><span data-lang-it>{r.k.it}</span><span data-lang-en>{r.k.en}</span></p>
            </div>
            <T as="p" class="sd-row-body" it={r.b.it} en={r.b.en} />
          </div>
        ))}
      </div>
      <p class="sd-src" data-reveal data-reveal-delay="0.24">
        <span data-lang-it>Fonti:&nbsp;</span><span data-lang-en>Sources:&nbsp;</span>
        <a href={SOURCES.mcpTools.url} target="_blank" rel="noopener noreferrer"><span data-lang-it>{SOURCES.mcpTools.label.it}</span><span data-lang-en>{SOURCES.mcpTools.label.en}</span></a>
        &nbsp;·&nbsp;<a href={SOURCES.mcpGuides.url} target="_blank" rel="noopener noreferrer"><span data-lang-it>{SOURCES.mcpGuides.label.it}</span><span data-lang-en>{SOURCES.mcpGuides.label.en}</span></a>
        &nbsp;·&nbsp;<a href={SOURCES.mcpFaq.url} target="_blank" rel="noopener noreferrer"><span data-lang-it>{SOURCES.mcpFaq.label.it}</span><span data-lang-en>{SOURCES.mcpFaq.label.en}</span></a>
      </p>
    </Slide>

    <!-- ── Cosa ti porti a casa ──────────────────────────────────────────── -->
    <Slide id="slide-take" bg="inverse" align="center">
      <div slot="backdrop" class="sd-bg-notte" style={`--bg-src: url(${bgTake.src})`}></div>
      <div class="sd-take" data-reveal>
        <T as="p" class="slide-eyebrow mb-3 sd-on-dark" it="Cosa vi portate a casa" en="What you take home" />
        <T as="h2" class="sd-take-title" it="Lato vostro è un pomeriggio, senza toccare l’app" en="On your side it is an afternoon, without touching the app" />
        <div class="sd-take-grid" data-reveal data-reveal-delay="0.14">
          <div class="sd-take-item">
            <T as="p" class="sd-take-k" it="Tempo" en="Time" />
            <T as="p" class="sd-take-t" it="Un permesso in Admin Console e un accesso. <strong>Nessun rilascio</strong> sulla SuperApp, nessuna modifica a Tags (Launch)." en="One permission in Admin Console and one sign-in. <strong>No release</strong> on the SuperApp, no change to Tags (Launch)." />
          </div>
          <div class="sd-take-item">
            <T as="p" class="sd-take-k" it="Controllo" en="Control" />
            <T as="p" class="sd-take-t" it="Decidete voi chi lo usa e su quali suite. <strong>I permessi sono quelli di Analytics</strong>, per persona, e li date e togliete voi." en="You decide who uses it and on which suites. <strong>Permissions are Analytics permissions</strong>, per person, and you grant and revoke them." />
          </div>
          <div class="sd-take-item">
            <T as="p" class="sd-take-k" it="Costo" en="Cost" />
            <T as="p" class="sd-take-t" it="Adobe include il server MCP nell’entitlement Analytics; le sue chiamate contano sul vostro monte richieste di reporting. <strong>Coworker</strong> parte con crediti di prova, e il modello dopo i crediti va sul tavolo prima della settimana quattro." en="Adobe includes the MCP server in the Analytics entitlement; its calls count against your monthly report request allowance. <strong>Coworker</strong> starts with trial credits, and the pricing after the credits goes on the table before week four." />
          </div>
        </div>
        <T as="p" class="sd-caveat" it="<strong>Una cautela.</strong> Lato Adobe c’è la verifica interna per il settore finanziario (cosa esclude e a quali condizioni, per iscritto) e il calendario di attivazione: la settimana uno parte dalla conferma scritta." en="<strong>One caution.</strong> On Adobe’s side there is the financial-services internal check (what it excludes and on which conditions, in writing) and the enablement calendar: week one starts from the written confirmation." data-reveal data-reveal-delay="0.24" />
      </div>
    </Slide>

  </DeckContainer>
</BaseLayout>
