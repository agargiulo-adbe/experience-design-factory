---
import BaseLayout from '../layouts/BaseLayout.astro';
import { PAGE_REGISTRY as SLIDE_MAP_REGISTRY } from '../data/slides';
import AdminConsole from '@edf/core/blocks/admin/AdminConsole.astro';
import { href } from '@edf/core/utils/url.js';

const base = import.meta.env.BASE_URL;
const SUPABASE_URL = import.meta.env.PUBLIC_SUPABASE_URL ?? '';
const SUPABASE_ANON_KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY ?? '';

interface SlideEntry { id: string; label: string; }
interface PageEntry { slug: string; label: string; slides: SlideEntry[]; }

// La mappa delle slide vive in un posto solo: `src/data/slides.ts`, letta anche
// dall'anteprima rapida. Teneva due copie e avevano già divergito.
const PAGE_REGISTRY: PageEntry[] = SLIDE_MAP_REGISTRY;


interface SolutionEntry {
  id: string; name: string; shortName: string;
  pillar: string; description: string; appearsIn: string[];
}

// Il deck non ha slide gated: il registro delle soluzioni serve al tab «Sezioni»
// e alle etichette; i capitoli si accendono/spengono dal tab «Capitoli e slide».
const SOLUTIONS: SolutionEntry[] = [
  { id: 'coworker', name: 'Adobe CX Enterprise Coworker — Chat su Adobe Analytics', shortName: 'Coworker', pillar: 'analytics',
    description: 'Domande in linguaggio naturale sulle report suite, root-cause, apertura in Workspace, skill del team.', appearsIn: ['Accendere', 'Rispondere', 'Capire', 'Governare'] },
  { id: 'mcp', name: 'Server MCP Adobe Analytics — 23 strumenti', shortName: 'MCP Analytics', pillar: 'analytics',
    description: 'Discovery, report, descrizione e uso dei componenti; quattro scritture con approvazione. Incluso nella licenza Analytics.', appearsIn: ['Accendere', 'Governare', 'Proteggere', 'Evolvere'] },
  { id: 'target', name: 'Adobe Target in Coworker — evolutiva', shortName: 'Target', pillar: 'evolutive',
    description: 'Altre integrazioni di Coworker, Target compreso. Fuori dal pilota: valutazione a sé con chi governa i dati.', appearsIn: ['Evolvere'] },
];

const PILLAR_LABELS: Record<string, string> = { analytics: 'Adobe Analytics', evolutive: 'Evolutive' };
const PILLAR_ORDER = ['analytics', 'evolutive'];
const PILLAR_COLORS: Record<string, string> = { analytics: '#0047bb', evolutive: '#eedc00' };

const solutionGroups = PILLAR_ORDER
  .map((pillar) => ({ pillar, label: PILLAR_LABELS[pillar], color: PILLAR_COLORS[pillar], solutions: SOLUTIONS.filter((s) => s.pillar === pillar) }))
  .filter((g) => g.solutions.length > 0);

const allSolutionIds = SOLUTIONS.map((s) => s.id);
const deckHref = href(base, '/');
---
<BaseLayout title="Console — Sei domande · Poste Italiane">
  <AdminConsole
    projectSlug="poste-sei-domande"
    projectName="Sei domande"
    clientLabel="Adobe × Poste Italiane"
    deckHref={deckHref}
    pages={PAGE_REGISTRY}
    solutionGroups={solutionGroups}
    allSolutionIds={allSolutionIds}
    supabaseUrl={SUPABASE_URL}
    supabaseAnonKey={SUPABASE_ANON_KEY}
  />
</BaseLayout>
