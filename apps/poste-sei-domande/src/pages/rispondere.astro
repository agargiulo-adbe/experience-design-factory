---
import BaseLayout from '../layouts/BaseLayout.astro';
import SdNavigation from '../components/SdNavigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import T from '@edf/core/blocks/i18n/T.astro';
import { href } from '@edf/core/utils/url.js';
import { CHAPTERS, prevSlug, nextSlug } from '../data/chapters';
import { SOURCES } from '../data/sources';
import bgCover from '../assets/generated/bg/notte-2.webp';
import bgOggi from '../assets/generated/bg/carta-4.webp';
import bgChat from '../assets/generated/bg/carta-1.webp';
import bgSettimana from '../assets/generated/bg/carta-3.webp';
import bgTake from '../assets/generated/bg/notte-5.webp';

const SLUG = 'rispondere';
const ch = CHAPTERS.find((c) => c.slug === SLUG)!;
const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;

// «Oggi»: la sequenza in Workspace, come la racconta chi la fa.
const oggi = [
  { it: 'Arriva la domanda, alle dieci: «ieri, per sezione, solo iOS, contro lunedì scorso». Il progetto del lunedì c’è; la variante no.', en: 'The question lands at ten: “yesterday, by section, iOS only, against last Monday”. The Monday project exists; the variant does not.' },
  { it: 'Si apre Workspace, si sceglie la report suite della SuperApp, si imposta ieri contro la settimana prima.', en: 'Open Workspace, pick the SuperApp report suite, set yesterday against the week before.' },
  { it: 'Si trascinano visite, visitatori unici, le sezioni dell’app; si aggiunge il segmento «app» che qualcuno ha creato nel 2023.', en: 'Drag in visits, unique visitors, the app sections; add the “app” segment someone created in 2023.' },
  { it: 'Si controlla che i numeri tornino con la dashboard del lunedì. Non tornano: il segmento è un altro.', en: 'Check that the numbers match the Monday dashboard. They do not: it is a different segment.' },
  { it: 'Si esporta, si incolla in una slide, si scrive tre righe. Si risponde nel pomeriggio.', en: 'Export, paste into a slide, write three lines. The answer goes out in the afternoon.' },
];

// Dati ILLUSTRATIVI: sezioni plausibili della SuperApp, numeri inventati per la demo.
const righe = [
  { s: { it: 'Operazioni Veloci', en: 'Operazioni Veloci (quick operations)' }, v: '1,52 mln', d: '+2,1%', up: true },
  { s: { it: 'Spedizioni · tracking', en: 'Shipments · tracking' }, v: '1,05 mln', d: '+6,4%', up: true },
  { s: { it: 'Saldo e movimenti', en: 'Balance and movements' }, v: '0,88 mln', d: '−0,8%', up: false },
  { s: { it: 'Ricariche Postepay', en: 'Postepay top-ups' }, v: '0,61 mln', d: '+1,3%', up: true },
  { s: { it: 'Bollettini', en: 'Payment slips' }, v: '0,19 mln', d: '+4,2%', up: true },
];
---
<BaseLayout title={ch.label.it} preloadImage={bgCover.src}>
  <div class="fixed top-0 left-0 right-0 z-50">
    <SdNavigation currentPath={currentPath} base={base} />
  </div>

  <DeckContainer nextHref={href(base, nextSlug(SLUG))} prevHref={href(base, prevSlug(SLUG))}>

    <!-- ── Cover ─────────────────────────────────────────────────────────── -->
    <Slide id="slide-cover" bg="inverse" align="center">
      <div slot="backdrop" class="sd-bg-notte" style={`--bg-src: url(${bgCover.src})`}></div>
      <div class="sd-q" data-reveal>
        <p class="sd-q-num"><span data-lang-it>Domanda {ch.num} · {ch.label.it}</span><span data-lang-en>Question {ch.num} · {ch.label.en}</span></p>
        <span class="sd-q-mark" aria-hidden="true"></span>
        <T as="h2" class="sd-q-title" it={`«${ch.question.it}»`} en={`“${ch.question.en}”`} data-reveal data-reveal-delay="0.08" />
        <T
          as="p"
          class="sd-q-lead"
          it="La domanda più frequente e la più semplice. Il progetto del lunedì esiste già: è la variante chiesta al volo che costa un pomeriggio. È la prima da spostare in una chat, perché la risposta è già nella report suite."
          en="The most frequent question and the simplest. The Monday project already exists: it is the variant asked on the spot that costs an afternoon. It is the first to move into a chat, because the answer is already in the report suite."
          data-reveal data-reveal-delay="0.15"
        />
      </div>
    </Slide>

    <!-- ── Oggi ──────────────────────────────────────────────────────────── -->
    <Slide id="slide-oggi" bg="secondary" align="center">
      <div slot="backdrop" class="sd-bg-azzurro" style={`--bg-src: url(${bgOggi.src})`}></div>
      <div class="sd-head" data-reveal>
        <T as="p" class="slide-eyebrow mb-3" it="Oggi, in Workspace" en="Today, in Workspace" />
        <T as="h2" class="sd-head-title" it="Cinque passaggi per una risposta" en="Five steps for one answer" />
      </div>
      <div class="sd-split" data-reveal data-reveal-delay="0.14">
        <div class="sd-today">
          <T as="p" class="sd-today-k" it="La sequenza, come la fa il team" en="The sequence, as the team does it" />
          <ol class="sd-today-ol">
            {oggi.map((o, i) => (
              <li class="sd-today-li"><span class="sd-today-n">{i + 1}</span><T as="span" it={o.it} en={o.en} /></li>
            ))}
          </ol>
        </div>
        <div class="sd-panel sd-panel--grigio">
          <div class="sd-panel-head"><T as="span" class="sd-tag sd-tag--grigio" it="Dove si perde tempo" en="Where the time goes" /></div>
          <ul class="sd-ul">
            <li class="sd-li"><span class="sd-dot sd-dot--grigio"></span><T as="span" it="<strong>Non nella query.</strong> Workspace risponde in secondi. Si perde nel trovare il segmento giusto, nel far tornare i numeri, nell’impaginare." en="<strong>Not in the query.</strong> Workspace answers in seconds. Time goes into finding the right segment, reconciling numbers, laying out the slide." /></li>
            <li class="sd-li"><span class="sd-dot sd-dot--grigio"></span><T as="span" it="<strong>Nella coda.</strong> Chi chiede aspetta chi sa costruire. Se il team è occupato, la domanda slitta a domani." en="<strong>In the queue.</strong> Whoever asks waits for whoever can build. If the team is busy, the question slips to tomorrow." /></li>
            <li class="sd-li"><span class="sd-dot sd-dot--grigio"></span><T as="span" it="<strong>Nella ripetizione.</strong> La stessa domanda torna ogni settimana con una data diversa. Il progetto si rifà, o si duplica." en="<strong>In repetition.</strong> The same question comes back every week with a different date. The project is rebuilt, or duplicated." /></li>
          </ul>
          <T as="p" class="sd-today-sum mt-4" it="La variante è pronta nel pomeriggio. Il dato era già nella report suite alle otto del mattino." en="The variant is ready in the afternoon. The data was already in the report suite at eight in the morning." />
        </div>
      </div>
    </Slide>

    <!-- ── Con Coworker ──────────────────────────────────────────────────── -->
    <Slide id="slide-chat" bg="primary" align="center">
      <div slot="backdrop" class="sd-bg-carta" style={`--bg-src: url(${bgChat.src})`}></div>
      <div class="sd-head" data-reveal>
        <T as="p" class="slide-eyebrow mb-3" it="Con Coworker" en="With Coworker" />
        <T as="h2" class="sd-head-title" it="La stessa domanda, chiesta a parole" en="The same question, asked in plain words" />
      </div>
      <div class="sd-split" data-reveal data-reveal-delay="0.14">
        <div class="sd-panel sd-panel--blu">
          <div class="sd-panel-head"><T as="span" class="sd-tag" it="Cosa succede" en="What happens" /></div>
          <ul class="sd-ul">
            <li class="sd-li"><span class="sd-dot"></span><T as="span" it="Coworker riconosce la report suite che avete messo in memoria e traduce «ieri» in un intervallo di date, sul fuso della report suite." en="Coworker recognises the report suite you saved in memory and turns “yesterday” into a date range, on the report suite’s time zone." /></li>
            <li class="sd-li"><span class="sd-dot"></span><T as="span" it="Cerca le dimensioni e le metriche con i nomi vostri: sezioni dell’app, visite, visitatori unici." en="It looks up dimensions and metrics with your names: app sections, visits, unique visitors." /></li>
            <li class="sd-li"><span class="sd-dot"></span><T as="span" it="Esegue il report, confronta con la settimana prima, scrive tre righe di lettura. Legge soltanto: non tocca nulla." en="It runs the report, compares with the week before, writes three lines of reading. It only reads: it touches nothing." /></li>
            <li class="sd-li"><span class="sd-dot"></span><T as="span" it="Su richiesta crea in Analysis Workspace un progetto con la stessa tabella, e ne dà il link." en="On request it creates an Analysis Workspace project with the same table, and returns the link." /></li>
          </ul>
        </div>
        <div class="sd-chat" aria-label="Coworker Chat">
          <div class="sd-chat-bar"><span class="sd-chat-bar-dot"></span><span class="sd-chat-bar-title">Coworker Chat</span><span class="sd-chat-bar-scope">Adobe Analytics · SuperApp · demo</span></div>
          <div class="sd-chat-body">
            <div class="sd-msg sd-msg--user"><span class="sd-msg-avatar"><span data-lang-it>Tu</span><span data-lang-en>You</span></span>
              <T as="p" class="sd-msg-text" it="Com’è andata ieri sulla SuperApp? Visite per sezione, confronto con lo stesso giorno della settimana scorsa." en="How did the SuperApp do yesterday? Visits by section, compared with the same day last week." />
            </div>
            <div class="sd-msg sd-msg--cw"><span class="sd-msg-avatar">CW</span>
              <div class="min-w-0 flex-1">
                <T as="p" class="sd-msg-text" it="Ieri la SuperApp ha registrato <strong>4,6 milioni di visite</strong>, +2,9% sullo stesso giorno della settimana prima. Le cinque sezioni più viste:" en="Yesterday the SuperApp recorded <strong>4.6 million visits</strong>, +2.9% on the same day last week. The five most-viewed sections:" />
                <div class="sd-msg-block">
                  <table class="sd-table">
                    <thead><tr><th><span data-lang-it>Sezione</span><span data-lang-en>Section</span></th><th class="num"><span data-lang-it>Visite</span><span data-lang-en>Visits</span></th><th class="num">Δ</th></tr></thead>
                    <tbody>
                      {righe.map((r) => (
                        <tr><td><span data-lang-it>{r.s.it}</span><span data-lang-en>{r.s.en}</span></td><td class="num">{r.v}</td><td class:list={['num', r.up ? 'up' : 'down']}>{r.d}</td></tr>
                      ))}
                    </tbody>
                  </table>
                </div>
                <T as="p" class="sd-msg-text mt-2" it="Cresce soprattutto il tracking spedizioni. Saldo e movimenti è l’unica sezione in calo, dentro la normale oscillazione del giorno." en="Shipment tracking grows most. Balance and movements is the only section down, within the normal daily swing." />
                <div class="sd-chips"><span class="sd-chip"><span data-lang-it>Apri in Analysis Workspace</span><span data-lang-en>Open in Analysis Workspace</span></span><span class="sd-chip"><span data-lang-it>Trend a 4 settimane</span><span data-lang-en>4-week trend</span></span><span class="sd-chip"><span data-lang-it>Solo iOS</span><span data-lang-en>iOS only</span></span></div>
              </div>
            </div>
          </div>
          <T as="p" class="sd-chat-note" it="Esempio con dati illustrativi, chat tradotta: oggi Coworker risponde in inglese · sezioni e metriche da confermare sulla vostra istanza" en="Example with illustrative data, translated chat: today Coworker answers in English · sections and metrics to confirm on your instance" />
        </div>
      </div>
      <p class="sd-src" data-reveal data-reveal-delay="0.24">
        <span data-lang-it>Fonti:&nbsp;</span><span data-lang-en>Sources:&nbsp;</span>
        <a href={SOURCES.aaRelease.url} target="_blank" rel="noopener noreferrer"><span data-lang-it>{SOURCES.aaRelease.label.it}</span><span data-lang-en>{SOURCES.aaRelease.label.en}</span></a>
        &nbsp;·&nbsp;<a href={SOURCES.mcpTools.url} target="_blank" rel="noopener noreferrer"><span data-lang-it>{SOURCES.mcpTools.label.it}</span><span data-lang-en>{SOURCES.mcpTools.label.en}</span></a>
      </p>
    </Slide>

    <!-- ── Il riepilogo settimanale ──────────────────────────────────────── -->
    <Slide id="slide-settimana" bg="primary" align="center">
      <div slot="backdrop" class="sd-bg-carta" style={`--bg-src: url(${bgSettimana.src})`}></div>
      <div class="sd-head" data-reveal>
        <T as="p" class="slide-eyebrow mb-3" it="La domanda che torna ogni settimana" en="The question that comes back every week" />
        <T as="h2" class="sd-head-title" it="Il riepilogo del lunedì, scritto una volta" en="The Monday summary, written once" />
        <T
          as="p"
          class="sd-head-lead"
          it="La procedura si scrive in una skill: cinque indicatori, tre letture, il formato che il business è abituato a ricevere. Il lunedì chiunque del team la lancia con una frase. Per chiedere serve un profilo Analytics con la suite e il permesso; chi non lo ha riceve il riepilogo da un collega del team, chi ce l’ha lo apre e va avanti."
          en="The procedure is written in a skill: five indicators, three readings, the format the business is used to receiving. On Monday anyone on the team runs it with one sentence. Asking needs an Analytics profile with the suite and the permission; those without it get the summary from a team colleague, those with it open it and carry on."
        />
      </div>
      <div class="sd-steps sd-steps--3" data-reveal data-reveal-delay="0.14">
        <div class="sd-step">
          <span class="sd-step-n sd-step-n--giallo">1</span>
          <T as="p" class="sd-step-title" it="La skill «riepilogo-settimana»" en="The “weekly-summary” skill" />
          <T as="p" class="sd-step-body" it="Un file di testo: quale suite, quali metriche, quali segmenti (per ID, gli stessi del report certificato), come confrontare, come scrivere. Lo scrive il team una volta." en="A text file: which suite, which metrics, which segments (by ID, the same as the certified report), how to compare, how to write. The team writes it once." />
        </div>
        <div class="sd-step">
          <span class="sd-step-n sd-step-n--giallo">2</span>
          <T as="p" class="sd-step-title" it="La frase del lunedì" en="The Monday sentence" />
          <T as="p" class="sd-step-body" it="«Riepilogo della settimana per la SuperApp.» Coworker esegue i report, applica i segmenti condivisi, produce tabella e lettura." en="“Weekly summary for the SuperApp.” Coworker runs the reports, applies the shared segments, produces table and reading." />
        </div>
        <div class="sd-step">
          <span class="sd-step-n sd-step-n--giallo">3</span>
          <T as="p" class="sd-step-title" it="La verifica resta vostra" en="The check stays yours" />
          <T as="p" class="sd-step-body" it="Il primo mese si confrontano i numeri col report certificato. Se tornano, il riepilogo smette di essere lavoro." en="For the first month, compare the numbers with the certified report. If they match, the summary stops being work." />
        </div>
      </div>
      <p class="sd-src" data-reveal data-reveal-delay="0.24">
        <span data-lang-it>Fonti:&nbsp;</span><span data-lang-en>Sources:&nbsp;</span>
        <a href={SOURCES.coworkerChat.url} target="_blank" rel="noopener noreferrer"><span data-lang-it>{SOURCES.coworkerChat.label.it}</span><span data-lang-en>{SOURCES.coworkerChat.label.en}</span></a>
      </p>
    </Slide>

    <!-- ── Take ──────────────────────────────────────────────────────────── -->
    <Slide id="slide-take" bg="inverse" align="center">
      <div slot="backdrop" class="sd-bg-notte" style={`--bg-src: url(${bgTake.src})`}></div>
      <div class="sd-take" data-reveal>
        <T as="p" class="slide-eyebrow mb-3 sd-on-dark" it="Cosa vi portate a casa" en="What you take home" />
        <T as="h2" class="sd-take-title" it="La domanda semplice smette di passare dal team" en="The simple question stops going through the team" />
        <div class="sd-take-grid" data-reveal data-reveal-delay="0.14">
          <div class="sd-take-item">
            <T as="p" class="sd-take-k" it="Tempo" en="Time" />
            <T as="p" class="sd-take-t" it="Dal pomeriggio a <strong>pochi minuti</strong>. Il progetto Workspace nasce solo se serve andare oltre." en="From the afternoon to <strong>a few minutes</strong>. The Workspace project is born only if you need to go further." />
          </div>
          <div class="sd-take-item">
            <T as="p" class="sd-take-k" it="Indipendenza" en="Independence" />
            <T as="p" class="sd-take-t" it="Chi ha il permesso chiede da sé. <strong>Il team scrive le regole</strong>, non le risposte." en="Whoever has the permission asks on their own. <strong>The team writes the rules</strong>, not the answers." />
          </div>
          <div class="sd-take-item">
            <T as="p" class="sd-take-k" it="Coerenza" en="Consistency" />
            <T as="p" class="sd-take-t" it="Stessa suite, stessi segmenti, stesso formato ogni settimana: <strong>i numeri tornano</strong>." en="Same suite, same segments, same format every week: <strong>the numbers match</strong>." />
          </div>
        </div>
        <T as="p" class="sd-caveat" it="<strong>Un limite.</strong> Coworker legge ciò che è nella report suite: se un segmento è definito male, la risposta lo eredita. Il primo mese si valida sul report certificato, sempre." en="<strong>One limit.</strong> Coworker reads what is in the report suite: if a segment is badly defined, the answer inherits it. For the first month, validate on the certified report, always." data-reveal data-reveal-delay="0.24" />
      </div>
    </Slide>

  </DeckContainer>
</BaseLayout>
