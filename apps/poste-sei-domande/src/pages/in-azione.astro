---
import BaseLayout from '../layouts/BaseLayout.astro';
import SdNavigation from '../components/SdNavigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import T from '@edf/core/blocks/i18n/T.astro';
import { href } from '@edf/core/utils/url.js';
import { CHAPTERS, prevSlug, nextSlug } from '../data/chapters';
import { SOURCES } from '../data/sources';
import bgCover from '../assets/generated/bg/notte-4.webp';
import bgPrima from '../assets/generated/bg/carta-2.webp';
import bgZero from '../assets/generated/bg/carta-4.webp';
import bgUno from '../assets/generated/bg/carta-1.webp';
import bgDue from '../assets/generated/bg/carta-3.webp';
import bgTake from '../assets/generated/bg/notte-1.webp';

const SLUG = 'in-azione';
const ch = CHAPTERS.find((c) => c.slug === SLUG)!;
const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;
const media = `${base.replace(/\/?$/, '/')}media/`;

// Una sola registrazione dell'organizzazione dimostrativa Adobe, caricata su
// YouTube come video non in elenco, divisa nei tre punti in cui cambia
// registro: prima si configura il contesto, poi si fanno domande sui dati,
// infine si chiede un documento finito.
//
// Facciata con poster, non iframe: il player di terzi nasce al clic. Così la
// pagina non carica YouTube su ogni slide, l'audit non aspetta la rete, e
// niente cookie di terzi finché qualcuno non decide di guardare.
const YT = 'XE5yH5qXbtc';
const clip = {
  zero: { start: 0,   end: 125, poster: `${media}sd-azione-00-contesto.poster.jpg` },
  uno:  { start: 125, end: 300, poster: `${media}sd-azione-01-riepilogo.poster.jpg` },
  due:  { start: 300, end: 399, poster: `${media}sd-azione-02-documento.poster.jpg` },
};

// Le tre cose da dire PRIMA di far partire una clip, non dopo.
const prima = [
  {
    t: { it: 'È l’organizzazione dimostrativa Adobe', en: 'It is Adobe’s demo organisation' },
    b: {
      it: 'Non la vostra istanza. I numeri che si vedono sono di una sandbox e non hanno la scala di Poste: non vanno letti, vanno guardati per la forma.',
      en: 'Not your instance. The numbers on screen are a sandbox’s and have nothing like Poste’s scale: they are not to be read, only looked at for their shape.',
    },
  },
  {
    t: { it: 'Gira su dati dimostrativi in CJA', en: 'It runs on demo data in CJA' },
    b: {
      it: 'Quello che si trasferisce al vostro caso è <strong>la forma della conversazione e dell’uscita</strong>, non la lettura delle vostre report suite. Su Adobe Analytics cambia la fonte, non il modo di chiedere.',
      en: 'What carries over to your case is <strong>the shape of the conversation and of the output</strong>, not the reading of your report suites. On Adobe Analytics the source changes, not the way you ask.',
    },
  },
  {
    t: { it: 'Su Analytics è in rollout', en: 'On Analytics it is rolling out' },
    b: {
      it: 'La lettura delle report suite di Adobe Analytics è in rollout dal 2 ottobre e la GA non è ancora dichiarata. Le clip mostrano il prodotto, non una data.',
      en: 'Reading Adobe Analytics report suites has been rolling out since 2 October and GA is not yet declared. The clips show the product, not a date.',
    },
  },
];

const guarda0 = [
  { it: 'Un interruttore <strong>Utente / Organizzazione</strong>: 290 skill installate, 78 dell’organizzazione, 2 personali. Chi scrive una procedura decide se resta sua o diventa di tutti.', en: 'A <strong>User / Org</strong> switch: 290 skills installed, 78 from the organisation, 2 personal. Whoever writes a procedure decides whether it stays theirs or becomes everyone’s.' },
  { it: 'La memoria fra una conversazione e l’altra è <strong>spenta di serie</strong>: la schermata lo dice e rimanda ad Adobe.', en: 'Memory across conversations is <strong>off by default</strong>: the screen says so and points to Adobe.' },
  { it: 'Nella scheda del marchio un documento solo, <code>Poste_Italiane_Brand_Guidelines.pdf</code>: da lì risultano <strong>49 controlli collegati</strong>.', en: 'The brand record holds one document, <code>Poste_Italiane_Brand_Guidelines.pdf</code>: from it, <strong>49 linked checks</strong>.' },
  { it: 'Ogni regola ha un nome — <code>brand_voice.lexicon.use-specific-action-led-ctas</code> — la frase italiana da cui è nata e il rimando alla pagina. Lì c’è il vocabolario: «verbi semplici: scopri, paga, invia, cerca».', en: 'Each rule carries a name — <code>brand_voice.lexicon.use-specific-action-led-ctas</code> — the Italian line it came from, and a link to the page. That is where the vocabulary sits: “simple verbs: scopri, paga, invia, cerca”.' },
];

const guarda1 = [
  { it: 'La domanda è scritta <strong>in italiano</strong>, come si direbbe a voce: «Mostrami il trend giornaliero degli utenti della SuperApp da aprile a luglio ed evidenzia le anomalie».', en: 'The question is typed <strong>in Italian</strong>, the way you would say it: “Show me the daily trend of SuperApp users from April to July and highlight the anomalies.”' },
  { it: 'Mentre lavora <strong>mostra i passaggi</strong>: quali skill carica, quanti script esegue. A un certo punto scrive «Retrying» e riprova da sé.', en: 'As it works it <strong>shows its steps</strong>: which skills it loads, how many scripts it runs. At one point it writes “Retrying” and tries again on its own.' },
  { it: 'Il grafico marca <strong>dieci anomalie</strong> e le spiega a parole. Poi le sezioni, e l’App contro il sito: <strong>Prestiti, Poste Vita e Conto BancoPosta oggi passano quasi solo dal web</strong>.', en: 'The chart marks <strong>ten anomalies</strong> and explains them in words. Then the sections, and the App against the site: <strong>Prestiti, Poste Vita and Conto BancoPosta today go almost only through the web</strong>.' },
  { it: 'All’ultima domanda, sulla distribuzione oraria, <strong>si ferma</strong>: «con questi dati non si può individuare una vera ora di picco. È un limite della demo da dichiarare, non un risultato sull’uso dei clienti».', en: 'On the last question, about the hourly distribution, it <strong>stops</strong>: “with this data a real peak hour cannot be identified. It is a limit of the demo to be declared, not a finding about customer behaviour.”' },
];

const guarda2 = [
  { it: 'Prima il riepilogo a schermo: <strong>otto indicatori</strong>, luglio contro giugno, «cosa è cambiato» e tre raccomandazioni numerate.', en: 'First the summary on screen: <strong>eight indicators</strong>, July against June, “what changed” and three numbered recommendations.' },
  { it: 'È Coworker a proporre il passo dopo. La richiesta è una riga: «puoi generare un PDF per il management di Poste Italiane?».', en: 'Coworker is the one offering the next step. The request is one line: “can you generate a PDF for Poste Italiane management?”' },
  { it: 'Il documento è di <strong>tre pagine</strong>: copertina con destinatari e periodo, la tabella degli otto indicatori con il grafico delle variazioni, i tre cambiamenti e le tre raccomandazioni.', en: 'The document runs to <strong>three pages</strong>: a cover with recipients and period, the table of eight indicators with the change chart, the three shifts and the three recommendations.' },
  { it: 'Giallo Poste, Blu Poste, Helvetica, piè di pagina numerato: escono dalle <strong>regole della Parte 1</strong>. E dichiara di aver riletto le tre pagine e corretto le etichette del grafico che si sovrapponevano alle barre.', en: 'Poste yellow, Poste blue, Helvetica, numbered footer: they come out of <strong>the rules from Part 1</strong>. And it states it re-read all three pages and fixed the chart labels that were overlapping the bars.' },
];
---
<BaseLayout title={ch.label.it} preloadImage={bgCover.src}>
  <div class="fixed top-0 left-0 right-0 z-50">
    <SdNavigation currentPath={currentPath} base={base} />
  </div>

  <DeckContainer nextHref={href(base, nextSlug(SLUG))} prevHref={href(base, prevSlug(SLUG))}>

    <!-- ── Cover ─────────────────────────────────────────────────────────── -->
    <Slide id="slide-cover" bg="inverse" align="center" data-made-with="Firefly" data-made-with-for="sfondo">
      <div slot="backdrop" class="sd-bg-notte" style={`--bg-src: url(${bgCover.src})`}></div>
      <div class="sd-q" data-reveal>
        <p class="sd-q-num"><span data-lang-it>Intermezzo · {ch.label.it}</span><span data-lang-en>Interlude · {ch.label.en}</span></p>
        <span class="sd-q-mark" aria-hidden="true"></span>
        <T as="h2" class="sd-q-title" it="Una demo, in tre tratti" en="One demo, in three parts" data-reveal data-reveal-delay="0.08" />
        <T
          as="p"
          class="sd-q-lead"
          it="Fin qui sono parole. Questa è una registrazione di Coworker che lavora, tagliata dove la demo cambia registro: prima si carica il contesto di Poste e si vede chi lo possiede, poi arrivano quattro domande in italiano sui dati, infine una richiesta sola che diventa un documento per il management. Gira sull’organizzazione dimostrativa Adobe, e la pagina qui dopo dice che cosa vale e che cosa no."
          en="So far these are words. This is a recording of Coworker working, cut where the demo changes register: first the Poste context is loaded and you see who owns it, then four questions in Italian about the data, finally a single request that becomes a management document. It runs on Adobe’s demo organisation, and the page that follows says what carries over and what does not."
          data-reveal data-reveal-delay="0.15"
        />
      </div>
    </Slide>

    <!-- ── Prima di guardarle ────────────────────────────────────────────── -->
    <Slide id="slide-prima" bg="secondary" align="center">
      <div slot="backdrop" class="sd-bg-azzurro" style={`--bg-src: url(${bgPrima.src})`}></div>
      <div class="sd-head" data-reveal>
        <T as="p" class="slide-eyebrow mb-3" it="Prima di guardarle" en="Before watching them" />
        <T as="h2" class="sd-head-title" it="Tre cose, dette prima e non dopo" en="Three things, said before and not after" />
        <T
          as="p"
          class="sd-head-lead"
          it="Una demo che si spiega dopo è una demo che ha già creato l’aspettativa sbagliata. Queste tre righe valgono per tutti e tre i tratti."
          en="A demo explained afterwards is a demo that has already set the wrong expectation. These three lines hold for all three parts."
        />
      </div>
      <div class="sd-steps sd-steps--3" data-reveal data-reveal-delay="0.14">
        {prima.map((p, i) => (
          <div class="sd-step">
            <span class="sd-step-n">{i + 1}</span>
            <T as="p" class="sd-step-title" it={p.t.it} en={p.t.en} />
            <T as="p" class="sd-step-body" it={p.b.it} en={p.b.en} />
          </div>
        ))}
      </div>
      <p class="sd-src" data-reveal data-reveal-delay="0.24">
        <span data-lang-it>Fonti:&nbsp;</span><span data-lang-en>Sources:&nbsp;</span>
        <a href={SOURCES.aaRelease.url} target="_blank" rel="noopener noreferrer"><span data-lang-it>{SOURCES.aaRelease.label.it}</span><span data-lang-en>{SOURCES.aaRelease.label.en}</span></a>
        &nbsp;·&nbsp;<span data-lang-it>clip registrate sull’organizzazione dimostrativa Adobe, 6 ottobre 2026</span><span data-lang-en>clips recorded on Adobe’s demo organisation, 6 October 2026</span>
      </p>
    </Slide>

    <!-- ── Clip 0 · Il contesto ──────────────────────────────────────────── -->
    <Slide id="slide-clip-contesto" bg="primary" align="center">
      <div slot="backdrop" class="sd-bg-carta" style={`--bg-src: url(${bgZero.src})`}></div>
      <div class="sd-head" data-reveal>
        <T as="p" class="slide-eyebrow mb-3" it="Parte 1 · due minuti" en="Part 1 · two minutes" />
        <T as="h2" class="sd-head-title" it="Prima di rispondere, che cosa sa di voi" en="Before it answers, what it knows about you" />
      </div>
      <div class="sd-split sd-split--media" data-reveal data-reveal-delay="0.14">
        <div class="sd-clip">
          <button type="button" class="sd-clip-v sd-clip-play" data-yt={YT} data-start={clip.zero.start} data-end={clip.zero.end} style={`--poster: url(${clip.zero.poster})`}>
            <span class="sd-clip-badge" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5.5v13l11-6.5z"/></svg>
            </span>
            <span class="sr-only" data-lang-it>Guarda il primo tratto della demo</span><span class="sr-only" data-lang-en>Play the first part of the demo</span>
          </button>
          <T as="p" class="sd-clip-cap" it="Organizzazione dimostrativa Adobe · 6 ottobre 2026" en="Adobe demo organisation · 6 October 2026" />
        </div>
        <div class="sd-panel sd-panel--blu">
          <div class="sd-panel-head"><T as="span" class="sd-tag" it="Che cosa guardare" en="What to watch" /></div>
          <ul class="sd-ul">
            {guarda0.map((g) => (
              <li class="sd-li"><span class="sd-dot"></span><T as="span" it={g.it} en={g.en} /></li>
            ))}
          </ul>
        </div>
      </div>
      <T
        as="p"
        class="sd-arch-note"
        it="<strong>Quello che non dice.</strong> La scheda del marchio è una configurazione a sé, fuori dall’attivazione su Analytics: si verifica a parte."
        en="<strong>What it does not say.</strong> The brand record is a configuration of its own, outside the Analytics switch-on: it is checked separately."
        data-reveal data-reveal-delay="0.24"
      />
    </Slide>

    <!-- ── Clip 2 · Il riepilogo ─────────────────────────────────────────── -->
    <Slide id="slide-clip-riepilogo" bg="secondary" align="center">
      <div slot="backdrop" class="sd-bg-azzurro" style={`--bg-src: url(${bgUno.src})`}></div>
      <div class="sd-head" data-reveal>
        <T as="p" class="slide-eyebrow mb-3" it="Parte 2 · quasi tre minuti" en="Part 2 · almost three minutes" />
        <T as="h2" class="sd-head-title" it="Quattro domande, in italiano" en="Four questions, in Italian" />
      </div>
      <div class="sd-split sd-split--media" data-reveal data-reveal-delay="0.14">
        <div class="sd-clip">
          <button type="button" class="sd-clip-v sd-clip-play" data-yt={YT} data-start={clip.uno.start} data-end={clip.uno.end} style={`--poster: url(${clip.uno.poster})`}>
            <span class="sd-clip-badge" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5.5v13l11-6.5z"/></svg>
            </span>
            <span class="sr-only" data-lang-it>Guarda il primo tratto della demo</span><span class="sr-only" data-lang-en>Play the first part of the demo</span>
          </button>
          <T as="p" class="sd-clip-cap" it="Organizzazione dimostrativa Adobe · dati di sandbox · registrata il 6 ottobre 2026" en="Adobe demo organisation · sandbox data · recorded 6 October 2026" />
        </div>
        <div class="sd-panel sd-panel--blu">
          <div class="sd-panel-head"><T as="span" class="sd-tag" it="Che cosa guardare" en="What to watch" /></div>
          <ul class="sd-ul">
            {guarda1.map((g) => (
              <li class="sd-li"><span class="sd-dot"></span><T as="span" it={g.it} en={g.en} /></li>
            ))}
          </ul>
        </div>
      </div>
    </Slide>

    <!-- ── Clip 3 · Il documento ─────────────────────────────────────────── -->
    <Slide id="slide-clip-documento" bg="primary" align="center">
      <div slot="backdrop" class="sd-bg-carta" style={`--bg-src: url(${bgDue.src})`}></div>
      <div class="sd-head" data-reveal>
        <T as="p" class="slide-eyebrow mb-3" it="Parte 3 · un minuto e quaranta" en="Part 3 · one minute forty" />
        <T as="h2" class="sd-head-title" it="Una richiesta, un documento finito" en="One request, a finished document" />
      </div>
      <div class="sd-split sd-split--media" data-reveal data-reveal-delay="0.14">
        <div class="sd-clip">
          <button type="button" class="sd-clip-v sd-clip-play" data-yt={YT} data-start={clip.due.start} data-end={clip.due.end} style={`--poster: url(${clip.due.poster})`}>
            <span class="sd-clip-badge" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5.5v13l11-6.5z"/></svg>
            </span>
            <span class="sr-only" data-lang-it>Guarda il secondo tratto della demo</span><span class="sr-only" data-lang-en>Play the second part of the demo</span>
          </button>
          <T as="p" class="sd-clip-cap" it="Organizzazione dimostrativa Adobe · dati di sandbox · registrata il 6 ottobre 2026" en="Adobe demo organisation · sandbox data · recorded 6 October 2026" />
        </div>
        <div class="sd-panel sd-panel--blu">
          <div class="sd-panel-head"><T as="span" class="sd-tag" it="Che cosa guardare" en="What to watch" /></div>
          <ul class="sd-ul">
            {guarda2.map((g) => (
              <li class="sd-li"><span class="sd-dot"></span><T as="span" it={g.it} en={g.en} /></li>
            ))}
          </ul>
        </div>
      </div>
    </Slide>

    <!-- ── Cosa resta ────────────────────────────────────────────────────── -->
    <Slide id="slide-take" bg="inverse" align="center" data-made-with="Firefly" data-made-with-for="sfondo">
      <div slot="backdrop" class="sd-bg-notte" style={`--bg-src: url(${bgTake.src})`}></div>
      <div class="sd-take" data-reveal>
        <T as="p" class="slide-eyebrow mb-3 sd-on-dark" it="Che cosa resta dei tre tratti" en="What the three parts leave behind" />
        <T as="h2" class="sd-take-title" it="Una demo intera vale più di tre slide di benefici" en="A whole demo is worth more than three slides of benefits" />
        <div class="sd-take-grid" data-reveal data-reveal-delay="0.14">
          <div class="sd-take-item">
            <T as="p" class="sd-take-k" it="Quello che si vede" en="What you see" />
            <T as="p" class="sd-take-t" it="La <strong>forma</strong>: come si carica il contesto e chi lo possiede, come si chiede, che cosa esce. Sulle vostre suite cambia la fonte, non il modo di chiedere." en="The <strong>shape</strong>: how context is loaded and who owns it, how you ask, what comes out. On your suites the source changes, not the way you ask." />
          </div>
          <div class="sd-take-item">
            <T as="p" class="sd-take-k" it="Quello che non si vede" en="What you do not see" />
            <T as="p" class="sd-take-t" it="I vostri numeri, la vostra scala, i vostri nomi di sezione. <strong>Quello arriva con la prova</strong>, sulla suite di sviluppo, con le vostre domande." en="Your numbers, your scale, your section names. <strong>That comes with the trial</strong>, on the development suite, with your questions." />
          </div>
          <div class="sd-take-item">
            <T as="p" class="sd-take-k" it="La domanda da farsi" en="The question to ask" />
            <T as="p" class="sd-take-t" it="Non «è bello?», ma <strong>«questa risposta la userei per una decisione?»</strong>. È la stessa domanda su cui si misura la prova." en="Not “is it nice?”, but <strong>“would I use this answer for a decision?”</strong>. It is the same question the trial is measured on." />
          </div>
        </div>
      </div>
    </Slide>

  </DeckContainer>
</BaseLayout>

<script>
  // Il player di terzi nasce al clic, non al caricamento: la facciata è un
  // poster e un pulsante. `youtube-nocookie.com` e nessun cookie finché
  // qualcuno non decide di guardare.
  (function () {
    function boot() {
      document.querySelectorAll('.sd-clip-play').forEach((btn) => {
        if ((btn as HTMLElement).dataset.wired) return;
        (btn as HTMLElement).dataset.wired = '1';
        btn.addEventListener('click', () => {
          const b = btn as HTMLElement;
          const p = new URLSearchParams({
            start: b.dataset.start || '0',
            end: b.dataset.end || '',
            autoplay: '1', rel: '0', modestbranding: '1', playsinline: '1', hl: document.documentElement.lang || 'it',
          });
          const f = document.createElement('iframe');
          f.className = 'sd-clip-v';
          f.src = `https://www.youtube-nocookie.com/embed/${b.dataset.yt}?${p}`;
          f.title = 'Adobe CX Enterprise Coworker — demo su organizzazione dimostrativa';
          f.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
          f.setAttribute('allowfullscreen', '');
          f.setAttribute('loading', 'lazy');
          b.replaceWith(f);
        });
      });
    }
    boot();
    document.addEventListener('astro:page-load', boot);
  })();
</script>
