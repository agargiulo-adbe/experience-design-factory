---
/**
 * CoBrand (Poste Italiane) — wrapper sottile sul componente condiviso.
 *
 * Il motore (`@edf/core/blocks/CoBrand.astro`) porta la regola: ordine Adobe ×
 * Brand non invertibile, firma fissa su ogni slide, lockup grande su prima e
 * ultima slide. Qui si dichiara solo CHI è il brand.
 *
 * Il marchio ufficiale Poste Italiane non è distribuito come SVG su poste.it né
 * su posteitaliane.it (header in PNG/JS, sprite di sole icone): il motore ripiega
 * sul nome in carattere display. Quando il cliente consegna l'SVG ufficiale, si
 * aggiunge `<BrandMark slot="brand" />` qui dentro e cambia in tutta l'experience.
 */
import Core from '@edf/core/blocks/CoBrand.astro';

interface Props {
  variant?: 'chrome' | 'hero';
  class?: string;
  [key: string]: unknown;
}
const props = Astro.props as Props;
---
<Core brand="Poste Italiane" {...props} />
