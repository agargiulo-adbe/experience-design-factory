---
/**
 * CoBrand (Poste Italiane) — wrapper sottile sul componente condiviso.
 *
 * Il motore (`@edf/core/blocks/CoBrand.astro`) porta la regola: ordine Adobe ×
 * Brand non invertibile, firma fissa su ogni slide, lockup grande su prima e
 * ultima slide. Qui si dichiara solo CHI è il brand.
 *
 * Il marchio ufficiale Poste Italiane è un WORDMARK tipografico («Poste» bold +
 * «italiane» regular, blu su banda gialla) distribuito da media.poste.it solo in
 * WebP/PNG (l'SVG risponde 403, verificato il 30/9/2026). Niente SVG a currentColor,
 * quindi niente logo nello slot: il ripiego è il nome nel carattere del cliente
 * (Inter, lo stesso di poste.it) con il contrasto di peso del wordmark vero. Non è
 * il logo: quando il cliente consegna l'SVG ufficiale, si passa `<svg slot="brand">`.
 */
import Core from '@edf/core/blocks/CoBrand.astro';

interface Props {
  variant?: 'chrome' | 'hero';
  class?: string;
  [key: string]: unknown;
}
const props = Astro.props as Props;
---
<Core brand="Poste Italiane" {...props}>
  <span slot="brand" class="sd-cobrand-word" aria-hidden="true"><b>Poste</b>italiane</span>
</Core>
