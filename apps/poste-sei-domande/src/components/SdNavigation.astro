---
import { href } from '@edf/core/utils/url.js';
import LangToggle from '@edf/core/blocks/i18n/LangToggle.astro';
import { CHAPTERS } from '../data/chapters';

interface Props {
  currentPath: string;
  base: string;
}
const { currentPath, base } = Astro.props;

function isActive(slug: string) {
  const norm = currentPath.replace(/\/+$/, '');
  return norm.endsWith('/' + slug);
}
---
<nav class="sd-nav flex items-center justify-between px-6 py-3" aria-label="Navigazione">
  <a href={href(base, '/')} class="flex items-center gap-2.5 no-underline group flex-shrink-0" aria-label="Home — Sei domande">
    <span class="sd-mark" aria-hidden="true">
      <svg width="28" height="28" viewBox="0 0 32 32">
        <rect width="32" height="32" rx="7" fill="var(--color-blu)"/>
        <g fill="#ffffff">
          <circle cx="11" cy="8.6" r="3.4"/><circle cx="21" cy="8.6" r="3.4"/>
          <circle cx="11" cy="16" r="3.4"/><circle cx="21" cy="16" r="3.4"/>
          <circle cx="11" cy="23.4" r="3.4"/>
        </g>
        <circle cx="21" cy="23.4" r="3.4" fill="var(--color-giallo)"/>
      </svg>
    </span>
    <span class="text-sm font-bold text-[var(--ink-primary)] group-hover:text-[var(--color-blu)] transition-colors whitespace-nowrap">
      Sei domande
    </span>
    <span class="hidden 2xl:inline text-[0.6rem] font-bold tracking-widest uppercase text-[var(--color-grigio-600)] ml-1 whitespace-nowrap">
      Adobe × Poste Italiane
    </span>
  </a>

  <ol class="hidden md:flex flex-nowrap items-center gap-0.5 min-w-0 overflow-x-auto [scrollbar-width:none] [-ms-overflow-style:none] [&::-webkit-scrollbar]:hidden" role="list">
    {CHAPTERS.map((c) => (
      <li role="listitem" class="flex-shrink-0">
        <a
          href={href(base, '/' + c.slug)}
          class:list={['sd-nav-link block whitespace-nowrap px-2.5 py-1.5 text-xs font-medium rounded-sm transition-colors no-underline', isActive(c.slug) && 'sd-nav-link--active']}
          aria-current={isActive(c.slug) ? 'page' : undefined}
        >
          <span class="text-[var(--color-grigio-500)] mr-1 tabular-nums">{c.num}</span>
          <span data-lang-it>{c.label.it}</span><span data-lang-en>{c.label.en}</span>
        </a>
      </li>
    ))}
  </ol>

  <div class="flex items-center gap-3 flex-shrink-0">
    <LangToggle langs={['it', 'en']} />
    <a
      href={href(base, '/admin')}
      class="text-[0.7rem] font-semibold tracking-wider uppercase px-3 py-1.5 border border-[var(--line-default)] text-[var(--color-grigio-600)] hover:text-[var(--color-blu)] hover:border-[var(--color-blu)] rounded-sm transition-colors no-underline"
      data-admin-only
    >
      Admin
    </a>
  </div>
</nav>
