---
/**
 * MockCaso — un caso d'uso visto dai due lati: chi viaggia e chi lavora.
 *
 * PERCHÉ DUE LATI
 * Il vincolo che il Direttore dei canali digitali ha ripetuto due volte il 27
 * ottobre: «se tu mi dai il pezzo di ferro e poi mi devo costruire tutto da
 * solo… noi vogliamo vendere il sistema, io me lo compro e poi non so che
 * fare». E ancora, sul motore di personalizzazione: «non è che lui lo fa da
 * solo, deve avere delle cose già stabilite». Un mockup che mostra solo la
 * pagina del viaggiatore risponde alla metà sbagliata: fa vedere il risultato
 * e nasconde il lavoro, che è esattamente il punto su cui non si fida.
 * Quindi a destra c'è il gesto di chi quel risultato lo prepara: scegliere il
 * gruppo, scegliere che cosa mostrargli, misurare.
 *
 * PERCHÉ È SEMPLIFICATO E NON UNO SCREENSHOT
 * Perché un'interfaccia vera invecchia — il sito Le Frecce si rifà a marzo — e
 * perché ricostruirne una falsa sarebbe la wrong-brand imagery che la Quality
 * Bar vieta. Qui ci sono forme e le parole vere: si capisce il gesto, non si
 * promette una schermata.
 */
interface Props {
  /** Che cosa vede chi viaggia. Una riga. */
  viaggiatore: string;
  /** Che cosa fa chi lavora in marketing. Una riga. */
  marketer: string;
  /** I tre passi del lato marketer: gruppo, cosa mostro, misura. */
  passi: [string, string, string];
  /** La riga sopra la finestra del viaggiatore: dove succede. */
  dove?: string;
  class?: string;
}
const { viaggiatore, marketer, passi, dove = 'trenitalia.com', class: className } = Astro.props as Props;
---
<div class:list={['mk', className]}>

  {/* ── Il viaggiatore ───────────────────────────────────────────────── */}
  <figure class="mk-lato">
    <figcaption class="mk-tag">Chi viaggia</figcaption>
    <div class="mk-schermo" aria-hidden="true">
      <div class="mk-barra">
        <span class="mk-pallino"></span><span class="mk-pallino"></span><span class="mk-pallino"></span>
        <span class="mk-url">{dove}</span>
      </div>
      <div class="mk-pagina">
        {/* La parte che NON cambia: resta ferma, e si vede che è la stessa pagina. */}
        <span class="mk-riga mk-riga--fissa" style="width: 46%"></span>
        {/* La parte che cambia: entra quando la slide si apre. */}
        {/* `data-stagger` è una scena del motore: entra un figlio alla volta,
            con `prefers-reduced-motion` già gestito. Non si riscrive a mano. */}
        <div class="mk-zona" data-stagger>
          <span class="mk-blocco mk-blocco--vivo"></span>
          <span class="mk-blocco mk-blocco--vivo"></span>
          <span class="mk-blocco mk-blocco--vivo"></span>
        </div>
        <span class="mk-riga mk-riga--fissa" style="width: 72%"></span>
        <span class="mk-riga mk-riga--fissa" style="width: 58%"></span>
      </div>
    </div>
    <p class="mk-dice">{viaggiatore}</p>
  </figure>

  {/* ── Il marketer ──────────────────────────────────────────────────── */}
  <figure class="mk-lato">
    <figcaption class="mk-tag">Chi lo prepara</figcaption>
    <div class="mk-pannello" aria-hidden="true" data-stagger>
      {passi.map((p, i) => (
        <div class="mk-passo">
          <span class="mk-passo-n">{i + 1}</span>
          <span class="mk-passo-t">{p}</span>
        </div>
      ))}
      <div class="mk-esito">
        <span class="mk-sparkline"></span>
        <span class="mk-esito-t">due settimane, poi si decide</span>
      </div>
    </div>
    <p class="mk-dice">{marketer}</p>
  </figure>
</div>

<style is:global>
  .mk {
    width: 100%; max-width: 62rem; margin-inline: auto;
    display: grid; grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1rem, 2.2vw, 2.2rem);
    align-items: start;
  }
  .mk-lato { display: flex; flex-direction: column; gap: 0.55rem; margin: 0; min-width: 0; }
  .mk-tag {
    font-size: clamp(0.64rem, 0.72vw, 0.74rem); font-weight: 700;
    letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-tertiary);
  }
  .mk-dice {
    font-size: clamp(0.82rem, 0.9vw, 0.92rem); line-height: 1.5;
    color: var(--ink-secondary); margin: 0; max-width: none; text-align: left;
  }

  /* ── La finestra del viaggiatore ──────────────────────────────────── */
  .mk-schermo {
    border: 1px solid var(--line-subtle); border-radius: 0.55rem; overflow: hidden;
    background: rgba(255, 255, 255, 0.035);
  }
  .mk-barra {
    display: flex; align-items: center; gap: 0.3rem;
    padding: 0.42rem 0.6rem;
    border-bottom: 1px solid var(--line-subtle);
    background: rgba(255, 255, 255, 0.045);
  }
  .mk-pallino {
    width: 0.4rem; height: 0.4rem; border-radius: 9999px;
    background: rgba(255, 255, 255, 0.22);
  }
  .mk-url {
    margin-left: 0.5rem; font-size: 0.68rem; letter-spacing: 0.02em;
    color: var(--ink-tertiary);
  }
  .mk-pagina { display: flex; flex-direction: column; gap: 0.45rem; padding: 0.85rem 0.8rem 1rem; }
  .mk-riga { display: block; height: 0.42rem; border-radius: 9999px; }
  .mk-riga--fissa { background: rgba(255, 255, 255, 0.13); }
  .mk-zona { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.4rem; margin: 0.25rem 0; }
  .mk-blocco {
    display: block; height: 2.6rem; border-radius: 0.3rem;
    border: 1px solid rgba(var(--sig-rgb), 0.55);
    background: rgba(var(--sig-rgb), 0.14);
  }

  /* ── Il pannello di chi lavora ────────────────────────────────────── */
  .mk-pannello {
    display: flex; flex-direction: column; gap: 0.4rem;
    border: 1px solid var(--line-subtle); border-radius: 0.55rem;
    padding: 0.8rem;
    background: rgba(255, 255, 255, 0.035);
  }
  .mk-passo {
    display: flex; align-items: center; gap: 0.55rem;
    padding: 0.42rem 0.5rem; border-radius: 0.35rem;
    background: rgba(255, 255, 255, 0.05);
  }
  .mk-passo-n {
    flex: 0 0 auto;
    width: 1.15rem; height: 1.15rem; border-radius: 9999px;
    display: flex; align-items: center; justify-content: center;
    font-size: 0.66rem; font-weight: 700;
    color: var(--ink-primary);
    border: 1px solid rgba(var(--sig-rgb), 0.8);
  }
  .mk-passo-t {
    font-size: clamp(0.74rem, 0.82vw, 0.84rem); line-height: 1.3;
    color: var(--ink-secondary); min-width: 0;
  }
  .mk-esito {
    display: flex; align-items: center; gap: 0.5rem;
    margin-top: 0.15rem; padding: 0.42rem 0.5rem;
  }
  /* Una riga che sale: la misura, non un grafico vero. Non dice un numero che
     non abbiamo — dice che alla fine si guarda se ha funzionato. */
  .mk-sparkline {
    flex: 0 0 auto; width: 3.4rem; height: 0.85rem;
    background:
      linear-gradient(to top right, transparent calc(50% - 1px), rgba(var(--sig-rgb), 0.95) calc(50% - 1px), rgba(var(--sig-rgb), 0.95) calc(50% + 1px), transparent calc(50% + 1px));
  }
  .mk-esito-t { font-size: 0.72rem; color: var(--ink-tertiary); }

  /* Il movimento lo porta il motore (`data-stagger` sui due contenitori): i
     figli entrano uno alla volta all'apertura della slide, e lo stato base è
     già quello finale — con «Riduci movimento» il mockup si legge comunque.
     Una scena del motore ha due implementazioni e le gestisce lui: riscriverla
     a mano qui significherebbe rifarne una peggiore. */

  @media (max-width: 860px) {
    .mk { grid-template-columns: minmax(0, 1fr); }
  }
</style>
