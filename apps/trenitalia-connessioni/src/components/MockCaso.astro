---
/**
 * MockCaso — un caso d'uso visto dai due lati: chi viaggia e chi lo prepara.
 *
 * PERCHÉ DUE LATI
 * Il vincolo che il Direttore dei canali digitali ha ripetuto due volte il 27
 * ottobre: «se tu mi dai il pezzo di ferro e poi mi devo costruire tutto da
 * solo… noi vogliamo vendere il sistema, io me lo compro e poi non so che
 * fare». Un mockup che mostra solo la pagina del viaggiatore risponde alla
 * metà sbagliata: fa vedere il risultato e nasconde il lavoro, che è
 * esattamente il punto su cui non si fida.
 *
 * PERCHÉ IL CONTENUTO È VERO
 * La prima versione aveva rettangoli grigi al posto delle tessere. Diceva
 * «qualcosa cambia» e non diceva che cosa, cioè la metà che a chi decide non
 * interessa. Ora la schermata porta le stazioni, le fasce di prezzo, i servizi
 * — le parole del caso — e il lato destro porta la frase che si scrive davvero.
 *
 * PERCHÉ È DISEGNATO E NON UNO SCREENSHOT
 * Un'interfaccia vera invecchia — il sito Le Frecce si rifà a marzo — e
 * ricostruirne una falsa sarebbe la wrong-brand imagery che la Quality Bar
 * vieta. Qui ci sono forme e parole vere: si capisce il gesto, non si promette
 * una schermata.
 */
import type { Passo } from '../data/casi-duso';

interface Props {
  schermo: { dove: string; titolo: string; tessere: { t: string; n: string }[] };
  /** La frase che chi lavora in marketing scrive dentro Coworker Chat. */
  chiesta: string;
  passi: [Passo, Passo, Passo];
  /** Una riga sotto la schermata: che cosa vede chi viaggia. */
  viaggiatore: string;
  class?: string;
}
const { schermo, chiesta, passi, viaggiatore, class: className } = Astro.props as Props;
---
<div class:list={['mk', className]}>

  {/* ── Il viaggiatore ───────────────────────────────────────────────── */}
  <figure class="mk-lato">
    <figcaption class="mk-tag">Chi viaggia</figcaption>
    <div class="mk-schermo">
      <div class="mk-barra" aria-hidden="true">
        <span class="mk-pallino"></span><span class="mk-pallino"></span><span class="mk-pallino"></span>
        <span class="mk-url">{schermo.dove}</span>
      </div>
      <div class="mk-pagina">
        {/* Quello che non cambia: resta, e si vede che è la stessa pagina. */}
        <span class="mk-riga" style="width: 38%" aria-hidden="true"></span>
        {/* Quello che cambia, con dentro le parole del caso. `data-stagger` è
            una scena del motore: entra una tessera alla volta, e con «Riduci
            movimento» le tessere sono già al loro posto. */}
        <p class="mk-titolo">{schermo.titolo}</p>
        <div class="mk-zona" data-stagger>
          {schermo.tessere.map((t) => (
            <span class="mk-tessera">
              <span class="mk-tessera-t">{t.t}</span>
              <span class="mk-tessera-n">{t.n}</span>
            </span>
          ))}
        </div>
        <span class="mk-riga" style="width: 64%" aria-hidden="true"></span>
      </div>
    </div>
    <p class="mk-dice">{viaggiatore}</p>
  </figure>

  {/* ── Chi lo prepara ───────────────────────────────────────────────── */}
  <figure class="mk-lato">
    <figcaption class="mk-tag">Chi lo prepara · Coworker</figcaption>
    <div class="mk-pannello">
      {/* La frase scritta. È il punto: il gruppo non si costruisce a mano. */}
      <p class="mk-chiesta">{chiesta}</p>
      <div class="mk-passi" data-stagger>
        {passi.map((p, i) => (
          <div class="mk-passo">
            <span class="mk-passo-n" aria-hidden="true">{i + 1}</span>
            <span class="mk-passo-t">{p.t}</span>
            <span class="mk-passo-d" data-dove={p.dove}>{p.dove}</span>
          </div>
        ))}
      </div>
      <div class="mk-esito">
        <span class="mk-sparkline" aria-hidden="true"></span>
        <span class="mk-esito-t">Coworker dice anche quanto deve durare, e quando si decide</span>
      </div>
    </div>
  </figure>
</div>

<style is:global>
  /* La slide è centrata e il reset del motore centra ogni `p`: dentro il mock
     tutto va a bandiera, se no «Milano Centrale / da 19 €» esce incolonnato al
     centro della tessera e sembra un listino, non una card. La specificità con
     `[data-slide]` serve a battere il reset, non per gusto. */
  [data-slide] .mk,
  [data-slide] .mk p,
  [data-slide] .mk span { text-align: left; }
  /* Il reset cappa la larghezza dei `p` dentro una slide e li centra con
     `margin-inline: auto`: il titolo della schermata usciva stretto e in mezzo
     alla finestra. Si difende come dice la regola — `margin-inline: 0` a
     specificità sufficiente — non togliendo il limite a tutti. */
  [data-slide] .mk p { max-width: none; width: 100%; margin-inline: 0; }

  .mk {
    width: 100%; max-width: 72rem; margin-inline: auto;
    display: grid; grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.1rem, 2.2vw, 2.1rem);
    align-items: start;
  }
  .mk-lato { display: flex; flex-direction: column; gap: 0.5rem; margin: 0; min-width: 0; }
  .mk-tag {
    font-size: clamp(0.68rem, 0.78vw, 0.78rem); font-weight: 700;
    letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-tertiary);
    text-align: left;
  }
  .mk-dice {
    font-size: clamp(0.86rem, 0.95vw, 0.96rem); line-height: 1.5;
    color: var(--ink-secondary); margin: 0; max-width: none; text-align: left;
  }

  /* ── La finestra del viaggiatore ──────────────────────────────────── */
  .mk-schermo {
    border: 1px solid var(--line-subtle); border-radius: 0.6rem; overflow: hidden;
    background: rgba(255, 255, 255, 0.04);
  }
  .mk-barra {
    display: flex; align-items: center; gap: 0.32rem;
    padding: 0.5rem 0.7rem;
    border-bottom: 1px solid var(--line-subtle);
    background: rgba(255, 255, 255, 0.05);
  }
  .mk-pallino {
    width: 0.42rem; height: 0.42rem; border-radius: 9999px;
    background: rgba(255, 255, 255, 0.24);
  }
  .mk-url {
    margin-left: 0.55rem; font-size: 0.74rem; letter-spacing: 0.02em;
    color: var(--ink-tertiary);
  }
  .mk-pagina { display: flex; flex-direction: column; gap: 0.45rem; padding: 0.8rem 0.9rem 0.9rem; }
  .mk-riga { display: block; height: 0.4rem; border-radius: 9999px; background: rgba(255, 255, 255, 0.11); }
  .mk-titolo {
    margin: 0.3rem 0 0; max-width: none; text-align: left;
    font-family: var(--font-display); font-weight: 600;
    font-size: clamp(0.95rem, 1.05vw, 1.08rem); line-height: 1.2;
    color: var(--ink-primary);
  }
  .mk-zona { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.45rem; margin: 0.1rem 0 0.3rem; }
  .mk-tessera {
    display: flex; flex-direction: column; justify-content: space-between; gap: 0.5rem;
    min-width: 0; min-height: 3.5rem;
    padding: 0.55rem 0.6rem; border-radius: 0.35rem;
    border: 1px solid rgba(var(--sig-rgb), 0.5);
    background: rgba(var(--sig-rgb), 0.12);
  }
  .mk-tessera-t {
    font-size: clamp(0.72rem, 0.8vw, 0.8rem); line-height: 1.25;
    color: var(--ink-secondary);
  }
  .mk-tessera-n {
    font-family: var(--font-display); font-weight: 600;
    font-size: clamp(0.84rem, 0.94vw, 0.95rem); line-height: 1.15;
    color: var(--ink-primary);
  }

  /* ── Il pannello di chi lo prepara ────────────────────────────────── */
  .mk-pannello {
    display: flex; flex-direction: column; gap: 0.5rem;
    border: 1px solid var(--line-subtle); border-radius: 0.6rem;
    padding: 0.8rem;
    background: rgba(255, 255, 255, 0.04);
  }
  /* La frase scritta. Ha la forma di un CAMPO, non di una citazione: quel
     blocco non è qualcosa che qualcuno ha detto, è qualcosa che si digita —
     ed è il punto dell'intera slide. La barra d'accento a sinistra che c'era
     prima diceva «virgolettato» e per giunta è il tell più riconoscibile
     delle interfacce generate: via, e al suo posto il contorno pieno e sottile
     di un campo di testo. */
  .mk-chiesta {
    margin: 0; max-width: none; text-align: left;
    padding: 0.5rem 0.7rem;
    border: 1px solid var(--line-subtle);
    border-radius: 0.35rem;
    background: rgba(255, 255, 255, 0.07);
    font-size: clamp(0.84rem, 0.93vw, 0.94rem); line-height: 1.45;
    color: var(--ink-primary);
  }
  .mk-passi { display: flex; flex-direction: column; gap: 0.38rem; }
  .mk-passo {
    display: flex; align-items: center; gap: 0.55rem;
    padding: 0.46rem 0.55rem; border-radius: 0.35rem;
    background: rgba(255, 255, 255, 0.05);
  }
  .mk-passo-n {
    flex: 0 0 auto;
    width: 1.2rem; height: 1.2rem; border-radius: 9999px;
    display: flex; align-items: center; justify-content: center;
    font-size: 0.68rem; font-weight: 700;
    color: var(--ink-primary);
    border: 1px solid rgba(var(--sig-rgb), 0.8);
  }
  .mk-passo-t {
    flex: 1 1 auto; min-width: 0;
    font-size: clamp(0.78rem, 0.86vw, 0.88rem); line-height: 1.3;
    color: var(--ink-secondary);
  }
  /* Il prodotto che esegue il gesto. Inchiostro pieno su fondo esplicito: un
     accento trasparente qui scenderebbe sotto soglia, e `audit:ink` lo vede. */
  .mk-passo-d {
    flex: 0 0 auto;
    font-size: 0.68rem; font-weight: 700; letter-spacing: 0.06em;
    padding: 0.14rem 0.42rem; border-radius: 0.25rem;
    color: rgba(255, 255, 255, 0.96);
    background: rgba(255, 255, 255, 0.14);
    border: 1px solid rgba(255, 255, 255, 0.22);
  }
  .mk-esito {
    display: flex; align-items: center; gap: 0.55rem;
    margin-top: 0; padding: 0.15rem 0.55rem 0;
  }
  /* Una riga che sale: la misura, non un grafico vero. Non dice un numero che
     non abbiamo — dice che alla fine si guarda se ha funzionato. */
  .mk-sparkline {
    flex: 0 0 auto; width: 3.4rem; height: 0.85rem;
    background:
      linear-gradient(to top right, transparent calc(50% - 1px), rgba(var(--sig-rgb), 0.95) calc(50% - 1px), rgba(var(--sig-rgb), 0.95) calc(50% + 1px), transparent calc(50% + 1px));
  }
  .mk-esito-t { font-size: 0.76rem; line-height: 1.35; color: var(--ink-tertiary); }

  /* A 1280 la safe-area si stringe e, col «Scopri come» aperto, la testa della
     slide sbordava: il contratto dice di ridurre densità e spaziature prima di
     toccare il tipo, e il tipo qui resta identico. */
  @media (max-width: 1300px) {
    .mk-lato { gap: 0.4rem; }
    .mk-pagina { gap: 0.38rem; padding: 0.65rem 0.75rem 0.7rem; }
    .mk-tessera { min-height: 3.05rem; padding: 0.45rem 0.5rem; gap: 0.35rem; }
    .mk-pannello { gap: 0.38rem; padding: 0.65rem; }
    .mk-chiesta { padding: 0.42rem 0.6rem; }
    .mk-passo { padding: 0.34rem 0.45rem; }
    .mk-esito { padding-top: 0; }
    .mk-barra { padding: 0.38rem 0.6rem; }
  }

  @media (max-width: 900px) {
    .mk { grid-template-columns: minmax(0, 1fr); }
  }
</style>
