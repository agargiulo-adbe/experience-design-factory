---
/**
 * «COME FUNZIONA IL PRIMO PASSO» — un pop-in a passi, sopra la slide del disegno.
 *
 * La meccanica è quella di `apps/trenitalia-prospettiva-sales/src/components/ProdottoPop.astro`
 * (22 nov 2026): stessa pelle, stesso cliente, quindi lo stesso gesto. Copiata e non
 * importata, perché due app non si legano per un componente.
 *
 * Il dialog è nativo: sta nel top layer, Esc e il fuoco arrivano gratis, e da chiuso
 * è `display: none`, quindi i gate di layout non lo misurano. Un pezzo entra al passo
 * `data-da` ed esce dopo `data-a`. Niente testo dentro un SVG: tutto HTML.
 *
 * ⚠️ IL PRIMO PASSO NON ASPETTA LE FRECCE (riordinato il 23 nov 2026). Legge
 * trenitalia.com e lo status del cliente estratto dal CRM, e si misura fino al clic
 * verso l'acquisto. Legare l'acquisto su Le Frecce alla ricerca è il secondo passo,
 * che si lavora in parallelo; finché non c'è, l'acquisto si legge in aggregato. La
 * scena lo dice nella nota, una riga. Il dettaglio tecnico sta nel documento di
 * riconciliazione, che resta fuori da questo deck.
 */
import '../styles/pop.css';
import { lega } from '../utils/lega';

const passi = [
  'Adobe Analytics raccoglie come oggi su trenitalia.com; dal CRM arriva un’estrazione con lo status del cliente.',
  'Customer Journey Analytics li legge insieme: lo status si lega alle visite di chi fa login.',
  'Dentro CJA nasce un pubblico: chi ha cercato una tratta e non è passato all’acquisto.',
  'Il pubblico passa a Target: la home di trenitalia.com cambia dalle visite dopo l’aggiornamento, entro qualche ora.',
  'La misura torna in CJA: quanti cliccano verso l’acquisto, contro un gruppo di controllo.',
  'Poi si lega l’acquisto su Le Frecce; con il nuovo portale, Target arriva anche su Le Frecce e sull’app.',
];

const fonti = [
  { label: 'Il connettore di Analytics', url: 'https://experienceleague.adobe.com/en/docs/experience-platform/sources/connectors/adobe-applications/analytics' },
  { label: 'I pubblici di CJA', url: 'https://experienceleague.adobe.com/en/docs/analytics-platform/using/cja-components/audiences/audiences-overview' },
];
---
<dialog class="pp" data-pp data-deck-nochrome data-audit-skip data-tot={passi.length} data-scena="primo-passo" aria-label="Come funziona il primo passo">
  <div class="pp-in">
    <header class="pp-testa">
      <div class="pp-testa-t">
        <p class="pp-k">Come funziona</p>
        <h3 class="pp-h">Il primo passo</h3>
      </div>
      <p class="pp-cosa">Il sito e il CRM letti insieme, e una proposta che cambia su trenitalia.com.</p>
      <button type="button" class="pp-x" data-pp-chiudi aria-label="Chiudi">×</button>
    </header>

    <div class="pp-scena">
      <div class="pp-pila">
        <div class="pp-cja">
          <div class="pp-target" data-da="4">
            <p class="pp-target-k">Adobe Target</p>
            <div class="pp-f" data-on><small>Dal primo passo</small><strong>trenitalia.com</strong></div>
            <div class="pp-f pp-f--poi" data-da="6"><small>Poi</small><strong>Le Frecce</strong></div>
            <div class="pp-f pp-f--poi" data-da="6"><small>Poi</small><strong>App Trenitalia</strong></div>
          </div>
          <div class="pp-fili" style="height: clamp(1.4rem, 3.6vh, 2.6rem);">
            <span class="pp-filo" data-da="4"></span>
          </div>
          <div class="pp-strato" data-da="2">
            <div class="pp-strato-t"><strong>Customer Journey Analytics</strong><span>legge le visite e lo status del cliente</span></div>
            <ol class="pp-viaggio" data-da="3">
              <li><small>Lunedì · trenitalia.com</small><strong>Cerca Roma–Napoli</strong></li>
              <li><small>Martedì · trenitalia.com</small><strong>Torna, non compra</strong></li>
              <li><small>Il pubblico</small><strong>Ha cercato, non ha comprato</strong></li>
              <li data-on data-da="5"><small>Giovedì · trenitalia.com</small><strong>Il clic su Acquista si misura</strong></li>
            </ol>
          </div>
          <div class="pp-fili">
            <span class="pp-filo" data-da="2"></span>
            <span class="pp-filo" data-da="2"></span>
            <span class="pp-filo pp-filo--poi" data-da="6"></span>
            <span class="pp-filo pp-filo--poi" data-da="6"></span>
          </div>
          <ul class="pp-fonti">
            <li class="pp-f" data-gia><small>Analytics</small><strong>trenitalia.com</strong></li>
            <li class="pp-f" data-gia><small>Un’estrazione</small><strong>CRM e fedeltà</strong></li>
            <li class="pp-f pp-f--poi" data-da="6"><small>Poi, in parallelo</small><strong>Acquisto su Le Frecce</strong></li>
            <li class="pp-f pp-f--poi" data-da="6"><small>Con il nuovo portale</small><strong>App Trenitalia</strong></li>
          </ul>
        </div>
      </div>
    </div>

    <footer class="pp-piede">
      <div class="pp-didas" aria-live="polite">
        {passi.map((p, i) => (<p class="pp-d" data-passo-t={i + 1}><span class="pp-d-n">{i + 1}</span>{lega(p)}</p>))}
      </div>
      <div class="pp-nav">
        <div class="pp-punti" aria-hidden="true">{passi.map((_, i) => <span data-punto={i + 1}></span>)}</div>
        <button type="button" class="pp-b-n" data-pp-prev aria-label="Passo precedente">←</button>
        <button type="button" class="pp-b-n pp-b-n--av" data-pp-next>Avanti →</button>
      </div>
      <p class="pp-nota">
        Esempio illustrativo. Nel primo passo la misura si ferma al clic verso l’acquisto; l’acquisto su Le Frecce si lega con il secondo passo
        {fonti.map((f) => <> · <a href={f.url} target="_blank" rel="noopener noreferrer">{f.label}</a></>)}
      </p>
    </footer>
  </div>
</dialog>

<script>
  /* Una delega sola sul documento: regge ai cambi di capitolo e a più istanze per
     pagina. Lo script di un componente Astro gira una volta. */
  const aperto = () => document.querySelector<HTMLDialogElement>('dialog.pp[open]');

  function vai(d: HTMLDialogElement, n: number) {
    const tot = Number(d.dataset.tot);
    const p = Math.min(Math.max(1, n), tot);
    d.dataset.passo = String(p);
    d.querySelectorAll<HTMLElement>('[data-da],[data-a]').forEach((el) => {
      const da = Number(el.dataset.da ?? 1);
      const a = Number(el.dataset.a ?? 99);
      el.classList.toggle('pp-on', p >= da && p <= a);
    });
    d.querySelectorAll<HTMLElement>('[data-passo-t]').forEach((el) => {
      el.classList.toggle('pp-on', Number(el.dataset.passoT) === p);
    });
    d.querySelectorAll<HTMLElement>('[data-punto]').forEach((el) => {
      el.classList.toggle('pp-on', Number(el.dataset.punto) <= p);
    });
    const prev = d.querySelector<HTMLButtonElement>('[data-pp-prev]');
    const next = d.querySelector<HTMLButtonElement>('[data-pp-next]');
    if (prev) prev.disabled = p === 1;
    if (next) next.textContent = p === tot ? 'Chiudi' : 'Avanti →';
  }

  function avanti(d: HTMLDialogElement) {
    const p = Number(d.dataset.passo);
    if (p >= Number(d.dataset.tot)) d.close();
    else vai(d, p + 1);
  }

  function apri(d: HTMLDialogElement) {
    d.closest('[data-deck]')?.setAttribute('data-deck-lock', '');
    d.showModal();
    vai(d, 1);
    d.querySelector<HTMLElement>('[data-pp-next]')?.focus();
  }

  document.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    const open = t.closest<HTMLElement>('[data-pp-open]');
    if (open) {
      const d = open.parentElement?.querySelector<HTMLDialogElement>('dialog.pp');
      if (d) { e.preventDefault(); apri(d); }
      return;
    }
    const d = t.closest<HTMLDialogElement>('dialog.pp');
    if (!d) return;
    if (t === d || t.closest('[data-pp-chiudi]')) d.close();
    else if (t.closest('[data-pp-next]')) avanti(d);
    else if (t.closest('[data-pp-prev]')) vai(d, Number(d.dataset.passo) - 1);
  });

  /* `close` non risale: si ascolta in cattura. Copre Esc, la ×, l'ultimo passo. */
  document.addEventListener('close', (e) => {
    const d = e.target as HTMLElement;
    if (d.matches?.('dialog.pp')) d.closest('[data-deck]')?.removeAttribute('data-deck-lock');
  }, true);

  /* A pop-in aperto i tasti non arrivano al deck, che ascolta su window. Vale anche
     per i telecomandi, che mandano PageDown/PageUp. */
  document.addEventListener('keydown', (e) => {
    const d = aperto();
    if (!d) return;
    if (['ArrowRight', 'ArrowDown', 'PageDown', ' '].includes(e.key)) {
      if ((e.target as HTMLElement).tagName === 'A') return;
      e.preventDefault(); e.stopPropagation(); avanti(d);
    } else if (['ArrowLeft', 'ArrowUp', 'PageUp'].includes(e.key)) {
      e.preventDefault(); e.stopPropagation(); vai(d, Number(d.dataset.passo) - 1);
    } else if (e.key !== 'Escape' && e.key !== 'Tab') {
      e.stopPropagation();
    }
  }, true);
</script>
