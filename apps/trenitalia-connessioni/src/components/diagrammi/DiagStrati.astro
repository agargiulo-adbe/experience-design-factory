---
/**
 * DiagStrati — la piattaforma vista di taglio: gli strati impilati, dal dato
 * grezzo in basso a quello che la gente usa in sopra, e la riga che dice chi
 * possiede ciascuno strato.
 *
 * Serve dove il deck spiegava «sopra i sistemi che già avete» a parole: qui la
 * sovrapposizione si vede, e si vede anche che sotto non si tocca niente.
 */
interface Props {
  /** Dal basso verso l'alto: il primo elemento è lo strato più profondo. */
  strati: { nome: string; nota?: string; evidenza?: boolean }[];
  class?: string;
}
const { strati, class: className } = Astro.props as Props;
const dallAlto = [...strati].reverse();
---
<div class:list={["dg-strati", className]} role="img"
     aria-label={dallAlto.map((s) => `${s.nome}${s.nota ? ' — ' + s.nota : ''}`).join('; sopra ')}>
  {dallAlto.map((s) => (
    <div class="dg-st-riga" data-evidenza={s.evidenza ? '' : undefined} aria-hidden="true">
      <span class="dg-st-nome">{s.nome}</span>
      {s.nota && <span class="dg-st-nota">{s.nota}</span>}
    </div>
  ))}
</div>

<style is:global>
  .dg-strati { display: flex; flex-direction: column; gap: 0.4rem; width: 100%; }
  .dg-st-riga {
    display: flex; align-items: baseline; justify-content: space-between; gap: 1rem;
    border: 1px solid rgba(214, 219, 230, 0.18);
    background: rgba(47, 57, 78, 0.45);
    border-radius: 4px;
    padding: 0.65rem 1rem;
  }
  /* Lo strato in evidenza è quello che si propone: gli altri restano come sono. */
  .dg-st-riga[data-evidenza] {
    border-color: rgba(var(--sig-rgb), 0.65);
    background: rgba(var(--sig-rgb), 0.13);
    box-shadow: 0 0 22px -8px rgba(var(--sig-rgb), 0.6);
  }
  .dg-st-nome {
    font-family: var(--font-display); font-weight: 600; font-size: 1.02rem;
    line-height: 1.25; color: rgba(255, 255, 255, 0.98);
  }
  .dg-st-nota {
    font-size: 0.86rem; line-height: 1.35; text-align: right; flex-shrink: 0;
    color: rgba(167, 176, 194, 0.98);
  }
  @media (max-width: 760px) {
    .dg-st-riga { flex-direction: column; gap: 0.2rem; }
    .dg-st-nota { text-align: left; }
  }
</style>
