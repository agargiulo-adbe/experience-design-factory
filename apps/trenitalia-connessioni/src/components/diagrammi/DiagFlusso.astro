---
/**
 * DiagFlusso — «sistemi separati → un layer → un percorso leggibile».
 *
 * È il concetto che questo deck ripete più spesso, e finora stava scritto in
 * un paragrafo. Qui si vede: a sinistra le fonti, ognuna chiusa nella sua
 * scatola; al centro la barra che le legge; a destra la linea unica.
 *
 * Il colore è quello del SEGNALE (`--sig-rgb`), quindi si ribalta col ramo
 * senza che la slide debba saperlo. rgba esplicito: il parser del contrasto
 * dell'audit non legge oklab().
 */
interface Props {
  /** Le fonti, a sinistra. 3-6 voci: oltre, le scatole diventano illeggibili. */
  fonti: string[];
  /** L'etichetta della barra centrale. */
  layer: string;
  /** Le tappe del percorso leggibile, a destra. */
  esito: string[];
  class?: string;
}
const { fonti, layer, esito, class: className } = Astro.props as Props;
---
<div class:list={["dg-flusso", className]} role="img"
     aria-label={`${fonti.join(', ')} confluiscono in ${layer}, che produce ${esito.join(', ')}`}>
  <div class="dg-col dg-col--fonti" aria-hidden="true">
    {fonti.map((f) => <span class="dg-box">{f}</span>)}
  </div>
  <svg class="dg-raccordo" viewBox="0 0 120 220" preserveAspectRatio="none" aria-hidden="true">
    {fonti.map((_, i) => {
      const y = 220 * ((i + 0.5) / fonti.length);
      return <path d={`M0 ${y} C 60 ${y}, 60 110, 120 110`} />;
    })}
  </svg>
  <div class="dg-layer" aria-hidden="true"><span>{layer}</span></div>
  <svg class="dg-raccordo dg-raccordo--out" viewBox="0 0 70 220" preserveAspectRatio="none" aria-hidden="true">
    <path d="M0 110 L70 110" />
  </svg>
  <div class="dg-col dg-col--esito" aria-hidden="true">
    <span class="dg-linea"></span>
    {esito.map((e, i) => (
      <span class="dg-tappa"><i class="dg-punto" data-ultimo={i === esito.length - 1 ? '' : undefined}></i>{e}</span>
    ))}
  </div>
</div>

<style is:global>
  /* A bandiera sempre: il diagramma vive dentro slide centrate e, ereditando
     `text-align: center`, le tappe si staccavano dai punti del percorso che
     stanno a sinistra. Qui non è una preferenza, è la lettura della linea. */
  .dg-flusso {
    text-align: left;
    display: grid;
    grid-template-columns: minmax(8rem, 1fr) 3.5rem minmax(7rem, 0.8fr) 2rem minmax(9rem, 1.2fr);
    align-items: center;
    gap: 0 0.5rem;
    width: 100%;
  }
  /* 1.05rem ≈ 19px alla radice del deck: il check `g` del ritmo verticale
     vuole almeno 16px fra due blocchi di testo adiacenti. */
  .dg-col { display: flex; flex-direction: column; gap: 1.05rem; min-width: 0; }
  .dg-box {
    border: 1px solid rgba(214, 219, 230, 0.22);
    background: rgba(47, 57, 78, 0.5);
    border-radius: 4px;
    padding: 0.5rem 0.7rem;
    font-size: 0.9rem;
    line-height: 1.3;
    color: rgba(241, 243, 244, 0.92);
  }
  /* Altezza fissa NO: la colonna delle fonti cresce con le etichette e le
     curve partivano scollate dalle scatole. Stirato sulla riga del grid, con
     preserveAspectRatio="none", ogni curva riprende il centro della sua. */
  .dg-raccordo { width: 100%; align-self: stretch; height: auto; min-height: 7rem; overflow: visible; }
  .dg-raccordo path {
    fill: none;
    stroke: rgba(var(--sig-rgb), 0.55);
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
  }
  .dg-layer {
    display: flex; align-items: center; justify-content: center; text-align: center;
    min-height: 7rem;
    border: 1px solid rgba(var(--sig-rgb), 0.6);
    background: rgba(var(--sig-rgb), 0.12);
    border-radius: 4px;
    padding: 0.8rem 0.6rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.05rem;
    line-height: 1.2;
    color: rgba(255, 255, 255, 0.98);
  }
  .dg-col--esito { position: relative; padding-left: 1.1rem; }
  .dg-linea {
    position: absolute; left: 0.3rem; top: 0.45rem; bottom: 0.45rem; width: 2px;
    background: linear-gradient(180deg, rgba(var(--sig-rgb), 0.9), rgba(var(--sig-rgb), 0.3));
    border-radius: 2px;
  }
  .dg-tappa {
    position: relative;
    font-size: 0.95rem; line-height: 1.35;
    color: rgba(241, 243, 244, 0.95);
  }
  .dg-punto {
    position: absolute; left: -1.05rem; top: 0.42rem;
    width: 0.5rem; height: 0.5rem; border-radius: 9999px;
    background: rgb(27, 34, 48);
    border: 2px solid rgba(var(--sig-rgb), 0.95);
  }
  @media (max-width: 900px) {
    .dg-flusso { grid-template-columns: 1fr; gap: 0.75rem; }
    .dg-raccordo { display: none; }
  }
</style>
