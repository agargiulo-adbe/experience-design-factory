---
/**
 * DiagIncrocio — due insiemi che si toccano solo nell'intersezione.
 *
 * È la forma della data collaboration: ciascuna società tiene i suoi dati, e
 * quello che si condivide è SOLO la sovrapposizione. Detto a parole si perde;
 * disegnato, la domanda «ma allora vi passate i dati?» non nasce nemmeno.
 */
interface Props {
  sinistra: { nome: string; nota?: string };
  destra: { nome: string; nota?: string };
  centro: string;
  /** La riga sotto: che cosa NON esce da ciascuna parte. */
  vincolo?: string;
  class?: string;
}
const { sinistra, destra, centro, vincolo, class: className } = Astro.props as Props;
---
<div class:list={["dg-incrocio", className]} role="img"
     aria-label={`${sinistra.nome} e ${destra.nome} condividono solo ${centro}.${vincolo ? ' ' + vincolo : ''}`}>
  <div class="dg-ic-scena" aria-hidden="true">
    <div class="dg-ic-cerchio dg-ic-cerchio--sx">
      <span class="dg-ic-nome">{sinistra.nome}</span>
      {sinistra.nota && <span class="dg-ic-nota">{sinistra.nota}</span>}
    </div>
    <div class="dg-ic-centro"><span>{centro}</span></div>
    <div class="dg-ic-cerchio dg-ic-cerchio--dx">
      <span class="dg-ic-nome">{destra.nome}</span>
      {destra.nota && <span class="dg-ic-nota">{destra.nota}</span>}
    </div>
  </div>
  {vincolo && <p class="dg-ic-vincolo" aria-hidden="true">{vincolo}</p>}
</div>

<style is:global>
  .dg-incrocio { width: 100%; display: flex; flex-direction: column; align-items: center; gap: 0.9rem; }
  .dg-ic-scena {
    position: relative; display: flex; align-items: center; justify-content: center;
    width: 100%; max-width: 52rem; min-height: 15rem;
  }
  .dg-ic-cerchio {
    display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center;
    width: 22rem; height: 15rem; border-radius: 9999px;
    padding: 1rem 1.6rem;
  }
  .dg-ic-cerchio--sx {
    border: 1.5px solid rgba(var(--park-rgb), 0.8);
    background: linear-gradient(rgba(var(--park-rgb), 0.17), rgba(var(--park-rgb), 0.17)), rgba(27, 34, 48, 0.68);
    margin-right: -3.5rem; padding-right: 4.8rem;
  }
  .dg-ic-cerchio--dx {
    border: 1.5px solid rgba(var(--rail-rgb), 0.8);
    background: linear-gradient(rgba(var(--rail-rgb), 0.17), rgba(var(--rail-rgb), 0.17)), rgba(27, 34, 48, 0.68);
    margin-left: -3.5rem; padding-left: 4.8rem;
  }
  .dg-ic-nome {
    font-family: var(--font-display); font-weight: 600; font-size: 1.05rem; line-height: 1.2;
    color: rgba(255, 255, 255, 0.98);
  }
  .dg-ic-nota { font-size: 0.86rem; line-height: 1.35; color: rgba(214, 219, 230, 0.92); margin-top: 0.25rem; }
  /* Il cerchio centrale copre la metà interna dei due laterali: senza il
     padding qui sopra, le note dei due lati ci finivano sotto, tagliate. Non
     lo vede il check `e`, che misura da 16px in su e le note stanno sotto. */
  .dg-ic-centro {
    position: relative; z-index: 2;
    display: flex; align-items: center; justify-content: center; text-align: center;
    width: 9rem; height: 9rem; border-radius: 9999px;
    background: rgba(27, 34, 48, 0.97);
    border: 1.5px solid rgba(241, 243, 244, 0.6);
    padding: 0.8rem;
  }
  .dg-ic-centro span {
    font-family: var(--font-display); font-weight: 600; font-size: 0.95rem; line-height: 1.2;
    color: rgba(255, 255, 255, 0.99);
  }
  .dg-ic-vincolo {
    font-size: 0.88rem; line-height: 1.45; text-align: center; max-width: 42rem;
    color: rgba(214, 219, 230, 0.95);
  }
  @media (max-width: 820px) {
    .dg-ic-scena { flex-direction: column; min-height: 0; }
    .dg-ic-cerchio { width: 100%; height: auto; border-radius: 6px; margin: 0; padding: 0.9rem; }
    .dg-ic-cerchio--sx, .dg-ic-cerchio--dx { margin: 0; padding: 0.9rem; }
    .dg-ic-centro { width: 100%; height: auto; border-radius: 6px; margin: -0.4rem 0; }
  }
</style>
