---
/**
 * DiagScambio — i tre passi come una linea con tre stazioni.
 *
 * PERCHÉ ESISTE (23 nov 2026). Le tre configurazioni stavano in tre schede di
 * definizioni, lette in fila come un elenco. Il punto della slide è una forma:
 * si parte da una stazione, e la linea prosegue.
 *
 * FINO AL 23 NOV ERA UNO SCAMBIO: due rami indipendenti dal primo passo, il CRM e
 * Target su Le Frecce. La call con il partner del 23 nov ha riordinato il piano:
 * il CRM entra nel primo passo, l'acquisto su Le Frecce si lavora da subito in
 * parallelo, e il percorso intero su Le Frecce con l'app aspetta il nuovo portale
 * di vendita. I passi ora sono in fila, e la figura è una linea.
 *
 * Ogni stazione mostra in pastiglie che cosa legge CJA e dove agisce Target, e
 * accende solo quello che si AGGIUNGE rispetto alla stazione prima: la differenza si
 * vede invece di leggerla. Il semaforo dice che cosa il passo aspetta. Il tratto
 * fra la prima e la seconda stazione è doppio: si lavora insieme, da subito.
 *
 * I PASSI: due marcatori `[data-substep]`, uno per tratto, letti con `:has()`. Il
 * tratto si disegna e la sua stazione entra. Con «Riduci movimento» o senza
 * JavaScript è tutto acceso.
 */
import { lega } from '../../utils/lega';
import { CONFIG, CASI } from '../../data/casi-duso';

interface Props { class?: string }
const { class: className } = Astro.props as Props;

const nCasi = (id: string) => CASI.filter((c) => c.config === id).length;
const etichetta = CONFIG.map((k) =>
  `${k.nome}, ${k.quando.toLowerCase()}: CJA legge ${k.leggeL.join(', ')}; Target agisce su ${k.agisceL.join(', ')}; aspetta ${k.serve}.`
).join(' ');
const tratti = [
  { p: 'b', l: 'da subito, insieme' },
  { p: 'c', l: 'con il nuovo portale' },
];
---
<div class:list={['sw', className]} role="img" aria-label={etichetta}>
  {CONFIG.map((k, i) => {
    const prima = CONFIG[i - 1];
    const righe = [
      { l: 'CJA legge', v: k.leggeL, b: prima?.leggeL, t: 'cja' },
      { l: 'Target agisce su', v: k.agisceL, b: prima?.agisceL, t: 'tgt' },
    ];
    return (
      <>
        {i > 0 && (
          <div class:list={['sw-tratto', `sw-tratto--${tratti[i - 1].p}`]} aria-hidden="true">
            <svg viewBox="0 0 100 20" preserveAspectRatio="none">
              <g class="sw-trav"><path d="M0 10 H100" /></g>
              <g class="sw-rot">
                <path class="sw-ramo" d="M0 6 H100" />
                <path class="sw-ramo" d="M0 14 H100" />
              </g>
            </svg>
            <span class="sw-tratto-l">{tratti[i - 1].l}</span>
          </div>
        )}
        <div class:list={['sw-st', `sw-st--${k.id}`]} data-st={k.id} aria-hidden="true">
          <p class="sw-k">{k.quando}</p>
          <p class="sw-n">{k.nome}<span class="sw-c">{nCasi(k.id) === 0 ? 'misura i casi sul venduto' : nCasi(k.id) === 1 ? '1 caso' : `${nCasi(k.id)} casi`}</span></p>
          {righe.map((r) => {
            const nuovi = r.b ? r.v.filter((x) => !r.b!.includes(x)) : r.v;
            return (
              <div class="sw-riga">
                <span class="sw-l">{r.l}</span>
                <span class="sw-chips">
                  {r.b && <b class="sw-chip sw-chip--come">come prima</b>}
                  {nuovi.map((x) => <b class:list={['sw-chip', `sw-chip--${r.t}`, r.b && 'sw-nuovo']}>{r.b ? `+ ${x}` : x}</b>)}
                </span>
              </div>
            );
          })}
          <p class="sw-sem"><i></i><span><small>Aspetta</small>{lega(k.serve)}</span></p>
        </div>
      </>
    );
  })}

  <i class="sw-m" data-substep data-p="b" aria-hidden="true"></i>
  <i class="sw-m" data-substep data-p="c" aria-hidden="true"></i>
</div>

<style is:global>
  .sw {
    width: 100%; max-width: 92rem; margin-inline: auto; text-align: left;
    display: grid; align-items: stretch;
    grid-template-columns: minmax(0, 1fr) minmax(4.5rem, 0.22fr) minmax(0, 1fr) minmax(4.5rem, 0.22fr) minmax(0, 1fr);
  }
  [data-slide] .sw p, [data-slide] .sw span { text-align: left; max-width: none; margin: 0; }

  .sw-st {
    display: flex; flex-direction: column; gap: 0.55rem; padding: 0.95rem 1.1rem 1rem; border-radius: 0.7rem;
    border: 1.5px solid rgba(255, 255, 255, 0.3); background: rgba(14, 19, 30, 0.78);
    box-shadow: 0 14px 34px rgba(6, 10, 18, 0.4);
  }
  .sw-st--a { border-color: var(--color-rosso-chiaro); }
  .sw-k {
    font-size: clamp(0.84rem, 0.9vw, 0.96rem); font-weight: 700; letter-spacing: 0.08em;
    text-transform: uppercase; color: var(--color-rosso-chiaro);
  }
  .sw-n {
    display: grid; gap: 0.2rem;
    font-family: var(--font-display); font-weight: 600; line-height: 1.15;
    font-size: clamp(1.2rem, 1.4vw, 1.5rem); color: var(--ink-primary);
  }
  .sw-c {
    font-family: var(--font-body); font-weight: 600;
    font-size: clamp(0.86rem, 0.9vw, 0.96rem); color: var(--ink-tertiary);
  }
  .sw-riga { display: grid; gap: 0.3rem; }
  .sw-l { font-size: clamp(0.9rem, 0.94vw, 1rem); font-weight: 600; color: var(--ink-tertiary); }
  .sw-chips { display: flex; flex-wrap: wrap; gap: 0.3rem; }
  .sw-chip {
    padding: 0.18rem 0.55rem; border-radius: 0.35rem; font-weight: 500;
    font-size: clamp(0.94rem, 0.98vw, 1.04rem); color: var(--ink-secondary);
    border: 1px solid rgba(255, 255, 255, 0.18); background: rgba(255, 255, 255, 0.06);
  }
  .sw-chip.sw-nuovo { font-weight: 700; color: var(--ink-primary); }
  .sw-chip--come { border-style: dashed; color: var(--ink-tertiary); background: transparent; }
  .sw-chip--cja.sw-nuovo { border-color: var(--color-verde-chiaro); background: rgba(0, 102, 102, 0.42); }
  .sw-chip--tgt.sw-nuovo { border-color: var(--color-rosso-chiaro); background: rgba(217, 24, 53, 0.3); }
  .sw-sem {
    display: flex; align-items: flex-start; gap: 0.6rem; margin-top: auto !important;
    padding-top: 0.6rem; border-top: 1px solid var(--line-subtle);
    font-size: clamp(0.98rem, 1.02vw, 1.08rem); line-height: 1.4; color: var(--ink-primary);
  }
  .sw-sem small {
    display: block; font-size: clamp(0.82rem, 0.86vw, 0.92rem); font-weight: 700;
    letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-tertiary);
  }
  /* Il semaforo: rosso finché il passo aspetta qualcuno. */
  .sw-sem i {
    flex: none; margin-top: 0.3rem; width: 0.8rem; height: 0.8rem; border-radius: 50%;
    background: var(--color-rosso); box-shadow: 0 0 0 4px rgba(217, 24, 53, 0.25), 0 0 14px rgba(217, 24, 53, 0.6);
  }

  /* ── I tratti di linea ───────────────────────────────────────────────── */
  .sw-tratto { position: relative; display: grid; align-content: center; justify-items: center; gap: 0.5rem; padding: 0 0.2rem; }
  .sw-tratto svg { width: 100%; height: 1.4rem; overflow: visible; }
  .sw-tratto path { fill: none; vector-effect: non-scaling-stroke; }
  .sw-trav path { stroke: rgba(255, 255, 255, 0.28); stroke-width: 14; stroke-dasharray: 2 7; }
  .sw-rot path { stroke: var(--color-rosso-chiaro); stroke-width: 3; stroke-linecap: round; }
  .sw-tratto-l {
    text-align: center !important; font-size: clamp(0.82rem, 0.86vw, 0.92rem); font-weight: 600; line-height: 1.3;
    color: var(--color-rosso-chiaro);
  }

  /* ── Un tratto alla volta ────────────────────────────────────────────── */
  .sw .sw-tratto svg, .sw .sw-tratto-l { clip-path: inset(0 100% 0 0); transition: clip-path 900ms cubic-bezier(0.45, 0, 0.2, 1); }
  .sw .sw-st--b, .sw .sw-st--c {
    opacity: 0; visibility: hidden; transform: translateX(14px);
    transition: opacity 420ms ease 300ms, transform 600ms cubic-bezier(0.16, 1, 0.3, 1) 300ms, visibility 420ms 300ms;
  }
  .sw:has(.sw-m[data-p='b'][data-substep-active]) .sw-tratto--b svg,
  .sw:has(.sw-m[data-p='b'][data-substep-active]) .sw-tratto--b .sw-tratto-l,
  .sw:has(.sw-m[data-p='c'][data-substep-active]) .sw-tratto--c svg,
  .sw:has(.sw-m[data-p='c'][data-substep-active]) .sw-tratto--c .sw-tratto-l { clip-path: inset(0 0 0 0); }
  .sw:has(.sw-m[data-p='b'][data-substep-active]) .sw-st--b,
  .sw:has(.sw-m[data-p='c'][data-substep-active]) .sw-st--c { opacity: 1; visibility: visible; transform: none; }
  .sw-m { display: block; width: 0; height: 0; }

  @media (prefers-reduced-motion: reduce) {
    .sw .sw-tratto svg, .sw .sw-tratto-l { clip-path: none; transition: none; }
    .sw .sw-st--b, .sw .sw-st--c { opacity: 1; visibility: visible; transform: none; transition: none; }
  }
  html:not(.js) .sw .sw-tratto svg, html:not(.js) .sw .sw-tratto-l { clip-path: none; }
  html:not(.js) .sw .sw-st--b, html:not(.js) .sw .sw-st--c { opacity: 1; visibility: visible; transform: none; }

  @media (max-width: 1300px), (max-height: 940px) {
    .sw-st { padding: 0.7rem 0.85rem 0.75rem; gap: 0.4rem; }
    .sw-riga { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.3rem 0.5rem; }
    .sw-chips { display: contents; }
    .sw-sem { padding-top: 0.4rem; }
  }
  @media (max-width: 900px) {
    .sw { grid-template-columns: minmax(0, 1fr); gap: 0.6rem; }
    .sw-tratto { display: none; }
  }
</style>
