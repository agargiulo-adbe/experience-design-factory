---
/**
 * DiagMatrice — i cinque casi e le tre configurazioni, in una figura sola.
 *
 * PERCHÉ ESISTE
 * Il piano va per tre passi in fila: il primo (trenitalia.com e il CRM), l'acquisto
 * su Le Frecce in parallelo, poi Le Frecce e l'app con il nuovo portale. La domanda
 * di chi decide è «che cosa ottengo a ogni passo?». La figura risponde senza una
 * frase: i passi in alto, i casi sotto, e una colonna si accende alla volta. Un
 * caso resta acceso dal suo passo in poi; il secondo passo non porta casi nuovi,
 * porta la misura sul venduto a quelli del primo (riordinato il 23 nov 2026).
 *
 * Fino al 22 nov 2026 le colonne erano le fonti, e la figura confrontava due
 * perimetri. Ora le tappe sono dello stesso piano.
 *
 * I PASSI li decide chi presenta: tre marcatori `[data-substep]`, uno per colonna.
 * Una cella non ancora accesa è assente (`visibility: hidden`), non trasparente.
 * Con «Riduci movimento» o senza JavaScript è tutto acceso: lo stato base è il finale.
 */
import { CONFIG, valeIn, type Caso } from '../../data/casi-duso';

interface Props {
  casi: Caso[];
  class?: string;
}
const { casi, class: className } = Astro.props as Props;

const etichetta = CONFIG.map((k) => {
  const nomi = casi.filter((c) => valeIn(c, k.id)).map((c) => c.titolo);
  return `${k.nome}: ${nomi.join(', ')}`;
}).join('. ');
---
<div class:list={['dg-mx', className]} data-matrice role="img"
     aria-label={`I casi d'uso nelle tre configurazioni. ${etichetta}.`}>

  <div class="dg-mx-testa" aria-hidden="true">
    <span class="dg-mx-ang"></span>
    {CONFIG.map((k) => (
      <span class="dg-mx-fonte" data-col={k.id}>
        <span class="dg-mx-fonte-n">{k.nome}<span class="dg-mx-fonte-x">{k.breve}</span></span>
      </span>
    ))}
  </div>

  {casi.map((c) => (
    <div class="dg-mx-riga" aria-hidden="true">
      <span class="dg-mx-caso">
        <span class="dg-mx-caso-n">{c.titolo}</span>
        <span class="dg-mx-caso-l">{c.origine === 'cliente' ? 'portato da voi' : 'proposto da Adobe'}</span>
      </span>
      {CONFIG.map((k) => (
        <span class="dg-mx-cella" data-col={k.id}>
          {valeIn(c, k.id) && (
            <span class="dg-mx-punto" data-qui={c.config === k.id ? 'si' : 'no'}></span>
          )}
        </span>
      ))}
    </div>
  ))}

  {CONFIG.map((k) => (
    <i class="dg-mx-m" data-substep data-col={k.id} aria-hidden="true"></i>
  ))}
</div>

<style is:global>
  .dg-mx {
    width: 100%; max-width: 62rem; margin-inline: auto;
    display: grid;
    grid-template-columns: minmax(13rem, 1.7fr) repeat(3, minmax(0, 1fr));
    gap: 0.3rem 0.6rem;
    align-items: stretch;
  }
  .dg-mx-testa { display: contents; }
  .dg-mx-ang { display: block; }
  .dg-mx-fonte {
    display: flex; flex-direction: column; gap: 0.15rem; text-align: center;
    padding: 0 0.2rem 0.6rem;
    border-bottom: 1.5px solid var(--line-subtle);
  }
  .dg-mx-fonte-n {
    font-family: var(--font-display);
    font-size: clamp(0.95rem, 1.05vw, 1.15rem); font-weight: 600; line-height: 1.2;
    color: var(--ink-primary);
  }
  .dg-mx-fonte-x {
    display: block; margin-top: 0.15rem; font-family: var(--font-body); font-weight: 400;
    font-size: clamp(0.8rem, 0.86vw, 0.92rem); line-height: 1.3;
    color: var(--ink-tertiary);
  }

  .dg-mx-riga { display: contents; }
  .dg-mx-caso {
    display: flex; flex-direction: column; gap: 0.15rem;
    text-align: left;
    padding: 0.75rem 0.6rem 0.75rem 0;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }
  .dg-mx-caso-n {
    font-size: clamp(1rem, 1.08vw, 1.15rem); font-weight: 600; line-height: 1.25;
    color: var(--ink-primary);
  }
  .dg-mx-caso-l {
    font-size: clamp(0.78rem, 0.82vw, 0.88rem); letter-spacing: 0.06em; text-transform: uppercase;
    color: var(--ink-tertiary);
  }
  .dg-mx-cella {
    display: flex; align-items: center; justify-content: center;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }
  .dg-mx-punto {
    width: 1rem; height: 1rem; border-radius: 9999px;
    background: rgba(255, 255, 255, 0.55);
  }
  /* La configurazione da cui il caso nasce: il punto pieno, di marchio. */
  .dg-mx-punto[data-qui='si'] {
    background: var(--color-rosso); box-shadow: 0 0 0 4px rgba(217, 24, 53, 0.25);
  }
  .dg-mx-m { display: block; width: 0; height: 0; }

  /* ── Una colonna alla volta ──────────────────────────────────────────── */
  .dg-mx .dg-mx-cella[data-col] .dg-mx-punto {
    opacity: 0; visibility: hidden; transform: scale(0.6);
    transition: opacity 380ms ease, transform 380ms cubic-bezier(0.2, 0.8, 0.2, 1), visibility 380ms;
  }
  .dg-mx:has(.dg-mx-m[data-col='a'][data-substep-active]) .dg-mx-cella[data-col='a'] .dg-mx-punto,
  .dg-mx:has(.dg-mx-m[data-col='b'][data-substep-active]) .dg-mx-cella[data-col='b'] .dg-mx-punto,
  .dg-mx:has(.dg-mx-m[data-col='c'][data-substep-active]) .dg-mx-cella[data-col='c'] .dg-mx-punto {
    opacity: 1; visibility: visible; transform: none;
  }
  .dg-mx:has(.dg-mx-m[data-col='a'][data-substep-active]) .dg-mx-fonte[data-col='a'],
  .dg-mx:has(.dg-mx-m[data-col='b'][data-substep-active]) .dg-mx-fonte[data-col='b'],
  .dg-mx:has(.dg-mx-m[data-col='c'][data-substep-active]) .dg-mx-fonte[data-col='c'] {
    border-bottom-color: var(--color-rosso);
  }
  @media (prefers-reduced-motion: reduce) {
    .dg-mx .dg-mx-cella[data-col] .dg-mx-punto { opacity: 1; visibility: visible; transform: none; transition: none; }
  }
  html:not(.js) .dg-mx .dg-mx-cella[data-col] .dg-mx-punto { opacity: 1; visibility: visible; transform: none; }

  @media (max-width: 900px) {
    .dg-mx { grid-template-columns: minmax(8rem, 1.4fr) repeat(3, minmax(0, 1fr)); }
  }
</style>
