---
/**
 * DiagAssistenti — il canale degli assistenti in tre tempi, invece di due paragrafi.
 *
 * PERCHÉ ESISTE (23 nov 2026). La slide diceva tre cose in prosa: gli assistenti
 * vi nominano (e possono sbagliare l'attribuzione), quel traffico va prima pesato,
 * e l'assistente sul vostro canale risponde meglio se sa chi scrive. Qui ognuna è
 * una scena: una risposta d'esempio con i nomi evidenziati, la domanda per i
 * vostri Analytics con il numero lasciato aperto (non lo abbiamo, e non si
 * inventa), e la stessa domanda con e senza contesto.
 *
 * La prima scena è già in pagina; le altre due entrano con ↓ (`[data-substep]`). Con
 * «Riduci movimento» o senza JavaScript sono tutte visibili.
 */
import { lega } from '../../utils/lega';
---
<div class="as" role="img" aria-label="Tre tempi. Primo: un assistente risponde a chi chiede come andare da Roma a Milano, e nomina Frecciarossa e Trenitalia; si verifica che vi nomini e che attribuisca bene i vostri treni, per domanda e per mercato. Secondo: quanto pesa il traffico che arriva dagli assistenti e come converte rispetto al resto; il numero è nei vostri Analytics. Terzo: l'assistente sul vostro canale, senza contesto, propone le offerte del giorno; con il contesto riprende la tratta cercata ieri.">
  <figure class="as-sc" aria-hidden="true">
    <figcaption class="as-k"><b>1</b> Come vi nominano</figcaption>
    <div class="as-box">
      <p class="as-q">{lega('Come vado da Roma a Milano domani mattina?')}</p>
      <p class="as-a">Con un <mark>Frecciarossa</mark> di <mark>Trenitalia</mark>, {lega('da Roma Termini a Milano Centrale.')}</p>
      <ul class="as-chk">
        <li>Vi nomina?</li>
        <li>{lega('Attribuisce bene i vostri treni?')}</li>
      </ul>
    </div>
    <p class="as-cap">{lega('Si misura per domanda e per mercato, e si corregge dove sbaglia.')}</p>
  </figure>

  <figure class="as-sc as-sc--peso" data-substep aria-hidden="true">
    <figcaption class="as-k"><b>2</b> Quanto pesa, prima di tutto</figcaption>
    <div class="as-box as-box--aa">
      <p class="as-aa-t">Adobe Analytics · provenienza</p>
      <div class="as-met"><span>{lega('Visite arrivate dagli assistenti')}</span><strong>?</strong></div>
      <div class="as-met"><span>{lega('Come convertono, rispetto al resto')}</span><strong>?</strong></div>
    </div>
    <p class="as-cap">{lega('Il numero sta già nei vostri Analytics: è la domanda per la sessione tecnica.')}</p>
  </figure>

  <figure class="as-sc" data-substep aria-hidden="true">
    <figcaption class="as-k"><b>3</b> Con quale contesto rispondete</figcaption>
    <div class="as-box">
      <p class="as-q">{lega('Vorrei un biglietto per domani.')}</p>
      <p class="as-r as-r--no"><small>Senza contesto</small>{lega('Ecco le offerte del giorno.')}</p>
      <p class="as-r as-r--si"><small>Con il contesto</small>{lega('Ieri cercavi Bologna → Firenze: riprendiamo da lì?')}</p>
    </div>
    <p class="as-cap">{lega('È lo stesso contesto che serve ai cinque casi.')}</p>
  </figure>
</div>

<style is:global>
  .as {
    width: 100%; max-width: 80rem; margin-inline: auto; text-align: left;
    display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(0.8rem, 1.6vw, 1.6rem);
    align-items: start;
  }
  [data-slide] .as p, [data-slide] .as li, [data-slide] .as span { text-align: left; max-width: none; margin: 0; }
  .as-sc { margin: 0; display: grid; gap: 0.6rem; }
  .as-k {
    display: flex; align-items: center; gap: 0.55rem;
    font-family: var(--font-display); font-weight: 600; font-size: clamp(1.08rem, 1.2vw, 1.3rem); color: var(--ink-primary);
  }
  .as-k b {
    display: grid; place-items: center; width: 1.7rem; height: 1.7rem; border-radius: 50%;
    font-size: 0.95rem; background: var(--color-rosso); color: var(--color-bianco);
  }
  .as-box {
    display: grid; gap: 0.55rem; padding: 0.9rem 1rem; border-radius: 0.7rem;
    border: 1px solid rgba(255, 255, 255, 0.22); background: rgba(14, 19, 30, 0.78);
    box-shadow: 0 14px 34px rgba(6, 10, 18, 0.4);
  }
  .as-q {
    justify-self: end; max-width: 88% !important; padding: 0.45rem 0.75rem; border-radius: 0.6rem 0.6rem 0.15rem 0.6rem;
    background: rgba(255, 255, 255, 0.12); font-size: clamp(0.98rem, 1.04vw, 1.1rem); line-height: 1.4; color: var(--ink-primary);
  }
  .as-a, .as-r {
    max-width: 92% !important; padding: 0.5rem 0.75rem; border-radius: 0.6rem 0.6rem 0.6rem 0.15rem;
    font-size: clamp(0.98rem, 1.04vw, 1.1rem); line-height: 1.45; color: var(--ink-secondary);
    border: 1px solid var(--line-subtle);
  }
  .as-a mark {
    padding: 0 0.2rem; border-radius: 0.2rem; color: var(--ink-primary); font-weight: 600;
    background: rgba(217, 24, 53, 0.4);
  }
  .as-chk { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.25rem; }
  .as-chk li {
    display: flex; align-items: center; gap: 0.5rem;
    font-size: clamp(0.94rem, 0.98vw, 1.04rem); color: var(--ink-secondary);
  }
  .as-chk li::before {
    content: ''; flex: none; width: 0.95rem; height: 0.95rem; border-radius: 0.2rem;
    border: 1.5px solid var(--color-verde-chiaro);
  }
  .as-cap { font-size: clamp(0.98rem, 1.04vw, 1.1rem); line-height: 1.45; color: var(--ink-secondary); }

  .as-sc--peso .as-k b { background: var(--color-verde); }
  .as-box--aa { border-color: rgba(79, 189, 180, 0.5); background: rgba(0, 60, 64, 0.55); }
  .as-aa-t { font-size: clamp(0.86rem, 0.9vw, 0.96rem); font-weight: 700; letter-spacing: 0.04em; color: var(--color-verde-chiaro); }
  .as-met {
    display: flex; align-items: center; justify-content: space-between; gap: 0.8rem;
    padding: 0.55rem 0.7rem; border-radius: 0.45rem; background: rgba(255, 255, 255, 0.07);
  }
  .as-met span { font-size: clamp(0.98rem, 1.02vw, 1.08rem); line-height: 1.35; color: var(--ink-primary); }
  .as-met strong {
    font-family: var(--font-display); font-size: clamp(1.8rem, 2.2vw, 2.4rem); line-height: 1; color: var(--color-verde-chiaro);
  }

  .as-r small {
    display: block; margin-bottom: 0.1rem; font-size: clamp(0.8rem, 0.84vw, 0.9rem); font-weight: 700;
    letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-tertiary);
  }
  .as-r--no { color: var(--ink-tertiary); }
  .as-r--si { border-color: rgba(79, 189, 180, 0.6); background: rgba(0, 102, 102, 0.3); color: var(--ink-primary); }
  .as-r--si small { color: var(--color-verde-chiaro); }

  /* Il punto interrogativo pulsa una volta quando la scena entra: è la domanda, non un dato. */
  .as-sc--peso[data-substep-active] .as-met strong { animation: as-chiede 1.2s ease-out 0.4s 1 both; }
  @keyframes as-chiede { 0% { transform: scale(0.6); opacity: 0; } 60% { transform: scale(1.15); opacity: 1; } 100% { transform: none; } }
  @media (prefers-reduced-motion: reduce) { .as-sc--peso[data-substep-active] .as-met strong { animation: none; } }

  @media (max-width: 1100px) { .as { grid-template-columns: minmax(0, 1fr); max-width: 36rem; } }
</style>
