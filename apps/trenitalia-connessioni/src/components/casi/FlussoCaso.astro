---
/**
 * FlussoCaso — il dato di un caso, da dove parte a che cosa vede chi viaggia.
 *
 * PERCHÉ ESISTE (23 nov 2026). Il flusso era un elenco numerato di quattro
 * stadi, e i prodotti Adobe si leggevano come parole in una riga. Qui ogni
 * prodotto è un nodo con il suo mestiere, fra un nodo e l'altro il filo dice
 * CHE COSA passa (il pubblico, o le tratte che diventano contenuto), e il
 * flusso finisce sulla pagina vera. Sotto, la misura torna in CJA: è lì che il
 * caso si giudica, e per questo il giudizio sta sull'anello di ritorno.
 *
 * I PASSI li decide chi presenta: cinque marcatori `[data-substep]` in fondo,
 * letti con `:has()`. Il nome di ogni prodotto si vede da subito, così
 * l'architettura si legge prima del racconto; il contenuto entra al suo passo,
 * e un impulso percorre il filo che lo precede. Con «Riduci movimento» o senza
 * JavaScript è tutto acceso: lo stato base è quello finale.
 */
import { lega } from '../../utils/lega';
import SchermoCaso from './SchermoCaso.astro';
import ChatCaso from './ChatCaso.astro';
import type { Caso } from '../../data/casi-duso';
import { FONTI } from '../../data/casi-duso';

interface Props { caso: Caso; class?: string }
const { caso: c, class: className } = Astro.props as Props;

const fonti = c.fonti.map((id) => FONTI.find((f) => f.id === id)!);
const conCrm = c.fonti.includes('crm');
const [src, cja, tgt, quarto] = c.flusso;
const richiede = quarto.k.startsWith('Richiede') ? quarto : null;

const etichetta =
  `Il flusso del caso «${c.titolo}». ` +
  `Le fonti: ${fonti.map((f) => f.nome).join(', ')}. ` +
  `Customer Journey Analytics ${cja.v}: ${cja.e}. ` +
  `Poi ${c.ponte}. Adobe Target ${tgt.v}: ${tgt.e}. ` +
  `Chi viaggia vede: ${c.schermo.titolo}. ` +
  `La misura torna in CJA: ${c.giudizio.chiude}`;
---
<div class:list={['fc', className]} data-flusso>
  <p class="sr-only">{etichetta}</p>
  <ol class="fc-fila" aria-hidden="true">
    <li class="fc-n fc-n--src" data-n="1">
      <p class="fc-p">{conCrm ? 'Adobe Analytics e CRM' : 'Adobe Analytics'}</p>
      <p class="fc-r">raccolgono, come&nbsp;oggi</p>
      <div class="fc-b">
        <ul class="fc-fonti">
          {fonti.map((f) => <li><b>{f.nome}</b><span>{f.nota}</span></li>)}
        </ul>
        <p class="fc-e">{lega(src.e)}</p>
      </div>
    </li>

    <li class="fc-filo" data-f="2"><span class="fc-l">connettore Analytics</span><i class="fc-dot"></i></li>

    <li class="fc-n fc-n--cja" data-n="2">
      <p class="fc-p">Customer Journey Analytics</p>
      <p class="fc-r">legge il viaggio</p>
      <div class="fc-b">
        <p class="fc-v">{lega(cja.v)}</p>
        <p class="fc-e">{lega(cja.e)}</p>
      </div>
    </li>

    <li class="fc-filo" data-f="3"><span class="fc-l">{lega(c.ponte)}</span><i class="fc-dot"></i></li>

    <li class="fc-n fc-n--tgt" data-n="3">
      <p class="fc-p">Adobe Target</p>
      <p class="fc-r">sceglie che cosa mostrare</p>
      <div class="fc-b">
        <p class="fc-v">{lega(tgt.v)}</p>
        <p class="fc-e">{lega(tgt.e)}</p>
        {richiede && <p class="fc-req"><b>Richiede in più</b> {lega(richiede.v)}</p>}
      </div>
    </li>

    <li class="fc-filo" data-f="4"><span class="fc-l">la variante scelta</span><i class="fc-dot"></i></li>

    <li class="fc-n fc-n--sc" data-n="4">
      <p class="fc-p">Chi viaggia</p>
      <p class="fc-r">vede</p>
      <div class="fc-b"><SchermoCaso caso={c} versione="con" mini /></div>
    </li>
  </ol>

  <div class="fc-giro" data-n="5">
    <div class="fc-chat"><ChatCaso caso={c} /></div>
    <span class="fc-giro-filo" aria-hidden="true"><i class="fc-dot fc-dot--r"></i></span>
    <div class="fc-giro-b" aria-hidden="true">
      <p class="fc-giro-k">La misura torna in CJA</p>
      <p class="fc-giro-v">{lega(c.giudizio.chiude)}</p>
      {c.giudizio.aperta && (
        <p class="fc-giro-a"><b>Se la verifica sui due siti resta aperta</b> {lega(c.giudizio.aperta)}</p>
      )}
      <ul class="fc-kpi">{c.kpi.map((k) => <li>{k}</li>)}</ul>
    </div>
  </div>

  {[1, 2, 3, 4, 5].map((p) => <i class="fc-m" data-substep data-p={p} aria-hidden="true"></i>)}
</div>

<style is:global>
  .fc {
    --fc-cja: var(--color-verde-chiaro);
    --fc-tgt: var(--color-rosso-chiaro);
    width: 100%; max-width: 84rem; margin-inline: auto; text-align: left;
  }
  [data-slide] .fc p, [data-slide] .fc li, [data-slide] .fc span { text-align: left; max-width: none; margin: 0; }
  .fc-fila {
    list-style: none; margin: 0; padding: 0;
    display: grid;
    grid-template-columns:
      minmax(0, 1fr) minmax(6.5rem, 0.5fr) minmax(0, 1.05fr) minmax(7.5rem, 0.6fr)
      minmax(0, 1.05fr) minmax(5.5rem, 0.42fr) minmax(0, 1fr);
    align-items: stretch;
  }

  /* ── I nodi ─────────────────────────────────────────────────────────── */
  .fc-n {
    display: flex; flex-direction: column; gap: 0.15rem;
    padding: 0.85rem 0.9rem 0.95rem; border-radius: 0.65rem;
    border: 1.5px solid rgba(255, 255, 255, 0.28); background: rgba(14, 19, 30, 0.72);
    transition: border-color 420ms ease, box-shadow 420ms ease, background 420ms ease;
  }
  .fc-p {
    font-family: var(--font-display); font-weight: 600; line-height: 1.15;
    font-size: clamp(1.02rem, 1.12vw, 1.22rem); color: var(--ink-primary);
  }
  .fc-r {
    font-size: clamp(0.92rem, 0.96vw, 1.02rem); font-weight: 600; color: var(--ink-tertiary);
  }
  .fc-n--cja .fc-r { color: var(--fc-cja); }
  .fc-n--tgt .fc-r { color: var(--fc-tgt); }
  .fc-b { display: flex; flex-direction: column; gap: 0.5rem; margin-top: 0.55rem; }
  .fc-v { font-size: clamp(0.98rem, 1.04vw, 1.12rem); line-height: 1.4; color: var(--ink-secondary); }
  /* L'esempio di dato: è la riga che fa capire, quindi ha il suo segno. */
  .fc-e {
    padding: 0.45rem 0.6rem; border-radius: 0.4rem;
    border: 1px dashed rgba(255, 255, 255, 0.32); background: rgba(255, 255, 255, 0.06);
    font-size: clamp(0.94rem, 0.98vw, 1.06rem); line-height: 1.4; color: var(--ink-primary);
  }
  .fc-n--cja .fc-e { border-color: rgba(79, 189, 180, 0.55); background: rgba(0, 102, 102, 0.22); }
  .fc-n--tgt .fc-e { border-color: rgba(255, 141, 157, 0.5); background: rgba(217, 24, 53, 0.14); }
  .fc-fonti { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.3rem; }
  .fc-fonti li {
    display: grid; gap: 0.05rem; padding: 0.35rem 0.55rem; border-radius: 0.35rem;
    background: rgba(255, 255, 255, 0.08);
  }
  .fc-fonti b { font-weight: 600; font-size: clamp(0.96rem, 1vw, 1.08rem); color: var(--ink-primary); }
  .fc-fonti span { font-size: clamp(0.84rem, 0.86vw, 0.92rem); color: var(--ink-tertiary); }
  .fc-req {
    font-size: clamp(0.9rem, 0.94vw, 1rem); line-height: 1.4; color: var(--ink-secondary);
    padding-top: 0.45rem; border-top: 1px solid var(--line-subtle);
  }
  .fc-req b { display: block; font-size: clamp(0.84rem, 0.86vw, 0.92rem); color: var(--fc-tgt); }
  .fc-n--sc { background: rgba(255, 255, 255, 0.05); }

  /* ── I fili: che cosa passa da un nodo all'altro ─────────────────────── */
  .fc-filo {
    position: relative; display: flex; flex-direction: column; justify-content: center; align-items: center;
    padding: 0 0.5rem;
  }
  .fc-filo::before {
    content: ''; position: absolute; left: 0; right: 0.35rem; top: 50%; height: 2px;
    background: rgba(255, 255, 255, 0.35);
  }
  .fc-filo::after {
    content: ''; position: absolute; right: 0.1rem; top: calc(50% - 0.32rem);
    border: 0.32rem solid transparent; border-left: 0.45rem solid rgba(255, 255, 255, 0.55);
  }
  .fc-l {
    position: absolute; z-index: 1; left: 0.3rem; right: 0.3rem; bottom: calc(50% + 0.55rem);
    text-align: center !important; text-wrap: balance;
    font-size: clamp(0.84rem, 0.88vw, 0.94rem); line-height: 1.3; font-weight: 600; color: var(--ink-secondary);
  }
  .fc-filo[data-f='3'] .fc-l { color: var(--fc-cja); }
  .fc-dot {
    position: absolute; top: calc(50% - 0.3rem); left: 0; width: 0.6rem; height: 0.6rem; border-radius: 50%;
    background: var(--color-bianco); box-shadow: 0 0 0 4px rgba(255, 255, 255, 0.18); opacity: 0;
  }
  .fc-filo[data-f='3'] .fc-dot { background: var(--fc-cja); box-shadow: 0 0 0 4px rgba(79, 189, 180, 0.25); }
  .fc-filo[data-f='4'] .fc-dot { background: var(--fc-tgt); box-shadow: 0 0 0 4px rgba(255, 141, 157, 0.25); }

  /* ── L'anello di ritorno: la misura ──────────────────────────────────── */
  .fc-giro {
    display: grid;
    grid-template-columns:
      minmax(0, 1fr) minmax(6.5rem, 0.5fr) minmax(0, 1.05fr) minmax(7.5rem, 0.6fr)
      minmax(0, 1.05fr) minmax(5.5rem, 0.42fr) minmax(0, 1fr);
  }
  /* Chi prepara il caso sta sotto le fonti, dove la riga è libera. */
  .fc-chat { grid-column: 1 / 3; grid-row: 1 / 3; align-self: end; padding-right: 1rem; }
  .fc-chat .cc-apri { margin-top: 0; text-align: left; }
  .fc-chat .cc-apri-b { text-align: left; }
  .fc-giro-filo {
    grid-column: 3 / 8; grid-row: 1; position: relative; display: block; height: 1.5rem;
    border: 2px dashed rgba(79, 189, 180, 0.6); border-top: 0; border-radius: 0 0 0.6rem 0.6rem;
    margin-left: 12.7%; margin-right: 12.1%;
  }
  .fc-giro-filo::before {
    content: ''; position: absolute; left: -0.45rem; top: -0.2rem;
    border: 0.4rem solid transparent; border-bottom: 0.55rem solid var(--fc-cja); border-top: 0;
  }
  .fc-dot--r { top: auto; bottom: -0.35rem; left: auto; right: 0; background: var(--fc-cja); }
  .fc-giro-b {
    grid-column: 3 / 8; grid-row: 2; margin-top: 0.7rem;
    display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 0.25rem 1.1rem; align-items: baseline;
    padding: 0.75rem 1rem; border-radius: 0.6rem;
    border: 1px solid rgba(79, 189, 180, 0.4); background: rgba(0, 102, 102, 0.2);
  }
  .fc-giro-k {
    grid-row: span 3; font-size: clamp(0.84rem, 0.88vw, 0.94rem); font-weight: 700;
    letter-spacing: 0.08em; text-transform: uppercase; color: var(--fc-cja); white-space: nowrap;
  }
  .fc-giro-v { font-size: clamp(1rem, 1.08vw, 1.16rem); line-height: 1.4; color: var(--ink-primary); }
  .fc-giro-a { font-size: clamp(0.92rem, 0.96vw, 1.02rem); line-height: 1.4; color: var(--ink-secondary); }
  .fc-giro-a b { color: var(--ink-primary); font-weight: 600; }
  .fc-kpi { list-style: none; margin: 0.15rem 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.35rem; }
  .fc-kpi li {
    padding: 0.15rem 0.55rem; border-radius: 999px; border: 1px solid rgba(79, 189, 180, 0.45);
    font-size: clamp(0.86rem, 0.9vw, 0.96rem); color: var(--ink-secondary);
  }
  .fc-m { display: block; width: 0; height: 0; }

  /* ── Un passo alla volta ─────────────────────────────────────────────────
     Prima del suo passo un nodo mostra solo il nome del prodotto: il corpo è
     assente (`visibility: hidden`), non trasparente. Il filo entra con il nodo
     che raggiunge, e l'impulso lo percorre una volta. */
  .fc .fc-b, .fc .fc-l, .fc .fc-giro-filo, .fc .fc-giro-b {
    opacity: 0; visibility: hidden; transform: translateY(6px);
    transition: opacity 420ms ease, transform 520ms cubic-bezier(0.16, 1, 0.3, 1), visibility 420ms;
  }
  .fc:has(.fc-m[data-p='1'][data-substep-active]) [data-n='1'] .fc-b,
  .fc:has(.fc-m[data-p='2'][data-substep-active]) [data-n='2'] .fc-b,
  .fc:has(.fc-m[data-p='3'][data-substep-active]) [data-n='3'] .fc-b,
  .fc:has(.fc-m[data-p='4'][data-substep-active]) [data-n='4'] .fc-b,
  .fc:has(.fc-m[data-p='2'][data-substep-active]) [data-f='2'] .fc-l,
  .fc:has(.fc-m[data-p='3'][data-substep-active]) [data-f='3'] .fc-l,
  .fc:has(.fc-m[data-p='4'][data-substep-active]) [data-f='4'] .fc-l,
  .fc:has(.fc-m[data-p='5'][data-substep-active]) .fc-giro-filo,
  .fc:has(.fc-m[data-p='5'][data-substep-active]) .fc-giro-b {
    opacity: 1; visibility: visible; transform: none;
  }
  .fc:has(.fc-m[data-p='1'][data-substep-active]) [data-n='1'] { border-color: rgba(255, 255, 255, 0.7); }
  .fc:has(.fc-m[data-p='2'][data-substep-active]) [data-n='2'] { border-color: var(--fc-cja); box-shadow: 0 12px 30px rgba(0, 102, 102, 0.35); }
  .fc:has(.fc-m[data-p='3'][data-substep-active]) [data-n='3'] { border-color: var(--fc-tgt); box-shadow: 0 12px 30px rgba(217, 24, 53, 0.3); }
  .fc:has(.fc-m[data-p='4'][data-substep-active]) [data-n='4'] { border-color: rgba(255, 255, 255, 0.7); }

  .fc:has(.fc-m[data-p='2'][data-substep-active]) [data-f='2'] .fc-dot,
  .fc:has(.fc-m[data-p='3'][data-substep-active]) [data-f='3'] .fc-dot,
  .fc:has(.fc-m[data-p='4'][data-substep-active]) [data-f='4'] .fc-dot {
    animation: fc-corre 900ms cubic-bezier(0.45, 0, 0.2, 1) 1 both;
  }
  .fc:has(.fc-m[data-p='5'][data-substep-active]) .fc-dot--r { animation: fc-torna 1100ms cubic-bezier(0.45, 0, 0.2, 1) 1 both; }
  @keyframes fc-corre {
    0% { left: 0; opacity: 0; } 15% { opacity: 1; } 85% { opacity: 1; } 100% { left: calc(100% - 0.9rem); opacity: 0; }
  }
  @keyframes fc-torna {
    0% { right: 0; opacity: 0; } 15% { opacity: 1; } 85% { opacity: 1; } 100% { right: calc(100% - 0.6rem); opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .fc .fc-b, .fc .fc-l, .fc .fc-giro-filo, .fc .fc-giro-b { opacity: 1; visibility: visible; transform: none; transition: none; }
    .fc .fc-dot { display: none; }
  }
  html:not(.js) .fc .fc-b, html:not(.js) .fc .fc-l,
  html:not(.js) .fc .fc-giro-filo, html:not(.js) .fc .fc-giro-b { opacity: 1; visibility: visible; transform: none; }

  /* Su uno schermo basso resta il mestiere di ogni nodo e l'esempio di dato:
     la riga descrittiva e le note delle fonti escono, il tipo non scende. */
  @media (max-width: 1300px), (max-height: 940px) {
    .fc-v, .fc-fonti span, .fc-kpi, .fc-giro-a { display: none; }
    .fc .sc--mini .sc-tess li:nth-child(n + 2) { display: none; }
    .fc .sc--mini .sc-top { padding: 0.3rem 0.6rem; }
    .fc-n { padding: 0.6rem 0.7rem 0.7rem; }
    .fc-b { margin-top: 0.4rem; gap: 0.4rem; }
    .fc-giro-filo { height: 1rem; }
    .fc-giro-b { margin-top: 0.45rem; padding: 0.55rem 0.8rem; }
  }

  /* Sotto i 900px il flusso scende in colonna e il filo diventa verticale. */
  @media (max-width: 900px) {
    .fc-fila, .fc-giro { grid-template-columns: minmax(0, 1fr); }
    .fc-filo { min-height: 3rem; }
    .fc-filo::before { left: 50%; right: auto; top: 0; bottom: 0; width: 2px; height: auto; }
    .fc-filo::after { display: none; }
    .fc-l { position: relative; left: auto; right: auto; bottom: auto; background: var(--surface-primary); padding: 0 0.4rem; }
    .fc-dot { display: none; }
    .fc-giro-filo { display: none; }
    .fc-giro-b, .fc-giro-filo, .fc-chat { grid-column: 1; grid-row: auto; }
    .fc-chat { order: 2; padding: 0.8rem 0 0; }
    .fc-giro-b { grid-template-columns: minmax(0, 1fr); }
    .fc-giro-k { grid-row: auto; }
  }
</style>
