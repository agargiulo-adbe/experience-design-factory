---
/**
 * SchermoCaso — la pagina che vede chi viaggia, oggi o con il caso acceso.
 *
 * PERCHÉ ESISTE (23 nov 2026). Il caso si capisce quando si vedono due pagine
 * una accanto all'altra: quella di oggi, uguale per tutti, e quella che sceglie
 * Target per questo profilo. Prima il mock mostrava solo le varianti in elenco,
 * e la differenza bisognava immaginarla.
 *
 * LA PELLE È QUELLA DI TRENITALIA, semplificata: la barra rossa di marchio, sul
 * web la striscia «Da · A · Data · Cerca», sull'app la barra in fondo. Non è un
 * ritratto fedele dell'interfaccia e non deve esserlo.
 *
 * Il telefono si usa solo dove Target agisce soltanto nell'app; altrove la
 * cornice è il browser, con l'indirizzo di dove succede.
 */
import { lega } from '../../utils/lega';
import type { Caso } from '../../data/casi-duso';

interface Props {
  caso: Caso;
  versione: 'oggi' | 'con';
  /** La miniatura dentro la figura del flusso: niente ricerca, niente barra in fondo. */
  mini?: boolean;
  class?: string;
}
const { caso: c, versione, mini = false, class: className } = Astro.props as Props;
const app = c.superfici.length === 1 && c.superfici[0] === 'app';
const con = versione === 'con';
---
<div
  class:list={['sc', app ? 'sc--app' : 'sc--web', con ? 'sc--con' : 'sc--oggi', mini && 'sc--mini', className]}
  aria-hidden="true"
>
  {!app && (
    <div class="sc-url">
      <i></i><i></i><i></i>
      <span>{c.schermo.dove}</span>
    </div>
  )}
  <div class="sc-top">
    <span class="sc-top-m">Trenitalia</span>
    <span class="sc-top-r"><i></i><i></i></span>
  </div>
  {!app && !mini && (
    <div class="sc-cerca">
      <span>Da</span><span>A</span><span>Data</span><b>Cerca</b>
    </div>
  )}

  <div class="sc-pag">
    {con ? (
      <>
        <p class="sc-h">
          <span>{lega(c.schermo.titolo)}</span>
          <em class="sc-badge">{c.config === 'a' ? 'per questa area' : c.config === 'b' ? 'per questa visita' : 'per questo profilo'}</em>
        </p>
        <ul class="sc-tess">
          {c.schermo.tessere.map((t) => (
            <li><span class="sc-t">{lega(t.t)}</span><span class="sc-n">{t.n}</span></li>
          ))}
        </ul>
      </>
    ) : (
      <>
        <p class="sc-h"><span>{lega(c.oggiSchermo.titolo)}</span></p>
        <ul class="sc-tess sc-tess--muta">
          {c.varianti.filter((v) => !v.match).map((v) => (
            <li><span class="sc-t">{lega(v.t)}</span><span class="sc-n">{v.n}</span></li>
          ))}
        </ul>
        <p class="sc-nota">{lega(c.oggiSchermo.nota)}</p>
      </>
    )}
  </div>

  {app && !mini && (
    <div class="sc-tab"><b>Home</b><span>Biglietti</span><span>Viaggi</span><span>Profilo</span></div>
  )}
</div>

<style is:global>
  .sc {
    --sc-bordo: rgba(255, 255, 255, 0.22);
    position: relative; overflow: hidden; width: 100%;
    border: 1px solid var(--sc-bordo); border-radius: 0.55rem;
    background: var(--color-grigio-100); color: var(--color-ardesia-notte);
    box-shadow: 0 18px 40px rgba(6, 10, 18, 0.45);
    text-align: left;
  }
  [data-slide] .sc p, [data-slide] .sc li, [data-slide] .sc span { text-align: left; max-width: none; margin: 0; }
  .sc--app { border-radius: 1.4rem; border-width: 0.45rem; border-color: var(--color-ardesia-notte); max-width: 21rem; margin-inline: auto; }

  .sc-url {
    display: flex; align-items: center; gap: 0.3rem;
    padding: 0.35rem 0.6rem; background: var(--color-chiaro); border-bottom: 1px solid var(--color-grigio-200);
  }
  .sc-url i { width: 0.5rem; height: 0.5rem; border-radius: 50%; background: var(--color-grigio-300); }
  .sc-url span {
    margin-left: 0.4rem !important; flex: 1; padding: 0.1rem 0.6rem; border-radius: 0.3rem; background: var(--color-bianco);
    font-size: clamp(0.78rem, 0.8vw, 0.86rem); color: var(--color-grigio-500); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .sc-top {
    display: flex; align-items: center; justify-content: space-between;
    padding: 0.45rem 0.8rem; background: var(--color-rosso);
  }
  .sc-top-m { font-family: var(--font-display); font-weight: 700; font-size: clamp(0.95rem, 1vw, 1.08rem); color: var(--color-bianco); }
  .sc-top-r { display: flex; gap: 0.3rem; }
  .sc-top-r i { width: 0.7rem; height: 0.7rem; border-radius: 0.15rem; background: rgba(255, 255, 255, 0.45); }
  .sc-cerca {
    display: grid; grid-template-columns: 1fr 1fr 0.8fr auto; gap: 0.3rem;
    padding: 0.5rem 0.8rem; background: var(--color-bianco); border-bottom: 1px solid var(--color-chiaro);
  }
  .sc-cerca span {
    padding: 0.25rem 0.45rem; border: 1px solid var(--color-grigio-200); border-radius: 0.25rem;
    font-size: clamp(0.78rem, 0.8vw, 0.86rem); color: var(--color-grigio-500);
  }
  .sc-cerca b {
    padding: 0.25rem 0.7rem; border-radius: 0.25rem; background: var(--color-ardesia);
    font-size: clamp(0.78rem, 0.8vw, 0.86rem); font-weight: 700; color: var(--color-bianco); text-transform: uppercase; letter-spacing: 0.04em;
  }

  .sc-pag { display: grid; gap: 0.55rem; padding: 0.8rem 0.8rem 0.9rem; }
  .sc-h {
    display: flex; flex-wrap: wrap; align-items: center; gap: 0.35rem 0.6rem;
    font-family: var(--font-display); font-weight: 700; line-height: 1.15;
    font-size: clamp(1.05rem, 1.2vw, 1.3rem); color: var(--color-ardesia-notte);
  }
  .sc-badge {
    font-style: normal; font-family: var(--font-body); font-weight: 700;
    font-size: clamp(0.72rem, 0.74vw, 0.8rem); letter-spacing: 0.08em; text-transform: uppercase;
    padding: 0.15rem 0.45rem; border-radius: 0.25rem; background: var(--color-rosso); color: var(--color-bianco);
  }
  .sc-tess { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.35rem; }
  .sc-tess li {
    display: flex; justify-content: space-between; align-items: baseline; gap: 0.6rem;
    padding: 0.45rem 0.6rem; border-radius: 0.35rem; background: var(--color-bianco); border: 1px solid var(--color-grigio-200);
  }
  .sc-t { font-weight: 600; font-size: clamp(0.92rem, 0.98vw, 1.04rem); color: var(--color-ardesia-notte); }
  .sc-n { font-size: clamp(0.84rem, 0.88vw, 0.94rem); color: var(--color-grigio-500); white-space: nowrap; }
  .sc--con .sc-tess li:first-child { border-color: var(--color-rosso); box-shadow: inset 0 0 0 1px var(--color-rosso); }
  .sc-tess--muta li { background: var(--color-chiaro); }
  .sc-tess--muta .sc-t, .sc-tess--muta .sc-n { color: var(--color-grigio-500); font-weight: 500; }
  .sc-nota {
    font-size: clamp(0.86rem, 0.9vw, 0.96rem); line-height: 1.35; color: var(--color-grigio-500); font-style: italic;
  }
  .sc-tab {
    display: grid; grid-template-columns: repeat(4, 1fr); text-align: center;
    padding: 0.45rem 0.3rem; background: var(--color-bianco); border-top: 1px solid var(--color-chiaro);
  }
  .sc-tab b, .sc-tab span { text-align: center !important; font-size: clamp(0.76rem, 0.78vw, 0.84rem); color: var(--color-grigio-500); }
  .sc-tab b { color: var(--color-rosso); }

  /* La miniatura nella figura del flusso: stessa pagina, meno cornice. */
  .sc--mini { box-shadow: 0 10px 24px rgba(6, 10, 18, 0.4); }
  .sc--mini.sc--app { border-width: 0.3rem; border-radius: 1rem; }
  .sc--mini .sc-pag { padding: 0.55rem; gap: 0.4rem; }
  .sc--mini .sc-tess li:nth-child(n + 3) { display: none; }
  .sc--mini .sc-url { display: none; }
  .sc--mini .sc-h { font-size: clamp(0.98rem, 1.04vw, 1.1rem); }
  .sc--mini .sc-tess li { display: grid; gap: 0; }
  .sc--mini .sc-n { white-space: normal; }

  /* Su uno schermo basso la pagina perde la cornice, non il contenuto. */
  @media (max-width: 1300px), (max-height: 940px) {
    .sc-cerca { display: none; }
    .sc-url { padding: 0.25rem 0.5rem; }
    .sc-pag { padding: 0.55rem 0.65rem 0.65rem; gap: 0.4rem; }
    .sc-tess li { padding: 0.35rem 0.5rem; }
    .sc-tess li:nth-child(n + 3) { display: none; }
    .sc--app { max-width: 17rem; }
  }
</style>
