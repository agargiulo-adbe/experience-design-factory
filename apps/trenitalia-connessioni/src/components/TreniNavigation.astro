---
import { href } from '@edf/core/utils/url.js';
import { PERCORSO } from '../data/percorso';

interface Props {
  currentPath: string;
  base: string;
  /** Ramo corrente: cambia rail e sottotitolo. Assente = tronco. */
  branch?: 'fs-park' | 'trenitalia';
}

const { currentPath, base, branch } = Astro.props;

interface NavEntry { slug: string; label: string; solution: string | null; num: string | null }

// Il percorso di default è uno e lineare, e viene da `src/data/percorso.ts`:
// tronco e capitoli nella stessa barra, così chi legge vede dove si trova
// dentro l'intero documento invece di due serie separate. I capitoli portano
// il numero, il tronco no — due «01» nello stesso deck obbligavano a ricordare
// quale serie si stesse guardando.
let nCap = 0;
const railPercorso: NavEntry[] = PERCORSO.map((t) => ({
  slug: t.slug,
  label: t.label,
  solution: t.solution ?? null,
  num: t.kind === 'Capitolo' ? String(++nCap).padStart(2, '0') : null,
}));

// Il ramo FS Park è fuori dal percorso di default ma le sue pagine restano in
// piedi: quando si apre una di quelle, la barra torna a essere la sua.
const railFsPark: NavEntry[] = [
  { slug: 'fs-park/partenza',        label: 'Partenza',        solution: null,           num: '01' },
  { slug: 'fs-park/fondamenta',      label: 'Fondamenta',      solution: null,           num: '02' },
  { slug: 'fs-park/convergenza',     label: 'Convergenza',     solution: 'cja',          num: '03' },
  { slug: 'fs-park/meta-invisibile', label: 'Metà invisibile', solution: 'data-collab',  num: '04' },
  { slug: 'fs-park/percorso',        label: 'Percorso',        solution: null,           num: '05' },
];

const inFsPark = branch === 'fs-park';
const sections = inFsPark ? railFsPark : railPercorso;
const subLabel = inFsPark ? 'FS Park' : branch === 'trenitalia' ? 'Trenitalia' : 'Adobe × FS';

function isActive(slug: string) {
  const norm = currentPath.replace(/\/+$/, '');
  if (slug === '') return norm.endsWith('/trenitalia-connessioni') || norm.endsWith('/index');
  return norm.endsWith('/' + slug);
}
---
<nav
  class="flex items-center justify-between px-6 py-3 bg-[var(--color-ardesia-notte)]/95 backdrop-blur-sm border-b border-[var(--color-ardesia-media)]"
  aria-label="Navigazione esperienza"
>
  <a
    href={href(base, '/')}
    class="flex items-center gap-2.5 no-underline group flex-shrink-0"
    aria-label="Home — Connessioni Intelligenti"
  >
    <span class="inline-flex items-center justify-center w-7 h-7 rounded bg-[var(--accent-primary)] flex-shrink-0" aria-hidden="true">
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
        <rect x="1" y="6" width="12" height="1.5" rx="0.75" fill={branch === 'fs-park' ? '#1b2230' : 'white'}/>
        <rect x="1" y="3" width="12" height="1.5" rx="0.75" fill={branch === 'fs-park' ? '#1b2230' : 'white'} opacity="0.6"/>
        <rect x="1" y="9" width="12" height="1.5" rx="0.75" fill={branch === 'fs-park' ? '#1b2230' : 'white'} opacity="0.6"/>
      </svg>
    </span>
    <span class="text-sm font-semibold text-[var(--color-chiaro)] group-hover:text-white transition-colors font-[family-name:var(--font-display)] whitespace-nowrap">
      Connessioni Intelligenti
    </span>
    <span class="hidden 2xl:inline text-[0.72rem] font-bold tracking-widest uppercase text-[var(--color-chiaro)]/70 ml-1 whitespace-nowrap">
      {subLabel}
    </span>
  </a>

  <ol class="hidden md:flex flex-nowrap items-center gap-0.5 min-w-0 overflow-x-auto [scrollbar-width:none] [-ms-overflow-style:none] [&::-webkit-scrollbar]:hidden" role="list">
    {inFsPark && (
      <li role="listitem" class="flex-shrink-0">
        <a
          href={href(base, '/bivio')}
          class="block whitespace-nowrap px-2.5 py-1.5 text-xs font-medium rounded-sm transition-colors no-underline text-[var(--color-grigio-300)] hover:text-[var(--color-chiaro)] hover:bg-[var(--color-ardesia-media)]"
        >
          <span aria-hidden="true" class="mr-1">⇤</span>Bivio
        </a>
      </li>
    )}
    {sections.map((s) => (
      <li
        data-nav-solution={s.solution ?? undefined}
        role="listitem"
        class="flex-shrink-0"
      >
        <a
          href={href(base, '/' + s.slug)}
          class={[
            'block whitespace-nowrap px-2.5 py-1.5 text-xs font-medium rounded-sm transition-colors no-underline',
            isActive(s.slug)
              ? 'bg-[var(--accent-primary)]/15 text-[var(--accent-primary)] border border-[var(--accent-primary)]/30'
              : 'text-[var(--color-grigio-300)] hover:text-[var(--color-chiaro)] hover:bg-[var(--color-ardesia-media)]',
          ].join(' ')}
          aria-current={isActive(s.slug) ? 'page' : undefined}
        >
          {/* Solo i capitoli sono numerati: il tronco numerato dava due «01»
              nello stesso documento, e chi legge doveva ricordare quale serie
              stesse guardando. */}
          {s.num && (
            <span class="text-[var(--color-grigio-400)] mr-1 tabular-nums">{s.num}</span>
          )}
          {s.label}
        </a>
      </li>
    ))}
  </ol>

  <div class="flex items-center gap-3 flex-shrink-0">
    <a
      href={href(base, '/admin')}
      class="text-[0.7rem] font-semibold tracking-wider uppercase px-3 py-1.5 border border-[var(--color-ardesia-media)] text-[var(--color-grigio-400)] hover:text-[var(--color-chiaro)] hover:border-[var(--color-grigio-300)] rounded-sm transition-colors no-underline"
      data-admin-only
    >
      Admin
    </a>
  </div>
</nav>
