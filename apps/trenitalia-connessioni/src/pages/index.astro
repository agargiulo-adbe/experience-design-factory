---
import BaseLayout from '../layouts/BaseLayout.astro';
import Sfondo from '../components/Sfondo.astro';
import SfondoLoop from '../components/SfondoLoop.astro';
import TreniNavigation from '../components/TreniNavigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import CoverHero from '@edf/core/blocks/CoverHero.astro';
import CoBrand from '../components/CoBrand.astro';
import { href } from '@edf/core/utils/url.js';
import { EXPERIENCE_TYPES } from '@edf/core/data/experienceTypes';
import { CAPITOLI } from '../data/percorso';
import { lega } from '../utils/lega';

const TYPE = 'blueprint' as const;
const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;

// Le tappe vengono da `src/data/percorso.ts`, la stessa fonte che alimenta la
// barra di navigazione e le frecce: scritte a mano qui divergevano dal resto al
// primo cambio di perimetro. Il tronco non è numerato — due «01» nello stesso
// documento obbligavano chi legge a ricordare quale serie stesse guardando.
// Le card sono i CAPITOLI: lo scenario è dove porta il bottone qui sotto, e
// metterlo anche fra le card faceva cinque blocchi, cioè una griglia che non
// si bilancia in nessun modo.
const journey = CAPITOLI.map((t, i) => ({
  kind: String(i + 1).padStart(2, '0'),
  label: t.label,
  sub: t.sub,
  href: '/' + t.slug,
}));

---
<BaseLayout
  title="Connessioni Intelligenti"
  description="La ricerca su trenitalia.com e l’acquisto su Le Frecce, letti insieme in tre fasi: che cosa si vede subito, quali casi si provano su Adobe Target, che cosa si decide a dicembre."
  branch="trenitalia"
>
  <div class="fixed top-0 left-0 right-0 z-50">
    <TreniNavigation currentPath={currentPath} base={base} branch="trenitalia" />
  </div>

  <DeckContainer wallScale nextHref={href(base, '/trenitalia/partenza')}>

    <!-- ── SLIDE 0: Cover ─────────────────────────────────────────── -->
    <Slide id="slide-cover" bg="primary" align="center" data-made-with="Firefly" data-made-with-for="clip">
      <div slot="backdrop" class="absolute inset-0">
        <div class="fs-bg"></div>
        <div class="fs-grid"></div>
      </div>
      <SfondoLoop slot="backdrop" id="linea-cover" forza="leggera" />
      <!-- Prima slide del percorso: qui il lockup è CONTENUTO, non chrome, e
           prende il posto dell'occhiello di testo. L'ordine Adobe × Brand non
           è una scelta di questa pagina: sta nel markup del componente
           condiviso, così non si può invertire. Fino al 9 ott qui c'era
           «FS Group ~ Adobe», cioè l'ordine sbagliato scritto a mano. -->
      <CoBrand brand="Trenitalia" variant="hero" class="edf-cover-lockup mb-7" data-reveal />
      <CoverHero
        eyebrow="trenitalia.com e Le Frecce, letti insieme"
        title="Connessioni Intelligenti"
        lead="Oggi la ricerca sta su un sito e l’acquisto su un altro. In tre fasi si leggono insieme, e Adobe Target lavora su quello che si legge."
        size="hero"
        tone="ink"
        signature={false}
      />
      <p class="mt-5 text-center text-[0.8rem] tracking-widest uppercase text-[var(--color-grigio-300)] max-w-2xl mx-auto">
        {EXPERIENCE_TYPES[TYPE].coverLine.it}. Scenari e numeri di esempio sono dichiarati slide per slide.
      </p>
    </Slide>

    <!-- ── SLIDE 2: Roadmap del percorso ──────────────────────────── -->
    <Slide id="slide-journey" bg="brand" align="center">
      <Sfondo slot="backdrop" id="tr-atrio" forza="forte" marca />
      <div class="w-full max-w-6xl mx-auto">
        <p class="fs-panel-tag text-center mb-3" style="color: rgba(241, 243, 244, 0.78);" data-reveal>
          IL PERCORSO
        </p>
        <h2
          class="font-[family-name:var(--font-display)] text-[var(--color-chiaro)] mb-4 text-center mx-auto max-w-3xl"
          style="font-size: clamp(2.05rem, 3.5vw, 3.1rem); font-weight: 600; line-height: 1.08; letter-spacing: -0.02em;"
          data-reveal
          data-reveal-delay="0.08"
        >
          Dalla proposta alle&nbsp;decisioni, in&nbsp;cinque&nbsp;capitoli.
        </h2>
        <p
          class="text-[clamp(0.9rem,1.05vw,1.05rem)] leading-[1.55] text-[var(--color-chiaro)]/80 max-w-2xl mx-auto text-center mb-8"
          data-reveal
          data-reveal-delay="0.15"
        >
          Chi ha dieci minuti legge il primo e l’ultimo. In coda, due appendici per il&nbsp;team&nbsp;tecnico.
        </p>

        <!-- La linea del percorso: tronco comune, poi i due rami -->
        <div class="relative pt-6" data-reveal data-reveal-delay="0.22">
          <div class="fs-line-h" style="top: 0.5rem; left: 5%; right: 5%; background: linear-gradient(90deg, rgba(241, 243, 244, 0) 0%, rgba(241, 243, 244, 0.9) 12%, rgba(241, 243, 244, 0.9) 88%, rgba(241, 243, 244, 0) 100%); box-shadow: 0 0 12px rgba(241, 243, 244, 0.35);"></div>
          <div class="grid grid-cols-2 md:grid-cols-5 auto-rows-fr gap-4">
            {journey.map((step) => (
              <a
                href={href(base, step.href)}
                data-edf-journey-card
                class="journey-card relative h-full px-5 pt-5 pb-4 border border-[var(--color-chiaro)]/25 rounded-md text-left text-[var(--color-chiaro)] transition-colors no-underline group"
              >
                <span class="absolute -top-[1.65rem] left-1/2 -translate-x-1/2 size-3 rounded-full bg-[var(--color-chiaro)] ring-4 ring-[var(--accent-primary)] group-hover:bg-white transition-colors"></span>
                <p class="text-[0.78rem] font-semibold tracking-widest uppercase text-[var(--color-chiaro)]/70 mb-1 font-[family-name:var(--font-display)] tabular-nums">
                  Capitolo {step.kind}
                </p>
                <p class="text-[1.05rem] font-semibold text-[var(--color-chiaro)] mb-1 font-[family-name:var(--font-display)]">
                  {step.label}
                </p>
                <p class="text-[0.95rem] leading-[1.45] text-[var(--color-chiaro)]/85">{lega(step.sub)}</p>
              </a>
            ))}
          </div>
        </div>

        <div class="text-center mt-8" data-reveal data-reveal-delay="0.35">
          <a
            href={href(base, '/trenitalia/partenza')}
            class="inline-flex items-center gap-3 px-9 py-2.5 text-[clamp(1rem,1.2vw,1.15rem)] font-semibold tracking-wide bg-[var(--color-chiaro)] text-[var(--color-ardesia-notte)] hover:bg-white transition-colors duration-300 focus-visible:outline-2 focus-visible:outline-[var(--color-chiaro)] focus-visible:outline-offset-4 font-[family-name:var(--font-display)]"
          >
            Dalla proposta, in una pagina
            <svg width="20" height="20" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        </div>
      </div>
    </Slide>

  </DeckContainer>
</BaseLayout>
