---
import BaseLayout from '../layouts/BaseLayout.astro';
import Sfondo from '../components/Sfondo.astro';
import SfondoLoop from '../components/SfondoLoop.astro';
import TreniNavigation from '../components/TreniNavigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import CoverHero from '@edf/core/blocks/CoverHero.astro';
import CoBrand from '../components/CoBrand.astro';
import { href } from '@edf/core/utils/url.js';
import { EXPERIENCE_TYPES } from '@edf/core/data/experienceTypes';

const TYPE = 'blueprint' as const;
const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;

// Il tronco non è numerato. Due capitoli «01» e due «02» nello stesso documento
// (Scenario/Partenza, Bivio/Fondamenta) obbligavano chi legge a tenere a mente
// quale serie stesse guardando: la numerazione 01–05 resta ai capitoli di ramo,
// il tronco si nomina per quello che è.
const journey = [
  { kind: 'Tronco', label: 'Scenario',   sub: 'Il viaggio di Davide, intero: dall\'auto alla destinazione', href: '/scenario' },
  { kind: 'Tronco', label: 'Il bivio',   sub: 'Due società, due sguardi sullo stesso percorso',             href: '/bivio' },
  { kind: 'Ramo',   label: 'FS Park',    sub: 'La metà su asfalto, in 5 capitoli che stanno in piedi da soli', href: '/fs-park/partenza' },
  { kind: 'Ramo',   label: 'Trenitalia', sub: 'La metà su rotaia, in 5 capitoli che stanno in piedi da soli', href: '/trenitalia/partenza' },
];

// Una notazione sola in tutto il deck (€16,5 mld, €100 mld) e ogni cifra
// intestata al documento da cui viene: «100B€» accanto a «€16,5B» erano due
// notazioni nella stessa riga, e i passeggeri stavano senza fonte.
const fsStats = [
  { value: '€16,5 mld', label: 'ricavi operativi 2024',     sub: 'Bilancio 2024 · +12% sul 2023' },
  { value: '840 mln+',  label: 'passeggeri all\'anno',      sub: 'Comunicato foundation digitale, marzo 2026' },
  { value: '€100 mld',  label: 'investimenti 2025–2029',    sub: 'Piano Strategico, dicembre 2024' },
];
---
<BaseLayout
  title="Connessioni Intelligenti"
  description="Come Customer Journey Analytics trasforma la complessità multi-sistema del Gruppo FS in un vantaggio competitivo concreto."
>
  <div class="fixed top-0 left-0 right-0 z-50">
    <TreniNavigation currentPath={currentPath} base={base} />
  </div>

  <DeckContainer wallScale nextHref={href(base, '/scenario')}>

    <!-- ── SLIDE 0: Cover ─────────────────────────────────────────── -->
    <Slide id="slide-cover" bg="primary" align="center" data-made-with="Firefly" data-made-with-for="clip">
      <div slot="backdrop" class="absolute inset-0">
        <div class="fs-bg"></div>
        <div class="fs-grid"></div>
      </div>
      <SfondoLoop slot="backdrop" id="linea-cover" forza="leggera" />
      <!-- Prima slide del percorso: qui il lockup è CONTENUTO, non chrome, e
           prende il posto dell'occhiello di testo. L'ordine Adobe × Brand non
           è una scelta di questa pagina: sta nel markup del componente
           condiviso, così non si può invertire. Fino al 9 ott qui c'era
           «FS Group ~ Adobe», cioè l'ordine sbagliato scritto a mano. -->
      <CoBrand variant="hero" class="edf-cover-lockup mb-7" data-reveal />
      <CoverHero
        eyebrow="L'intelligenza di ogni viaggio"
        title="Connessioni Intelligenti"
        lead="Ogni viaggio lascia segnali sparsi su più sistemi. Customer Journey Analytics li mette in fila e li rende leggibili come un unico percorso."
        size="hero"
        tone="ink"
        signature={false}
      />
      <p class="mt-5 text-center text-[0.75rem] tracking-widest uppercase text-[var(--color-grigio-300)] max-w-2xl mx-auto">
        {EXPERIENCE_TYPES[TYPE].coverLine.it}. I fatti sul Gruppo vengono da fonti pubbliche datate;
        il ramo FS Park da un tavolo di lavoro Adobe × FS Park di luglio 2026; il ramo Trenitalia
        da fonti pubbliche e da ipotesi nostre, senza un tavolo equivalente. Scenari e numeri di
        esempio sono dichiarati slide per slide.
      </p>

      <!-- Un solo viaggiatore, Davide: la linea sfuma dal verde (FS Park) al
           rosso (Trenitalia), le due società che lo guardano da lati opposti. -->
      <div class="relative w-full max-w-2xl mx-auto mt-9 mb-1" data-reveal data-reveal-delay="0.3">
        <div class="fs-line-h" style="top: 1.45rem; left: 14%; right: 14%; background: linear-gradient(90deg, rgba(var(--park-rgb), 0) 0%, rgba(var(--park-rgb), 0.9) 26%, rgba(var(--rail-rgb), 0.9) 74%, rgba(var(--rail-rgb), 0) 100%); box-shadow: 0 0 12px rgba(var(--rail-rgb), 0.28);"></div>
        <div class="relative flex justify-center items-start">
          <div class="flex flex-col items-center gap-2.5 text-center max-w-[26rem]">
            <span class="fs-node" data-active>D</span>
            <span class="fs-node-label">Davide, pendolare business Milano–Roma. Un viaggio solo, che FS Park e Trenitalia guardano da lati opposti.</span>
          </div>
        </div>
      </div>
    </Slide>

    <!-- ── SLIDE 1: Contesto FS ───────────────────────────────────── -->
    <Slide id="slide-fs-context" bg="primary" align="center">
      <div slot="backdrop" class="absolute inset-0">
        <div class="fs-bg"></div>
        <div class="fs-grid"></div>
      </div>
      <Sfondo slot="backdrop" id="tr-tetto" forza="forte" />
      <div class="w-full max-w-5xl mx-auto">
        <p class="fs-panel-tag mb-3" data-reveal>IL CONTESTO STRATEGICO</p>
        <h2
          class="text-[var(--ink-primary)] mb-5 font-[family-name:var(--font-display)]"
          style="font-size: clamp(2rem, 3.6vw, 3.4rem); font-weight: 600; line-height: 1.06; letter-spacing: -0.02em;"
          data-reveal
          data-reveal-delay="0.08"
        >
          Un Gruppo in piena accelerazione
        </h2>
        <p
          class="text-[var(--ink-secondary)] max-w-3xl mb-7"
          style="font-size: clamp(1rem, 1.25vw, 1.2rem); line-height: 1.55;"
          data-reveal
          data-reveal-delay="0.15"
        >
          Il Piano Strategico 2025–2029 vale oltre €100 mld di investimenti in cinque anni, di cui
          circa €60 mld sulla rete ferroviaria. Accanto corre un Piano Tecnologico da oltre €20 mld
          al 2034. La foundation digitale è già in cantiere: nel marzo 2026 FS Technology ha avviato
          la piattaforma agentica di Gruppo. CJA è il layer di intelligenza che la completa.
        </p>

        <!-- Le tre cifre come stazioni sulla linea del Gruppo. I nodi stanno nel
             FLUSSO, non in assoluto sopra il blocco: posizionati fuori finivano
             addosso all'ultima riga del lead a 1920. -->
        <div class="relative pt-3" data-reveal data-reveal-delay="0.22">
          <div class="fs-line-h" style="top: 1.45rem; left: 10%; right: 10%;"></div>
          <div class="grid grid-cols-3 gap-6">
            {fsStats.map((m) => (
              <div class="relative flex flex-col items-center text-center gap-[18px]">
                <span class="fs-node relative z-10" data-active aria-hidden="true"></span>
                <p class="fs-stat-value mt-1">{m.value}</p>
                <p class="fs-stat-label font-medium">{m.label}</p>
                <p class="fs-stat-src">{m.sub}</p>
              </div>
            ))}
          </div>
        </div>

        <!-- Le fonti stavano su una riga sola separate da &nbsp;·&nbsp;: ai
             viewport da muro i tre link andavano a capo e le loro scatole si
             sovrapponevano (check e). In flex-wrap con un gap vero non succede.
             Il quarto link è il Piano Tecnologico: la cifra al 2034 stava in
             pagina senza nessuna delle tre fonti che la coprisse. -->
        <p class="fs-panel-src mt-9 flex flex-wrap items-baseline gap-x-3 gap-y-1.5">
          <span>Fonti:</span>
          <a href="https://www.fsitaliane.it/content/fsitaliane/it/media/comunicati-stampa/2024/12/12/gruppo-fs-piano-strategico-2025-2029-100-miliardi-investimenti-accompagnare-crescita-paese.html" target="_blank" rel="noopener noreferrer" class="underline underline-offset-2">Piano Strategico 2025–2029 (dic 2024)</a>
          <a href="https://www.fsnews.it/it/focus-on/innovazione/2026/1/27/piano-strategico-fs-tecnologia-e-digitalizzazione.html" target="_blank" rel="noopener noreferrer" class="underline underline-offset-2">Piano Tecnologico al 2034 (gen 2026)</a>
          <a href="https://www.fsitaliane.it/it/media/comunicati-stampa/2025/4/3/risultati-bilancio-2024-gruppofs.html" target="_blank" rel="noopener noreferrer" class="underline underline-offset-2">Bilancio 2024 (apr 2025)</a>
          <a href="https://www.fsnews.it/it/focus-on/innovazione/2026/3/5/fs-technology-salesforce-foundation-digitale.html" target="_blank" rel="noopener noreferrer" class="underline underline-offset-2">Foundation digitale FS Technology (mar 2026)</a>
        </p>
      </div>
    </Slide>

    <!-- ── SLIDE 2: Roadmap del percorso ──────────────────────────── -->
    <Slide id="slide-journey" bg="brand" align="center">
      <Sfondo slot="backdrop" id="tr-atrio" forza="forte" marca />
      <div class="w-full max-w-5xl mx-auto">
        <p class="fs-panel-tag text-center mb-3" style="color: rgba(241, 243, 244, 0.78);" data-reveal>
          IL PERCORSO
        </p>
        <h2
          class="font-[family-name:var(--font-display)] text-[var(--color-chiaro)] mb-4 text-center mx-auto max-w-3xl"
          style="font-size: clamp(2.05rem, 3.5vw, 3.1rem); font-weight: 600; line-height: 1.08; letter-spacing: -0.02em;"
          data-reveal
          data-reveal-delay="0.08"
        >
          Un viaggio, due sguardi, una sola intelligenza.
        </h2>
        <p
          class="text-[clamp(0.9rem,1.05vw,1.05rem)] leading-[1.55] text-[var(--color-chiaro)]/80 max-w-2xl mx-auto text-center mb-8"
          data-reveal
          data-reveal-delay="0.15"
        >
          Due racconti distinti e autoconsistenti, uno per società: ciascuno parte dal proprio
          cliente e produce risultati in casa propria. Convergono perché sotto c'è la stessa
          piattaforma, che apre gli scenari di Gruppo quando le società vorranno.
        </p>

        <!-- La linea del percorso: tronco comune, poi i due rami -->
        <div class="relative pt-6" data-reveal data-reveal-delay="0.22">
          <div class="fs-line-h" style="top: 0.5rem; left: 5%; right: 5%; background: linear-gradient(90deg, rgba(241, 243, 244, 0) 0%, rgba(241, 243, 244, 0.9) 12%, rgba(241, 243, 244, 0.9) 88%, rgba(241, 243, 244, 0) 100%); box-shadow: 0 0 12px rgba(241, 243, 244, 0.35);"></div>
          <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
            {journey.map((step) => (
              <a
                href={href(base, step.href)}
                data-edf-journey-card
                class="journey-card relative px-4 pt-5 pb-3.5 border border-[var(--color-chiaro)]/25 rounded-md text-left text-[var(--color-chiaro)] transition-colors no-underline group"
              >
                <span class="absolute -top-[1.65rem] left-1/2 -translate-x-1/2 size-3 rounded-full bg-[var(--color-chiaro)] ring-4 ring-[var(--accent-primary)] group-hover:bg-white transition-colors"></span>
                <p class="text-[0.75rem] font-semibold tracking-widest uppercase text-[var(--color-chiaro)]/70 mb-1 font-[family-name:var(--font-display)]">
                  {step.kind}
                </p>
                <p class="text-[1.05rem] font-semibold text-[var(--color-chiaro)] mb-1 font-[family-name:var(--font-display)]">
                  {step.label}
                </p>
                <p class="text-[0.82rem] leading-[1.4] text-[var(--color-chiaro)]/75">{step.sub}</p>
              </a>
            ))}
          </div>
        </div>

        <div class="text-center mt-8" data-reveal data-reveal-delay="0.35">
          <a
            href={href(base, '/scenario')}
            class="inline-flex items-center gap-3 px-9 py-2.5 text-[clamp(1rem,1.2vw,1.15rem)] font-semibold tracking-wide bg-[var(--color-chiaro)] text-[var(--color-ardesia-notte)] hover:bg-white transition-colors duration-300 focus-visible:outline-2 focus-visible:outline-[var(--color-chiaro)] focus-visible:outline-offset-4 font-[family-name:var(--font-display)]"
          >
            Dallo scenario
            <svg width="20" height="20" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        </div>
      </div>
    </Slide>

  </DeckContainer>
</BaseLayout>
