---
import BaseLayout from '../layouts/BaseLayout.astro';
import TreniNavigation from '../components/TreniNavigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import SlideBackdrop from '@edf/core/blocks/SlideBackdrop.astro';
import { href } from '@edf/core/utils/url.js';
import { mediaProps } from '../../assets.index';

const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;

const chapters = [
  { num: '01', label: 'Partenza' },
  { num: '02', label: 'Fondamenta' },
  { num: '03', label: 'Convergenza' },
  { num: '04', label: 'Metà invisibile' },
  { num: '05', label: 'Percorso' },
];
---
<BaseLayout
  title="Il bivio"
  description="Un viaggio, due sguardi: da qui l'esperienza si divide nel ramo FS Park e nel ramo Trenitalia."
>
  <div class="fixed top-0 left-0 right-0 z-50">
    <TreniNavigation currentPath={currentPath} base={base} />
  </div>

  <DeckContainer
    nextHref={href(base, '/fs-park/partenza')}
    prevHref={href(base, '/scenario')}
  >

    <!-- ── SLIDE 0: La linea si spezza ───────────────────────────── -->
    <Slide id="slide-spezzata" bg="inverse" align="center">
      <div slot="backdrop" class="fs-bg"></div>
      <div slot="backdrop" class="fs-grid"></div>
      <SlideBackdrop
        slot="backdrop"
        {...mediaProps('bg-stazione')}
        imageClass="opacity-15"
        scrim="bg-[var(--color-carbonio)]/92"
      />
      <p class="fs-panel-tag text-center mb-4" data-reveal>02 · IL BIVIO</p>
      <h2
        class="text-[var(--color-ghiaccio)] mb-5 text-center font-[family-name:var(--font-display)]"
        style="font-size: clamp(2rem, 3.6vw, 3.4rem); font-weight: 600; line-height: 1.06; letter-spacing: -0.02em;"
        data-reveal
        data-reveal-delay="0.08"
      >
        Un viaggio, due sguardi
      </h2>
      <p
        class="text-[var(--color-grigio-200)] max-w-3xl mx-auto text-center mb-10"
        style="font-size: clamp(1rem, 1.25vw, 1.2rem); line-height: 1.55;"
        data-reveal
        data-reveal-delay="0.15"
      >
        Il lunedì di Davide è un percorso solo, ma dentro il Gruppo lo osservano due società
        diverse. FS Park lo accompagna dall'auto alla sbarra, Trenitalia lo prende in carico
        al binario. Ognuna ha valore da estrarre nella propria metà — e un punto cieco
        dove comincia quella dell'altra.
      </p>

      <!-- La linea del viaggio, spezzata al centro -->
      <div class="relative w-full max-w-4xl mx-auto" data-reveal data-reveal-delay="0.24">
        <span class="fs-line-h" style="top: 1.4rem; left: 4%; width: 40%; background: linear-gradient(90deg, rgba(245,166,35,0) 0%, rgba(245,166,35,0.9) 25%, rgba(245,166,35,0.9) 100%);" aria-hidden="true"></span>
        <span class="fs-line-h" style="top: 1.4rem; right: 4%; width: 40%; background: linear-gradient(90deg, rgba(226,0,26,0.9) 0%, rgba(226,0,26,0.9) 75%, rgba(226,0,26,0) 100%);" aria-hidden="true"></span>
        <span class="absolute left-1/2 -translate-x-1/2 text-[var(--color-grigio-500)] font-[family-name:var(--font-display)] text-sm tracking-widest" style="top: 0.9rem;" aria-hidden="true">∥</span>
        <div class="grid grid-cols-4 gap-4">
          <div class="flex flex-col items-center gap-2.5 text-center">
            <span class="fs-node fs-node--ambra" data-active>🚗</span>
            <span class="fs-node-label">L'auto, il tragitto, l'arrivo all'hub</span>
          </div>
          <div class="flex flex-col items-center gap-2.5 text-center">
            <span class="fs-node fs-node--ambra" data-active>🅿️</span>
            <span class="fs-node-label">La sosta — il mondo FS Park</span>
          </div>
          <div class="flex flex-col items-center gap-2.5 text-center">
            <span class="fs-node fs-node--rosso" data-active>🚆</span>
            <span class="fs-node-label">Il binario — il mondo Trenitalia</span>
          </div>
          <div class="flex flex-col items-center gap-2.5 text-center">
            <span class="fs-node fs-node--rosso" data-active>🏁</span>
            <span class="fs-node-label">Il viaggio, la destinazione</span>
          </div>
        </div>
      </div>

      <p class="mt-10 text-center fs-panel-src tracking-widest uppercase" data-reveal data-reveal-delay="0.32">
        La stessa piattaforma serve entrambe le metà · scegli il punto di partenza
      </p>
    </Slide>

    <!-- ── SLIDE 1: Le due porte ─────────────────────────────────── -->
    <Slide id="slide-porte" bg="inverse" align="center">
      <div slot="backdrop" class="fs-bg"></div>
      <div slot="backdrop" class="fs-grid"></div>
      <SlideBackdrop
        slot="backdrop"
        {...mediaProps('bg-dati')}
        imageClass="opacity-12"
        scrim="bg-[var(--color-carbonio)]/92"
      />
      <p class="fs-panel-tag text-center mb-3" data-reveal>SCEGLI IL PUNTO DI VISTA</p>
      <h2
        class="text-[var(--color-ghiaccio)] mb-8 text-center font-[family-name:var(--font-display)]"
        style="font-size: clamp(1.8rem, 3vw, 2.8rem); font-weight: 600; line-height: 1.06; letter-spacing: -0.02em;"
        data-reveal
        data-reveal-delay="0.08"
      >
        Stessi concetti, due punti di partenza
      </h2>

      <div class="w-full max-w-5xl mx-auto grid md:grid-cols-2 gap-6" data-reveal data-reveal-delay="0.16">
        <a href={href(base, '/fs-park/partenza')} class="fs-porta fs-porta--ambra">
          <p class="fs-porta-kicker">Ramo FS Park</p>
          <p class="fs-porta-title">La metà su asfalto</p>
          <p class="fs-porta-lead">Parti da qui se il tuo mondo è la sosta: sito, app, area riservata e CRM che diventano un solo cliente.</p>
          <div class="fs-porta-chapters">
            {chapters.map((c) => (
              <span class="fs-porta-chapter"><span class="fs-porta-num">{c.num}</span> <b>{c.label}</b></span>
            ))}
          </div>
          <span class="fs-porta-cta">Entra nel ramo FS Park
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
        </a>

        <a href={href(base, '/trenitalia/partenza')} class="fs-porta fs-porta--rosso">
          <p class="fs-porta-kicker">Ramo Trenitalia</p>
          <p class="fs-porta-title">La metà su rotaia</p>
          <p class="fs-porta-lead">Parti da qui se il tuo mondo è il viaggio: analytics, CRM e app letti finalmente come un unico percorso.</p>
          <div class="fs-porta-chapters">
            {chapters.map((c) => (
              <span class="fs-porta-chapter"><span class="fs-porta-num">{c.num}</span> <b>{c.label}</b></span>
            ))}
          </div>
          <span class="fs-porta-cta">Entra nel ramo Trenitalia
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
        </a>
      </div>

      <p class="mt-7 text-center fs-panel-src tracking-widest uppercase" data-reveal data-reveal-delay="0.28">
        Ogni ramo sta in piedi da solo: il valore nasce in casa di ciascuna società · l'incontro delle due metà è un orizzonte, non un prerequisito
      </p>
    </Slide>

  </DeckContainer>
</BaseLayout>
