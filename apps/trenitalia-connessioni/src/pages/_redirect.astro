---
// Stub di redirect per le vecchie sezioni pre-biforcazione (deep link già
// condivisi col cliente): ogni vecchia route inoltra alla pagina più vicina
// del ramo Trenitalia, preservando la query string. JS + <meta refresh> +
// link visibile per no-JS. Stesso pattern degli stub maxmara del factory-hub.
interface Props {
  /** Path sotto la base dell'app, es. 'trenitalia/fondamenta' (senza slash iniziale). */
  to: string;
}
const { to } = Astro.props;
const base = import.meta.env.BASE_URL;
const b = base.replace(/\/?$/, '/');
const target = `${b}${to}/`;
---
<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Reindirizzamento…</title>
    <link rel="canonical" href={target} />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <script is:inline define:vars={{ target }}>
      location.replace(target + location.search);
    </script>
    <style>
      body {
        margin: 0;
        min-height: 100vh;
        display: grid;
        place-items: center;
        background: #0d0d14;
        color: #f2f4f8;
        font-family: system-ui, -apple-system, 'Segoe UI', sans-serif;
        text-align: center;
        padding: 2rem;
      }
      p { color: #b0b6c4; margin: 0 0 1rem; }
      a { color: #f2f4f8; font-weight: 600; }
    </style>
  </head>
  <body>
    <main>
      <p>Questa sezione si è spostata nel ramo Trenitalia.</p>
      <a href={target}>Continua verso l'esperienza →</a>
    </main>
  </body>
</html>
