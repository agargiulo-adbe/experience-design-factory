---
// Stub di redirect per le vecchie sezioni pre-biforcazione (deep link già
// condivisi col cliente): ogni vecchia route inoltra alla pagina più vicina
// del ramo Trenitalia, preservando la query string. JS + <meta refresh> +
// link visibile per no-JS. Stesso pattern degli stub maxmara del factory-hub.
interface Props {
  /** Path sotto la base dell'app, es. 'trenitalia/fondamenta' (senza slash iniziale). */
  to: string;
}
const { to } = Astro.props;
const base = import.meta.env.BASE_URL;
const b = base.replace(/\/?$/, '/');
const target = `${b}${to}/`;
---
<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Reindirizzamento…</title>
    <link rel="canonical" href={target} />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <script is:inline define:vars={{ target }}>
      location.replace(target + location.search);
    </script>
    <style>
      body {
        margin: 0;
        min-height: 100vh;
        display: grid;
        place-items: center;
        background: #1b2230;
        color: #f1f3f4;
        font-family: system-ui, -apple-system, 'Segoe UI', sans-serif;
        text-align: center;
        padding: 2rem;
      }
      p { color: #adb5bd; margin: 0 0 1rem; }
      a { color: #f1f3f4; font-weight: 600; }
    </style>
      <!-- L'anteprima del link anche qui: questa pagina è un rimando, e un vecchio
         link incollato in chat è proprio il caso in cui il riquadro grigio fa
         sembrare rotto un link che funziona. L'URL è assoluto (i crawler non
         risolvono i relativi) e punta all'og.png dell'app di destinazione. -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Connessioni Intelligenti — Adobe × FS Group" />
    <meta property="og:description" content="Questo capitolo si è spostato: il percorso è stato riorganizzato." />
    <meta property="og:locale" content="it_IT" />
    <meta property="og:image" content={new URL(`${b}og.png`, Astro.site).href} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Connessioni Intelligenti — Adobe × FS Group" />
    <meta name="twitter:image" content={new URL(`${b}og.png`, Astro.site).href} />
  </head>
  <body>
    <main>
      <p>Questa sezione si è spostata nel ramo Trenitalia.</p>
      <a href={target}>Continua verso l'esperienza →</a>
    </main>
  </body>
</html>
