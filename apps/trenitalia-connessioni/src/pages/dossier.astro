---
import DocLayout from '../layouts/DocLayout.astro';
import DossierPage from '@edf/core/blocks/doc/DossierPage.astro';

// ── Pagina RISERVATA (Adobe internal) ──────────────────────────────────────
// Orfana (fuori nav) + noindex. Il contenuto confidenziale NON è nel bundle
// statico: vive in Supabase (tabella restricted_docs, RLS) e si carica solo
//   1) dopo login (super admin o utente con accesso a trenitalia-connessioni), o
//   2) via secret-link ?t=<uuid> (RPC get_shared_doc di 0009, senza login).
// Seed (git-ignorato): docs/Ferrovie/0027_seed_trenitalia_fstechnology_dossier.sql.
//
// ⚠️ PERCHÉ QUESTO FILE È STATO RISCRITTO il 15 ottobre 2026.
// Conteneva una COPIA del renderer — 503 righe — con il contenuto del dossier
// scritto inline: nome e ruolo del referente del cliente, nomi di due dirigenti,
// e la lettura del fornitore concorrente. Risultato: `dist/dossier/index.html`
// da 54 KB servito in chiaro su GitHub Pages, HTTP 200 senza alcun gate, e il
// sorgente tracciato in un repository PUBBLICO. `noindex` impedisce
// l'indicizzazione, non l'accesso: chiunque avesse l'URL leggeva tutto.
// Il contenuto gated esisteva già (slug `trenitalia-fstechnology`, nel database
// dal 9 ottobre): mancava solo questa pagina, rimasta indietro alla migrazione.
// Regola, da CLAUDE.md e dalla skill `dossier`: mai copiare il renderer dentro
// un'app, il contenuto riservato non sta mai nel bundle statico.
//
// L'altra pagina di dossier di questa app, `dossier-sales.astro`, prepara il
// tavolo con la Direzione Sales di Trenitalia: stanze diverse, vincoli diversi,
// documenti separati. Condividono l'experience nel registry, non il contenuto.
---
<DocLayout
  title="Dossier — FSTechnology"
  description="Adobe internal — dossier riservato (accesso ristretto)."
  noindex={true}
>
  <DossierPage
    docSlug="trenitalia-fstechnology"
    title="Dossier — FSTechnology"
    base={import.meta.env.BASE_URL}
    supabaseUrl={import.meta.env.PUBLIC_SUPABASE_URL ?? ''}
    supabaseAnon={import.meta.env.PUBLIC_SUPABASE_ANON_KEY ?? ''}
    deckHref="/experience-design-factory/trenitalia-connessioni/"
    deckLabel="Apri l'esperienza ↗"
  />
</DocLayout>
