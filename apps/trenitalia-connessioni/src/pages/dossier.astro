---
import BaseLayout from '../layouts/BaseLayout.astro';
import { href } from '@edf/core/utils/url.js';

const base = import.meta.env.BASE_URL;

// ── Pagina RISERVATA (Adobe internal) ──────────────────────────────────────
// Dossier di preparazione per l'Adobe Day con FSTechnology (Gruppo FS).
// Orfana (fuori nav) + noindex. Fonti pubbliche verificate (deep-research,
// 24 claim su 25, verifica avversariale a 3 voti). Nessun dato contrattuale.

const summary: string[] = [
  '<strong>Chi è.</strong> Maurizio Giampaolo è <strong>Digital Business Partner Trasporto</strong> nel Management di <strong>FSTechnology</strong> (FST), la società ICT in-house del Gruppo FS (nata 31/07/2019). È il raccordo tra l\'IT e il business delle società <em>di trasporto</em> del Gruppo.',
  '<strong>Cosa segue.</strong> Il perimetro Trasporto del Gruppo (Piano 2025-2029): tre Business Unit — <strong>Passeggeri</strong> (capofila Trenitalia, + Busitalia + FS Park), <strong>Passeggeri Internazionale</strong> (FS International) e <strong>Merci/Logistica</strong> (<strong>FS Logistix</strong>, ex Mercitalia Logistics: Mercitalia Rail, TX Logistik, Mercitalia Intermodal, Terminali Italia).',
  '<strong>Il fatto che cambia tutto.</strong> A marzo 2026 il Gruppo FS ha annunciato con <strong>Salesforce</strong> una "foundation digitale agentica" — <strong>coordinata proprio da FSTechnology</strong> — su Data Cloud + MuleSoft, per unificare la CX di 840M+ passeggeri/anno e della logistica merci. Salesforce presidia già lo strato CDP/CX che un pitch Adobe toccherebbe.',
  '<strong>La mossa.</strong> L\'Adobe Day non può essere un pitch CDP greenfield: va posizionato come <em>complementare</em> (content & experience layer, analytics, journey) o come <em>sfidante mirato</em> dove Adobe è oggettivamente più forte. Il tema <strong>merci/B2B</strong> è il vero ampliamento di orizzonte richiesto.',
  '<strong>Dove abbiamo già asset.</strong> Use case Trenitalia + FS Park in sviluppo nella Factory, proposta CJA FS Park e template Adobe Target per FS Tech (apr 2026) già in casa. La big idea multimodale è il ponte naturale verso lo scope allargato.',
];

const missione: string[] = [
  '<strong>Obiettivo minimo:</strong> uscire con le priorità di business di Giampaolo (booking? loyalty? MaaS? acquisizione cargo?) e una lettura chiara di cosa della foundation Salesforce è già live vs roadmap — cioè dove Adobe si innesta senza sovrapporsi.',
  '<strong>Obiettivo pieno:</strong> un working group su un caso concreto con KPI e data, la conferma del perimetro (se il ramo Merci/FS Logistix ricade sotto di lui) e il mandato ad estendere l\'use case Trenitalia+FS Park verso il B2B/merci e l\'analytics di filiera.',
  '<strong>Postura:</strong> ascoltare prima l\'architettura in piedi, proporre dopo. Giampaolo siede nel Management di FST come raccordo tra IT e business: ragiona per <em>capability riusabili su più società</em>, non per feature isolata. Ogni big idea va confezionata così.',
];

const comePensa = [
  '<strong>Come pensa:</strong> è il raccordo IT↔business di più società del Gruppo, quindi ragiona <em>per consolidamento di piattaforma e time-to-market</em>, non per punto-soluzione. Le big idea vanno presentate come capability di gruppo, non come tool.',
  '<strong>Come parlargli:</strong> architettura, governance del dato, riuso cross-società, valore misurabile. Il terreno CartaFRECCIA e customer care è quello delle società di trasporto che segue: parliamo la sua lingua.',
  '<strong>Cosa lo accende:</strong> superare la frammentazione delle applicazioni verticali con un layer unico di gruppo. È esattamente il frame della foundation FS×Salesforce che coordina — da usare a nostro favore, mostrando dove Adobe estende quel valore invece di rifarlo.',
];

const fatti = [
  {
    badge: 'verificato 3-0',
    t: '<strong>FSTechnology</strong> è la società hi-tech in-house del Gruppo FS (nata 31/07/2019) con missione "potenziare e supportare l\'innovazione digitale delle società del Gruppo". Giampaolo compare nel Management come Digital Business Partner Trasporto, accanto ai DBP Corporate (Cofini) e Infrastructure (Noto); Presidente Garri, AD Iacomussi.',
  },
  {
    badge: 'verificato 3-0',
    t: '<strong>Perimetro Trasporto (Piano 2025-2029, ~100 Mld€, AD Donnarumma):</strong> Gruppo in 5 Business Unit — 2 infrastruttura (RFI/Italferr; ANAS) + 3 trasporto: Passeggeri (capofila Trenitalia), Passeggeri Internazionale (FS International), Merci (FS Logistix).',
  },
  {
    badge: 'verificato 3-0',
    t: '<strong>FS Logistix</strong> (ex Mercitalia Logistics, rebrand 26/05/2025) è la sub-holding merci come "unico interlocutore per il cliente", ambizione European Freight Forwarder: coordina Mercitalia Rail (leader in Italia, ~38-39% quota), TX Logistik (pan-europeo, 100% dal gen 2017), Mercitalia Intermodal (150+ porti/terminal, ~500k UTI/anno), Terminali Italia.',
  },
  {
    badge: 'verificato 3-0',
    t: '<strong>Touchpoint cargo già attivi:</strong> la piattaforma FS Logistix (26/05/2025) col "Widget" one-click per le richieste di trasporto, gestione integrata ferro-gomma-mare con tracciabilità end-to-end; e la <strong>MIR APP</strong> di Mercitalia Rail (stato spedizioni in corso + programma 2 settimane, notifiche push). Sono lo strato portale-cargo/journey/tracking per i casi d\'uso merci Adobe.',
  },
  {
    badge: 'verificato 3-0',
    t: '<strong>Touchpoint passeggeri già attivo:</strong> <strong>CartaFRECCIA</strong> — programma loyalty gratuito (punti viaggiando su Frecce/Eurocity/Euronight + partner) con promozioni "su misura" previo consenso al trattamento dati. Motore loyalty + gate di consenso già presenti: materia prima per RTCDP + AJO + Target.',
  },
  {
    badge: 'competitivo · leggere prima',
    t: '<strong>Foundation FS × Salesforce (mar 2026):</strong> "foundation digitale agentica" coordinata da FSTechnology, su Salesforce Data Cloud + MuleSoft + AI generativa/agentica (incl. acquisto biglietti via AI-agent, rollout 2026), per unificare la CX di 840M+ passeggeri (Trenitalia, Busitalia, 100+ FS Park) e della logistica merci (FS Logistix, 50M+ ton/anno). Fonte FS + 8 testate indipendenti.',
  },
];

const dire = [
  'Parlare la sua lingua: capability di gruppo riusabili su più società, non feature isolate.',
  'Riconoscere l\'installato: "estendiamo il valore del dato già unificato", non "rifacciamo la CDP".',
  'CartaFRECCIA e il Widget di FS Logistix come punti di partenza reali, non slide teoriche.',
  'Multimodale (treno → bus → sosta FS Park) come un unico journey: è l\'ambizione già dichiarata dal Gruppo.',
  'Chiudere ogni big idea con una misura e una data; agganciare la proposta CJA FS Park già in casa.',
];

const nonDire = [
  'Nominare Salesforce o attaccarlo: mostrare capability e outcome, far emergere la complementarità.',
  'Proporre un rip-and-replace della CDP/CRM: la scelta è fatta da 6 mesi, un pitch greenfield cade.',
  'Usare "Mercitalia Logistics": il brand ombrello è oggi <strong>FS Logistix</strong> (Mercitalia Rail resta operativo).',
  'Presentare il blueprint travel/hospitality come "case ferroviario": è un blueprint adattato, va detto.',
];

const bigIdeasPax = [
  {
    tag: 'P0 · Passeggeri',
    nome: 'CartaFRECCIA che ti riconosce',
    societa: 'Trenitalia (+ estendibile Busitalia)',
    aggancio: 'CartaFRECCIA è già consent-based (punti + partner; promozioni su consenso). Motore loyalty e gate di consenso già presenti.',
    cosa: 'Audience per tier / saldo punti / propensione; home e offerte personalizzate per geo e comportamento; recupero prenotazione abbandonata; next-best-offer sui servizi ancillari (posto, lounge, ristorazione, FS Park).',
    adobe: 'RTCDP + AJO + Target (+ CJA per misurare)',
  },
  {
    tag: 'P0 · Passeggeri',
    nome: 'Un solo viaggio, molti mezzi (MaaS)',
    societa: 'Trenitalia + Busitalia + FS Park',
    aggancio: 'È esattamente l\'ambizione multimodale del Gruppo; FS Park (100+ location) è l\'ultimo miglio già in perimetro e già nel nostro use case.',
    cosa: 'Journey orchestrato che, comprato il Frecciarossa, propone il parcheggio FS Park a destinazione e il bus di adduzione, con comunicazioni contestuali in tempo reale (ritardo, cambio binario).',
    adobe: 'RTCDP + AJO + CJA — il ponte tra l\'use case esistente e lo scope allargato',
  },
];

const bigIdeasMerci = [
  {
    tag: 'P0 · Merci / B2B',
    nome: 'Portale cargo che converte',
    societa: 'FS Logistix (+ Mercitalia Rail / Intermodal / TX Logistik)',
    aggancio: 'Il "Widget" di richiesta trasporto e la gestione ferro-gomma-mare esistono già: portale B2B + journey account su cui innestare CDP B2B + AEM.',
    cosa: 'Profilazione account (settore, volumi, filiera), contenuti/quotazioni personalizzati sul portale, lead scoring e journey di acquisizione/retention dello spedizioniere. Qui l\'analytics diventa più specifica.',
    adobe: 'AEM Sites + RTCDP B2B + AJO + CJA',
  },
  {
    tag: 'P1 · Merci',
    nome: 'Dove è il mio carico',
    societa: 'Mercitalia Rail (MIR APP), Intermodal, TX Logistik',
    aggancio: 'La MIR APP mostra già stato spedizioni + programma 2 settimane con push: touchpoint di proactive care pronto per la journey orchestration.',
    cosa: 'Notifiche proattive event-driven (ETA, eccezioni, milestone di filiera), esperienza di tracking uniforme cross-vettore, analytics di filiera end-to-end.',
    adobe: 'AJO + CJA + AEP (profilo cliente B2B)',
  },
  {
    tag: 'P0 · Trasversale',
    nome: 'Analytics di filiera + attribuzione multimodale',
    societa: 'Tutto il perimetro',
    aggancio: 'Il "secondo parere" analitico accanto a Data Cloud, dove Adobe è forte e poco contestato. Aggancio diretto alla proposta CJA FS Park già in casa.',
    cosa: 'Un layer CJA che unisce misura del journey passeggeri (fisico + digitale) e KPI di filiera merci.',
    adobe: 'Customer Journey Analytics',
  },
];

const perimetroPax = [
  { soc: 'Trenitalia', modello: 'Passeggeri nazionale (AV Frecce, Intercity, Regionale)', touch: 'Sito/App, CartaFRECCIA, e-commerce biglietti, Trenitalia SmartBI' },
  { soc: 'Trenitalia Tper', modello: 'JV regionale Emilia-Romagna', touch: 'Canali regionali, abbonamenti' },
  { soc: 'Busitalia', modello: 'TPL e trasporto su gomma passeggeri', touch: 'App/canali TPL locali, titoli di viaggio' },
  { soc: 'FS Park', modello: 'Sosta / parcheggi (100+ location)', touch: 'App parcheggi, prenotazione sosta, integrazione col viaggio' },
];

const perimetroMerci = [
  { soc: 'Mercitalia Rail', modello: 'Merci su ferro — leader in Italia (~38-39%)', touch: 'MIR APP: stato spedizioni + programma 2 settimane, push' },
  { soc: 'TX Logistik', modello: 'Operatore ferroviario merci pan-europeo (100% dal 2017)', touch: 'Portali/tracking di rete, pilot smart freight wagon' },
  { soc: 'Mercitalia Intermodal', modello: 'Combinato non accompagnato — 150+ porti/terminal', touch: 'Booking intermodale, tracking unità di carico' },
  { soc: 'Terminali Italia', modello: 'Gestione terminal intermodali', touch: 'Sistemi terminalistici' },
];

const priorita = [
  { idea: '#1 CartaFRECCIA personalization', impatto: 'Alto', overlap: 'Media', riuso: 'Alto', p: 'P0' },
  { idea: '#2 Multimodale (Trenitalia+FS Park+Busitalia)', impatto: 'Alto', overlap: 'Media', riuso: 'Alto', p: 'P0' },
  { idea: '#3 Portale cargo FS Logistix', impatto: 'Alto', overlap: 'Bassa-Media', riuso: 'Medio', p: 'P0' },
  { idea: '#4 Tracking / care MIR APP', impatto: 'Medio', overlap: 'Bassa', riuso: 'Basso', p: 'P1' },
  { idea: '#5 CJA filiera + attribuzione', impatto: 'Medio-Alto', overlap: 'Bassa', riuso: 'Alto', p: 'P0' },
];

const domande = [
  '<strong>Perimetro reale:</strong> il tuo mandato DBP Trasporto copre anche Merci/FS Logistix, o è un presidio distinto? (decide a chi indirizzare le big idea cargo).',
  '<strong>Architettura in piedi:</strong> stato di adozione della foundation Salesforce Data Cloud/MuleSoft — cosa è già live vs roadmap → dove Adobe si innesta senza sovrapporsi.',
  '<strong>Priorità business 2026-27:</strong> conversione booking? loyalty? MaaS? acquisizione clienti cargo?',
  '<strong>Analytics gap:</strong> cosa oggi non riuscite a misurare sul journey (fisico↔digitale, multimodale, filiera merci) → gancio per CJA.',
];

const caveat = [
  '<strong>Naming:</strong> usare FS Logistix (non "Mercitalia Logistics"); Mercitalia Rail resta brand operativo.',
  '<strong>Fit Adobe = blueprint travel/hospitality</strong> (Experience League, apr 2026), non case ferroviario: transfer ragionevole ma analogico; CJA/AEM non nel blueprint citato.',
  '<strong>Time-sensitivity Salesforce:</strong> annuncio ~mar 2026, in rollout attivo → tarare il pitch su un incumbent già scelto.',
];

const biblioteca = [
  { label: 'FSTechnology — Organi sociali e Management (ruolo DBP Trasporto)', url: 'https://www.fstechnology.it/it/chi-siamo/organi-sociali-e-management.html', tipo: 'primaria' },
  { label: 'FS Italiane — «Nasce FS Technology» (31 lug 2019)', url: 'https://www.fsitaliane.it/content/fsitaliane/it/media/comunicati-stampa/2019/7/31/nasce-fs-technology-la-societa-hi-tech-del-gruppo-fs-italiane.html', tipo: 'primaria' },
  { label: 'FS Italiane — Società del Gruppo / Piano 2025-2029 (5 BU, 3 trasporto)', url: 'https://www.fsitaliane.it/it/il-gruppo-fs/societa-del-gruppo.html', tipo: 'primaria' },
  { label: 'FS Logistix — «Nasce FS Logistix» 26/05/2025 (Widget, ferro-gomma-mare)', url: 'https://www.fslogistix.com/it/media/nasce-fs-logistix--parte-la-rivoluzione-digitale-della-logistica.html', tipo: 'primaria' },
  { label: 'FS Logistix — Mercitalia Rail (perimetro, quote di mercato)', url: 'https://www.fslogistix.com/en/about-us/our-companies/mercitalia-rail.html', tipo: 'primaria' },
  { label: 'TX Logistik — pilot smart freight wagon con Mercitalia Intermodal', url: 'https://www.txlogistik.eu/en/press-releases/tx-logistik-and-mercitalia-intermodal-launch-pilot-test-for-smart-freight-wagon-in-combined-transport/', tipo: 'primaria' },
  { label: 'Mercitalia Rail — MIR APP (tracking spedizioni)', url: 'https://www.ferrovie.it/portale/articoli/6886', tipo: 'stampa' },
  { label: 'Trenitalia — CartaFRECCIA «Il Programma» (loyalty consent-based)', url: 'https://www.trenitalia.com/it/cartafreccia/il-programma.html', tipo: 'primaria' },
  { label: 'FSNews — foundation Gruppo FS × Salesforce (5 mar 2026)', url: 'https://www.fsnews.it/it/focus-on/innovazione/2026/3/5/fs-technology-salesforce-foundation-digitale.html', tipo: 'stampa' },
  { label: 'Adobe Experience League — Travel & Hospitality blueprint (RTCDP/AJO)', url: 'https://experienceleague.adobe.com/en/docs/blueprints-learn/architecture/industry-use-cases/travel-hospitality-overview', tipo: 'primaria' },
];
---
<BaseLayout
  title="Dossier — FSTechnology · Adobe Day"
  description="Adobe internal — dossier di preparazione riservato."
  noindex={true}
>
  <div class="dw-shell">
    <header class="dw-header">
      <div class="dw-header-inner">
        <div class="dw-header-left">
          <span class="dw-badge">Adobe internal · Riservato</span>
          <h1 class="dw-title">War Room — FSTechnology · Adobe Day</h1>
        </div>
        <div class="dw-header-right">
          <a class="dw-deck-link" href={href(base, '/')}>Apri l'esperienza →</a>
        </div>
      </div>
      <p class="dw-disclaimer">
        Documento di lavoro per il team Adobe. Fonti pubbliche citate; nessun dato contrattuale o
        economico. Referente cliente: Maurizio Giampaolo (Digital Business Partner Trasporto, FSTechnology).
        Incontro previsto entro fine settembre 2026. Da non far circolare fuori da Adobe.
      </p>
    </header>

    <main class="dw-main">

      <!-- 01 · Executive summary -->
      <section class="dw-section" aria-labelledby="dw-h-summary">
        <h2 class="dw-h" id="dw-h-summary"><span class="dw-h-num">01</span>Executive summary</h2>
        <ul class="dw-list">
          {summary.map((s) => <li class="dw-li" set:html={s} />)}
        </ul>
      </section>

      <!-- 02 · Mission brief -->
      <section class="dw-section" aria-labelledby="dw-h-missione">
        <h2 class="dw-h" id="dw-h-missione"><span class="dw-h-num">02</span>Mission brief</h2>
        <ul class="dw-list">
          {missione.map((o) => <li class="dw-li" set:html={o} />)}
        </ul>
      </section>

      <!-- 03 · Chi è Maurizio Giampaolo -->
      <section class="dw-section" aria-labelledby="dw-h-persona">
        <h2 class="dw-h" id="dw-h-persona"><span class="dw-h-num">03</span>Chi è Maurizio Giampaolo</h2>
        <ul class="dw-list">
          {comePensa.map((c) => <li class="dw-li" set:html={c} />)}
        </ul>
      </section>

      <!-- 04 · Il perimetro societario -->
      <section class="dw-section" aria-labelledby="dw-h-perimetro">
        <h2 class="dw-h" id="dw-h-perimetro"><span class="dw-h-num">04</span>Il perimetro che segue</h2>
        <h3 class="dw-sub">A · Trasporto Passeggeri — capofila Trenitalia</h3>
        <div class="dw-grid">
          {perimetroPax.map((r) => (
            <div class="dw-card">
              <p class="dw-card-name">{r.soc}</p>
              <p class="dw-card-model">{r.modello}</p>
              <p class="dw-card-touch"><span class="dw-touch-label">Touchpoint</span> {r.touch}</p>
            </div>
          ))}
        </div>
        <h3 class="dw-sub">C · Trasporto Merci / Logistica — capofila FS Logistix</h3>
        <div class="dw-grid">
          {perimetroMerci.map((r) => (
            <div class="dw-card">
              <p class="dw-card-name">{r.soc}</p>
              <p class="dw-card-model">{r.modello}</p>
              <p class="dw-card-touch"><span class="dw-touch-label">Touchpoint</span> {r.touch}</p>
            </div>
          ))}
        </div>
        <p class="dw-note">La BU <strong>Passeggeri Internazionale</strong> (FS International: Netinera, Trenitalia c2c, ecc.) potrebbe far capo a un presidio distinto — da confermare. La lista esatta società→DBP non è documentata da fonte primaria.</p>
      </section>

      <!-- 05 · I fatti verificati -->
      <section class="dw-section" aria-labelledby="dw-h-fatti">
        <h2 class="dw-h" id="dw-h-fatti"><span class="dw-h-num">05</span>I fatti verificati</h2>
        <p class="dw-note">Ogni affermazione ha superato una verifica avversariale a 3 voti su fonti primarie (deep-research, 8 set 2026). Rinfrescare le fonti prima dell'incontro.</p>
        <ul class="dw-list">
          {fatti.map((f) => (
            <li class="dw-li">
              <span class={`dw-chip ${f.badge.startsWith('competitivo') ? 'dw-chip--warn' : ''}`}>{f.badge}</span>
              <span set:html={f.t} />
            </li>
          ))}
        </ul>
      </section>

      <!-- 06 · Le big idea -->
      <section class="dw-section" aria-labelledby="dw-h-idee">
        <h2 class="dw-h" id="dw-h-idee"><span class="dw-h-num">06</span>Le big idea da proporre</h2>
        <h3 class="dw-sub">Passeggeri</h3>
        <div class="dw-ideas">
          {bigIdeasPax.map((b) => (
            <article class="dw-idea">
              <span class="dw-chip">{b.tag}</span>
              <h4 class="dw-idea-name">{b.nome}</h4>
              <p class="dw-idea-soc">{b.societa}</p>
              <p class="dw-idea-line"><span class="dw-idea-k">Aggancio reale</span> {b.aggancio}</p>
              <p class="dw-idea-line"><span class="dw-idea-k">Cosa mostriamo</span> {b.cosa}</p>
              <p class="dw-idea-adobe">{b.adobe}</p>
            </article>
          ))}
        </div>
        <h3 class="dw-sub">Merci / B2B — l'ampliamento di orizzonte</h3>
        <div class="dw-ideas">
          {bigIdeasMerci.map((b) => (
            <article class="dw-idea">
              <span class="dw-chip">{b.tag}</span>
              <h4 class="dw-idea-name">{b.nome}</h4>
              <p class="dw-idea-soc">{b.societa}</p>
              <p class="dw-idea-line"><span class="dw-idea-k">Aggancio reale</span> {b.aggancio}</p>
              <p class="dw-idea-line"><span class="dw-idea-k">Cosa mostriamo</span> {b.cosa}</p>
              <p class="dw-idea-adobe">{b.adobe}</p>
            </article>
          ))}
        </div>
      </section>

      <!-- 07 · Matrice di priorità -->
      <section class="dw-section" aria-labelledby="dw-h-matrice">
        <h2 class="dw-h" id="dw-h-matrice"><span class="dw-h-num">07</span>Matrice di priorità</h2>
        <div class="dw-table" role="table" aria-label="Matrice di priorità delle big idea">
          <div class="dw-tr dw-tr--head" role="row">
            <span role="columnheader">Big idea</span>
            <span role="columnheader">Impatto demo</span>
            <span role="columnheader">Overlap Salesforce</span>
            <span role="columnheader">Riuso asset</span>
            <span role="columnheader">Priorità</span>
          </div>
          {priorita.map((r) => (
            <div class="dw-tr" role="row">
              <span role="cell" class="dw-td-idea">{r.idea}</span>
              <span role="cell">{r.impatto}</span>
              <span role="cell">{r.overlap}</span>
              <span role="cell">{r.riuso}</span>
              <span role="cell"><span class={`dw-p dw-p--${r.p.toLowerCase()}`}>{r.p}</span></span>
            </div>
          ))}
        </div>
      </section>

      <!-- 08 · Da dire / da non dire -->
      <section class="dw-section" aria-labelledby="dw-h-dire">
        <h2 class="dw-h" id="dw-h-dire"><span class="dw-h-num">08</span>Da dire / da non dire</h2>
        <div class="dw-cols">
          <div class="dw-col dw-col--ok">
            <h3 class="dw-col-h">✓ Da dire</h3>
            <ul class="dw-list">
              {dire.map((d) => <li class="dw-li dw-li--tight" set:html={d} />)}
            </ul>
          </div>
          <div class="dw-col dw-col--no">
            <h3 class="dw-col-h">✗ Da non dire</h3>
            <ul class="dw-list">
              {nonDire.map((d) => <li class="dw-li dw-li--tight" set:html={d} />)}
            </ul>
          </div>
        </div>
      </section>

      <!-- 09 · Domande da fare + caveat -->
      <section class="dw-section" aria-labelledby="dw-h-domande">
        <h2 class="dw-h" id="dw-h-domande"><span class="dw-h-num">09</span>Cosa chiedere · Caveat</h2>
        <h3 class="dw-sub">Domande per de-rischiare</h3>
        <ul class="dw-list">
          {domande.map((d) => <li class="dw-li" set:html={d} />)}
        </ul>
        <h3 class="dw-sub">Caveat &amp; onestà intellettuale</h3>
        <ul class="dw-list">
          {caveat.map((c) => <li class="dw-li dw-li--tight" set:html={c} />)}
