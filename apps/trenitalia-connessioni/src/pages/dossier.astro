---
import DocLayout from '../layouts/DocLayout.astro';
import DossierPage from '@edf/core/blocks/doc/DossierPage.astro';

// ── Pagina RISERVATA (Adobe internal) ──────────────────────────────────────
// Dossier di preparazione per l'Adobe Day con FSTechnology, la società ICT
// in-house del Gruppo FS.
//
// Fino al 9 ottobre 2026 questa pagina aveva il renderer copiato dentro l'app
// e il contenuto scritto qui dentro: compilato nel bundle statico e quindi
// PUBBLICATO. Chi apriva l'URL leggeva tutto senza password — il badge
// «Adobe internal · Riservato» era una scritta, non un lucchetto, e `noindex`
// tiene fuori i motori di ricerca, non chi ha il link. Il contenuto adesso
// vive in Supabase (tabella restricted_docs, RLS) e si carica solo
//   1) dopo login (super admin o utente con accesso a trenitalia-connessioni), o
//   2) via secret-link ?t=<uuid> (RPC get_shared_doc di 0009, senza login).
// L'URL non è cambiato. Seed (git-ignorato):
// docs/Ferrovie/0027_seed_trenitalia_fstechnology_dossier.sql.
//
// Perché due pagine di dossier in questa app: questa prepara il tavolo con la
// società ICT del Gruppo, `dossier-sales.astro` quello con la Direzione Sales
// di Trenitalia. Stanze diverse, interlocutori diversi, vincoli diversi: non
// si mescolano in un unico documento. Condividono l'experience nel registry,
// non il contenuto.
//
// Il rendering è del motore condiviso `@edf/core/blocks/doc/DossierPage.astro`:
// qui restano solo lo slug e il guscio. La palette sta nel DocLayout.
---
<DocLayout
  title="Dossier — FSTechnology · Adobe Day"
  description="Adobe internal — dossier di preparazione riservato (accesso ristretto)."
  noindex={true}
>
  <DossierPage
    docSlug="trenitalia-fstechnology"
    title="Dossier — FSTechnology · Adobe Day"
    base={import.meta.env.BASE_URL}
    supabaseUrl={import.meta.env.PUBLIC_SUPABASE_URL ?? ''}
    supabaseAnon={import.meta.env.PUBLIC_SUPABASE_ANON_KEY ?? ''}
    deckHref="/experience-design-factory/trenitalia-connessioni/"
    deckLabel="Apri l'esperienza ↗"
  />
</DocLayout>
