---
/**
 * Appendice — Per il team tecnico: dati, ruoli, licenze e sicurezza.
 *
 * NASCE IL 27 NOV 2026, dalla critica di design sul deck intero. Su cinquanta slide
 * una trentina parlavano a FS Technology, al DPO e a chi amministra i due Analytics,
 * e stavano nello stesso percorso di chi dirige i canali digitali: per arrivare ai
 * casi bisognava attraversarle. Ora stanno qui, in coda, e si aprono quando in sala
 * arriva la domanda. Nessuna è stata riscritta nel merito: sono le slide nate dai
 * due giri di panel del 26 nov, spostate.
 *
 * Che cosa c'è, nell'ordine in cui di solito arrivano le domande:
 *   · chi decide e chi lavora, fase per fase;
 *   · che cosa vedono il DPO e FS Technology già nella fase 0;
 *   · la rimappatura dei campi, con quelli letti nei tag dei due siti;
 *   · come arriva un gruppo di visitatori a Target, dalla fase 1;
 *   · il CRM, con il login;
 *   · il percorso del dato negli altri quattro casi;
 *   · il traffico dagli assistenti e il riferimento ferroviario (decisione
 *     dell'owner: restano nel deck, fuori dal percorso principale).
 */
import { lega } from '../../utils/lega';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Sfondo from '../../components/Sfondo.astro';
import TreniNavigation from '../../components/TreniNavigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import CoverHero from '@edf/core/blocks/CoverHero.astro';
import FiguraCampi from '../../components/figure/FiguraCampi.astro';
import DiagAssistenti from '../../components/diagrammi/DiagAssistenti.astro';
import FlussoCaso from '../../components/casi/FlussoCaso.astro';
import { href } from '@edf/core/utils/url.js';
import { rotte } from '../../data/percorso';
import { PRIMA, CAMPI } from '../../data/vista-unica';
import { CASI, RIFERIMENTO, FONTI_CAPITOLO } from '../../data/casi-duso';

const base = import.meta.env.BASE_URL;
const { next, prev } = rotte('trenitalia/appendice');
const currentPath = Astro.url.pathname;
const h2 = 'font-size: clamp(1.7rem, 2.7vw, 2.4rem); font-weight: 600; line-height: 1.06; letter-spacing: -0.02em;';

/* Per il DPO e la sicurezza IT: solo ciò che le pagine pubbliche di Adobe dicono,
   lette il 27 nov 2026. La regione specifica non la dà il Trust Center: si sceglie
   all'attivazione, e per questo in slide è una scelta e non un valore. */
const dati = [
  { k: 'La regione', v: 'Si sceglie all’attivazione, fra le sedi europee di Experience Platform, e i dati non si spostano dopo.',
    fonte: 'Sedi di Customer Journey Analytics', url: 'https://experienceleague.adobe.com/en/docs/analytics-platform/using/technotes/data-centers' },
  { k: 'La cifratura', v: 'In transito con TLS 1.2; a riposo, in un archivio isolato per organizzazione.',
    fonte: 'Cifratura in Experience Platform', url: 'https://experienceleague.adobe.com/en/docs/experience-platform/landing/governance-privacy-security/encryption' },
  { k: 'La conservazione', v: 'In Customer Journey Analytics, una finestra in mesi sulla connessione; nel data lake, una scadenza sul dataset, da fissare con il DPO. Le richieste degli interessati passano dal servizio privacy di Adobe.',
    fonte: 'Privacy in Customer Journey Analytics', url: 'https://experienceleague.adobe.com/en/docs/analytics-platform/using/cja-privacy/privacy-overview' },
  { k: 'I ruoli', v: 'Il cliente è titolare, Adobe responsabile del trattamento. A fine contratto i dati si cancellano o si restituiscono, a scelta del cliente.',
    fonte: 'Accordo sul trattamento dei dati', url: 'https://www.adobe.com/content/dam/cc/en/legal/terms/enterprise/pdfs/DPA-WW.pdf' },
  { k: 'I fornitori', v: 'L’elenco dei sub-responsabili è pubblico, con un preavviso per ogni nuovo ingresso.',
    fonte: 'Sub-responsabili di Adobe', url: 'https://www.adobe.com/privacy/sub-processors.html' },
];

const SFONDI: Record<string, string> = { interesse: 'rl-binari', oro: 'tc-quiete', upgrade: 'tc-acciaio', app: 'rl-pensilina' };
const altriCasi = CASI.slice(1);

const governo = [
  { f: '0', entra: 'le righe di visita dei due Analytics, con identificativi pseudonimi',
    decide: 'FS Technology e chi amministra Le Frecce; il DPO dà il parere',
    fa: 'Adobe: mappatura e rimappatura; FS Technology: accessi e sicurezza; chi gestisce gli Analytics di Le Frecce (IBM, da confermare)' },
  { f: '1', entra: 'un identificativo in più nel passaggio a Le Frecce, e la conferma per visitatore',
    decide: 'chi possiede la piattaforma di vendita, per il campo; il DPO; FS Technology',
    fa: 'il partner sulla libreria, il vostro team sul tag della conferma' },
  { f: '2', entra: 'il login su trenitalia.com, con lo username come chiave (un’ipotesi), e un attributo dal CRM',
    decide: 'il Gruppo, su login e portale; il DPO, per il CRM; marketing e revenue management, per offerte e status',
    fa: 'chi sviluppa i portali; Adobe sul profilo in CJA' },
];

const catena = [
  { k: 'Adobe Analytics', v: 'raccoglie come oggi, su trenitalia.com' },
  { k: 'Il connettore', v: 'porta le visite e l’acquisto; lo status, con il login, da un’estrazione del CRM', nuovo: true },
  { k: 'Customer Journey Analytics', v: 'legge il viaggio e costruisce il pubblico', nuovo: true },
  { k: 'La destinazione Target', v: 'passa il pubblico a Target; serve Real-Time CDP, nella stessa organizzazione di Target', nuovo: true },
  { k: 'Adobe Target', v: 'su trenitalia.com, dalle visite successive' },
];

const catenaNote = [
  { k: 'Ogni quanto si aggiorna', v: 'Si ricalcola al massimo ogni 4 ore, e fra la visita e l’arrivo in Target passano altre ore. Se il pubblico non arriva, resta la home di oggi.' },
  { k: 'Le Frecce, dopo', v: 'L’acquisto entra con la conferma, nella fase 1; lo status del cliente con il login, nella fase 2.' },
  { k: 'Come si spegne', v: 'Un interruttore per attività in Target; at.js nasconde la parte che cambia fino alla variante, con una soglia in millisecondi da fissare con il vostro team.' },
];

const crm = [
  { k: 'Prima, un file', v: 'Un attributo per cliente, come lo status del programma fedeltà, che dal 2027 sta in Salesforce, o un livello di valore, con un’estrazione periodica. Nessun dato anagrafico.' },
  { k: 'Poi, dal vostro gateway', v: 'A regime il dato parte dallo strato di integrazione del Gruppo verso Adobe, in uscita. Il come si studia con la sicurezza IT.' },
  { k: 'Per tutte e due', v: 'Il parere del DPO e della sicurezza IT, anche per un solo attributo. Il connettore diretto passa da internet: lo valutiamo con la sicurezza IT.' },
];

---
<BaseLayout title="Per il team tecnico" branch="trenitalia" pageSolutions={['cja']}
  description="Appendice per FS Technology, il DPO e chi amministra i due Analytics: chi decide e chi lavora, che cosa entra, come arriva un gruppo a Target, il CRM.">
  <div class="fixed top-0 left-0 right-0 z-50">
    <TreniNavigation currentPath={currentPath} base={base} branch="trenitalia" />
  </div>

  <DeckContainer nextHref={href(base, next)} prevHref={href(base, prev)}>

    <!-- ── Copertina ──────────────────────────────────────────────────── -->
    <Slide id="slide-cover" bg="primary" align="center" data-solution="cja">
      <div slot="backdrop" class="absolute inset-0">
        <Sfondo id="tc-acciaio" forza="media" />
        <div class="fs-grid"></div>
      </div>
      <CoverHero
        eyebrow="Appendice · Per il team tecnico"
        numeral="A"
        title="Dati, ruoli, licenze e sicurezza"
        lead={lega('Quello che serve a FS Technology, al DPO e a chi amministra i due Analytics, fase per fase.')}
        size="phase"
        signature={false}
      />
    </Slide>

    <!-- ── Chi decide, chi firma, chi fa ────────────────────────────────── -->
    <Slide id="slide-governo" bg="primary" align="center" data-solution="cja">
      <div slot="backdrop" class="absolute inset-0">
        <div class="fs-bg"></div>
        <div class="fs-grid"></div>
      </div>
      <Sfondo slot="backdrop" id="tc-acciaio" forza="forte" />
      <p class="fs-panel-tag text-center mb-3" data-reveal>CHI DECIDE, CHI FA</p>
      <h2
        class="text-center text-[var(--ink-primary)] mb-6 font-[family-name:var(--font-display)]"
        style="font-size: clamp(1.7rem, 2.7vw, 2.4rem); font-weight: 600; line-height: 1.06; letter-spacing: -0.02em;"
        data-reveal data-reveal-delay="0.08"
      >
        Chi decide e chi lavora, fase per&nbsp;fase.
      </h2>
      <div class="cv-gov" role="table" aria-label="Chi decide e chi fa, fase per fase" data-reveal data-reveal-delay="0.16">
        <div class="cv-gov-r cv-gov-t" role="row">
          <span role="columnheader">Fase</span><span role="columnheader">Che cosa entra</span><span role="columnheader">Chi decide</span><span role="columnheader">Chi fa</span>
        </div>
        {governo.map((g) => (
          <div class="cv-gov-r" role="row">
            <span role="cell" class="cv-gov-f">{g.f}</span>
            <span role="cell">{lega(g.entra)}</span>
            <span role="cell">{lega(g.decide)}</span>
            <span role="cell">{lega(g.fa)}</span>
          </div>
        ))}
      </div>
      <p class="fs-panel-src text-center mt-5" data-reveal data-reveal-delay="0.3">
        {lega('Committente: la direzione dei canali digitali. Verifiche tecniche e budget: FS Technology. L’ordine segue il percorso d’acquisto del Gruppo, da confermare. Titolarità del dato e accordi fra le due organizzazioni: da chiedere al DPO.')}
      </p>
    </Slide>

    <!-- ── Che cosa vedono il DPO e FS Technology ─────────────────────── -->
    {/* Dal panel del 26 nov 2026: il DPO vede già la fase 0, perché il connettore
        porta righe di visita con identificativi pseudonimi. */}
    <Slide id="slide-prima" bg="secondary" align="center" data-solution="cja">
      <div slot="backdrop" class="absolute inset-0"><div class="fs-bg-soft"></div><div class="fs-grid"></div></div>
      <Sfondo slot="backdrop" id="tc-quiete" forza="forte" />
      <p class="fs-panel-tag text-center mb-3" data-reveal>LA FASE 0 · LE CONDIZIONI</p>
      <h2 class="text-center text-[var(--ink-primary)] mb-6 font-[family-name:var(--font-display)]" style={h2} data-reveal data-reveal-delay="0.08">
        Il DPO e FS Technology entrano già nella fase&nbsp;0.
      </h2>
      <div class="vu-prima" data-stagger>
        {PRIMA.slice(0, 2).map((c) => (
          <div class="vu-pr">
            <p class="vu-pr-k">{c.k}</p>
            <ul>{c.v.map((x) => <li>{lega(x)}</li>)}</ul>
          </div>
        ))}
      </div>
      <p class="fs-panel-src text-center mt-5" data-reveal data-reveal-delay="0.3">
        {lega('Le righe di visita entrano con identificativi pseudonimi: è un trattamento, e per questo il parere del DPO serve subito.')}
        La mappatura fra organizzazioni si chiede tramite Adobe, con l’approvazione scritta degli amministratori di ciascuna ·
        <a href="https://experienceleague.adobe.com/en/docs/analytics-platform/using/compare-aa-cja/cja-aa-comparison/mapping-data-ims-orgs" target="_blank" rel="noopener noreferrer">Experience League</a>. Il connettore copia nel data lake fino a 13&nbsp;mesi di storico; in Customer Journey Analytics se ne leggono tre, con una finestra mobile. Quanto resta nel data lake si fissa con una scadenza sul dataset, da decidere con il&nbsp;DPO · <a href="https://experienceleague.adobe.com/en/docs/experience-platform/sources/connectors/adobe-applications/analytics" target="_blank" rel="noopener noreferrer">il connettore Analytics</a>.
      </p>
    </Slide>

    <!-- ── Dove stanno i dati, e come si cancellano ───────────────────── -->
    {/* Chiesta dal panel del 27 nov 2026: il via libera sui dati non aveva oggetto.
        Qui stanno solo i fatti letti nelle pagine pubbliche di Adobe quel giorno,
        ognuno con il suo link. Quello che le pagine non dicono resta domanda. */}
    <Slide id="slide-dati" bg="primary" align="center" data-solution="cja">
      <div slot="backdrop" class="absolute inset-0"><div class="fs-bg"></div><div class="fs-grid"></div></div>
      <Sfondo slot="backdrop" id="tc-acciaio" forza="forte" />
      <p class="fs-panel-tag text-center mb-3" data-reveal>PER IL DPO E LA SICUREZZA IT</p>
      <h2 class="text-center text-[var(--ink-primary)] mb-6 font-[family-name:var(--font-display)]" style={h2} data-reveal data-reveal-delay="0.08">
        Dove stanno i dati, e come si&nbsp;cancellano.
      </h2>
      <dl class="ap-dati" data-stagger>
        {dati.map((d) => (
          <div>
            <dt>{d.k}</dt>
            <dd>{lega(d.v)} <a href={d.url} target="_blank" rel="noopener noreferrer">{d.fonte}</a></dd>
          </div>
        ))}
      </dl>
      <p class="fs-panel-src text-center mt-5" data-reveal data-reveal-delay="0.3">
        {lega('Pagine pubbliche di Adobe, lette il 27 novembre 2026. Restano da definire insieme: i campi che entrano e quelli esclusi, chi ha accesso, la durata della conservazione.')}
      </p>
    </Slide>

    <!-- ── La rimappatura, in concreto ────────────────────────────────── -->
    <Slide id="slide-campi" bg="secondary" align="center" data-solution="cja">
      <div slot="backdrop" class="absolute inset-0"><div class="fs-bg-soft"></div><div class="fs-grid"></div></div>
      <Sfondo slot="backdrop" id="rl-pensilina" forza="forte" />
      <p class="fs-panel-tag text-center mb-3" data-reveal>LA RIMAPPATURA, IN CONCRETO</p>
      <h2 class="text-center text-[var(--ink-primary)] mb-4 font-[family-name:var(--font-display)]" style={h2} data-reveal data-reveal-delay="0.08">
        La stessa tratta è scritta due volte, con nomi&nbsp;diversi.
      </h2>
      <p class="vu-lead text-center fs-card-body max-w-3xl mx-auto mb-6" data-reveal data-reveal-delay="0.14">
        L’abbiamo vista nei vostri tag, cercando Roma Termini – Milano Centrale dalla home di&nbsp;trenitalia.com.
      </p>
      <div class="w-full" data-reveal data-reveal-delay="0.2">
        <FiguraCampi sinistra={CAMPI.tcom} destra={CAMPI.frecce} derivato={CAMPI.derivato} attenzione={CAMPI.attenzione} />
      </div>
    </Slide>

    <!-- ── Come arriva un pubblico a Target ─────────────────────────────── -->
    {/* Chiesta dal panel del 22 nov 2026: «Target lo riceve» taceva il come. Il
        passaggio usa la destinazione Adobe Target di Experience Platform, che si
        abilita nella proposta: al cliente non si propone una piattaforma da gestire.
        La latenza e la residenza dei dati si dicono «da confermare» finché non lo sono. */}
    <Slide id="slide-catena" bg="primary" align="center" data-solution="cja">
      <div slot="backdrop" class="absolute inset-0">
        <div class="fs-bg"></div>
        <div class="fs-grid"></div>
      </div>
      <Sfondo slot="backdrop" id="tc-acciaio" forza="forte" />
      <p class="fs-panel-tag text-center mb-3" data-reveal>DALLA FASE 1 · COME ARRIVA UN PUBBLICO A TARGET</p>
      <h2
        class="text-center text-[var(--ink-primary)] mb-5 font-[family-name:var(--font-display)]"
        style="font-size: clamp(1.7rem, 2.7vw, 2.4rem); font-weight: 600; line-height: 1.06; letter-spacing: -0.02em;"
        data-reveal data-reveal-delay="0.08"
      >
        Dalla fase 1 i gruppi di visitatori arrivano a Target da Experience&nbsp;Platform.
      </h2>
      <p class="text-center fs-card-body max-w-3xl mx-auto mb-7" style="text-wrap: balance;" data-reveal data-reveal-delay="0.14">
        Nella fase 0 non passa nessun pubblico; dalla fase 1, passa&nbsp;così.
      </p>
      <ol class="cv-catena" data-reveal data-reveal-delay="0.2">
        {catena.map((c, i) => (
          <li class:list={['cv-anello', c.nuovo && 'cv-anello--nuovo']} data-substep={i > 0 ? '' : undefined}>
            <span class="cv-anello-k">{c.k}</span>
            <span class="cv-anello-v">{lega(c.v)}</span>
          </li>
        ))}
      </ol>
      <div class="w-full max-w-6xl mx-auto grid md:grid-cols-3 gap-5 mt-7" data-stagger>
        {catenaNote.map((c) => (
          <div class="fs-card text-left h-full">
            <p class="fs-card-title mb-2" style="font-size: 1.05rem;">{c.k}</p>
            <p class="fs-card-body">{lega(c.v)}</p>
          </div>
        ))}
      </div>
    </Slide>

    <!-- ── Con il CRM ─────────────────────────────────────────────────── -->
    {/* Fino alla sera del 23 nov stava nel primo passo. Verificato in Chromium: su
        trenitalia.com non si fa login, quindi lo status si lega sulla conferma
        d'acquisto, ed entra con il secondo passo. Dal 26 nov 2026 sta nella fase 2:
        senza il login nessun dato del CRM si lega a una visita (decisione dell'owner). */}
    <Slide id="slide-dove-sta-il-dato" bg="primary" align="center" data-solution="cja">
      <div slot="backdrop" class="absolute inset-0">
        <div class="fs-bg"></div>
        <div class="fs-grid"></div>
      </div>
      <Sfondo slot="backdrop" id="rl-quiete" forza="media" />
      <p class="fs-panel-tag text-center mb-3" data-reveal>LA FASE 2 · IL CRM, CON IL LOGIN</p>
      <h2
        class="text-center text-[var(--ink-primary)] mb-5 font-[family-name:var(--font-display)]"
        style="font-size: clamp(1.7rem, 2.7vw, 2.4rem); font-weight: 600; line-height: 1.06; letter-spacing: -0.02em;"
        data-reveal data-reveal-delay="0.08"
      >
        Il CRM resta in Salesforce; entra un attributo, non il&nbsp;profilo.
      </h2>
      <p class="text-center fs-card-body max-w-3xl mx-auto mb-7" data-reveal data-reveal-delay="0.14">
        Oggi su trenitalia.com non si fa login, e senza una chiave nessun dato del&nbsp;CRM si lega a una visita. Il login è la condizione della fase&nbsp;2.
      </p>
      <div class="w-full max-w-6xl mx-auto grid md:grid-cols-3 gap-5" data-stagger>
        {crm.map((c, i) => (
          <div class:list={['fs-card text-left h-full', i === 2 && 'ap-card--nota']}>
            <p class="fs-card-title mb-2" style="font-size: 1.1rem;">{c.k}</p>
            <p class="fs-card-body">{lega(c.v)}</p>
          </div>
        ))}
      </div>
    </Slide>

    <!-- ── Il percorso del dato, negli altri quattro casi ─────────────── -->
    {altriCasi.map((c, i) => (
      <Slide id={`slide-dietro-${c.id}`} bg={i % 2 === 0 ? 'secondary' : 'primary'} align="center">
        <div slot="backdrop" class="absolute inset-0">
          <div class="fs-bg-soft"></div>
          <div class="fs-grid"></div>
        </div>
        <Sfondo slot="backdrop" id={SFONDI[c.id]} forza="forte" />
        <p class="fs-panel-tag text-center mb-3" data-reveal>
          CASO {String(i + 2).padStart(2, '0')} · IL PERCORSO DEL DATO
        </p>
        <h2 class="text-center text-[var(--ink-primary)] mb-5 font-[family-name:var(--font-display)]"
          style="font-size: clamp(1.6rem, 2.5vw, 2.2rem); font-weight: 600; line-height: 1.08; letter-spacing: -0.02em;"
          data-reveal data-reveal-delay="0.08">
          {c.titolo}
        </h2>
        <div class="w-full" data-reveal data-reveal-delay="0.14">
          <FlussoCaso caso={c} />
        </div>
      </Slide>
    ))}

    <!-- ── Il canale conversazionale ──────────────────────────────────── -->
    {/* Nella riunione del 27 ott i motori conversazionali erano la prima
        priorità dichiarata. Qui stanno dopo il percorso sulla vista unica, non
        prima: il contesto che serve a rispondere bene è lo stesso che serve ai
        cinque casi sopra. Restano due cose, distinte di proposito. */}
    <Slide id="slide-conversazionale" bg="primary" align="center">
      <div slot="backdrop" class="absolute inset-0">
        <div class="fs-bg-soft"></div>
        <div class="fs-grid"></div>
      </div>
      <Sfondo slot="backdrop" id="rl-banchina" forza="forte" />
      <p class="fs-panel-tag text-center mb-3" data-reveal>IL CANALE CHE CRESCE · SI LEGGE GIÀ DALLA FASE 0</p>
      <h2
        class="text-center text-[var(--ink-primary)] mb-4 font-[family-name:var(--font-display)]"
        style="font-size: clamp(1.7rem, 2.7vw, 2.4rem); font-weight: 600; line-height: 1.06; letter-spacing: -0.02em;"
        data-reveal data-reveal-delay="0.08"
      >
        Prima si misura quanto pesa il traffico dagli assistenti.
      </h2>
      <p class="text-center fs-card-body max-w-3xl mx-auto mb-6" data-reveal data-reveal-delay="0.14">
        Come vi nominano e che cosa sa di chi vi scrive sono due lavori diversi. In&nbsp;mezzo, il&nbsp;numero
        che ancora manca.
      </p>

      <div class="w-full" data-reveal data-reveal-delay="0.2">
        <DiagAssistenti />
      </div>
      <p class="fs-panel-src text-center mt-5" data-reveal data-reveal-delay="0.3">
        Se un domani l’assistente usasse il profilo, servirebbe una valutazione privacy a sé: qui non si propone.
      </p>
    </Slide>

    <!-- ── La referenza, e il passo ───────────────────────────────────── -->
    <Slide id="slide-riferimento" bg="secondary" align="center">
      <div slot="backdrop" class="absolute inset-0">
        <div class="fs-bg-soft"></div>
        <div class="fs-grid"></div>
      </div>
      <Sfondo slot="backdrop" id="tr-tetto" forza="forte" />
      <p class="fs-panel-tag text-center mb-3" data-reveal>UN’ALTRA FERROVIA CHE LEGGE IL VIAGGIO</p>
      <h2
        class="text-center text-[var(--ink-primary)] mb-4 font-[family-name:var(--font-display)]"
        style="font-size: clamp(1.7rem, 2.7vw, 2.4rem); font-weight: 600; line-height: 1.06; letter-spacing: -0.02em;"
        data-reveal data-reveal-delay="0.08"
      >
        {RIFERIMENTO.nome}
      </h2>
      <p class="text-center fs-card-body max-w-3xl mx-auto mb-6" data-reveal data-reveal-delay="0.14">
        {RIFERIMENTO.cosa}
      </p>

      <div class="w-full max-w-md mx-auto grid grid-cols-1 gap-4" data-stagger>
        {RIFERIMENTO.numeri.map((n) => (
          <div class="fs-card text-center !py-5">
            <p
              class="mx-auto mb-2 font-[family-name:var(--font-display)] text-[var(--ink-primary)]"
              style="font-size: clamp(1.8rem, 2.8vw, 2.5rem); font-weight: 600; line-height: 1.04; letter-spacing: -0.03em;"
              data-display
            >{n.v}</p>
            <p class="fs-card-body">{lega(n.l)}</p>
          </div>
        ))}
      </div>

      <p class="fs-panel-src text-center mt-5" data-reveal data-reveal-delay="0.3">
        Caso pubblicato da Adobe ·
        <a href={RIFERIMENTO.url} target="_blank" rel="noopener noreferrer">business.adobe.com</a>
      </p>

      <div class="fs-panel fs-panel--alt w-full max-w-5xl mx-auto text-left mt-4 !py-3.5" data-reveal data-reveal-delay="0.36">
        <p class="fs-panel-src">
          Fonti del capitolo, aperte il 22 novembre 2026: {FONTI_CAPITOLO.map((f, i) => (
            <>{i > 0 ? ' · ' : ''}<a href={f.url} target="_blank" rel="noopener noreferrer">{f.cosa}</a></>
          ))}
        </p>
      </div>
    </Slide>

  </DeckContainer>
</BaseLayout>

