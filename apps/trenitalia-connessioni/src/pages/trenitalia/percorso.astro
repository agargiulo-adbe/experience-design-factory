---
/**
 * Capitolo 05 — Prossimi passi: tre decisioni a dicembre.
 *
 * RIDISEGNATO IL 27 NOV 2026: il capitolo diceva le tappe ma non chi decide che
 * cosa. Ora apre sulle tre decisioni, poi le tappe, la regola per passare alla
 * fase 1, le licenze. I tre obiettivi (misurare, conoscere, condividere) escono:
 * erano tre parole che non decidevano nulla. Quello che segue è la storia di prima.
 *
 * RISCRITTO IL 22 NOV 2026. Prima il capitolo proponeva due fasi di prodotto
 * (CJA, poi Real-Time CDP e Journey Optimizer; dal 27 nov Journey Optimizer
 * non si considera: nel Gruppo è di FS News) e un POC su dati simulati. Il piano
 * di oggi è un altro: il primo passo in produzione su un volume limitato, una o due
 * attività Target su trenitalia.com con lo status estratto dal CRM. In parallelo si
 * lega l'acquisto su Le Frecce, che porta la misura sul venduto; Le Frecce e l'app
 * arrivano con il nuovo portale di vendita (riordinato il 23 nov 2026).
 *
 * LE DATE SONO INDICATIVE, e lo si dice in pagina. Dipendono dall'esito della
 * verifica sui due siti e dai rilasci. Un test su Target chiede qualche settimana di
 * traffico: per questo la prima misura sta a febbraio e non a gennaio.
 *
 * I TRE OBIETTIVI (misurare, conoscere, condividere) vengono da un suggerimento
 * interno del 16 nov: ognuno porta sotto la domanda a cui risponde, così il
 * risultato del primo passo si dice in una frase.
 *
 * IL CONSENSO: il primo passo parte quando chi fissa le priorità in Trenitalia e chi
 * presidia la piattaforma in FS Technology arrivano allo stesso sì. Si dice per
 * ruolo, mai per nome.
 */
import { lega } from '../../utils/lega';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Sfondo from '../../components/Sfondo.astro';
import SfondoLoop from '../../components/SfondoLoop.astro';
import CoBrand from '../../components/CoBrand.astro';
import TreniNavigation from '../../components/TreniNavigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import CoverHero from '@edf/core/blocks/CoverHero.astro';
import { href } from '@edf/core/utils/url.js';
import { rotte } from '../../data/percorso';

const base = import.meta.env.BASE_URL;
const { next, prev } = rotte('trenitalia/percorso');
const currentPath = Astro.url.pathname;

/* Le tre decisioni di dicembre. È la slide che mancava: prima il capitolo diceva
   «chi fa che cosa» con cinque attori per riga e nessun responsabile, e le
   decisioni vere stavano sepolte nel capitolo sulla fase 0 (27 nov 2026). */
const decisioni = [
  { n: '1', cosa: 'Customer Journey Analytics a contratto, con i primi sei mesi senza costo',
    decide: 'La direzione dei canali digitali, come committente',
    lavora: 'Adobe prepara la proposta; FS Technology la verifica e gestisce il budget', quando: 'Dicembre' },
  { n: '2', cosa: 'Il via libera a leggere insieme i due Analytics',
    decide: 'FS Technology, chi amministra Le Frecce e il DPO',
    lavora: 'Adobe e FS Technology; chi gestisce gli Analytics di Le Frecce (IBM, da confermare)', quando: 'Dicembre' },
  { n: '3', cosa: 'Il primo caso da provare in home',
    decide: 'I canali digitali, con il marketing',
    lavora: 'Il vostro team Target, con Adobe', quando: 'Entro la sesta settimana' },
];

/* Dal sì al login: le prime due tappe sono di adesso (rosso), le altre arrivano
   dopo (verde acqua). I tempi della fase 2 non sono nostri, e si dice. */
const tappe = [
  { quando: 'Dicembre', cosa: 'Due decisioni', dettaglio: 'Il contratto e il via libera sui dati. Quanto dura il via libera si stima insieme.' },
  { quando: 'Settimane 1–6', cosa: 'La fase 0', dettaglio: 'I due siti si leggono insieme. Alla sesta settimana, le prime letture e il primo test in home.' },
  { quando: 'Dopo le prime letture', cosa: 'La fase 1', dettaglio: 'Si decide con tre numeri della fase 0. Intanto si prepara il campo in più.', poi: true },
  { quando: 'Con il login', cosa: 'La fase 2', dettaglio: 'Dipende dal login su trenitalia.com e dal nuovo portale: i tempi sono del Gruppo.', poi: true },
];

/* La regola per passare alla fase 1, e che cosa succede se non si prosegue. Viene
   dal panel del 26 nov: senza una regola d'uscita la fase 0 sembrava un impegno. */
const regola = [
  { k: 'La perdita fra i due siti', v: 'tratta per tratta: dice dove la fase 1 rende di più' },
  { k: 'Le conferme che arrivano da trenitalia.com', v: 'è la quota che la fase 1 può collegare' },
  { k: 'Safari e iOS', v: 'su quei browser il collegamento dura meno: quanto pesano?' },
];

// Che cosa c'è già e che cosa si aggiunge. Nessuna cifra: la quotazione sta nella
// proposta. Il passaggio dei pubblici verso Target usa la destinazione di Experience
// Platform e si abilita nella proposta: al cliente non si chiede una piattaforma da gestire.
const licenze = [
  { stato: 'Già a contratto', cosa: 'Adobe Analytics e Adobe Target' },
  { stato: 'Si aggiunge', cosa: 'Customer Journey Analytics, senza costo per i primi sei mesi', nuovo: true },
  { stato: 'Dalla fase 1', cosa: 'Real-Time CDP, limitato al passaggio dei gruppi di visitatori verso Target', nuovo: true },
  { stato: 'Per arrivare prima', cosa: 'CX Enterprise Coworker: accorcia il tempo fra la lettura e il test. L’accesso si definisce a parte' },
];

---
<BaseLayout
  title="Prossimi passi"
  description="Due decisioni a dicembre, il contratto e il via libera sui dati; il primo caso entro la sesta settimana."
  pageSolutions={['cja']}
  branch="trenitalia"
>
  <div class="fixed top-0 left-0 right-0 z-50">
    <TreniNavigation currentPath={currentPath} base={base} branch="trenitalia" />
  </div>

  <DeckContainer wallScale
    nextHref={href(base, next)}
    prevHref={href(base, prev)}
  >

    <!-- ── Copertina ──────────────────────────────────────────────── -->
    <Slide id="slide-cover" bg="primary" align="center">
      <div slot="backdrop" class="fs-bg"></div>
      <Sfondo slot="backdrop" id="tr-tetto" forza="leggera" />
      <div slot="backdrop" class="fs-grid"></div>
      <CoverHero
        eyebrow="Capitolo 05 · Prossimi passi"
        numeral="05"
        title="Due decisioni a dicembre, una alla sesta settimana"
        lead={lega('Da quando contratto e via libera ci sono, le prime letture arrivano in circa sei settimane.')}
        size="phase"
        tone="ink"
        signature={false}
      />
    </Slide>

    <!-- ── Che cosa si decide adesso ──────────────────────────────────── -->
    <Slide id="slide-decisioni" bg="primary" align="center">
      <div slot="backdrop" class="fs-bg"></div>
      <Sfondo slot="backdrop" id="tc-acciaio" forza="forte" />
      <div slot="backdrop" class="fs-grid"></div>
      <p class="fs-panel-tag text-center mb-3" data-reveal>CHE COSA SI DECIDE ADESSO</p>
      <h2
        class="text-center text-[var(--ink-primary)] mb-7 font-[family-name:var(--font-display)]"
        style="font-size: clamp(1.7rem, 2.7vw, 2.4rem); font-weight: 600; line-height: 1.06; letter-spacing: -0.02em;"
        data-reveal data-reveal-delay="0.08"
      >
        Tre decisioni, ognuna con chi la&nbsp;prende.
      </h2>
      <div class="pc-dec" role="table" aria-label="Le tre decisioni" data-reveal data-reveal-delay="0.16">
        <div class="pc-dec-r pc-dec-t" role="row">
          <span role="columnheader"></span><span role="columnheader">La decisione</span><span role="columnheader">Chi decide</span><span role="columnheader">Chi lavora</span><span role="columnheader">Quando</span>
        </div>
        {decisioni.map((d) => (
          <div class="pc-dec-r" role="row">
            <span role="cell" class="pc-dec-n">{d.n}</span>
            <span role="cell" class="pc-dec-c">{lega(d.cosa)}</span>
            <span role="cell">{lega(d.decide)}</span>
            <span role="cell">{lega(d.lavora)}</span>
            <span role="cell" class="pc-dec-q">{d.quando}</span>
          </div>
        ))}
      </div>
      <p class="fs-panel-src text-center mt-5" data-reveal data-reveal-delay="0.3">
        {lega('L’ordine segue il percorso d’acquisto del Gruppo, con la sua centrale di committenza: da confermare insieme. Il caso si sceglie dall’analisi su Target già in corso fra FS Technology e il partner.')}
      </p>
    </Slide>

    <!-- ── Le tappe ──────────────────────────────────────────────────── -->
    {/* Tutte e quattro in vista da subito: a passi chiusi la slide era una card su
        quattro, con il vuoto accanto. */}
    <Slide id="slide-tappe" bg="primary" align="center">
      <div slot="backdrop" class="fs-bg"></div>
      <Sfondo slot="backdrop" id="rl-binari" forza="forte" />
      <div slot="backdrop" class="fs-grid"></div>
      <p class="fs-panel-tag text-center mb-3" data-reveal>LE TAPPE</p>
      <h2
        class="text-center text-[var(--ink-primary)] mb-8 font-[family-name:var(--font-display)]"
        style="font-size: clamp(1.7rem, 2.7vw, 2.4rem); font-weight: 600; line-height: 1.06; letter-spacing: -0.02em;"
        data-reveal data-reveal-delay="0.08"
      >
        Dal via alle prime letture, in circa sei&nbsp;settimane.
      </h2>
      <ol class="pc-linea" data-stagger>
        {tappe.map((t) => (
          <li class:list={['pc-tappa', t.poi && 'pc-tappa--poi']}>
            <span class="pc-punto" aria-hidden="true"></span>
            <p class="pc-quando">{t.quando}</p>
            <p class="pc-cosa">{lega(t.cosa)}</p>
            <p class="pc-det">{lega(t.dettaglio)}</p>
          </li>
        ))}
      </ol>
      <p class="fs-panel-src text-center mt-6" data-reveal data-reveal-delay="0.3">
        {lega('Sei settimane è un’ipotesi di Adobe, e parte da quando contratto e via libera ci sono.')}
      </p>
    </Slide>

    <!-- ── La regola per passare alla fase 1 ──────────────────────────── -->
    <Slide id="slide-regola" bg="secondary" align="center">
      <div slot="backdrop" class="fs-bg-soft"></div>
      <Sfondo slot="backdrop" id="tc-quiete" forza="media" />
      <div slot="backdrop" class="fs-grid"></div>
      <p class="fs-panel-tag text-center mb-3" data-reveal>DOPO LE PRIME LETTURE</p>
      <h2
        class="text-center text-[var(--ink-primary)] mb-5 font-[family-name:var(--font-display)]"
        style="font-size: clamp(1.7rem, 2.7vw, 2.4rem); font-weight: 600; line-height: 1.06; letter-spacing: -0.02em;"
        data-reveal data-reveal-delay="0.08"
      >
        Alla fase 1 si passa con tre numeri della fase&nbsp;0.
      </h2>
      <p class="text-center fs-card-body max-w-3xl mx-auto mb-7" style="text-wrap: balance;" data-reveal data-reveal-delay="0.14">
        {lega('Le soglie si fissano insieme, sui valori delle prime due settimane.')}
      </p>
      <ol class="pc-regola" data-stagger>
        {regola.map((r, i) => (
          <li>
            <span class="pc-regola-n" aria-hidden="true">{i + 1}</span>
            <p class="pc-regola-k">{lega(r.k)}</p>
            <p class="pc-regola-v">{lega(r.v)}</p>
          </li>
        ))}
      </ol>
      <div class="pc-uscita" data-reveal data-reveal-delay="0.3">
        <p><strong>Se non si prosegue.</strong> {lega('Connessione, dati e mappatura si cancellano, con una conferma scritta.')}</p>
      </div>
    </Slide>

    <!-- ── Che cosa c'è già e che cosa si aggiunge ─────────────────────── -->
    <Slide id="slide-licenze" bg="secondary" align="center">
      <div slot="backdrop" class="fs-bg-soft"></div>
      <Sfondo slot="backdrop" id="tc-strati" forza="media" />
      <div slot="backdrop" class="fs-grid"></div>
      <p class="fs-panel-tag text-center mb-3" data-reveal>CHE COSA C’È, CHE COSA SI AGGIUNGE</p>
      <h2
        class="text-center text-[var(--ink-primary)] mb-5 font-[family-name:var(--font-display)]"
        style="font-size: clamp(1.7rem, 2.7vw, 2.4rem); font-weight: 600; line-height: 1.06; letter-spacing: -0.02em;"
        data-reveal data-reveal-delay="0.08"
      >
        Per la fase 0 basta un prodotto in&nbsp;più. Il&nbsp;secondo serve dalla fase&nbsp;1.
      </h2>
      <p class="text-center fs-card-body max-w-3xl mx-auto mb-7" data-reveal data-reveal-delay="0.14">
        Per i primi sei mesi si leggono tre mesi di storico in Customer Journey Analytics; il confronto anno su anno resta in Analytics. Il dopo si decide su un tavolo a&nbsp;parte.
      </p>
      <ul class="pc-lic" data-stagger>
        {licenze.map((l) => (
          <li class:list={['pc-lic-r', l.nuovo && 'pc-lic-r--nuovo']}>
            <span class="pc-lic-s">{l.stato}</span>
            <span class="pc-lic-c">{lega(l.cosa)}</span>
          </li>
        ))}
      </ul>
    </Slide>

    <!-- ── Chiusura ──────────────────────────────────────────────────── -->
    <Slide id="slide-chiusura" bg="primary" align="center" data-made-with="Firefly" data-made-with-for="clip">
      <div slot="backdrop" class="fs-bg"></div>
      <div slot="backdrop" class="fs-grid"></div>
      <SfondoLoop slot="backdrop" id="linea-chiusura" forza="media" />
      <div class="w-full max-w-4xl mx-auto text-center flex flex-col items-center gap-9">
        <p class="fs-panel-tag" data-reveal>IL PROSSIMO PASSO</p>
        <h2
          class="font-[family-name:var(--font-display)] text-[var(--color-chiaro)]"
          style="font-size: clamp(2.4rem, 5vw, 4.4rem); font-weight: 600; line-height: 1.02; letter-spacing: -0.03em;"
          data-display
          data-reveal
          data-reveal-delay="0.1"
        >
          A dicembre: il sì alla fase 0.<br/>Alla sesta settimana, il primo caso.
        </h2>
        <CoBrand brand="Trenitalia" variant="hero" data-reveal data-reveal-delay="0.28" />
        <a href={href(base, '/trenitalia/percorso') + '#slide-decisioni'} class="edf-sig-cta" data-reveal data-reveal-delay="0.4">Le tre decisioni →</a>
      </div>
    </Slide>

  </DeckContainer>
</BaseLayout>

<style is:global>
  /* ── La linea delle tappe ─────────────────────────────────────────── */
  .pc-linea {
    list-style: none; margin: 0 auto; padding: 0;
    width: 100%; max-width: 72rem;
    display: grid; grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(0.8rem, 1.6vw, 1.6rem);
    position: relative;
  }
  .pc-linea::before {
    content: ''; position: absolute; left: 0.55rem; right: 0.55rem; top: 0.55rem;
    height: 2px; background: rgba(255, 255, 255, 0.35);
  }
  .pc-tappa { position: relative; display: grid; align-content: start; gap: 0.35rem; margin-top: 2rem; padding: 1rem 1.1rem 1.1rem; text-align: left;
    background: rgba(27, 34, 48, 0.62); border: 1px solid var(--line-subtle); border-radius: 0.6rem; }
  [data-slide] .pc-tappa p { margin: 0; max-width: none; text-align: left; }
  .pc-punto {
    position: absolute; top: -2rem; left: 0; width: 1.1rem; height: 1.1rem; border-radius: 50%;
    background: var(--color-rosso); box-shadow: 0 0 0 4px rgba(217, 24, 53, 0.25);
  }
  .pc-tappa--poi .pc-punto { background: transparent; box-shadow: inset 0 0 0 2px var(--color-verde-chiaro); }
  .pc-quando {
    font-size: clamp(0.84rem, 0.9vw, 0.96rem); font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--color-rosso-chiaro);
  }
  .pc-tappa--poi .pc-quando { color: var(--color-verde-chiaro); }
  .pc-cosa {
    font-family: var(--font-display); font-weight: 600;
    font-size: clamp(1.15rem, 1.35vw, 1.45rem); line-height: 1.2; color: var(--ink-primary);
  }
  .pc-det { font-size: clamp(0.95rem, 1vw, 1.05rem); line-height: 1.5; color: var(--ink-secondary); }

  /* ── Le tre decisioni ─────────────────────────────────────────────── */
  .pc-dec { width: 100%; max-width: 80rem; margin-inline: auto; display: grid; gap: 0.6rem; text-align: left; }
  .pc-dec-r {
    display: grid; grid-template-columns: 2.6rem minmax(0, 1.35fr) minmax(0, 1.1fr) minmax(0, 1.1fr) minmax(7.5rem, 0.6fr); gap: clamp(0.8rem, 1.4vw, 1.5rem);
    align-items: center; padding: clamp(0.9rem, 2.2vh, 1.35rem) clamp(0.9rem, 1.2vw, 1.3rem);
    border-radius: 0.6rem; border: 1px solid rgba(255, 255, 255, 0.22); background: rgba(27, 34, 48, 0.6);
    font-size: clamp(1.02rem, 1.08vw, 1.16rem); line-height: 1.36; color: var(--ink-primary);
  }
  .pc-dec-r > span { text-wrap: pretty; }
  .pc-dec-t { background: none; border: none; padding-block: 0 0.1rem; font-size: clamp(0.86rem, 0.92vw, 0.98rem); font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-secondary); }
  .pc-dec-n { display: inline-grid; place-items: center; width: 2.2rem; height: 2.2rem; border-radius: 50%; background: var(--color-rosso); font-family: var(--font-display); font-weight: 700; font-size: 1.15rem; }
  .pc-dec-c { font-family: var(--font-display); font-weight: 600; font-size: clamp(1.1rem, 1.25vw, 1.36rem); line-height: 1.25; }
  .pc-dec-q { font-weight: 700; color: var(--color-rosso-chiaro); }
  @media (max-width: 900px) { .pc-dec-r { grid-template-columns: minmax(0, 1fr); } .pc-dec-t { display: none; } }

  /* ── La regola per passare alla fase 1 ────────────────────────────── */
  .pc-regola { list-style: none; margin: 0 auto; padding: 0; width: 100%; max-width: 76rem; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(0.8rem, 1.4vw, 1.5rem); text-align: left; }
  .pc-regola li { display: grid; gap: 0.45rem; align-content: start; padding: clamp(1rem, 2.2vh, 1.4rem) clamp(1rem, 1.3vw, 1.4rem); border-radius: 0.7rem; border: 1px solid rgba(255, 255, 255, 0.22); background: rgba(27, 34, 48, 0.6); }
  [data-slide] .pc-regola p { margin: 0; max-width: none; text-align: left; }
  .pc-regola-n { display: inline-grid; place-items: center; width: 2rem; height: 2rem; border-radius: 50%; border: 2px solid var(--color-verde-chiaro); font-family: var(--font-display); font-weight: 700; font-size: 1.05rem; color: var(--ink-primary); }
  .pc-regola-k { font-family: var(--font-display); font-weight: 600; font-size: clamp(1.15rem, 1.35vw, 1.45rem); line-height: 1.2; color: var(--ink-primary); }
  .pc-regola-v { font-size: clamp(1.02rem, 1.08vw, 1.16rem); line-height: 1.4; color: var(--ink-secondary); }
  .pc-uscita { width: 100%; max-width: 76rem; margin: clamp(1rem, 2.4vh, 1.5rem) auto 0; padding: clamp(0.8rem, 1.8vh, 1.1rem) clamp(1rem, 1.4vw, 1.5rem); border-radius: 0.7rem; border: 1.5px dashed rgba(255, 255, 255, 0.55); text-align: left; }
  [data-slide] .pc-uscita p { margin: 0; max-width: none; text-align: left; font-size: clamp(1.02rem, 1.1vw, 1.18rem); line-height: 1.42; color: var(--ink-primary); }
  @media (max-width: 900px) { .pc-regola { grid-template-columns: minmax(0, 1fr); } }

  /* ── Licenze ──────────────────────────────────────────────────────── */
  .pc-lic { list-style: none; margin: 0 auto; padding: 0; width: 100%; max-width: 60rem; display: grid; gap: 0.7rem; }
  .pc-lic-r {
    display: grid; grid-template-columns: 12rem minmax(0, 1fr); gap: 1.2rem; align-items: center;
    padding: 1.1rem 1.3rem; border-radius: 0.6rem; text-align: left;
    background: rgba(27, 34, 48, 0.6); border: 1px solid var(--line-subtle);
  }
  .pc-lic-r--nuovo { border: 1.5px solid rgba(79, 189, 180, 0.75); }
  .pc-lic-s { font-size: clamp(0.84rem, 0.9vw, 0.96rem); font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-rosso-chiaro); }
  .pc-lic-r--nuovo .pc-lic-s { color: var(--color-verde-chiaro); }
  .pc-lic-c { font-family: var(--font-display); font-weight: 600; font-size: clamp(1.1rem, 1.25vw, 1.35rem); line-height: 1.3; color: var(--ink-primary); }
  @media (max-width: 900px) { .pc-lic-r { grid-template-columns: minmax(0, 1fr); gap: 0.3rem; } }

  @media (max-width: 900px) {
    .pc-linea { grid-template-columns: minmax(0, 1fr); }
    .pc-linea::before { display: none; }
  }
</style>
