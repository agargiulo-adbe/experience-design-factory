---
/**
 * Capitolo 05 — Percorso: da dicembre, un passo alla volta.
 *
 * RISCRITTO IL 22 NOV 2026. Prima il capitolo proponeva due fasi di prodotto
 * (CJA, poi Real-Time CDP e Journey Optimizer) e un POC su dati simulati. Il piano
 * di oggi è un altro: il primo passo in produzione su un volume limitato, una o due
 * attività Target su trenitalia.com con lo status estratto dal CRM. In parallelo si
 * lega l'acquisto su Le Frecce, che porta la misura sul venduto; Le Frecce e l'app
 * arrivano con il nuovo portale di vendita (riordinato il 23 nov 2026).
 *
 * LE DATE SONO INDICATIVE, e lo si dice in pagina. Dipendono dall'esito della
 * verifica sui due siti e dai rilasci. Un test su Target chiede qualche settimana di
 * traffico: per questo la prima misura sta a febbraio e non a gennaio.
 *
 * I TRE OBIETTIVI (misurare, conoscere, condividere) vengono da un suggerimento
 * interno del 16 nov: ognuno porta sotto la domanda a cui risponde, così il
 * risultato del primo passo si dice in una frase.
 *
 * IL CONSENSO: il primo passo parte quando chi fissa le priorità in Trenitalia e chi
 * presidia la piattaforma in FS Technology arrivano allo stesso sì. Si dice per
 * ruolo, mai per nome.
 */
import { lega } from '../../utils/lega';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Sfondo from '../../components/Sfondo.astro';
import SfondoLoop from '../../components/SfondoLoop.astro';
import CoBrand from '../../components/CoBrand.astro';
import TreniNavigation from '../../components/TreniNavigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import CoverHero from '@edf/core/blocks/CoverHero.astro';
import { href } from '@edf/core/utils/url.js';
import { rotte } from '../../data/percorso';

const base = import.meta.env.BASE_URL;
const { next, prev } = rotte('trenitalia/percorso');
const currentPath = Astro.url.pathname;

const tappe = [
  { quando: 'Dicembre', cosa: 'Si scelgono i casi', dettaglio: 'Uno o due casi del primo passo. Intanto si aprono il parere del DPO e quello della sicurezza IT per lo status.' },
  { quando: 'Dopo il sì', cosa: 'CJA si accende', dettaglio: 'Qualche settimana per il connettore e lo storico, poi la prima attività su trenitalia.com.' },
  { quando: 'Dopo la prova', cosa: 'La prima misura', dettaglio: 'La durata si calcola sul traffico di ciascun caso, con un gruppo di controllo fisso.' },
  { quando: 'In parallelo, poi', cosa: 'Si aggiunge il resto', dettaglio: 'Da subito si lavora al legame con l’acquisto su Le Frecce, che porta anche lo status. Target su Le Frecce e app arriva con il nuovo portale.' },
];

const obiettivi = [
  { verbo: 'Misurare', domanda: 'Quale proposta fa crescere il ricavo, senza abbassare il prezzo medio?' },
  { verbo: 'Conoscere', domanda: 'Dove si perde la vendita, fra la ricerca e l’acquisto?' },
  { verbo: 'Condividere', domanda: 'Su quale definizione di vendita si mettono d’accordo marketing, vendite e IT?' },
];

// Che cosa c'è già e che cosa si aggiunge. Nessuna cifra: la quotazione sta nella
// proposta. Il passaggio dei pubblici verso Target usa la destinazione di Experience
// Platform e si abilita nella proposta: al cliente non si chiede una piattaforma da gestire.
const licenze = [
  { stato: 'Già a contratto', cosa: 'Adobe Analytics e Adobe Target' },
  { stato: 'Si aggiunge', cosa: 'Customer Journey Analytics', nuovo: true },
  { stato: 'Si aggiunge', cosa: 'L’abilitazione della destinazione Target, che passa i pubblici: voce a parte', nuovo: true },
  { stato: 'Facoltativo', cosa: 'CX Enterprise Coworker: il primo passo funziona anche senza' },
];

const serve = [
  { cosa: 'Scegliere uno o due casi', chi: 'Canali digitali, Direzione Sales, marketing e revenue management, con FS Technology' },
  { cosa: 'Legare l’acquisto e lo status, in parallelo', chi: 'Il partner, FS Technology e Adobe; il pubblico raggiungibile si definisce insieme' },
  { cosa: 'Valutazione privacy, da subito', chi: 'DPO e sicurezza IT: consenso, estrazione dal CRM, chi vede quali dati' },
  { cosa: 'Amministrare CJA ed Experience Platform', chi: 'FS Technology e il partner, con Adobe nei primi mesi' },
];
---
<BaseLayout
  title="Da dicembre, un passo alla volta"
  description="Si scelgono i casi, si accende il primo passo su trenitalia.com, e in parallelo si lega l’acquisto su Le Frecce, che porta lo status dal CRM. Le Frecce e l’app arrivano con il nuovo portale."
  pageSolutions={['cja']}
  branch="trenitalia"
>
  <div class="fixed top-0 left-0 right-0 z-50">
    <TreniNavigation currentPath={currentPath} base={base} branch="trenitalia" />
  </div>

  <DeckContainer wallScale
    nextHref={href(base, next)}
    prevHref={href(base, prev)}
  >

    <!-- ── Copertina ──────────────────────────────────────────────── -->
    <Slide id="slide-cover" bg="primary" align="center">
      <div slot="backdrop" class="fs-bg"></div>
      <Sfondo slot="backdrop" id="tr-tetto" forza="leggera" />
      <div slot="backdrop" class="fs-grid"></div>
      <CoverHero
        eyebrow="Capitolo 05 · Percorso"
        numeral="05"
        title="Da dicembre, un passo alla volta"
        lead="A dicembre si scelgono i casi; la prima misura arriva dopo la durata della prova."
        size="phase"
        tone="ink"
        signature={false}
      />
    </Slide>

    <!-- ── Le tappe ──────────────────────────────────────────────────── -->
    {/* Una tappa per ↓: chi presenta racconta il calendario, non lo legge. */}
    <Slide id="slide-tappe" bg="primary" align="center">
      <div slot="backdrop" class="fs-bg"></div>
      <Sfondo slot="backdrop" id="rl-binari" forza="forte" />
      <div slot="backdrop" class="fs-grid"></div>
      <p class="fs-panel-tag text-center mb-3" data-reveal>LE TAPPE</p>
      <h2
        class="text-center text-[var(--ink-primary)] mb-5 font-[family-name:var(--font-display)]"
        style="font-size: clamp(1.7rem, 2.7vw, 2.4rem); font-weight: 600; line-height: 1.06; letter-spacing: -0.02em;"
        data-reveal data-reveal-delay="0.08"
      >
        Dalla scelta dei casi alla prima misura.
      </h2>
      <p class="text-center fs-card-body max-w-3xl mx-auto mb-8" data-reveal data-reveal-delay="0.14">
        Con il sì a dicembre, la prima attività parte dopo il blocco dei rilasci di fine anno.
      </p>
      <ol class="pc-linea" data-reveal data-reveal-delay="0.2">
        {tappe.map((t, i) => (
          <li class:list={['pc-tappa', i === tappe.length - 1 && 'pc-tappa--poi']} data-substep={i > 0 ? '' : undefined}>
            <span class="pc-punto" aria-hidden="true"></span>
            <p class="pc-quando">{t.quando}</p>
            <p class="pc-cosa">{lega(t.cosa)}</p>
            <p class="pc-det">{lega(t.dettaglio)}</p>
          </li>
        ))}
      </ol>
    </Slide>

    <!-- ── Che cosa vi portate a casa ─────────────────────────────────── -->
    <Slide id="slide-obiettivi" bg="secondary" align="center">
      <div slot="backdrop" class="fs-bg-soft"></div>
      <Sfondo slot="backdrop" id="tc-quiete" forza="media" />
      <div slot="backdrop" class="fs-grid"></div>
      <p class="fs-panel-tag text-center mb-3" data-reveal>DOPO IL PRIMO PASSO</p>
      <h2
        class="text-center text-[var(--ink-primary)] mb-5 font-[family-name:var(--font-display)]"
        style="font-size: clamp(1.7rem, 2.7vw, 2.4rem); font-weight: 600; line-height: 1.06; letter-spacing: -0.02em;"
        data-reveal data-reveal-delay="0.08"
      >
        Il secondo passo si decide con i numeri del primo.
      </h2>
      <p class="text-center fs-card-body max-w-3xl mx-auto mb-8" data-reveal data-reveal-delay="0.14">
        Per ogni caso si fissano prima il valore di oggi, l’effetto minimo che basta e la durata.
      </p>
      <div class="w-full max-w-6xl mx-auto grid md:grid-cols-3 gap-5" data-stagger>
        {obiettivi.map((o, i) => (
          <div class="fs-card text-left h-full pc-ob">
            <p class="pc-ob-n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</p>
            <p class="pc-ob-v">{o.verbo}</p>
            <p class="fs-card-body pc-ob-d">{lega(o.domanda)}</p>
          </div>
        ))}
      </div>
    </Slide>

    <!-- ── Che cosa c'è già e che cosa si aggiunge ─────────────────────── -->
    <Slide id="slide-licenze" bg="secondary" align="center">
      <div slot="backdrop" class="fs-bg-soft"></div>
      <Sfondo slot="backdrop" id="tc-strati" forza="media" />
      <div slot="backdrop" class="fs-grid"></div>
      <p class="fs-panel-tag text-center mb-3" data-reveal>CHE COSA C’È, CHE COSA SI AGGIUNGE</p>
      <h2
        class="text-center text-[var(--ink-primary)] mb-5 font-[family-name:var(--font-display)]"
        style="font-size: clamp(1.7rem, 2.7vw, 2.4rem); font-weight: 600; line-height: 1.06; letter-spacing: -0.02em;"
        data-reveal data-reveal-delay="0.08"
      >
        Per il primo passo si aggiungono CJA e il passaggio dei pubblici a Target.
      </h2>
      <p class="text-center fs-card-body max-w-3xl mx-auto mb-7" data-reveal data-reveal-delay="0.14">
        La quotazione è nella proposta, con i volumi e i mesi di storico. CJA legge i&nbsp;percorsi; il confronto anno su anno resta in Analytics.
      </p>
      <ul class="pc-lic" data-stagger>
        {licenze.map((l) => (
          <li class:list={['pc-lic-r', l.nuovo && 'pc-lic-r--nuovo']}>
            <span class="pc-lic-s">{l.stato}</span>
            <span class="pc-lic-c">{lega(l.cosa)}</span>
          </li>
        ))}
      </ul>
    </Slide>

    <!-- ── Che cosa serve per partire ─────────────────────────────────── -->
    <Slide id="slide-serve" bg="primary" align="center">
      <div slot="backdrop" class="fs-bg"></div>
      <Sfondo slot="backdrop" id="tc-acciaio" forza="media" />
      <div slot="backdrop" class="fs-grid"></div>
      <p class="fs-panel-tag text-center mb-3" data-reveal>CHI FA CHE COSA</p>
      <h2
        class="text-center text-[var(--ink-primary)] mb-5 font-[family-name:var(--font-display)]"
        style="font-size: clamp(1.7rem, 2.7vw, 2.4rem); font-weight: 600; line-height: 1.06; letter-spacing: -0.02em;"
        data-reveal data-reveal-delay="0.08"
      >
        Chi fa che cosa, da confermare insieme a dicembre.
      </h2>
      <p class="text-center fs-card-body max-w-3xl mx-auto mb-7" data-reveal data-reveal-delay="0.14">
        Si prepara a dicembre; il legame con Le Frecce si lavora intanto, in parallelo.
      </p>
      <ul class="pc-serve" data-stagger>
        {serve.map((s) => (
          <li class="pc-serve-r">
            <span class="pc-serve-c">{lega(s.cosa)}</span>
            <span class="pc-serve-chi">{lega(s.chi)}</span>
          </li>
        ))}
      </ul>
      <p class="text-center fs-card-body max-w-3xl mx-auto mt-6" data-reveal data-reveal-delay="0.3">
        I casi si scelgono partendo dall’analisi su Target in corso fra FS Technology e il partner, e li scelgono insieme Trenitalia e FS Technology.
      </p>
    </Slide>

    <!-- ── Chiusura ──────────────────────────────────────────────────── -->
    <Slide id="slide-chiusura" bg="primary" align="center" data-made-with="Firefly" data-made-with-for="clip">
      <div slot="backdrop" class="fs-bg"></div>
      <div slot="backdrop" class="fs-grid"></div>
      <SfondoLoop slot="backdrop" id="linea-chiusura" forza="media" />
      <div class="w-full max-w-4xl mx-auto text-center flex flex-col items-center gap-9">
        <p class="fs-panel-tag" data-reveal>IL PROSSIMO PASSO</p>
        <h2
          class="font-[family-name:var(--font-display)] text-[var(--color-chiaro)]"
          style="font-size: clamp(2.4rem, 5vw, 4.4rem); font-weight: 600; line-height: 1.02; letter-spacing: -0.03em;"
          data-display
          data-reveal
          data-reveal-delay="0.1"
        >
          A dicembre, uno o due casi<br/>e chi li firma.
        </h2>
        <CoBrand brand="Trenitalia" variant="hero" data-reveal data-reveal-delay="0.28" />
        <a href={href(base, '/trenitalia/partenza')} class="edf-sig-cta" data-reveal data-reveal-delay="0.4">Rivedi il percorso →</a>
      </div>
    </Slide>

  </DeckContainer>
</BaseLayout>

<style is:global>
  /* ── La linea delle tappe ─────────────────────────────────────────── */
  .pc-linea {
    list-style: none; margin: 0 auto; padding: 0;
    width: 100%; max-width: 72rem;
    display: grid; grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(0.8rem, 1.6vw, 1.6rem);
    position: relative;
  }
  .pc-linea::before {
    content: ''; position: absolute; left: 0.55rem; right: 0.55rem; top: 0.55rem;
    height: 2px; background: rgba(255, 255, 255, 0.35);
  }
  .pc-tappa { position: relative; display: grid; align-content: start; gap: 0.35rem; margin-top: 2rem; padding: 1rem 1.1rem 1.1rem; text-align: left;
    background: rgba(27, 34, 48, 0.62); border: 1px solid var(--line-subtle); border-radius: 0.6rem; }
  [data-slide] .pc-tappa p { margin: 0; max-width: none; text-align: left; }
  .pc-punto {
    position: absolute; top: -2rem; left: 0; width: 1.1rem; height: 1.1rem; border-radius: 50%;
    background: var(--color-rosso); box-shadow: 0 0 0 4px rgba(217, 24, 53, 0.25);
  }
  .pc-tappa--poi .pc-punto { background: transparent; box-shadow: inset 0 0 0 2px var(--color-verde-chiaro); }
  .pc-quando {
    font-size: clamp(0.84rem, 0.9vw, 0.96rem); font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--color-rosso-chiaro);
  }
  .pc-tappa--poi .pc-quando { color: var(--color-verde-chiaro); }
  .pc-cosa {
    font-family: var(--font-display); font-weight: 600;
    font-size: clamp(1.15rem, 1.35vw, 1.45rem); line-height: 1.2; color: var(--ink-primary);
  }
  .pc-det { font-size: clamp(0.95rem, 1vw, 1.05rem); line-height: 1.5; color: var(--ink-secondary); }

  /* ── I tre obiettivi ──────────────────────────────────────────────── */
  [data-slide] .pc-ob p { text-align: left; margin-inline: 0; max-width: none; }
  .pc-ob-n { font-size: 0.85rem; font-weight: 700; letter-spacing: 0.12em; color: var(--color-rosso-chiaro); margin: 0 0 0.5rem; }
  .pc-ob-v {
    font-family: var(--font-display); font-weight: 600;
    font-size: clamp(1.6rem, 2.2vw, 2.2rem); line-height: 1.05; letter-spacing: -0.02em;
    color: var(--ink-primary); margin: 0 0 0.7rem;
  }
  .pc-ob-d { font-size: clamp(1rem, 1.1vw, 1.15rem) !important; }

  /* ── Licenze ──────────────────────────────────────────────────────── */
  .pc-lic { list-style: none; margin: 0 auto; padding: 0; width: 100%; max-width: 60rem; display: grid; gap: 0.7rem; }
  .pc-lic-r {
    display: grid; grid-template-columns: 12rem minmax(0, 1fr); gap: 1.2rem; align-items: center;
    padding: 1.1rem 1.3rem; border-radius: 0.6rem; text-align: left;
    background: rgba(27, 34, 48, 0.6); border: 1px solid var(--line-subtle);
  }
  .pc-lic-r--nuovo { border-color: rgba(79, 189, 180, 0.7); box-shadow: inset 0.28rem 0 0 var(--color-verde-chiaro); }
  .pc-lic-s { font-size: clamp(0.84rem, 0.9vw, 0.96rem); font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-rosso-chiaro); }
  .pc-lic-r--nuovo .pc-lic-s { color: var(--color-verde-chiaro); }
  .pc-lic-c { font-family: var(--font-display); font-weight: 600; font-size: clamp(1.1rem, 1.25vw, 1.35rem); line-height: 1.3; color: var(--ink-primary); }
  @media (max-width: 900px) { .pc-lic-r { grid-template-columns: minmax(0, 1fr); gap: 0.3rem; } }

  /* ── Che cosa serve ───────────────────────────────────────────────── */
  .pc-serve { list-style: none; margin: 0 auto; padding: 0; width: 100%; max-width: 60rem; display: grid; gap: 0.6rem; }
  .pc-serve-r {
    display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); gap: 1.2rem; align-items: center;
    padding: 0.9rem 1.2rem; border-radius: 0.6rem;
    background: rgba(27, 34, 48, 0.6); border: 1px solid var(--line-subtle); text-align: left;
  }
  .pc-serve-c { font-family: var(--font-display); font-weight: 600; font-size: clamp(1.05rem, 1.2vw, 1.3rem); line-height: 1.25; color: var(--ink-primary); }
  .pc-serve-chi { font-size: clamp(0.95rem, 1vw, 1.05rem); line-height: 1.4; color: var(--ink-secondary); }

  @media (max-width: 900px) {
    .pc-linea { grid-template-columns: minmax(0, 1fr); }
    .pc-linea::before { display: none; }
    .pc-serve-r { grid-template-columns: minmax(0, 1fr); gap: 0.3rem; }
  }
</style>
