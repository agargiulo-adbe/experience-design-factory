---
/**
 * Capitolo — «Che cosa ci faccio»: i casi d'uso.
 *
 * Nasce il 28 ott 2026 da una richiesta esplicita, fatta il giorno prima dal
 * Direttore dei canali digitali: un quadro di quattro o cinque casi d'uso
 * importanti, con l'obiettivo dichiarato di vendere di più. La parte tecnica
 * gli andava bene; quello che mancava erano i casi.
 *
 * STA QUI, dopo Convergenza, perché Convergenza dice che cos'è lo strato e
 * questo dice che cosa ci si fa: invertirli vorrebbe dire mostrare la macchina
 * a chi ha già detto di non volersi ritrovare lo strumento senza saperlo usare.
 *
 * DAL 22 NOV 2026 I CASI SONO ORDINATI PER PASSO, riordinati il 23 nov dopo la
 * call con il partner e di nuovo la sera: due dal primo passo (trenitalia.com), uno
 * con l'acquisto e lo status (il cliente Oro: sul sito non si fa login, e lo status
 * si lega sulla conferma d'acquisto), che porta anche la misura sul venduto, due con
 * Le Frecce e l'app. La matrice lo fa vedere una colonna alla volta, e ogni caso
 * porta in testa il passo da cui esiste. Il perché sta in `src/data/casi-duso.ts`.
 *
 * DAL 26 NOV 2026 I PASSI SONO TRE FASI (0 Vista unica, 1 la conferma, 2 il login),
 * e il capitolo viene dopo «Vista unica»: la fase 0 ha il suo approfondimento prima.
 */
import { lega } from '../../utils/lega';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Sfondo from '../../components/Sfondo.astro';
import TreniNavigation from '../../components/TreniNavigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import CoverHero from '@edf/core/blocks/CoverHero.astro';
import DiagMatrice from '../../components/diagrammi/DiagMatrice.astro';
import SchermoCaso from '../../components/casi/SchermoCaso.astro';
import FlussoCaso from '../../components/casi/FlussoCaso.astro';
import { href } from '@edf/core/utils/url.js';
import { rotte } from '../../data/percorso';
import { CASI, CONFIG } from '../../data/casi-duso';

const base = import.meta.env.BASE_URL;
const { next, prev } = rotte('trenitalia/casi-duso');
const currentPath = Astro.url.pathname;

const nomeConfig = (id: string) => CONFIG.find((k) => k.id === id)?.nome ?? id;
const serveA = (id: string) => CONFIG.find((k) => k.id === id)?.serveBreve ?? '';


/**
 * La fotografia di ogni caso. Non è decorazione intercambiabile: l'alba sta
 * sul caso che parte da dove sei, i binari su chi ripassa, la pensilina su due
 * società che si incontrano. Gli slot vengono da `assets.index`, già usati dal
 * resto del deck: nessuna immagine nuova da generare.
 */
const SFONDI: Record<string, string> = {
  geo: 'rl-alba',
  interesse: 'rl-binari',
  oro: 'tc-quiete',
  upgrade: 'tc-acciaio',
  app: 'rl-pensilina',
};
---
<BaseLayout title="Che cosa ci faccio — i casi d'uso" branch="trenitalia">
  <div class="fixed top-0 left-0 right-0 z-50">
    <TreniNavigation currentPath={currentPath} base={base} branch="trenitalia" />
  </div>

  <DeckContainer nextHref={href(base, next)} prevHref={href(base, prev)}>

    <!-- ── Copertina ──────────────────────────────────────────────────── -->
    <Slide id="slide-cover" bg="primary" align="center">
      <div slot="backdrop" class="absolute inset-0">
        <Sfondo id="rl-banchina" forza="media" />
        <div class="fs-grid"></div>
      </div>
      <CoverHero
        eyebrow="Capitolo 03 · I casi"
        numeral="03"
        title="I casi su Target, e quando si fanno"
        lead={lega('Cinque casi sul canale digitale diretto, in ordine di fase. Per capire se una vendita è nuova o spostata serve il dato di agenzie e rivenditori: lo porta Sales, e si legge insieme.')}
        size="phase"
        signature={false}
      />
    </Slide>

    <!-- ── La matrice: una colonna alla volta ─────────────────────────── -->
    {/* Il primo ↓ accende la fase 0, il secondo la conferma d'acquisto, il
        terzo il login. Il punto rosso dice da dove nasce il caso; il punto
        chiaro che resta valido anche nei passi dopo. */}
    <Slide id="slide-matrice" bg="secondary" align="center">
      <div slot="backdrop" class="absolute inset-0">
        <div class="fs-bg-soft"></div>
        <div class="fs-grid"></div>
      </div>
      <Sfondo slot="backdrop" id="tc-strati" forza="forte" />
      <p class="fs-panel-tag text-center mb-3" data-reveal>I CASI, FASE PER FASE</p>
      <h2
        class="text-center text-[var(--ink-primary)] mb-5 font-[family-name:var(--font-display)]"
        style="font-size: clamp(1.7rem, 2.7vw, 2.4rem); font-weight: 600; line-height: 1.06; letter-spacing: -0.02em;"
        data-reveal data-reveal-delay="0.08"
      >
        Un caso parte dalla fase 0, uno dalla fase 1, tre dalla fase&nbsp;2.
      </h2>
      <div class="w-full" data-reveal data-reveal-delay="0.2">
        <DiagMatrice casi={CASI} />
      </div>
      <p class="fs-panel-src text-center mt-3" data-reveal data-reveal-delay="0.26">
        <span class="cs-leg"><i class="cs-leg-qui"></i>parte da questa fase</span>
        <span class="cs-leg"><i></i>resta valido nelle fasi dopo</span>
        <span class="cs-leg">Tre casi dal vostro elenco, due nostri</span>
      </p>
    </Slide>

    <!-- ── I cinque casi ──────────────────────────────────────────────── -->
    {CASI.map((c, i) => (
      <>
      {/* ── Come si fa: la sessione con Coworker, e che cosa vede chi viaggia ── */}
      <Slide id={`slide-caso-${c.id}`} bg={i % 2 === 0 ? 'primary' : 'secondary'} align="center">
        <div slot="backdrop" class="absolute inset-0">
          <div class="fs-bg-soft"></div>
          <div class="fs-grid"></div>
        </div>
        <Sfondo slot="backdrop" id={SFONDI[c.id]} forza="forte" />
        <p class="fs-panel-tag text-center mb-3" data-reveal>
          {nomeConfig(c.config).toUpperCase()} · CASO {String(i + 1).padStart(2, '0')}
        </p>
        <h2
          class="text-center text-[var(--ink-primary)] mb-4 font-[family-name:var(--font-display)]"
          style="font-size: clamp(1.6rem, 2.5vw, 2.2rem); font-weight: 600; line-height: 1.08; letter-spacing: -0.02em;"
          data-reveal data-reveal-delay="0.08"
        >
          {c.titolo}
        </h2>
        <p class="cs-caso-lead text-center fs-card-body max-w-3xl mx-auto mb-5" data-reveal data-reveal-delay="0.14">
          {lega(c.punto)}
        </p>
        {/* Oggi, quello che si sa, e la pagina che ne esce: il caso si capisce da qui. */}
        <div class="cx" data-reveal data-reveal-delay="0.2">
          <figure class="cx-col">
            <figcaption class="cx-k">Oggi</figcaption>
            <SchermoCaso caso={c} versione="oggi" />
            <p class="cx-cap">{lega(c.oggi)}</p>
          </figure>
          <div class="cx-mezzo" data-substep>
            <p class="cx-prof-k">Quello che si sa</p>
            <ul class="cx-prof">
              {c.profilo.map((a) => <li><span>{a.k}</span><b>{a.v}</b></li>)}
            </ul>
            <span class="cx-freccia" aria-hidden="true"></span>
          </div>
          <figure class="cx-col cx-col--con" data-substep>
            <figcaption class="cx-k cx-k--con">Con il caso</figcaption>
            <SchermoCaso caso={c} versione="con" />
            <p class="cx-cap">{lega(c.viaggiatore)}</p>
          </figure>
        </div>
        {/* Che cosa serve e su che cosa si giudica: prima stava in una slide a parte
            per ogni caso, cinque volte lo stesso schema. Il percorso del dato si
            mostra una volta, sul primo caso; gli altri stanno in appendice. */}
        <dl class="cs-fascia" data-reveal data-reveal-delay="0.28">
          <div><dt>Serve</dt><dd>{lega(serveA(c.config))}</dd></div>
          <div><dt>Si misura su</dt><dd>{lega(c.kpi.slice(0, 2).join(' · '))}</dd></div>
        </dl>
      </Slide>

      {/* ── Dietro le quinte: il dato, e che cosa muove il caso ───────────── */}
      {i === 0 && (
      <Slide id={`slide-dietro-${c.id}`} bg={i % 2 === 0 ? 'primary' : 'secondary'} align="center">
        <div slot="backdrop" class="absolute inset-0">
          <div class="fs-bg-soft"></div>
          <div class="fs-grid"></div>
        </div>
        <Sfondo slot="backdrop" id={SFONDI[c.id]} forza="forte" />
        <p class="fs-panel-tag text-center mb-3" data-reveal>
          CASO {String(i + 1).padStart(2, '0')} · IL PERCORSO DEL DATO
        </p>
        <h2
          class="text-center text-[var(--ink-primary)] mb-5 font-[family-name:var(--font-display)]"
          style="font-size: clamp(1.6rem, 2.5vw, 2.2rem); font-weight: 600; line-height: 1.08; letter-spacing: -0.02em;"
          data-reveal data-reveal-delay="0.08"
        >
          {c.titolo}
        </h2>
        <div class="w-full" data-reveal data-reveal-delay="0.14">
          <FlussoCaso caso={c} />
        </div>
        <p class="fs-panel-src text-center mt-4" data-reveal data-reveal-delay="0.3">
          Il percorso del dato è lo stesso negli altri quattro casi: sta nell’appendice per il team tecnico.
        </p>
      </Slide>
      )}
      </>
    ))}

    <!-- ── Che cosa viene dopo ────────────────────────────────────────── -->
    <Slide id="slide-scelta" bg="primary" align="center">
      <div slot="backdrop" class="absolute inset-0">
        <div class="fs-bg"></div>
        <div class="fs-grid"></div>
      </div>
      <Sfondo slot="backdrop" id="rl-binari" forza="forte" />
      <div class="w-full max-w-4xl mx-auto text-center flex flex-col items-center gap-7">
        <p class="fs-panel-tag" data-reveal>DA DOVE SI COMINCIA</p>
        <h2
          class="font-[family-name:var(--font-display)] text-[var(--color-chiaro)]"
          style="font-size: clamp(2rem, 3.8vw, 3.3rem); font-weight: 600; line-height: 1.06; letter-spacing: -0.025em; text-wrap: balance;"
          data-display data-reveal data-reveal-delay="0.1"
        >
          Il primo caso che proponiamo non aspetta la fase 0.
        </h2>
        <p class="fs-card-body max-w-2xl" style="text-wrap: balance;" data-reveal data-reveal-delay="0.2">
          {lega('La home per area si può provare con Target già oggi, e la fase 0 la rende più precisa. La scelta si conferma con l’analisi su Target in corso; metrica, effetto minimo e durata si fissano prima di partire.')}
        </p>
        <a href={href(base, next)} class="edf-sig-cta" data-reveal data-reveal-delay="0.3">La fase 0, da vicino →</a>
      </div>
    </Slide>

  </DeckContainer>
</BaseLayout>

<style is:global>
  /* La riga «Oggi»: il punto di partenza, in chiaro e non dietro un blocco.
     La pastiglia è un pseudo-elemento, così la riga resta UN solo elemento di
     testo e il check «testo su testo» non ha niente da misurare. */
  .cs-oggi {
    max-width: 48rem; margin: 0 auto 0.9rem; text-align: center;
    font-size: clamp(0.82rem, 0.9vw, 0.92rem); line-height: 1.5;
    color: var(--ink-tertiary);
  }
  .cs-oggi-k {
    font-size: 0.7rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--color-rosso-chiaro); margin-right: 0.4rem;
  }


  /* ── Il caso: oggi, quello che si sa, la pagina che ne esce ─────────── */
  .cx {
    width: 100%; max-width: 84rem; margin-inline: auto;
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(13rem, 0.62fr) minmax(0, 1fr);
    gap: clamp(0.9rem, 2vw, 2rem); align-items: start; text-align: left;
  }
  [data-slide] .cx p, [data-slide] .cx li, [data-slide] .cx span { text-align: left; max-width: none; margin: 0; }
  .cx-col { margin: 0; display: grid; gap: 0.6rem; min-width: 0; }
  /* Le code di frase sulle righe lunghe: si bilancia, non si lega (26 nov 2026). */
  [data-slide] .cs-caso-lead, [data-slide] .cx-cap { text-wrap: balance; }
  .cx-k {
    font-size: clamp(0.86rem, 0.92vw, 0.98rem); font-weight: 700; letter-spacing: 0.1em;
    text-transform: uppercase; color: var(--ink-tertiary);
  }
  .cx-k--con { color: var(--color-rosso-chiaro); }
  .cx-cap { font-size: clamp(1rem, 1.08vw, 1.16rem); line-height: 1.45; color: var(--ink-secondary); }
  .cx-col:not(.cx-col--con) .sc { filter: saturate(0.55); }
  .cx-mezzo {
    position: relative; align-self: center; display: grid; gap: 0.5rem;
    padding: 0.9rem 1rem; border-radius: 0.65rem;
    border: 1px solid rgba(79, 189, 180, 0.45); background: rgba(0, 102, 102, 0.22);
  }
  .cx-prof-k {
    font-size: clamp(0.86rem, 0.92vw, 0.98rem); font-weight: 700; letter-spacing: 0.1em;
    text-transform: uppercase; color: var(--color-verde-chiaro);
  }
  .cx-prof { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.45rem; }
  .cx-prof li { display: grid; gap: 0.05rem; }
  .cx-prof span { font-size: clamp(0.88rem, 0.92vw, 0.98rem); color: var(--ink-tertiary); }
  .cx-prof b { font-size: clamp(1.02rem, 1.1vw, 1.18rem); font-weight: 600; color: var(--ink-primary); }
  .cx-prof li { opacity: 0; transform: translateX(-8px); transition: opacity 360ms ease-out, transform 360ms ease-out; }
  .cx-mezzo[data-substep-active] li { opacity: 1; transform: none; }
  .cx-mezzo[data-substep-active] li:nth-child(2) { transition-delay: 0.16s; }
  .cx-mezzo[data-substep-active] li:nth-child(3) { transition-delay: 0.32s; }
  /* La freccia verso la pagina nuova: il verso del caso, senza una parola. */
  .cx-col--con { position: relative; }
  .cx-col--con::before {
    content: ''; position: absolute; left: calc(-1 * clamp(0.9rem, 2vw, 2rem)); top: 50%;
    width: calc(clamp(0.9rem, 2vw, 2rem) - 0.4rem); height: 2px; background: var(--color-verde-chiaro);
  }
  .cx-col--con::after {
    content: ''; position: absolute; left: -0.55rem; top: calc(50% - 0.3rem);
    border: 0.32rem solid transparent; border-left: 0.45rem solid var(--color-verde-chiaro); border-right: 0;
  }
  .cx-freccia { display: none; }
  .cx-freccia::after {
    content: ''; position: absolute; right: -0.1rem; top: -0.3rem;
    border: 0.32rem solid transparent; border-left: 0.45rem solid var(--color-verde-chiaro); border-right: 0;
  }
  .cx-col--con .sc { box-shadow: 0 20px 44px rgba(6, 10, 18, 0.5), 0 0 0 2px var(--color-rosso); }
  @media (prefers-reduced-motion: reduce) { .cx-prof li { opacity: 1; transform: none; transition: none; } }
  html:not(.js) .cx-prof li { opacity: 1; transform: none; }
  @media (max-width: 900px) {
    .cx { grid-template-columns: minmax(0, 1fr); }
    .cx-freccia { display: none; }
  }

  /* La legenda della matrice e la fascia sotto ogni caso. */
  .cs-leg { display: inline-flex; align-items: center; gap: 0.45rem; margin-inline: 0.7rem; }
  .cs-leg i { width: 0.8rem; height: 0.8rem; border-radius: 50%; background: rgba(255, 255, 255, 0.55); }
  .cs-leg .cs-leg-qui { background: var(--color-rosso); }
  .cs-fascia {
    width: 100%; max-width: 84rem; margin: clamp(0.8rem, 2vh, 1.3rem) auto 0;
    display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); gap: clamp(0.8rem, 1.6vw, 1.8rem); text-align: left;
  }
  .cs-fascia > div { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 0.2rem 0.8rem; align-items: baseline; padding-top: 0.7rem; border-top: 1px solid rgba(255, 255, 255, 0.28); }
  .cs-fascia dt { font-size: clamp(0.86rem, 0.92vw, 0.98rem); font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-secondary); }
  .cs-fascia dd { margin: 0; font-size: clamp(1rem, 1.06vw, 1.14rem); line-height: 1.38; color: var(--ink-primary); text-wrap: pretty; }
  @media (max-width: 900px) { .cs-fascia { grid-template-columns: minmax(0, 1fr); } }

  /* ── Le tre configurazioni ───────────────────────────────────────── */
  .cs-cfg--on { border-color: rgba(255, 141, 157, 0.6) !important; box-shadow: inset 0.28rem 0 0 var(--color-rosso); }
  [data-slide] .cs-cfg-k {
    margin: 0 0 0.4rem; font-size: clamp(0.8rem, 0.86vw, 0.92rem); font-weight: 700;
    letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-rosso-chiaro); text-align: left;
  }
  .cs-cfg-l { margin: 0; display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 0.45rem 0.9rem; }
  .cs-cfg-l dt { font-size: clamp(0.84rem, 0.9vw, 0.95rem); font-weight: 600; color: var(--ink-tertiary); }
  .cs-cfg-l dd { margin: 0; font-size: clamp(0.95rem, 1vw, 1.05rem); line-height: 1.4; color: var(--ink-primary); }

  /* ── Che cosa muove il caso, e la prova ─────────────────────────── */
  /* Due riquadri distinti, uno per domanda: il verde di marca dove si misura,
     il rosso dove si dimostra. Gli inchiostri sono le varianti chiare, le sole
     che reggono AA sul fondo scuro (le piene danno 2,35:1 e 3,14:1). */
  .cs-misura--dietro { margin-top: 2.6rem; }
  .cs-misura {
    width: 100%; max-width: 76rem; margin: 2.1rem auto 0;
    display: grid; grid-template-columns: minmax(0, 1.02fr) minmax(0, 1fr);
    gap: clamp(0.7rem, 1.6vw, 1.6rem);
    align-items: stretch;
  }
  [data-slide] .cs-misura p { text-align: left; max-width: none; margin-inline: 0; }
  .cs-box { border: 1px solid var(--line-subtle); border-radius: 0.6rem; padding: 0.85rem 1rem; }
  .cs-box--kpi { background: rgba(0, 102, 102, 0.18); border-color: rgba(79, 189, 180, 0.3); }
  .cs-box--prova { background: rgba(217, 24, 53, 0.12); border-color: rgba(255, 141, 157, 0.28); }
  .cs-box-tag {
    margin: 0 0 0.5rem; font-size: clamp(0.84rem, 0.92vw, 0.96rem); font-weight: 700;
    letter-spacing: 0.1em; text-transform: uppercase;
  }
  .cs-box--kpi .cs-box-tag { color: var(--color-verde-chiaro); }
  .cs-box--prova .cs-box-tag { color: var(--color-rosso-chiaro); }
  .cs-box-v {
    margin: 0; display: flex; align-items: baseline; flex-wrap: wrap; gap: 0.15rem 0.45rem;
    font-size: clamp(1rem, 1.14vw, 1.2rem); line-height: 1.5;
    color: var(--ink-secondary);
  }
  .cs-prova-v {
    font-family: var(--font-display); font-weight: 600;
    font-size: clamp(1.3rem, 1.8vw, 1.7rem); line-height: 1.08; letter-spacing: -0.02em;
    color: var(--ink-primary);
  }
  .cs-prova-s { color: var(--ink-tertiary); font-size: 0.78rem; }
  [data-slide] .cs-giu { display: grid; gap: 0.2rem; }
  .cs-giu-k { font-size: clamp(0.8rem, 0.86vw, 0.9rem); font-weight: 700; color: var(--color-rosso-chiaro); margin-top: 0.2rem; }
  /* Una fonte non è una CTA: eredita l'inchiostro e si distingue per la
     sottolineatura, che si accende d'accento al passaggio. */
  .cs-misura a {
    font-size: clamp(0.74rem, 0.82vw, 0.82rem); color: var(--ink-tertiary);
    text-decoration: underline; text-underline-offset: 0.18em;
  }
  .cs-misura a:hover { color: var(--accent-primary); }

  @media (max-width: 1300px) {
    .cs-misura { margin-top: 0.3rem; }
    .cs-box { padding: 0.4rem 0.55rem; display: flex; align-items: baseline; gap: 0.5rem; flex-wrap: wrap; }
    .cs-box-tag { margin: 0; flex: 0 0 auto; font-size: 0.68rem; }
    .cs-box-v { font-size: 0.8rem; line-height: 1.4; }
    .cs-prova-v { font-size: 1.15rem; }
    [data-slide] .cs-caso-lead { margin-bottom: 0.6rem !important; }
  }
  @media (max-width: 900px) {
    .cs-misura { grid-template-columns: minmax(0, 1fr); }
  }

  /* `!important` serve davvero: `CoverHero` scrive il colore nell'attributo
     `style` dell'occhiello, e un attributo in linea batte qualunque selettore.
     Senza, la regola si applica in silenzio a niente — e `audit:ink` continua
     a segnare 2,55:1 mentre il CSS sembra a posto. */
  #slide-cover [data-cover] p { text-wrap: balance; }
  #slide-cover [data-cover] > p:first-of-type { color: rgba(241, 243, 244, 0.94) !important; }
</style>
