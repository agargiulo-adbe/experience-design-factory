---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Sfondo from '../../components/Sfondo.astro';
import TreniNavigation from '../../components/TreniNavigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import CoverHero from '@edf/core/blocks/CoverHero.astro';
import DiagStrati from '../../components/diagrammi/DiagStrati.astro';
import { href } from '@edf/core/utils/url.js';
import { rotte } from '../../data/percorso';

const base = import.meta.env.BASE_URL;
// Avanti e indietro vengono dal percorso, non scritti a mano: così spegnere
// un capitolo non lascia una freccia che punta fuori dal percorso.
const { next, prev } = rotte('trenitalia/fondamenta');
const currentPath = Astro.url.pathname;

// La piattaforma vista di taglio, dal basso verso l'alto: prima i sistemi che
// girano già, in cima lo strato che manca. Lo stato di ciascun prodotto (attivo,
// parziale, da aggiungere) sta nella nota, dove si legge insieme al nome.
//
// Verificato su trenitalia.com il 9 ott 2026: AEM Sites «classico» (clientlibs,
// componenti core, /content/dam dietro CDN), non Edge Delivery; Adobe Target è
// distribuito su tutto il sito via integrazione AEM, non «solo in homepage» —
// al più sono le attività a concentrarsi lì. Il numero di siti e di istanze è
// informazione del cliente: sta fra le domande della prima sessione.
const strati = [
  { nome: 'Piattaforma di esecuzione email', nota: 'Attiva · CartaFreccia, X-GO, alta frequenza di invio — fuori dalla prima fase, fornitore da confermare con voi' },
  { nome: 'Salesforce CRM, Data Cloud, MuleSoft', nota: 'Foundation 2026 · il backbone operativo del Gruppo' },
  { nome: 'AEM Sites (as a Cloud Service)', nota: 'Attivo · trenitalia.com e le property di Gruppo' },
  // Il vincolo di tempo entra nella fotografia dell'ecosistema: strumentare un
  // funnel che sta per essere rifatto è lavoro che si butta.
  { nome: 'Piattaforma di vendita', nota: 'Fuori perimetro · in rifacimento dentro il piano, strumentarla adesso è lavoro che si butta' },
  { nome: 'Adobe Analytics', nota: 'Attivo · due istanze: nella prima fase entra quella di trenitalia.com, le Frecce dopo' },
  { nome: 'Adobe Target', nota: 'Implementato sul sito via integrazione AEM · copertura d\'uso da verificare' },
  { nome: 'Customer Journey Analytics', nota: 'Da aggiungere · nella prima fase legge trenitalia.com e il CRM', evidenza: true },
];

// Le cinque misure della prima sessione. Nessuna è nostra: stanno nei sistemi
// del cliente, e la colonna di destra dice la direzione senza portare un numero.
const misure = [
  {
    nome: 'Quota di prenotazioni da app',
    oggi: 'Sul totale dei canali diretti, mese per mese',
    direzione: 'Più prenotazioni che nascono e si chiudono in app',
  },
  {
    nome: 'Costo per contatto all\'assistenza',
    oggi: 'Contatti per mille transazioni, e quanto costa gestirli',
    direzione: 'Meno contatti a parità di viaggi venduti',
  },
  {
    nome: 'Tasso di consenso',
    oggi: 'Raccolto e revocato, per canale di raccolta',
    direzione: 'Più consenso raccolto, e meno revoche dopo una campagna',
  },
  {
    nome: 'Rinnovo degli abbonamenti',
    oggi: 'Alla scadenza e nei trenta giorni successivi',
    direzione: 'Più rinnovi prima della scadenza, meno recuperi dopo',
  },
  {
    nome: 'Quota di vendita diretta',
    oggi: 'Rispetto ai canali di terzi, per tipo di servizio',
    direzione: 'Più vendita diretta a parità di spesa in comunicazione',
  },
];
---
<BaseLayout
  title="Le fondamenta che ci sono già"
  description="AEM, Adobe Analytics, Target, la piattaforma email, Salesforce: fondamenta solide. CJA è il layer di intelligence che le completa."
  branch="trenitalia"
>
  <div class="fixed top-0 left-0 right-0 z-50">
    <TreniNavigation currentPath={currentPath} base={base} branch="trenitalia" />
  </div>

  <DeckContainer wallScale
    nextHref={href(base, next)}
    prevHref={href(base, prev)}
  >

    <!-- ── SLIDE 0: Cover ─────────────────────────────────────────── -->
    <Slide id="slide-cover" bg="primary" align="center">
      <div slot="backdrop" class="fs-bg"></div>
      <Sfondo slot="backdrop" id="rl-pensilina" forza="leggera" />
      <div slot="backdrop" class="fs-grid"></div>
      <CoverHero
        eyebrow="Capitolo 02 · Fondamenta"
        numeral="02"
        title="Le fondamenta che avete già"
        lead="Ciò che funziona resta al suo posto. Il lavoro è collegare i sistemi che avete già e aggiungere lo strato di intelligence che oggi manca."
        size="phase"
        tone="ink"
        signature={false}
      />
    </Slide>

    <!-- ── SLIDE 1: Ecosistema a strati (righe full-width impilate) ── -->
    <Slide id="slide-ecosystem" bg="primary" align="center">
      <div slot="backdrop" class="fs-bg-soft"></div>
      <Sfondo slot="backdrop" id="tc-strati" forza="media" />
      <div slot="backdrop" class="fs-grid"></div>

      <div class="w-full max-w-6xl mx-auto">
        <div class="text-center mb-6">
          <p class="fs-panel-tag inline-block" data-reveal>
            L'ECOSISTEMA ATTUALE · CJA SI AGGIUNGE SOPRA
          </p>
          <h2
            class="text-[var(--ink-primary)] mt-3 font-[family-name:var(--font-display)]"
            style="font-size: clamp(1.6rem, 2.3vw, 2.1rem); font-weight: 600; line-height: 1.06; letter-spacing: -0.02em;"
            data-reveal
            data-reveal-delay="0.08"
          >
            Tanti sistemi, un solo strato da aggiungere.
          </h2>
        </div>

        {/* strati: la piattaforma email, campione di luglio 2026 · AEM fonte
            osservazione pubblica · Salesforce v. slide successiva. Impilati, si
            vede che CJA sta sopra e che sotto non si tocca niente. */}
        <div class="w-full max-w-5xl mx-auto" data-reveal data-reveal-delay="0.16">
          <DiagStrati strati={strati} />
        </div>

        {/* Una riga sola, perché la slide è già alta: la conseguenza del vincolo
            che la fotografia qui sopra adesso dichiara. Il dettaglio sta nella
            slide del POC e nella Fase 1 del capitolo «Il percorso». */}
        <p
          class="mx-auto mt-4 text-center text-[var(--color-grigio-300)]"
          style="font-size: 0.85rem; line-height: 1.5; max-width: 64rem;"
          data-reveal
          data-reveal-delay="0.26"
        >
          Il rifacimento della piattaforma di vendita è un vincolo di tempo: la prima fase parte dai pezzi stabili, cioè il sito autenticato e le letture del CRM.
        </p>
      </div>
    </Slide>

    <!-- ── SLIDE 1b: Cosa misuriamo ───────────────────────────────── -->
    <Slide id="slide-misure" bg="secondary" align="center">
      <div slot="backdrop" class="fs-bg-soft"></div>
      <Sfondo slot="backdrop" id="tc-quiete" forza="media" />
      <div slot="backdrop" class="fs-grid"></div>

      <p class="fs-panel-tag text-center mb-3" data-reveal>
        COSA MISURIAMO · PRIMA DI PROMETTERE QUALSIASI COSA
      </p>
      <h2
        class="text-center text-[var(--ink-primary)] mb-5 font-[family-name:var(--font-display)]"
        style="font-size: clamp(1.55rem, 2.4vw, 2.2rem); font-weight: 600; line-height: 1.06; letter-spacing: -0.02em;"
        data-reveal
        data-reveal-delay="0.08"
      >
        Cinque numeri, da leggere insieme.
      </h2>

      <div class="w-full max-w-6xl mx-auto flex flex-col gap-2.5" data-reveal data-reveal-delay="0.2">
        {/* Le intestazioni stanno sulla stessa ascissa delle celle: stesso
            padding orizzontale del pannello, e a bandiera come il contenuto. */}
        <div class="grid md:grid-cols-[13rem_1fr_1fr] gap-x-6 text-left" style="padding-left: 1.75rem; padding-right: 1.75rem;">
          <span class="fs-panel-tag">LA MISURA</span>
          <span class="fs-panel-tag">OGGI, DA LEGGERE INSIEME</span>
          <span class="fs-panel-tag" style="color: rgba(var(--sig2-rgb), 0.98);">COSA VORREMMO VEDERE</span>
        </div>
        {misure.map((m) => (
          <div class="fs-panel text-left grid md:grid-cols-[13rem_1fr_1fr] gap-x-6 gap-y-1.5 items-baseline" style="padding-top: 0.8rem; padding-bottom: 0.8rem;">
            <p class="fs-card-title" style="font-size: 1.02rem; margin-inline: 0;">{m.nome}</p>
            <p class="fs-card-body" style="margin-inline: 0;">{m.oggi}</p>
            <p class="fs-card-body" style="margin-inline: 0; color: rgba(241, 243, 244, 0.95);">{m.direzione}</p>
          </div>
        ))}
      </div>

      <p class="mx-auto mt-4 text-center text-[var(--color-grigio-300)]" style="font-size: 0.85rem; line-height: 1.5; max-width: 64rem;" data-reveal data-reveal-delay="0.32">
        Nessuno di questi numeri è nostro: baseline da rilevare nel POC, target da fissare insieme.
      </p>
    </Slide>

    <!-- ── SLIDE 2: Salesforce Foundation — il nuovo backbone ─────── -->
    <Slide id="slide-salesforce" bg="secondary" align="center">
      <Sfondo slot="backdrop" id="tc-acciaio" forza="forte" />
      <div slot="backdrop" class="fs-bg-soft"></div>

      <div class="w-full max-w-6xl mx-auto">
        <div class="fs-panel fs-panel--alt mb-5" data-reveal>
          <p class="fs-panel-tag">FS TECHNOLOGY + SALESFORCE · Q1 2026</p>
          <h2 class="fs-panel-head mt-1 mb-3" style="font-size: clamp(1.5rem, 2.3vw, 2.1rem);">
            La foundation agentica è partita.<br/>Adobe si collega a quella base.
          </h2>
          <p class="fs-panel-body max-w-4xl" style="font-size: clamp(0.98rem, 1.1vw, 1.08rem); line-height: 1.62;">
            A marzo 2026 FSTechnology ha lanciato con Salesforce una piattaforma agentica che unisce
            Trenitalia, Busitalia, FS Park e FS Logistix in un unico backbone CRM, con MuleSoft come
            integration engine e Data Cloud come layer dati. Il confine è scritto una volta e vale
            per tutto il percorso: <strong class="text-[var(--ink-primary)]">Salesforce Data Cloud resta
            master del dato CRM e del consenso; Adobe lavora sul profilo di esperienza e non duplica
            il profilo operativo.</strong>
          </p>
        </div>

        <div
          class="grid md:grid-cols-3 gap-4 mb-4"
          data-reveal
          data-reveal-delay="0.14"
        >
          {[
            {
              n: '01',
              prodotto: 'Salesforce CRM',
              ruolo: 'Backbone operativo',
              adobe: 'CJA porta gli attributi che servono all\'analisi accanto al comportamento sul sito',
            },
            {
              n: '02',
              prodotto: 'MuleSoft',
              ruolo: 'Integration engine',
              adobe: 'Già in campo: alimenta AEP e CJA senza aggiungere infrastruttura',
            },
            {
              n: '03',
              prodotto: 'Salesforce Data Cloud',
              ruolo: 'Master del profilo e del consenso',
              adobe: 'CJA legge le letture che servono all\'analisi; il profilo operativo e le liste di soppressione restano qui',
            },
          ].map((item) => (
            <div class="fs-card flex flex-col">
              <div class="flex items-center gap-3 mb-2">
                <span class="fs-mark" aria-hidden="true">{item.n}</span>
                <div>
                  <p class="fs-card-title" style="font-size: 1.1rem;">{item.prodotto}</p>
                  <p class="text-[0.78rem] text-[var(--accent-secondary)] font-semibold uppercase tracking-wide">{item.ruolo}</p>
                </div>
              </div>
              <p class="fs-card-body" style="font-size: 0.95rem;">
                <strong class="text-[var(--accent-secondary)]">Adobe:</strong> {item.adobe}
              </p>
            </div>
          ))}
        </div>

        <p class="fs-panel-src text-center" data-reveal data-reveal-delay="0.24">
          Fonte:&nbsp;
          <a href="https://www.fsnews.it/it/focus-on/innovazione/2026/3/5/fs-technology-salesforce-foundation-digitale.html" target="_blank" rel="noopener noreferrer" class="underline underline-offset-2 hover:opacity-80">
            fsnews.it — FSTechnology + Salesforce Foundation Digitale (mar 2026)
          </a>
        </p>
      </div>
    </Slide>

    <!-- ── SLIDE 3: La scelta · non disruption, connessione ──────── -->
    <Slide id="slide-choice" bg="brand" align="center">
      <Sfondo slot="backdrop" id="rl-alba" forza="media" marca />
      <div class="w-full max-w-3xl mx-auto text-left">
        <p class="slide-eyebrow text-[var(--color-chiaro)]/70 mb-8" data-reveal>
          IL PRINCIPIO GUIDA
        </p>
        <div class="fs-quote" data-reveal data-reveal-delay="0.08">
          <h2
            class="fs-quote-text text-[var(--color-chiaro)] font-[family-name:var(--font-display)]"
            style="font-size: clamp(2.5rem, 5vw, 4.5rem); font-weight: 700; line-height: 1.0; letter-spacing: -0.03em;"
          >
            Non si sostituisce:<br/>si connette.
          </h2>
        </div>
        <p
          class="text-[var(--color-chiaro)]/85 leading-relaxed max-w-2xl mt-6 mb-10"
          style="font-size: clamp(1.1rem, 1.5vw, 1.4rem);"
          data-reveal
          data-reveal-delay="0.16"
        >
          la piattaforma di esecuzione email continua a eseguire le campagne, Salesforce a gestire i profili,
          AEM a consegnare i contenuti. CJA si appoggia sopra e li legge tutti, restituendo una
          vista del journey che nessuno dei tre, da solo, è in grado di dare.
        </p>

        <div
          class="flex flex-col sm:flex-row gap-4 max-w-2xl"
          data-reveal
          data-reveal-delay="0.24"
        >
          <a
            href={href(base, next)}
            class="flex-1 inline-flex items-center justify-center gap-3 px-8 py-4 text-base font-semibold tracking-wide bg-[var(--color-chiaro)] text-[var(--color-ardesia-notte)] hover:bg-white transition-colors duration-300 font-[family-name:var(--font-display)]"
          >
            CJA: il layer di convergenza
            <svg width="18" height="18" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        </div>
      </div>
    </Slide>

  </DeckContainer>
</BaseLayout>
