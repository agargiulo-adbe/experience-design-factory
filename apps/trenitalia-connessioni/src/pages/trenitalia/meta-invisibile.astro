---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Sfondo from '../../components/Sfondo.astro';
import TreniNavigation from '../../components/TreniNavigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import CoverHero from '@edf/core/blocks/CoverHero.astro';
import MediaDemoSlot from '@edf/core/blocks/immersive/MediaDemoSlot.astro';
import DiagIncrocio from '../../components/diagrammi/DiagIncrocio.astro';
import { href } from '@edf/core/utils/url.js';

const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;
---
<BaseLayout
  title="La metà invisibile · Ramo Trenitalia"
  description="Trenitalia guarda oltre la stazione: use case di cross-sell e Real-Time CDP Collaboration con FS Park, orchestrati da Adobe CJA e Adobe Real-Time CDP Collaboration."
  pageSolutions={['data-collab']}
  branch="trenitalia"
>
  <div class="fixed top-0 left-0 right-0 z-50">
    <TreniNavigation currentPath={currentPath} base={base} branch="trenitalia" />
  </div>

  <DeckContainer wallScale
    nextHref={href(base, '/trenitalia/percorso')}
    prevHref={href(base, '/trenitalia/convergenza')}
  >

    <!-- ── SLIDE 0: Cover — La metà invisibile ─────────────────────── -->
    <Slide id="slide-cover" bg="primary" align="center" data-solution="data-collab">
      <div slot="backdrop" class="fs-bg"></div>
      <Sfondo slot="backdrop" id="rl-pensilina" forza="leggera" />
      <div slot="backdrop" class="fs-grid"></div>
      <CoverHero
        eyebrow="Fuori percorso · Metà invisibile"
        numeral=""
        title="La metà invisibile"
        lead="Il viaggio di Davide non comincia al binario. C'è una metà che Trenitalia oggi non vede: l'arrivo, la sosta, il tempo prima della partenza. Real-Time CDP Collaboration la rende leggibile senza scambiare dati in chiaro."
        size="phase"
        tone="ink"
        signature={false}
      />
    </Slide>

    <!-- ── SLIDE 1: Il gap di oggi ────────────────────────────────── -->
    <Slide id="slide-gap" bg="primary" align="center" data-solution="data-collab">
      <div slot="backdrop" class="fs-bg"></div>
      <div slot="backdrop" class="fs-grid"></div>
      <Sfondo slot="backdrop" id="rl-banchina" forza="forte" />
      <p class="slide-eyebrow text-center text-[var(--accent-primary)] mb-4" data-reveal>
        IL GAP ATTUALE
      </p>
      <h2
        class="text-center text-[var(--ink-primary)] mb-4 font-[family-name:var(--font-display)]"
        style="font-size: clamp(1.6rem, 2.5vw, 2.2rem); font-weight: 600; line-height: 1.05; letter-spacing: -0.02em;"
        data-reveal
        data-reveal-delay="0.08"
      >
        Sistemi che non si parlano, occasioni che si perdono.
      </h2>
      <p
        class="text-center text-[var(--ink-secondary)] leading-snug max-w-3xl mx-auto mb-7"
        style="font-size: clamp(0.95rem, 1.15vw, 1.1rem);"
        data-reveal
        data-reveal-delay="0.13"
      >
        Ogni sistema conosce solo la propria fetta di cliente. Nello spazio fra quello che
        Trenitalia sa e quello che non vede stanno le occasioni che oggi si perdono.
      </p>

      {/* Due nodi sulla linea del segnale: gli attori sono le due società, e
          sono due perché due sono i titolari del trattamento. La piattaforma di
          esecuzione email stava qui come terzo attore, e un lettore interno ne
          concludeva che il CRM è un terzo titolare: è scesa fra gli esecutori. */}
      <div class="relative w-full max-w-5xl mx-auto" data-reveal data-reveal-delay="0.18">
        <span class="fs-line-h hidden md:block" style="top: 1.45rem; left: 25%; right: 25%;" aria-hidden="true"></span>
        <div class="grid md:grid-cols-2 gap-5 relative">
          {[
            {
              brand: 'FS Park',
              rosso: false,
              sa: 'Chi ha prenotato · quando · dove · durata sosta',
              nonSa: 'Se ha viaggiato in Frecce · se ha abbonamento · se è CartaFreccia',
              gap: 'Nessun pacchetto: il parcheggio resta commodity.',
            },
            {
              brand: 'Trenitalia',
              rosso: true,
              sa: 'Storico biglietti · classe · frequenza · canale',
              nonSa: 'Se ha usato FS Park · se ha cercato parcheggio · dove arriva',
              gap: 'Il pacchetto viaggio-parcheggio non si vede: ricavo accessorio perso.',
            },
          ].map((item, i) => (
            <div class="flex flex-col items-center">
              <span class:list={["fs-node mb-4 relative z-10", item.rosso && "fs-node--alt"]} aria-hidden="true">
                {String(i + 1).padStart(2, "0")}
              </span>
              <div class="fs-card w-full text-left flex flex-col gap-2.5">
                <p class="fs-card-title mb-0.5">{item.brand}</p>
                <p class="fs-card-body">
                  <span class="font-bold tracking-wider uppercase text-emerald-400 text-[0.76rem]">SA · </span>{item.sa}
                </p>
                <p class="fs-card-body">
                  <span class="font-bold tracking-wider uppercase text-[var(--accent-primary)] text-[0.76rem]">NON SA · </span>{item.nonSa}
                </p>
                <p class="text-[0.92rem] text-[var(--color-grigio-300)] italic leading-snug pt-3 mt-auto border-t border-[var(--line-subtle)]">{item.gap}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <div class="w-full max-w-5xl mx-auto mt-5 fs-panel text-left !py-3.5" data-reveal data-reveal-delay="0.3">
        <p class="fs-panel-body" style="margin-inline: 0;">
          <strong class="text-[var(--ink-primary)]">Fra gli esecutori, non fra i titolari:</strong> la
          piattaforma di esecuzione email manda le campagne, e di suo conosce aperture, click e device.
          Il contesto del momento, cioè se una prenotazione è appena stata fatta o un abbonamento sta
          scadendo, oggi non arriva fino a lì.
        </p>
      </div>
    </Slide>

    <!-- ── SLIDE 1b: Perché serve Real-Time CDP Collaboration ─────────────── -->
    <Slide id="slide-why-collab" bg="secondary" align="center" data-solution="data-collab">
      <div slot="backdrop" class="fs-bg-soft"></div>
      <Sfondo slot="backdrop" id="tc-strati" forza="forte" />
      <div slot="backdrop" class="fs-grid"></div>
      <p class="slide-eyebrow text-center text-[var(--accent-secondary)] mb-4" data-reveal>
        LA CLEAN ROOM · ANCHE DENTRO IL GRUPPO FS
      </p>
      <h2
        class="text-center text-[var(--ink-primary)] mb-5 font-[family-name:var(--font-display)]"
        style="font-size: clamp(1.7rem, 2.9vw, 2.6rem); font-weight: 600; line-height: 1.05; letter-spacing: -0.02em;"
        data-reveal
        data-reveal-delay="0.08"
      >
        Stesso Gruppo, entità legali distinte.<br/>Serve una clean room.
      </h2>

      {/* Due insiemi che condividono soltanto l'intersezione: disegnata così, la
          domanda «ma allora vi passate i dati?» non nasce nemmeno. Prima erano
          tre nodi fatti a mano più due pannelli che si ripetevano. */}
      <div class="w-full max-w-5xl mx-auto" data-reveal data-reveal-delay="0.16">
        {/* Note cortissime per forza: il cerchio centrale copre la metà interna
            dei due laterali, e una riga oltre gli 8rem ci finisce sotto. Quello
            che ciascuna società sa per esteso sta nella slide precedente. */}
        <DiagIncrocio
          sinistra={{ nome: 'FS Park', nota: 'la sosta' }}
          destra={{ nome: 'Trenitalia', nota: 'il viaggio' }}
          centro="chi fa entrambe le cose"
          vincolo="Sono due entità giuridiche distinte: per condividere dati personali identificativi servono una base giuridica, un accordo di condivisione fra i due titolari e la minimizzazione. Nessun profilo esce da una parte né dall'altra: si incrociano le audience, non gli archivi."
        />
      </div>

      <div class="fs-panel fs-panel--alt w-full max-w-5xl mx-auto text-left mt-5" data-reveal data-reveal-delay="0.26">
        <p class="fs-panel-body">
          CJA legge i comportamenti aggregati di entrambe, ma <strong class="text-[var(--ink-primary)]">per attivare
          una campagna sui dati personali serve la clean room</strong>: Adobe Real-Time CDP Collaboration fa incontrare le
          audience senza dati in chiaro, e misura l'attribuzione.
        </p>
      </div>
    </Slide>

    <!-- ── SLIDE 2: Use Cases ─────────────────────────────────────── -->
    <Slide id="slide-usecases" bg="secondary" align="center" data-solution="data-collab">
      <div slot="backdrop" class="fs-bg-soft"></div>
      <Sfondo slot="backdrop" id="rl-quiete" forza="forte" />
      <div slot="backdrop" class="fs-grid"></div>
      <p class="slide-eyebrow text-center text-[var(--accent-secondary)] mb-4" data-reveal>
        TRE USE CASE · IMPATTO DA VALIDARE
      </p>
      <h2
        class="text-center text-[var(--ink-primary)] mb-6 font-[family-name:var(--font-display)]"
        style="font-size: clamp(1.55rem, 2.5vw, 2rem); line-height: 1.05;"
        data-reveal
        data-reveal-delay="0.08"
      >
        Dalla lettura del journey a tre azioni concrete.
      </h2>

      {/* Three use-cases threaded on one vertical rail — each is a station on the
          same line, tagged, recapped, with its measurable impact called out. */}
      <div
        class="relative w-full max-w-6xl mx-auto flex flex-col gap-4"
        data-reveal
        data-reveal-delay="0.18"
      >
        {[
          {
            id: 'uc1',
            tag: 'Use Case 01 · Rinnovo',
            title: 'Il rinnovo che si anticipa',
            recap: 'Viaggi in calo nelle settimane prima della scadenza: CJA coglie l\'anomalia in anticipo. La piattaforma di esecuzione email e AJO attivano il rinnovo puntuale.',
            impatto: 'Churn intercettato prima della scadenza',
          },
          {
            id: 'uc2',
            tag: 'Use Case 02 · Cross-sell',
            title: 'Il parcheggio come cross-sell',
            recap: 'Chi parcheggia da FS Park e viaggia in Frecce esiste già nei dati di entrambe, ma le due società non lo sanno. La clean room fa incontrare le audience: bundle parcheggio + biglietto.',
            impatto: 'Ricavo accessorio per viaggio, oggi non colto',
          },
          {
            id: 'uc3',
            tag: 'Use Case 03 · Loyalty',
            title: 'Dalla tratta alla relazione',
            recap: 'Business 3×/mese senza loyalty card: CJA la legge come "alto LTV latente". CJA individua i candidati; l’offerta di iscrizione resta una decisione del programma.',
            impatto: 'Clienti alto-valore diventano loyalty member',
          },
        ].map((uc, i) => (
          <div class:list={["fs-panel text-left", uc.id === "uc1" && "fs-panel--alt"]}>
            <div class="flex items-center gap-8">
              <div class="flex-shrink-0 w-[17rem] flex items-start gap-4">
                <span class:list={["fs-node flex-shrink-0", uc.id === "uc1" && "fs-node--alt"]} data-active aria-hidden="true">
                  {String(i + 1).padStart(2, "0")}
                </span>
                <div>
                  <p class="fs-panel-tag mb-1">{uc.tag}</p>
                  <h3 class="text-[1.15rem] font-bold text-[var(--ink-primary)] font-[family-name:var(--font-display)] leading-snug">{uc.title}</h3>
                </div>
              </div>
              <div class="flex-1 grid md:grid-cols-[2.2fr_1fr] gap-x-8 items-center">
                <p class="fs-panel-body">{uc.recap}</p>
                <div>
                  <p class="fs-panel-tag mb-1">Impatto</p>
                  <p class="fs-panel-figure" style="font-size: 1.15rem;">{uc.impatto}</p>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
      <p class="mt-5 text-center fs-panel-src tracking-widest uppercase" data-reveal data-reveal-delay="0.28">
        Scenari illustrativi · impatti da validare sul campo
      </p>
    </Slide>

    <!-- ── SLIDE 3: Real-Time CDP Collaboration — come funziona ────────────── -->
    <Slide id="slide-data-collab" bg="primary" align="left" data-solution="data-collab">
      <div slot="backdrop" class="fs-bg"></div>
      <Sfondo slot="backdrop" id="tc-acciaio" forza="forte" />
      <div slot="backdrop" class="fs-grid"></div>
      <div data-demo-flex class="w-full flex items-start gap-8">
        <div class="flex-1 min-w-0 flex flex-col text-left">
          <p class="slide-eyebrow text-[var(--accent-secondary)] mb-4" data-reveal>
            ADOBE REAL-TIME CDP COLLABORATION
          </p>
          <h2
            class="text-[var(--ink-primary)] mb-4 font-[family-name:var(--font-display)]"
            style="font-size: clamp(1.5rem, 2.4vw, 2.1rem); font-weight: 600; line-height: 1.05; letter-spacing: -0.02em;"
            data-reveal
            data-reveal-delay="0.08"
          >
            Nessun dato in chiaro, e un ricavo in più.
          </h2>
          <p
            class="text-[var(--color-grigio-200)] leading-snug mb-6"
            style="font-size: clamp(0.9rem, 1.05vw, 1rem);"
            data-reveal
            data-reveal-delay="0.14"
          >
            Adobe Real-Time CDP Collaboration crea una clean room tra FS Park e Trenitalia: collaborano
            sull'overlap dei clienti senza mai scambiarsi dati in chiaro. L'incrocio resta conforme al GDPR e la campagna si misura.
          </p>

          {/* Four sequential nodes on a single connected rail: hash → overlap →
              activate → attribute. The line runs left of the nodes, top to bottom. */}
          <div class="relative flex flex-col gap-4 pl-1" data-reveal data-reveal-delay="0.2">
            <span
              class="absolute w-[2px] left-[calc(1.45rem-1px)] top-6 bottom-6"
              style="background: linear-gradient(180deg, rgba(var(--sig-rgb), 0) 0%, rgba(var(--sig-rgb), 0.9) 12%, rgba(var(--sig-rgb), 0.9) 88%, rgba(var(--sig-rgb), 0) 100%); box-shadow: 0 0 10px rgba(var(--sig-rgb), 0.45);"
              aria-hidden="true"
            ></span>
            {[
              {
                step: '01',
                label: 'Hashing & Match',
                desc: 'Entrambe portano i segmenti come hash pseudonimi, mai dati in chiaro.',
              },
              {
                step: '02',
                label: 'Clean Room Overlap',
                desc: 'Si calcola l\'overlap: quanti clienti FS Park hanno viaggiato in Frecce.',
              },
              {
                step: '03',
                label: 'Attivazione',
                desc: 'Nessun dato personale passa fra le due società; l\'attivazione avviene sulle destinazioni di una sola di esse, in export batch, e richiede Real-Time CDP, cioè la fase successiva.',
              },
              {
                step: '04',
                label: 'Misurazione condivisa',
                desc: 'Sovrapposizione, insight di audience e report di campagna concordati fra le due società. Alcune automazioni di misura non sono nella prima release.',
              },
            ].map((s) => (
              <div class="relative flex gap-4 items-start">
                <span class="fs-node flex-shrink-0 relative z-10" style="width: 2.9rem; height: 2.9rem; font-size: 0.95rem;" aria-hidden="true">
                  {s.step}
                </span>
                <div class="flex-1 min-w-0 pt-1">
                  <p class="text-[1.1rem] font-semibold text-[var(--ink-primary)] font-[family-name:var(--font-display)] mb-0.5 leading-tight">{s.label}</p>
                  <p class="text-[0.96rem] text-[var(--color-grigio-200)] leading-snug">{s.desc}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
        <MediaDemoSlot id="data-collab-demo" label="Adobe Real-Time CDP Collaboration — Clean Room FS" />
      </div>
    </Slide>

    <!-- ── SLIDE 4: AEP Data Governance & Security ────────────────── -->
    <Slide id="slide-governance" bg="secondary" align="center" data-solution="data-collab">
      <div slot="backdrop" class="fs-bg-soft"></div>
      <Sfondo slot="backdrop" id="tc-quiete" forza="media" />
      <div slot="backdrop" class="fs-grid"></div>
      <p class="slide-eyebrow text-center text-[var(--accent-secondary)] mb-4" data-reveal>
        AEP · DATA GOVERNANCE & SECURITY
      </p>
      <h2
        class="text-[var(--ink-primary)] mb-4 font-[family-name:var(--font-display)]"
        style="font-size: clamp(1.5rem, 2.4vw, 2.1rem); font-weight: 600; line-height: 1.05; letter-spacing: -0.02em;"
        data-reveal
        data-reveal-delay="0.08"
      >
        Una governance sola sopra i sistemi che restano.
      </h2>
      <p
        class="text-center text-[var(--ink-secondary)] leading-snug max-w-4xl mx-auto mb-6"
        style="font-size: clamp(0.92rem, 1.05vw, 1rem);"
        data-reveal
        data-reveal-delay="0.14"
      >
        I dati personali vivono su più sistemi, e nessuno viene sostituito. Adobe Experience
        Platform aggiunge un perimetro governato sopra quelli che restano.
      </p>

      {/* I quattro controlli del perimetro governato. Griglia 2×2 a blocchi
          pari: su quattro colonne la riga più lunga usciva a quindici caratteri
          per riga, e il meccanismo non si poteva più descrivere per quello che è.
          Due meccanismi erano descritti sbagliati: le data usage label
          classificano dataset e campi, non cifrano e non «proteggono il PII
          all'origine»; e AEP non pseudonimizza da sola all'ingestione —
          l'hashing si fa a monte o in Data Prep. */}
      <div
        class="w-full max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-2 auto-rows-fr gap-4 mb-4"
        data-reveal
        data-reveal-delay="0.2"
      >
        {[
          { n: '01', label: 'Etichette di sensibilità', desc: 'Ogni campo classificato: le attivazioni fuori policy si bloccano da sole.' },
          { n: '02', label: 'Policy d\'uso', desc: 'Le regole stanno sul dataset, non nella testa di chi lo usa.' },
          { n: '03', label: 'Audit trail completo', desc: 'Log di ogni accesso: chi tocca cosa, e quando.' },
          { n: '04', label: 'Identificativi su hash', desc: 'Hashing a monte dell\'ingestione, policy in AEP: una scelta di implementazione, non un interruttore.' },
        ].map((p) => (
          <div class="fs-card text-left h-full flex flex-col gap-2 md:flex-row md:items-start md:gap-4">
            <span class="fs-mark flex-shrink-0" aria-hidden="true">{p.n}</span>
            <div class="min-w-0">
              <p class="fs-card-title mb-1" style="margin-inline: 0;">{p.label}</p>
              <p class="fs-card-body" style="margin-inline: 0;">{p.desc}</p>
            </div>
          </div>
        ))}
      </div>

      <div
        class="fs-panel fs-panel--alt max-w-5xl mx-auto flex items-start gap-4 text-left"
        data-reveal
        data-reveal-delay="0.3"
      >
        <svg class="flex-shrink-0 mt-0.5" width="24" height="24" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M10 2l6.5 3v5c0 4-2.8 6.7-6.5 8-3.7-1.3-6.5-4-6.5-8V5L10 2z" stroke="rgba(var(--sig2-rgb), 0.95)" stroke-width="1.4" stroke-linejoin="round"/>
        </svg>
        <p class="fs-panel-body">
          <strong class="text-[var(--ink-primary)]">Perché conta oggi:</strong> ogni nuovo
          collegamento allarga la superficie da proteggere. La governance è un requisito della
          prima fase, e si verifica con il DPO di ciascuna società prima che un dato si muova.
        </p>
      </div>
    </Slide>

    <!-- ── SLIDE 5: Il valore end-to-end ─────────────────────────── -->
    <Slide id="slide-value" bg="brand" align="center" data-solution="data-collab">
      <Sfondo slot="backdrop" id="tc-quiete" forza="forte" marca />
      <div slot="backdrop" class="fs-grid" style="opacity: 0.28;"></div>
      <p class="slide-eyebrow text-center text-[var(--color-chiaro)]/75 mb-4" data-reveal>
        IL VALORE COMPLESSIVO
      </p>
      <h2
        class="font-[family-name:var(--font-display)] text-[var(--color-chiaro)] mb-4"
        style="font-size: clamp(1.6rem, 2.6vw, 2.2rem); font-weight: 600; line-height: 1.05; letter-spacing: -0.02em;"
        data-reveal
        data-reveal-delay="0.08"
      >
        Ogni viaggio e ogni parcheggio, dentro un'unica relazione.
      </h2>
      <p
        class="text-[var(--color-chiaro)]/85 leading-snug max-w-2xl mx-auto mb-4"
        style="font-size: clamp(0.92rem, 1.1vw, 1.05rem);"
        data-reveal
        data-reveal-delay="0.15"
      >
        CJA e Real-Time CDP Collaboration leggono ogni contatto come un segnale e lo traducono in un'azione
        pertinente, al posto degli invii a calendario su dati che restano separati.
      </p>

      {/* Four terminal stations on the rosso ground — the end-to-end payoff, each
          station a measured outcome. Ghiaccio ink on rosso for AA contrast. */}
      <div class="relative w-full max-w-4xl mx-auto mb-6" data-reveal data-reveal-delay="0.22">
        <span class="hidden md:block absolute top-0 left-[10%] right-[10%] h-[2px]" style="background: linear-gradient(90deg, rgba(241, 243, 244, 0) 0%, rgba(241, 243, 244, 0.55) 12%, rgba(241, 243, 244, 0.55) 88%, rgba(241, 243, 244, 0) 100%);" aria-hidden="true"></span>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-3.5 md:pt-6">
          {[
            { value: 'LTV ↑', label: 'Valore del cliente cross-brand', sub: 'Relazione più lunga e più ricca, da misurare sul campo' },
            { value: 'CAC ↓', label: 'Costo di acquisizione abbonamento', sub: 'Early-trigger al posto del batch, da misurare' },
            { value: '€/viaggio', label: 'Ricavo accessorio da bundle', sub: 'Parcheggio e servizi correlati, da misurare' },
            { value: 'In chiaro: zero', label: 'Dati in chiaro scambiati fra le due società', sub: 'Identificativi pseudonimizzati, dentro i consensi raccolti. La conformità la valuta il DPO di ciascuna società' },
          ].map((m) => (
            <div class="relative text-center px-3 py-4 bg-[var(--color-chiaro)]/10 border border-[var(--color-chiaro)]/25 rounded-sm">
              <span class="hidden md:block absolute -top-[calc(1.5rem+5px)] left-1/2 -translate-x-1/2 w-2.5 h-2.5 rounded-full bg-[var(--color-chiaro)]" style="box-shadow: 0 0 10px rgba(241, 243, 244, 0.7);" aria-hidden="true"></span>
              <p
                class="font-[family-name:var(--font-display)] font-bold text-[var(--color-chiaro)] leading-tight mb-1.5 break-words"
                style="font-size: clamp(1.6rem, 2.4vw, 2.2rem);"
              >
                {m.value}
              </p>
              <p class="text-[0.98rem] font-medium text-[var(--color-chiaro)]/90 mb-1 leading-snug break-words">{m.label}</p>
              {/* La cautela sul trattamento è la riga che il DPO cerca per prima:
                  a 0.78rem sbiadita al 70% in proiezione non si leggeva. */}
              <p class="text-[0.84rem] text-[var(--color-chiaro)]/90" style="line-height: 1.5;">{m.sub}</p>
            </div>
          ))}
        </div>
      </div>

      <a
        href={href(base, '/trenitalia/percorso')}
        class="inline-flex items-center gap-3 px-8 py-3 text-base font-semibold tracking-wide bg-[var(--color-chiaro)] text-[var(--color-ardesia-notte)] hover:bg-white transition-colors duration-300 font-[family-name:var(--font-display)]"
        data-reveal
        data-reveal-delay="0.3"
      >
        Il percorso: i prossimi passi
        <svg width="18" height="18" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </Slide>

  </DeckContainer>
</BaseLayout>
