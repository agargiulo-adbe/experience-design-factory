---
/**
 * Capitolo 01 — In sintesi: la proposta in una pagina.
 *
 * RISCRITTO IL 27 NOV 2026, dopo la critica di design sul deck intero. Prima il
 * capitolo apriva con una persona (il pendolare con la carta fedeltà) e con il
 * campione di una casella email: una storia di cliente riconosciuto, che è la
 * fase 2, la più lontana. Chi dirige i canali digitali arrivava alla proposta
 * diciotto slide dopo.
 *
 * Ora il capitolo regge da solo le tre domande di chi ha dieci minuti:
 *   · che cosa proponete — una slide, tre colonne;
 *   · qual è il problema — una tratta, con la ricerca su un sito e l'acquisto
 *     sull'altro. I valori sono d'ipotesi e lo dicono;
 *   · «ma senza login funziona?» — l'obiezione che si fa da soli in sala. La
 *     risposta è la distinzione fra leggere il fenomeno e riconoscere la persona.
 *
 * La slide sull'identificativo comune diceva che senza quello «l'unione non
 * avviene»: vero per la persona, falso per la fase 0, che legge i due siti per
 * giorno e per tratta. La fonte resta, la frase dice a che cosa si applica.
 */
import { lega } from '../../utils/lega';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Sfondo from '../../components/Sfondo.astro';
import TreniNavigation from '../../components/TreniNavigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import CoverHero from '@edf/core/blocks/CoverHero.astro';
import DiagSoglia from '../../components/diagrammi/DiagSoglia.astro';
import GraficoFunnel from '../../components/figure/GraficoFunnel.astro';
import { href } from '@edf/core/utils/url.js';
import { rotte } from '../../data/percorso';
import { TRATTE } from '../../data/vista-unica';

const base = import.meta.env.BASE_URL;
// Avanti e indietro vengono dal percorso, non scritti a mano: così spegnere
// un capitolo non lascia una freccia che punta fuori dal percorso.
const { next, prev } = rotte('trenitalia/partenza');
const currentPath = Astro.url.pathname;
const h2 = 'font-size: clamp(1.7rem, 2.7vw, 2.4rem); font-weight: 600; line-height: 1.06; letter-spacing: -0.02em;';

/* La proposta in tre colonne. La terza è quella che si decide adesso, e porta il
   rosso: nel deck il rosso vuol dire «adesso», il verde acqua «dopo». */
const sintesi = [
  { k: 'Che cosa proponiamo',
    v: ['Leggere insieme gli Analytics dei due siti, con Customer Journey Analytics.',
        'Per leggere i dati non serve nessun rilascio sui siti.',
        'Poi, in due fasi, riconoscere la visita che compra e il cliente.'] },
  { k: 'Che cosa si vede subito',
    v: ['Tratta per tratta, dove la ricerca non arriva all’acquisto sul canale diretto.',
        'Un test su Adobe Target in home, costruito su quello che si legge.',
        'Una risposta alle domande di revenue management, Customer Operations e Sales.'] },
  { k: 'Che cosa serve per partire', ora: true,
    v: ['Il sì a Customer Journey Analytics: i primi sei mesi di licenza sono senza costo.',
        'Il via libera di FS Technology, di chi amministra Le Frecce e del DPO.',
        'Entro la sesta settimana, un caso da provare in home.'] },
];

/* Una tratta sola, la stessa che torna nel capitolo sulla fase 0 con le altre. */
const tratta = [TRATTE[1]];

const senzaLogin = [
  'Quante ricerche diventano acquisti, per giorno e per tratta',
  'Dove si perde la vendita fra i due siti',
  'Quale variante di una pagina porta più ricerche',
];
const conIlLogin = [
  'La stessa persona su trenitalia.com e su Le Frecce',
  'Lo status fedeltà accanto a quello che cerca',
  'Una proposta diversa cliente per cliente',
];
---
<BaseLayout
  title="In sintesi"
  description="La proposta in una pagina: gli Analytics di trenitalia.com e di Le Frecce letti insieme, che cosa si vede subito e che cosa serve a dicembre."
  branch="trenitalia"
>
  <div class="fixed top-0 left-0 right-0 z-50">
    <TreniNavigation currentPath={currentPath} base={base} branch="trenitalia" />
  </div>

  <DeckContainer wallScale
    nextHref={href(base, next)}
    prevHref={href(base, prev)}
  >

    <!-- ── Copertina ──────────────────────────────────────────────── -->
    <Slide id="slide-cover" bg="primary" align="center">
      <div slot="backdrop" class="fs-bg"></div>
      <div slot="backdrop" class="fs-grid"></div>
      <Sfondo slot="backdrop" id="rl-pensilina" forza="leggera" />
      <CoverHero
        eyebrow="Capitolo 01 · In sintesi"
        numeral="01"
        title="Due siti, una lettura sola"
        lead={lega('Oggi la ricerca parte da trenitalia.com e l’acquisto si chiude su Le Frecce. In circa sei settimane dal via si leggono insieme.')}
        size="phase"
        tone="ink"
        signature={false}
      />

      {/* Il binario del deck, in piccolo: due stazioni e il tratto che oggi manca. */}
      <div class="pt-linea" data-reveal data-reveal-delay="0.3" aria-hidden="true">
        <span class="pt-staz"><i></i>trenitalia.com<small>si cerca</small></span>
        <span class="pt-vuoto"></span>
        <span class="pt-staz"><i></i>Le Frecce<small>si compra</small></span>
      </div>
    </Slide>

    <!-- ── La proposta, in una pagina ─────────────────────────────── -->
    <Slide id="slide-sintesi" bg="primary" align="center">
      <div slot="backdrop" class="fs-bg"></div>
      <Sfondo slot="backdrop" id="tc-strati" forza="forte" />
      <div slot="backdrop" class="fs-grid"></div>
      <p class="fs-panel-tag text-center mb-3" data-reveal>LA PROPOSTA, IN UNA PAGINA</p>
      <h2 class="text-center text-[var(--ink-primary)] mb-7 font-[family-name:var(--font-display)]" style={h2} data-reveal data-reveal-delay="0.08">
        In circa sei settimane dal via, ricerca e acquisto si leggono&nbsp;insieme.
      </h2>
      <div class="pt-sintesi" data-stagger>
        {sintesi.map((c) => (
          <div class:list={['pt-col', c.ora && 'pt-col--ora']}>
            <p class="pt-col-k">{c.k}</p>
            <ul>{c.v.map((x) => <li>{lega(x)}</li>)}</ul>
          </div>
        ))}
      </div>
    </Slide>

    <!-- ── Il problema, su una tratta ─────────────────────────────── -->
    {/* Primo ↓ gli arrivi su Le Frecce, secondo ↓ le conferme, terzo ↓ la lettura. */}
    <Slide id="slide-due-siti" bg="secondary" align="center">
      <div slot="backdrop" class="fs-bg-soft"></div>
      <Sfondo slot="backdrop" id="rl-alba" forza="forte" />
      <div slot="backdrop" class="fs-grid"></div>
      <p class="fs-panel-tag text-center mb-3" data-reveal>IL PUNTO DI PARTENZA · UNA TRATTA</p>
      <h2 class="text-center text-[var(--ink-primary)] mb-4 font-[family-name:var(--font-display)]" style={h2} data-reveal data-reveal-delay="0.08">
        Su una tratta, quante ricerche avviate arrivano all’acquisto&nbsp;diretto?
      </h2>
      <p class="pt-lead text-center fs-card-body max-w-3xl mx-auto mb-7" data-reveal data-reveal-delay="0.14">
        {lega('Oggi i due numeri stanno in due report separati. Affiancati, dicono dove guardare. App, biglietteria e agenzie restano fuori da questo conto.')}
      </p>
      <div class="w-full" data-reveal data-reveal-delay="0.2">
        <GraficoFunnel righe={tratta}
          gradini={['Ricerche su trenitalia.com', 'Arrivi su Le Frecce', 'Conferme d’acquisto']}
          avvertenza="Esempio illustrativo: la tratta è vera, i valori sono un’ipotesi, in indice 100 sulle ricerche. I numeri veri arrivano con la fase 0." />
      </div>
    </Slide>

    <!-- ── Senza login, che cosa si legge ─────────────────────────── -->
    <Slide id="slide-riconoscimento" bg="inverse" align="center">
      <Sfondo slot="backdrop" id="rl-alba" forza="forte" chiara />
      <p class="fs-panel-tag text-center mb-3" data-reveal>
        SENZA LOGIN SU TRENITALIA.COM
      </p>
      <h2
        class="text-center text-[var(--color-ardesia-notte)] mb-6 font-[family-name:var(--font-display)]"
        style="font-size: clamp(1.7rem, 2.7vw, 2.6rem); font-weight: 600; line-height: 1.06; letter-spacing: -0.02em;"
        data-reveal
        data-reveal-delay="0.08"
      >
        Senza login non si riconosce la&nbsp;persona. I&nbsp;totali si leggono&nbsp;comunque.
      </h2>

      <div class="w-full max-w-5xl mx-auto mb-6" data-reveal data-reveal-delay="0.16">
        <DiagSoglia
          prima={{ titolo: 'Si legge da subito', voci: senzaLogin }}
          soglia="il login"
          inverti
          dopo={{ titolo: 'Arriva con il login', voci: conIlLogin }}
        />
      </div>

      <p class="fs-panel-src text-center max-w-4xl mx-auto" data-reveal data-reveal-delay="0.3">
        Per unire due insiemi di dati sulla stessa persona serve un identificativo comune ·
        <a href="https://experienceleague.adobe.com/en/docs/analytics-platform/using/cja-connections/create-connection" target="_blank" rel="noopener noreferrer" class="underline underline-offset-2">Experience League, «Create or edit a connection»</a>.
        Per leggerli affiancati, per giorno e per tratta, non serve. Il login di trenitalia.com avviene su Le Frecce: sul sito non resta una sessione autenticata.
      </p>

      <div class="mt-6" data-reveal data-reveal-delay="0.4">
        <a
          href={href(base, next)}
          class="inline-flex items-center gap-3 px-8 py-2.5 text-base font-semibold tracking-wide bg-[var(--color-ardesia-notte)] text-[var(--color-chiaro)] hover:bg-[var(--color-ardesia)] transition-colors duration-300 font-[family-name:var(--font-display)]"
        >
          Le tre fasi
          <svg width="18" height="18" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>
    </Slide>

  </DeckContainer>
</BaseLayout>

<style is:global>
  #slide-cover [data-cover] p { text-wrap: balance; }
  [data-slide] .pt-lead { text-wrap: balance; }
  /* Una tratta sola: la riga cresce, perché qui è lei la slide. */
  #slide-due-siti .gf-riga { padding-block: clamp(1.2rem, 3vh, 2rem); }
  #slide-due-siti .gf-barra { height: clamp(1rem, 2.2vh, 1.5rem); }
  #slide-due-siti .gf-barre { gap: 0.55rem; }
  #slide-due-siti .gf-tratta { font-size: clamp(1.2rem, 1.5vw, 1.6rem); }
  #slide-due-siti .gf-lettura strong { font-size: clamp(1.15rem, 1.35vw, 1.45rem); }
  #slide-due-siti .gf-lettura span { font-size: clamp(1.02rem, 1.1vw, 1.18rem); }

  /* Il binario in copertina: due stazioni, e in mezzo il tratto che manca. */
  .pt-linea {
    width: 100%; max-width: 46rem; margin: clamp(1.6rem, 4vh, 2.6rem) auto 0;
    display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: start; gap: 1rem;
  }
  .pt-staz { display: grid; justify-items: center; gap: 0.2rem; font-family: var(--font-display); font-weight: 600; font-size: clamp(1.05rem, 1.25vw, 1.35rem); color: var(--ink-primary); }
  .pt-staz i { width: 1rem; height: 1rem; border-radius: 50%; background: var(--ink-primary); margin-bottom: 0.35rem; }
  .pt-staz small { font-family: var(--font-body); font-weight: 500; font-size: clamp(0.9rem, 0.95vw, 1rem); color: var(--ink-secondary); }
  .pt-vuoto { height: 0; margin-top: 0.5rem; border-top: 2px dashed rgba(255, 255, 255, 0.55); }

  /* La sintesi: tre colonne, la terza è quella che si decide adesso. */
  .pt-sintesi { width: 100%; max-width: 80rem; margin-inline: auto; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(0.8rem, 1.4vw, 1.5rem); text-align: left; }
  .pt-col { padding: clamp(1.1rem, 2.4vh, 1.6rem) clamp(1.1rem, 1.4vw, 1.5rem); border-radius: 0.7rem; border: 1px solid rgba(255, 255, 255, 0.22); background: rgba(27, 34, 48, 0.6); }
  .pt-col--ora { border: 1.5px solid var(--color-rosso-chiaro); background: rgba(217, 24, 53, 0.14); }
  [data-slide] .pt-col-k { margin: 0 0 0.9rem; max-width: none; text-align: left; font-family: var(--font-display); font-weight: 600; font-size: clamp(1.2rem, 1.45vw, 1.55rem); line-height: 1.15; color: var(--ink-primary); }
  .pt-col ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.7rem; }
  .pt-col li { position: relative; padding-left: 1.1rem; font-size: clamp(1.02rem, 1.1vw, 1.18rem); line-height: 1.4; color: var(--ink-primary); text-wrap: pretty; }
  .pt-col li::before { content: ''; position: absolute; left: 0; top: 0.58em; width: 0.42rem; height: 0.42rem; border-radius: 50%; background: rgba(255, 255, 255, 0.7); }
  .pt-col--ora li::before { background: var(--color-rosso-chiaro); }
  @media (max-width: 900px) { .pt-sintesi { grid-template-columns: minmax(0, 1fr); } }
</style>
