---
/**
 * Capitolo 03 — Convergenza: il disegno d'insieme, in tre passi.
 *
 * RISCRITTO IL 22 NOV 2026 per l'incontro con il responsabile dei canali digitali,
 * che ha chiesto un piano di casi d'uso su Adobe Target. RIORDINATO IL 23 NOV dopo la
 * call con il partner. I passi sono tre, in fila:
 *   · il primo passo — CJA su trenitalia.com e sullo status del cliente, estratto dal
 *     CRM; Target su trenitalia.com. Aspetta il DPO e la sicurezza IT;
 *   · l'acquisto su Le Frecce — si lavora da subito, in parallelo: lega la vendita
 *     alla ricerca sulla pagina di conferma, senza toccare la piattaforma di vendita;
 *   · Le Frecce e l'app — il percorso intero, e Target anche lì: con il nuovo portale.
 * Il motivo del riordino: su Le Frecce il partner misura solo la pagina di conferma,
 * e la piattaforma di vendita non rilascia prima del nuovo portale.
 *
 * IL LEGAME FRA I DUE SITI (due organizzazioni Adobe, due identità) è il lavoro del
 * secondo passo, con il partner, FS Technology e il DPO. Qui si dice per quello che è
 * per il cliente: che cosa si verifica, quale pubblico si raggiunge e perché gli altri
 * restano fuori, chi decide. I vincoli stanno come cose da decidere, senza numeri del
 * partner. Il dettaglio tecnico sta nel documento di riconciliazione, fuori dal deck.
 *
 * RIPENSATO IL 25 NOV 2026, dopo le due call del 24 (con il partner e con il
 * Customer Success). Tre fatti nuovi:
 *   · trenitalia.com più il CRM, da solo, non lega niente: sul sito non si fa login;
 *   · il primo legame è la pagina di conferma su Le Frecce, dove gira già un tag
 *     del team del cliente che scrive nella report suite di trenitalia.com: la
 *     traccia della ricerca ci arriva dentro un parametro, e l'acquisto si lega;
 *   · il CRM entra come un attributo, con il DPO; il connettore diretto esce,
 *     perché passa da internet e la sicurezza del Gruppo vuole tutto dal gateway.
 * E una scelta di racconto: prima i casi a valore nel perimetro che ha dato il
 * cliente (gli Analytics dei due siti e il CRM), poi i due gruppi — senza toccare
 * Le Frecce / con Le Frecce nel disegno — poi i tempi. La slide «i casi nel tempo»
 * sta subito dopo la copertina. Il dettaglio, con fonti, sta nella
 * cartella d’analisi dell’account (git-ignorata).
 *
 * RINUMERATO IL 26 NOV 2026 IN TRE FASI, dopo la call con il partner e l'AE:
 *   · fase 0, Vista unica: i due Analytics in CJA come sono, letti per giorno e per
 *     tratta; Target prova varianti per tutti. Ha il suo capitolo, subito dopo;
 *   · fase 1, la conferma: la traccia della ricerca passa a Le Frecce in un campo
 *     in più del passaggio fra i siti, e la conferma la riporta. Nascono i pubblici;
 *   · fase 2, il login su trenitalia.com: l'unico identificativo persistente, e
 *     solo da qui il CRM (decisione dell'owner). Il login si dice come condizione,
 *     in chiaro: lo chiede il partner, e il team digitale lo vuole.
 * La slide nuova dopo la copertina, i tre cerchi, è l'idea della consulente dati:
 * le fasi come convergenza dal fenomeno alla persona, non come piano di progetto.
 * Ogni fase dice che cosa dà e che cosa non dà ancora: è il dubbio dell'AE, che il
 * cliente si aspetti dalla fase 0 più di quello che porta.
 *
 * Usciti dal capitolo: «CJA non è una CDP», «i casi in tabella» (stanno nel capitolo
 * dopo), Content Analytics (prodotto a parte, fuori dal piano) e la tabella a tre
 * fasi con Real-Time CDP. I pubblici da CJA a Target si abilitano a contratto: al
 * cliente non si propone una piattaforma in più da gestire.
 */
import { lega } from '../../utils/lega';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Sfondo from '../../components/Sfondo.astro';
import TreniNavigation from '../../components/TreniNavigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import CoverHero from '@edf/core/blocks/CoverHero.astro';
import MediaDemoSlot from '@edf/core/blocks/immersive/MediaDemoSlot.astro';
import DiagDisegno from '../../components/diagrammi/DiagDisegno.astro';
import DiagOrizzonti, { type Orizzonte } from '../../components/diagrammi/DiagOrizzonti.astro';
import FiguraConvergenza from '../../components/figure/FiguraConvergenza.astro';
import ComeFunziona from '../../components/ComeFunziona.astro';
import { href } from '@edf/core/utils/url.js';
import { rotte } from '../../data/percorso';

const base = import.meta.env.BASE_URL;
const { next, prev } = rotte('trenitalia/convergenza');
const currentPath = Astro.url.pathname;

const orizzonti: Orizzonte[] = [
  { id: 'a', quando: 'Fase 0 · circa sei settimane', nome: 'Vista unica, i due siti come sono',
    casi: ['Le tratte più cercate dall’area', 'Dove si perde la vendita', 'Le settimane che arrivano', 'Una prova su Target per lettura'],
    serve: 'i due Analytics in CJA; il via libera di FS Technology, di Le Frecce e del DPO',
    muove: 'Adobe, FS Technology e chi amministra Le Frecce' },
  { id: 'b', quando: 'Fase 1 · dopo le prime letture', nome: 'La conferma d’acquisto',
    casi: ['La home riconosce chi ha già cercato', 'Quale campagna vende davvero', 'Non rincorrere chi ha già comprato'],
    serve: 'prima la conferma legata, senza licenze nuove; poi i pubblici, con Real-Time CDP o Journey Optimizer',
    muove: 'chi gestisce la vendita, il vostro team, il partner' },
  { id: 'c', quando: 'Fase 2 · con il login', nome: 'La persona, anche sull’app',
    casi: ['Lo status fedeltà, al ritorno', 'L’upgrade a chi lo compra davvero', 'La stessa proposta sul sito e nell’app', 'L’abbandono, recuperato'],
    serve: 'login e nuovo portale: decisioni del Gruppo, non di Adobe',
    muove: 'Trenitalia e chi sviluppa i portali' },
];

/* I tre cerchi: che cosa si legge e che cosa si attiva, fase per fase. «Si attiva»
   è la parte che risponde al dubbio di chi decide: la fase 0 non porta pubblici. */
const anelli: Parameters<typeof FiguraConvergenza>[0]['anelli'] = [
  { n: '0', nome: 'Il fenomeno', legge: 'ricerche, arrivi e conferme, per giorno e per tratta',
    attiva: 'prove su Target senza pubblici, anche per area', casi: ['Le tratte più cercate dall’area', 'Dove si perde la vendita'] },
  { n: '1', nome: 'La visita che compra', legge: 'chi ha cercato e poi ha comprato, senza un nome',
    attiva: 'pubblici di visitatori, misurati fino alla conferma', casi: ['La home riconosce chi ha già cercato', 'Non rincorrere chi ha già comprato'] },
  { n: '2', nome: 'La persona', legge: 'la stessa persona sui due siti, con lo status',
    attiva: 'la proposta per persona, anche nell’app', casi: ['Lo status fedeltà, al ritorno', 'La stessa proposta sul sito e nell’app'] },
];

/* Chi decide, chi firma, chi fa: dal panel del 26 nov 2026. FS Technology la
   leggeva come la condizione d'accesso; titolarità e accordi fra le due
   organizzazioni restano «da chiedere» finché il DPO non li dice. */
const governo = [
  { f: '0', entra: 'le righe di visita dei due Analytics, con identificativi pseudonimi',
    decide: 'FS Technology e chi amministra Le Frecce; il DPO dà il parere',
    fa: 'Adobe: mappatura e rimappatura; FS Technology: accessi, connessione, sicurezza' },
  { f: '1', entra: 'un identificativo in più nel passaggio a Le Frecce, e la conferma per visitatore',
    decide: 'Customer Operations per il campo, da confermare; il DPO; FS Technology',
    fa: 'il partner sulla libreria, il vostro team sul tag della conferma' },
  { f: '2', entra: 'il login su trenitalia.com e un attributo dal CRM',
    decide: 'il Gruppo, su login e portale; il DPO, per il CRM; marketing e revenue management, per offerte e status',
    fa: 'chi sviluppa i portali; Adobe sul profilo in CJA' },
];

const verifica = [
  { k: 'Che cosa si verifica', v: 'Che l’identificativo del visitatore di trenitalia.com passi a Le Frecce in un campo in più, fuori da referrer e log, e che il tag della conferma lo riporti con l’acquisto.' },
  { k: 'Chi si raggiunge', v: 'Chi passa da trenitalia.com a Le Frecce con il consenso. Restano fuori chi arriva diretto su Le Frecce e, su Safari, chi torna dopo una settimana.' },
  { k: 'Chi decide', v: 'Chi gestisce la vendita, per il campo in più; il vostro team, per il tag della conferma; il partner, per la libreria.' },
];

const catena = [
  { k: 'Adobe Analytics', v: 'raccoglie come oggi, su trenitalia.com' },
  { k: 'Il connettore', v: 'porta le visite e l’acquisto; lo status, con il login, da un’estrazione del CRM', nuovo: true },
  { k: 'Customer Journey Analytics', v: 'legge il viaggio e costruisce il pubblico', nuovo: true },
  { k: 'La destinazione Target', v: 'passa il pubblico a Target; serve Real-Time CDP o Journey Optimizer', nuovo: true },
  { k: 'Adobe Target', v: 'su trenitalia.com, dalle visite successive' },
];

const catenaNote = [
  { k: 'Ogni quanto si aggiorna', v: 'Al più ogni 4 ore. Con at.js 2, già sul sito, vale dalla visita dopo; se il pubblico non arriva, resta la home di oggi.' },
  { k: 'Le Frecce, dopo', v: 'L’acquisto entra con la conferma, nella fase 1; lo status del cliente con il login, nella fase 2.' },
  { k: 'Come si spegne', v: 'Un interruttore per attività in Target; at.js nasconde la parte che cambia fino alla variante, con una soglia in millisecondi da fissare con il vostro team.' },
];

const crm = [
  { k: 'Prima, un file', v: 'Un attributo per cliente, come lo status del programma fedeltà, che dal 2027 sta in Salesforce, o un livello di valore, con un’estrazione periodica. Nessun dato anagrafico.' },
  { k: 'Poi, dal vostro gateway', v: 'A regime il dato parte dallo strato di integrazione del Gruppo verso Adobe, in uscita. Il come si studia con la sicurezza IT.' },
  { k: 'Per tutte e due', v: 'Il parere del DPO e della sicurezza IT, anche per un solo attributo. Il connettore diretto passa da internet: lo valutiamo con la sicurezza IT.' },
];

const letture = [
  { metric: 'Cosa cerca', label: 'chi poi compra, e chi no', sub: 'La ricerca su un sito, l’acquisto sull’altro, nella stessa riga' },
  { metric: 'Dove si ferma', label: 'e quante volte torna', sub: 'Sul sito per passaggi; su Le Frecce, con il login' },
  { metric: 'Su che cosa', label: 'si misura una proposta', sub: 'Prima sui clic verso l’acquisto, poi fino alla conferma' },
];
---
<BaseLayout
  title="Un disegno, tre fasi"
  description="Tre fasi, dal fenomeno alla persona: i due Analytics letti insieme senza toccare i siti, poi la conferma d’acquisto legata alla ricerca, poi il login su trenitalia.com con lo status dal CRM."
  pageSolutions={['cja']}
  branch="trenitalia"
>
  <div class="fixed top-0 left-0 right-0 z-50">
    <TreniNavigation currentPath={currentPath} base={base} branch="trenitalia" />
  </div>

  <DeckContainer wallScale
    nextHref={href(base, next)}
    prevHref={href(base, prev)}
  >

    <!-- ── Copertina ──────────────────────────────────────────────── -->
    <Slide id="slide-cover" bg="primary" align="center" data-solution="cja">
      <div slot="backdrop" class="absolute inset-0">
        <div class="fs-bg"></div>
        <Sfondo slot="backdrop" id="rl-binari" forza="leggera" />
        <div class="fs-grid"></div>
      </div>
      <CoverHero
        eyebrow="Capitolo 03 · Convergenza"
        numeral="03"
        title="Un disegno, tre fasi"
        lead={lega('Che cosa si legge subito, che cosa si sblocca con la conferma d’acquisto e che cosa con il login.')}
        size="phase"
        tone="ink"
        signature={false}
      />

      <div class="relative w-full max-w-3xl mx-auto mt-9 mb-1" data-reveal data-reveal-delay="0.3">
        <div class="fs-line-h" style="top: 1.45rem; left: 8%; right: 8%;"></div>
        <div class="relative flex justify-between items-start px-[4%]">
          <div class="flex flex-col items-center gap-2.5 text-center">
            <span class="fs-node" data-active>AA</span>
            <span class="fs-node-label">Il sito, come oggi</span>
          </div>
          <div class="flex flex-col items-center gap-2.5 text-center">
            <span class="fs-node fs-node--alt" data-active>CJA</span>
            <span class="fs-node-label">Legge il viaggio</span>
          </div>
          <div class="flex flex-col items-center gap-2.5 text-center">
            <span class="fs-node" data-active>AT</span>
            <span class="fs-node-label">Agisce sul sito</span>
          </div>
        </div>
      </div>
    </Slide>

    <!-- ── Dal fenomeno alla persona ────────────────────────────────────── -->
    {/* I tre cerchi. Il primo ↓ accende la fase 1, il secondo la fase 2. */}
    <Slide id="slide-cerchi" bg="primary" align="center" data-solution="cja">
      <div slot="backdrop" class="absolute inset-0">
        <div class="fs-bg"></div>
        <div class="fs-grid"></div>
      </div>
      <Sfondo slot="backdrop" id="tc-strati" forza="forte" />
      <p class="fs-panel-tag text-center mb-3" data-reveal>DAL FENOMENO ALLA PERSONA</p>
      <h2
        class="text-center text-[var(--ink-primary)] mb-5 font-[family-name:var(--font-display)]"
        style="font-size: clamp(1.7rem, 2.7vw, 2.4rem); font-weight: 600; line-height: 1.06; letter-spacing: -0.02em;"
        data-reveal data-reveal-delay="0.08"
      >
        Ogni fase aggiunge una chiave, e l’attivazione si fa più&nbsp;mirata.
      </h2>
      <p class="text-center fs-card-body max-w-3xl mx-auto mb-6" data-reveal data-reveal-delay="0.14">
        Ogni fase riusa la connessione e i campi della precedente.
      </p>
      <div class="w-full" data-reveal data-reveal-delay="0.2">
        <FiguraConvergenza anelli={anelli} centro="la persona" />
      </div>
    </Slide>

    <!-- ── I casi nel tempo ──────────────────────────────────────────── -->
    {/* Prima i casi, poi la macchina: è l'ordine che ha chiesto il cliente. Il primo
        ↓ accende la seconda colonna, il secondo quella con Le Frecce. */}
    <Slide id="slide-orizzonti" bg="secondary" align="center" data-solution="cja">
      <div slot="backdrop" class="absolute inset-0">
        <div class="fs-bg-soft"></div>
        <div class="fs-grid"></div>
      </div>
      <Sfondo slot="backdrop" id="tc-quiete" forza="forte" />
      <p class="fs-panel-tag text-center mb-3" data-reveal>I CASI NEL TEMPO</p>
      <h2
        class="text-center text-[var(--ink-primary)] mb-5 font-[family-name:var(--font-display)]"
        style="font-size: clamp(1.7rem, 2.7vw, 2.4rem); font-weight: 600; line-height: 1.06; letter-spacing: -0.02em;"
        data-reveal data-reveal-delay="0.08"
      >
        La prima fase non chiede rilasci; le altre due, una&nbsp;chiave.
      </h2>
      <p class="text-center fs-card-body max-w-3xl mx-auto mb-6" style="text-wrap: balance;" data-reveal data-reveal-delay="0.14">
        La conferma aggiunge un campo verso Le Frecce; il login sul sito dà la&nbsp;persona.
      </p>
      <div class="w-full" data-reveal data-reveal-delay="0.2">
        <DiagOrizzonti orizzonti={orizzonti} primo={1}
          gruppi={['Senza rilasci sui siti', 'Con una chiave fra i due siti']}
          asse={['il fenomeno', 'la persona']} />
      </div>
    </Slide>

    <!-- ── Chi decide, chi firma, chi fa ────────────────────────────────── -->
    <Slide id="slide-governo" bg="primary" align="center" data-solution="cja">
      <div slot="backdrop" class="absolute inset-0">
        <div class="fs-bg"></div>
        <div class="fs-grid"></div>
      </div>
      <Sfondo slot="backdrop" id="tc-acciaio" forza="forte" />
      <p class="fs-panel-tag text-center mb-3" data-reveal>CHI DECIDE, CHI FA</p>
      <h2
        class="text-center text-[var(--ink-primary)] mb-6 font-[family-name:var(--font-display)]"
        style="font-size: clamp(1.7rem, 2.7vw, 2.4rem); font-weight: 600; line-height: 1.06; letter-spacing: -0.02em;"
        data-reveal data-reveal-delay="0.08"
      >
        Chi decide e chi lavora, fase per&nbsp;fase.
      </h2>
      <div class="cv-gov" role="table" aria-label="Chi decide e chi fa, fase per fase" data-reveal data-reveal-delay="0.16">
        <div class="cv-gov-r cv-gov-t" role="row">
          <span role="columnheader">Fase</span><span role="columnheader">Che cosa entra</span><span role="columnheader">Chi decide</span><span role="columnheader">Chi fa</span>
        </div>
        {governo.map((g) => (
          <div class="cv-gov-r" role="row">
            <span role="cell" class="cv-gov-f">{g.f}</span>
            <span role="cell">{lega(g.entra)}</span>
            <span role="cell">{lega(g.decide)}</span>
            <span role="cell">{lega(g.fa)}</span>
          </div>
        ))}
      </div>
      <p class="fs-panel-src text-center mt-5" data-reveal data-reveal-delay="0.3">
        {lega('Sponsor e firma: la direzione dei canali digitali, con chi tiene il budget, da confermare. Titolarità del dato e accordi fra le due organizzazioni: da chiedere al DPO.')}
      </p>
    </Slide>

    <!-- ── Il disegno che si costruisce ─────────────────────────────── -->
    {/* Il primo stato è il primo passo. Con ↓ entra l'acquisto su Le Frecce, con ↓
        ancora Le Frecce e l'app. Il pulsante apre il «come funziona» a passi. */}
    <Slide id="slide-disegno" bg="primary" align="center" data-solution="cja">
      <div slot="backdrop" class="absolute inset-0">
        <div class="fs-bg"></div>
        <div class="fs-grid"></div>
      </div>
      <Sfondo slot="backdrop" id="tc-strati" forza="forte" />
      <p class="fs-panel-tag text-center mb-3" data-reveal>IL DISEGNO D’INSIEME</p>
      <h2
        class="text-center text-[var(--ink-primary)] mb-5 font-[family-name:var(--font-display)]"
        style="font-size: clamp(1.7rem, 2.7vw, 2.4rem); font-weight: 600; line-height: 1.06; letter-spacing: -0.02em;"
        data-reveal data-reveal-delay="0.08"
      >
        I due Analytics entrano dalla prima fase; Target cresce con&nbsp;loro.
      </h2>
      <p class="text-center fs-card-body max-w-3xl mx-auto mb-6" data-reveal data-reveal-delay="0.14">
        Nella fase 0 Target prova varianti per tutti su trenitalia.com, dove c’è già una prima geolocalizzazione. Dalla fase 1 riceve pubblici; con il login, la&nbsp;persona.
      </p>
      <div class="w-full" data-reveal data-reveal-delay="0.2">
        <DiagDisegno />
      </div>
      <div class="cv-apri" data-reveal data-reveal-delay="0.3">
        <button type="button" class="cv-apri-b" data-pp-open aria-haspopup="dialog">Come funziona, dalla fase 0 alla fase 1 →</button>
        <ComeFunziona />
      </div>
    </Slide>

    <!-- ── La fase 1, preparata in parallelo ───────────────────────────── -->
    {/* Calma, e con il ripiego in vista. Il primo passo non aspetta il legame fra i
        due siti; il pubblico raggiungibile si definisce insieme, e si dice perché gli
        altri restano fuori. Nessun numero del partner: il consenso si misura. */}
    <Slide id="slide-verifica" bg="secondary" align="center" data-solution="cja">
      <div slot="backdrop" class="absolute inset-0">
        <div class="fs-bg-soft"></div>
        <div class="fs-grid"></div>
      </div>
      <Sfondo slot="backdrop" id="tc-quiete" forza="media" />
      <p class="fs-panel-tag text-center mb-3" data-reveal>LA FASE 1 · LA CONFERMA D’ACQUISTO</p>
      <h2
        class="text-center text-[var(--ink-primary)] mb-5 font-[family-name:var(--font-display)]"
        style="font-size: clamp(1.7rem, 2.7vw, 2.4rem); font-weight: 600; line-height: 1.06; letter-spacing: -0.02em;"
        data-reveal data-reveal-delay="0.08"
      >
        La ricerca e l’acquisto si incontrano sulla pagina di&nbsp;conferma.
      </h2>
      <p class="text-center fs-card-body max-w-3xl mx-auto mb-7" data-reveal data-reveal-delay="0.14">
        La traccia della ricerca passa a Le Frecce in un campo in più; sulla&nbsp;conferma, un tag vostro da configurare la riporta negli&nbsp;Analytics.
      </p>
      {/* Il ponte fra i due siti: tratteggiato, perché è quello che si verifica. */}
      <div class="cv-ponte" data-reveal data-reveal-delay="0.18" aria-hidden="true">
        <span class="cv-ponte-s"><small>la ricerca</small>trenitalia.com</span>
        <span class="cv-ponte-l">
          <svg viewBox="0 0 200 8" preserveAspectRatio="none"><line x1="0" y1="4" x2="200" y2="4" stroke="currentColor" stroke-width="2" stroke-dasharray="6 6" vector-effect="non-scaling-stroke"/></svg>
          <em>la stessa persona?</em>
        </span>
        <span class="cv-ponte-s"><small>l’acquisto</small>Le Frecce</span>
      </div>
      <div class="w-full max-w-6xl mx-auto grid md:grid-cols-3 gap-5" data-stagger>
        {verifica.map((c, i) => (
          <div class:list={['fs-card text-left h-full', i === 1 && 'cv-card--ok']}>
            <p class="fs-card-title mb-2" style="font-size: 1.1rem;">{c.k}</p>
            <p class="fs-card-body">{lega(c.v)}</p>
          </div>
        ))}
      </div>
      <p class="text-center fs-card-body max-w-3xl mx-auto mt-6" data-reveal data-reveal-delay="0.3">
        Si sa se la visita ha comprato; biglietto e importo solo se la conferma porta anche quei campi. Il dato è per visitatore: serve il parere del&nbsp;DPO.
      </p>
    </Slide>

    <!-- ── Come arriva un pubblico a Target ─────────────────────────────── -->
    {/* Chiesta dal panel del 22 nov 2026: «Target lo riceve» taceva il come. Il
        passaggio usa la destinazione Adobe Target di Experience Platform, che si
        abilita nella proposta: al cliente non si propone una piattaforma da gestire.
        La latenza e la residenza dei dati si dicono «da confermare» finché non lo sono. */}
    <Slide id="slide-catena" bg="primary" align="center" data-solution="cja">
      <div slot="backdrop" class="absolute inset-0">
        <div class="fs-bg"></div>
        <div class="fs-grid"></div>
      </div>
      <Sfondo slot="backdrop" id="tc-acciaio" forza="forte" />
      <p class="fs-panel-tag text-center mb-3" data-reveal>DALLA FASE 1 · COME ARRIVA UN PUBBLICO A TARGET</p>
      <h2
        class="text-center text-[var(--ink-primary)] mb-5 font-[family-name:var(--font-display)]"
        style="font-size: clamp(1.7rem, 2.7vw, 2.4rem); font-weight: 600; line-height: 1.06; letter-spacing: -0.02em;"
        data-reveal data-reveal-delay="0.08"
      >
        La raccolta resta com’è; il pubblico passa da Experience Platform.
      </h2>
      <p class="text-center fs-card-body max-w-3xl mx-auto mb-7" style="text-wrap: balance;" data-reveal data-reveal-delay="0.14">
        Nella fase 0 non passa nessun pubblico; dalla fase 1, passa&nbsp;così.
      </p>
      <ol class="cv-catena" data-reveal data-reveal-delay="0.2">
        {catena.map((c, i) => (
          <li class:list={['cv-anello', c.nuovo && 'cv-anello--nuovo']} data-substep={i > 0 ? '' : undefined}>
            <span class="cv-anello-k">{c.k}</span>
            <span class="cv-anello-v">{lega(c.v)}</span>
          </li>
        ))}
      </ol>
      <div class="w-full max-w-6xl mx-auto grid md:grid-cols-3 gap-5 mt-7" data-stagger>
        {catenaNote.map((c) => (
          <div class="fs-card text-left h-full">
            <p class="fs-card-title mb-2" style="font-size: 1.05rem;">{c.k}</p>
            <p class="fs-card-body">{lega(c.v)}</p>
          </div>
        ))}
      </div>
    </Slide>

    <!-- ── Con il CRM ─────────────────────────────────────────────────── -->
    {/* Fino alla sera del 23 nov stava nel primo passo. Verificato in Chromium: su
        trenitalia.com non si fa login, quindi lo status si lega sulla conferma
        d'acquisto, ed entra con il secondo passo. Dal 26 nov 2026 sta nella fase 2:
        senza il login nessun dato del CRM si lega a una visita (decisione dell'owner). */}
    <Slide id="slide-dove-sta-il-dato" bg="primary" align="center" data-solution="cja">
      <div slot="backdrop" class="absolute inset-0">
        <div class="fs-bg"></div>
        <div class="fs-grid"></div>
      </div>
      <Sfondo slot="backdrop" id="rl-quiete" forza="media" />
      <p class="fs-panel-tag text-center mb-3" data-reveal>LA FASE 2 · IL CRM, CON IL LOGIN</p>
      <h2
        class="text-center text-[var(--ink-primary)] mb-5 font-[family-name:var(--font-display)]"
        style="font-size: clamp(1.7rem, 2.7vw, 2.4rem); font-weight: 600; line-height: 1.06; letter-spacing: -0.02em;"
        data-reveal data-reveal-delay="0.08"
      >
        Il CRM resta in Salesforce; entra un attributo, non il&nbsp;profilo.
      </h2>
      <p class="text-center fs-card-body max-w-3xl mx-auto mb-7" data-reveal data-reveal-delay="0.14">
        Oggi su trenitalia.com non si fa login, e senza una chiave nessun dato del&nbsp;CRM si lega a una visita. Il login è la condizione della fase&nbsp;2.
      </p>
      <div class="w-full max-w-6xl mx-auto grid md:grid-cols-3 gap-5" data-stagger>
        {crm.map((c, i) => (
          <div class:list={['fs-card text-left h-full', i === 2 && 'cv-card--nota']}>
            <p class="fs-card-title mb-2" style="font-size: 1.1rem;">{c.k}</p>
            <p class="fs-card-body">{lega(c.v)}</p>
          </div>
        ))}
      </div>
    </Slide>

    <!-- ── Che cosa si vede in CJA ─────────────────────────────────────── -->
    <Slide id="slide-demo-cja" bg="secondary" align="center" data-solution="cja">
      <div slot="backdrop" class="absolute inset-0">
        <div class="fs-bg-soft"></div>
        <div class="fs-grid"></div>
      </div>
      <Sfondo slot="backdrop" id="rl-quiete" forza="media" />
      <div data-demo-flex class="w-full flex items-start gap-8">
        <div class="flex-1 min-w-0 flex flex-col items-center">
          <p class="fs-panel-tag mb-3" data-reveal>ADOBE CUSTOMER JOURNEY ANALYTICS</p>
          <h2
            class="text-center text-[var(--ink-primary)] mb-5 font-[family-name:var(--font-display)]"
            style="font-size: clamp(1.7rem, 2.7vw, 2.4rem); font-weight: 600; line-height: 1.06; letter-spacing: -0.02em;"
            data-reveal data-reveal-delay="0.08"
          >
            Dalla fase 1, chi ha cercato e chi ha comprato si leggono&nbsp;insieme.
          </h2>
          <p class="text-center fs-card-body max-w-3xl mx-auto mb-6" data-reveal data-reveal-delay="0.14">
            La ricerca su trenitalia.com e l’acquisto su Le&nbsp;Frecce stanno in una lettura sola; il percorso in mezzo arriva con il&nbsp;login.
          </p>
          <div class="w-full max-w-4xl mx-auto grid md:grid-cols-3 gap-3 mb-4" data-stagger>
            {letture.map((m) => (
              <div class="fs-card text-center !py-5">
                <p class="fs-stat-value mb-1.5" style="font-size: clamp(1.8rem, 3vw, 2.6rem);">{m.metric}</p>
                <p class="fs-card-title mb-1" style="font-size: 1rem;">{lega(m.label)}</p>
                <p class="fs-card-body" style="font-size: 0.95rem;">{lega(m.sub)}</p>
              </div>
            ))}
          </div>
          <p class="fs-panel-src text-center">Esempio illustrativo su dati simulati · Adobe Customer Journey Analytics</p>
        </div>
        <MediaDemoSlot id="cja-workspace-demo" label="CJA Workspace — Demo FS Journey" />
      </div>
    </Slide>

    <!-- ── Coworker: chiedere perché ───────────────────────────────────── -->
    <Slide id="slide-coworker" bg="primary" align="center" data-solution="cja">
      <div slot="backdrop" class="absolute inset-0">
        <div class="fs-bg"></div>
        <div class="fs-grid"></div>
      </div>
      <Sfondo slot="backdrop" id="tc-strati" forza="media" />
      <p class="fs-panel-tag text-center mb-3" data-reveal>ADOBE CX ENTERPRISE COWORKER</p>
      <h2
        class="text-center text-[var(--ink-primary)] mb-5 font-[family-name:var(--font-display)]"
        style="font-size: clamp(1.7rem, 2.7vw, 2.4rem); font-weight: 600; line-height: 1.06; letter-spacing: -0.02em;"
        data-reveal data-reveal-delay="0.08"
      >
        Il pubblico si chiede a parole, invece di costruirlo a mano.
      </h2>
      <p class="text-center fs-card-body max-w-3xl mx-auto mb-7" data-reveal data-reveal-delay="0.14">
        {lega('Coworker prepara il segmento in CJA e la bozza dell’attività in Target; il team Target la controlla e la pubblica.')}
      </p>
      <div class="w-full max-w-5xl mx-auto grid md:grid-cols-2 gap-5" data-stagger>
        <div class="fs-card text-left">
          <p class="fs-card-title mb-2" style="font-size: 1.1rem;">Oggi</p>
          <p class="fs-card-body">Una regola scritta a mano da chi conosce il modello dati, e un’ipotesi alla volta.</p>
        </div>
        <div class="fs-card cv-card--ok text-left">
          <p class="fs-card-title mb-2" style="font-size: 1.1rem;">Con Coworker</p>
          <p class="fs-card-body">«Perché su questa tratta si perde più gente?» Lo strumento cerca dove il dato si discosta, poi le cause.</p>
        </div>
      </div>
      <p class="fs-panel-src text-center mt-6" data-reveal data-reveal-delay="0.3">
        Disponibile da giugno 2026; per voi si accende con l’approvazione delle condizioni sull’IA generativa. Dentro CJA è ancora in prova limitata, e la risposta può mescolare l’inglese. I casi reggono anche senza ·
        <a href="https://experienceleague.adobe.com/en/docs/analytics-platform/using/cja-workspace/coworker" target="_blank" rel="noopener noreferrer">Coworker in Customer Journey Analytics</a>
      </p>
      <div class="mt-6 text-center" data-reveal data-reveal-delay="0.38">
        <a
          href={href(base, next)}
          class="inline-flex items-center gap-3 px-8 py-3.5 text-base font-semibold tracking-wide bg-[var(--accent-primary)] text-white hover:opacity-90 transition-opacity duration-300 font-[family-name:var(--font-display)] rounded-sm"
        >
          La fase 0, da vicino
          <svg width="18" height="18" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>
    </Slide>

  </DeckContainer>
</BaseLayout>

<style is:global>
