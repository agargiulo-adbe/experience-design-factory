    .cv-anello:not(:first-child) { padding-left: 1rem; }
  }
  .cv-ponte {
    width: 100%; max-width: 52rem; margin: 0 auto clamp(1.2rem, 3vh, 2rem);
    display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: 1rem;
  }
  .cv-ponte-s {
    display: grid; gap: 0.1rem; padding: 0.7rem 1.1rem; border-radius: 0.6rem;
    border: 1.5px solid rgba(255, 255, 255, 0.5); background: rgba(255, 255, 255, 0.07);
    font-family: var(--font-display); font-weight: 600; font-size: clamp(1.05rem, 1.2vw, 1.3rem); color: var(--ink-primary);
  }
  .cv-ponte-s small { font-family: var(--font-body); font-weight: 500; font-size: clamp(0.82rem, 0.88vw, 0.92rem); color: var(--ink-tertiary); }
  .cv-ponte-l { display: grid; justify-items: center; gap: 0.35rem; color: var(--color-verde-chiaro); }
  .cv-ponte-l svg { width: 100%; height: 8px; }
  .cv-ponte-l em { font-style: normal; font-size: clamp(0.9rem, 0.95vw, 1rem); font-weight: 600; color: var(--color-verde-chiaro); }
  .cv-card--ok { border-color: rgba(79, 189, 180, 0.55) !important; box-shadow: inset 0.28rem 0 0 var(--color-verde-chiaro); }
  .cv-card--nota { border-color: rgba(255, 141, 157, 0.5) !important; box-shadow: inset 0.28rem 0 0 var(--color-rosso-chiaro); }
