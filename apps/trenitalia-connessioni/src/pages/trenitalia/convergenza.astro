---
/**
 * Capitolo 03 — Convergenza: il disegno d'insieme, in tre passi.
 *
 * RISCRITTO IL 22 NOV 2026 per l'incontro con il responsabile dei canali digitali,
 * che ha chiesto un piano di casi d'uso su Adobe Target. RIORDINATO IL 23 NOV dopo la
 * call con il partner. I passi sono tre, in fila:
 *   · il primo passo — CJA su trenitalia.com e sullo status del cliente, estratto dal
 *     CRM; Target su trenitalia.com. Aspetta il DPO e la sicurezza IT;
 *   · l'acquisto su Le Frecce — si lavora da subito, in parallelo: lega la vendita
 *     alla ricerca sulla pagina di conferma, senza toccare la piattaforma di vendita;
 *   · Le Frecce e l'app — il percorso intero, e Target anche lì: con il nuovo portale.
 * Il motivo del riordino: su Le Frecce il partner misura solo la pagina di conferma,
 * e la piattaforma di vendita non rilascia prima del nuovo portale.
 *
 * IL LEGAME FRA I DUE SITI (due organizzazioni Adobe, due identità) è il lavoro del
 * secondo passo, con il partner, FS Technology e il DPO. Qui si dice per quello che è
 * per il cliente: che cosa si verifica, quale pubblico si raggiunge e perché gli altri
 * restano fuori, chi decide. I vincoli stanno come cose da decidere, senza numeri del
 * partner. Il dettaglio tecnico sta nel documento di riconciliazione, fuori dal deck.
 *
 * Usciti dal capitolo: «CJA non è una CDP», «i casi in tabella» (stanno nel capitolo
 * dopo), Content Analytics (prodotto a parte, fuori dal piano) e la tabella a tre
 * fasi con Real-Time CDP. I pubblici da CJA a Target si abilitano a contratto: al
 * cliente non si propone una piattaforma in più da gestire.
 */
import { lega } from '../../utils/lega';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Sfondo from '../../components/Sfondo.astro';
import TreniNavigation from '../../components/TreniNavigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import CoverHero from '@edf/core/blocks/CoverHero.astro';
import MediaDemoSlot from '@edf/core/blocks/immersive/MediaDemoSlot.astro';
import DiagDisegno from '../../components/diagrammi/DiagDisegno.astro';
import ComeFunziona from '../../components/ComeFunziona.astro';
import { href } from '@edf/core/utils/url.js';
import { rotte } from '../../data/percorso';

const base = import.meta.env.BASE_URL;
const { next, prev } = rotte('trenitalia/convergenza');
const currentPath = Astro.url.pathname;

const verifica = [
  { k: 'Che cosa si verifica', v: 'Come portare la traccia della ricerca fino alla conferma dell’acquisto, senza aspettare il nuovo portale di vendita.' },
  { k: 'Chi si raggiunge', v: 'Chi passa da trenitalia.com a Le Frecce con il consenso. Chi arriva diretto su Le Frecce resta fuori: il legame nasce dal passaggio.' },
  { k: 'Chi decide', v: 'Il partner e FS Technology sul come; il DPO e la sicurezza IT sul consenso e su chi vede i dati di Le Frecce.' },
];

const catena = [
  { k: 'Adobe Analytics', v: 'raccoglie come oggi, su trenitalia.com' },
  { k: 'Il connettore', v: 'porta in Experience Platform le visite e l’estrazione dal CRM', nuovo: true },
  { k: 'Customer Journey Analytics', v: 'legge il viaggio e costruisce il pubblico', nuovo: true },
  { k: 'La destinazione Target', v: 'passa il pubblico a Target; si abilita con una voce dedicata', nuovo: true },
  { k: 'Adobe Target', v: 'su trenitalia.com, dalle visite successive' },
];

const catenaNote = [
  { k: 'Ogni quanto si aggiorna', v: 'Ogni qualche ora. Con at.js 2, che gira oggi sul sito, il pubblico vale dalle visite successive e la libreria non cambia.' },
  { k: 'Le Frecce, dopo', v: 'L’acquisto su Le Frecce entra con il secondo passo, quando il legame fra i due siti è verificato.' },
  { k: 'Come si spegne', v: 'Ogni attività ha un interruttore in Target, e una soglia sui tempi di caricamento della home.' },
];

const crm = [
  { k: 'Entra', v: 'Un attributo, lo status CartaFreccia, con un’estrazione periodica. Si lega alle visite di chi fa login.' },
  { k: 'Resta dov’è', v: 'Il profilo resta in Salesforce; consenso ed esclusioni restano dove li governate oggi.' },
  { k: 'Prima serve', v: 'Il parere del DPO e della sicurezza IT, anche per un’estrazione. Il connettore si valuta dopo.' },
];

const letture = [
  { metric: 'Cosa cerca', label: 'chi poi compra, e chi no', sub: 'La ricerca su un sito, l’acquisto sull’altro, nella stessa riga' },
  { metric: 'Dove si ferma', label: 'e quante volte torna', sub: 'Il percorso si legge per passaggi, non per pagine isolate' },
  { metric: 'Su che cosa', label: 'si misura una proposta', sub: 'Prima sui clic verso l’acquisto, poi sul venduto' },
];
---
<BaseLayout
  title="Un disegno, tre passi"
  description="Customer Journey Analytics legge trenitalia.com e lo status del cliente, Adobe Target agisce su trenitalia.com. L’acquisto su Le Frecce si lega in parallelo; Le Frecce e l’app arrivano con il nuovo portale."
  pageSolutions={['cja']}
  branch="trenitalia"
>
  <div class="fixed top-0 left-0 right-0 z-50">
    <TreniNavigation currentPath={currentPath} base={base} branch="trenitalia" />
  </div>

  <DeckContainer wallScale
    nextHref={href(base, next)}
    prevHref={href(base, prev)}
  >

    <!-- ── Copertina ──────────────────────────────────────────────── -->
    <Slide id="slide-cover" bg="primary" align="center" data-solution="cja">
      <div slot="backdrop" class="absolute inset-0">
        <div class="fs-bg"></div>
        <Sfondo slot="backdrop" id="rl-binari" forza="leggera" />
        <div class="fs-grid"></div>
      </div>
      <CoverHero
        eyebrow="Capitolo 03 · Convergenza"
        numeral="03"
        title="Un disegno, tre passi"
        lead="Si parte da trenitalia.com e dal CRM, con Adobe Target sul sito."
        size="phase"
        tone="ink"
        signature={false}
      />

      <div class="relative w-full max-w-3xl mx-auto mt-9 mb-1" data-reveal data-reveal-delay="0.3">
        <div class="fs-line-h" style="top: 1.45rem; left: 8%; right: 8%;"></div>
        <div class="relative flex justify-between items-start px-[4%]">
          <div class="flex flex-col items-center gap-2.5 text-center">
            <span class="fs-node" data-active>AA</span>
            <span class="fs-node-label">Il sito e il CRM</span>
          </div>
          <div class="flex flex-col items-center gap-2.5 text-center">
            <span class="fs-node fs-node--alt" data-active>CJA</span>
            <span class="fs-node-label">Li legge insieme</span>
          </div>
          <div class="flex flex-col items-center gap-2.5 text-center">
            <span class="fs-node" data-active>AT</span>
            <span class="fs-node-label">Agisce sul sito</span>
          </div>
        </div>
      </div>
    </Slide>

    <!-- ── Il disegno che si costruisce ─────────────────────────────── -->
    {/* Il primo stato è il primo passo. Con ↓ entra l'acquisto su Le Frecce, con ↓
        ancora Le Frecce e l'app. Il pulsante apre il «come funziona» a passi. */}
    <Slide id="slide-disegno" bg="primary" align="center" data-solution="cja">
      <div slot="backdrop" class="absolute inset-0">
        <div class="fs-bg"></div>
        <div class="fs-grid"></div>
      </div>
      <Sfondo slot="backdrop" id="tc-strati" forza="forte" />
      <p class="fs-panel-tag text-center mb-3" data-reveal>IL DISEGNO D’INSIEME</p>
      <h2
        class="text-center text-[var(--ink-primary)] mb-5 font-[family-name:var(--font-display)]"
        style="font-size: clamp(1.7rem, 2.7vw, 2.4rem); font-weight: 600; line-height: 1.06; letter-spacing: -0.02em;"
        data-reveal data-reveal-delay="0.08"
      >
        Si parte da trenitalia.com e dal CRM, e&nbsp;si aggiunge Customer Journey Analytics.
      </h2>
      <p class="text-center fs-card-body max-w-3xl mx-auto mb-6" data-reveal data-reveal-delay="0.14">
        CJA legge il sito e lo status del cliente; Target cambia la proposta su&nbsp;trenitalia.com, dove oggi c’è già una prima geolocalizzazione.
      </p>
      <div class="w-full" data-reveal data-reveal-delay="0.2">
        <DiagDisegno />
      </div>
      <div class="cv-apri" data-reveal data-reveal-delay="0.3">
        <button type="button" class="cv-apri-b" data-pp-open aria-haspopup="dialog">Come funziona il primo passo →</button>
        <ComeFunziona />
      </div>
    </Slide>

    <!-- ── Il secondo passo, in parallelo ────────────────────────────── -->
    {/* Calma, e con il ripiego in vista. Il primo passo non aspetta il legame fra i
        due siti; il pubblico raggiungibile si definisce insieme, e si dice perché gli
        altri restano fuori. Nessun numero del partner: il consenso si misura. */}
    <Slide id="slide-verifica" bg="secondary" align="center" data-solution="cja">
      <div slot="backdrop" class="absolute inset-0">
        <div class="fs-bg-soft"></div>
        <div class="fs-grid"></div>
      </div>
      <Sfondo slot="backdrop" id="tc-quiete" forza="media" />
      <p class="fs-panel-tag text-center mb-3" data-reveal>IN PARALLELO · L’ACQUISTO SU LE FRECCE</p>
      <h2
        class="text-center text-[var(--ink-primary)] mb-5 font-[family-name:var(--font-display)]"
        style="font-size: clamp(1.7rem, 2.7vw, 2.4rem); font-weight: 600; line-height: 1.06; letter-spacing: -0.02em;"
        data-reveal data-reveal-delay="0.08"
      >
        Il legame fra ricerca e acquisto si prepara da subito.
      </h2>
      <p class="text-center fs-card-body max-w-3xl mx-auto mb-7" data-reveal data-reveal-delay="0.14">
        Oggi i due siti si misurano ciascuno per conto suo. Il primo passo non aspetta il&nbsp;legame.
      </p>
      {/* Il ponte fra i due siti: tratteggiato, perché è quello che si verifica. */}
      <div class="cv-ponte" data-reveal data-reveal-delay="0.18" aria-hidden="true">
        <span class="cv-ponte-s"><small>la ricerca</small>trenitalia.com</span>
        <span class="cv-ponte-l">
          <svg viewBox="0 0 200 8" preserveAspectRatio="none"><line x1="0" y1="4" x2="200" y2="4" stroke="currentColor" stroke-width="2" stroke-dasharray="6 6" vector-effect="non-scaling-stroke"/></svg>
          <em>la stessa persona?</em>
        </span>
        <span class="cv-ponte-s"><small>l’acquisto</small>Le Frecce</span>
      </div>
      <div class="w-full max-w-6xl mx-auto grid md:grid-cols-3 gap-5" data-stagger>
        {verifica.map((c, i) => (
          <div class:list={['fs-card text-left h-full', i === 1 && 'cv-card--ok']}>
            <p class="fs-card-title mb-2" style="font-size: 1.1rem;">{c.k}</p>
            <p class="fs-card-body">{lega(c.v)}</p>
          </div>
        ))}
      </div>
      <p class="text-center fs-card-body max-w-3xl mx-auto mt-6" data-reveal data-reveal-delay="0.3">
        Finché il legame non c’è, l’acquisto su Le Frecce si legge in aggregato.
      </p>
    </Slide>

    <!-- ── Come arriva un pubblico a Target ─────────────────────────────── -->
    {/* Chiesta dal panel del 22 nov 2026: «Target lo riceve» taceva il come. Il
        passaggio usa la destinazione Adobe Target di Experience Platform, che si
        abilita nella proposta: al cliente non si propone una piattaforma da gestire.
        La latenza e la residenza dei dati si dicono «da confermare» finché non lo sono. */}
    <Slide id="slide-catena" bg="primary" align="center" data-solution="cja">
      <div slot="backdrop" class="absolute inset-0">
        <div class="fs-bg"></div>
        <div class="fs-grid"></div>
      </div>
      <Sfondo slot="backdrop" id="tc-acciaio" forza="forte" />
      <p class="fs-panel-tag text-center mb-3" data-reveal>COME ARRIVA UN PUBBLICO A TARGET</p>
      <h2
        class="text-center text-[var(--ink-primary)] mb-5 font-[family-name:var(--font-display)]"
        style="font-size: clamp(1.7rem, 2.7vw, 2.4rem); font-weight: 600; line-height: 1.06; letter-spacing: -0.02em;"
        data-reveal data-reveal-delay="0.08"
      >
        La raccolta resta com’è; il pubblico passa da Experience Platform.
      </h2>
      <p class="text-center fs-card-body max-w-3xl mx-auto mb-7" data-reveal data-reveal-delay="0.14">
        Un passo alla volta, dal dato raccolto alla proposta in pagina.
      </p>
      <ol class="cv-catena" data-reveal data-reveal-delay="0.2">
        {catena.map((c, i) => (
          <li class:list={['cv-anello', c.nuovo && 'cv-anello--nuovo']} data-substep={i > 0 ? '' : undefined}>
            <span class="cv-anello-k">{c.k}</span>
            <span class="cv-anello-v">{lega(c.v)}</span>
          </li>
        ))}
      </ol>
      <div class="w-full max-w-6xl mx-auto grid md:grid-cols-3 gap-5 mt-7" data-stagger>
        {catenaNote.map((c) => (
          <div class="fs-card text-left h-full">
            <p class="fs-card-title mb-2" style="font-size: 1.05rem;">{c.k}</p>
            <p class="fs-card-body">{lega(c.v)}</p>
          </div>
        ))}
      </div>
    </Slide>

    <!-- ── Con il CRM ─────────────────────────────────────────────────── -->
    <Slide id="slide-dove-sta-il-dato" bg="primary" align="center" data-solution="cja">
      <div slot="backdrop" class="absolute inset-0">
        <div class="fs-bg"></div>
        <div class="fs-grid"></div>
      </div>
      <Sfondo slot="backdrop" id="rl-quiete" forza="media" />
      <p class="fs-panel-tag text-center mb-3" data-reveal>NEL PRIMO PASSO · IL CRM</p>
      <h2
        class="text-center text-[var(--ink-primary)] mb-5 font-[family-name:var(--font-display)]"
        style="font-size: clamp(1.7rem, 2.7vw, 2.4rem); font-weight: 600; line-height: 1.06; letter-spacing: -0.02em;"
        data-reveal data-reveal-delay="0.08"
      >
        Il CRM resta in Salesforce; in CJA entra lo status del cliente.
      </h2>
      <p class="text-center fs-card-body max-w-3xl mx-auto mb-7" data-reveal data-reveal-delay="0.14">
        È il dato che porta il livello del cliente nei casi su trenitalia.com.
      </p>
      <div class="w-full max-w-6xl mx-auto grid md:grid-cols-3 gap-5" data-stagger>
        {crm.map((c, i) => (
          <div class:list={['fs-card text-left h-full', i === 2 && 'cv-card--nota']}>
            <p class="fs-card-title mb-2" style="font-size: 1.1rem;">{c.k}</p>
            <p class="fs-card-body">{lega(c.v)}</p>
          </div>
        ))}
      </div>
    </Slide>

    <!-- ── Che cosa si vede in CJA ─────────────────────────────────────── -->
    <Slide id="slide-demo-cja" bg="secondary" align="center" data-solution="cja">
      <div slot="backdrop" class="absolute inset-0">
        <div class="fs-bg-soft"></div>
        <div class="fs-grid"></div>
      </div>
      <Sfondo slot="backdrop" id="rl-quiete" forza="media" />
      <div data-demo-flex class="w-full flex items-start gap-8">
        <div class="flex-1 min-w-0 flex flex-col items-center">
          <p class="fs-panel-tag mb-3" data-reveal>ADOBE CUSTOMER JOURNEY ANALYTICS</p>
          <h2
            class="text-center text-[var(--ink-primary)] mb-5 font-[family-name:var(--font-display)]"
            style="font-size: clamp(1.7rem, 2.7vw, 2.4rem); font-weight: 600; line-height: 1.06; letter-spacing: -0.02em;"
            data-reveal data-reveal-delay="0.08"
          >
            Dalla ricerca all’acquisto, su una riga sola.
          </h2>
          <p class="text-center fs-card-body max-w-3xl mx-auto mb-6" data-reveal data-reveal-delay="0.14">
            Con il secondo passo, la ricerca su trenitalia.com e l’acquisto su Le&nbsp;Frecce stanno in una lettura sola.
          </p>
          <div class="w-full max-w-4xl mx-auto grid md:grid-cols-3 gap-3 mb-4" data-stagger>
            {letture.map((m) => (
              <div class="fs-card text-center !py-5">
                <p class="fs-stat-value mb-1.5" style="font-size: clamp(1.8rem, 3vw, 2.6rem);">{m.metric}</p>
                <p class="fs-card-title mb-1" style="font-size: 1rem;">{lega(m.label)}</p>
                <p class="fs-card-body" style="font-size: 0.95rem;">{lega(m.sub)}</p>
              </div>
            ))}
          </div>
          <p class="fs-panel-src text-center">Esempio illustrativo su dati simulati · Adobe Customer Journey Analytics</p>
        </div>
        <MediaDemoSlot id="cja-workspace-demo" label="CJA Workspace — Demo FS Journey" />
      </div>
    </Slide>

    <!-- ── Coworker: chiedere perché ───────────────────────────────────── -->
    <Slide id="slide-coworker" bg="primary" align="center" data-solution="cja">
      <div slot="backdrop" class="absolute inset-0">
        <div class="fs-bg"></div>
        <div class="fs-grid"></div>
      </div>
      <Sfondo slot="backdrop" id="tc-strati" forza="media" />
      <p class="fs-panel-tag text-center mb-3" data-reveal>ADOBE CX ENTERPRISE COWORKER</p>
      <h2
        class="text-center text-[var(--ink-primary)] mb-5 font-[family-name:var(--font-display)]"
        style="font-size: clamp(1.7rem, 2.7vw, 2.4rem); font-weight: 600; line-height: 1.06; letter-spacing: -0.02em;"
        data-reveal data-reveal-delay="0.08"
      >
        Il pubblico si chiede a parole, invece di costruirlo a mano.
      </h2>
      <p class="text-center fs-card-body max-w-3xl mx-auto mb-7" data-reveal data-reveal-delay="0.14">
        Coworker prepara il pubblico e la bozza della prova; la approva e la pubblica il team Target.
      </p>
      <div class="w-full max-w-5xl mx-auto grid md:grid-cols-2 gap-5" data-stagger>
        <div class="fs-card text-left">
          <p class="fs-card-title mb-2" style="font-size: 1.1rem;">Oggi</p>
          <p class="fs-card-body">Una regola scritta a mano da chi conosce il modello dati, e un’ipotesi alla volta.</p>
        </div>
        <div class="fs-card cv-card--ok text-left">
          <p class="fs-card-title mb-2" style="font-size: 1.1rem;">Con Coworker</p>
          <p class="fs-card-body">«Perché su questa tratta si perde più gente?» Lo strumento cerca dove il dato si discosta, poi le cause.</p>
        </div>
      </div>
      <p class="fs-panel-src text-center mt-6" data-reveal data-reveal-delay="0.3">
        Disponibile da giugno 2026, attivato per gradi; dentro CJA è ancora in prova limitata, e la risposta può mescolare l’inglese. I casi reggono anche senza ·
        <a href="https://experienceleague.adobe.com/en/docs/analytics-platform/using/cja-workspace/coworker" target="_blank" rel="noopener noreferrer">Coworker in Customer Journey Analytics</a>
      </p>
      <div class="mt-6 text-center" data-reveal data-reveal-delay="0.38">
        <a
          href={href(base, next)}
          class="inline-flex items-center gap-3 px-8 py-3.5 text-base font-semibold tracking-wide bg-[var(--accent-primary)] text-white hover:opacity-90 transition-opacity duration-300 font-[family-name:var(--font-display)] rounded-sm"
        >
          I casi d’uso, passo per passo
          <svg width="18" height="18" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>
    </Slide>

  </DeckContainer>
</BaseLayout>

<style is:global>
  .cv-apri { margin-top: clamp(1rem, 2.6vh, 1.8rem); text-align: center; }
  .cv-apri-b {
    min-height: 2.75rem; padding: 0.6rem 1.4rem; border-radius: 0.4rem;
    border: 1.5px solid var(--color-rosso-chiaro); background: transparent;
    font-family: var(--font-display); font-weight: 600; font-size: clamp(1rem, 1.05vw, 1.15rem);
    color: var(--ink-primary); cursor: pointer;
  }
  .cv-apri-b:hover { background: rgba(217, 24, 53, 0.22); }
  .cv-catena {
    list-style: none; margin: 0 auto; padding: 0; width: 100%; max-width: 76rem;
    display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: clamp(0.5rem, 1vw, 1rem);
  }
  .cv-anello {
    position: relative; display: grid; gap: 0.3rem; align-content: start;
    padding: 0.9rem 1rem; border-radius: 0.6rem;
    border: 1.5px solid rgba(255, 255, 255, 0.5); background: rgba(255, 255, 255, 0.07); text-align: left;
  }
  .cv-anello--nuovo { border-color: rgba(79, 189, 180, 0.8); background: rgba(0, 102, 102, 0.26); }
  .cv-anello:not(:first-child) { padding-left: 2rem; }
  .cv-anello:not(:first-child)::before {
    content: '→'; position: absolute; left: 0.6rem; top: 0.9rem;
    color: var(--color-verde-chiaro); font-size: 1.1rem; line-height: 1.2;
  }
  .cv-anello-k { font-family: var(--font-display); font-weight: 600; font-size: clamp(1rem, 1.1vw, 1.2rem); line-height: 1.2; color: var(--ink-primary); }
  .cv-anello-v { font-size: clamp(0.92rem, 0.98vw, 1.02rem); line-height: 1.4; color: var(--ink-secondary); }
  @media (max-width: 900px) {
    .cv-catena { grid-template-columns: minmax(0, 1fr); }
    .cv-anello:not(:first-child)::before { display: none; }
    .cv-anello:not(:first-child) { padding-left: 1rem; }
  }
  .cv-ponte {
    width: 100%; max-width: 52rem; margin: 0 auto clamp(1.2rem, 3vh, 2rem);
    display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: 1rem;
  }
  .cv-ponte-s {
    display: grid; gap: 0.1rem; padding: 0.7rem 1.1rem; border-radius: 0.6rem;
    border: 1.5px solid rgba(255, 255, 255, 0.5); background: rgba(255, 255, 255, 0.07);
    font-family: var(--font-display); font-weight: 600; font-size: clamp(1.05rem, 1.2vw, 1.3rem); color: var(--ink-primary);
  }
