    align-items: start; padding: clamp(0.7rem, 1.4vh, 1rem) clamp(0.9rem, 1.2vw, 1.2rem);
    border-radius: 0.6rem; border: 1px solid rgba(255, 255, 255, 0.2); background: rgba(27, 34, 48, 0.55);
    font-size: clamp(1rem, 1.06vw, 1.12rem); line-height: 1.35; color: var(--ink-primary);
  }
