---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Sfondo from '../../components/Sfondo.astro';
import TreniNavigation from '../../components/TreniNavigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import CoverHero from '@edf/core/blocks/CoverHero.astro';
import MediaDemoSlot from '@edf/core/blocks/immersive/MediaDemoSlot.astro';
import DiagFlusso from '../../components/diagrammi/DiagFlusso.astro';
import DiagFasi from '../../components/diagrammi/DiagFasi.astro';
import { href } from '@edf/core/utils/url.js';
import { rotte } from '../../data/percorso';

const base = import.meta.env.BASE_URL;
// Avanti e indietro vengono dal percorso, non scritti a mano: così spegnere
// un capitolo non lascia una freccia che punta fuori dal percorso.
const { next, prev } = rotte('trenitalia/convergenza');
const currentPath = Astro.url.pathname;

// Le fonti che confluiscono nel layer, e il percorso che ne esce. L'elenco
// dichiara il perimetro: due fonti nella prima fase, e le altre in attesa.
// Teneva cinque fonti tutte sullo stesso piano, cioè la promessa di
// un'integrazione che non è sul tavolo.
const fonti = [
  'Adobe Analytics · trenitalia.com — prima fase',
  'Salesforce Data Cloud · attributi CRM — prima fase',
  'Adobe Analytics · Frecce — dopo',
  'Piattaforma email e app · dopo',
];

const percorsoLeggibile = [
  // Mai un identificativo di loyalty a schermo: il mock è pseudonimo, e la
  // slide lo dichiara «dati simulati».
  'Davide, riconosciuto al login come cliente CartaFreccia',
  'Le ricerche e le pagine viste, in ordine di tempo',
  'Accanto: livello carta, abbonamenti, storico acquisti',
  'Dove si ferma, e quante volte torna prima di comprare',
];

// Richiamo sintetico della tabella delle fasi, che vive in una copia sola nel
// capitolo «Il percorso»: stesse etichette, stesso ordine dei prodotti. Qui non
// si ridisegna, e prerequisiti, chi esegue e cosa si misura non si ripetono —
// due roadmap nello stesso ramo erano due piani diversi per chi gira il deck.
const fasiCja = [
  { n: 'Fase 1', nome: 'Analisi', durata: 'subito', esito: 'Customer Journey Analytics su trenitalia.com e sugli attributi del CRM: le domande di questo capitolo trovano una risposta.' },
  { n: 'Fase 2', nome: 'Attivazione', durata: 'a seguire', esito: 'I segmenti escono verso Adobe Target e verso le campagne. Qui serve il passaggio di Real-Time CDP, da mettere a contratto prima.' },
  { n: 'Fase 3', nome: 'Estensione', durata: 'nel tempo', esito: 'Le Frecce, la piattaforma di invio, e la collaborazione fra società: una fonte per volta, quando la prima fase ha una baseline.' },
];
---
<BaseLayout
  title="Cosa si legge, cosa si attiva"
  description="Customer Journey Analytics connette le due istanze Adobe Analytics e tutti i sistemi, senza disruption, in fasi incrementali."
  pageSolutions={['cja']}
  branch="trenitalia"
>
  <div class="fixed top-0 left-0 right-0 z-50">
    <TreniNavigation currentPath={currentPath} base={base} branch="trenitalia" />
  </div>

  <DeckContainer wallScale
    nextHref={href(base, next)}
    prevHref={href(base, prev)}
  >

    <!-- ── SLIDE 0: Cover ─────────────────────────────────────────── -->
    <Slide id="slide-cover" bg="primary" align="center" data-solution="cja">
      <div slot="backdrop" class="absolute inset-0">
        <div class="fs-bg"></div>
      <Sfondo slot="backdrop" id="rl-binari" forza="leggera" />
        <div class="fs-grid"></div>
      </div>
      <CoverHero
        eyebrow="Capitolo 03 · Convergenza"
        numeral="03"
        title="CJA: il layer di convergenza"
        lead="Una vista unica del journey, senza migrare né dismettere nulla. CJA lavora sopra i sistemi che già avete, senza toccarli, e li fa parlare tra loro."
        size="phase"
        tone="ink"
        signature={false}
      />

      <!-- Le fonti come stazioni che convergono su un nodo unico -->
      <div class="relative w-full max-w-3xl mx-auto mt-9 mb-1" data-reveal data-reveal-delay="0.3">
        <div class="fs-line-h" style="top: 1.45rem; left: 8%; right: 8%;"></div>
        <div class="relative flex justify-between items-start px-[4%]">
          <div class="flex flex-col items-center gap-2.5 text-center">
            <span class="fs-node" data-active>AA</span>
            <span class="fs-node-label">Sistemi frammentati</span>
          </div>
          <div class="flex flex-col items-center gap-2.5 text-center">
            <span class="fs-node fs-node--alt" data-active>CJA</span>
            <span class="fs-node-label">Il layer di convergenza</span>
          </div>
          <div class="flex flex-col items-center gap-2.5 text-center">
            <span class="fs-node" data-active>1</span>
            <span class="fs-node-label">Un journey leggibile</span>
          </div>
        </div>
      </div>
    </Slide>

    <!-- ── SLIDE 1: CJA come hub di convergenza ──────────────────── -->
    <Slide id="slide-convergenza" bg="primary" align="center" data-solution="cja">
      <div slot="backdrop" class="absolute inset-0">
        <div class="fs-bg"></div>
        <div class="fs-grid"></div>
      </div>
      <Sfondo slot="backdrop" id="tc-strati" forza="forte" />
      <p class="fs-panel-tag text-center mb-4 flex items-center justify-center gap-3 flex-wrap" data-reveal>
        <span>COME FUNZIONA · CONNETTORI NATIVI, I DATI ENTRANO IN AEP</span>
        {/* Lo stesso marchio che porta il mock del ramo FS Park: quello che si
            vede qui è un esempio, non un record. */}
        <span class="font-bold px-2 py-0.5 rounded-sm tracking-wide" style="font-size: 0.68rem; background: rgba(var(--sig-rgb), 0.16); color: rgba(var(--sig-rgb), 0.98);">
          Dati simulati
        </span>
      </p>
      <h2
        class="text-center text-[var(--ink-primary)] mb-6 font-[family-name:var(--font-display)]"
        style="font-size: clamp(1.6rem, 2.5vw, 2.2rem); font-weight: 600; line-height: 1.05; letter-spacing: -0.02em;"
        data-reveal
        data-reveal-delay="0.08"
      >
        Due fonti in un'unica vista. Le altre quando serve.
      </h2>

      {/* Fonti separate → il layer che le legge → un percorso unico. Il
          diagramma sostituisce le tre colonne fatte a mano che dicevano la
          stessa cosa con tre strutture diverse. */}
      {/* text-left: la slide è centrata e il diagramma eredita il centramento,
          così le tappe sulla linea escono allineate al centro e i pallini della
          rotaia restano orfani a sinistra. */}
      <div class="w-full max-w-6xl mx-auto text-left" data-reveal data-reveal-delay="0.2">
        <DiagFlusso
          fonti={fonti}
          layer="Customer Journey Analytics"
          esito={percorsoLeggibile}
        />
      </div>

      <p
        class="text-[var(--ink-secondary)] leading-relaxed mx-auto mt-7 text-center"
        style="font-size: clamp(0.95rem, 1.1vw, 1.05rem); max-width: 52rem;"
        data-reveal
        data-reveal-delay="0.3"
      >
        Le frecce vanno in una direzione sola. I dataset entrano in Adobe Experience Platform e
        si modellano su uno schema comune; nessuna delle fonti cambia mestiere, e nessuna viene
        sostituita. <strong class="text-[var(--ink-primary)]">Salesforce Data Cloud resta master
        del profilo, e master del consenso e della soppressione.</strong>
      </p>
    </Slide>

    <!-- ── SLIDE 1b: CJA è / non è — disambiguazione ─────────────── -->
    <Slide id="slide-cja-vs-cdp" bg="secondary" align="center" data-solution="cja">
      <div slot="backdrop" class="absolute inset-0">
        <div class="fs-bg-soft"></div>
      <Sfondo slot="backdrop" id="tc-quiete" forza="media" />
        <div class="fs-grid"></div>
      </div>
      <p class="fs-panel-tag text-center mb-4" data-reveal>
        DISAMBIGUAZIONE · CJA ≠ CDP
      </p>
      <h2
        class="text-center text-[var(--ink-primary)] mb-4 font-[family-name:var(--font-display)]"
        style="font-size: clamp(1.8rem, 3vw, 2.5rem); font-weight: 600; line-height: 1.05; letter-spacing: -0.02em;"
        data-reveal
        data-reveal-delay="0.08"
      >
        Cosa fa CJA, e cosa no.
      </h2>
      <p
        class="text-center text-[var(--ink-secondary)] leading-snug max-w-3xl mx-auto mb-7"
        style="font-size: clamp(0.95rem, 1.1vw, 1.05rem);"
        data-reveal
        data-reveal-delay="0.12"
      >
        «Ma abbiamo già una CDP» è l'obiezione più comune. CJA non è la CDP operativa (Salesforce
        Data Cloud): è l'analytics del journey. La CDP attiva i profili, CJA legge il viaggio: servono entrambe.
      </p>

      <div class="w-full max-w-5xl mx-auto grid md:grid-cols-2 gap-6" data-reveal data-reveal-delay="0.16">
        <div class="fs-panel text-left">
          <p class="text-[0.85rem] font-bold tracking-widest uppercase text-emerald-400 mb-4">CJA È · Analytics</p>
          <ul class="space-y-3.5 text-[1rem] text-[var(--color-grigio-200)] leading-snug">
            <li class="flex gap-3"><span class="text-emerald-400 flex-shrink-0 mt-px">✓</span>Legge e analizza il journey cross-sistema</li>
            <li class="flex gap-3"><span class="text-emerald-400 flex-shrink-0 mt-px">✓</span>Connette segnali da fonti diverse in un'unica timeline</li>
            <li class="flex gap-3"><span class="text-emerald-400 flex-shrink-0 mt-px">✓</span>Produce insight, segmenti e attribution</li>
          </ul>
        </div>
        <div class="fs-panel fs-panel--alt text-left">
          <p class="text-[0.85rem] font-bold tracking-widest uppercase text-[var(--accent-primary)] mb-4">CJA NON È · non sostituisce una CDP</p>
          <ul class="space-y-3.5 text-[1rem] text-[var(--color-grigio-200)] leading-snug">
            <li class="flex gap-3"><span class="text-[var(--accent-primary)] flex-shrink-0 mt-px">✗</span>Non raccoglie profili operativi real-time (è Real-Time CDP)</li>
            <li class="flex gap-3"><span class="text-[var(--accent-primary)] flex-shrink-0 mt-px">✗</span>Non invia campagne né messaggi (è AJO + la piattaforma di esecuzione email)</li>
            <li class="flex gap-3"><span class="text-[var(--accent-primary)] flex-shrink-0 mt-px">✗</span>Non sostituisce la piattaforma di esecuzione email né Salesforce CRM</li>
          </ul>
        </div>
      </div>
    </Slide>

    <!-- ── SLIDE 1c: Dove sta il dato ──────────────────────────────── -->
    {/* La domanda arrivata in riunione era «sto duplicando la base dati?». La
        risposta onesta è che per CJA il dato entra: non esiste oggi una lettura
        in sede per l'analisi, e prometterla si paga al primo tavolo con il loro
        cyber. Quello che si governa è quanto dato entra e con che etichette. */}
    <Slide id="slide-dove-sta-il-dato" bg="secondary" align="center" data-solution="cja">
      <div slot="backdrop" class="absolute inset-0">
        <div class="fs-bg-soft"></div>
        <Sfondo slot="backdrop" id="tc-quiete" forza="media" />
        <div class="fs-grid"></div>
      </div>
      <p class="fs-panel-tag text-center mb-4" data-reveal>
        LA DOMANDA TECNICA · DOVE FINISCE IL DATO DEL CRM
      </p>
      <h2
        class="text-center text-[var(--ink-primary)] mb-4 font-[family-name:var(--font-display)]"
        style="font-size: clamp(1.7rem, 2.7vw, 2.4rem); font-weight: 600; line-height: 1.06; letter-spacing: -0.02em;"
        data-reveal
        data-reveal-delay="0.08"
      >
        Il dato entra. Si decide quanto.
      </h2>
      <p
        class="text-center text-[var(--ink-secondary)] mx-auto mb-7"
        style="font-size: clamp(0.98rem, 1.1vw, 1.08rem); line-height: 1.55; max-width: 52rem;"
        data-reveal
        data-reveal-delay="0.12"
      >
        CJA analizza quello che è stato portato dentro Adobe Experience Platform: una lettura
        che lasci il dato alla fonte e lo interroghi da fuori oggi non c'è. La leva non è
        evitare la copia, è scegliere cosa copiare.
      </p>

      <div class="w-full max-w-6xl mx-auto grid md:grid-cols-3 gap-5" data-reveal data-reveal-delay="0.18">
        <div class="fs-card text-left h-full">
          <p class="fs-card-title mb-2.5" style="font-size: 1.05rem;">Quello che entra</p>
          <ul class="space-y-2.5">
            <li class="fs-card-body">Gli attributi che servono all'analisi, non la base dati: livello carta, stato dell'abbonamento, sintesi dello storico.</li>
            <li class="fs-card-body">Entrano come Profile dataset, accanto agli eventi di navigazione, sulla stessa chiave di persona.</li>
          </ul>
        </div>
        <div class="fs-card text-left h-full">
          <p class="fs-card-title mb-2.5" style="font-size: 1.05rem;">Come entra</p>
          <ul class="space-y-2.5">
            <li class="fs-card-body">File su SFTP, chiamate verso le API, oppure in continuo dall'Edge come già arriva il dato di Analytics.</li>
            <li class="fs-card-body">La scelta fra le tre è un tema da chiudere con l'IT e con chi presidia il CRM.</li>
          </ul>
        </div>
        <div class="fs-card text-left h-full">
          <p class="fs-card-title mb-2.5" style="font-size: 1.05rem;">Quello che resta dov'è</p>
          <ul class="space-y-2.5">
            <li class="fs-card-body">Salesforce Data Cloud resta master del profilo, del consenso e delle liste di soppressione.</li>
            <li class="fs-card-body">Gli attributi copiati portano le etichette d'uso del dato e le politiche che ne governano l'impiego.</li>
          </ul>
        </div>
      </div>

      <div class="fs-panel fs-panel--alt w-full max-w-6xl mx-auto text-left mt-6 !py-3.5" data-reveal data-reveal-delay="0.3">
        <p class="fs-panel-body">
          <strong class="text-[var(--ink-primary)]">Da dire prima:</strong> in Adobe esiste un modo
          per lasciare il dato nel magazzino e interrogarlo a distanza, ma serve a comporre audience,
          non ad alimentare l'analisi di cui si parla qui. Una clean room lavora invece su indicatori
          che stanno fuori dal data lake: è un'altra cosa ancora, e viene dopo.
        </p>
        <p class="fs-panel-src mt-1.5">Verificato il 9 ott 2026 su documentazione Adobe</p>
      </div>
    </Slide>

    <!-- ── SLIDE 2: Demo CJA Workspace ───────────────────────────── -->
    <Slide id="slide-demo-cja" bg="primary" align="center" data-solution="cja">
      <div slot="backdrop" class="absolute inset-0">
        <div class="fs-bg"></div>
      <Sfondo slot="backdrop" id="rl-quiete" forza="media" />
        <div class="fs-grid"></div>
      </div>
      <div data-demo-flex class="w-full flex items-start gap-8">
        <div class="flex-1 min-w-0 flex flex-col items-center">
          <p class="fs-panel-tag mb-4" data-reveal>
            ADOBE CUSTOMER JOURNEY ANALYTICS
          </p>
          <h2
            class="text-[var(--ink-primary)] mb-4 font-[family-name:var(--font-display)]"
            style="font-size: clamp(1.75rem, 3.2vw, 2.9rem); font-weight: 600; line-height: 1.05; letter-spacing: -0.02em;"
            data-reveal
            data-reveal-delay="0.08"
          >
            Lo stesso cliente,<br/>letto da due sistemi.
          </h2>
          <p
            class="text-[var(--ink-secondary)] leading-normal max-w-2xl mb-5"
            style="font-size: clamp(0.95rem, 1.1vw, 1.05rem);"
            data-reveal
            data-reveal-delay="0.14"
          >
            CJA Workspace mette su una timeline sola le ricerche e le pagine viste su
            trenitalia.com, e accanto gli attributi che arrivano dal CRM: livello carta,
            abbonamenti, storico degli acquisti. Lo stesso cliente, letto da due sistemi che
            oggi si guardano da lontano.
          </p>

          <div
            class="w-full max-w-4xl mx-auto grid md:grid-cols-3 gap-3 mb-4"
            data-reveal
            data-reveal-delay="0.2"
          >
            {[
              { metric: 'Cosa cerca', label: 'chi poi compra, e chi no', sub: 'Oggi le ricerche restano separate dal profilo di chi le ha fatte' },
              { metric: 'Dove si ferma', label: 'e quante volte torna prima', sub: 'Il flusso si legge per passaggi, non per pagine isolate' },
              { metric: 'Senza estrazioni', label: 'le domande si fanno sul posto', sub: 'Oggi una risposta che incrocia due sistemi passa da un\'estrazione e da chi la prepara' },
            ].map((m) => (
              <div class="fs-card text-center">
                <p class="fs-stat-value mb-1.5" style="font-size: clamp(2rem, 3.4vw, 2.9rem);">{m.metric}</p>
                <p class="fs-card-title mb-1" style="font-size: 0.98rem;">{m.label}</p>
                <p class="text-[0.82rem] text-[var(--color-grigio-300)] leading-snug">{m.sub}</p>
              </div>
            ))}
          </div>
          {/* La riga di fonte citava un «benchmark Adobe 2024» che il cliente non
              può aprire, e la tessera che reggeva («<1h time-to-insight») non c'è
              più. Qui si dichiara che cos'è quello che si guarda. */}
          <p class="text-center text-[var(--color-grigio-300)]" style="font-size: 0.82rem; line-height: 1.5;">
            Mock illustrativo su dati simulati · Adobe Customer Journey Analytics
          </p>
        </div>
        <MediaDemoSlot id="cja-workspace-demo" label="CJA Workspace — Demo FS Journey" />
      </div>
    </Slide>

    <!-- ── SLIDE 2b: Che cosa si fa con due fonti ──────────────────── -->
    {/* «Se mi fermo ad analizzare non c'è alcun interesse»: ogni riga qui parte
        da una domanda che oggi resta senza risposta e arriva a cosa si fa con
        la risposta. Gli esempi sono quelli nati in riunione, non i nostri. */}
    <Slide id="slide-use-case" bg="secondary" align="center" data-solution="cja">
      <div slot="backdrop" class="absolute inset-0">
        <div class="fs-bg-soft"></div>
        <Sfondo slot="backdrop" id="rl-banchina" forza="media" />
        <div class="fs-grid"></div>
      </div>
      <p class="fs-panel-tag text-center mb-3" data-reveal>
        CHE COSA SI FA CON QUESTE DUE FONTI
      </p>
      <h2
        class="text-center text-[var(--ink-primary)] mb-6 font-[family-name:var(--font-display)]"
        style="font-size: clamp(1.7rem, 2.7vw, 2.4rem); font-weight: 600; line-height: 1.06; letter-spacing: -0.02em;"
        data-reveal
        data-reveal-delay="0.08"
      >
        Tre domande, e cosa si fa con la risposta.
      </h2>

      <div class="w-full max-w-6xl mx-auto flex flex-col gap-3.5" data-reveal data-reveal-delay="0.16">
        {[
          {
            n: '01',
            domanda: 'Cerca una tratta, ne compra un\'altra. Perché?',
            oggi: 'Le ricerche stanno in Analytics, gli acquisti nel CRM: nessuno può dire se chi cerca Napoli poi la compra o ripiega.',
            uso: 'Un\'offerta sulla tratta cercata e mai comprata, misurata su due settimane.',
          },
          {
            n: '02',
            domanda: 'Chi si ferma lungo il percorso, e che cliente è?',
            oggi: 'Il punto di caduta si vede, la persona dietro no: un abbonato e un visitatore di passaggio contano uguale.',
            uso: 'La priorità di intervento va dove si fermano i clienti che valgono di più.',
          },
          {
            n: '03',
            domanda: 'Il cliente Oro che entra viene trattato come tale?',
            oggi: 'Il livello carta sta nel CRM e non arriva al sito: chi è abbonato da anni vede la pagina di chiunque altro.',
            uso: 'Un canale di contatto riservato, mostrato solo a quel segmento.',
          },
        ].map((uc) => (
          <div class="fs-card text-left !py-4 !px-5">
            <div class="grid md:grid-cols-[auto_minmax(0,1fr)_minmax(0,0.78fr)] gap-x-5 gap-y-2 items-start">
              <span class="fs-mark" aria-hidden="true">{uc.n}</span>
              <div class="min-w-0">
                <p class="fs-card-title mb-1.5" style="font-size: 1.08rem;">{uc.domanda}</p>
                <p class="fs-card-body">{uc.oggi}</p>
              </div>
              <div class="min-w-0 md:border-l md:border-[var(--line-subtle)] md:pl-5">
                <p class="text-[0.78rem] font-semibold tracking-widest uppercase mb-1.5" style="color: rgba(var(--sig-rgb), 0.95);">
                  Cosa si fa
                </p>
                <p class="fs-card-body">{uc.uso}</p>
              </div>
            </div>
          </div>
        ))}
      </div>

      <div class="fs-panel fs-panel--alt w-full max-w-6xl mx-auto text-left mt-5 !py-3.5" data-reveal data-reveal-delay="0.32">
        <p class="fs-panel-body">
          <strong class="text-[var(--ink-primary)]">Fin dove arriva la prima fase:</strong> le tre
          analisi e i tre segmenti si costruiscono qui. Portarli su Adobe Target in automatico
          richiede un passaggio in più, che ha un suo perimetro commerciale: è una voce da chiudere
          insieme prima di partire, non un interruttore da accendere dopo.
        </p>
        <p class="fs-panel-src mt-1.5">Verificato il 9 ott 2026 su documentazione Adobe · scenari illustrativi</p>
      </div>
    </Slide>

    <!-- ── SLIDE 2c: Trovare le cause ─────────────────────────────── -->
    {/* L'obiezione più forte della riunione: «se la regola me la devo
        immaginare da sola, il lavoro l'ho fatto io». È l'unica a cui una
        capability nuova risponde per intero, e non era nelle slide. */}
    <Slide id="slide-coworker" bg="primary" align="center" data-solution="cja">
      <div slot="backdrop" class="absolute inset-0">
        <div class="fs-bg"></div>
        <Sfondo slot="backdrop" id="tc-strati" forza="media" />
        <div class="fs-grid"></div>
      </div>
      <p class="fs-panel-tag text-center mb-3" data-reveal>
        TROVARE LE CAUSE, NON SOLO I NUMERI
      </p>
      <h2
        class="text-center text-[var(--ink-primary)] mb-3 font-[family-name:var(--font-display)]"
        style="font-size: clamp(1.7rem, 2.7vw, 2.4rem); font-weight: 600; line-height: 1.06; letter-spacing: -0.02em;"
        data-reveal
        data-reveal-delay="0.08"
      >
        Chiedere perché, invece di dettare la regola.
      </h2>
      <div class="w-full max-w-5xl mx-auto grid md:grid-cols-2 gap-6" data-reveal data-reveal-delay="0.18">
        <div class="fs-panel text-left h-full">
          <p class="text-[0.85rem] font-bold tracking-widest uppercase text-[var(--accent-primary)] mb-3.5">Oggi · si parte dall'ipotesi</p>
          <ul class="space-y-3 text-[1rem] text-[var(--color-grigio-200)]" style="line-height: 1.5;">
            <li>«Quanti hanno cercato due volte la stessa tratta negli ultimi tre mesi»: è una regola scritta a mano.</li>
            <li>Serve chi conosce il modello dati e sa dove guardare, e si procede per esclusione.</li>
            <li>Le ipotesi che nessuno formula restano fuori dall'analisi.</li>
          </ul>
        </div>
        <div class="fs-panel text-left h-full">
          <p class="text-[0.85rem] font-bold tracking-widest uppercase text-emerald-400 mb-3.5">Con Coworker · si parte dalla domanda</p>
          <ul class="space-y-3 text-[1rem] text-[var(--color-grigio-200)]" style="line-height: 1.5;">
            <li>«Perché su questo tipo di ricerca si perde più gente che sull'altro»: la domanda si scrive in italiano.</li>
            <li>Lo strumento cerca prima dove il dato si discosta, poi risale alle cause.</li>
            <li>La competenza di analisi smette di essere di poche persone.</li>
          </ul>
        </div>
      </div>

      <div class="fs-panel fs-panel--alt w-full max-w-5xl mx-auto text-left mt-6 !py-3.5" data-reveal data-reveal-delay="0.3">
        <p class="fs-panel-body">
          <strong class="text-[var(--ink-primary)]">Stato.</strong> Adobe CX Enterprise Coworker è
          stato rilasciato a giugno 2026 e distribuito per gradi da luglio; l'analisi dei dati di
          Customer Journey Analytics in chat è nelle note di rilascio di luglio. Ha una licenza
          propria, quindi entra nel conto dei costi insieme a tutto il resto.
        </p>
        <p class="fs-panel-src mt-1.5">
          Fonti: note di rilascio CJA lug 2026 · Experience League, «CJA &amp; Coworker — Root Cause
          Analysis», agg. 7 ott 2026
        </p>
      </div>
    </Slide>

    <!-- ── SLIDE 3: Content Analytics ────────────────────────────── -->
    <Slide id="slide-content-analytics" bg="secondary" align="center" data-solution="cja">
      <div slot="backdrop" class="absolute inset-0">
        <div class="fs-bg-soft"></div>
      <Sfondo slot="backdrop" id="tc-acciaio" forza="media" />
        <div class="fs-grid"></div>
      </div>
      <p class="fs-panel-tag text-center mb-4" data-reveal>
        ADOBE CONTENT ANALYTICS · SU AEM — OLTRE LA PRIMA FASE
      </p>
      <h2
        class="text-[var(--ink-primary)] mb-4 font-[family-name:var(--font-display)]"
        style="font-size: clamp(1.6rem, 2.6vw, 2.4rem); font-weight: 600; line-height: 1.06; letter-spacing: -0.02em;"
        data-reveal
        data-reveal-delay="0.08"
      >
        Quale contenuto converte davvero?
      </h2>
      <p
        class="text-[var(--ink-secondary)] leading-snug max-w-2xl mx-auto mb-6"
        style="font-size: clamp(0.95rem, 1.25vw, 1.15rem);"
        data-reveal
        data-reveal-delay="0.14"
      >
        Content Analytics si appoggia a una connessione e a una data view CJA, ma è un prodotto a licenza separata (standalone da febbraio 2026), analizza le caratteristiche
        dei contenuti (formato, stile visivo, posizione, lunghezza) e le correla con engagement
        e conversione. Il team editoriale AEM ottimizza sui dati, non più a intuito.
      </p>

      <div
        class="w-full max-w-4xl mx-auto grid md:grid-cols-2 gap-5"
        data-reveal
        data-reveal-delay="0.2"
      >
        {[
          {
            label: 'Attributi analizzati',
            rosso: false,
            items: [
              'Immagini: soggetto, colore, composizione',
              'Testo: tono, lunghezza, call-to-action',
              'Layout: posizione, gerarchia visiva',
              'Formato: video vs. carousel vs. hero static',
            ],
          },
          {
            label: 'Insight azionabili per AEM',
            rosso: true,
            items: [
              'Quali offerte homepage generano più click su funnel',
              'Quali CTA X-GO e CartaFreccia convertono meglio',
              'Stagionalità dei contenuti ad alto engagement',
              'Ipotesi di test suggerite dagli attributi che performano, da eseguire su Adobe Target',
            ],
          },
        ].map((col) => (
          <div class="fs-panel text-left" class:list={[col.rosso && 'fs-panel--alt']}>
            <p class="fs-panel-tag mb-3" style={col.rosso ? 'color: rgba(var(--sig2-rgb), 0.98);' : ''}>{col.label}</p>
            <ul class="space-y-1.5">
              {col.items.map((item) => (
                <li class="flex items-start gap-2.5 text-[0.96rem] leading-tight text-[var(--color-grigio-200)]">
                  <span class={`flex-shrink-0 mt-1.5 w-1.5 h-1.5 rounded-full ${col.rosso ? 'bg-[var(--accent-primary)]' : 'bg-[rgba(var(--sig-rgb), 0.95)]'}`} aria-hidden="true"/>
                  {item}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>

      {/* Il prerequisito va detto qui, non scoperto dal loro IT fra un mese:
          Content Analytics raccoglie con Adobe Web SDK, e trenitalia.com oggi
          raccoglie con at.js e AppMeasurement. */}
      <p
        class="mx-auto mt-5 text-center text-[var(--color-grigio-300)]"
        style="font-size: 0.85rem; line-height: 1.5; max-width: 52rem;"
        data-reveal
        data-reveal-delay="0.28"
      >
        Un prerequisito, dichiarato prima: Content Analytics raccoglie con Adobe Web SDK, mentre
        le property oggi raccolgono con at.js e AppMeasurement. Il passaggio va messo in conto
        come attività, sulle sole property che si vogliono misurare.
      </p>
    </Slide>

    <!-- ── SLIDE 4: Le 3 fasi ─────────────────────────────────────── -->
    <Slide id="slide-fasi" bg="primary" align="center" data-solution="cja">
      <div slot="backdrop" class="absolute inset-0">
        <div class="fs-bg"></div>
      <Sfondo slot="backdrop" id="rl-binari" forza="forte" />
        <div class="fs-grid"></div>
      </div>
      <div class="w-full max-w-5xl mx-auto text-center">
        <p class="fs-panel-tag mb-3" data-reveal>
          APPROCCIO GRADUALE · SENZA SALTI NEL VUOTO
        </p>
        <h2
          class="text-[var(--ink-primary)] mb-5 font-[family-name:var(--font-display)]"
          style="font-size: clamp(1.6rem, 2.9vw, 2.6rem); font-weight: 600; line-height: 1.05; letter-spacing: -0.02em;"
          data-reveal
          data-reveal-delay="0.08"
        >
          Si legge, poi si attiva, e solo dopo si allarga.
        </h2>
      </div>

      {/* Le fasi sull'asse del tempo: la barra dice quanto dura, la riga sotto
          che cosa consegna. Prima era un elenco in colonna con i numeri a lato.
          Il lead che stava qui («nessun sistema viene dismesso») è già nella
          copertina del capitolo: ripeterlo alzava il titolo fuori banda. */}
      <div class="w-full max-w-6xl mx-auto mt-6" data-reveal data-reveal-delay="0.22">
        <DiagFasi fasi={fasiCja} />
      </div>

      <p class="mx-auto mt-5 text-center text-[var(--color-grigio-300)]" style="font-size: 0.85rem; line-height: 1.5; max-width: 52rem;" data-reveal data-reveal-delay="0.3">
        Ipotesi di percorso per discussione, tempistiche da definire con FSTechnology. Prerequisiti,
        chi esegue e cosa si misura per ciascuna fase stanno nel capitolo «Il percorso», in una copia sola.
      </p>

      <div class="mt-4 text-center" data-reveal data-reveal-delay="0.38">
        <a
          href={href(base, next)}
          class="inline-flex items-center gap-3 px-8 py-3.5 text-base font-semibold tracking-wide bg-[var(--accent-primary)] text-white hover:opacity-90 transition-opacity duration-300 font-[family-name:var(--font-display)] rounded-sm"
        >
          Il percorso e la decisione
          <svg width="18" height="18" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>
    </Slide>

  </DeckContainer>
</BaseLayout>
