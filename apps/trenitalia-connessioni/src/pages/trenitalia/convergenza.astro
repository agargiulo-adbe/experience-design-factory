---
/**
 * Capitolo 02 — Le tre fasi: dal totale per tratta al cliente riconosciuto.
 *
 * LA STORIA, in breve. Il capitolo nasce il 22 nov 2026 come piano di casi su Adobe
 * Target; il 26 nov, dopo la call con il partner e l'AE, i passi diventano tre fasi:
 *   · fase 0, Vista unica: i due Analytics in CJA come sono, letti per giorno e per
 *     tratta; Target prova varianti per tutti;
 *   · fase 1, la conferma: la traccia della ricerca passa a Le Frecce in un campo in
 *     più del passaggio fra i siti, e la conferma la riporta. Nascono i gruppi;
 *   · fase 2, il login su trenitalia.com: l'unico identificativo persistente, e solo
 *     da qui il CRM (decisione dell'owner).
 *
 * RIDISEGNATO IL 27 NOV 2026, dopo la critica di design. Tre cose:
 *   · i tre cerchi concentrici lasciano il posto al binario (`FiguraBinario`): gli
 *     stessi due siti ripetuti tre volte, e cambia solo il filo nel passaggio. I
 *     cerchi dicevano l'importanza al contrario e non mostravano i due siti;
 *   · la slide «i casi nel tempo» diventa una tabella a tre righe (si legge, Target
 *     può, serve). I casi hanno il loro capitolo, e undici voci qui contro cinque là
 *     era un conto che non tornava;
 *   · quello che serve a FS Technology e al DPO — chi decide e chi lavora, come
 *     arriva un gruppo a Target, il CRM — sta nell'appendice per il team tecnico.
 * La slide con la schermata di CJA esce: annunciava un esempio che in pagina non c'era.
 *
 * IL COLORE vale una cosa sola: rosso è quello che si fa adesso (la fase 0), verde
 * acqua quello che arriva dopo, il tratteggio «non ancora».
 */
import { lega } from '../../utils/lega';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Sfondo from '../../components/Sfondo.astro';
import TreniNavigation from '../../components/TreniNavigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import CoverHero from '@edf/core/blocks/CoverHero.astro';
import DiagDisegno from '../../components/diagrammi/DiagDisegno.astro';
import FiguraBinario from '../../components/figure/FiguraBinario.astro';
import ComeFunziona from '../../components/ComeFunziona.astro';
import { href } from '@edf/core/utils/url.js';
import { rotte } from '../../data/percorso';

const base = import.meta.env.BASE_URL;
const { next, prev } = rotte('trenitalia/convergenza');
const currentPath = Astro.url.pathname;
const h2 = 'font-size: clamp(1.7rem, 2.7vw, 2.4rem); font-weight: 600; line-height: 1.06; letter-spacing: -0.02em;';

/* Il binario: una riga per fase, e nel passaggio fra i due siti cambia il filo. */
const fasi: Parameters<typeof FiguraBinario>[0]['fasi'] = [
  { n: '0', nome: 'Vista unica', quando: 'circa sei settimane dal via',
    filo: 'nessun legame: si leggono i totali', beneficio: 'Si vede dove si perde la vendita.' },
  { n: '1', nome: 'La conferma', quando: 'dopo le prime letture',
    filo: 'una visita, senza un nome', beneficio: 'Si sa quale visita ha comprato.' },
  { n: '2', nome: 'Il login', quando: 'con il login sul sito',
    filo: 'il cliente, con il suo status', beneficio: 'Si riconosce il cliente, anche nell’app.' },
];

/* Le tre fasi in tabella: che cosa si legge, che cosa può fare Target, che cosa
   serve. Niente nomi di caso: quelli stanno nel capitolo dopo, e sono cinque. */
const tabella = [
  { k: 'Si legge',
    v: ['Ricerche, arrivi e conferme, per giorno e per tratta',
        'Quale visita ha poi comprato, senza sapere chi è',
        'Lo stesso cliente sui due siti, con lo status fedeltà'] },
  { k: 'Target può',
    v: ['Provare una variante per tutti, o per area',
        'Parlare a gruppi di visitatori, e misurare fino alla conferma',
        'Fare una proposta al singolo cliente, anche su Le Frecce e in app'] },
  { k: 'Serve',
    v: ['I due Analytics in Customer Journey Analytics. Nessun rilascio sui siti',
        'Per misurare: un campo in più nel passaggio, nessuna licenza nuova. Per i gruppi verso Target: Real-Time CDP',
        'Il login su trenitalia.com e il nuovo portale: decisioni del Gruppo. Target su Le Frecce e in app, da quotare'] },
];

const verifica = [
  { k: 'Che cosa cambia', v: 'Nel passaggio a Le Frecce viaggerebbe un identificativo di visita, senza nome. Sulla pagina di conferma, il tag che c’è già lo riporterebbe con l’acquisto.' },
  { k: 'Chi si riconosce', v: 'Chi passa da trenitalia.com a Le Frecce e ha dato il consenso. Resta fuori chi entra diretto su Le Frecce.' },
  { k: 'Che cosa si sa', v: 'Che quella visita ha comprato. Quale biglietto e a che prezzo, solo se la conferma porta anche quei campi.' },
];
---
<BaseLayout
  title="Le tre fasi"
  description="Tre fasi: i due Analytics letti insieme senza toccare i siti, poi la conferma d’acquisto legata alla ricerca, poi il login su trenitalia.com con lo status dal CRM."
  pageSolutions={['cja']}
  branch="trenitalia"
>
  <div class="fixed top-0 left-0 right-0 z-50">
    <TreniNavigation currentPath={currentPath} base={base} branch="trenitalia" />
  </div>

  <DeckContainer wallScale
    nextHref={href(base, next)}
    prevHref={href(base, prev)}
  >

    <!-- ── Copertina ──────────────────────────────────────────────── -->
    <Slide id="slide-cover" bg="primary" align="center" data-solution="cja">
      <div slot="backdrop" class="absolute inset-0">
        <div class="fs-bg"></div>
        <Sfondo slot="backdrop" id="rl-binari" forza="leggera" />
        <div class="fs-grid"></div>
      </div>
      <CoverHero
        eyebrow="Capitolo 02 · Le tre fasi"
        numeral="02"
        title="Tre fasi, un passo alla volta"
        lead={lega('Che cosa si legge subito, che cosa arriva con la conferma d’acquisto e che cosa con il login.')}
        size="phase"
        tone="ink"
        signature={false}
      />
    </Slide>

    <!-- ── Lo stesso binario, tre volte ──────────────────────────────── -->
    {/* Il primo ↓ accende la fase 1, il secondo la fase 2. */}
    <Slide id="slide-binario" bg="primary" align="center" data-solution="cja">
      <div slot="backdrop" class="absolute inset-0">
        <div class="fs-bg"></div>
        <div class="fs-grid"></div>
      </div>
      <Sfondo slot="backdrop" id="tc-strati" forza="forte" />
      <p class="fs-panel-tag text-center mb-3" data-reveal>LO STESSO PERCORSO, TRE VOLTE</p>
      <h2 class="text-center text-[var(--ink-primary)] mb-6 font-[family-name:var(--font-display)]" style={h2} data-reveal data-reveal-delay="0.08">
        A ogni fase si riconosce meglio chi visita il&nbsp;sito.
      </h2>
      <div class="w-full" data-reveal data-reveal-delay="0.16">
        <FiguraBinario fasi={fasi}
          sinistra={['trenitalia.com', 'dove si cerca']}
          destra={['Le Frecce e l’app', 'dove si compra']} />
      </div>
    </Slide>

    <!-- ── Le tre fasi, in tabella ───────────────────────────────────── -->
    <Slide id="slide-fasi" bg="secondary" align="center" data-solution="cja">
      <div slot="backdrop" class="absolute inset-0">
        <div class="fs-bg-soft"></div>
        <div class="fs-grid"></div>
      </div>
      <Sfondo slot="backdrop" id="tc-quiete" forza="forte" />
      <p class="fs-panel-tag text-center mb-3" data-reveal>CHE COSA DÀ OGNI FASE, E CHE COSA CHIEDE</p>
      <h2 class="text-center text-[var(--ink-primary)] mb-6 font-[family-name:var(--font-display)]" style={h2 + ' text-wrap: balance;'} data-reveal data-reveal-delay="0.08">
        La fase 0 parte senza toccare i siti. Le&nbsp;altre due aspettano un&nbsp;collegamento.
      </h2>
      <div class="cv-tab" role="table" aria-label="Le tre fasi: che cosa si legge, che cosa può fare Target, che cosa serve" data-reveal data-reveal-delay="0.16">
        <div class="cv-tab-r cv-tab-t" role="row">
          <span role="columnheader"></span>
          <span role="columnheader" class="cv-tab-f cv-tab-f--ora"><b>0</b>Vista unica</span>
          <span role="columnheader" class="cv-tab-f"><b>1</b>La conferma</span>
          <span role="columnheader" class="cv-tab-f"><b>2</b>Il login</span>
        </div>
        {tabella.map((r) => (
          <div class="cv-tab-r" role="row">
            <span role="rowheader" class="cv-tab-k">{r.k}</span>
            {r.v.map((x, i) => <span role="cell" class:list={[i === 0 && 'cv-tab-ora']}>{lega(x)}</span>)}
          </div>
        ))}
      </div>
      <p class="fs-panel-src text-center mt-5" data-reveal data-reveal-delay="0.3">
        {lega('Ogni fase riusa la connessione e i campi della precedente. Il CRM e il consenso del cliente restano in Salesforce. I tempi della fase 2 dipendono dal Gruppo.')}
      </p>
    </Slide>

    <!-- ── I prodotti dietro le fasi ─────────────────────────────────── -->
    {/* Il primo stato è la fase 0. Con ↓ entra la conferma, con ↓ ancora il login.
        Il pulsante apre il «come funziona» a passi. */}
    <Slide id="slide-disegno" bg="primary" align="center" data-solution="cja">
      <div slot="backdrop" class="absolute inset-0">
        <div class="fs-bg"></div>
        <div class="fs-grid"></div>
      </div>
      <Sfondo slot="backdrop" id="tc-strati" forza="forte" />
      <p class="fs-panel-tag text-center mb-3" data-reveal>I PRODOTTI DIETRO LE FASI</p>
      <h2 class="text-center text-[var(--ink-primary)] mb-5 font-[family-name:var(--font-display)]" style={h2} data-reveal data-reveal-delay="0.08">
        Due prodotti li avete già. Due si aggiungono, uno per&nbsp;fase.
      </h2>
      <p class="text-center fs-card-body max-w-3xl mx-auto mb-6" style="text-wrap: balance;" data-reveal data-reveal-delay="0.14">
        {lega('Customer Journey Analytics per la fase 0, Real-Time CDP dalla fase 1. Le righe di visita entrano in copia in Experience Platform.')}
      </p>
      <div class="w-full" data-reveal data-reveal-delay="0.2">
        <DiagDisegno />
      </div>
      <div class="cv-apri" data-reveal data-reveal-delay="0.3">
        <button type="button" class="cv-apri-b" data-pp-open aria-haspopup="dialog">Come funziona, dalla fase 0 alla fase 1 →</button>
        <ComeFunziona />
      </div>
    </Slide>

    <!-- ── La fase 1, in concreto ────────────────────────────────────── -->
    <Slide id="slide-verifica" bg="secondary" align="center" data-solution="cja">
      <div slot="backdrop" class="absolute inset-0">
        <div class="fs-bg-soft"></div>
        <div class="fs-grid"></div>
      </div>
      <Sfondo slot="backdrop" id="tc-quiete" forza="media" />
      <p class="fs-panel-tag text-center mb-3" data-reveal>LA FASE 1 · LA CONFERMA D’ACQUISTO</p>
      <h2 class="text-center text-[var(--ink-primary)] mb-7 font-[family-name:var(--font-display)]" style={h2} data-reveal data-reveal-delay="0.08">
        La ricerca e l’acquisto si incontrano sulla pagina di&nbsp;conferma.
      </h2>
      {/* Il ponte fra i due siti: tratteggiato, perché è quello che si verifica. */}
      <div class="cv-ponte" data-reveal data-reveal-delay="0.18" aria-hidden="true">
        <span class="cv-ponte-s"><small>la ricerca</small>trenitalia.com</span>
        <span class="cv-ponte-l">
          <svg viewBox="0 0 200 8" preserveAspectRatio="none"><line x1="0" y1="4" x2="200" y2="4" stroke="currentColor" stroke-width="2" stroke-dasharray="6 6" vector-effect="non-scaling-stroke"/></svg>
          <em>la stessa visita?</em>
        </span>
        <span class="cv-ponte-s"><small>l’acquisto</small>Le Frecce</span>
      </div>
      <div class="w-full max-w-6xl mx-auto grid md:grid-cols-3 gap-5" data-stagger>
        {verifica.map((c) => (
          <div class="fs-card text-left h-full">
            <p class="fs-card-title mb-2" style="font-size: 1.15rem;">{c.k}</p>
            <p class="fs-card-body">{lega(c.v)}</p>
          </div>
        ))}
      </div>
      <p class="fs-panel-src text-center mt-6" data-reveal data-reveal-delay="0.3">
        {lega('È una proposta, da collaudare con chi gestisce la piattaforma di vendita: se chiede un rilascio, lo si saprà dal collaudo. Chi decide e chi lavora sta nell’appendice per il team tecnico.')}
      </p>
    </Slide>

    <!-- ── Coworker: chiedere perché ───────────────────────────────────── -->
    <Slide id="slide-coworker" bg="primary" align="center" data-solution="cja">
      <div slot="backdrop" class="absolute inset-0">
        <div class="fs-bg"></div>
        <div class="fs-grid"></div>
      </div>
      <Sfondo slot="backdrop" id="tc-strati" forza="media" />
      <p class="fs-panel-tag text-center mb-3" data-reveal>ADOBE CX ENTERPRISE COWORKER · PER ARRIVARE PRIMA AL RISULTATO</p>
      <h2 class="text-center text-[var(--ink-primary)] mb-5 font-[family-name:var(--font-display)]" style={h2} data-reveal data-reveal-delay="0.08">
        Dalla domanda alla bozza del test, in una&nbsp;conversazione.
      </h2>
      <p class="text-center fs-card-body max-w-3xl mx-auto mb-7" data-reveal data-reveal-delay="0.14">
        {lega('Due siti, tre fasi, più direzioni che chiedono numeri: Coworker è il modo di governarli con il team di oggi. Prepara l’analisi e la bozza in Target; a pubblicare resta il vostro team.')}
      </p>
      <div class="w-full max-w-5xl mx-auto grid md:grid-cols-2 gap-5" data-stagger>
        <div class="fs-card text-left">
          <p class="fs-card-title mb-2" style="font-size: 1.15rem;">Oggi</p>
          <p class="fs-card-body">{lega('Ogni lettura passa da chi conosce il modello dati. Fra la domanda e il test passano giorni.')}</p>
        </div>
        <div class="fs-card cv-card--dopo text-left">
          <p class="fs-card-title mb-2" style="font-size: 1.15rem;">Con Coworker</p>
          <p class="fs-card-body">{lega('«Perché su questa tratta la ricerca non arriva all’acquisto?» Coworker cerca dove il dato si discosta, e propone il test.')}</p>
        </div>
      </div>
      <p class="fs-panel-src text-center mt-6" data-reveal data-reveal-delay="0.3">
        L’accesso oggi passa da una prova concessa da Adobe, dall’attivazione di un vostro amministratore e dal parere della sicurezza IT: non è compreso nella proposta. Dentro Customer Journey Analytics è in prova limitata, e la risposta può mescolare l’inglese. I casi reggono anche senza ·
        <a href="https://experienceleague.adobe.com/en/docs/analytics-platform/using/cja-workspace/coworker" target="_blank" rel="noopener noreferrer">Coworker in Customer Journey Analytics</a>
      </p>
      <div class="mt-6 text-center" data-reveal data-reveal-delay="0.38">
        <a
          href={href(base, next)}
          class="inline-flex items-center gap-3 px-8 py-3.5 text-base font-semibold tracking-wide bg-[var(--accent-primary)] text-white hover:opacity-90 transition-opacity duration-300 font-[family-name:var(--font-display)] rounded-sm"
        >
          I casi, uno per uno
          <svg width="18" height="18" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>
    </Slide>

  </DeckContainer>
</BaseLayout>

<style is:global>
  #slide-cover [data-cover] p { text-wrap: balance; }

  /* La tabella delle fasi: tre colonne, la prima è quella di adesso. */
  .cv-tab { width: 100%; max-width: 80rem; margin-inline: auto; display: grid; gap: 0.55rem; text-align: left; }
  .cv-tab-r {
    display: grid; grid-template-columns: minmax(7rem, 0.42fr) repeat(3, minmax(0, 1fr)); gap: clamp(0.8rem, 1.4vw, 1.5rem);
    align-items: start; padding: clamp(0.8rem, 1.9vh, 1.2rem) clamp(0.9rem, 1.2vw, 1.3rem);
    border-radius: 0.6rem; border: 1px solid rgba(255, 255, 255, 0.2); background: rgba(27, 34, 48, 0.58);
    font-size: clamp(1.02rem, 1.1vw, 1.18rem); line-height: 1.38; color: var(--ink-primary);
  }
  .cv-tab-r > span { text-wrap: pretty; }
  .cv-tab-t { background: none; border: none; padding-block: 0 0.1rem; align-items: center; }
  .cv-tab-f { display: flex; align-items: center; gap: 0.6rem; font-family: var(--font-display); font-weight: 600; font-size: clamp(1.12rem, 1.3vw, 1.4rem); }
  .cv-tab-f b { flex: none; display: inline-grid; place-items: center; width: 2rem; height: 2rem; border-radius: 50%; border: 2px solid var(--color-verde-chiaro); font-weight: 700; font-size: 1.05rem; }
  .cv-tab-f--ora b { border-color: var(--color-rosso); background: var(--color-rosso); }
  .cv-tab-k { font-family: var(--font-display); font-weight: 600; font-size: clamp(1.05rem, 1.2vw, 1.3rem); color: var(--ink-secondary); }
  @media (max-width: 900px) { .cv-tab-r { grid-template-columns: minmax(0, 1fr); } .cv-tab-t { display: none; } }

  .cv-apri { margin-top: clamp(1rem, 2.6vh, 1.8rem); text-align: center; }
  .cv-apri-b {
    min-height: 2.75rem; padding: 0.6rem 1.4rem; border-radius: 0.4rem;
    border: 1.5px solid var(--color-rosso-chiaro); background: transparent;
    font-family: var(--font-display); font-weight: 600; font-size: clamp(1rem, 1.05vw, 1.15rem);
    color: var(--ink-primary); cursor: pointer;
  }
  .cv-apri-b:hover { background: rgba(217, 24, 53, 0.22); }
  .cv-ponte {
    width: 100%; max-width: 52rem; margin: 0 auto clamp(1.4rem, 3.4vh, 2.2rem);
    display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: 1rem;
  }
  .cv-ponte-s {
    display: grid; gap: 0.1rem; padding: 0.7rem 1.1rem; border-radius: 0.6rem;
    border: 1.5px solid rgba(255, 255, 255, 0.5); background: rgba(255, 255, 255, 0.07);
    font-family: var(--font-display); font-weight: 600; font-size: clamp(1.05rem, 1.2vw, 1.3rem); color: var(--ink-primary);
  }
  .cv-ponte-s small { font-family: var(--font-body); font-weight: 500; font-size: clamp(0.88rem, 0.92vw, 0.98rem); color: var(--ink-secondary); }
  .cv-ponte-l { display: grid; justify-items: center; gap: 0.35rem; color: var(--color-verde-chiaro); }
  .cv-ponte-l svg { width: 100%; height: 8px; }
  .cv-ponte-l em { font-style: normal; font-size: clamp(0.95rem, 1vw, 1.06rem); font-weight: 600; color: var(--color-verde-chiaro); }
  .cv-card--dopo { border: 1.5px solid rgba(79, 189, 180, 0.7) !important; }
</style>
