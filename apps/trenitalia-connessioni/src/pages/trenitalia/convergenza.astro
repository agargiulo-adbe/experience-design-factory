  }
  .cv-anello--nuovo { border-color: rgba(79, 189, 180, 0.8); background: rgba(0, 102, 102, 0.26); }
  .cv-anello:not(:first-child) { padding-left: 2rem; }
  .cv-anello:not(:first-child)::before {
    content: '→'; position: absolute; left: 0.6rem; top: 0.9rem;
    color: var(--color-verde-chiaro); font-size: 1.1rem; line-height: 1.2;
  }
  .cv-anello-k { font-family: var(--font-display); font-weight: 600; font-size: clamp(1rem, 1.1vw, 1.2rem); line-height: 1.2; color: var(--ink-primary); }
  .cv-anello-v { font-size: clamp(0.92rem, 0.98vw, 1.02rem); line-height: 1.4; color: var(--ink-secondary); }
  @media (max-width: 900px) {
    .cv-catena { grid-template-columns: minmax(0, 1fr); }
