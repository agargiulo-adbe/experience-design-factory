---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Sfondo from '../../components/Sfondo.astro';
import TreniNavigation from '../../components/TreniNavigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import CoverHero from '@edf/core/blocks/CoverHero.astro';
import MediaDemoSlot from '@edf/core/blocks/immersive/MediaDemoSlot.astro';
import DiagFlusso from '../../components/diagrammi/DiagFlusso.astro';
import DiagFasi from '../../components/diagrammi/DiagFasi.astro';
import { href } from '@edf/core/utils/url.js';

const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;

// Le cinque fonti che confluiscono nel layer, e il percorso che ne esce: è il
// concetto più ripetuto del capitolo, e qui si vede invece di leggersi.
const fonti = [
  'Adobe Analytics ×2 · sito e funnel',
  'App Trenitalia · eventi e notifiche',
  'Piattaforma di esecuzione email · risposta alle email',
  'Salesforce Data Cloud · profili CRM',
  'FS Park · accessi agli hub (cap. 4)',
];

const percorsoLeggibile = [
  // spazio unificatore: senza, «4892-XX» resta orfano su una riga sua
  'Identità ricucita: Davide Ferretti, CartaFreccia 4892-XX',
  'Il percorso completo su una timeline sola',
  'Cinque fonti Trenitalia diventano un profilo di journey',
  'Ricerca → acquisto → app → viaggio',
  'Il ritorno a Milano, e la sera a casa',
];

// Le tre fasi di CJA sulla linea del tempo. Le durate non sono stimate da noi:
// sono le parole del deck («CJA subito, l'attivazione a seguire, l'intelligence
// nel tempo»), e la nota sotto la slide dice che i tempi si fissano con FS.
const fasiCja = [
  { n: 'Fase 1', nome: 'Convergenza analytics', durata: 'subito', esito: 'CJA unifica le due istanze Adobe Analytics: prima vista end-to-end dalla homepage al checkout, senza toccare l\'infrastruttura.' },
  { n: 'Fase 2', nome: 'Journey full-funnel', durata: 'a seguire', esito: 'Si aggiungono app, la piattaforma email via SFTP e Salesforce Data Cloud via MuleSoft. Journey analysis cross-sistema.' },
  { n: 'Fase 3', nome: 'Attivazione ed evoluzione', durata: 'nel tempo', esito: 'Real-Time CDP e AJO per l\'attivazione, la clean room Collaboration per incontrare FS Park. Target esteso a funnel e app.' },
];
---
<BaseLayout
  title="CJA: il layer di convergenza · Ramo Trenitalia"
  description="Customer Journey Analytics connette le due istanze Adobe Analytics e tutti i sistemi, senza disruption, in fasi incrementali."
  pageSolutions={['cja']}
  branch="trenitalia"
>
  <div class="fixed top-0 left-0 right-0 z-50">
    <TreniNavigation currentPath={currentPath} base={base} branch="trenitalia" />
  </div>

  <DeckContainer wallScale
    nextHref={href(base, '/trenitalia/meta-invisibile')}
    prevHref={href(base, '/trenitalia/fondamenta')}
  >

    <!-- ── SLIDE 0: Cover ─────────────────────────────────────────── -->
    <Slide id="slide-cover" bg="primary" align="center" data-solution="cja">
      <div slot="backdrop" class="absolute inset-0">
        <div class="fs-bg"></div>
      <Sfondo slot="backdrop" id="rl-binari" forza="leggera" />
        <div class="fs-grid"></div>
      </div>
      <CoverHero
        eyebrow="03 · Customer Journey Analytics"
        numeral="03"
        title="CJA: il layer di convergenza"
        lead="Una vista unica del journey, senza migrare né dismettere nulla. CJA lavora sopra i sistemi che già avete, senza toccarli, e li fa parlare tra loro."
        size="phase"
        tone="ink"
        signature={false}
      />

      <!-- Le fonti come stazioni che convergono su un nodo unico -->
      <div class="relative w-full max-w-3xl mx-auto mt-9 mb-1" data-reveal data-reveal-delay="0.3">
        <div class="fs-line-h" style="top: 1.45rem; left: 8%; right: 8%;"></div>
        <div class="relative flex justify-between items-start px-[4%]">
          <div class="flex flex-col items-center gap-2.5 text-center">
            <span class="fs-node" data-active>AA</span>
            <span class="fs-node-label">Sistemi frammentati</span>
          </div>
          <div class="flex flex-col items-center gap-2.5 text-center">
            <span class="fs-node fs-node--alt" data-active>CJA</span>
            <span class="fs-node-label">Il layer di convergenza</span>
          </div>
          <div class="flex flex-col items-center gap-2.5 text-center">
            <span class="fs-node" data-active>1</span>
            <span class="fs-node-label">Un journey leggibile</span>
          </div>
        </div>
      </div>
    </Slide>

    <!-- ── SLIDE 1: CJA come hub di convergenza ──────────────────── -->
    <Slide id="slide-convergenza" bg="primary" align="center" data-solution="cja">
      <div slot="backdrop" class="absolute inset-0">
        <div class="fs-bg"></div>
        <div class="fs-grid"></div>
      </div>
      <Sfondo slot="backdrop" id="tc-strati" forza="forte" />
      <p class="fs-panel-tag text-center mb-4" data-reveal>
        COME FUNZIONA · CONNETTORI NATIVI, DATI SEMPRE IN AEP
      </p>
      <h2
        class="text-center text-[var(--ink-primary)] mb-6 font-[family-name:var(--font-display)]"
        style="font-size: clamp(1.6rem, 2.5vw, 2.2rem); font-weight: 600; line-height: 1.05; letter-spacing: -0.02em;"
        data-reveal
        data-reveal-delay="0.08"
      >
        Tutte le fonti in un'unica vista, senza stravolgere nulla.
      </h2>

      {/* Fonti separate → il layer che le legge → un percorso unico. Il
          diagramma sostituisce le tre colonne fatte a mano che dicevano la
          stessa cosa con tre strutture diverse. */}
      {/* text-left: la slide è centrata e il diagramma eredita il centramento,
          così le tappe sulla linea escono allineate al centro e i pallini della
          rotaia restano orfani a sinistra. */}
      <div class="w-full max-w-6xl mx-auto text-left" data-reveal data-reveal-delay="0.2">
        <DiagFlusso
          fonti={fonti}
          layer="Customer Journey Analytics"
          esito={percorsoLeggibile}
        />
      </div>

      <p
        class="text-[var(--ink-secondary)] leading-relaxed mx-auto mt-7 text-center"
        style="font-size: clamp(0.95rem, 1.1vw, 1.05rem); max-width: 52rem;"
        data-reveal
        data-reveal-delay="0.3"
      >
        Le frecce vanno in una direzione sola. I dataset entrano in Adobe Experience Platform
        e si modellano su uno schema comune; nessuna delle cinque fonti cambia mestiere, e
        nessuna viene sostituita.
      </p>
    </Slide>

    <!-- ── SLIDE 1b: CJA è / non è — disambiguazione ─────────────── -->
    <Slide id="slide-cja-vs-cdp" bg="secondary" align="center" data-solution="cja">
      <div slot="backdrop" class="absolute inset-0">
        <div class="fs-bg-soft"></div>
      <Sfondo slot="backdrop" id="tc-quiete" forza="media" />
        <div class="fs-grid"></div>
      </div>
      <p class="fs-panel-tag text-center mb-4" data-reveal>
        DISAMBIGUAZIONE · CJA ≠ CDP
      </p>
      <h2
        class="text-center text-[var(--ink-primary)] mb-4 font-[family-name:var(--font-display)]"
        style="font-size: clamp(1.8rem, 3vw, 2.5rem); font-weight: 600; line-height: 1.05; letter-spacing: -0.02em;"
        data-reveal
        data-reveal-delay="0.08"
      >
        Cosa fa CJA, e cosa no.
      </h2>
      <p
        class="text-center text-[var(--ink-secondary)] leading-snug max-w-3xl mx-auto mb-7"
        style="font-size: clamp(0.95rem, 1.1vw, 1.05rem);"
        data-reveal
        data-reveal-delay="0.12"
      >
        «Ma abbiamo già una CDP» è l'obiezione più comune. CJA non è la CDP operativa (Salesforce
        Data Cloud): è l'analytics del journey. La CDP attiva i profili, CJA legge il viaggio: servono entrambe.
      </p>

      <div class="w-full max-w-5xl mx-auto grid md:grid-cols-2 gap-6" data-reveal data-reveal-delay="0.16">
        <div class="fs-panel text-left">
          <p class="text-[0.85rem] font-bold tracking-widest uppercase text-emerald-400 mb-4">CJA È · Analytics</p>
          <ul class="space-y-3.5 text-[1rem] text-[var(--color-grigio-200)] leading-snug">
            <li class="flex gap-3"><span class="text-emerald-400 flex-shrink-0 mt-px">✓</span>Legge e analizza il journey cross-sistema</li>
            <li class="flex gap-3"><span class="text-emerald-400 flex-shrink-0 mt-px">✓</span>Connette segnali da fonti diverse in un'unica timeline</li>
            <li class="flex gap-3"><span class="text-emerald-400 flex-shrink-0 mt-px">✓</span>Produce insight, segmenti e attribution</li>
          </ul>
        </div>
        <div class="fs-panel fs-panel--alt text-left">
          <p class="text-[0.85rem] font-bold tracking-widest uppercase text-[var(--accent-primary)] mb-4">CJA NON È · non sostituisce una CDP</p>
          <ul class="space-y-3.5 text-[1rem] text-[var(--color-grigio-200)] leading-snug">
            <li class="flex gap-3"><span class="text-[var(--accent-primary)] flex-shrink-0 mt-px">✗</span>Non raccoglie profili operativi real-time (è Real-Time CDP)</li>
            <li class="flex gap-3"><span class="text-[var(--accent-primary)] flex-shrink-0 mt-px">✗</span>Non invia campagne né messaggi (è AJO + la piattaforma di esecuzione email)</li>
            <li class="flex gap-3"><span class="text-[var(--accent-primary)] flex-shrink-0 mt-px">✗</span>Non sostituisce la piattaforma di esecuzione email né Salesforce CRM</li>
          </ul>
        </div>
      </div>
    </Slide>

    <!-- ── SLIDE 2: Demo CJA Workspace ───────────────────────────── -->
    <Slide id="slide-demo-cja" bg="primary" align="center" data-solution="cja">
      <div slot="backdrop" class="absolute inset-0">
        <div class="fs-bg"></div>
      <Sfondo slot="backdrop" id="rl-quiete" forza="media" />
        <div class="fs-grid"></div>
      </div>
      <div data-demo-flex class="w-full flex items-start gap-8">
        <div class="flex-1 min-w-0 flex flex-col items-center">
          <p class="fs-panel-tag mb-4" data-reveal>
            ADOBE CUSTOMER JOURNEY ANALYTICS
          </p>
          <h2
            class="text-[var(--ink-primary)] mb-4 font-[family-name:var(--font-display)]"
            style="font-size: clamp(1.75rem, 3.2vw, 2.9rem); font-weight: 600; line-height: 1.05; letter-spacing: -0.02em;"
            data-reveal
            data-reveal-delay="0.08"
          >
            Il journey di Davide,<br/>visto per la prima volta.
          </h2>
          <p
            class="text-[var(--ink-secondary)] leading-normal max-w-2xl mb-5"
            style="font-size: clamp(0.95rem, 1.1vw, 1.05rem);"
            data-reveal
            data-reveal-delay="0.14"
          >
            CJA Workspace ricostruisce il percorso completo: ricerca su trenitalia.com,
            abbandono del funnel a metà checkout, ritorno da push app, prenotazione parcheggio
            FS Park, acquisto biglietto, viaggio, NPS post-arrivo. Una sola timeline, dalla
            prima ricerca all'ultimo contatto.
          </p>

          <div
            class="w-full max-w-4xl mx-auto grid md:grid-cols-3 gap-3 mb-4"
            data-reveal
            data-reveal-delay="0.2"
          >
            {[
              { metric: '5→1', label: 'fonti Trenitalia in una vista sola', sub: 'La sovrapposizione con la base FS Park si legge come audience, nel capitolo 4' },
              { metric: 'Da capo a fondo', label: 'il percorso di un cliente', sub: 'Dalla prima ricerca alla fine del viaggio, dentro il perimetro Trenitalia' },
              { metric: 'Senza estrazioni', label: 'le domande si fanno sul posto', sub: 'Oggi una risposta cross-sistema passa da un\'estrazione e da chi la prepara' },
            ].map((m) => (
              <div class="fs-card text-center">
                <p class="fs-stat-value mb-1.5" style="font-size: clamp(2rem, 3.4vw, 2.9rem);">{m.metric}</p>
                <p class="fs-card-title mb-1" style="font-size: 0.98rem;">{m.label}</p>
                <p class="text-[0.82rem] text-[var(--color-grigio-300)] leading-snug">{m.sub}</p>
              </div>
            ))}
          </div>
          <p class="text-center fs-stat-src tracking-widest uppercase">
            Fonte: Adobe Customer Journey Analytics · benchmark Adobe 2024
          </p>
        </div>
        <MediaDemoSlot id="cja-workspace-demo" label="CJA Workspace — Demo FS Journey" />
      </div>
    </Slide>

    <!-- ── SLIDE 3: Content Analytics ────────────────────────────── -->
    <Slide id="slide-content-analytics" bg="secondary" align="center" data-solution="cja">
      <div slot="backdrop" class="absolute inset-0">
        <div class="fs-bg-soft"></div>
      <Sfondo slot="backdrop" id="tc-acciaio" forza="media" />
        <div class="fs-grid"></div>
      </div>
      <p class="fs-panel-tag text-center mb-4" data-reveal>
        ADOBE CONTENT ANALYTICS · SU AEM
      </p>
      <h2
        class="text-[var(--ink-primary)] mb-4 font-[family-name:var(--font-display)]"
        style="font-size: clamp(1.6rem, 2.6vw, 2.4rem); font-weight: 600; line-height: 1.06; letter-spacing: -0.02em;"
        data-reveal
        data-reveal-delay="0.08"
      >
        Quale contenuto converte davvero?
      </h2>
      <p
        class="text-[var(--ink-secondary)] leading-snug max-w-2xl mx-auto mb-6"
        style="font-size: clamp(0.95rem, 1.25vw, 1.15rem);"
        data-reveal
        data-reveal-delay="0.14"
      >
        Content Analytics, costruito su CJA e integrato con AEM, analizza le caratteristiche
        dei contenuti (formato, stile visivo, posizione, lunghezza) e le correla con engagement
        e conversione. Il team editoriale AEM ottimizza sui dati, non più a intuito.
      </p>

      <div
        class="w-full max-w-4xl mx-auto grid md:grid-cols-2 gap-5"
        data-reveal
        data-reveal-delay="0.2"
      >
        {[
          {
            label: 'Attributi analizzati',
            rosso: false,
            items: [
              'Immagini: soggetto, colore, composizione',
              'Testo: tono, lunghezza, call-to-action',
              'Layout: posizione, gerarchia visiva',
              'Formato: video vs. carousel vs. hero static',
            ],
          },
          {
            label: 'Insight azionabili per AEM',
            rosso: true,
            items: [
              'Quali offerte homepage generano più click su funnel',
              'Quali CTA X-GO e CartaFreccia convertono meglio',
              'Stagionalità dei contenuti ad alto engagement',
              'A/B test guidati dagli attributi, non dalle varianti fatte a mano',
            ],
          },
        ].map((col) => (
          <div class="fs-panel text-left" class:list={[col.rosso && 'fs-panel--alt']}>
            <p class="fs-panel-tag mb-3" style={col.rosso ? 'color: rgba(var(--sig2-rgb), 0.98);' : ''}>{col.label}</p>
            <ul class="space-y-1.5">
              {col.items.map((item) => (
                <li class="flex items-start gap-2.5 text-[0.96rem] leading-tight text-[var(--color-grigio-200)]">
                  <span class={`flex-shrink-0 mt-1.5 w-1.5 h-1.5 rounded-full ${col.rosso ? 'bg-[var(--accent-primary)]' : 'bg-[rgba(var(--sig-rgb), 0.95)]'}`} aria-hidden="true"/>
                  {item}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </Slide>

    <!-- ── SLIDE 4: Le 3 fasi ─────────────────────────────────────── -->
    <Slide id="slide-fasi" bg="primary" align="center" data-solution="cja">
      <div slot="backdrop" class="absolute inset-0">
        <div class="fs-bg"></div>
      <Sfondo slot="backdrop" id="rl-binari" forza="forte" />
        <div class="fs-grid"></div>
      </div>
      <div class="w-full max-w-5xl mx-auto text-center">
        <p class="fs-panel-tag mb-3" data-reveal>
          APPROCCIO GRADUALE · SENZA SALTI NEL VUOTO
        </p>
        <h2
          class="text-[var(--ink-primary)] mb-5 font-[family-name:var(--font-display)]"
          style="font-size: clamp(1.6rem, 2.9vw, 2.6rem); font-weight: 600; line-height: 1.05; letter-spacing: -0.02em;"
          data-reveal
          data-reveal-delay="0.08"
        >
          Tre fasi, e ognuna lascia qualcosa.
        </h2>
      </div>

      {/* Le fasi sull'asse del tempo: la barra dice quanto dura, la riga sotto
          che cosa consegna. Prima era un elenco in colonna con i numeri a lato.
          Il lead che stava qui («nessun sistema viene dismesso») è già nella
          copertina del capitolo: ripeterlo alzava il titolo fuori banda. */}
      <div class="w-full max-w-6xl mx-auto mt-6" data-reveal data-reveal-delay="0.22">
        <DiagFasi fasi={fasiCja} />
      </div>

      <p class="mt-5 text-center fs-stat-src tracking-widest uppercase" data-reveal data-reveal-delay="0.3">
        Ipotesi di percorso per discussione · tempistiche da definire con FS Technology
      </p>

      <div class="mt-4 text-center" data-reveal data-reveal-delay="0.38">
        <a
          href={href(base, '/trenitalia/meta-invisibile')}
          class="inline-flex items-center gap-3 px-8 py-3.5 text-base font-semibold tracking-wide bg-[var(--accent-primary)] text-white hover:opacity-90 transition-opacity duration-300 font-[family-name:var(--font-display)] rounded-sm"
        >
          La metà che manca: oltre la stazione
          <svg width="18" height="18" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>
    </Slide>

  </DeckContainer>
</BaseLayout>
