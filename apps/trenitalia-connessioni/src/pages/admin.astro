interface SolutionEntry {
  id: string; name: string; shortName: string;
  pillar: string; description: string; appearsIn: string[];
}

const SOLUTIONS: SolutionEntry[] = [
  {
    id: 'cja',
    name: 'Customer Journey Analytics',
    shortName: 'CJA',
    pillar: 'analytics',
    description: 'Layer di convergenza in tre fasi: nella fase 0 legge insieme gli Adobe Analytics di trenitalia.com e di Le Frecce, aggregati; nella fase 1 l\'acquisto su Le Frecce si lega alla ricerca sulla conferma; nella fase 2, con il login, entrano la persona e gli attributi del CRM. Piattaforma email e FS Park entrano dopo, una fonte per volta.',
    appearsIn: ['Convergenza (Trenitalia)', 'Percorso (Trenitalia)', 'Convergenza (FS Park, fuori percorso)'],
  },
  {
    id: 'rtcdp',
    name: 'Adobe Real-Time CDP',
    shortName: 'Real-Time CDP',
    pillar: 'activation',
    description: 'Profili unificati in real-time, e il passaggio che serve perché un\'audience costruita in CJA esca verso Adobe Target: da mettere a contratto prima della Fase 2.',
    appearsIn: ['Percorso (Trenitalia)'],
  },
  {
    id: 'ajo',
    name: 'Adobe Journey Optimizer',
    shortName: 'AJO',
    pillar: 'activation',
    description: 'Orchestrazione journey omnicanale con AI: trigger CJA → decisione canale → esecuzione sulla piattaforma di esecuzione email/push/AEM.',
    appearsIn: ['Percorso (Trenitalia)'],
  },
  {
    id: 'data-collab',
    name: 'Adobe Real-Time CDP Collaboration',
    shortName: 'Data Collab',
    pillar: 'collaboration',
    description: 'Clean room privacy-first per FS Park × Trenitalia: audience matching GDPR-compliant senza condividere PII.',
    appearsIn: ['Metà invisibile (FS Park)', 'Metà invisibile (Trenitalia)'],
  },
];

const PILLAR_LABELS: Record<string, string> = {
  analytics:     'Analytics & Intelligence',
  activation:    'Attivazione',
  intelligence:  'Media Intelligence',
  collaboration: 'Real-Time CDP Collaboration',
};
const PILLAR_ORDER = ['analytics', 'activation', 'intelligence', 'collaboration'];
const PILLAR_COLORS: Record<string, string> = {
  analytics:     '#d91835',
  activation:    '#7c3aed',
  intelligence:  '#0891b2',
  collaboration: '#0d9488',
};

const solutionGroups = PILLAR_ORDER
  .map((pillar) => ({
    pillar,
    label: PILLAR_LABELS[pillar],
    color: PILLAR_COLORS[pillar],
    solutions: SOLUTIONS.filter((s) => s.pillar === pillar),
  }))
  .filter((g) => g.solutions.length > 0);

const allSolutionIds = SOLUTIONS.map((s) => s.id);
const deckHref = href(base, '/');
// Due stanze, due dossier: la societa' ICT del Gruppo e la Direzione Sales.
const DOSSIERS = [
  { href: href(base, '/dossier'), label: 'Dossier FSTechnology' },
  { href: href(base, '/dossier-sales'), label: 'Dossier Direzione Sales' },
];
---
<BaseLayout title="Console — Connessioni Intelligenti · FS Group">
  <AdminConsole
    projectSlug="trenitalia-connessioni"
    projectName="Connessioni Intelligenti"
    clientLabel="Adobe × FS Group"
    deckHref={deckHref}
    dossiers={DOSSIERS}
    pages={PAGE_REGISTRY}
    solutionGroups={solutionGroups}
    allSolutionIds={allSolutionIds}
    supabaseUrl={SUPABASE_URL}
    supabaseAnonKey={SUPABASE_ANON_KEY}
  />
</BaseLayout>
