    { id: 'slide-esplorare',       label: 'Da esplorare — 3 direttrici' },
    { id: 'slide-poc',             label: 'Il primo passo — POC su dati simulati o campionati' },
    { id: 'slide-sintesi',         label: 'Sintesi + invito' },
    { id: 'slide-chiusura',        label: 'Chiusura — solo visual' },
