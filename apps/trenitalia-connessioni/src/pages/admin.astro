  // Il tronco non è numerato: la serie 01–05 è dei capitoli di ramo, e due «01»
  // nello stesso documento obbligavano a ricordare quale serie si stesse leggendo.
  { slug: 'index', label: 'Tronco — Copertina e percorso', slides: [
    { id: 'slide-cover',      label: 'Copertina — la clip e il lockup Adobe × FS Group' },
    { id: 'slide-fs-context', label: 'Il contesto: un Gruppo in accelerazione' },
    { id: 'slide-journey',    label: 'Il percorso — le quattro tappe' },
