    { id: 'slide-davide',      label: 'Davide visto da FS Park' },
    { id: 'slide-ecosistema',  label: 'L\'ecosistema FS Park oggi (5 fonti, varco compreso)' },
    { id: 'slide-identita',    label: 'Cinque fonti, cinque versioni del cliente' },
    { id: 'slide-indicatori',  label: 'I numeri della sosta — 6 indicatori e la domanda che aprono' },
