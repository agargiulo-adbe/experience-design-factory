---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Sfondo from '../../components/Sfondo.astro';
import TreniNavigation from '../../components/TreniNavigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import CoverHero from '@edf/core/blocks/CoverHero.astro';
import DiagIncrocio from '../../components/diagrammi/DiagIncrocio.astro';
import DiagStrati from '../../components/diagrammi/DiagStrati.astro';
import DiagFasi from '../../components/diagrammi/DiagFasi.astro';
import { href } from '@edf/core/utils/url.js';

const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;

const puntiCiechi = [
  { mark: '01', nome: 'Il treno', desc: 'Quale prende, a che ora, con che frequenza. La sosta ha sempre una destinazione, e FS Park non la vede.' },
  { mark: '02', nome: 'Il motivo della sosta', desc: 'Pendolarismo, trasferta, aeroporto: contesti diversi che chiederebbero offerte diverse.' },
  { mark: '03', nome: 'Il ritorno', desc: 'Quando Davide riprende l\'auto e se il ritardo del treno gli ha fatto sforare la tariffa.' },
  { mark: '04', nome: 'Il valore oltre il parcheggio', desc: 'Quanto vale quel cliente per il Gruppo, oltre la sosta che paga a FS Park.' },
];

// La forma della data collaboration: due titolari, e in condivisione solo
// l'intersezione. Disegnata, la domanda «ma allora vi passate i dati?» non nasce.
// I colori dei due cerchi vengono da --park-rgb e --rail-rgb, cioè la stessa
// coppia che il deck usa per asfalto e rotaia: l'associazione è già nota.
const incrocioGruppo = {
  sinistra: {
    nome: 'FS Park',
    nota: 'Titolare dei dati della sosta: prenotazioni, pagamenti, assistenza',
  },
  destra: {
    nome: 'Trenitalia',
    nota: 'Titolare dei dati del viaggio: biglietti, treni, frequenza',
  },
  centro: 'Solo la sovrapposizione',
  vincolo:
    'Nessun dato personale passa da una società all\'altra: la clean room restituisce la sovrapposizione fra le due audience, non i singoli record, e solo dentro i consensi raccolti.',
};

const scenari = [
  {
    nome: 'Ritardo treno → benefit sosta',
    desc: 'Il treno di Davide arriva tardi e la sua sosta si estende senza penale, perché il ritardo di una società lo sa anche l\'altra.',
  },
  {
    nome: 'Cross-selling sosta + viaggio',
    desc: 'Chi viaggia spesso in treno e parcheggia sempre in zona stazione riceve una proposta che tiene insieme le due cose.',
  },
  {
    nome: 'Churn e retention letti insieme',
    desc: 'Un cliente che smette di parcheggiare sta forse smettendo di viaggiare. Letto insieme, il segnale arriva prima.',
  },
];

// La governance di taglio, dal dato grezzo in basso all'analisi in cima: così si
// vede che le regole stanno SOTTO l'analisi, non accanto come tre card pari.
const stratiGovernance = [
  { nome: 'Il dato, come arriva dalla fonte', nota: 'Eventi, profili, transazioni' },
  { nome: 'Etichette d\'uso', nota: 'Dichiarano come quel dato può essere usato' },
  { nome: 'Policy enforcement', nota: 'La piattaforma applica le regole e blocca il resto' },
  { nome: 'Consenso che viaggia col record', nota: 'Le scelte del cliente seguono il dato in ogni analisi' },
  { nome: 'L\'analisi, dentro il perimetro consentito', nota: 'Anche quando due società collaborano', evidenza: true },
];

// Le due mosse del ramo, con il peso che dice quanto dura ciascuna. Niente date:
// il deck dichiara che il ritmo lo decide FS Park, e un numero inventato qui
// sarebbe una scadenza mai concordata.
const fasiGruppo = [
  {
    n: '01',
    nome: 'FS Park legge il proprio cliente',
    durata: 'Si parte da qui',
    esito: 'Identità riconciliata, journey e funnel sui dati di casa, senza dipendere da nessun altro.',
    peso: 1.1,
  },
  {
    n: '02',
    nome: 'La clean room apre il Gruppo',
    durata: 'Quando le due società decidono',
    esito: 'Benefit sulla sosta, cross-selling fra sosta e viaggio, retention letta su entrambe le metà.',
    peso: 1,
  },
];
---
<BaseLayout
  branch="fs-park"
  title="Alla sbarra, Davide scompare"
  description="La metà che FS Park non vede e la clean room che permette di leggerla insieme a Trenitalia, nel rispetto del GDPR."
  pageSolutions={['data-collab']}
>
  <div class="fixed top-0 left-0 right-0 z-50">
    <TreniNavigation currentPath={currentPath} base={base} branch="fs-park" />
  </div>

  <DeckContainer wallScale
    nextHref={href(base, '/fs-park/percorso')}
    prevHref={href(base, '/fs-park/convergenza')}
  >

    <!-- ── SLIDE 0: Cover ─────────────────────────────────────────── -->
    <Slide id="slide-cover" bg="primary" align="center">
      <div slot="backdrop" class="fs-bg"></div>
      <div slot="backdrop" class="fsp-stalli"></div>
      <Sfondo slot="backdrop" id="pk-rampa" forza="leggera" />
      <CoverHero
        eyebrow="04 · Metà invisibile"
        numeral="04"
        title="Alla sbarra,<br/>Davide scompare"
        lead="La lettura del cliente FS Park si interrompe dove inizia il viaggio. Quello che succede dopo esiste, ma appartiene a un'altra società del Gruppo."
        size="phase"
        tone="ink"
        signature={false}
      />
    </Slide>

    <!-- ── SLIDE 1: Cosa FS Park non vede ─────────────────────────── -->
    <Slide id="slide-punto-cieco" bg="primary" align="center">
      <div slot="backdrop" class="fs-bg"></div>
      <Sfondo slot="backdrop" id="pk-asfalto" forza="media" />
      <div slot="backdrop" class="fs-grid"></div>
      <p class="fs-panel-tag text-center mb-4" data-reveal>
        IL PUNTO CIECO
      </p>
      <h2
        class="text-center text-[var(--ink-primary)] mb-4 font-[family-name:var(--font-display)]"
        style="font-size: clamp(1.7rem, 2.8vw, 2.5rem); font-weight: 600; line-height: 1.06; letter-spacing: -0.02em;"
        data-reveal
        data-reveal-delay="0.08"
      >
        Quattro cose che FS Park non vede.
      </h2>
      <p
        class="text-center text-[var(--ink-secondary)] leading-snug max-w-2xl mx-auto mb-7"
        style="font-size: clamp(0.95rem, 1.15vw, 1.08rem);"
        data-reveal
        data-reveal-delay="0.14"
      >
        Anche con le proprie fonti riconciliate, la storia resta a metà.
        L'altra metà del cliente vive sui binari.
      </p>

      <div class="w-full max-w-5xl mx-auto grid md:grid-cols-2 gap-4" data-reveal data-reveal-delay="0.2">
        {puntiCiechi.map((p) => (
          <div class="fs-card flex items-start gap-4 text-left" style="border-style: dashed; border-color: rgba(241, 243, 244, 0.22);">
            <span class="fs-mark flex-shrink-0" style="border-style: dashed; background: rgba(27, 34, 48, 0.6); border-color: rgba(241, 243, 244, 0.4);" aria-hidden="true">{p.mark}</span>
            <div class="min-w-0 flex-1">
              <p class="fs-card-title mb-1" style="font-size: 1.1rem;">{p.nome}</p>
              <p class="fs-card-body" style="font-size: 0.95rem;">{p.desc}</p>
            </div>
          </div>
        ))}
      </div>

      <p class="mt-6 text-center fs-panel-src tracking-widest uppercase" data-reveal data-reveal-delay="0.32">
        La metà su rotaia esiste · serve un modo lecito e sicuro per leggerla
      </p>
    </Slide>

    <!-- ── SLIDE 2: Perché una clean room ─────────────────────────── -->
    <Slide id="slide-why-collab" bg="secondary" align="center">
      <Sfondo slot="backdrop" id="tc-strati" forza="forte" />
      <div slot="backdrop" class="fs-bg-soft"></div>

      <div class="w-full max-w-6xl mx-auto">
        <div class="fs-panel mb-5" data-reveal>
          <p class="fs-panel-tag">PERCHÉ UNA CLEAN ROOM · ADOBE REAL-TIME CDP COLLABORATION</p>
          <h2 class="fs-panel-head mt-1 mb-3" style="font-size: clamp(1.5rem, 2.3vw, 2.1rem);">
            Stesso Gruppo, entità legali distinte.
          </h2>
          <p class="fs-panel-body max-w-4xl" style="font-size: clamp(0.98rem, 1.1vw, 1.08rem); line-height: 1.6;">
            FS Park e Trenitalia appartengono allo stesso Gruppo, ma sono società diverse,
            ognuna titolare dei propri dati. Il GDPR vale anche tra società sorelle: i dati
            personali dell'una non possono semplicemente passare all'altra. Adobe Real-Time
            CDP Collaboration — la clean room di Adobe — esiste esattamente per questo caso.
          </p>
        </div>

        <div class="fsp-incrocio mb-5" data-reveal data-reveal-delay="0.14">
          <DiagIncrocio
            sinistra={incrocioGruppo.sinistra}
            destra={incrocioGruppo.destra}
            centro={incrocioGruppo.centro}
            vincolo={incrocioGruppo.vincolo}
          />
        </div>

        <p class="fs-panel-src text-center" data-reveal data-reveal-delay="0.24">
          Vincolo emerso al tavolo di lavoro Adobe × FS Park, luglio 2026 · la collaborazione tra società richiede una clean room anche intra-gruppo
        </p>
      </div>
    </Slide>

    <!-- ── SLIDE 3: Scenari intersocietari ────────────────────────── -->
    <Slide id="slide-usecases-gruppo" bg="primary" align="center">
      <div slot="backdrop" class="fs-bg"></div>
      <Sfondo slot="backdrop" id="tc-quiete" forza="media" />
      <div slot="backdrop" class="fs-grid"></div>

      <div class="w-full max-w-6xl mx-auto">
        <div class="text-center mb-6">
          <p class="fs-panel-tag inline-block" data-reveal>
            SCENARI INTERSOCIETARI · VISTI DA FS PARK
          </p>
          <h2
            class="text-[var(--ink-primary)] mt-3 font-[family-name:var(--font-display)]"
            style="font-size: clamp(1.6rem, 2.5vw, 2.3rem); font-weight: 600; line-height: 1.06; letter-spacing: -0.02em;"
            data-reveal
            data-reveal-delay="0.08"
          >
            Cosa diventa possibile quando le due metà si parlano.
          </h2>
        </div>

        <div class="relative flex flex-col gap-3">
          <div class="fs-line-h hidden md:block" style="left: 1.45rem; top: 1.45rem; bottom: 1.45rem; width: 2px; height: auto; background: linear-gradient(180deg, rgba(var(--sig-rgb), 0) 0%, rgba(var(--sig-rgb), 0.9) 8%, rgba(var(--sig-rgb), 0.9) 92%, rgba(var(--sig-rgb), 0) 100%);" aria-hidden="true"></div>

          {scenari.map((s, i) => (
            <div
              class="relative flex items-center gap-4"
              data-reveal
              data-reveal-delay={(0.14 + i * 0.07).toFixed(2)}
            >
              <span class="fs-node fs-node--sig flex-shrink-0 relative z-10" data-active aria-hidden="true">{i + 1}</span>
              <div class="fs-card flex-1 min-w-0 text-left" style="padding: 1rem 1.25rem;">
                <div class="flex items-center gap-2.5 flex-wrap mb-1">
                  <p class="fs-card-title" style="font-size: 1.1rem; margin-inline: 0;">{s.nome}</p>
                  <span class="text-[0.72rem] font-bold px-2 py-0.5 rounded-sm tracking-wide uppercase flex-shrink-0" style="background: rgba(241, 243, 244, 0.12); color: rgba(221,224,232,0.9);">
                    Da esplorare · da validare sul campo
                  </span>
                </div>
                <p class="fs-card-body" style="font-size: 0.96rem; line-height: 1.55; margin-inline: 0;">{s.desc}</p>
              </div>
            </div>
          ))}
        </div>

        <p class="mt-5 text-center fs-panel-src tracking-widest uppercase" data-reveal data-reveal-delay="0.36">
          Evoluzione possibile, non punto di partenza · dal tavolo di lavoro Adobe × FS Park, luglio 2026
        </p>
      </div>
    </Slide>

    <!-- ── SLIDE 4: AEP Data Governance ───────────────────────────── -->
    <Slide id="slide-governance" bg="secondary" align="center">
      <div slot="backdrop" class="fs-bg-soft"></div>
      <Sfondo slot="backdrop" id="tc-acciaio" forza="media" />
      <div slot="backdrop" class="fs-grid"></div>
      <p class="fs-panel-tag text-center mb-4" data-reveal>
        ADOBE EXPERIENCE PLATFORM · DATA GOVERNANCE
      </p>
      <h2
        class="text-center text-[var(--ink-primary)] mb-4 font-[family-name:var(--font-display)]"
        style="font-size: clamp(1.7rem, 2.8vw, 2.5rem); font-weight: 600; line-height: 1.06; letter-spacing: -0.02em;"
        data-reveal
        data-reveal-delay="0.08"
      >
        La condizione tecnica per parlarsi tra società.
      </h2>
      <p
        class="text-center text-[var(--ink-secondary)] leading-snug max-w-3xl mx-auto mb-7"
        style="font-size: clamp(0.95rem, 1.15vw, 1.08rem);"
        data-reveal
        data-reveal-delay="0.14"
      >
        La governance non è un adempimento che frena: è quello che rende possibile la
        collaborazione. Le regole stanno sul dato, e le applicalla piattaforma.
      </p>

      <!-- Tre card pari facevano sembrare etichette, policy e consenso tre cose
           accanto. Sono impilate: ognuna poggia sulla precedente. -->
      <div class="w-full max-w-5xl mx-auto" data-reveal data-reveal-delay="0.2">
        <DiagStrati strati={stratiGovernance} />
      </div>

      <p
        class="text-center text-[var(--ink-secondary)] max-w-4xl mx-auto mt-6"
        style="font-size: 0.98rem; line-height: 1.6;"
        data-reveal
        data-reveal-delay="0.28"
      >
        Etichette, policy e consenso sono nativi in Adobe Experience Platform: valgono per
        l'uso interno dei dati FS Park e, quando servirà, per la collaborazione tra società.
      </p>
    </Slide>

    <!-- ── SLIDE 5: Partire da FS Park, estendere al Gruppo ───────── -->
    <Slide id="slide-strategia" bg="primary" align="center">
      <div slot="backdrop" class="fs-bg"></div>
      <Sfondo slot="backdrop" id="pk-alba" forza="media" />
      <div slot="backdrop" class="fsp-stalli"></div>
      <p class="fs-panel-tag text-center mb-4" data-reveal>
        LA STRATEGIA
      </p>
      <h2
        class="text-center text-[var(--ink-primary)] mb-6 font-[family-name:var(--font-display)]"
        style="font-size: clamp(1.7rem, 2.8vw, 2.5rem); font-weight: 600; line-height: 1.06; letter-spacing: -0.02em;"
        data-reveal
        data-reveal-delay="0.08"
      >
        Partire da FS Park.<br/>Estendere al Gruppo.
      </h2>

      <!-- Le due mosse sulla linea del tempo, invece di due pannelli affiancati:
           così si vede che la seconda non blocca la prima. -->
      <div class="fsp-fasi w-full max-w-6xl mx-auto mb-7" data-reveal data-reveal-delay="0.16">
        <DiagFasi fasi={fasiGruppo} />
      </div>

      <p
        class="text-center text-[var(--ink-secondary)] max-w-3xl mx-auto mb-7"
        style="font-size: 1rem; line-height: 1.6;"
        data-reveal
        data-reveal-delay="0.22"
      >
        La prima mossa sta in piedi da sola, sui dati di casa. La seconda arriva sulla
        stessa piattaforma, e la decidono le due società quando vogliono.
      </p>

      <div class="text-center" data-reveal data-reveal-delay="0.28">
        <a
          href={href(base, '/fs-park/percorso')}
          class="inline-flex items-center gap-3 px-8 py-3 text-base font-semibold tracking-wide bg-[var(--color-verde)] text-white hover:bg-[#00807f] transition-colors duration-300 font-[family-name:var(--font-display)] rounded-sm"
        >
          Il percorso: da dove si comincia
          <svg width="18" height="18" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>
    </Slide>

  </DeckContainer>
</BaseLayout>

<!-- DiagIncrocio è tarato su note di poche parole: le nostre dicono di che cosa
     ciascuna società è titolare, e a quella misura il cerchio centrale finiva
     SOPRA il testo dei due lati (letto a schermo, non dall'audit: le note sono
     a 0.86rem e il check testo-su-testo guarda solo da 16px in su). I cerchi si
     allargano, la sovrapposizione si stringe e il padding interno tiene il
     testo fuori dall'area coperta. Scoped al ramo: la nav è SPA e i fogli
     restano in pagina anche dopo lo swap. -->
