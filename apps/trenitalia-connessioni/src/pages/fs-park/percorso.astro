---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TreniNavigation from '../../components/TreniNavigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import CoverHero from '@edf/core/blocks/CoverHero.astro';
import SlideBackdrop from '@edf/core/blocks/SlideBackdrop.astro';
import { href } from '@edf/core/utils/url.js';
import { mediaProps } from '../../../assets.index';

const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;

const radar = [
  {
    nome: 'Rinnovi e mancati rinnovi',
    desc: 'Capire chi non rinnova l\'abbonamento e cosa era successo nelle settimane prima.',
  },
  {
    nome: 'Ricorrenze → proposta abbonamento',
    desc: 'Chi acquista soste singole con regolarità riceve la proposta di abbonamento al momento giusto.',
  },
  {
    nome: 'Segmentazione auto / moto / bici',
    desc: 'Comportamenti e bisogni diversi per tipo di veicolo, letti come segmenti distinti.',
  },
  {
    nome: 'Sorgenti che convertono',
    desc: 'Da dove arrivano i clienti che poi comprano davvero: canali, campagne, percorsi di ingresso.',
  },
  {
    nome: 'Transazioni ↔ assistenza',
    desc: 'Correlare acquisti, reclami e richieste CRM: cosa succede al cliente dopo un problema.',
  },
];

// Il riepilogo si ferma al capitolo 04: il 05 è questa pagina — il suo
// contenuto (POC, radar, adozione) vive nel paragrafo di chiusura, non in lista.
const capitoli = [
  { num: '01', label: 'Partenza', desc: 'La metà su asfalto: l\'ecosistema e il cliente in quattro versioni' },
  { num: '02', label: 'Fondamenta', desc: 'Una sola identità: email hashata, Identity Graph, stitching, backfill' },
  { num: '03', label: 'Convergenza', desc: 'Customer Journey Analytics: tutte le fonti, un\'unica lettura' },
  { num: '04', label: 'Metà invisibile', desc: 'La clean room che apre gli scenari di Gruppo, nel rispetto del GDPR' },
];
---
<BaseLayout
  branch="fs-park"
  title="Il percorso"
  description="Il percorso FS Park: POC su dati realistici o simulati, use case sul radar, accompagnamento e orizzonte di Gruppo."
>
  <div class="fixed top-0 left-0 right-0 z-50">
    <TreniNavigation currentPath={currentPath} base={base} branch="fs-park" />
  </div>

  <DeckContainer
    nextHref={href(base, '/bivio')}
    prevHref={href(base, '/fs-park/meta-invisibile')}
  >

    <!-- ── SLIDE 0: Cover ─────────────────────────────────────────── -->
    <Slide id="slide-cover" bg="primary" align="center">
      <div slot="backdrop" class="fs-bg"></div>
      <div slot="backdrop" class="fsp-stalli"></div>
      <SlideBackdrop
        slot="backdrop"
        {...mediaProps('bg-dashboard')}
        imageClass="opacity-10"
        scrim="bg-[var(--surface-primary)]/92"
      />
      <CoverHero
        eyebrow="05 · Il percorso"
        numeral="05"
        title="Il percorso"
        lead="Un primo passo concreto e dimostrabile, una lista di use case sul radar e un accompagnamento che rende il team autonomo. Senza scadenze imposte: il ritmo lo decide FS Park."
        size="phase"
        tone="ink"
        signature={false}
      />
    </Slide>

    <!-- ── SLIDE 1: Il primo passo — POC ──────────────────────────── -->
    <Slide id="slide-poc" bg="primary" align="center">
      <div slot="backdrop" class="fs-bg"></div>
      <div slot="backdrop" class="fs-grid"></div>
      <p class="fs-panel-tag text-center mb-4" data-reveal>
        IL PRIMO PASSO
      </p>
      <h2
        class="text-center text-[var(--ink-primary)] mb-4 font-[family-name:var(--font-display)]"
        style="font-size: clamp(1.7rem, 2.8vw, 2.5rem); font-weight: 600; line-height: 1.06; letter-spacing: -0.02em;"
        data-reveal
        data-reveal-delay="0.08"
      >
        Un POC su dati realistici o simulati.
      </h2>
      <p
        class="text-center text-[var(--ink-secondary)] leading-snug max-w-3xl mx-auto mb-7"
        style="font-size: clamp(0.95rem, 1.15vw, 1.08rem);"
        data-reveal
        data-reveal-delay="0.14"
      >
        Il modo più onesto di valutare la piattaforma: vederla lavorare su un caso FS Park,
        prima di qualunque impegno sull'ecosistema reale.
      </p>

      <div class="w-full max-w-5xl mx-auto grid md:grid-cols-2 gap-6" data-reveal data-reveal-delay="0.2">
        <div class="fs-panel text-left">
          <p class="text-[0.85rem] font-bold tracking-widest uppercase text-emerald-400 mb-4">Cosa dimostra</p>
          <ul class="space-y-3.5 text-[1rem] text-[var(--color-grigio-200)] leading-snug">
            <li class="flex gap-3"><span class="text-emerald-400 flex-shrink-0 mt-px">✓</span>La riconciliazione delle identità tra sito, app e CRM</li>
            <li class="flex gap-3"><span class="text-emerald-400 flex-shrink-0 mt-px">✓</span>Il journey end-to-end, dall'accesso anonimo all'acquisto</li>
            <li class="flex gap-3"><span class="text-emerald-400 flex-shrink-0 mt-px">✓</span>La drop-off analysis sul funnel di prenotazione</li>
          </ul>
        </div>
        <div class="fs-panel text-left">
          <p class="text-[0.85rem] font-bold tracking-widest uppercase mb-4" style="color: rgba(255,201,77,0.98);">Cosa non richiede</p>
          <ul class="space-y-3.5 text-[1rem] text-[var(--color-grigio-200)] leading-snug">
            <li class="flex gap-3"><span class="flex-shrink-0 mt-px" style="color: rgba(255,201,77,0.98);">✗</span>L'ecosistema completo già in produzione</li>
            <li class="flex gap-3"><span class="flex-shrink-0 mt-px" style="color: rgba(255,201,77,0.98);">✗</span>L'area riservata web già attiva</li>
            <li class="flex gap-3"><span class="flex-shrink-0 mt-px" style="color: rgba(255,201,77,0.98);">✗</span>Una migrazione preventiva dello storico</li>
          </ul>
        </div>
      </div>

      <p class="mt-6 text-center fs-panel-src tracking-widest uppercase" data-reveal data-reveal-delay="0.3">
        Ipotesi emerse al tavolo di lavoro FS Park × Adobe, luglio 2026 · perimetro da definire insieme
      </p>
    </Slide>

    <!-- ── SLIDE 2: Sul radar ─────────────────────────────────────── -->
    <Slide id="slide-esplorare" bg="secondary" align="center">
      <div slot="backdrop" class="fs-bg-soft"></div>
      <div slot="backdrop" class="fs-grid"></div>

      <div class="w-full max-w-6xl mx-auto">
        <div class="text-center mb-5">
          <p class="fs-panel-tag inline-block" data-reveal>
            SUL RADAR · DOPO I PRIMI TRE USE CASE
          </p>
          <h2
            class="text-[var(--ink-primary)] mt-3 font-[family-name:var(--font-display)]"
            style="font-size: clamp(1.6rem, 2.4vw, 2.2rem); font-weight: 600; line-height: 1.06; letter-spacing: -0.02em;"
            data-reveal
            data-reveal-delay="0.08"
          >
            Cinque direzioni già individuate.
          </h2>
        </div>

        <div class="relative flex flex-col gap-2.5">
          <div class="fs-line-h hidden md:block" style="left: 1.45rem; top: 1.45rem; bottom: 1.45rem; width: 2px; height: auto; background: linear-gradient(180deg, rgba(245,166,35,0) 0%, rgba(245,166,35,0.9) 8%, rgba(245,166,35,0.9) 92%, rgba(245,166,35,0) 100%);" aria-hidden="true"></div>

          {radar.map((r, i) => (
            <div
              class="relative flex items-center gap-4"
              data-reveal
              data-reveal-delay={(0.12 + i * 0.05).toFixed(2)}
            >
              <span class="fs-node fs-node--ambra flex-shrink-0 relative z-10" data-active aria-hidden="true">{i + 1}</span>
              <div class="fs-card flex-1 min-w-0 text-left" style="padding: 0.8rem 1.1rem;">
                <div class="flex items-center gap-2.5 flex-wrap mb-0.5">
                  <p class="fs-card-title" style="font-size: 1.05rem; margin-inline: 0;">{r.nome}</p>
                  <span class="text-[0.7rem] font-bold px-2 py-0.5 rounded-sm tracking-wide uppercase flex-shrink-0" style="background: rgba(245,166,35,0.16); color: rgba(255,201,77,0.98);">
                    Da validare sul campo
                  </span>
                </div>
                <p class="fs-card-body" style="font-size: 0.95rem; line-height: 1.5; margin-inline: 0;">{r.desc}</p>
              </div>
            </div>
          ))}
        </div>

        <p class="mt-4 text-center fs-panel-src tracking-widest uppercase" data-reveal data-reveal-delay="0.4">
          Use case raccolti al tavolo di lavoro FS Park × Adobe, luglio 2026
        </p>
      </div>
    </Slide>

    <!-- ── SLIDE 3: Accompagnamento e formazione ──────────────────── -->
    <Slide id="slide-adozione" bg="primary" align="center">
      <div slot="backdrop" class="fs-bg"></div>
      <div slot="backdrop" class="fs-grid"></div>
      <p class="fs-panel-tag text-center mb-4" data-reveal>
        ADOZIONE · DENTRO IL PERCORSO, NON DOPO
      </p>
      <h2
        class="text-center text-[var(--ink-primary)] mb-4 font-[family-name:var(--font-display)]"
        style="font-size: clamp(1.7rem, 2.8vw, 2.5rem); font-weight: 600; line-height: 1.06; letter-spacing: -0.02em;"
        data-reveal
        data-reveal-delay="0.08"
      >
        L'accompagnamento fa parte del progetto.
      </h2>
      <p
        class="text-center text-[var(--ink-secondary)] leading-snug max-w-3xl mx-auto mb-7"
        style="font-size: clamp(0.95rem, 1.15vw, 1.08rem);"
        data-reveal
        data-reveal-delay="0.14"
      >
        Ogni fase del percorso include chi aiuta a leggere i dati e a trasformarli in decisioni.
        L'obiettivo è costruire autonomia, un'analisi alla volta, senza creare dipendenza.
      </p>

      <div class="w-full max-w-5xl mx-auto grid md:grid-cols-2 gap-6" data-reveal data-reveal-delay="0.2">
        <div class="fs-panel text-left" style="padding: 1.9rem 2rem;">
          <p class="fs-panel-tag mb-3">Affiancamento alla lettura</p>
          <p class="fs-panel-body" style="font-size: 1.05rem; line-height: 1.65;">
            Le analisi dei primi mesi si costruiscono in sessioni di lavoro congiunte,
            partendo dalle domande del business e arrivando insieme alla risposta nei dati.
          </p>
        </div>
        <div class="fs-panel text-left" style="padding: 1.9rem 2rem;">
          <p class="fs-panel-tag mb-3">Autonomia progressiva</p>
          <p class="fs-panel-body" style="font-size: 1.05rem; line-height: 1.65;">
            Formazione sul metodo e AI Assistant per interrogare i dati in linguaggio
            naturale: nel tempo il team fa da solo, e l'affiancamento si sposta sui casi nuovi.
          </p>
        </div>
      </div>

      <p class="mt-7 text-center fs-panel-src tracking-widest uppercase" data-reveal data-reveal-delay="0.3">
        Percorso di accompagnamento emerso al tavolo di lavoro FS Park × Adobe, luglio 2026
      </p>
    </Slide>

    <!-- ── SLIDE 4: Verso il Gruppo ───────────────────────────────── -->
    <Slide id="slide-orizzonte" bg="inverse" align="center">
      <div slot="backdrop" class="fs-bg"></div>
      <div slot="backdrop" class="fsp-stalli"></div>
      <SlideBackdrop
        slot="backdrop"
        {...mediaProps('bg-stazione')}
        imageClass="opacity-12"
        scrim="bg-[var(--color-carbonio)]/93"
      />
      <p class="fs-panel-tag text-center mb-4" data-reveal>
        L'ORIZZONTE
      </p>
      <h2
        class="text-[var(--color-ghiaccio)] mb-5 text-center font-[family-name:var(--font-display)]"
        style="font-size: clamp(1.9rem, 3.4vw, 3.1rem); font-weight: 600; line-height: 1.06; letter-spacing: -0.02em;"
        data-reveal
        data-reveal-delay="0.08"
      >
        Quando l'asfalto incontra la rotaia.
      </h2>
      <p
        class="text-[var(--color-grigio-200)] max-w-3xl mx-auto text-center mb-10"
        style="font-size: clamp(1rem, 1.25vw, 1.2rem); line-height: 1.55;"
        data-reveal
        data-reveal-delay="0.15"
      >
        Il valore per FS Park parte prima e non aspetta nessuno. Ma la linea del bivio
        può richiudersi: la clean room permette alle due metà del viaggio di Davide di
        raccontarsi a vicenda, con ogni società padrona dei propri dati. Un orizzonte,
        una possibilità aperta, non una dipendenza.
      </p>

      <div class="relative w-full max-w-4xl mx-auto" data-reveal data-reveal-delay="0.24">
        <span class="fs-line-h" style="top: 1.4rem; left: 4%; width: 42%; background: linear-gradient(90deg, rgba(245,166,35,0) 0%, rgba(245,166,35,0.9) 25%, rgba(245,166,35,0.9) 100%);" aria-hidden="true"></span>
        <span class="fs-line-h" style="top: 1.4rem; right: 4%; width: 42%; background: linear-gradient(90deg, rgba(226,0,26,0.9) 0%, rgba(226,0,26,0.9) 75%, rgba(226,0,26,0) 100%);" aria-hidden="true"></span>
        <div class="grid grid-cols-3 gap-4">
          <div class="flex flex-col items-center gap-2.5 text-center">
            <span class="fs-node fs-node--ambra" data-active>🅿️</span>
            <span class="fs-node-label">La metà su asfalto · FS Park</span>
          </div>
          <div class="flex flex-col items-center gap-2.5 text-center">
            <span class="fs-node relative z-10" data-active style="border-color: rgba(242,244,248,0.9); box-shadow: 0 0 18px rgba(242,244,248,0.4);">⇄</span>
            <span class="fs-node-label">La clean room · Data Collaboration</span>
          </div>
          <div class="flex flex-col items-center gap-2.5 text-center">
            <span class="fs-node fs-node--rosso" data-active>🚆</span>
            <span class="fs-node-label">La metà su rotaia · Trenitalia</span>
          </div>
        </div>
      </div>

      <p
        class="mt-10 text-center text-[var(--color-grigio-200)] max-w-2xl mx-auto"
        style="font-size: 0.98rem; line-height: 1.55;"
        data-reveal
        data-reveal-delay="0.32"
      >
        Gli scenari intersocietari restano da esplorare, con ogni società titolare
        dei propri dati. Intanto il ramo FS Park cammina sulle proprie gambe.
      </p>
    </Slide>

    <!-- ── SLIDE 5: Sintesi + invito ──────────────────────────────── -->
    <Slide id="slide-sintesi" bg="primary" align="center">
      <div slot="backdrop" class="fs-bg"></div>
      <div slot="backdrop" class="fs-grid"></div>
      <p class="fs-panel-tag text-center mb-4" data-reveal>
        IN SINTESI · IL RAMO FS PARK
      </p>
      <h2
        class="text-center text-[var(--ink-primary)] mb-6 font-[family-name:var(--font-display)]"
        style="font-size: clamp(1.7rem, 2.8vw, 2.5rem); font-weight: 600; line-height: 1.06; letter-spacing: -0.02em;"
        data-reveal
        data-reveal-delay="0.08"
      >
        Un cliente intero, a partire da casa propria.
      </h2>

      <div class="w-full max-w-4xl mx-auto flex flex-col gap-2.5 mb-6" data-reveal data-reveal-delay="0.16">
        {capitoli.map((c) => (
          <div class="fs-card flex items-center gap-4 text-left" style="padding: 0.75rem 1.1rem;">
            <span class="fs-node fs-node--ambra flex-shrink-0" data-active style="width:2.2rem;height:2.2rem;font-size:0.82rem;" aria-hidden="true">{c.num}</span>
            <div class="min-w-0 flex-1">
              <p class="fs-card-title" style="font-size: 1.02rem; margin-inline: 0;">{c.label}</p>
              <p class="fs-card-body" style="font-size: 0.95rem; line-height: 1.45; margin-inline: 0;">{c.desc}</p>
            </div>
          </div>
        ))}
      </div>

      <p
        class="text-center text-[var(--ink-secondary)] max-w-2xl mx-auto mb-6"
        style="font-size: clamp(0.98rem, 1.2vw, 1.1rem); line-height: 1.55;"
        data-reveal
        data-reveal-delay="0.26"
      >
        Da qui comincia il percorso vero: POC su dati simulati, use case sul radar,
        adozione accompagnata. Il primo passo è sedersi sui dati e definire insieme
        il perimetro del POC e le prime domande a cui rispondere.
      </p>

      <div class="text-center" data-reveal data-reveal-delay="0.34">
        <a
          href={href(base, '/bivio')}
          class="inline-flex items-center gap-3 px-8 py-3 text-base font-semibold tracking-wide bg-[var(--color-ambra)] text-[var(--color-carbonio)] hover:bg-[var(--color-ambra-chiara)] transition-colors duration-300 font-[family-name:var(--font-display)] rounded-sm"
        >
          Torna al bivio
          <svg width="18" height="18" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>
    </Slide>

    <!-- ── SLIDE 6: Chiusura — solo visual ────────────────────────── -->
    <Slide id="slide-chiusura" bg="inverse" align="center">
      <div slot="backdrop" class="fs-bg"></div>
      <div slot="backdrop" class="fsp-stalli"></div>
      <SlideBackdrop
        slot="backdrop"
        {...mediaProps('bg-parcheggio')}
        imageClass="opacity-25"
        scrim="bg-[var(--color-carbonio)]/82"
      />
      <div class="w-full max-w-4xl mx-auto text-center flex flex-col items-center gap-9">
        <p class="fs-panel-tag" style="color: rgba(245,166,35,0.95);" data-reveal>
          LA METÀ SU ASFALTO
        </p>
        <h2
          class="font-[family-name:var(--font-display)] text-[var(--color-ghiaccio)]"
          style="font-size: clamp(2.4rem, 5vw, 4.4rem); font-weight: 600; line-height: 1.02; letter-spacing: -0.03em;"
          data-display
          data-reveal
          data-reveal-delay="0.1"
        >
          Ogni sosta,<br/>un cliente riconosciuto.
        </h2>

        <!-- Lockup co-brand collegato dalla linea-segnale (ambra) -->
        <div class="flex items-center justify-center gap-6" data-reveal data-reveal-delay="0.28">
          <span class="font-[family-name:var(--font-display)] text-[var(--color-ghiaccio)]" style="font-size: clamp(1.35rem, 2.4vw, 2rem); font-weight: 600; letter-spacing: -0.01em;">FS Park</span>
          <span class="block h-px w-24 sm:w-36" aria-hidden="true" style="background: linear-gradient(90deg, rgba(245,166,35,0) 0%, rgba(245,166,35,0.95) 50%, rgba(245,166,35,0) 100%); box-shadow: 0 0 12px rgba(245,166,35,0.6);"></span>
          <span class="font-[family-name:var(--font-display)] text-[var(--color-ghiaccio)]" style="font-size: clamp(1.35rem, 2.4vw, 2rem); font-weight: 600; letter-spacing: -0.01em;">Adobe</span>
        </div>
      </div>
    </Slide>

  </DeckContainer>
</BaseLayout>
