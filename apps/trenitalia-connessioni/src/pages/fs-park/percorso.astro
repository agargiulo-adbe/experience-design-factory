---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Sfondo from '../../components/Sfondo.astro';
import SfondoLoop from '../../components/SfondoLoop.astro';
import CoBrand from '../../components/CoBrand.astro';
import TreniNavigation from '../../components/TreniNavigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import CoverHero from '@edf/core/blocks/CoverHero.astro';
import DiagSoglia from '../../components/diagrammi/DiagSoglia.astro';
import { href } from '@edf/core/utils/url.js';

const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;

const radar = [
  {
    nome: 'Rinnovi e mancati rinnovi',
    desc: 'Capire chi non rinnova l\'abbonamento e cosa era successo nelle settimane prima.',
  },
  {
    nome: 'Ricorrenze → proposta abbonamento',
    desc: 'Chi acquista soste singole con regolarità riceve la proposta di abbonamento al momento giusto.',
  },
  {
    nome: 'Segmentazione auto / moto / bici',
    desc: 'Comportamenti e bisogni diversi per tipo di veicolo, letti come segmenti distinti.',
  },
  {
    nome: 'Sorgenti che convertono',
    desc: 'Da dove arrivano i clienti che poi comprano davvero: canali, campagne, percorsi di ingresso.',
  },
  {
    nome: 'Transazioni ↔ assistenza',
    desc: 'Correlare acquisti, reclami e richieste CRM: cosa succede al cliente dopo un problema.',
  },
];

// Il POC letto come una soglia: a sinistra, tratteggiato, quello che non serve
// avere pronto; a destra, pieno, quello che si vede già. La freccia di ritorno
// dice che il resto si aggiunge dopo, senza rifare il lavoro.
const sogliaPoc = {
  prima: {
    titolo: 'Non serve averlo pronto',
    voci: [
      'L\'ecosistema completo già in produzione',
      'L\'area riservata web già attiva',
      'Una migrazione preventiva dello storico',
    ],
  },
  soglia: 'Il POC',
  dopo: {
    titolo: 'Si vede già',
    voci: [
      'La riconciliazione delle identità tra sito, app e CRM',
      'Il journey end-to-end, dall\'accesso anonimo all\'acquisto',
      'La drop-off analysis sul funnel di prenotazione',
    ],
  },
  ritorno: 'Quello che manca si aggiunge dopo, senza rifare il POC',
};

// Il riepilogo si ferma al capitolo 04: il 05 è questa pagina — il suo
// contenuto (POC, radar, adozione) vive nel paragrafo di chiusura, non in lista.
const capitoli = [
  { num: '01', label: 'Partenza', desc: 'La metà su asfalto: l\'ecosistema e il cliente in quattro versioni' },
  { num: '02', label: 'Fondamenta', desc: 'Una sola identità: email hashata, Identity Graph, stitching, backfill' },
  { num: '03', label: 'Convergenza', desc: 'Customer Journey Analytics: tutte le fonti, un\'unica lettura' },
  { num: '04', label: 'Metà invisibile', desc: 'La clean room che apre gli scenari di Gruppo, nel rispetto del GDPR' },
];
---
<BaseLayout
  branch="fs-park"
  title="Il percorso"
  description="Il percorso FS Park: POC su dati realistici o simulati, use case sul radar, accompagnamento e orizzonte di Gruppo."
>
  <div class="fixed top-0 left-0 right-0 z-50">
    <TreniNavigation currentPath={currentPath} base={base} branch="fs-park" />
  </div>

  <DeckContainer wallScale
    nextHref={href(base, '/bivio')}
    prevHref={href(base, '/fs-park/meta-invisibile')}
  >

    <!-- ── SLIDE 0: Cover ─────────────────────────────────────────── -->
    <Slide id="slide-cover" bg="primary" align="center">
      <div slot="backdrop" class="fs-bg"></div>
      <div slot="backdrop" class="fsp-stalli"></div>
      <Sfondo slot="backdrop" id="pk-varco" forza="leggera" />
      <CoverHero
        eyebrow="05 · Percorso"
        numeral="05"
        title="Il percorso"
        lead="Si comincia da un passo dimostrabile. Dietro ci sono gli use case già sul radar e un accompagnamento pensato per rendere il team autonomo. Nessuna scadenza imposta: il ritmo lo decide FS Park."
        size="phase"
        tone="ink"
        signature={false}
      />
    </Slide>

    <!-- ── SLIDE 1: Il primo passo — POC ──────────────────────────── -->
    <Slide id="slide-poc" bg="primary" align="center">
      <div slot="backdrop" class="fs-bg"></div>
      <Sfondo slot="backdrop" id="pk-struttura" forza="media" />
      <div slot="backdrop" class="fs-grid"></div>
      <p class="fs-panel-tag text-center mb-4" data-reveal>
        IL PRIMO PASSO
      </p>
      <h2
        class="text-center text-[var(--ink-primary)] mb-4 font-[family-name:var(--font-display)]"
        style="font-size: clamp(1.7rem, 2.8vw, 2.5rem); font-weight: 600; line-height: 1.06; letter-spacing: -0.02em;"
        data-reveal
        data-reveal-delay="0.08"
      >
        Un POC su dati realistici o simulati.
      </h2>
      <p
        class="text-center text-[var(--ink-secondary)] leading-snug max-w-3xl mx-auto mb-10"
        style="font-size: clamp(0.95rem, 1.15vw, 1.08rem);"
        data-reveal
        data-reveal-delay="0.14"
      >
        Il modo più onesto di valutare la piattaforma: vederla lavorare su un caso FS Park,
        prima di qualunque impegno sull'ecosistema reale.
      </p>

      <div class="fsp-diag w-full max-w-6xl mx-auto" data-reveal data-reveal-delay="0.2">
        <DiagSoglia
          prima={sogliaPoc.prima}
          soglia={sogliaPoc.soglia}
          dopo={sogliaPoc.dopo}
          ritorno={sogliaPoc.ritorno}
        />
      </div>

      <p class="mt-9 text-center fs-panel-src tracking-widest uppercase" data-reveal data-reveal-delay="0.3">
        Ipotesi emerse al tavolo di lavoro Adobe × FS Park, luglio 2026 · perimetro da definire insieme
      </p>
    </Slide>

    <!-- ── SLIDE 2: Sul radar ─────────────────────────────────────── -->
    <Slide id="slide-esplorare" bg="secondary" align="center">
      <div slot="backdrop" class="fs-bg-soft"></div>
      <Sfondo slot="backdrop" id="tc-quiete" forza="media" />
      <div slot="backdrop" class="fs-grid"></div>

      <div class="w-full max-w-6xl mx-auto">
        <div class="text-center mb-4">
          <p class="fs-panel-tag inline-block" data-reveal>
            SUL RADAR · DOPO I PRIMI TRE USE CASE
          </p>
          <h2
            class="text-[var(--ink-primary)] mt-3 font-[family-name:var(--font-display)]"
            style="font-size: clamp(1.6rem, 2.4vw, 2.2rem); font-weight: 600; line-height: 1.06; letter-spacing: -0.02em;"
            data-reveal
            data-reveal-delay="0.08"
          >
            Cinque direzioni già individuate.
          </h2>
        </div>

        <div class="relative flex flex-col gap-2">
          <div class="fs-line-h hidden md:block" style="left: 1.45rem; top: 1.45rem; bottom: 1.45rem; width: 2px; height: auto; background: linear-gradient(180deg, rgba(var(--sig-rgb), 0) 0%, rgba(var(--sig-rgb), 0.9) 8%, rgba(var(--sig-rgb), 0.9) 92%, rgba(var(--sig-rgb), 0) 100%);" aria-hidden="true"></div>

          {radar.map((r, i) => (
            <div
              class="relative flex items-center gap-4"
              data-reveal
              data-reveal-delay={(0.12 + i * 0.05).toFixed(2)}
            >
              <span class="fs-node fs-node--sig flex-shrink-0 relative z-10" data-active aria-hidden="true">{i + 1}</span>
              <div class="fs-card flex-1 min-w-0 text-left" style="padding: 0.65rem 1rem;">
                <div class="flex items-center gap-2.5 flex-wrap mb-0.5">
                  <p class="fs-card-title" style="font-size: 1.05rem; margin-inline: 0;">{r.nome}</p>
                  <span class="text-[0.7rem] font-bold px-2 py-0.5 rounded-sm tracking-wide uppercase flex-shrink-0" style="background: rgba(var(--sig-rgb), 0.16); color: rgba(var(--sig-rgb), 0.98);">
                    Da validare sul campo
                  </span>
                </div>
                <p class="fs-card-body" style="font-size: 0.95rem; line-height: 1.5; margin-inline: 0;">{r.desc}</p>
              </div>
            </div>
          ))}
        </div>

        <p class="mt-3 text-center fs-panel-src tracking-widest uppercase" data-reveal data-reveal-delay="0.4">
          Use case raccolti al tavolo di lavoro Adobe × FS Park, luglio 2026
        </p>
      </div>
    </Slide>

    <!-- ── SLIDE 3: Accompagnamento e formazione ──────────────────── -->
    <Slide id="slide-adozione" bg="primary" align="center">
      <div slot="backdrop" class="fs-bg"></div>
      <Sfondo slot="backdrop" id="pk-stalli" forza="media" />
      <div slot="backdrop" class="fs-grid"></div>
      <p class="fs-panel-tag text-center mb-4" data-reveal>
        ADOZIONE · DENTRO IL PERCORSO, NON DOPO
      </p>
      <h2
        class="text-center text-[var(--ink-primary)] mb-4 font-[family-name:var(--font-display)]"
        style="font-size: clamp(1.7rem, 2.8vw, 2.5rem); font-weight: 600; line-height: 1.06; letter-spacing: -0.02em;"
        data-reveal
        data-reveal-delay="0.08"
      >
        L'accompagnamento fa parte del progetto.
      </h2>
      <p
        class="text-center text-[var(--ink-secondary)] leading-snug max-w-3xl mx-auto mb-7"
        style="font-size: clamp(0.95rem, 1.15vw, 1.08rem);"
        data-reveal
        data-reveal-delay="0.14"
      >
        Ogni fase del percorso include chi aiuta a leggere i dati e a trasformarli in decisioni.
        L'obiettivo è costruire autonomia, un'analisi alla volta, senza creare dipendenza.
      </p>

      <div class="w-full max-w-5xl mx-auto grid md:grid-cols-2 gap-6" data-reveal data-reveal-delay="0.2">
        <div class="fs-panel text-left" style="padding: 1.9rem 2rem;">
          <p class="fs-panel-tag mb-3">Affiancamento alla lettura</p>
          <p class="fs-panel-body" style="font-size: 1.05rem; line-height: 1.65;">
            Le analisi dei primi mesi si costruiscono in sessioni di lavoro congiunte,
            partendo dalle domande del business e arrivando insieme alla risposta nei dati.
          </p>
        </div>
        <div class="fs-panel text-left" style="padding: 1.9rem 2rem;">
          <p class="fs-panel-tag mb-3">Autonomia progressiva</p>
          <p class="fs-panel-body" style="font-size: 1.05rem; line-height: 1.65;">
            Formazione sul metodo e AI Assistant per interrogare i dati in linguaggio
            naturale: nel tempo il team fa da solo, e l'affiancamento si sposta sui casi nuovi.
          </p>
        </div>
      </div>

      <p class="mt-7 text-center fs-panel-src tracking-widest uppercase" data-reveal data-reveal-delay="0.3">
        Percorso di accompagnamento emerso al tavolo di lavoro Adobe × FS Park, luglio 2026
      </p>
    </Slide>

    <!-- ── SLIDE 4: Verso il Gruppo ───────────────────────────────── -->
    <Slide id="slide-orizzonte" bg="primary" align="center">
      <div slot="backdrop" class="fs-bg"></div>
      <div slot="backdrop" class="fsp-stalli"></div>
      <Sfondo slot="backdrop" id="pk-alba" forza="media" />
      <p class="fs-panel-tag text-center mb-4" data-reveal>
        L'ORIZZONTE
      </p>
      <h2
        class="text-[var(--color-chiaro)] mb-5 text-center font-[family-name:var(--font-display)]"
        style="font-size: clamp(1.9rem, 3.4vw, 3.1rem); font-weight: 600; line-height: 1.06; letter-spacing: -0.02em;"
        data-reveal
        data-reveal-delay="0.08"
      >
        Quando l'asfalto incontra la rotaia.
      </h2>
      <p
        class="text-[var(--color-grigio-200)] max-w-3xl mx-auto text-center mb-10"
        style="font-size: clamp(1rem, 1.25vw, 1.2rem); line-height: 1.55;"
        data-reveal
        data-reveal-delay="0.15"
      >
        Il valore per FS Park parte prima e non aspetta nessuno. Ma la linea del bivio
        può richiudersi: la clean room permette alle due metà del viaggio di Davide di
        raccontarsi a vicenda, con ogni società padrona dei propri dati. Resta una
        possibilità aperta, da cui nessuno dei due rami dipende.
      </p>

      <div class="relative w-full max-w-4xl mx-auto" data-reveal data-reveal-delay="0.24">
        <span class="fs-line-h" style="top: 1.4rem; left: 4%; width: 42%; background: linear-gradient(90deg, rgba(var(--sig-rgb), 0) 0%, rgba(var(--sig-rgb), 0.9) 25%, rgba(var(--sig-rgb), 0.9) 100%);" aria-hidden="true"></span>
        <span class="fs-line-h" style="top: 1.4rem; right: 4%; width: 42%; background: linear-gradient(90deg, rgba(var(--sig2-rgb), 0.9) 0%, rgba(var(--sig2-rgb), 0.9) 75%, rgba(var(--sig2-rgb), 0) 100%);" aria-hidden="true"></span>
        <div class="grid grid-cols-3 gap-4">
          <div class="flex flex-col items-center gap-2.5 text-center">
            <span class="fs-node fs-node--sig" data-active>🅿️</span>
            <span class="fs-node-label">La metà su asfalto · FS Park</span>
          </div>
          <div class="flex flex-col items-center gap-2.5 text-center">
            <span class="fs-node relative z-10" data-active style="border-color: rgba(241, 243, 244, 0.9); box-shadow: 0 0 18px rgba(241, 243, 244, 0.4);">⇄</span>
            <span class="fs-node-label">La clean room · Real-Time CDP Collaboration</span>
          </div>
          <div class="flex flex-col items-center gap-2.5 text-center">
            <span class="fs-node fs-node--alt" data-active>🚆</span>
            <span class="fs-node-label">La metà su rotaia · Trenitalia</span>
          </div>
        </div>
      </div>

      <p
        class="mt-10 text-center text-[var(--color-grigio-200)] max-w-2xl mx-auto"
        style="font-size: 0.98rem; line-height: 1.55;"
        data-reveal
        data-reveal-delay="0.32"
      >
        Gli scenari intersocietari restano da esplorare, con ogni società titolare
        dei propri dati. Intanto il ramo FS Park cammina sulle proprie gambe.
      </p>
    </Slide>

    <!-- ── SLIDE 5: Sintesi + invito ──────────────────────────────── -->
    <Slide id="slide-sintesi" bg="primary" align="center">
      <div slot="backdrop" class="fs-bg"></div>
      <Sfondo slot="backdrop" id="tc-strati" forza="media" />
      <div slot="backdrop" class="fs-grid"></div>
      <p class="fs-panel-tag text-center mb-4" data-reveal>
        IN SINTESI · IL RAMO FS PARK
      </p>
      <h2
        class="text-center text-[var(--ink-primary)] mb-6 font-[family-name:var(--font-display)]"
        style="font-size: clamp(1.7rem, 2.8vw, 2.5rem); font-weight: 600; line-height: 1.06; letter-spacing: -0.02em;"
        data-reveal
        data-reveal-delay="0.08"
      >
        Un cliente intero, a partire da casa propria.
      </h2>

      <div class="w-full max-w-4xl mx-auto flex flex-col gap-2.5 mb-6" data-reveal data-reveal-delay="0.16">
        {capitoli.map((c) => (
          <div class="fs-card flex items-center gap-4 text-left" style="padding: 0.75rem 1.1rem;">
            <span class="fs-node fs-node--sig flex-shrink-0" data-active style="width:2.2rem;height:2.2rem;font-size:0.82rem;" aria-hidden="true">{c.num}</span>
            <div class="min-w-0 flex-1">
              <p class="fs-card-title" style="font-size: 1.02rem; margin-inline: 0;">{c.label}</p>
              <p class="fs-card-body" style="font-size: 0.95rem; line-height: 1.45; margin-inline: 0;">{c.desc}</p>
            </div>
          </div>
        ))}
      </div>

      <p
        class="text-center text-[var(--ink-secondary)] max-w-2xl mx-auto mb-6"
        style="font-size: clamp(0.98rem, 1.2vw, 1.1rem); line-height: 1.55;"
        data-reveal
        data-reveal-delay="0.26"
      >
        Da qui comincia il percorso vero, con il POC su dati simulati e l'adozione
        accompagnata. Il primo passo è sedersi sui dati e definire insieme il perimetro
        del POC e le prime domande a cui rispondere.
      </p>

      <div class="text-center" data-reveal data-reveal-delay="0.34">
        <a
          href={href(base, '/bivio')}
          class="inline-flex items-center gap-3 px-8 py-3 text-base font-semibold tracking-wide bg-[var(--color-verde)] text-white hover:bg-[#00807f] transition-colors duration-300 font-[family-name:var(--font-display)] rounded-sm"
        >
          Torna al bivio
          <svg width="18" height="18" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>
    </Slide>

    <!-- ── SLIDE 6: Chiusura — solo visual ────────────────────────── -->
    <Slide id="slide-chiusura" bg="primary" align="center" data-made-with="Firefly" data-made-with-for="clip">
      <div slot="backdrop" class="fs-bg"></div>
      <div slot="backdrop" class="fsp-stalli"></div>
      <SfondoLoop slot="backdrop" id="linea-chiusura" forza="media" />
      <div class="w-full max-w-4xl mx-auto text-center flex flex-col items-center gap-9">
        <p class="fs-panel-tag" style="color: rgba(var(--sig-rgb), 0.95);" data-reveal>
          LA METÀ SU ASFALTO
        </p>
        <h2
          class="font-[family-name:var(--font-display)] text-[var(--color-chiaro)]"
          style="font-size: clamp(2.4rem, 5vw, 4.4rem); font-weight: 600; line-height: 1.02; letter-spacing: -0.03em;"
          data-display
          data-reveal
          data-reveal-delay="0.1"
        >
          Ogni sosta,<br/>un cliente riconosciuto.
        </h2>

        <CoBrand brand="FS Park" variant="hero" data-reveal data-reveal-delay="0.28" />
        <a href={href(base, '/fs-park/partenza')} class="edf-sig-cta" data-reveal data-reveal-delay="0.4">Rivedi il percorso →</a>
      </div>
    </Slide>

  </DeckContainer>
</BaseLayout>

<!-- Come in fondamenta.astro: il ritmo delle voci del DiagSoglia su fondo nudo
     va portato ai 16px che una proiezione pretende. -->
