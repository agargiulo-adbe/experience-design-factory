---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Sfondo from '../../components/Sfondo.astro';
import TreniNavigation from '../../components/TreniNavigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import CoverHero from '@edf/core/blocks/CoverHero.astro';
import DiagSoglia from '../../components/diagrammi/DiagSoglia.astro';
import DiagStrati from '../../components/diagrammi/DiagStrati.astro';
import { href } from '@edf/core/utils/url.js';

const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;

const chiavi = [
  {
    nome: 'Email, anche hashata',
    ruolo: 'Identificativo candidato',
    desc: 'Il dato comune ad app, area riservata e CRM. Hashata, riconosce senza esporre nulla in chiaro.',
  },
  // La chiave email esiste solo dopo il login, e al varco il login non c'è:
  // senza la targa il cliente più ricorrente resta fuori dal grafo. È un dato
  // personale, quindi la condizione legale si dice qui, non dopo.
  {
    nome: 'La targa, al varco',
    ruolo: 'La chiave fuori dal login',
    desc: 'Al varco il cliente è una targa, e una targa è un dato personale: entra nel grafo solo con base giuridica e informativa che lo prevedano. In app si lega alla prenotazione.',
  },
  {
    nome: 'Identity Graph',
    ruolo: 'La mappa delle identità',
    desc: 'Collega gli identificativi dello stesso cliente: cookie, ID dell\'app, record CRM, targa.',
  },
  {
    nome: 'Stitching',
    ruolo: 'Il ricucito dei percorsi',
    desc: 'Sessioni anonime e autenticate della stessa persona diventano un percorso unico.',
  },
  // La finestra accanto al meccanismo: «anche tutto il prima» prometteva una
  // retroattività illimitata, e il cliente l'avrebbe scoperta a POC finito.
  {
    nome: 'Backfill',
    ruolo: 'Il recupero del prima',
    desc: 'Il prima si riattacca una volta sola, nella finestra del pacchetto: 13–25 mesi; lookback 30 giorni.',
  },
];

// Il confine anonimo/autenticato, disegnato: a sinistra quel che c'è senza un
// nome (tratteggiato), a destra quel che si sa dal login in poi, e la freccia
// che torna indietro — la riconciliazione che riattacca il prima.
const sogliaLogin = {
  prima: {
    titolo: 'Prima del login · anonimo',
    voci: [
      'Pagine viste, tariffe confrontate, ricerche di disponibilità',
      'Nessun nome: solo un identificativo tecnico di sessione',
      'Qui matura la decisione di acquisto, e il CRM non la vede',
    ],
  },
  soglia: 'Login',
  dopo: {
    titolo: 'Dal login in poi · autenticato',
    voci: [
      'Profilo noto: prenotazioni, pagamenti, abbonamenti',
      'Comportamento in app già tracciato e attribuibile',
      'Sosta e assistenza finiscono sulla stessa persona',
    ],
  },
  ritorno: 'La riconciliazione riattacca il prima a questo profilo, dentro una finestra definita',
};

// La piattaforma vista di taglio: sotto i sistemi di oggi, che non si toccano;
// sopra lo schema e la lettura. Sostituisce le tre card che lo dicevano a parole.
const stratiXdm = [
  { nome: 'Sito, app, area riservata, CRM Salesforce', nota: 'Restano dove sono, come oggi' },
  { nome: 'Source connector e tagging già in produzione', nota: 'Lo storico entra, e quel che l\'app traccia si riusa' },
  { nome: 'Schema XDM · Adobe Experience Platform', nota: 'Eventi, profili e transazioni in una lingua sola', evidenza: true },
  { nome: 'Customer Journey Analytics', nota: 'Legge il flusso che arriva da sotto' },
];
---
<BaseLayout
  branch="fs-park"
  title="Le fondamenta: una sola identità"
  description="Riconciliare l'anonimo e l'autenticato: email hashata, Identity Graph, stitching e backfill per un solo cliente FS Park."
>
  <div class="fixed top-0 left-0 right-0 z-50">
    <TreniNavigation currentPath={currentPath} base={base} branch="fs-park" />
  </div>

  <DeckContainer wallScale
    nextHref={href(base, '/fs-park/convergenza')}
    prevHref={href(base, '/fs-park/partenza')}
  >

    <!-- ── SLIDE 0: Cover ─────────────────────────────────────────── -->
    <Slide id="slide-cover" bg="primary" align="center">
      <div slot="backdrop" class="fs-bg"></div>
      <Sfondo slot="backdrop" id="pk-rampa" forza="leggera" />
      <div slot="backdrop" class="fsp-stalli"></div>
      <CoverHero
        eyebrow="02 · Fondamenta"
        numeral="02"
        title="Le fondamenta:<br/>una sola identità"
        lead="Prima delle dashboard viene l'identità. Il lavoro vero è far riconoscere alla piattaforma che l'anonimo sul sito, l'utente in app e il record CRM sono la stessa persona."
        size="phase"
        tone="ink"
        signature={false}
      />
    </Slide>

    <!-- ── SLIDE 1: Il confine anonimo / autenticato ──────────────── -->
    <Slide id="slide-anonimo" bg="primary" align="center">
      <div slot="backdrop" class="fs-bg"></div>
      <Sfondo slot="backdrop" id="pk-struttura" forza="forte" />
      <div slot="backdrop" class="fs-grid"></div>
      <p class="fs-panel-tag text-center mb-4" data-reveal>
        IL CONFINE ANONIMO / AUTENTICATO
      </p>
      <h2
        class="text-center text-[var(--ink-primary)] mb-4 font-[family-name:var(--font-display)]"
        style="font-size: clamp(1.7rem, 2.8vw, 2.5rem); font-weight: 600; line-height: 1.06; letter-spacing: -0.02em;"
        data-reveal
        data-reveal-delay="0.08"
      >
        Al login, il cliente si accende.
      </h2>
      <p
        class="text-center text-[var(--ink-secondary)] leading-snug max-w-2xl mx-auto mb-10"
        style="font-size: clamp(0.95rem, 1.15vw, 1.08rem);"
        data-reveal
        data-reveal-delay="0.14"
      >
        Fino a quel momento è un visitatore qualunque. Quello che conta davvero
        è poter ricostruire anche tutto quanto c'era prima.
      </p>

      <div class="fsp-diag w-full max-w-6xl mx-auto" data-reveal data-reveal-delay="0.2">
        <DiagSoglia
          prima={sogliaLogin.prima}
          soglia={sogliaLogin.soglia}
          dopo={sogliaLogin.dopo}
          ritorno={sogliaLogin.ritorno}
        />
      </div>

      <p class="mt-9 text-center fs-panel-src tracking-widest uppercase" data-reveal data-reveal-delay="0.3">
        Ricostruire il prima è il cuore della riconciliazione · dal tavolo di lavoro Adobe × FS Park, luglio 2026
      </p>
    </Slide>

    <!-- ── SLIDE 2: La chiave di riconciliazione ──────────────────── -->
    <Slide id="slide-chiave" bg="secondary" align="center">
      <div slot="backdrop" class="fs-bg-soft"></div>
      <Sfondo slot="backdrop" id="pk-asfalto" forza="media" />
      <div slot="backdrop" class="fs-grid"></div>

      <div class="w-full max-w-6xl mx-auto">
        <div class="text-center mb-3">
          <p class="fs-panel-tag inline-block" data-reveal>
            LE CHIAVI DI RICONCILIAZIONE
          </p>
          <h2
            class="text-[var(--ink-primary)] mt-2 font-[family-name:var(--font-display)]"
            style="font-size: clamp(1.6rem, 2.4vw, 2.2rem); font-weight: 600; line-height: 1.06; letter-spacing: -0.02em;"
            data-reveal
            data-reveal-delay="0.08"
          >
            Due chiavi, tre meccanismi che le usano.
          </h2>
        </div>

        <div class="relative flex flex-col gap-1.5">
          <div class="fs-line-h hidden md:block" style="left: 1.45rem; top: 1.45rem; bottom: 1.45rem; width: 2px; height: auto; background: linear-gradient(180deg, rgba(var(--sig-rgb), 0) 0%, rgba(var(--sig-rgb), 0.9) 8%, rgba(var(--sig-rgb), 0.9) 92%, rgba(var(--sig-rgb), 0) 100%);" aria-hidden="true"></div>

          {chiavi.map((c, i) => (
            <div
              class="relative grid md:grid-cols-[13rem_1fr] items-center gap-4"
              data-reveal
              data-reveal-delay={(0.14 + i * 0.06).toFixed(2)}
            >
              <div class="flex items-center gap-4">
                <span class="fs-node fs-node--sig flex-shrink-0 relative z-10" data-active aria-hidden="true">{i + 1}</span>
                <p class="fs-node-label font-semibold uppercase tracking-widest leading-tight" style="color: rgba(var(--sig-rgb), 0.95); font-size: 0.78rem;">
                  {c.ruolo}
                </p>
              </div>

              <div class="fs-card flex items-center gap-4 text-left" style="padding: 0.6rem 1.1rem;">
                <div class="flex-1 min-w-0">
                  <p class="fs-card-title mb-1" style="font-size: 1.08rem; margin-inline: 0;">{c.nome}</p>
                  <p class="fs-card-body" style="font-size: 0.95rem; line-height: 1.5; margin-inline: 0;">{c.desc}</p>
                </div>
              </div>
            </div>
          ))}
        </div>

        <p class="mt-3 text-center fs-panel-src max-w-6xl mx-auto" data-reveal data-reveal-delay="0.42">
          Quanto la chiave riconosca è un esito del POC, non una promessa: ospiti e canali indiretti restano fuori · tavolo Adobe × FS Park, luglio 2026
        </p>
      </div>
    </Slide>

    <!-- ── SLIDE 3: Da fonti a schema — XDM ───────────────────────── -->
    <Slide id="slide-xdm" bg="primary" align="center">
      <Sfondo slot="backdrop" id="tc-acciaio" forza="media" />
      <div slot="backdrop" class="fs-bg-soft"></div>

      <div class="w-full max-w-6xl mx-auto">
        <div class="fs-panel mb-5" data-reveal>
          <p class="fs-panel-tag">DA FONTI A SCHEMA · ADOBE EXPERIENCE PLATFORM</p>
          <h2 class="fs-panel-head mt-1 mb-3" style="font-size: clamp(1.5rem, 2.3vw, 2.1rem);">
            Le fonti restano dove sono.<br/>Cambia la lingua in cui si parlano.
          </h2>
          <p class="fs-panel-body max-w-4xl" style="font-size: clamp(0.98rem, 1.1vw, 1.08rem); line-height: 1.6;">
            Sito, app e CRM continuano a lavorare come oggi. Adobe Experience Platform li accoglie
            in uno schema comune, il flusso alimenta Customer Journey Analytics e lo storico
            entra dai connettori. Nessuna fonte viene sostituita per strada.
          </p>
        </div>

        <!-- Gli strati al posto delle tre card: la sovrapposizione si vede, e si
             vede che sotto non si tocca niente. -->
        <div class="mb-4" data-reveal data-reveal-delay="0.14">
          <DiagStrati strati={stratiXdm} />
        </div>

        <p class="fs-panel-src text-center" data-reveal data-reveal-delay="0.24">
          La quantità di dati storici da portare dentro è da valutare insieme · dal tavolo di lavoro Adobe × FS Park, luglio 2026
        </p>
      </div>
    </Slide>

    <!-- ── SLIDE 4: Non rifare. Riconciliare. ─────────────────────── -->
    <Slide id="slide-choice" bg="primary" align="center">
      <div slot="backdrop" class="fs-bg"></div>
      <div slot="backdrop" class="fsp-stalli"></div>
      <Sfondo slot="backdrop" id="pk-alba" forza="media" />
      <div class="w-full max-w-3xl mx-auto text-left">
        <p class="slide-eyebrow text-[rgba(var(--sig-rgb), 0.95)] mb-8" data-reveal>
          IL PRINCIPIO GUIDA
        </p>
        <div class="fs-quote" data-reveal data-reveal-delay="0.08">
          <h2
            class="fs-quote-text text-[var(--color-chiaro)] font-[family-name:var(--font-display)]"
            style="font-size: clamp(2.5rem, 5vw, 4.5rem); font-weight: 700; line-height: 1.0; letter-spacing: -0.03em;"
          >
            Non si rifà:<br/>si riconcilia.
          </h2>
        </div>
        <p
          class="text-[var(--color-grigio-200)] leading-relaxed max-w-2xl mt-6 mb-10"
          style="font-size: clamp(1.1rem, 1.5vw, 1.4rem);"
          data-reveal
          data-reveal-delay="0.16"
        >
          Il sito può evolvere con i suoi tempi, l'app è già tracciata e l'area riservata
          arriverà. La piattaforma riconcilia quello che c'è e accoglie quello che arriva
          dopo. A nessuno viene chiesto di ripartire da zero.
        </p>

        <!-- La foundation di Gruppo comprende FS Park per nome: tacerla qui, e
             dedicarle una slide intera nel ramo Trenitalia, voleva dire portare
             due fotografie diverse della stessa azienda a due tavoli. -->
        <p
          class="fs-panel-src max-w-2xl -mt-6 mb-10"
          data-reveal
          data-reveal-delay="0.2"
        >
          Vale anche per la base di Gruppo: la piattaforma agentica che FS Technology ha
          avviato con Salesforce nel marzo 2026 mette Trenitalia, Busitalia, FS Park e
          FS Logistix sullo stesso backbone CRM. Adobe si aggancia lì, non accanto.&nbsp;
          <a href="https://www.fsnews.it/it/focus-on/innovazione/2026/3/5/fs-technology-salesforce-foundation-digitale.html" target="_blank" rel="noopener noreferrer" class="underline underline-offset-2">fsnews.it, marzo 2026</a>
        </p>

        <div class="flex flex-col sm:flex-row gap-4 max-w-2xl" data-reveal data-reveal-delay="0.24">
          <a
            href={href(base, '/fs-park/convergenza')}
            class="flex-1 inline-flex items-center justify-center gap-3 px-8 py-4 text-base font-semibold tracking-wide bg-[var(--color-verde)] text-white hover:bg-[#00807f] transition-colors duration-300 font-[family-name:var(--font-display)]"
          >
            CJA: tutte le fonti, un'unica lettura
            <svg width="18" height="18" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        </div>
      </div>
    </Slide>

  </DeckContainer>
</BaseLayout>

<!-- Le voci del DiagSoglia stanno su fondo nudo dentro le loro colonne: a
     0.45rem di gap l'audit le conta appiccicate e in proiezione lo sono.
     `is:global` perché il markup è del componente, non di questa pagina. -->
