---
import BaseLayout from '../layouts/BaseLayout.astro';
import Sfondo from '../components/Sfondo.astro';
import TreniNavigation from '../components/TreniNavigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import CoverHero from '@edf/core/blocks/CoverHero.astro';
import MediaSlot from '@edf/core/blocks/MediaSlot.astro';
import { href } from '@edf/core/utils/url.js';
import { rotte } from '../data/percorso';
import { mediaProps } from '../../assets.index';

const base = import.meta.env.BASE_URL;
// Avanti e indietro vengono dal percorso, non scritti a mano: così spegnere
// un capitolo non lascia una freccia che punta fuori dal percorso.
const { next, prev } = rotte('scenario');
const currentPath = Astro.url.pathname;

// `fase1` dice quali due sistemi stanno nel perimetro di questa proposta. Gli
// altri quattro restano in pagina perché la fotografia dell'oggi è questa, ma
// marcarli evita la promessa di un'integrazione che non è sul tavolo.
const touchpoints = [
  { label: 'trenitalia.com',  icon: '🌐', owner: 'Trenitalia', fase1: true,  nota: 'Adobe Analytics istanza 1 · navigazione e ricerche' },
  { label: 'Salesforce CRM',  icon: '☁️', owner: 'FSTechnology', fase1: true, nota: 'Foundation 2026 · Data Cloud · MuleSoft' },
  { label: 'Frecce booking',  icon: '🎫', owner: 'Trenitalia', fase1: false, nota: 'Adobe Analytics istanza 2 · funnel acquisto' },
  { label: 'App Trenitalia', icon: '📱', owner: 'Trenitalia', fase1: false, nota: 'Streaming events · comportamento in-app' },
  { label: 'Piattaforma di esecuzione email', icon: '📧', owner: 'Trenitalia', fase1: false, nota: 'Campagne CRM · CartaFreccia · X-GO' },
  // FS Park ha una propria app (iOS e Android) per prenotazione, estensione
  // della sosta e abbonamenti. EasyPark è un canale diverso — accesso e
  // pagamento con lettura targa — e fino al 9 ott 2026 questa riga lo dava
  // come il sistema di prenotazione: due fornitori confusi in uno.
  { label: 'App FS Park',     icon: '🅿️', owner: 'FS Park', fase1: false, nota: 'Prenotazione, estensione della sosta, abbonamenti' },
];
---
<BaseLayout
  title="Il viaggio del cliente oggi"
  description="Quattro canali, sei sistemi, e un identificativo che non li attraversa. Lo scenario da cui parte CJA."
>
  <div class="fixed top-0 left-0 right-0 z-50">
    <TreniNavigation currentPath={currentPath} base={base} />
  </div>

  <DeckContainer wallScale
    nextHref={href(base, next)}
    prevHref={href(base, prev)}
  >

    <!-- ── SLIDE 0: Cover ─────────────────────────────────────────── -->
    <Slide id="slide-cover" bg="primary" align="center">
      <div slot="backdrop" class="fs-bg"></div>
      <div slot="backdrop" class="fs-grid"></div>
      <Sfondo slot="backdrop" id="tr-atrio" forza="leggera" />
      <!-- Senza numero: la serie 01–05 è dei capitoli di ramo, e un «01 ·
           Scenario» accanto a un «01 · Partenza» faceva due capitoli primi
           nello stesso documento. -->
      <CoverHero
        eyebrow="Tronco comune · Scenario"
        title="Il viaggio del cliente oggi"
        lead="Davide usa quattro canali in un viaggio solo. Quanti di questi sistemi sanno che è sempre lui?"
        size="phase"
        tone="ink"
        signature={false}
      />
    </Slide>

    <!-- ── SLIDE 1: Davide, il pendolare ──────────────────────────── -->
    <Slide id="slide-marco" bg="primary" align="split">
      <div slot="backdrop" class="fs-bg"></div>
      <Sfondo slot="backdrop" id="tr-quiete" forza="media" />
      <div slot="backdrop" class="fs-grid"></div>
      <div class="w-full flex-1 min-h-0 grid md:grid-cols-[minmax(0,0.82fr)_minmax(0,1fr)] gap-10 md:gap-14 items-center">
        <div class="flex items-center justify-center" data-reveal>
          <div class="relative overflow-hidden rounded-sm mx-auto" style="width:min(100%,420px); aspect-ratio:4/5; height:min(520px,64dvh);">
            <MediaSlot {...mediaProps('persona-marco')} fill objectPosition="52% 32%" />
            <div class="absolute inset-x-0 bottom-0 h-[38%] bg-gradient-to-t from-[rgba(27, 34, 48, 0.85)] to-transparent" aria-hidden="true"></div>
            <div class="absolute left-4 bottom-4 flex items-center gap-2.5" aria-hidden="true">
              <span class="fs-node !w-11 !h-11" data-active>D</span>
              <span class="fs-node-label !text-[rgba(241, 243, 244, 0.9)]">Il cliente che compra già</span>
            </div>
          </div>
        </div>

        <div class="text-left max-w-xl">
          <p class="fs-panel-tag mb-3" data-reveal>
            STORIA DI DAVIDE · IL VIAGGIO INTERO
          </p>
          <h2
            class="text-[var(--ink-primary)] mb-6 font-[family-name:var(--font-display)]"
            style="font-size: clamp(2rem, 3.8vw, 3.5rem); font-weight: 600; line-height: 1.06; letter-spacing: -0.02em;"
            data-reveal
            data-reveal-delay="0.1"
          >
            Davide, 38 anni.<br />Pendolare business.
          </h2>
          <p
            class="text-[var(--ink-secondary)] leading-relaxed mb-7"
            style="font-size: clamp(1rem, 1.4vw, 1.25rem);"
            data-reveal
            data-reveal-delay="0.2"
          >
            Ogni lunedì mattina Davide prende il Frecciarossa per Roma e il venerdì rientra a
            Milano. È un cliente CartaFreccia Oro da quattro anni, con un abbonamento mensile
            A/R acquistato sempre in app. Fuori dal lavoro cerca altre tratte, le guarda e le
            lascia lì: quelle ricerche restano in un sistema che non parla con il suo profilo.
          </p>
          <div class="fs-panel" data-reveal data-reveal-delay="0.4">
            <p class="fs-panel-tag mb-2.5">Davide, oggi</p>
            <div class="fs-quote">
              <p class="fs-quote-text" style="font-size: clamp(1.05rem, 1.5vw, 1.3rem); line-height: 1.4;">
                «Ricevo email CartaFreccia ogni settimana e sono sempre le stesse. Napoli la
                cerco da un mese: in quelle email non ne ho mai vista una.»
              </p>
            </div>
          </div>
        </div>
      </div>
    </Slide>

    <!-- ── SLIDE 2: I 6 touchpoint → dato frammentato ─────────────── -->
    <Slide id="slide-touchpoints" bg="primary" align="center">
      <div slot="backdrop" class="fs-bg"></div>
      <Sfondo slot="backdrop" id="tc-strati" forza="media" />
      <div slot="backdrop" class="fs-grid"></div>
      <p class="fs-panel-tag text-center mb-3" data-reveal>
        IL PROBLEMA
      </p>
      <h2
        class="text-[var(--ink-primary)] mb-4 font-[family-name:var(--font-display)]"
        style="font-size: clamp(1.8rem, 3vw, 2.8rem); font-weight: 600; line-height: 1.06; letter-spacing: -0.02em;"
        data-reveal
        data-reveal-delay="0.08"
      >
        Davide usa quattro canali.<br/>Quanti di questi sistemi sanno che è sempre lui?
      </h2>
      {/* Six systems on one signal line — nodes lit, but the story between them is dark. */}
      <div class="relative w-full max-w-6xl mx-auto" data-reveal data-reveal-delay="0.22">
        <span class="fs-line-h hidden md:block" style="top: 1.4rem; left: 8.3%; right: 8.3%;" aria-hidden="true"></span>
        <div class="grid grid-cols-2 md:grid-cols-3 auto-rows-fr gap-x-4 gap-y-4 max-[1350px]:gap-y-3 relative">
          {touchpoints.map((tp, i) => (
            <div class="flex flex-col items-center h-full">
              <span class:list={["fs-node mb-3 relative z-10 max-[1350px]:!w-9 max-[1350px]:!h-9 max-[1350px]:!text-[0.85rem]", tp.owner === 'FS Park' && "fs-node--park"]} aria-hidden="true">
                {String(i + 1).padStart(2, "0")}
              </span>
              <div
                class:list={["fs-card w-full flex-1 text-left flex items-start gap-3 !py-4 !px-5 max-[1350px]:!py-2.5 max-[1350px]:!px-3.5", !tp.fase1 && "opacity-80"]}
                style={tp.fase1 ? 'border-color: rgba(var(--rail-rgb), 0.55); box-shadow: inset 2px 0 0 rgba(var(--rail-rgb), 0.9);' : undefined}
              >
                <span class="text-2xl flex-shrink-0 mt-0.5" aria-hidden="true">{tp.icon}</span>
                <div class="min-w-0 flex-1">
                  <div class="flex items-center gap-2 flex-wrap mb-1">
                    <p class="fs-card-title">{tp.label}</p>
                    <span
                      class="text-[0.72rem] font-bold px-1.5 py-0.5 rounded-sm tracking-wide uppercase"
                      style={tp.owner === 'FS Park'
                        ? 'background: rgba(var(--sig-rgb), 0.18); color: rgba(var(--sig-rgb), 0.95);'
                        : tp.owner === 'FSTechnology'
                          ? 'background: rgba(241, 243, 244, 0.12); color: rgba(241, 243, 244, 0.75);'
                          : 'background: rgba(var(--sig2-rgb), 0.2); color: rgba(255,122,134,0.95);'}
                    >{tp.owner}</span>
                  </div>
                  <p class="fs-card-body">{tp.nota}</p>
                  {tp.fase1 && (
                    <p class="mt-1.5 text-[0.78rem] font-semibold tracking-wide uppercase" style="color: rgba(var(--rail-rgb), 0.95);">
                      Nel perimetro della prima fase
                    </p>
                  )}
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
      <!-- EasyPark va nominato per quello che è — accesso e pagamento con
           lettura della targa, operatore terzo — perché fino al 9 ott 2026
           stava al posto dell'app FS Park. Chi è titolare del dato quando il
           canale è di terzi lo dice il ramo FS Park, dove c'è lo spazio. -->
      <p class="mt-4 text-center fs-panel-src max-w-4xl mx-auto">
        Questa proposta prende i due sistemi marcati e li unisce. Gli altri quattro entrano più
        tardi, uno per volta · la sosta passa anche da EasyPark, operatore terzo, con lettura
        della targa · ecosistema da riconfermare, fonte: tavolo tecnico FSTechnology apr 2025 e
        tracking delle campagne
      </p>
    </Slide>

    <!-- ── SLIDE 3: Il momento dell'opportunità ───────────────────── -->
    <Slide id="slide-opportunity" bg="inverse" align="center">
      <Sfondo slot="backdrop" id="rl-alba" forza="forte" chiara />
      <p class="fs-panel-tag text-center mb-4" data-reveal>
        L'OPPORTUNITÀ MANCATA
      </p>
      <h2
        class="text-[var(--color-ardesia-notte)] mb-6 font-[family-name:var(--font-display)]"
        style="font-size: clamp(1.8rem, 3vw, 2.8rem); font-weight: 600; line-height: 1.06; letter-spacing: -0.02em;"
        data-reveal
        data-reveal-delay="0.08"
      >
        Davide cerca Napoli da settimane.<br/>Compra sempre e solo Roma.
      </h2>

      <div
        class="relative w-full max-w-4xl mx-auto grid md:grid-cols-2 gap-5 mb-5"
        data-reveal
        data-reveal-delay="0.18"
      >
        {[
          {
            label: 'Quello che dice la navigazione',
            fonte: 'Adobe Analytics · trenitalia.com',
            mark: 'N',
            items: ['Cerca Milano–Napoli quasi ogni venerdì sera', 'Apre le offerte, non arriva mai al carrello', 'Sempre da telefono, pochi minuti per volta'],
          },
          {
            label: 'Quello che dice il CRM',
            fonte: 'Salesforce · Data Cloud',
            mark: 'C',
            items: ['CartaFreccia Oro da quattro anni', 'Abbonamento Milano–Roma sempre rinnovato', 'Nessun acquisto fuori dalla tratta di lavoro'],
          },
        ].map((col, ci) => (
          <div class="fs-card text-left">
            <div class="flex items-center gap-2.5 mb-1">
              <span class:list={["fs-mark !w-8 !h-8 !text-[0.85rem]", ci === 0 && "fs-node--rail"]} aria-hidden="true">{col.mark}</span>
              <p class="fs-card-title !text-[1.05rem]">{col.label}</p>
            </div>
            <p class="fs-panel-src mb-3 ml-[2.6rem]">{col.fonte}</p>
            <ul class="space-y-2">
              {col.items.map((item) => (
                <li class="flex items-start gap-2.5 fs-card-body">
                  <span class="flex-shrink-0 mt-2 w-1.5 h-1.5 rounded-full bg-[var(--accent-primary)]" aria-hidden="true"/>
                  {item}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>

      <p class="text-center fs-panel-src max-w-2xl mx-auto -mt-1 mb-4" data-reveal data-reveal-delay="0.24">
        Le due colonne parlano della stessa persona. Oggi nessun identificativo le attraversa.
      </p>

      <div
        class="fs-panel max-w-3xl mx-auto !bg-[rgba(var(--sig-rgb), 0.14)] !border-[rgba(var(--sig-rgb), 0.4)]"
        data-reveal
        data-reveal-delay="0.3"
      >
        <p class="fs-panel-tag mb-2">
          Quello che l'unione dei due rende possibile
        </p>
        <p class="fs-panel-head !text-[1.15rem] !leading-snug">
          «Davide cerca Napoli e non compra mai. Se il motivo è il prezzo, un'offerta sul venerdì
          sera lo verifica in due settimane.»
        </p>
        <p class="fs-panel-src mt-2.5">
          Scenario illustrativo. La prima fase costruisce e misura questa audience; portarla a
          Target è il passo dopo, e ha un costo suo.
        </p>
      </div>

      <div class="mt-6" data-reveal data-reveal-delay="0.4">
        <a
          href={href(base, next)}
          class="inline-flex items-center gap-3 px-8 py-2.5 text-base font-semibold tracking-wide bg-[var(--color-ardesia-notte)] text-[var(--color-chiaro)] hover:bg-[var(--color-ardesia)] transition-colors duration-300 font-[family-name:var(--font-display)]"
        >
          Dentro Trenitalia: cosa si vede oggi
          <svg width="18" height="18" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>
    </Slide>

  </DeckContainer>
</BaseLayout>
