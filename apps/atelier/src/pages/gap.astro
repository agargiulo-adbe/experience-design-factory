---
import BaseLayout from '../layouts/BaseLayout.astro';
import AtelierNavigation from '../components/AtelierNavigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import SlideBackdrop from '@edf/core/blocks/SlideBackdrop.astro';
import T from '@edf/core/blocks/i18n/T.astro';
import { href } from '@edf/core/utils/url.js';
import { mediaProps } from '../../assets.index';

const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;

// Four numbers, 2025–2026. Each one carries its source and its date on the slide:
// a figure without a source does not belong on a slide.
const buyerFigures = [
  {
    figure: '67%',
    body: {
      en: 'of B2B buyers prefer a rep-free experience; 70% prefer fully digital self-service.',
      it: "dei buyer B2B preferisce un'esperienza senza venditore; il 70% vuole un self-service interamente digitale.",
      fr: "des acheteurs B2B préfèrent une expérience sans commercial&nbsp;; 70&nbsp;% veulent un self-service entièrement numérique.",
    },
    src: {
      en: 'Gartner, 9 Mar 2026 (n=646)',
      it: 'Gartner, 9 mar 2026 (n=646)',
      fr: 'Gartner, 9 mars 2026 (n=646)',
    },
  },
  {
    figure: '60/40',
    body: {
      en: 'research versus engagement: buyers now spend 60% of the cycle without a vendor.',
      it: 'ricerca contro contatto: oggi il buyer passa il 60% del ciclo senza un fornitore accanto.',
      fr: "recherche contre contact&nbsp;: l'acheteur passe désormais 60&nbsp;% du cycle sans fournisseur.",
    },
    src: {
      en: '6sense, 12 Nov 2025 (4,000+ buyers)',
      it: '6sense, 12 nov 2025 (oltre 4.000 buyer)',
      fr: '6sense, 12 nov. 2025 (plus de 4 000 acheteurs)',
    },
  },
  {
    figure: '18%',
    body: {
      en: 'name “their demo blew us away” as a deciding factor, up from 13%; demos and trials outrank every other content.',
      it: 'indica «la loro demo ci ha spiazzati» fra i fattori decisivi, in crescita dal 13%; demo e trial battono ogni altro contenuto.',
      fr: 'citent «&nbsp;leur démo nous a bluffés&nbsp;» comme facteur décisif, contre 13&nbsp;% auparavant&nbsp;; démos et essais devancent tout autre contenu.',
    },
    src: {
      en: 'TrustRadius, 15 Jul 2026 (1,862 buyers)',
      it: 'TrustRadius, 15 lug 2026 (1.862 buyer)',
      fr: 'TrustRadius, 15 juil. 2026 (1 862 acheteurs)',
    },
  },
  {
    figure: '69%',
    body: {
      en: 'turn to a human to validate AI-generated insights.',
      it: 'si rivolge a una persona per validare quello che ha prodotto un modello.',
      fr: "se tournent vers un humain pour valider ce qu'un modèle a produit.",
    },
    src: {
      en: 'Gartner, 20 May 2026 (n=645)',
      it: 'Gartner, 20 mag 2026 (n=645)',
      fr: 'Gartner, 20 mai 2026 (n=645)',
    },
  },
];

// Where the category moved in 2026 — four moves, four sources.
const categoryMoves = [
  {
    claim: {
      en: 'Consensus acquires Peel and Saleo — “agentic product experience platform”',
      it: 'Consensus acquisisce Peel e Saleo e si dichiara «agentic product experience platform»',
      fr: 'Consensus rachète Peel et Saleo et se présente en «&nbsp;agentic product experience platform&nbsp;»',
    },
    src: { en: 'PR Newswire, 9 Jun 2026', it: 'PR Newswire, 9 giu 2026', fr: 'PR Newswire, 9 juin 2026' },
  },
  {
    claim: {
      en: 'Seismic and Highspot merge — 2,500 customers, 3.5M users',
      it: 'Seismic e Highspot si fondono: 2.500 clienti, 3,5 milioni di utenti',
      fr: 'Seismic et Highspot fusionnent&nbsp;: 2 500 clients, 3,5 millions d’utilisateurs',
    },
    src: { en: 'Seismic newsroom, 18 Aug 2026', it: 'Newsroom Seismic, 18 ago 2026', fr: 'Newsroom Seismic, 18 août 2026' },
  },
  {
    claim: {
      en: 'Aligned raises $60M to become an “AI Deal Workspace”',
      it: 'Aligned raccoglie 60M$ per diventare un «AI Deal Workspace»',
      fr: 'Aligned lève 60&nbsp;M$ pour devenir un «&nbsp;AI Deal Workspace&nbsp;»',
    },
    src: { en: 'GlobeNewswire, 1 Jul 2026', it: 'GlobeNewswire, 1 lug 2026', fr: 'GlobeNewswire, 1er juil. 2026' },
  },
  {
    claim: {
      en: 'Mutiny retires an eight-figure SaaS product and relaunches as an agent that generates deal rooms',
      it: 'Mutiny ritira un prodotto SaaS da otto cifre e riparte come agente che genera deal room',
      fr: 'Mutiny retire un produit SaaS à huit chiffres et repart en agent qui génère des deal rooms',
    },
    src: { en: 'Forbes, 15 Apr 2026', it: 'Forbes, 15 apr 2026', fr: 'Forbes, 15 avr. 2026' },
  },
];

// Adobe's own move — the ground this Factory is built on.
const adobeMoves = [
  {
    body: {
      en: 'Experience Cloud became CX Enterprise: Agent Orchestrator, Brand Intelligence, an Agent Skills Catalog and MCP endpoints.',
      it: 'Experience Cloud è diventata CX Enterprise: Agent Orchestrator, Brand Intelligence, un Agent Skills Catalog ed endpoint MCP.',
      fr: 'Experience Cloud est devenue CX Enterprise&nbsp;: Agent Orchestrator, Brand Intelligence, un Agent Skills Catalog et des endpoints MCP.',
    },
    src: { en: 'Adobe Summit, 20–22 Apr 2026', it: 'Adobe Summit, 20–22 apr 2026', fr: 'Adobe Summit, 20–22 avr. 2026' },
  },
  {
    body: {
      en: 'The Marketing Agent runs inside Microsoft 365 Copilot, Claude Enterprise, ChatGPT Enterprise and Gemini Enterprise.',
      it: 'Il Marketing Agent gira dentro Microsoft 365 Copilot, Claude Enterprise, ChatGPT Enterprise e Gemini Enterprise.',
      fr: 'Le Marketing Agent tourne dans Microsoft 365 Copilot, Claude Enterprise, ChatGPT Enterprise et Gemini Enterprise.',
    },
    src: { en: 'Adobe newsroom, 20 Apr 2026', it: 'Newsroom Adobe, 20 apr 2026', fr: 'Newsroom Adobe, 20 avr. 2026' },
  },
  {
    body: {
      en: 'Adobe ships first-party MCP servers (Target, Analytics, Real-Time CDP, AEM) and the “Adobe for creativity” connector in Claude — the one this Factory is built with.',
      it: 'Adobe rilascia server MCP di prima parte (Target, Analytics, Real-Time CDP, AEM) e il connettore «Adobe for creativity» dentro Claude: quello con cui è costruita questa Factory.',
      fr: 'Adobe publie des serveurs MCP first-party (Target, Analytics, Real-Time CDP, AEM) et le connecteur «&nbsp;Adobe for creativity&nbsp;» dans Claude&nbsp;: celui avec lequel cette Factory est bâtie.',
    },
    src: { en: 'Adobe blog, 28 Apr 2026', it: 'Blog Adobe, 28 apr 2026', fr: 'Blog Adobe, 28 avr. 2026' },
  },
];

// The precedents — who industrialised a pattern, and what happens to those who don't.
const precedents = [
  {
    org: 'Moderna',
    claim: {
      en: '3,000+ custom GPTs across ~5,000 employees',
      it: 'Oltre 3.000 GPT su misura per circa 5.000 dipendenti',
      fr: 'Plus de 3 000 GPT sur mesure pour environ 5 000 salariés',
    },
    src: {
      en: 'UNLEASH, 27 Jun 2025 (vendor-reported)',
      it: 'UNLEASH, 27 giu 2025 (dato del vendor)',
      fr: 'UNLEASH, 27 juin 2025 (chiffres de l’éditeur)',
    },
  },
  {
    org: 'JPMorgan',
    claim: {
      en: '230,000+ employees on the LLM Suite, now configuring their own assistants',
      it: 'Oltre 230.000 dipendenti sulla LLM Suite, e adesso si configurano i propri assistenti',
      fr: 'Plus de 230 000 salariés sur la LLM Suite, qui configurent désormais leurs propres assistants',
    },
    src: { en: 'The Digital Banker, 6 Mar 2026', it: 'The Digital Banker, 6 mar 2026', fr: 'The Digital Banker, 6 mars 2026' },
  },
  {
    org: 'Cisco',
    claim: {
      en: 'An agent for all 90,000 employees',
      it: 'Un agente per tutti i 90.000 dipendenti',
      fr: 'Un agent pour les 90 000 salariés',
    },
    src: { en: 'PYMNTS, 27 Aug 2026', it: 'PYMNTS, 27 ago 2026', fr: 'PYMNTS, 27 août 2026' },
  },
  {
    org: 'MIT',
    claim: {
      en: '95% of organisations report zero return on $30–40B of GenAI spend',
      it: 'Il 95% delle organizzazioni dichiara zero ritorno su 30–40 miliardi di dollari spesi in GenAI',
      fr: '95 % des organisations déclarent zéro retour sur 30–40 milliards de dollars dépensés en GenAI',
    },
    src: {
      en: 'MIT NANDA, Jul 2025 (not peer-reviewed)',
      it: 'MIT NANDA, lug 2025 (non sottoposto a peer review)',
      fr: 'MIT NANDA, juil. 2025 (sans relecture par les pairs)',
    },
  },
];
---
<BaseLayout
  title="The gap"
  description="The gap — what B2B buyers want in 2026, where the demo category converged, what Adobe shipped, and what the ones who got value did differently."
>
  <div class="fixed top-0 left-0 right-0 z-50">
    <AtelierNavigation currentPath={currentPath} base={base} />
  </div>

  <DeckContainer
    nextHref={href(base, '/moves')}
    prevHref={href(base, '/capability')}
  >

    <!-- ── SLIDE 0: Cover — the gap in the weave (detail cut) ────── -->
    <Slide id="slide-cover" bg="primary" align="center" data-solution="detail" data-made-with="Firefly" data-made-with-for="backdrop">
      <div slot="backdrop" class="loom-bg absolute inset-0" aria-hidden="true"></div>
      <SlideBackdrop
        slot="backdrop"
        {...mediaProps('bg-gap')}
        imageClass="opacity-[0.22]"
        scrim="bg-transparent"
      />

      <div class="atl-frame flex flex-col items-center">
        <p class="atl-cover-num mb-3" aria-hidden="true" data-display data-reveal>03</p>
        <T
          as="p"
          en="The gap"
          it="Il divario"
          fr="L'écart"
          class="atl-cover-kicker mb-5"
          data-reveal
        />
        <T
          as="h1"
          en="What buyers want now."
          it="Cosa vogliono i buyer, adesso."
          fr="Ce que veulent les acheteurs, aujourd'hui."
          class="slide-title text-center text-[var(--ink-primary)] mx-auto max-w-5xl mb-8"
          style="font-size: clamp(2.2rem, 4.4vw, 4rem);"
          data-reveal
          data-reveal-delay="0.12"
        />
        <T
          as="p"
          en="Four numbers from 2025 and 2026, and where the category, and Adobe, moved because of them."
          it="Quattro numeri fra il 2025 e il 2026, e dove si sono spostati la categoria e Adobe per via di quei numeri."
          fr="Quatre chiffres de 2025 et 2026, et les déplacements qu'ils ont provoqués chez les éditeurs comme chez Adobe."
          class="atl-lede"
          data-reveal
          data-reveal-delay="0.2"
        />
        <div class="flex items-center justify-center flex-wrap gap-x-4 gap-y-2 mt-6" data-reveal data-reveal-delay="0.28">
          <T en="The buyers" it="I buyer" fr="Les acheteurs" class="font-semibold tracking-widest uppercase text-[var(--color-sabbia-300)]" style="font-size: 0.9rem;" />
          <span class="w-1 h-1 rounded-full bg-[var(--accent-primary)]" aria-hidden="true"></span>
          <T en="The category" it="La categoria" fr="La catégorie" class="font-semibold tracking-widest uppercase text-[var(--color-sabbia-300)]" style="font-size: 0.9rem;" />
          <span class="w-1 h-1 rounded-full bg-[var(--accent-primary)]" aria-hidden="true"></span>
          <T en="Adobe" it="Adobe" fr="Adobe" class="font-semibold tracking-widest uppercase text-[var(--color-sabbia-300)]" style="font-size: 0.9rem;" />
        </div>
      </div>
    </Slide>

    <!-- ── SLIDE 1: The buyers, in four numbers ──────────────────── -->
    <Slide id="slide-buyers" bg="secondary" align="left">
      <div slot="backdrop" class="loom-bg-soft absolute inset-0" aria-hidden="true"></div>

      <div class="atl-frame">
        <T
          as="h2"
          en="The buyers, in four numbers"
          it="I buyer, in quattro numeri"
          fr="Les acheteurs, en quatre chiffres"
          class="slide-title text-[var(--ink-primary)] mb-6"
          style="font-size: clamp(1.7rem, 2.6vw, 2.4rem);"
          data-reveal
        />

        <div class="grid md:grid-cols-2 auto-rows-fr gap-4" data-reveal data-reveal-delay="0.1">
          {buyerFigures.map((f) => (
            <div class="loom-panel gap-panel h-full">
              <span class="gap-figure" data-display>{f.figure}</span>
              <T as="p" en={f.body.en} it={f.body.it} fr={f.body.fr} class="loom-panel-body" />
              <T as="p" en={f.src.en} it={f.src.it} fr={f.src.fr} class="gap-src mt-auto" />
            </div>
          ))}
        </div>

        <T
          as="p"
          en="They want to move without us, and they trust what a person can vouch for."
          it="Vogliono muoversi senza di noi, e si fidano di quello che una persona può garantire."
          fr="Ils veulent avancer sans nous, et ils font confiance à ce qu'une personne peut garantir."
          class="gap-close"
          data-reveal
          data-reveal-delay="0.2"
        />
      </div>
    </Slide>

    <!-- ── SLIDE 2: Where the category moved (detail cut) ─────────── -->
    <Slide id="slide-market" bg="primary" align="left" data-solution="detail">
      <div slot="backdrop" class="loom-bg absolute inset-0" aria-hidden="true"></div>

      <div class="atl-frame">
        <T
          as="h2"
          en="The category converged on the deal workspace"
          it="La categoria è confluita sul deal workspace"
          fr="La catégorie a convergé vers le deal workspace"
          class="slide-title text-[var(--ink-primary)] mb-6"
          style="font-size: clamp(1.7rem, 2.6vw, 2.4rem);"
          data-reveal
        />

        <div class="loom-weave" data-reveal data-reveal-delay="0.1">
          {categoryMoves.map((row, i) => (
            <div class="loom-thread gap-row" style={`--thread:${i}`}>
              <div class="loom-thread-rail" aria-hidden="true">
                <span class="loom-thread-num">{i + 1}</span>
              </div>
              <div class="loom-thread-copy">
                <T as="p" en={row.claim.en} it={row.claim.it} fr={row.claim.fr} class="loom-thread-title" />
                <T as="p" en={row.src.en} it={row.src.it} fr={row.src.fr} class="gap-src" />
              </div>
            </div>
          ))}
        </div>

        <div class="loom-quote" data-reveal data-reveal-delay="0.22">
          <T
            as="p"
            en="All of them ship engagement analytics and an AI rep. None of them ships a bespoke, brand-exact experience."
            it="Tutti rilasciano analytics di engagement e un venditore AI. Nessuno rilascia un'esperienza su misura, esatta nel brand del cliente."
            fr="Tous livrent des analytics d'engagement et un commercial IA. Aucun ne livre une expérience sur mesure, fidèle à la marque du client jusqu'au détail."
            class="loom-quote-text"
          />
        </div>
      </div>
    </Slide>

    <!-- ── SLIDE 3: Adobe's own move ─────────────────────────────── -->
    <Slide id="slide-adobe" bg="secondary" align="left">
      <div slot="backdrop" class="loom-bg-soft absolute inset-0" aria-hidden="true"></div>

      <div class="atl-frame">
        <T
          as="p"
          en="Adobe's own move"
          it="La mossa di Adobe"
          fr="Le mouvement d'Adobe"
          class="slide-eyebrow text-[var(--accent-primary)] mb-3"
          data-reveal
        />
        <T
          as="h2"
          en="CX Enterprise: agents, skills and MCP endpoints"
          it="CX Enterprise: agenti, skill ed endpoint MCP"
          fr="CX Enterprise : agents, skills et endpoints MCP"
          class="slide-title text-[var(--ink-primary)] mb-6"
          style="font-size: clamp(1.65rem, 2.5vw, 2.3rem);"
          data-reveal
          data-reveal-delay="0.08"
        />

        <div class="grid grid-cols-1 md:grid-cols-3 auto-rows-fr gap-4" data-reveal data-reveal-delay="0.16">
          {adobeMoves.map((card, i) => (
            <div class="loom-card gap-card h-full">
              <span class="loom-mark" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <T as="p" en={card.body.en} it={card.body.it} fr={card.body.fr} class="loom-card-body" />
              <T as="p" en={card.src.en} it={card.src.it} fr={card.src.fr} class="gap-src mt-auto" />
            </div>
          ))}
        </div>

        <T
          as="p"
          en="We build in Adobe's grain. This deck is the proof."
          it="Costruiamo nella fibra di Adobe. Questo deck ne è la prova."
          fr="Nous construisons dans le fil d'Adobe. Ce deck en est la preuve."
          class="gap-close"
          data-reveal
          data-reveal-delay="0.24"
        />
      </div>
    </Slide>

    <!-- ── SLIDE 4: The precedents (detail cut) ───────────────────── -->
    <Slide id="slide-precedent" bg="primary" align="left" data-solution="detail">
      <div slot="backdrop" class="loom-bg absolute inset-0" aria-hidden="true"></div>

      <div class="atl-frame">
        <T
          as="h2"
          en="The ones who got value industrialised a pattern"
          it="Chi ha ottenuto valore ha industrializzato uno schema"
          fr="Ceux qui en ont tiré de la valeur ont industrialisé un schéma"
          class="slide-title text-[var(--ink-primary)] mb-6"
          style="font-size: clamp(1.7rem, 2.6vw, 2.4rem);"
          data-reveal
        />

        <div class="grid md:grid-cols-2 auto-rows-fr gap-4" data-reveal data-reveal-delay="0.12">
          {precedents.map((p) => (
            <div class="loom-card gap-card h-full">
              <p class="loom-tag mb-2">{p.org}</p>
              <T as="p" en={p.claim.en} it={p.claim.it} fr={p.claim.fr} class="loom-card-title" />
              <T as="p" en={p.src.en} it={p.src.it} fr={p.src.fr} class="gap-src mt-auto" />
            </div>
          ))}
        </div>

        <div class="loom-quote" data-reveal data-reveal-delay="0.24">
          <T
            as="p"
            en="A pilot is not a programme. The asset is the pattern, not the eight decks."
            it="Un pilota non è un programma. L'asset è lo schema, non gli otto deck."
            fr="Un pilote n'est pas un programme. L'actif, c'est le schéma, pas les huit decks."
            class="loom-quote-text"
          />
        </div>
      </div>
    </Slide>

  </DeckContainer>
</BaseLayout>
