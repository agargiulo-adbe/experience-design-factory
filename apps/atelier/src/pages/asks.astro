---
import BaseLayout from '../layouts/BaseLayout.astro';
import AtelierNavigation from '../components/AtelierNavigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import T from '@edf/core/blocks/i18n/T.astro';
import { href } from '@edf/core/utils/url.js';

const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;

// Proportions only. Figures live in a private annex (Annex A), never on a slide.
const resources = [
  {
    mark: '01',
    width: '100%',
    name: {
      en: 'Enterprise AI licences, tiered',
      it: 'Licenze AI enterprise, a livelli',
      fr: 'Licences IA enterprise, par paliers',
    },
    why: {
      en: 'Top tier for the core builders, mid tier for power creators, standard for pilot users. Billing follows actual usage, so the caps are ceilings rather than spend.',
      it: 'Livello alto per chi costruisce il nucleo, intermedio per i power creator, standard per gli utenti pilota. La fatturazione segue l’uso reale, quindi i tetti sono limiti, non spesa.',
      fr: 'Palier haut pour l’équipe centrale, intermédiaire pour les power creators, standard pour les utilisateurs pilotes. Facturation à l’usage réel&nbsp;; les plafonds sont des limites.',
    },
  },
  {
    mark: '02',
    width: '55%',
    name: {
      en: 'Sponsored time',
      it: 'Tempo dedicato',
      fr: 'Temps alloué',
    },
    why: {
      en: 'An official allocation for the project lead, Solution Consultant hours for the Context Layer, one professional design review.',
      it: 'Un’allocazione ufficiale per il project lead, ore di Solution Consultant per il Context Layer, una design review professionale.',
      fr: 'Une allocation officielle pour le responsable du projet, des heures de Solution Consultant pour le Context Layer, une revue de design professionnelle.',
    },
  },
  {
    mark: '03',
    width: '35%',
    name: {
      en: 'Events',
      it: 'Eventi',
      fr: 'Événements',
    },
    why: {
      en: 'A hackathon day in February 2027; a demo stand and a speaking submission at Adobe Summit, Las Vegas, 22–25 March 2027.',
      it: 'Una giornata di hackathon a febbraio 2027; uno stand demo e una proposta di intervento all’Adobe Summit di Las Vegas, 22–25 marzo 2027.',
      fr: 'Une journée de hackathon en février 2027&nbsp;; un stand de démo et une proposition d’intervention à l’Adobe Summit de Las Vegas, du 22 au 25 mars 2027.',
    },
  },
  {
    mark: '04',
    width: '15%',
    name: {
      en: 'Infrastructure and tooling',
      it: 'Infrastruttura e strumenti',
      fr: 'Infrastructure et outillage',
    },
    why: {
      en: 'Hosting, database, asset licensing, CI. The smallest line: the platform already runs on it.',
      it: 'Hosting, database, licenze degli asset, CI. La voce più piccola: la piattaforma ci gira già sopra.',
      fr: 'Hébergement, base de données, licences d’assets, CI. La plus petite ligne&nbsp;: la plateforme tourne déjà dessus.',
    },
  },
];

// The decision, in three concrete items. No figures: the M1 envelope is sized in Annex A.
const decisions = [
  {
    mark: '1',
    name: { en: 'Yes to the pilot', it: 'Sì al pilota', fr: 'Oui au projet pilote' },
    body: {
      en: 'Five to ten sellers, a guided intake, twelve weeks: M1 Foundations by mid-December 2026.',
      it: 'Da cinque a dieci venditori, un brief guidato, dodici settimane: M1 Fondamenta entro metà dicembre 2026.',
      fr: 'Cinq à dix commerciaux, un brief guidé, douze semaines&nbsp;: M1 Fondations d’ici la mi-décembre 2026.',
    },
  },
  {
    mark: '2',
    name: { en: 'A sponsor at leadership level', it: 'Uno sponsor nella leadership', fr: 'Un sponsor au comité de direction' },
    body: {
      en: 'Thirty minutes a month to review the scorecard, and the authority to open the pilot cohort and the partner access.',
      it: 'Trenta minuti al mese per rivedere la scorecard, e l’autorità per aprire la coorte pilota e l’accesso ai partner.',
      fr: 'Trente minutes par mois pour passer en revue le tableau de bord, et l’autorité pour ouvrir la cohorte pilote et l’accès partenaires.',
    },
  },
  {
    mark: '3',
    name: { en: 'The M1 envelope', it: 'La dotazione M1', fr: 'L’enveloppe M1' },
    body: {
      en: 'As sized in Annex A, for the twelve weeks of Foundations.',
      it: 'Come dimensionata nell’Allegato A, per le dodici settimane di Fondamenta.',
      fr: 'Telle que dimensionnée dans l’annexe A, pour les douze semaines de Fondations.',
    },
  },
];
---
<BaseLayout
  title="What it takes"
  description="What it takes — resources sized to the milestones they serve, shown as proportions, and the three-item decision we ask for by 30 September 2026."
  pageSolutions={['asks']}
>
  <div class="fixed top-0 left-0 right-0 z-50">
    <AtelierNavigation currentPath={currentPath} base={base} />
  </div>

  <DeckContainer
    nextHref={href(base, '/closing')}
    prevHref={href(base, '/plan')}
  >

    <!-- ── SLIDE 0: Cover (detail cut) ────────────────────────────── -->
    <Slide id="slide-cover" bg="primary" align="center" data-solution="detail">
      <div slot="backdrop" class="loom-bg"></div>
      <p class="atl-cover-num mb-5" data-reveal data-display aria-hidden="true">06</p>
      <T
        as="p"
        en="What it takes"
        it="Cosa serve"
        fr="Ce qu’il faut"
        class="atl-cover-kicker mb-5"
        data-reveal
        data-reveal-delay="0.08"
      />
      <T
        as="h1"
        en="A small stack of asks, in the right order."
        it="Poche richieste, messe nell’ordine giusto."
        fr="Une courte liste de demandes, dans le bon ordre."
        class="slide-title text-center text-[var(--ink-primary)] mx-auto max-w-5xl mb-5"
        style="font-size: clamp(2.2rem, 4vw, 3.9rem);"
        data-reveal
        data-reveal-delay="0.15"
      />
      <T
        as="p"
        en="Everything below is sized to the milestones it serves. Almost all of this pays for people’s time and licences, not for tooling."
        it="Tutto quel che segue è dimensionato sulle milestone che serve. Quasi tutto paga il tempo delle persone e le licenze, non gli strumenti."
        fr="Tout ce qui suit est dimensionné sur les jalons qu’il sert. Presque tout finance le temps des personnes et les licences, pas l’outillage."
        class="atl-lede"
        data-reveal
        data-reveal-delay="0.22"
      />
    </Slide>

    <!-- ── SLIDE 1: Resources (proportions only) ──────────────────── -->
    <Slide id="slide-resources" bg="secondary" align="left">
      <div slot="backdrop" class="loom-bg-soft"></div>
      <div class="atl-frame">
        <T
          as="p"
          en="The envelope"
          it="La dotazione"
          fr="L’enveloppe"
          class="slide-eyebrow text-[var(--accent-primary)] mb-1"
          data-reveal
        />
        <div class="asks-res-headrow" data-reveal data-reveal-delay="0.08">
          <T
            as="h2"
            en="Resources"
            it="Risorse"
            fr="Ressources"
            class="text-[var(--ink-primary)] font-[family-name:var(--font-display)]"
            style="font-size: clamp(1.7rem, 2.6vw, 2.4rem); font-weight: 600; line-height: 1.08; letter-spacing: -0.02em;"
          />
          <T
            as="p"
            en="Relative envelope, one bar per line"
            it="Dotazione relativa, una barra per voce"
            fr="Enveloppe relative, une barre par ligne"
            class="atl-label asks-res-legend"
          />
        </div>

        <div class="w-full grid lg:grid-cols-2 gap-2.5 lg:gap-3" data-reveal data-reveal-delay="0.16">
          {resources.map((row) => (
            <div class="loom-card asks-res-card">
              <div class="asks-res-head">
                <span class="loom-mark asks-res-mark" aria-hidden="true">{row.mark}</span>
                <T
                  as="p"
                  en={row.name.en}
                  it={row.name.it}
                  fr={row.name.fr}
                  class="loom-card-title asks-res-title"
                />
                <div class="asks-res-track" aria-hidden="true">
                  <div class="asks-res-fill" style={`width: ${row.width};`}></div>
                </div>
              </div>
              <T
                as="p"
                en={row.why.en}
                it={row.why.it}
                fr={row.why.fr}
                class="loom-card-body asks-res-body"
              />
            </div>
          ))}
        </div>

        <T
          as="p"
          en="Figures live in a private annex (Annex A), available on request from the project lead; this page carries proportions only."
          it="Le cifre stanno in un allegato riservato (Allegato A), disponibile su richiesta al project lead; questa pagina mostra solo le proporzioni."
          fr="Les chiffres figurent dans une annexe confidentielle (annexe A), disponible sur demande auprès du responsable du projet&nbsp;; cette page ne montre que les proportions."
          class="asks-annex"
          data-reveal
          data-reveal-delay="0.24"
        />
      </div>
    </Slide>

    <!-- ── SLIDE 2: What we ask you to decide ─────────────────────── -->
    <Slide id="slide-sponsor" bg="primary" align="left">
      <div slot="backdrop" class="loom-bg"></div>
      <div class="atl-frame">
        <T
          as="p"
          en="The decision"
          it="La decisione"
          fr="La décision"
          class="slide-eyebrow text-[var(--accent-primary)] mb-1"
          data-reveal
        />
        <T
          as="h2"
          en="What we ask you to decide"
          it="Cosa vi chiediamo di decidere"
          fr="Ce que nous vous demandons de décider"
          class="text-[var(--ink-primary)] mb-4 lg:mb-5 font-[family-name:var(--font-display)]"
          style="font-size: clamp(1.7rem, 2.6vw, 2.4rem); font-weight: 600; line-height: 1.08; letter-spacing: -0.02em;"
          data-reveal
          data-reveal-delay="0.08"
        />

        <div class="w-full grid md:grid-cols-3 gap-3 lg:gap-4" data-reveal data-reveal-delay="0.16">
          {decisions.map((d) => (
            <div class="loom-card asks-dec-card">
              <span class="loom-mark" aria-hidden="true">{d.mark}</span>
              <T
                as="p"
                en={d.name.en}
                it={d.name.it}
                fr={d.name.fr}
                class="loom-card-title"
              />
              <T
                as="p"
                en={d.body.en}
                it={d.body.it}
                fr={d.body.fr}
                class="loom-card-body asks-dec-body"
              />
            </div>
          ))}
        </div>

        <div class="asks-decide" data-reveal data-reveal-delay="0.24">
          <span class="asks-decide-rule" aria-hidden="true"></span>
          <T
            as="p"
            en="Decision requested by 30 September 2026."
            it="Decisione richiesta entro il 30 settembre 2026."
            fr="Décision demandée d’ici le 30 septembre 2026."
            class="asks-decide-text"
          />
        </div>
      </div>
    </Slide>

  </DeckContainer>

  <style>
    /* ── Asks — resources: four loom-cards, the bar rides in the head row so the
         card stays short enough for 2×2 at 1280×800 (usable height 464px). ── */
    .asks-res-headrow {
      display: flex; align-items: baseline; justify-content: space-between; gap: 1.5rem;
      margin-bottom: 0.75rem;
    }
    .asks-res-legend { flex: 0 0 auto; max-width: none; white-space: nowrap; }
    .asks-res-card { padding: 0.9rem 1.25rem 0.9rem; }
    .asks-res-head {
      display: flex; align-items: center; gap: 0.8rem; flex-wrap: nowrap;
      margin-bottom: 0.55rem;
    }
    .asks-res-mark { margin-bottom: 0; }
    .asks-res-title { margin-bottom: 0; font-size: 1.1rem; flex: 1 1 auto; min-width: 0; }
    .asks-res-body { font-size: 0.95rem; margin-bottom: 0; }
    /* The track may shrink (long FR titles) but never drops onto its own row. */
    .asks-res-track {
      flex: 0 1 9rem; min-width: 6rem; height: 6px; border-radius: 999px; overflow: hidden;
      background: rgba(201, 169, 106, 0.14);
    }
    .asks-res-fill {
      height: 100%; border-radius: 999px;
      background: var(--color-champagne);
    }
    .asks-annex {
      margin-top: 0.7rem; padding-top: 0.55rem;
      border-top: 1px solid var(--line-subtle);
      font-size: 0.9rem; line-height: 1.5; letter-spacing: 0.01em;
      color: var(--color-sabbia-300); max-width: none;
    }
    /* Short projection viewports (1280×800 keeps the full 168px chrome reserve →
       464px usable; 1366×768 / 1280×720 → ~460–507px): tighten SPACING only,
       never type. FR/IT run one line longer than EN in two cards + the annex. */
    @media (max-height: 820px) and (min-width: 641px) {
      .asks-res-headrow { margin-bottom: 0.5rem; }
      .asks-res-card { padding: 0.7rem 1.1rem 0.7rem; }
      .asks-res-head { margin-bottom: 0.4rem; }
      .asks-res-mark { width: 1.7rem; height: 1.7rem; font-size: 0.85rem; }
      .asks-res-body { line-height: 1.5; }
      .asks-res-track { flex: 0 0 6rem; min-width: 0; } /* fixed, shorter track keeps the long FR title of card 01 on one line */
      .asks-annex { margin-top: 0.45rem; padding-top: 0.4rem; }
    }
    @media (max-width: 640px) {
      .asks-res-headrow { flex-direction: column; align-items: flex-start; gap: 0.35rem; }
      .asks-res-legend { white-space: normal; }
      .asks-res-head { flex-wrap: wrap; }
      .asks-res-track { flex: 1 1 100%; }
    }

    /* ── Asks — the decision: three cards + one dated line ─────────── */
    .asks-dec-card { padding: 1.25rem 1.35rem 1.15rem; }
    .asks-dec-body { margin-bottom: 0; }
    .asks-decide {
      display: flex; align-items: center; gap: 1rem;
      margin-top: 1.25rem;
    }
    .asks-decide-rule {
      flex: 0 0 3rem; height: 2px; border-radius: 2px;
      background: var(--color-champagne);
    }
    .asks-decide-text {
      font-family: var(--font-display); font-weight: 500;
      font-size: clamp(1.2rem, 1.6vw, 1.5rem); line-height: 1.3;
      color: var(--color-champagne); max-width: none;
    }
  </style>
</BaseLayout>
