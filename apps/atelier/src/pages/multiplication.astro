---
/**
 * Redirect stub — «The multiplication» è stata riscritta come capitolo 03 «The gap»
 * (2026-09-14, redesign «tre mosse»). La rotta resta viva perché i link condivisi e i
 * segnalibri dei mesi scorsi puntano ancora qui: chi arriva finisce su /gap/, chi ha
 * JavaScript spento vede un link e ci arriva con un clic. Nessun DeckContainer: questa
 * pagina non è una sezione del deck e non deve entrare nel conteggio delle slide.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { href } from '@edf/core/utils/url.js';

const base = import.meta.env.BASE_URL;
const target = href(base, '/gap');
---
<BaseLayout title="The gap" description="Moved to The gap — chapter 03 of the Experience Atelier.">
  <main class="min-h-[100dvh] flex flex-col items-center justify-center gap-4 text-center px-6">
    <p class="atl-label">Experience Atelier</p>
    <a href={target} class="slide-title text-[var(--accent-primary)] underline underline-offset-4" style="font-size: clamp(1.4rem, 2.4vw, 2rem);">
      Moved to The gap
    </a>
  </main>
  <script is:inline define:vars={{ target }}>
    location.replace(target);
  </script>
</BaseLayout>
