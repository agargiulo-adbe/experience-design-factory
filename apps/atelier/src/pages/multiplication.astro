---
import BaseLayout from '../layouts/BaseLayout.astro';
import AtelierNavigation from '../components/AtelierNavigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import SlideBackdrop from '@edf/core/blocks/SlideBackdrop.astro';
import T from '@edf/core/blocks/i18n/T.astro';
import { href } from '@edf/core/utils/url.js';
import { mediaProps } from '../../assets.index';

const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;

// The model — three threads, each widening the weave from one toward fifty.
const modelThreads = [
  {
    n: '1',
    title: { en: 'Guided intake', it: 'Brief guidato', fr: 'Brief guidé' },
    body: {
      en: "A shareable brief skill interviews the seller and produces a structured brief the engine can build from. It exists today.",
      it: "Un brief guidato condivisibile intervista il venditore e produce un brief strutturato da cui il motore costruisce. Esiste già.",
      fr: "Un questionnaire de brief partageable interroge le vendeur et produit un brief structuré dont le moteur peut partir. Il existe déjà.",
    },
  },
  {
    n: '2',
    title: { en: 'Templates and self-service', it: 'Template e self-service', fr: 'Modèles et self-service' },
    body: {
      en: "A template gallery and a guided wizard let a BDR or AE assemble an experience without touching code.",
      it: "Galleria di template e procedura guidata: un BDR o un AE monta un'esperienza senza toccare codice.",
      fr: "Galerie de modèles et assistant guidé : un BDR ou un AE assemble une expérience sans toucher au code.",
    },
  },
  {
    n: '3',
    title: { en: 'Partners', it: 'Partner', fr: 'Partenaires' },
    body: {
      en: "Adobe partners co-build joint experience designs with their own brand next to ours, on the same engine.",
      it: "I partner Adobe co-firmano experience design congiunti, il loro brand accanto al nostro, sullo stesso motore.",
      fr: "Les partenaires Adobe co-signent des expériences conjointes, leur marque à côté de la nôtre, sur le même moteur.",
    },
  },
];
---
<BaseLayout
  title="The multiplication"
  description="The multiplication — from one person's craft to a shared capability: market evidence, precedents, and the model that turns one into fifty."
>
  <div class="fixed top-0 left-0 right-0 z-50">
    <AtelierNavigation currentPath={currentPath} base={base} />
  </div>

  <DeckContainer
    nextHref={href(base, '/frontiers')}
    prevHref={href(base, '/capability')}
  >

    <!-- ── SLIDE 0: Cover — one thread, fifty (detail cut) ───────── -->
    <Slide id="slide-cover" bg="primary" align="center" data-solution="detail">
      <div slot="backdrop" class="loom-bg absolute inset-0" aria-hidden="true"></div>
      <SlideBackdrop
        slot="backdrop"
        {...mediaProps('bg-loom')}
        imageClass="opacity-12"
        scrim="bg-transparent"
      />

      <div class="atl-frame flex flex-col items-center">
        <p class="atl-cover-num mb-3" aria-hidden="true" data-display data-reveal>03</p>
        <T
          as="p"
          en="The multiplication"
          it="La moltiplicazione"
          fr="La multiplication"
          class="atl-cover-kicker mb-5"
          data-reveal
        />
        <T
          as="h1"
          en="What if fifty people could do this?"
          it="E se cinquanta persone potessero farlo?"
          fr="Et si cinquante personnes pouvaient le faire&nbsp;?"
          class="slide-title text-center text-[var(--ink-primary)] mx-auto max-w-5xl mb-8"
          style="font-size: clamp(2.2rem, 4.4vw, 4rem);"
          data-reveal
          data-reveal-delay="0.12"
        />

        <!-- the loom fan: one thread on the left, fifty on the right -->
        <div class="loom-fan w-full max-w-3xl mb-8" data-reveal data-reveal-delay="0.24" aria-hidden="true">
          <span class="loom-fan-cap loom-fan-cap--one">1</span>
          <svg class="loom-fan-svg" viewBox="0 0 560 132" preserveAspectRatio="none" fill="none">
            <g stroke="var(--color-champagne)" stroke-width="1">
              <line x1="16" y1="66" x2="544" y2="10"/>
              <line x1="16" y1="66" x2="544" y2="30"/>
              <line x1="16" y1="66" x2="544" y2="50"/>
              <line x1="16" y1="66" x2="544" y2="66"/>
              <line x1="16" y1="66" x2="544" y2="82"/>
              <line x1="16" y1="66" x2="544" y2="102"/>
              <line x1="16" y1="66" x2="544" y2="122"/>
            </g>
            <circle cx="16" cy="66" r="5" fill="var(--color-champagne)"/>
          </svg>
          <span class="loom-fan-cap loom-fan-cap--many">50</span>
        </div>

        <T
          as="p"
          en="Today this is one person's craft. The next nine months turn it into a shared capability."
          it="Oggi è il mestiere di una persona. Nei prossimi nove mesi diventa una capacità condivisa."
          fr="Aujourd'hui, c'est le métier d'une personne. Les neuf prochains mois en font une capacité partagée."
          class="atl-lede"
          data-reveal
          data-reveal-delay="0.32"
        />
        <div class="flex items-center justify-center flex-wrap gap-x-4 gap-y-2 mt-6" data-reveal data-reveal-delay="0.4">
          <T en="The market" it="Il mercato" fr="Le marché" class="font-semibold tracking-widest uppercase text-[var(--color-sabbia-300)]" style="font-size: 0.9rem;" />
          <span class="w-1 h-1 rounded-full bg-[var(--accent-primary)]" aria-hidden="true"></span>
          <T en="The precedents" it="I precedenti" fr="Les précédents" class="font-semibold tracking-widest uppercase text-[var(--color-sabbia-300)]" style="font-size: 0.9rem;" />
          <span class="w-1 h-1 rounded-full bg-[var(--accent-primary)]" aria-hidden="true"></span>
          <T en="The model" it="Il modello" fr="Le modèle" class="font-semibold tracking-widest uppercase text-[var(--color-sabbia-300)]" style="font-size: 0.9rem;" />
        </div>
      </div>
    </Slide>

    <!-- ── SLIDE 1: Market evidence (detail cut) ─────────────────── -->
    <Slide id="slide-market" bg="secondary" align="left" data-solution="detail">
      <div slot="backdrop" class="loom-bg-soft absolute inset-0" aria-hidden="true"></div>

      <div class="atl-frame">
        <T
          as="h2"
          en="Buyers already pay for experience-led selling"
          it="C'è già chi paga per l'experience-led selling"
          fr="La vente par l'expérience a déjà ses acheteurs"
          class="slide-title text-[var(--ink-primary)] mb-6"
          style="font-size: clamp(1.7rem, 2.6vw, 2.4rem);"
          data-reveal
        />

        <div class="grid md:grid-cols-2 gap-5" data-reveal data-reveal-delay="0.1">
          <div class="loom-panel">
            <div class="loom-panel-head mult-head">
              <T as="span" en="The category" it="La categoria" fr="La catégorie" class="loom-tag mult-tag" />
              <span class="mult-figure-block">
                <span class="loom-figure">$110M</span>
                <T
                  as="span"
                  en="Sumeru round, Business Wire, Mar 2023"
                  it="Round Sumeru, Business Wire, mar 2023"
                  fr="Tour Sumeru, Business Wire, mars 2023"
                  class="mult-figure-src"
                />
              </span>
            </div>
            <T
              as="p"
              en="Demo-experience platforms are a funded product category: Consensus raised $110M from Sumeru Equity Partners in 2023 and consolidated the space in 2026 by acquiring Peel and Saleo."
              it="Le piattaforme di demo experience sono una categoria finanziata: nel 2023 Consensus ha raccolto 110M$ da Sumeru Equity Partners e nel 2026 ha consolidato il settore acquisendo Peel e Saleo."
              fr="Les plateformes de démo sont un marché déjà financé&nbsp;: Consensus a levé 110&nbsp;M$ auprès de Sumeru Equity Partners en 2023, puis consolidé le secteur en 2026 en rachetant Peel et Saleo."
              class="loom-panel-body"
            />
            <T
              as="p"
              en="Business Wire, Mar 2023 · PR Newswire, Apr–Jun 2026"
              it="Business Wire, mar 2023 · PR Newswire, apr–giu 2026"
              fr="Business Wire, mars 2023 · PR Newswire, avr.–juin 2026"
              class="mult-src mt-auto"
            />
          </div>

          <div class="loom-panel">
            <div class="loom-panel-head mult-head">
              <T as="span" en="Claimed impact" it="Impatto dichiarato" fr="Impact déclaré" class="loom-tag mult-tag" />
              <span class="mult-figure-block">
                <span class="loom-figure">+60%</span>
                <T
                  as="span"
                  en="Forrester TEI commissioned by Reprise, Feb 2022"
                  it="Forrester TEI commissionato da Reprise, feb 2022"
                  fr="TEI Forrester commandé par Reprise, févr. 2022"
                  class="mult-figure-src"
                />
              </span>
            </div>
            <T
              as="p"
              en="The category sells on speed: Consensus itself reports sales cycles shortened by 29–68%; a Reprise-commissioned Forrester study reports a 60% lift in pipeline conversion."
              it="La categoria vende velocità: Consensus dichiara cicli di vendita ridotti del 29–68%; uno studio Forrester commissionato da Reprise riporta +60% di conversione in pipeline."
              fr="La catégorie se vend sur la vitesse&nbsp;: Consensus annonce des cycles de vente réduits de 29–68&nbsp;%&nbsp;; une étude Forrester commandée par Reprise rapporte +60&nbsp;% de conversion du pipeline."
              class="loom-panel-body"
            />
            <T
              as="p"
              en="Vendor-reported figures: Consensus releases 2023–2026; Forrester TEI for Reprise, Feb 2022"
              it="Dati dichiarati dai vendor: comunicati Consensus 2023–2026; Forrester TEI per Reprise, feb 2022"
              fr="Chiffres déclarés par les éditeurs&nbsp;: communiqués Consensus 2023–2026&nbsp;; TEI Forrester pour Reprise, févr. 2022"
              class="mult-src mt-auto"
            />
          </div>
        </div>

        <T
          as="p"
          en="Sales teams already pay for demo tools. The Atelier covers a neighbouring need in-house."
          it="I team di vendita pagano già strumenti per le demo. L'Atelier copre un bisogno vicino, fatto in casa."
          fr="Les équipes commerciales paient déjà des outils de démo. L'Atelier couvre un besoin voisin, en interne."
          class="mult-close"
          data-reveal
          data-reveal-delay="0.2"
        />
      </div>
    </Slide>

    <!-- ── SLIDE 2: Precedents (detail cut) ──────────────────────── -->
    <Slide id="slide-precedent" bg="primary" align="left" data-solution="detail">
      <div slot="backdrop" class="loom-bg absolute inset-0" aria-hidden="true"></div>

      <div class="atl-frame">
        <T
          as="h2"
          en="The playbook has precedents"
          it="Il playbook ha dei precedenti"
          fr="Le modèle a des précédents"
          class="slide-title text-[var(--ink-primary)] mb-3"
          style="font-size: clamp(1.7rem, 2.7vw, 2.5rem);"
          data-reveal
        />
        <T
          as="p"
          en="SAP and Moderna each show one half of the model: games in pre-sales, employees building their own AI."
          it="SAP e Moderna mostrano una metà ciascuna del modello: il gioco nel pre-vendita, i dipendenti che si costruiscono l'AI."
          fr="SAP et Moderna illustrent chacun une moitié du modèle&nbsp;: le jeu en avant-vente, les employés qui construisent leur propre IA."
          class="text-[var(--color-sabbia-200)] mb-6"
          style="font-size: clamp(1rem, 1.2vw, 1.15rem); line-height: 1.55; max-width: none;"
          data-reveal
          data-reveal-delay="0.08"
        />

        <div class="grid md:grid-cols-2 gap-5" data-reveal data-reveal-delay="0.16">
          <div class="loom-card">
            <span class="loom-mark" aria-hidden="true">01</span>
            <T
              as="p"
              en="SAP institutionalized pre-sales play"
              it="SAP: il gioco pre-vendita è un'istituzione"
              fr="SAP a fait du jeu un outil d'avant-vente"
              class="loom-card-title"
            />
            <T
              as="p"
              en="Since 2020 SAP runs facilitator-led board games with customers, from the S/4HANA virtual board game to the BTP Diamond Game, positioned in the discovery phase of the sales cycle, with partners selling facilitated workshops."
              it="Dal 2020 SAP gioca con i clienti board game guidati da facilitatori, dal board game virtuale S/4HANA al BTP Diamond Game, collocati nella fase di discovery del ciclo di vendita, con partner che vendono workshop facilitati."
              fr="Depuis 2020, SAP anime avec ses clients des jeux de plateau facilités, du board game virtuel S/4HANA au BTP Diamond Game, placés en phase de discovery du cycle de vente, avec des partenaires qui vendent des ateliers animés."
              class="loom-card-body"
            />
            <T
              as="p"
              en="SAP News 2020–2023, partner Bluestonex"
              it="SAP News 2020–2023, partner Bluestonex"
              fr="SAP News 2020–2023, partenaire Bluestonex"
              class="mult-src mt-auto"
            />
          </div>

          <div class="loom-card">
            <span class="loom-mark" aria-hidden="true">02</span>
            <T
              as="p"
              en="Workforces build their own AI"
              it="La forza lavoro si costruisce l'AI"
              fr="Les équipes se fabriquent leur IA"
              class="loom-card-title"
            />
            <T
              as="p"
              en="Moderna reports that within two months of adopting ChatGPT Enterprise, employees had built 750 custom GPTs, with 40% of weekly active users creating their own."
              it="Moderna riferisce che due mesi dopo l'adozione di ChatGPT Enterprise i dipendenti avevano creato 750 GPT personalizzati; il 40% degli utenti attivi settimanali ne costruiva di propri."
              fr="Moderna rapporte que deux mois après l'adoption de ChatGPT Enterprise, ses employés avaient créé 750 GPT sur mesure&nbsp;; 40&nbsp;% des utilisateurs actifs chaque semaine bâtissaient les leurs."
              class="loom-card-body"
            />
            <T
              as="p"
              en="OpenAI customer story, Apr 2024 (vendor-reported)"
              it="Customer story OpenAI, apr 2024 (dato del vendor)"
              fr="Customer story OpenAI, avr. 2024 (chiffres de l'éditeur)"
              class="mult-src mt-auto"
            />
          </div>
        </div>
      </div>
    </Slide>

    <!-- ── SLIDE 3: The model — the weave that widens ─────────────── -->
    <Slide id="slide-model" bg="secondary" align="left">
      <div slot="backdrop" class="loom-bg-soft absolute inset-0" aria-hidden="true"></div>

      <div class="atl-frame">
        <T
          as="h2"
          en="How one becomes fifty"
          it="Come uno diventa cinquanta"
          fr="Comment un devient cinquante"
          class="slide-title text-[var(--ink-primary)] mb-6"
          style="font-size: clamp(1.7rem, 2.6vw, 2.4rem);"
          data-reveal
        />

        <!-- Three threads, each widening the weave from one toward fifty -->
        <div class="loom-weave" data-reveal data-reveal-delay="0.1">
          {modelThreads.map((step, i) => (
            <div class="loom-thread" style={`--thread: ${i};`}>
              <div class="loom-thread-rail" aria-hidden="true">
                <span class="loom-thread-num">{step.n}</span>
              </div>
              <div class="loom-thread-copy">
                <T as="p" en={step.title.en} it={step.title.it} fr={step.title.fr} class="loom-thread-title" />
                <T as="p" en={step.body.en} it={step.body.it} fr={step.body.fr} class="loom-thread-body" />
              </div>
            </div>
          ))}
        </div>

        <div class="loom-quote" data-reveal data-reveal-delay="0.22">
          <T
            as="p"
            en="The plan ahead is sized on exactly this: enable people, measure what they ship."
            it="Il piano è tarato proprio su questo: abilitare le persone, misurare ciò che rilasciano."
            fr="Le plan qui suit est calibré là-dessus&nbsp;: outiller les équipes, mesurer ce qu'elles livrent."
            class="loom-quote-text"
          />
        </div>
      </div>
    </Slide>

  </DeckContainer>
</BaseLayout>

<style>
  /* Page-specific refinements over the shared loom system (global.css).
     Explicit rgba / brand tokens only so the deck audit's contrast parser reads them. */

  /* Market panel head: tag on the left, display figure + its attribution stacked right. */
  .mult-head { align-items: flex-start; }
  .mult-tag { font-size: 0.8rem; padding-top: 0.35rem; }
  .mult-figure-block {
    display: flex; flex-direction: column; align-items: flex-end; gap: 0.35rem;
    min-width: 0; text-align: right;
  }
  .mult-figure-src {
    font-size: 0.8rem; line-height: 1.4; letter-spacing: 0.02em;
    color: var(--color-sabbia-300);
  }

  /* Source lines: sentence case, never below the label minimum. */
  .mult-src {
    font-size: 0.8rem; line-height: 1.45; letter-spacing: 0.02em;
    color: var(--color-sabbia-300); max-width: none;
  }

  /* Market: plain closing sentence (no pull-quote device on this slide). */
  .mult-close {
    margin-top: 1.5rem;
    font-family: var(--font-display); font-weight: 500;
    color: var(--color-avorio);
    font-size: clamp(1.05rem, 1.4vw, 1.3rem); line-height: 1.45; max-width: 60ch;
  }
</style>
