---
import BaseLayout from '../layouts/BaseLayout.astro';
import AtelierNavigation from '../components/AtelierNavigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import T from '@edf/core/blocks/i18n/T.astro';
import { href } from '@edf/core/utils/url.js';

const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;

// First-commit dates verified from git history (git log --reverse per app).
// Each fact describes the experience as it is TODAY (2026-09-08), not at birth.
const timeline = [
  {
    date: { en: '15 Jun 2026', it: '15 giu 2026', fr: '15 juin 2026' },
    name: 'Generazioni', client: 'Max Mara',
    fact: {
      en: 'The first instance: eight sections in Italian, where the shared engine was born.',
      it: 'La prima istanza: otto sezioni in italiano, qui è nato il motore condiviso.',
      fr: 'La première instance&nbsp;: huit sections en italien, où le moteur partagé est né.',
    },
  },
  {
    date: { en: '1 Jul 2026', it: '1 lug 2026', fr: '1er juil. 2026' },
    name: 'Engagement Unlimited', client: 'UniCredit',
    fact: {
      en: 'Six chapters, bilingual IT/EN, one customer story.',
      it: 'Sei capitoli, bilingue IT/EN, una sola storia cliente.',
      fr: 'Six chapitres, bilingues IT/EN, une seule histoire client.',
    },
  },
  {
    date: { en: '6 Jul 2026', it: '6 lug 2026', fr: '6 juil. 2026' },
    name: 'Pole Position', client: 'Ferrari Racing',
    fact: {
      en: 'Bilingual EN/IT, nine sections, live product mockups.',
      it: 'Bilingue EN/IT, nove sezioni, mockup di prodotto dal vivo.',
      fr: 'Bilingue EN/IT, neuf sections, maquettes produit en direct.',
    },
  },
  {
    date: { en: '13 Jul 2026', it: '13 lug 2026', fr: '13 juil. 2026' },
    name: 'Connessioni Intelligenti', client: 'FS Group',
    fact: {
      en: 'Two self-contained branches, FS Park and Trenitalia, five chapters each.',
      it: 'Due rami autonomi, FS Park e Trenitalia, cinque capitoli ciascuno.',
      fr: 'Deux branches autonomes, FS Park et Trenitalia, cinq chapitres chacune.',
    },
  },
  {
    date: { en: '14 Jul 2026', it: '14 lug 2026', fr: '14 juil. 2026' },
    name: 'Trait d’Union', client: 'Agos',
    fact: {
      en: 'Seven chapters, consumer credit, live the day after FS.',
      it: 'Sette capitoli, credito al consumo, online il giorno dopo FS.',
      fr: 'Sept chapitres, crédit à la consommation, en ligne le lendemain de FS.',
    },
  },
  {
    date: { en: '28 Aug 2026', it: '28 ago 2026', fr: '28 août 2026' },
    name: 'Orbita', client: 'Eni',
    fact: {
      en: 'Six chapters, group governance, EN/IT.',
      it: 'Sei capitoli, governance di gruppo, EN/IT.',
      fr: 'Six chapitres, gouvernance de groupe, EN/IT.',
    },
  },
  {
    date: { en: '2 Sep 2026', it: '2 set 2026', fr: '2 sept. 2026' },
    name: 'La voce del Ministero', client: 'Ministero dell’Istruzione e del Merito',
    fact: {
      en: 'Seven chapters, Firefly imagery with Content Credentials.',
      it: 'Sette capitoli, immagini Firefly con Content Credentials.',
      fr: 'Sept chapitres, visuels Firefly avec Content Credentials.',
    },
  },
];
const timelineCols = [timeline.slice(0, 4), timeline.slice(4)];

const steps = [
  {
    num: '01',
    name: { en: 'Brief', it: 'Brief', fr: 'Brief' },
    desc: {
      en: 'A guided intake turns “an experience for brand X” into a structured brief.',
      it: 'Un percorso guidato trasforma «un’esperienza per il brand X» in un brief strutturato.',
      fr: 'Une prise de brief guidée transforme «&nbsp;une expérience pour la marque X&nbsp;» en un brief structuré.',
    },
  },
  {
    num: '02',
    name: { en: 'Engine', it: 'Motore', fr: 'Moteur' },
    desc: {
      en: 'A shared deck engine renders it; every client is a skin of tokens, copy and assets.',
      it: 'Un motore di deck condiviso lo mette in scena; ogni cliente è una skin di token, testi e asset.',
      fr: 'Un moteur de deck partagé le met en scène&nbsp;; chaque client est une skin de tokens, textes et assets.',
    },
  },
  {
    num: '03',
    name: { en: 'Craft', it: 'Mestiere', fr: 'Métier' },
    desc: {
      en: 'A person decides story, taste and claims; the AI pair speeds up build, audit and translation.',
      it: 'Una persona decide storia, gusto e affermazioni; l’AI in coppia accelera costruzione, audit e traduzioni.',
      fr: 'Une personne décide du récit, du goût et des affirmations&nbsp;; l’IA en binôme accélère construction, audit et traduction.',
    },
  },
  {
    num: '04',
    name: { en: 'Gates', it: 'Controlli', fr: 'Contrôles' },
    desc: {
      en: 'Automated layout audit at three projection sizes, accessibility AA, screenshot review before anything ships.',
      it: 'Audit automatico del layout su tre formati di proiezione, accessibilità AA, revisione degli screenshot prima di ogni rilascio.',
      fr: 'Audit de layout automatisé à trois formats de projection, accessibilité AA, revue des captures avant toute mise en ligne.',
    },
  },
];

// Four evidence panels (six did not fit at 1280×800 with generous type):
// the public/licensed pair and the repo pair are merged; the AI panel states
// the process rule with its evidence.
const evidence = [
  {
    claim: {
      en: 'Public Adobe capabilities, licensed imagery',
      it: 'Capability Adobe pubbliche, immagini su licenza',
      fr: 'Capacités Adobe publiques, visuels sous licence',
    },
    proof: {
      en: 'No reserved client IP anywhere in the repo. Every asset ships with author, source and licence in provenance.json.',
      it: 'Nessuna proprietà intellettuale riservata dei clienti nel repo. Ogni asset arriva con autore, fonte e licenza in provenance.json.',
      fr: 'Aucune PI client réservée dans le dépôt. Chaque asset embarque auteur, source et licence dans provenance.json.',
    },
  },
  {
    claim: {
      en: 'A public repository, with no secrets in it',
      it: 'Un repository pubblico, senza segreti dentro',
      fr: 'Un dépôt public, sans aucun secret',
    },
    proof: {
      en: 'Credentials live in CI secrets and gitignored env files. Anyone at Adobe can audit any of this.',
      it: 'Le credenziali vivono nei secret di CI e in file env esclusi da git. Chiunque in Adobe può verificare ogni punto.',
      fr: 'Les identifiants restent dans les secrets CI et des fichiers env ignorés par git. N’importe qui chez Adobe peut tout vérifier.',
    },
  },
  {
    claim: {
      en: 'WCAG 2.2 AA and a 12-check layout audit',
      it: 'WCAG 2.2 AA e audit di layout a 12 controlli',
      fr: 'WCAG 2.2 AA et audit de layout en 12 contrôles',
    },
    proof: {
      en: 'The deterministic audit runs on every deck at three projection sizes, before anything ships.',
      it: 'L’audit deterministico gira su ogni deck a tre formati di proiezione, prima di ogni rilascio.',
      fr: 'L’audit déterministe tourne sur chaque deck à trois formats de projection, avant toute mise en ligne.',
    },
  },
  {
    claim: {
      en: 'AI used as a process rule, not a shortcut',
      it: 'L’AI come regola di processo, non scorciatoia',
      fr: 'L’IA comme règle de processus, pas un raccourci',
    },
    proof: {
      en: 'Claude Enterprise, used within its approved data classes; no client data in prompts; the repository is public and auditable.',
      it: 'Claude Enterprise, usato entro le classi di dati consentite; nessun dato cliente nei prompt; il repository è pubblico e verificabile.',
      fr: 'Claude Enterprise, utilisé dans ses classes de données autorisées&nbsp;; aucune donnée client dans les prompts&nbsp;; le dépôt est public et auditable.',
    },
  },
];
---
<BaseLayout
  title="The method"
  description="How the Experience Atelier was built: one Adobian paired with AI, a shared engine, human judgment and automated quality gates, with the evidence for every claim."
>
  <div class="fixed top-0 left-0 right-0 z-50">
    <AtelierNavigation currentPath={currentPath} base={base} />
  </div>

  <DeckContainer
    nextHref={href(base, '/capability')}
    prevHref={href(base, '/')}
  >

    <!-- ── SLIDE 0: Cover (shared template) — detail cut only ───────── -->
    <Slide id="slide-cover" bg="primary" align="center" data-solution="detail">
      <div slot="backdrop" class="loom-bg"></div>
      <div class="atl-frame flex flex-col items-center">
        <p class="atl-cover-num" data-reveal>01</p>
        <T
          as="p"
          en="How it was built"
          it="Come è stato costruito"
          fr="Comment il a été construit"
          class="atl-cover-kicker mt-3 mb-5"
          data-reveal
          data-reveal-delay="0.06"
        />
        <T
          as="h1"
          en="Built in the open."
          it="Costruito alla luce del sole."
          fr="Construit au grand jour."
          class="slide-title text-center text-[var(--ink-primary)] mb-6"
          style="font-size: clamp(2.6rem, 4.8vw, 4.6rem);"
          data-reveal
          data-reveal-delay="0.1"
        />
        <T
          as="p"
          en="One Adobian and an AI pair, on public Adobe capabilities only. Every claim on the next slides carries its proof."
          it="Un Adobiano in coppia con un’AI, usando solo capability Adobe pubbliche. Ogni affermazione nelle prossime slide porta con sé la sua prova."
          fr="Un Adobien en binôme avec une IA, sur les seules capacités Adobe publiques. Chaque affirmation des slides qui suivent apporte sa preuve."
          class="atl-lede"
          data-reveal
          data-reveal-delay="0.16"
        />

        <!-- Warp & weft device: warp threads (the shared engine) crossed by the woven weft. -->
        <div class="mth-warp mx-auto mt-7 mb-7" aria-hidden="true" data-reveal data-reveal-delay="0.2">
          <svg class="mth-warp-svg" viewBox="0 0 720 96" preserveAspectRatio="none" role="presentation">
            <g class="mth-warp-lines">
              <line x1="0" y1="20" x2="720" y2="20" />
              <line x1="0" y1="40" x2="720" y2="40" />
              <line x1="0" y1="60" x2="720" y2="60" />
              <line x1="0" y1="76" x2="720" y2="76" />
            </g>
            <g class="mth-weft-lines">
              <line x1="180" y1="0" x2="180" y2="96" />
              <line x1="360" y1="0" x2="360" y2="96" />
              <line x1="540" y1="0" x2="540" y2="96" />
            </g>
          </svg>
        </div>

        <div class="flex items-center justify-center gap-x-12" data-reveal data-reveal-delay="0.24">
          {[
            { n: '7', en: 'client experiences', it: 'esperienze cliente', fr: 'expériences clients' },
            { n: '3', en: 'languages, one deck', it: 'lingue, un solo deck', fr: 'langues, un seul deck' },
            { n: '12', en: 'checks per slide', it: 'controlli per slide', fr: 'contrôles par slide' },
          ].map((stat) => (
            <div class="text-center">
              <p class="text-[var(--accent-primary)] font-[family-name:var(--font-display)] font-semibold tabular-nums" style="font-size: clamp(1.5rem, 1.9vw, 1.9rem); line-height: 1.1;">{stat.n}</p>
              <T as="p" en={stat.en} it={stat.it} fr={stat.fr} class="atl-label mt-1" />
            </div>
          ))}
        </div>
      </div>
    </Slide>

    <!-- ── SLIDE 1: Genesis — the real timeline, straight and aligned ── -->
    <Slide id="slide-genesis" bg="secondary" align="left">
      <div slot="backdrop" class="loom-bg-soft"></div>
      <div class="atl-frame">
        <T
          as="h2"
          en="From one evening demo to seven client experiences"
          it="Da una demo serale a sette esperienze cliente"
          fr="D’une démo du soir à sept expériences clients"
          class="mth-h2 slide-title text-[var(--ink-primary)]"
          data-reveal
        />
        <T
          as="p"
          en="All on the same shared engine."
          it="Tutte sullo stesso motore condiviso."
          fr="Toutes sur le même moteur partagé."
          class="mth-sub"
          data-reveal
          data-reveal-delay="0.06"
        />

        <div class="mth-timeline" data-reveal data-reveal-delay="0.14">
          {timelineCols.map((col) => (
            <ol class="mth-col">
              {col.map((row) => (
                <li class="mth-row">
                  <T
                    as="p"
                    en={row.date.en}
                    it={row.date.it}
                    fr={row.date.fr}
                    class="mth-date atl-label"
                  />
                  <span class="mth-dot" aria-hidden="true"></span>
                  <div class="mth-copy">
                    <p class="mth-name">
                      {row.name} <span class="mth-client">· {row.client}</span>
                    </p>
                    <T as="p" en={row.fact.en} it={row.fact.it} fr={row.fact.fr} class="mth-fact" />
                  </div>
                </li>
              ))}
            </ol>
          ))}
        </div>
      </div>
    </Slide>

    <!-- ── SLIDE 2: The working method — four steps ───────────────── -->
    <Slide id="slide-method" bg="primary" align="left">
      <div slot="backdrop" class="loom-bg"></div>
      <div class="atl-frame">
        <T
          as="h2"
          en="The working method"
          it="Il metodo di lavoro"
          fr="La méthode de travail"
          class="mth-h2 slide-title text-[var(--ink-primary)]"
          data-reveal
        />
        <T
          as="p"
          en="The person decides; the AI takes weeks out of the build."
          it="Decide la persona; l’AI toglie settimane alla costruzione."
          fr="La personne décide&nbsp;; l’IA fait gagner des semaines de construction."
          class="mth-sub"
          data-reveal
          data-reveal-delay="0.06"
        />

        <div class="mth-loom-grid w-full" data-reveal data-reveal-delay="0.14">
          {steps.map((s) => (
            <article class="loom-card">
              <span class="loom-mark" aria-hidden="true">{s.num}</span>
              <T as="h3" en={s.name.en} it={s.name.it} fr={s.name.fr} class="loom-card-title" />
              <T as="p" en={s.desc.en} it={s.desc.it} fr={s.desc.fr} class="loom-card-body" style="margin-bottom: 0;" />
            </article>
          ))}
        </div>
      </div>
    </Slide>

    <!-- ── SLIDE 3: Compliant by construction — detail cut only ──────── -->
    <Slide id="slide-compliance" bg="secondary" align="left" data-solution="detail">
      <div slot="backdrop" class="loom-bg-soft"></div>
      <div class="atl-frame">
        <T
          as="h2"
          en="Compliant by construction"
          it="Conforme per costruzione"
          fr="Conforme par construction"
          class="mth-h2 slide-title text-[var(--ink-primary)]"
          data-reveal
        />
        <T
          as="p"
          en="Every claim on this deck, with its evidence."
          it="Ogni affermazione di questo deck, con la sua prova."
          fr="Chaque affirmation de ce deck, avec sa preuve."
          class="mth-sub"
          data-reveal
          data-reveal-delay="0.06"
        />

        <div class="mth-evidence-grid w-full" data-reveal data-reveal-delay="0.14">
          {evidence.map((row) => (
            <div class="loom-panel mth-panel">
              <div class="loom-panel-head">
                <T
                  as="h3"
                  en={row.claim.en}
                  it={row.claim.it}
                  fr={row.claim.fr}
                  class="mth-claim text-[var(--ink-primary)]"
                />
              </div>
              <T as="p" en={row.proof.en} it={row.proof.it} fr={row.proof.fr} class="loom-panel-body" style="margin-bottom: 0;" />
            </div>
          ))}
        </div>

        <T
          as="p"
          en="The repo-verifiable evidence lives in the repository: provenance.json per app, CI configuration, audit scripts."
          it="Le prove verificabili nel repository sono lì: provenance.json per ogni app, configurazione CI, script di audit."
          fr="Les preuves vérifiables dans le dépôt y résident&nbsp;: provenance.json par app, configuration CI, scripts d’audit."
          class="mth-foot"
          data-reveal
          data-reveal-delay="0.24"
        />
      </div>
    </Slide>

  </DeckContainer>
</BaseLayout>

<style>
  /* ── The method — section devices (loom warp/weft) ───────────────── */

  /* Cover: warp threads (constant engine) crossed by woven weft. */
  .mth-warp { width: min(560px, 70%); }
  .mth-warp-svg { width: 100%; height: clamp(48px, 7vh, 88px); display: block; }
  .mth-warp-lines line {
    stroke: rgba(201, 169, 106, 0.5);
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
  }
  .mth-weft-lines line {
    stroke: rgba(201, 169, 106, 0.28);
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
  }
  @media (prefers-reduced-motion: no-preference) {
    .mth-weft-lines line {
      stroke-dasharray: 4 6;
      animation: mth-weft-flow 3.2s linear infinite;
    }
    @keyframes mth-weft-flow { to { stroke-dashoffset: -20; } }
  }

  /* Content-slide heading: title + one readable sub-line (no uppercase eyebrow). */
  .mth-h2 {
    font-size: clamp(1.7rem, 2.6vw, 2.4rem);
    max-width: none;
    margin-bottom: 0.5rem;
  }
  .mth-sub {
    color: var(--color-sabbia-200);
    font-size: clamp(1rem, 1.2vw, 1.2rem);
    line-height: 1.5;
    max-width: none;
    margin-bottom: 1.1rem;
  }

  /* Genesis: two straight vertical timelines (4 + 3), titles aligned on one
     x for every row — no staircase. Date column · rail · copy. */
  .mth-timeline {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 2.5rem;
    width: 100%;
  }
  .mth-col { list-style: none; display: flex; flex-direction: column; min-width: 0; }
  .mth-row {
    position: relative;
    display: grid;
    grid-template-columns: 6.6rem 1.25rem minmax(0, 1fr);
    align-items: start;
    column-gap: 0.4rem;
    padding-block: 0.55rem;
  }
  .mth-row:first-child { padding-top: 0; }
  .mth-row:last-child { padding-bottom: 0; }
  /* the rail: a hairline through the dot column, per column of rows */
  .mth-row::before {
    content: '';
    position: absolute;
    left: calc(6.6rem + 0.4rem + 0.625rem - 0.5px);
    top: 0; bottom: 0;
    width: 1px;
    background: rgba(201, 169, 106, 0.32);
  }
  .mth-row:first-child::before { top: 0.6rem; }
  .mth-row:last-child::before { bottom: auto; height: 0.6rem; }
  .mth-date {
    color: var(--accent-primary);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    max-width: none;
    line-height: 1.5;
    padding-top: 0.2rem;
  }
  .mth-dot {
    width: 0.625rem; height: 0.625rem; border-radius: 50%;
    background: var(--color-champagne);
    margin-top: 0.42rem;
    justify-self: center;
    position: relative; z-index: 1;
  }
  .mth-copy { min-width: 0; }
  .mth-name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.05rem;
    line-height: 1.3;
    color: var(--color-avorio);
    max-width: none;
  }
  .mth-client { font-weight: 500; color: var(--color-sabbia-300); }
  .mth-fact {
    color: var(--color-sabbia-200);
    font-size: 0.95rem;
    line-height: 1.5;
    max-width: none;
  }
  @media (max-width: 1023px) {
    .mth-timeline { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    .mth-row { grid-template-columns: 1.25rem minmax(0, 1fr); }
    .mth-row::before { left: calc(0.625rem - 0.5px); }
    .mth-date { grid-column: 2; order: -1; padding-top: 0; }
    .mth-dot { grid-row: 1 / span 2; }
  }

  /* Method: four steps of the weave. */
  .mth-loom-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.9rem;
  }
  @media (max-width: 767px) {
    .mth-loom-grid { grid-template-columns: 1fr; }
  }

  /* Compliance: four claim panels, each with its proof below. */
  .mth-evidence-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-auto-rows: 1fr;
    gap: 0.9rem;
  }
  @media (max-width: 640px) {
    .mth-evidence-grid { grid-template-columns: 1fr; }
  }
  .mth-claim {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.1rem;
    line-height: 1.3;
    max-width: none;
  }
  .mth-foot {
    margin-top: 1rem;
    color: var(--color-sabbia-300);
    font-size: 0.85rem;
    line-height: 1.5;
    max-width: none;
  }
</style>
