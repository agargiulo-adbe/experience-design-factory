---
import BaseLayout from '../layouts/BaseLayout.astro';
import AtelierNavigation from '../components/AtelierNavigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import T from '@edf/core/blocks/i18n/T.astro';
import { href } from '@edf/core/utils/url.js';

const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;

// Plan as of September 2026 (decision requested by 31 October 2026).
// Three milestones, eight months (November 2026 → June 2027). Work and targets are
// declared in advance: the KPI story is "we measure ourselves".
//   M1 · by end of January 2027 — Foundations
//   M2 · by Adobe Summit, Las Vegas, 22–25 March 2027 — Scale and open
//        (Summit dates to be confirmed on summit.adobe.com)
//   M3 · by end of June 2027 — Enterprise and lighthouse
const milestones = [
  {
    id: 'slide-m1',
    bg: 'secondary' as const,
    kicker: {
      en: 'Milestone 1 · by end of January 2027',
      it: 'Milestone 1 · entro fine gennaio 2027',
      fr: 'Jalon 1 · d’ici fin janvier 2027',
    },
    title: { en: 'Foundations', it: 'Fondamenta', fr: 'Fondations' },
    intro: {
      en: 'From one person’s project to a measured, compliant, callable platform.',
      it: 'Dal progetto personale a una piattaforma misurata, conforme, richiamabile.',
      fr: 'Du projet personnel à une plateforme mesurée, conforme et appelable.',
    },
    work: [
      {
        en: 'Pilot: five to ten Adobe Italia sellers build their first experience through the guided intake',
        it: 'Pilota: da cinque a dieci commerciali di Adobe Italia costruiscono la loro prima esperienza con il brief guidato',
        fr: 'Pilote&nbsp;: cinq à dix commerciaux d’Adobe Italia construisent leur première expérience grâce au brief guidé',
      },
      {
        en: 'Telemetry live on three experiences; art. 50 disclosure record exported from provenance; C2PA manifest kept through the build',
        it: 'Telemetria attiva su tre esperienze; registro di trasparenza dell’art. 50 esportato dalla provenance; manifest C2PA intatto per tutta la build',
        fr: 'Télémétrie active sur trois expériences&nbsp;; registre de transparence de l’art. 50 exporté depuis la provenance&nbsp;; manifeste C2PA conservé tout au long du build',
      },
      {
        en: 'MCP server v1 with three Agent Skills, used by the pilot from Claude Enterprise',
        it: 'Server MCP v1 con tre Agent Skills, usato dal pilota dentro Claude Enterprise',
        fr: 'Serveur MCP v1 avec trois Agent Skills, utilisé par le pilote depuis Claude Enterprise',
      },
      {
        en: 'One private Firefly Custom Model for one client brand (beta)',
        it: 'Un Firefly Custom Model privato sul brand di un cliente (beta)',
        fr: 'Un Firefly Custom Model privé sur la marque d’un client (bêta)',
      },
      {
        en: 'Simulation: multiplayer skeleton on real funnel data',
        it: 'Simulazione: scheletro multiplayer sui dati veri di un funnel',
        fr: 'Simulation&nbsp;: squelette multijoueur sur de vraies données de funnel',
      },
    ],
    targets: {
      en: 'Brief to experience under one week · at least three pilot experiences in deals, with engagement data · zero art. 50 incidents · MCP server used by every pilot seller',
      it: 'Dal brief all’esperienza in meno di una settimana · almeno tre esperienze pilota in trattativa, con i dati di utilizzo · zero incidenti sull’art. 50 · server MCP usato da tutti i commerciali del pilota',
      fr: 'Du brief à l’expérience en moins d’une semaine · au moins trois expériences pilotes dans des deals, avec les données d’engagement · zéro incident art. 50 · serveur MCP utilisé par tous les commerciaux du pilote',
    },
  },
  {
    id: 'slide-m2',
    bg: 'primary' as const,
    kicker: {
      en: 'Milestone 2 · by Adobe Summit, Las Vegas, 22–25 March 2027',
      it: 'Milestone 2 · entro l’Adobe Summit, Las Vegas, 22–25 marzo 2027',
      fr: 'Jalon 2 · d’ici l’Adobe Summit, Las Vegas, 22–25 mars 2027',
    },
    title: { en: 'Scale and open', it: 'Scalare e aprire', fr: 'Monter en échelle et ouvrir' },
    intro: {
      en: 'The buying surface gets its agent, and the Atelier takes its public stage.',
      it: 'La superficie d’acquisto ha il suo agente e l’Atelier sale sul palco pubblico.',
      fr: 'La surface d’achat reçoit son agent et l’Atelier monte sur la scène publique.',
    },
    work: [
      {
        en: 'Buyer-facing agent (Brand Concierge) on three live experiences',
        it: 'Agente rivolto al buyer (Brand Concierge) su tre esperienze già online',
        fr: 'Agent face à l’acheteur (Brand Concierge) sur trois expériences en ligne',
      },
      {
        en: 'Atelier in the Agent Skills Catalog; scoping and configuration as MCP Apps',
        it: 'Atelier nell’Agent Skills Catalog; scoping e configurazione come MCP App',
        fr: 'Atelier dans l’Agent Skills Catalog&nbsp;; cadrage et configuration en MCP Apps',
      },
      {
        en: 'Template gallery and guided flow; 25 to 40 active users',
        it: 'Galleria di template e percorso guidato; da 25 a 40 utenti attivi',
        fr: 'Galerie de templates et parcours guidé&nbsp;; 25 à 40 utilisateurs actifs',
      },
      {
        en: 'Two to three Adobe partners co-build joint experiences',
        it: 'Due o tre partner Adobe co-costruiscono esperienze congiunte',
        fr: 'Deux à trois partenaires Adobe co-construisent des expériences conjointes',
      },
      {
        en: 'Simulation: facilitated beta and first real workshop',
        it: 'Simulazione: beta facilitata e primo workshop vero',
        fr: 'Simulation&nbsp;: bêta accompagnée et premier atelier réel',
      },
      {
        en: 'Hackathon day, February 2027 · Summit demo pod and speaking submission',
        it: 'Giornata hackathon, febbraio 2027 · demo pod al Summit e candidatura per uno speech',
        fr: 'Journée hackathon, février 2027 · pod de démo au Summit et candidature pour une prise de parole',
      },
    ],
    targets: {
      en: 'Ten or more experiences in active deals, measured · influenced pipeline reported per deal · at least two partner co-signed experiences · Summit demo pod confirmed',
      it: 'Dieci o più esperienze in trattative attive, misurate · pipeline influenzata riportata per trattativa · almeno due esperienze co-firmate con i partner · demo pod al Summit confermato',
      fr: 'Dix expériences ou plus dans des deals actifs, mesurées · pipeline influencé rapporté par deal · au moins deux expériences co-signées avec des partenaires · pod de démo au Summit confirmé',
    },
  },
  {
    id: 'slide-m3',
    bg: 'secondary' as const,
    kicker: {
      en: 'Milestone 3 · by end of June 2027',
      it: 'Milestone 3 · entro fine giugno 2027',
      fr: 'Jalon 3 · d’ici fin juin 2027',
    },
    title: { en: 'Enterprise and lighthouse', it: 'Enterprise e faro', fr: 'Entreprise et vitrine' },
    intro: {
      en: 'The capability becomes infrastructure, with a first EMEA client to show for it.',
      it: 'La capability diventa infrastruttura, con un primo cliente EMEA da mostrare.',
      fr: 'La capacité devient infrastructure, avec un premier client EMEA à montrer.',
    },
    work: [
      {
        en: 'Enterprise-managed authorization via MCP, audit logs, security review',
        it: 'Autorizzazione gestita dall’azienda via MCP, audit log, security review',
        fr: 'Autorisation gérée par l’entreprise via MCP, journaux d’audit, revue de sécurité',
      },
      {
        en: 'Brief to experience in under 24 hours; agent on every experience',
        it: 'Dal brief all’esperienza in meno di 24 ore; agente su ogni esperienza',
        fr: 'Du brief à l’expérience en moins de 24 heures&nbsp;; agent sur chaque expérience',
      },
      {
        en: 'Expansion across EMEA with live translation in the room',
        it: 'Espansione in tutta l’area EMEA, con traduzione dal vivo in sala',
        fr: 'Expansion dans toute la zone EMEA, avec traduction en direct dans la salle',
      },
      {
        en: 'Lighthouse: the first partner co-built experience live for an EMEA client',
        it: 'Faro: la prima esperienza co-costruita con un partner, attiva per un cliente EMEA',
        fr: 'Vitrine&nbsp;: la première expérience co-construite avec un partenaire, en production chez un client EMEA',
      },
      {
        en: 'Simulation: second industry pack',
        it: 'Simulazione: secondo pacchetto di settore',
        fr: 'Simulation&nbsp;: deuxième pack sectoriel',
      },
    ],
    targets: {
      en: 'One hundred or more enabled users · one lighthouse experience live with an EMEA client · 100% of shipped assets with provenance and C2PA · the project institutionalised with a team and a budget line',
      it: 'Cento o più utenti abilitati · un’esperienza faro attiva con un cliente EMEA · il 100% degli asset pubblicati con provenance e C2PA · il progetto istituzionalizzato con un team e una voce di budget',
      fr: 'Cent utilisateurs formés et outillés ou plus · une expérience vitrine en production chez un client EMEA · 100&nbsp;% des assets livrés avec provenance et C2PA · le projet institutionnalisé avec une équipe et une ligne budgétaire',
    },
  },
];

// ── Roadmap as a Gantt: six workstreams (rows) on a time axis from November 2026
// to June 2027. The grid has 16 half-month columns (col 2 = 1–15 Nov … col 17 =
// 16–30 Jun) after the lane column, so bars can end exactly on the milestone
// lines: M1 end of January (line 8), M2 end of March / Summit (line 12), M3 end
// of June (line 18). The Simulation row is gated by the `simulation` toggle.
const ganttMonths = [
  { en: 'Nov 2026', it: 'nov 2026', fr: 'nov. 2026' },
  { en: 'Dec', it: 'dic', fr: 'déc.' },
  { en: 'Jan 2027', it: 'gen 2027', fr: 'janv. 2027' },
  { en: 'Feb', it: 'feb', fr: 'févr.' },
  { en: 'Mar', it: 'mar', fr: 'mars' },
  { en: 'Apr', it: 'apr', fr: 'avr.' },
  { en: 'May', it: 'mag', fr: 'mai' },
  { en: 'Jun', it: 'giu', fr: 'juin' },
];

// Milestone labels (row 2) sit right above their vertical line (rows 3–8).
const ganttMilestoneLabels = [
  { col: '1', align: 'right', en: 'Decision · 31 Oct', it: 'Decisione · 31 ott', fr: 'Décision · 31 oct.' },
  { col: '5 / 9', align: 'center', en: 'M1 · end Jan', it: 'M1 · fine gen', fr: 'J1 · fin janv.' },
  { col: '10 / 14', align: 'center', en: 'M2 · Summit · 22–25 Mar', it: 'M2 · Summit · 22–25 mar', fr: 'J2 · Summit · 22–25 mars' },
  { col: '14 / 18', align: 'right', en: 'M3 · end Jun', it: 'M3 · fine giu', fr: 'J3 · fin juin' },
];
// Vertical lines: [grid column, at its start or its end edge].
const ganttMarkers = [
  { col: '2', edge: 'start', today: true },
  { col: '7', edge: 'end', today: false },
  { col: '11', edge: 'end', today: false },
  { col: '17', edge: 'end', today: false },
];

const P1 = '2 / 8';   // Nov → end Jan
const P2 = '8 / 12';  // Feb → end Mar
const P3 = '12 / 18'; // Apr → end Jun
const whenP1 = { en: 'Nov → end Jan', it: 'nov → fine gen', fr: 'nov. → fin janv.' };
const whenP2 = { en: 'Feb → Mar', it: 'feb → mar', fr: 'févr. → mars' };
const whenP3 = { en: 'Apr → Jun', it: 'apr → giu', fr: 'avr. → juin' };

const ganttRows = [
  {
    lane: { en: 'Trust & compliance', it: 'Fiducia e conformità', fr: 'Confiance & conformité' },
    segs: [
      { col: P1, when: whenP1, en: 'Telemetry, art. 50 record, C2PA kept, secrets out of the repo',
        it: 'Telemetria, registro art. 50, C2PA intatto, segreti fuori dal repo',
        fr: 'Télémétrie, registre art. 50, C2PA conservé, secrets hors du dépôt' },
      { col: P2, when: whenP2, en: 'Security review', it: 'Security review', fr: 'Revue de sécurité' },
      { col: P3, when: whenP3, en: 'Enterprise-managed auth via MCP', it: 'Autorizzazione gestita dall’azienda via MCP', fr: 'Autorisation gérée par l’entreprise via MCP' },
    ],
  },
  {
    lane: { en: 'Buying surface', it: 'Superficie d’acquisto', fr: 'Surface d’achat' },
    segs: [
      { col: P1, when: whenP1, en: 'Telemetry live on 3 experiences', it: 'Telemetria attiva su 3 esperienze', fr: 'Télémétrie active sur 3 expériences' },
      { col: P2, when: whenP2, en: 'Buyer agent (Brand Concierge) on 3', it: 'Agente per il buyer (Brand Concierge) su 3', fr: 'Agent acheteur (Brand Concierge) sur 3' },
      { col: P3, when: whenP3, en: 'On every experience', it: 'Su ogni esperienza', fr: 'Sur chaque expérience' },
    ],
  },
  {
    lane: { en: 'Distribution', it: 'Distribuzione', fr: 'Distribution' },
    segs: [
      { col: P1, when: whenP1, en: 'MCP server v1 + 3 Agent Skills', it: 'Server MCP v1 + 3 Agent Skills', fr: 'Serveur MCP v1 + 3 Agent Skills' },
      { col: P2, when: whenP2, en: 'In the Agent Skills Catalog · MCP Apps for scoping',
        it: 'Nell’Agent Skills Catalog · MCP App per lo scoping',
        fr: 'Dans l’Agent Skills Catalog · MCP Apps pour le cadrage' },
      { col: P3, when: whenP3, en: 'Brief → experience in 24 h', it: 'Dal brief all’esperienza in 24 h', fr: 'Du brief à l’expérience en 24 h' },
    ],
  },
  {
    lane: { en: 'Enablement', it: 'Abilitazione', fr: 'Montée en compétence' },
    segs: [
      { col: P1, when: whenP1, en: 'Pilot: 5–10 sellers', it: 'Pilota: 5–10 commerciali', fr: 'Pilote&nbsp;: 5–10 commerciaux' },
      { col: P2, when: whenP2, en: 'Gallery + guided flow · 25–40', it: 'Galleria + percorso · 25–40', fr: 'Galerie + flux guidé · 25–40' },
      { col: P3, when: whenP3, en: '100+ · EMEA, live translation', it: '100+ · EMEA, traduzione dal vivo', fr: '100+ · EMEA, traduction en direct' },
    ],
  },
  {
    lane: { en: 'Ecosystem', it: 'Ecosistema', fr: 'Écosystème' },
    segs: [
      { col: P2, when: whenP2, en: '2–3 partners co-build', it: '2–3 partner co-creano', fr: '2–3 partenaires co-créent' },
      { col: P3, when: whenP3, en: 'Partner pipeline · lighthouse client', it: 'Pipeline partner · cliente faro', fr: 'Pipeline partenaires · client vitrine' },
    ],
  },
  {
    lane: { en: 'Simulation', it: 'Simulazione', fr: 'Simulation' },
    solution: 'simulation',
    segs: [
      { col: P1, when: whenP1, en: 'Multiplayer skeleton on real funnel data', it: 'Scheletro multiplayer sul funnel vero', fr: 'Squelette multijoueur sur le vrai funnel' },
      { col: P2, when: whenP2, en: 'Facilitated beta, first workshop', it: 'Beta facilitata, primo workshop', fr: 'Bêta accompagnée, premier atelier' },
      { col: P3, when: whenP3, en: 'Second industry pack', it: 'Secondo pacchetto di settore', fr: 'Deuxième pack sectoriel' },
    ],
  },
];

// Key moments: three, in date order.
const ganttMoments = [
  { name: { en: 'Decision', it: 'Decisione', fr: 'Décision' },
    date: { en: '31 Oct 2026', it: '31 ott 2026', fr: '31 oct. 2026' } },
  { name: { en: 'Hackathon day', it: 'Hackathon', fr: 'Hackathon' },
    date: { en: 'Feb 2027', it: 'feb 2027', fr: 'févr. 2027' } },
  { name: { en: 'Adobe Summit, Las Vegas', it: 'Adobe Summit, Las Vegas', fr: 'Adobe Summit, Las Vegas' },
    date: { en: '22–25 Mar 2027', it: '22–25 mar 2027', fr: '22–25 mars 2027' } },
];

// ── KPI scorecard: four families, three metrics each, a target per milestone.
// Split over two slides (two families each) so type stays generous.
const kpiCols = [
  { en: 'M1 · end Jan 2027', it: 'M1 · fine gen 2027', fr: 'J1 · fin janv. 2027' },
  { en: 'M2 · 22–25 Mar 2027', it: 'M2 · 22–25 mar 2027', fr: 'J2 · 22–25 mars 2027' },
  { en: 'M3 · end Jun 2027', it: 'M3 · fine giu 2027', fr: 'J3 · fin juin 2027' },
];
const ownerLead = { en: 'Owner: project lead', it: 'Responsabile: project lead', fr: 'Responsable&nbsp;: chef de projet' };
const ownerSponsor = { en: 'Owner: sponsor + project lead', it: 'Responsabili: sponsor + project lead', fr: 'Responsables&nbsp;: sponsor + chef de projet' };

type Tri = { en: string; it: string; fr: string };
type KpiFamily = { name: Tri; owner: Tri; metrics: Array<{ name: Tri; m: [Tri, Tri, Tri] }> };

const kpiSlides: Array<{ id: string; label: Tri; title: Tri; families: KpiFamily[] }> = [
  {
    id: 'slide-kpi',
    label: { en: 'KPI scorecard · families 1–2 of 4', it: 'Scorecard KPI · famiglie 1–2 di 4', fr: 'Tableau de bord KPI · familles 1–2 sur 4' },
    title: {
      en: 'Targets at every milestone: buying surface and speed',
      it: 'Obiettivi a ogni milestone: superficie d’acquisto e velocità',
      fr: 'Des objectifs à chaque jalon&nbsp;: surface d’achat et vitesse',
    },
    families: [
      {
        name: { en: 'Buying surface', it: 'Superficie d’acquisto', fr: 'Surface d’achat' },
        owner: ownerSponsor,
        metrics: [
          { name: { en: 'Influenced pipeline, measured', it: 'Pipeline influenzata, misurata', fr: 'Pipeline influencé, mesuré' },
            m: [{ en: 'baseline', it: 'baseline', fr: 'référence' },
                { en: 'reported per deal', it: 'riportata per trattativa', fr: 'rapporté par deal' },
                { en: 'reported per deal', it: 'riportata per trattativa', fr: 'rapporté par deal' }] },
          { name: { en: 'Experiences reopened by the client after the meeting', it: 'Esperienze riaperte dal cliente dopo l’incontro', fr: 'Expériences rouvertes par le client après la réunion' },
            m: [{ en: 'tracked', it: 'tracciate', fr: 'suivies' }, { en: '50%', it: '50%', fr: '50&nbsp;%' }, { en: '70%', it: '70%', fr: '70&nbsp;%' }] },
          { name: { en: 'Buyer questions answered by the agent', it: 'Domande del buyer a cui risponde l’agente', fr: 'Questions de l’acheteur traitées par l’agent' },
            m: [{ en: '—', it: '—', fr: '—' },
                { en: 'on 3 experiences', it: 'su 3 esperienze', fr: 'sur 3 expériences' },
                { en: 'on all', it: 'su tutte', fr: 'sur toutes' }] },
        ],
      },
      {
        name: { en: 'Speed', it: 'Velocità', fr: 'Vitesse' },
        owner: ownerLead,
        metrics: [
          { name: { en: 'Brief to first experience', it: 'Dal brief alla prima esperienza', fr: 'Du brief à la première expérience' },
            m: [{ en: '< 1 week', it: '< 1 settimana', fr: '< 1 semaine' }, { en: '< 2 days', it: '< 2 giorni', fr: '< 2 jours' }, { en: '< 24 hours', it: '< 24 ore', fr: '< 24 heures' }] },
          { name: { en: 'Experiences in active deals', it: 'Esperienze in trattative attive', fr: 'Expériences dans des deals actifs' },
            m: [{ en: '3 (pilot)', it: '3 (pilota)', fr: '3 (pilote)' }, { en: '10+', it: '10+', fr: '10+' }, { en: '25+', it: '25+', fr: '25+' }] },
          { name: { en: 'How people create', it: 'Come creano le persone', fr: 'Comment les gens créent' },
            m: [{ en: 'guided', it: 'in modo guidato', fr: 'accompagnés' }, { en: 'self-service', it: 'in autonomia', fr: 'en autonomie' }, { en: 'self-service', it: 'in autonomia', fr: 'en autonomie' }] },
        ],
      },
    ],
  },
  {
    id: 'slide-kpi-2',
    label: { en: 'KPI scorecard · families 3–4 of 4', it: 'Scorecard KPI · famiglie 3–4 di 4', fr: 'Tableau de bord KPI · familles 3–4 sur 4' },
    title: {
      en: 'Targets at every milestone: trust and people',
      it: 'Obiettivi a ogni milestone: fiducia e persone',
      fr: 'Des objectifs à chaque jalon&nbsp;: confiance et personnes',
    },
    families: [
      {
        name: { en: 'Trust', it: 'Fiducia', fr: 'Confiance' },
        owner: ownerLead,
        metrics: [
          { name: { en: 'Art. 50 incidents', it: 'Incidenti sull’art. 50', fr: 'Incidents art. 50' },
            m: [{ en: '0', it: '0', fr: '0' }, { en: '0', it: '0', fr: '0' }, { en: '0', it: '0', fr: '0' }] },
          { name: { en: 'Shipped assets with provenance and C2PA', it: 'Asset pubblicati con provenance e C2PA', fr: 'Assets livrés avec provenance et C2PA' },
            m: [{ en: '50%', it: '50%', fr: '50&nbsp;%' }, { en: '100%', it: '100%', fr: '100&nbsp;%' }, { en: '100%', it: '100%', fr: '100&nbsp;%' }] },
          { name: { en: 'Access and audit', it: 'Accessi e audit', fr: 'Accès et audit' },
            m: [{ en: 'telemetry, secrets out of repo', it: 'telemetria, segreti fuori dal repo', fr: 'télémétrie, secrets hors du dépôt' },
                { en: 'security review', it: 'security review', fr: 'revue de sécurité' },
                { en: 'enterprise-managed auth + audit logs', it: 'autorizzazione aziendale + audit log', fr: 'autorisation entreprise + journaux d’audit' }] },
        ],
      },
      {
        name: { en: 'People & ecosystem', it: 'Persone ed ecosistema', fr: 'Personnes & écosystème' },
        owner: ownerSponsor,
        metrics: [
          { name: { en: 'Enabled Adobians', it: 'Adobiani abilitati', fr: 'Adobiens formés et outillés' },
            m: [{ en: '5–10', it: '5–10', fr: '5–10' }, { en: '25–40', it: '25–40', fr: '25–40' }, { en: '100+', it: '100+', fr: '100+' }] },
          { name: { en: 'Partner co-signed experiences', it: 'Esperienze co-firmate con i partner', fr: 'Expériences co-signées avec des partenaires' },
            m: [{ en: '0', it: '0', fr: '0' }, { en: '2', it: '2', fr: '2' }, { en: '5', it: '5', fr: '5' }] },
          { name: { en: 'Lighthouse client experience', it: 'Esperienza faro con un cliente', fr: 'Expérience vitrine chez un client' },
            m: [{ en: '—', it: '—', fr: '—' }, { en: 'scoped', it: 'definita', fr: 'cadrée' }, { en: 'live, EMEA', it: 'live, EMEA', fr: 'en production, EMEA' }] },
        ],
      },
    ],
  },
];
---
<BaseLayout
  title="The plan"
  description="The plan as of September 2026 — eight months, three milestones: foundations by end of January, scale and open by Adobe Summit in March, enterprise and lighthouse by end of June, with a target at every milestone."
>
  <div class="fixed top-0 left-0 right-0 z-50">
    <AtelierNavigation currentPath={currentPath} base={base} />
  </div>

  <DeckContainer
    nextHref={href(base, '/asks')}
    prevHref={href(base, '/moves')}
  >

    <!-- ── SLIDE 0: Cover (detail cut only: the sponsor cut opens on the Gantt) ── -->
    <Slide id="slide-cover" bg="primary" align="center" data-solution="detail">
      <div slot="backdrop" class="loom-bg"></div>
      <p class="atl-cover-num mb-5" data-reveal data-display aria-hidden="true">05</p>
      <T
        as="p"
        en="The plan"
        it="Il piano"
        fr="Le plan"
        class="atl-cover-kicker mb-5"
        data-reveal
        data-reveal-delay="0.08"
      />
      <T
        as="h1"
        en="Eight months, three milestones."
        it="Otto mesi, tre milestone."
        fr="Huit mois, trois jalons."
        class="slide-title text-center text-[var(--ink-primary)] mx-auto max-w-5xl mb-5"
        style="font-size: clamp(2.2rem, 4vw, 3.9rem);"
        data-reveal
        data-reveal-delay="0.15"
      />
      <T
        as="p"
        en="Each one ends with a number you can check."
        it="Ognuna si chiude con un numero verificabile."
        fr="Chacun se termine sur un chiffre vérifiable."
        class="atl-lede"
        data-reveal
        data-reveal-delay="0.22"
      />

      <!-- Woven timeline warp: three milestone nodes on a champagne spine -->
      <div class="pln-cover-warp" data-reveal data-reveal-delay="0.3" aria-hidden="true">
        <span class="pln-cover-spine"></span>
        <span class="pln-cover-node"></span>
        <span class="pln-cover-node"></span>
        <span class="pln-cover-node"></span>
      </div>

      <div class="flex items-center justify-center flex-wrap gap-x-4 gap-y-2 mt-4" data-reveal data-reveal-delay="0.34">
        <T
          en="Foundations"
          it="Fondamenta"
          fr="Fondations"
          class="font-semibold tracking-widest uppercase text-[var(--color-sabbia-300)]"
          style="font-size: 0.9rem;"
        />
        <span class="w-1 h-1 rounded-full bg-[var(--accent-primary)]" aria-hidden="true"></span>
        <T
          en="Scale and open"
          it="Scalare e aprire"
          fr="Monter en échelle et ouvrir"
          class="font-semibold tracking-widest uppercase text-[var(--color-sabbia-300)]"
          style="font-size: 0.9rem;"
        />
        <span class="w-1 h-1 rounded-full bg-[var(--accent-primary)]" aria-hidden="true"></span>
        <T
          en="Enterprise and lighthouse"
          it="Enterprise e faro"
          fr="Entreprise et vitrine"
          class="font-semibold tracking-widest uppercase text-[var(--color-sabbia-300)]"
          style="font-size: 0.9rem;"
        />
      </div>

      <T
        as="p"
        en="Plan as of September 2026 · decision by 31 October 2026"
        it="Piano aggiornato a settembre 2026 · decisione entro il 31 ottobre 2026"
        fr="Plan à jour en septembre 2026 · décision d’ici le 31&nbsp;octobre 2026"
        class="atl-label text-center mt-6"
        data-reveal
        data-reveal-delay="0.4"
      />
    </Slide>

    <!-- ── SLIDE 1: Roadmap — a Gantt over the eight months ────────── -->
    <Slide id="slide-roadmap" bg="secondary" align="left">
      <div slot="backdrop" class="loom-bg-soft"></div>
      <div class="atl-frame">
        <T
          as="h2"
          en="The roadmap, November 2026 to June 2027"
          it="La roadmap, da novembre 2026 a giugno 2027"
          fr="La feuille de route, de novembre 2026 à juin 2027"
          class="slide-title text-[var(--ink-primary)] mb-4"
          style="font-size: clamp(1.6rem, 2.4vw, 2.25rem); max-width: none;"
          data-reveal
        />

        <div class="pln-gantt" data-reveal data-reveal-delay="0.12">
          <!-- Row 1: the month axis -->
          <div class="pln-gantt-months">
            {ganttMonths.map((mo, i) => (
              <T as="p" en={mo.en} it={mo.it} fr={mo.fr} class="pln-gantt-month" style={`grid-column: ${2 + i * 2} / span 2;`} />
            ))}
          </div>
          <!-- Row 2: milestone labels, each right above its line -->
          <div class="pln-gantt-labels">
            {ganttMilestoneLabels.map((l) => (
              <T as="p" en={l.en} it={l.it} fr={l.fr} class="pln-gantt-mlabel" data-align={l.align} style={`grid-column: ${l.col};`} />
            ))}
          </div>
          <!-- Vertical lines (rows 3–8): today/decision, M1, M2, M3 -->
          {ganttMarkers.map((mk) => (
            <span class="pln-gantt-line" data-edge={mk.edge} data-today={mk.today ? 'true' : undefined} style={`grid-column: ${mk.col};`} aria-hidden="true"></span>
          ))}
          <!-- Rows 3–8: workstreams -->
          {ganttRows.map((row, ri) => (
            <div class="pln-gantt-row" data-solution={row.solution}>
              <T en={row.lane.en} it={row.lane.it} fr={row.lane.fr} class="pln-gantt-lane" style={`grid-row: ${3 + ri};`} />
              {row.segs.map((s) => (
                <div class="pln-gantt-seg" style={`grid-column: ${s.col}; grid-row: ${3 + ri};`}>
                  <T en={s.when.en} it={s.when.it} fr={s.when.fr} class="pln-gantt-when" />
                  <T en={s.en} it={s.it} fr={s.fr} class="pln-gantt-seg-t" />
                </div>
              ))}
            </div>
          ))}
          <!-- Row 9: key moments -->
          <T
            en="Key moments"
            it="Momenti chiave"
            fr="Temps forts"
            class="pln-gantt-lane pln-gantt-lane--moments"
            style="grid-row: 9;"
          />
          <ul class="pln-gantt-moments" style="grid-row: 9;">
            {ganttMoments.map((mm) => (
              <li class="pln-gantt-moment">
                <span class="pln-gantt-diamond" aria-hidden="true"></span>
                <T en={mm.name.en} it={mm.name.it} fr={mm.name.fr} class="pln-gantt-moment-t" />
                <T en={mm.date.en} it={mm.date.it} fr={mm.date.fr} class="pln-gantt-moment-d" />
              </li>
            ))}
          </ul>
          <!-- Phones only: the milestones as a list (the axis is hidden there) -->
          <T
            as="p"
            en="Milestones: M1 end of January 2027 · M2 22–25 March 2027 (Adobe Summit) · M3 end of June 2027"
            it="Milestone: M1 fine gennaio 2027 · M2 22–25 marzo 2027 (Adobe Summit) · M3 fine giugno 2027"
            fr="Jalons&nbsp;: J1 fin janvier 2027 · J2 22–25 mars 2027 (Adobe Summit) · J3 fin juin 2027"
            class="pln-gantt-mobile-ms"
          />
        </div>

        <T
          as="p"
          en="One view of the eight months. Each milestone is detailed on the next three slides."
          it="Gli otto mesi in un colpo d'occhio. Ogni milestone è dettagliata nelle tre slide successive."
          fr="Les huit mois d'un coup d'œil. Chaque jalon est détaillé sur les trois slides suivantes."
          class="mt-4 text-[var(--color-sabbia-300)]"
          style="font-size: 0.9rem; line-height: 1.5; max-width: none;"
          data-reveal
          data-reveal-delay="0.24"
          data-solution="detail"
        />
      </div>
    </Slide>

    <!-- ── SLIDES 2–4: Milestones (detail cut only) ───────────────── -->
    {milestones.map((m, mi) => (
      <Slide id={m.id} bg={m.bg} align="left" data-solution="detail">
        <div slot="backdrop" class="loom-bg"></div>
        <div class="atl-frame">
          <!-- Milestone position on the warp: node mi of 3 lit on the spine -->
          <div class="pln-mstone-warp" data-reveal aria-hidden="true">
            <span class="pln-mstone-spine"></span>
            <span class={`pln-mstone-node ${mi === 0 ? 'is-here' : ''}`}></span>
            <span class={`pln-mstone-node ${mi === 1 ? 'is-here' : ''}`}></span>
            <span class={`pln-mstone-node ${mi === 2 ? 'is-here' : ''}`}></span>
          </div>

          <T
            as="p"
            en={m.kicker.en}
            it={m.kicker.it}
            fr={m.kicker.fr}
            class="slide-eyebrow text-[var(--accent-primary)] mb-2"
            style="max-width: none;"
            data-reveal
          />
          <T
            as="h2"
            en={m.title.en}
            it={m.title.it}
            fr={m.title.fr}
            class="slide-title text-[var(--ink-primary)] mb-1.5"
            style="font-size: clamp(1.7rem, 2.6vw, 2.4rem); max-width: none;"
            data-reveal
            data-reveal-delay="0.08"
          />
          <T
            as="p"
            en={m.intro.en}
            it={m.intro.it}
            fr={m.intro.fr}
            class="text-[var(--color-sabbia-200)] mb-3"
            style="font-size: clamp(1rem, 1.2vw, 1.15rem); line-height: 1.5; max-width: none;"
            data-reveal
            data-reveal-delay="0.14"
          />

          <!-- Work threads woven off the milestone node -->
          <div class="w-full grid md:grid-cols-2 gap-2.5" data-reveal data-reveal-delay="0.2">
            {m.work.map((w, wi) => (
              <div class={`pln-work ${wi === m.work.length - 1 && m.work.length % 2 === 1 ? 'md:col-span-2' : ''}`}>
                <span class="pln-work-knot" aria-hidden="true"></span>
                <T
                  as="p"
                  en={w.en}
                  it={w.it}
                  fr={w.fr}
                  class="text-[var(--color-sabbia-200)] min-w-0"
                  style="font-size: 0.97rem; line-height: 1.5; max-width: none;"
                />
              </div>
            ))}
          </div>

          <div class="loom-quote w-full" data-reveal data-reveal-delay="0.28">
            <T
              as="p"
              en="Targets"
              it="Obiettivi"
              fr="Objectifs"
              class="atl-label mb-1"
              style="color: var(--accent-primary);"
            />
            <T
              as="p"
              en={m.targets.en}
              it={m.targets.it}
              fr={m.targets.fr}
              class="text-[var(--color-avorio)]"
              style="font-size: 0.98rem; line-height: 1.55; max-width: none;"
            />
          </div>
        </div>
      </Slide>
    ))}

    <!-- ── SLIDES 5–6: KPI scorecard, two families per slide ──────── -->
    {kpiSlides.map((ks) => (
      <Slide id={ks.id} bg="primary" align="left">
        <div slot="backdrop" class="loom-bg"></div>
        <div class="atl-frame">
          <T
            as="p"
            en={ks.label.en}
            it={ks.label.it}
            fr={ks.label.fr}
            class="atl-label mb-2"
            style="max-width: none;"
            data-reveal
          />
          <T
            as="h2"
            en={ks.title.en}
            it={ks.title.it}
            fr={ks.title.fr}
            class="slide-title text-[var(--ink-primary)] mb-4"
            style="font-size: clamp(1.6rem, 2.4vw, 2.25rem); max-width: none;"
            data-reveal
            data-reveal-delay="0.08"
          />

          <div class="pln-kpi-stack" data-reveal data-reveal-delay="0.16">
            {ks.families.map((f) => (
              <section class="loom-panel pln-kpi-fam">
                <div class="pln-kpi-head">
                  <T
                    as="h3"
                    en={f.name.en}
                    it={f.name.it}
                    fr={f.name.fr}
                    class="pln-kpi-name"
                  />
                  <T as="p" en={f.owner.en} it={f.owner.it} fr={f.owner.fr} class="atl-label pln-kpi-owner" />
                </div>
                <div class="pln-kpi-table" role="table">
                  <div class="pln-kpi-tr pln-kpi-tr--head" role="row">
                    <span class="pln-kpi-th" role="columnheader"><T en="Metric" it="Metrica" fr="Indicateur" /></span>
                    {kpiCols.map((c) => (
                      <span class="pln-kpi-th" role="columnheader"><T en={c.en} it={c.it} fr={c.fr} /></span>
                    ))}
                  </div>
                  {f.metrics.map((mt) => (
                    <div class="pln-kpi-tr" role="row">
                      <T en={mt.name.en} it={mt.name.it} fr={mt.name.fr} class="pln-kpi-metric" role="rowheader" />
                      {mt.m.map((v, vi) => (
                        <T en={v.en} it={v.it} fr={v.fr} class="pln-kpi-val" role="cell" data-col={`M${vi + 1}`} />
                      ))}
                    </div>
                  ))}
                </div>
              </section>
            ))}
          </div>
        </div>
      </Slide>
    ))}

  </DeckContainer>
</BaseLayout>

<!-- Plan section device: the 8-month plan rendered as a LOOM over time — a
     champagne warp spine through three milestone nodes on the cover, a real Gantt
     on the roadmap (six weft workstreams on a month axis, vertical milestone
     lines), and per-milestone target tables. Explicit rgba() only so the audit
     contrast parser measures real values (never oklab/color-mix). -->
<style>
  /* ── Cover: the warp with three woven milestone nodes ──────────── */
  #slide-cover .pln-cover-warp {
    position: relative;
    width: min(34rem, 68vw);
    height: 2px;
    margin: 2.2rem auto 0;
    display: flex; align-items: center; justify-content: space-between;
  }
  #slide-cover .pln-cover-spine {
    position: absolute; left: 0; right: 0; top: 50%; height: 2px;
    transform: translateY(-50%);
    background: linear-gradient(to right, rgba(201,169,106,0.15), rgba(201,169,106,0.85), rgba(201,169,106,0.15));
    border-radius: 2px;
  }
  #slide-cover .pln-cover-node {
    position: relative; z-index: 1;
    width: 0.85rem; height: 0.85rem; border-radius: 50%;
    background: var(--color-champagne);
    box-shadow: 0 0 0 4px rgba(18,16,12,0.9), 0 0 0 6px rgba(201,169,106,0.35);
  }

  /* ── Roadmap: the Gantt ────────────────────────────────────────────
     Grid = lane column + 16 half-month columns (Nov 2026 → Jun 2027).
     Rows: 1 months · 2 milestone labels · 3–8 workstreams · 9 key moments.
     Row gaps are carried by the items' own margins (not row-gap) so a gated
     row (Simulation off) collapses to nothing. */
  #slide-roadmap .pln-gantt {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 10.5rem) repeat(16, minmax(0, 1fr));
    grid-template-rows: auto auto repeat(6, auto) auto;
    column-gap: 0; row-gap: 0;
    width: 100%; min-width: 0;
  }
  #slide-roadmap .pln-gantt-months,
  #slide-roadmap .pln-gantt-labels,
  #slide-roadmap .pln-gantt-row { display: contents; }

  /* Row 1: month axis, a hairline under the whole track */
  #slide-roadmap .pln-gantt-month {
    grid-row: 1; min-width: 0;
    font-size: 0.8rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase;
    color: var(--color-sabbia-300); text-align: center; line-height: 1.3; max-width: none;
    padding-bottom: 0.35rem; margin-bottom: 0.45rem;
    border-bottom: 1px solid rgba(201,169,106,0.4);
    white-space: nowrap;
  }
  /* Row 2: milestone labels, each aligned to its line */
  #slide-roadmap .pln-gantt-mlabel {
    grid-row: 2; min-width: 0;
    font-size: 0.8rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase;
    color: var(--accent-primary); line-height: 1.3; max-width: none;
    margin-bottom: 0.3rem; white-space: nowrap;
  }
  #slide-roadmap .pln-gantt-mlabel[data-align="center"] { text-align: center; }
  #slide-roadmap .pln-gantt-mlabel[data-align="right"] { text-align: right; padding-right: 0.5rem; }

  /* Vertical lines: absolutely positioned grid children (they take no cell,
     so they never disturb the placement of the bars). */
  #slide-roadmap .pln-gantt-line {
    position: absolute; grid-row: 3 / 9; top: 0; bottom: 0; width: 2px;
    background: rgba(201,169,106,0.55); pointer-events: none; z-index: 2;
  }
  #slide-roadmap .pln-gantt-line[data-edge="start"] { left: 0; }
  #slide-roadmap .pln-gantt-line[data-edge="end"] { left: calc(100% - 2px); }
  #slide-roadmap .pln-gantt-line[data-today] {
    background: repeating-linear-gradient(to bottom, rgba(201,169,106,0.8) 0 5px, transparent 5px 9px);
  }

  /* Rows 3–8: lane names + bar segments */
  #slide-roadmap .pln-gantt-lane {
    grid-column: 1; min-width: 0;
    display: flex; align-items: center;
    color: var(--ink-primary); font-family: var(--font-display);
    font-weight: 600; font-size: 1rem; line-height: 1.2;
    padding: 0.28rem 0.9rem 0.28rem 0; max-width: none;
  }
  #slide-roadmap .pln-gantt-seg {
    position: relative; z-index: 1; min-width: 0;
    display: flex; align-items: center;
    margin: 0.22rem 2px;
    border: 1px solid rgba(201,169,106,0.35);
    background: rgba(201, 169, 106, 0.12);
    border-radius: 4px; padding: 0.34rem 0.6rem 0.34rem 0.9rem;
  }
  /* the weft thread: a champagne knot at the bar's left edge */
  #slide-roadmap .pln-gantt-seg::before {
    content: ''; position: absolute; left: 0.4rem; top: 50%;
    width: 0.3rem; height: 0.3rem; transform: translateY(-50%);
    border-radius: 50%; background: var(--color-champagne);
  }
  #slide-roadmap .pln-gantt-seg-t {
    color: var(--color-sabbia-200); font-size: 0.95rem; line-height: 1.35; max-width: none; min-width: 0;
  }
  /* Date range of a bar: read by screen readers, shown only on phones */
  #slide-roadmap .pln-gantt-when {
    position: absolute; left: -9999px; top: 0; width: 1px; height: 1px; overflow: hidden; white-space: nowrap;
    font-size: 0.8rem; /* below the audit's 16px text threshold: an off-screen SR label must not skew centre-of-mass */
  }

  /* Row 9: key moments */
  #slide-roadmap .pln-gantt-lane--moments {
    grid-row: 9; margin-top: 0.55rem;
    font-family: var(--font-body); font-size: 0.8rem; font-weight: 600;
    letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-sabbia-300);
  }
  #slide-roadmap .pln-gantt-moments {
    grid-column: 2 / -1; grid-row: 9; min-width: 0;
    display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.4rem 2rem;
    margin-top: 0.55rem; padding-left: 0.5rem; list-style: none;
  }
  #slide-roadmap .pln-gantt-moment { display: flex; align-items: baseline; gap: 0.5rem; min-width: 0; }
  #slide-roadmap .pln-gantt-diamond {
    flex: 0 0 auto; width: 0.5rem; height: 0.5rem; transform: rotate(45deg) translateY(-1px);
    background: var(--color-champagne);
  }
  #slide-roadmap .pln-gantt-moment-t { color: var(--color-avorio); font-size: 0.95rem; line-height: 1.4; font-weight: 600; max-width: none; }
  #slide-roadmap .pln-gantt-moment-d { color: var(--color-sabbia-300); font-size: 0.8rem; letter-spacing: 0.06em; text-transform: uppercase; font-weight: 600; max-width: none; }
  #slide-roadmap .pln-gantt-mobile-ms { display: none; }

  /* Phones and small tablets: the axis goes away; each workstream becomes a
     stack of labelled rows (date range + scope). No horizontal overflow. */
  @media (max-width: 768px) {
    #slide-roadmap .pln-gantt { display: block; }
    #slide-roadmap .pln-gantt-months, #slide-roadmap .pln-gantt-labels, #slide-roadmap .pln-gantt-line { display: none; }
    #slide-roadmap .pln-gantt-row { display: block; margin-bottom: 0.9rem; }
    #slide-roadmap .pln-gantt-lane { padding: 0 0 0.3rem; }
    #slide-roadmap .pln-gantt-seg { margin: 0 0 0.3rem; flex-direction: column; align-items: flex-start; gap: 0.1rem; }
    #slide-roadmap .pln-gantt-when {
      position: static; width: auto; height: auto; overflow: visible; white-space: normal;
      font-size: 0.8rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-sabbia-300);
    }
    #slide-roadmap .pln-gantt-mobile-ms {
      display: block; margin: 0.4rem 0 0.9rem; color: var(--color-sabbia-200);
      font-size: 0.95rem; line-height: 1.5; max-width: none;
    }
    #slide-roadmap .pln-gantt-lane--moments { margin-top: 0; }
    #slide-roadmap .pln-gantt-moments { flex-direction: column; gap: 0.35rem; padding-left: 0; margin-top: 0.2rem; }
  }

  /* ── Milestone slides: position on the warp + woven work threads ── */
  .pln-mstone-warp {
    position: relative; width: min(20rem, 46vw); height: 0.9rem;
    margin-bottom: 1.1rem;
    display: flex; align-items: center; gap: 0;
  }
  .pln-mstone-spine {
    position: absolute; left: 0; right: 0; top: 50%; height: 2px;
    transform: translateY(-50%);
    background: linear-gradient(to right, rgba(201,169,106,0.7), rgba(201,169,106,0.2));
    border-radius: 2px;
  }
  .pln-mstone-node {
    position: relative; z-index: 1;
    width: 0.5rem; height: 0.5rem; border-radius: 50%;
    margin-right: auto;
    background: rgba(201,169,106,0.3);
    box-shadow: 0 0 0 3px rgba(18,16,12,0.9);
  }
  .pln-mstone-node:last-child { margin-right: 0; }
  .pln-mstone-node.is-here {
    width: 0.85rem; height: 0.85rem;
    background: var(--color-champagne);
    box-shadow: 0 0 0 3px rgba(18,16,12,0.9), 0 0 0 5px rgba(201,169,106,0.4);
  }

  .pln-work {
    position: relative; display: flex; align-items: flex-start; gap: 0.7rem;
    min-width: 0;
    border: 1px solid var(--line-subtle);
    background: rgba(27, 24, 19, 0.6);
    border-radius: 6px; padding: 0.7rem 1rem 0.7rem 0.9rem;
  }
  .pln-work-knot {
    flex: 0 0 auto; margin-top: 0.42rem;
    width: 0.5rem; height: 0.5rem; border-radius: 50%;
    background: var(--color-champagne);
    box-shadow: 0 0 0 3px rgba(201,169,106,0.14);
  }

  /* ── KPI scorecard: one full-width panel per family, targets per milestone ── */
  .pln-kpi-stack { display: flex; flex-direction: column; gap: 0.75rem; width: 100%; }
  .pln-kpi-fam { padding: 1.1rem 1.4rem 1rem; }
  .pln-kpi-head {
    display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; flex-wrap: wrap;
    margin-bottom: 0.55rem;
  }
  .pln-kpi-name {
    min-width: 0; color: var(--ink-primary); font-weight: 600;
    font-family: var(--font-display); font-size: 1.15rem; line-height: 1.2; max-width: none;
  }
  .pln-kpi-owner { max-width: none; }
  .pln-kpi-table { display: flex; flex-direction: column; min-width: 0; }
  .pln-kpi-tr {
    display: grid; grid-template-columns: minmax(0, 1.7fr) repeat(3, minmax(0, 1fr));
    column-gap: 1rem; align-items: baseline;
    padding: 0.3rem 0; border-top: 1px solid rgba(201,169,106,0.18);
  }
  .pln-kpi-tr--head { border-top: 0; padding-top: 0; padding-bottom: 0.3rem; }
