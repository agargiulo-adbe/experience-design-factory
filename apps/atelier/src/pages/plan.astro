---
import BaseLayout from '../layouts/BaseLayout.astro';
import AtelierNavigation from '../components/AtelierNavigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import T from '@edf/core/blocks/i18n/T.astro';
import { href } from '@edf/core/utils/url.js';

const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;

// Plan as of September 2026 (decision requested by 30 September 2026).
// Three milestones, nine months (October 2026 → June 2027). Work and targets are
// declared in advance: the KPI story is "we measure ourselves".
//   M1 · by mid-December 2026 — Foundations
//   M2 · by Adobe Summit, Las Vegas, 22–25 March 2027 — Scale and open
//   M3 · by end of June 2027 — Enterprise and lighthouse
const milestones = [
  {
    id: 'slide-m1',
    bg: 'secondary' as const,
    kicker: {
      en: 'Milestone 1 · by mid-December 2026',
      it: 'Milestone 1 · entro metà dicembre 2026',
      fr: 'Jalon 1 · d’ici mi-décembre 2026',
    },
    title: { en: 'Foundations', it: 'Fondamenta', fr: 'Fondations' },
    intro: {
      en: 'From one person’s project to a pilot-ready platform.',
      it: 'Dal progetto di una persona a una piattaforma pronta per la fase pilota.',
      fr: 'Du projet d’une personne à une plateforme prête pour le pilote.',
    },
    work: [
      {
        en: 'Pilot: five to ten Adobe Italia BDR and AE build their first experience through the guided intake',
        it: 'Pilota: da cinque a dieci BDR e AE di Adobe Italia costruiscono la loro prima esperienza con il brief guidato',
        fr: 'Pilote&nbsp;: cinq à dix BDR et AE d’Adobe Italia construisent leur première expérience grâce au brief guidé',
      },
      {
        en: 'Adobe Context Layer v1: product catalog, positioning and limits, validated by Solution Consultants',
        it: 'Adobe Context Layer v1: catalogo prodotti, posizionamento e limiti, validati dai Solution Consultant',
        fr: 'Adobe Context Layer v1&nbsp;: catalogue produits, positionnement et limites, validés par les Solution Consultants',
      },
      {
        en: 'Multi-user hardening and CI quality gates',
        it: 'Irrobustimento multi-utente e quality gate in CI',
        fr: 'Durcissement multi-utilisateur et contrôles qualité en CI',
      },
      {
        en: 'Boardroom Quest walking skeleton; KPI telemetry baseline',
        it: 'Scheletro funzionante di Boardroom Quest; baseline della telemetria KPI',
        fr: 'Squelette fonctionnel de Boardroom Quest&nbsp;; baseline de télémétrie KPI',
      },
    ],
    targets: {
      en: 'Time to first experience under one week per pilot user · at least three experiences created by pilots · KPI baseline instrumented',
      it: 'Prima esperienza in meno di una settimana per ogni utente pilota · almeno tre esperienze create dagli utenti pilota · baseline KPI strumentata',
      fr: 'Première expérience en moins d’une semaine par utilisateur pilote · au moins trois expériences créées par les pilotes · baseline KPI instrumentée',
    },
  },
  {
    id: 'slide-m2',
    bg: 'primary' as const,
    kicker: {
      en: 'Milestone 2 · by Adobe Summit, Las Vegas, 22–25 March 2027',
      it: 'Milestone 2 · entro l’Adobe Summit, Las Vegas, 22–25 marzo 2027',
      fr: 'Jalon 2 · d’ici l’Adobe Summit, Las Vegas, 22–25 mars 2027',
    },
    title: { en: 'Scale and open', it: 'Scalare e aprire', fr: 'Monter en échelle et ouvrir' },
    intro: {
      en: 'The Atelier stops being one person’s tool, and takes its public stage at Summit.',
      it: 'L’Atelier smette di essere lo strumento di una persona sola e sale sul palco pubblico del Summit.',
      fr: 'L’Atelier cesse d’être l’outil d’une seule personne et prend la scène publique du Summit.',
    },
    work: [
      {
        en: 'Two to three Adobe partners co-build joint experiences, with hardened external access',
        it: 'Due o tre partner Adobe co-costruiscono esperienze congiunte, con accessi esterni rafforzati',
        fr: 'Deux à trois partenaires Adobe co-construisent des expériences conjointes, avec des accès externes durcis',
      },
      {
        en: 'Template gallery and self-service wizard; 25 to 40 active users',
        it: 'Galleria di template e procedura guidata self-service; da 25 a 40 utenti attivi',
        fr: 'Galerie de templates et assistant self-service&nbsp;; 25 à 40 utilisateurs actifs',
      },
      {
        en: 'Firefly and GenStudio demos embedded in live experiences',
        it: 'Demo di Firefly e GenStudio integrate nelle esperienze live',
        fr: 'Démos Firefly et GenStudio intégrées dans les expériences live',
      },
      {
        en: 'Boardroom Quest facilitated beta and first real workshop',
        it: 'Beta facilitata di Boardroom Quest e primo workshop reale',
        fr: 'Bêta accompagnée de Boardroom Quest et premier atelier réel',
      },
      {
        en: 'Hackathon day for Adobians, partners and clients, February 2027 · Adobe Summit 2027, Las Vegas, March 22–25: demo pod and speaking submission',
        it: 'Giornata hackathon per Adobiani, partner e clienti, febbraio 2027 · Adobe Summit 2027, Las Vegas, 22–25 marzo: demo pod e candidatura per uno speech',
        fr: 'Journée hackathon pour Adobiens, partenaires et clients, février 2027 · Adobe Summit 2027, Las Vegas, 22–25 mars&nbsp;: pod de démo et candidature pour une prise de parole',
      },
    ],
    targets: {
      en: 'Ten or more experiences used in active deals · at least two partner co-signed experiences · one Boardroom Quest workshop delivered with debrief · Summit demo pod confirmed',
      it: 'Dieci o più esperienze usate in trattative attive · almeno due esperienze co-firmate con i partner · un workshop Boardroom Quest erogato con debrief · demo pod al Summit confermato',
      fr: 'Dix expériences ou plus utilisées dans des deals actifs · au moins deux expériences co-signées avec des partenaires · un atelier Boardroom Quest animé avec débrief · pod de démo au Summit confirmé',
    },
  },
  {
    id: 'slide-m3',
    bg: 'secondary' as const,
    kicker: {
      en: 'Milestone 3 · by end of June 2027',
      it: 'Milestone 3 · entro fine giugno 2027',
      fr: 'Jalon 3 · d’ici fin juin 2027',
    },
    title: { en: 'Enterprise and lighthouse', it: 'Enterprise e faro', fr: 'Entreprise et vitrine' },
    intro: {
      en: 'The capability becomes infrastructure, with a first client to show for it.',
      it: 'La capability diventa infrastruttura, con un primo cliente da mostrare.',
      fr: 'La capacité devient infrastructure, avec un premier client à montrer.',
    },
    work: [
      {
        en: 'Federated SSO, audit logs, security review, data governance',
        it: 'SSO federato, audit log, security review, data governance',
        fr: 'SSO fédéré, journaux d’audit, revue de sécurité, gouvernance des données',
      },
      {
        en: 'Expansion beyond Italy across EMEA',
        it: 'Espansione oltre l’Italia, in tutta l’area EMEA',
        fr: 'Expansion au-delà de l’Italie, dans toute la zone EMEA',
      },
      {
        en: 'Boardroom Quest multiplayer and a second industry pack',
        it: 'Boardroom Quest multiplayer e un secondo pacchetto di settore',
        fr: 'Boardroom Quest multijoueur et un deuxième pack sectoriel',
      },
      {
        en: 'Lighthouse: the first partner co-built experience published for an EMEA client',
        it: 'Faro: la prima esperienza co-costruita con un partner pubblicata per un cliente EMEA',
        fr: 'Vitrine&nbsp;: la première expérience co-construite avec un partenaire publiée pour un client EMEA',
      },
    ],
    targets: {
      en: 'One hundred or more enabled users · one lighthouse experience live with an EMEA client · influenced pipeline tracked per deal · the project institutionalized with a team and a budget line',
      it: 'Cento o più utenti abilitati · un’esperienza faro attiva con un cliente EMEA · pipeline influenzata tracciata per trattativa · progetto istituzionalizzato con un team e una voce di budget',
      fr: 'Cent utilisateurs formés et outillés ou plus · une expérience vitrine en production chez un client EMEA · pipeline influencé suivi par deal · projet institutionnalisé avec une équipe et une ligne budgétaire',
    },
  },
];

// ── Roadmap as a Gantt: five workstreams (rows) on a time axis from October 2026
// to June 2027. The grid has 18 half-month columns (col 2 = 1–15 Oct … col 19 =
// 16–30 Jun) after the lane column, so bars can end exactly on the milestone
// lines: M1 mid-December (line 7), M2 end of March / Summit (line 14), M3 end of
// June (line 20). The Boardroom Quest row is gated by the `quest` audience toggle.
const ganttMonths = [
  { en: 'Oct 2026', it: 'ott 2026', fr: 'oct. 2026' },
  { en: 'Nov', it: 'nov', fr: 'nov.' },
  { en: 'Dec', it: 'dic', fr: 'déc.' },
  { en: 'Jan 2027', it: 'gen 2027', fr: 'janv. 2027' },
  { en: 'Feb', it: 'feb', fr: 'févr.' },
  { en: 'Mar', it: 'mar', fr: 'mars' },
  { en: 'Apr', it: 'apr', fr: 'avr.' },
  { en: 'May', it: 'mag', fr: 'mai' },
  { en: 'Jun', it: 'giu', fr: 'juin' },
];

// Milestone labels (row 2) sit right above their vertical line (rows 3–7).
const ganttMilestoneLabels = [
  { col: '1', align: 'right', en: 'Decision · 30 Sep', it: 'Decisione · 30 set', fr: 'Décision · 30 sept.' },
  { col: '5 / 9', align: 'center', en: 'M1 · mid-Dec', it: 'M1 · metà dic', fr: 'J1 · mi-déc.' },
  { col: '11 / 17', align: 'center', en: 'M2 · Summit · 22–25 Mar', it: 'M2 · Summit · 22–25 mar', fr: 'J2 · Summit · 22–25 mars' },
  { col: '17 / 20', align: 'right', en: 'M3 · end Jun', it: 'M3 · fine giu', fr: 'J3 · fin juin' },
];
// Vertical lines: [grid column, at its start or its end edge].
const ganttMarkers = [
  { col: '2', edge: 'start', today: true },
  { col: '7', edge: 'start', today: false },
  { col: '13', edge: 'end', today: false },
  { col: '19', edge: 'end', today: false },
];

const P1 = '2 / 7';   // Oct → mid-Dec
const P2 = '7 / 14';  // mid-Dec → end Mar
const P3 = '14 / 20'; // Apr → end Jun
const whenP1 = { en: 'Oct → mid-Dec', it: 'ott → metà dic', fr: 'oct. → mi-déc.' };
const whenP2 = { en: 'mid-Dec → Mar', it: 'metà dic → mar', fr: 'mi-déc. → mars' };
const whenP3 = { en: 'Apr → Jun', it: 'apr → giu', fr: 'avr. → juin' };

const ganttRows = [
  {
    lane: { en: 'Platform & trust', it: 'Piattaforma e fiducia', fr: 'Plateforme & confiance' },
    segs: [
      { col: P1, when: whenP1, en: 'Multi-user + CI gates', it: 'Multi-utente + gate CI', fr: 'Multi-utilisateur + CI' },
      { col: P2, when: whenP2, en: 'Hardened external access', it: 'Accessi esterni rafforzati', fr: 'Accès externes durcis' },
      { col: P3, when: whenP3, en: 'SSO, audit, governance', it: 'SSO, audit, governance', fr: 'SSO, audit, gouvernance' },
    ],
  },
  {
    lane: { en: 'Enablement', it: 'Abilitazione', fr: 'Montée en compétence' },
    segs: [
      { col: P1, when: whenP1, en: 'Pilot: 5–10 BDR/AE', it: 'Pilota: 5–10 BDR/AE', fr: 'Pilote&nbsp;: 5–10 BDR/AE' },
      { col: P2, when: whenP2, en: 'Gallery + wizard · 25–40 users', it: 'Galleria + procedura guidata · 25–40', fr: 'Galerie + assistant · 25–40' },
      { col: P3, when: whenP3, en: '100+ users · EMEA', it: '100+ utenti · EMEA', fr: '100+ utilisateurs · EMEA' },
    ],
  },
  {
    lane: { en: 'Ecosystem', it: 'Ecosistema', fr: 'Écosystème' },
    segs: [
      { col: P2, when: whenP2, en: '2–3 partners co-build', it: '2–3 partner co-costruiscono', fr: '2–3 partenaires co-construisent' },
      { col: P3, when: whenP3, en: 'Partner pipeline · lighthouse client', it: 'Pipeline partner · cliente faro', fr: 'Pipeline partenaires · client vitrine' },
    ],
  },
  {
    lane: { en: 'Boardroom Quest', it: 'Boardroom Quest', fr: 'Boardroom Quest' },
    solution: 'quest',
    segs: [
      { col: '3 / 7', when: { en: 'mid-Oct → mid-Dec', it: 'metà ott → metà dic', fr: 'mi-oct. → mi-déc.' },
        en: 'Walking skeleton', it: 'Scheletro funzionante', fr: 'Squelette fonctionnel' },
      { col: P2, when: whenP2, en: 'Beta + first workshop', it: 'Beta + primo workshop', fr: 'Bêta + premier atelier' },
      { col: P3, when: whenP3, en: 'Multiplayer · 2nd pack', it: 'Multiplayer · 2° pack', fr: 'Multijoueur · 2e pack' },
    ],
  },
  {
    lane: { en: 'Adobe Context Layer', it: 'Adobe Context Layer', fr: 'Adobe Context Layer' },
    segs: [
      { col: P1, when: whenP1, en: 'v1, SC-validated', it: 'v1, validato dai SC', fr: 'v1, validé par les SC' },
      { col: '7 / 20', when: { en: 'mid-Dec → Jun', it: 'metà dic → giu', fr: 'mi-déc. → juin' },
        en: 'Kept fresh, then governed', it: 'Aggiornato, poi sotto governance', fr: 'Tenu à jour, puis sous gouvernance' },
    ],
  },
];

// Key moments: three, in date order.
const ganttMoments = [
  { name: { en: 'Decision', it: 'Decisione', fr: 'Décision' },
    date: { en: '30 Sep 2026', it: '30 set 2026', fr: '30 sept. 2026' } },
  { name: { en: 'Hackathon day', it: 'Giornata hackathon', fr: 'Journée hackathon' },
    date: { en: 'Feb 2027', it: 'feb 2027', fr: 'févr. 2027' } },
  { name: { en: 'Adobe Summit, Las Vegas', it: 'Adobe Summit, Las Vegas', fr: 'Adobe Summit, Las Vegas' },
    date: { en: '22–25 Mar 2027', it: '22–25 mar 2027', fr: '22–25 mars 2027' } },
];

// ── KPI scorecard: four families, two or three metrics each, a target per
// milestone. Split over two slides (two families each) so type stays generous.
const kpiCols = [
  { en: 'M1 · mid-Dec 2026', it: 'M1 · metà dic 2026', fr: 'J1 · mi-déc. 2026' },
  { en: 'M2 · 22–25 Mar 2027', it: 'M2 · 22–25 mar 2027', fr: 'J2 · 22–25 mars 2027' },
  { en: 'M3 · end Jun 2027', it: 'M3 · fine giu 2027', fr: 'J3 · fin juin 2027' },
];
const ownerLead = { en: 'Owner: project lead', it: 'Responsabile: project lead', fr: 'Responsable&nbsp;: chef de projet' };
const ownerSponsor = { en: 'Owner: sponsor + project lead', it: 'Responsabili: sponsor + project lead', fr: 'Responsables&nbsp;: sponsor + chef de projet' };

type Tri = { en: string; it: string; fr: string };
type KpiFamily = { name: Tri; owner: Tri; metrics: Array<{ name: Tri; m: [Tri, Tri, Tri] }> };

const kpiSlides: Array<{ id: string; label: Tri; title: Tri; families: KpiFamily[] }> = [
  {
    id: 'slide-kpi',
    label: { en: 'KPI scorecard · families 1–2 of 4', it: 'Scorecard KPI · famiglie 1–2 di 4', fr: 'Tableau de bord KPI · familles 1–2 sur 4' },
    title: {
      en: 'Targets at every milestone: go-to-market and people',
      it: 'Obiettivi a ogni milestone: go-to-market e persone',
      fr: 'Des objectifs à chaque jalon&nbsp;: mise sur le marché et personnes',
    },
    families: [
      {
        name: { en: 'GTM velocity', it: 'Velocità GTM', fr: 'Vitesse de mise sur le marché' },
        owner: ownerSponsor,
        metrics: [
          { name: { en: 'Experiences in active deals', it: 'Esperienze in trattative attive', fr: 'Expériences dans des deals actifs' },
            m: [{ en: '3 (pilot)', it: '3 (pilota)', fr: '3 (pilote)' }, { en: '10+', it: '10+', fr: '10+' }, { en: '25+', it: '25+', fr: '25+' }] },
          { name: { en: 'Time to first experience', it: 'Tempo alla prima esperienza', fr: 'Temps jusqu’à la première expérience' },
            m: [{ en: '< 1 week', it: '< 1 settimana', fr: '< 1 semaine' }, { en: '< 2 days', it: '< 2 giorni', fr: '< 2 jours' }, { en: '< 1 day', it: '< 1 giorno', fr: '< 1 jour' }] },
          { name: { en: 'Win-rate and deal-size delta', it: 'Delta di tasso di chiusura e valore trattative', fr: 'Écart de taux de succès et de taille des deals' },
            m: [{ en: 'baseline', it: 'baseline', fr: 'référence' }, { en: 'measured', it: 'misurato', fr: 'mesuré' }, { en: 'reported', it: 'riportato', fr: 'rapporté' }] },
        ],
      },
      {
        name: { en: 'Workforce enablement', it: 'Abilitazione delle persone', fr: 'Montée en compétence' },
        owner: ownerLead,
        metrics: [
          { name: { en: 'Enabled Adobians', it: 'Adobiani abilitati', fr: 'Adobiens formés et outillés' },
            m: [{ en: '5–10', it: '5–10', fr: '5–10' }, { en: '25–40', it: '25–40', fr: '25–40' }, { en: '100+', it: '100+', fr: '100+' }] },
          { name: { en: 'Reach', it: 'Perimetro', fr: 'Périmètre' },
            m: [{ en: 'Adobe Italia', it: 'Adobe Italia', fr: 'Adobe Italia' }, { en: 'Italy + partners', it: 'Italia + partner', fr: 'Italie + partenaires' }, { en: 'EMEA', it: 'EMEA', fr: 'EMEA' }] },
          { name: { en: 'How people create', it: 'Come creano le persone', fr: 'Comment les gens créent' },
            m: [{ en: 'guided', it: 'in modo guidato', fr: 'accompagnés' }, { en: 'self-service', it: 'in autonomia', fr: 'en autonomie' }, { en: 'self-service', it: 'in autonomia', fr: 'en autonomie' }] },
        ],
      },
    ],
  },
  {
    id: 'slide-kpi-2',
    label: { en: 'KPI scorecard · families 3–4 of 4', it: 'Scorecard KPI · famiglie 3–4 di 4', fr: 'Tableau de bord KPI · familles 3–4 sur 4' },
    title: {
      en: 'Targets at every milestone: ecosystem and platform',
      it: 'Obiettivi a ogni milestone: ecosistema e piattaforma',
      fr: 'Des objectifs à chaque jalon&nbsp;: écosystème et plateforme',
    },
    families: [
      {
        name: { en: 'Ecosystem', it: 'Ecosistema', fr: 'Écosystème' },
        owner: ownerSponsor,
        metrics: [
          { name: { en: 'Partner co-signed experiences', it: 'Esperienze co-firmate con i partner', fr: 'Expériences co-signées avec des partenaires' },
            m: [{ en: '0', it: '0', fr: '0' }, { en: '2', it: '2', fr: '2' }, { en: '5', it: '5', fr: '5' }] },
          { name: { en: 'Partner-sourced pipeline', it: 'Pipeline generata dai partner', fr: 'Pipeline généré par les partenaires' },
            m: [{ en: '—', it: '—', fr: '—' }, { en: 'tracked', it: 'tracciata', fr: 'suivi' }, { en: 'reported', it: 'riportata', fr: 'rapporté' }] },
          { name: { en: 'Lighthouse client experience', it: 'Esperienza faro con un cliente', fr: 'Expérience vitrine chez un client' },
            m: [{ en: '—', it: '—', fr: '—' }, { en: 'scoped', it: 'definita', fr: 'cadrée' }, { en: 'live, EMEA', it: 'live, EMEA', fr: 'en production, EMEA' }] },
        ],
      },
      {
        name: { en: 'Platform health and trust', it: 'Salute e fiducia della piattaforma', fr: 'Santé et confiance de la plateforme' },
        owner: ownerLead,
        metrics: [
          { name: { en: 'Access and audit', it: 'Accessi e audit', fr: 'Accès et audit' },
            m: [{ en: 'multi-user', it: 'multi-utente', fr: 'multi-utilisateur' }, { en: 'external access hardened', it: 'accessi esterni rafforzati', fr: 'accès externes durcis' }, { en: 'SSO + audit logs', it: 'SSO + audit log', fr: 'SSO + journaux d’audit' }] },
          { name: { en: 'CI quality gates and accessibility AA', it: 'Quality gate in CI e accessibilità AA', fr: 'Contrôles qualité en CI et accessibilité AA' },
            m: [{ en: 'in place', it: 'attivi', fr: 'en place' }, { en: 'green on every release', it: 'verdi a ogni rilascio', fr: 'au vert à chaque livraison' }, { en: 'green + security review', it: 'verdi + security review', fr: 'au vert + revue de sécurité' }] },
          { name: { en: 'Compliance incidents', it: 'Incidenti di compliance', fr: 'Incidents de conformité' },
            m: [{ en: '0', it: '0', fr: '0' }, { en: '0', it: '0', fr: '0' }, { en: '0', it: '0', fr: '0' }] },
        ],
      },
    ],
  },
];
---
<BaseLayout
  title="The plan"
  description="The plan as of September 2026 — nine months, three milestones: foundations by mid-December, scale and open by Adobe Summit in March, enterprise and lighthouse by end of June, with a target at every milestone."
>
  <div class="fixed top-0 left-0 right-0 z-50">
    <AtelierNavigation currentPath={currentPath} base={base} />
  </div>

  <DeckContainer
    nextHref={href(base, '/asks')}
    prevHref={href(base, '/frontiers')}
  >

    <!-- ── SLIDE 0: Cover (detail cut only: the sponsor cut opens on the Gantt) ── -->
    <Slide id="slide-cover" bg="primary" align="center" data-solution="detail">
      <div slot="backdrop" class="loom-bg"></div>
      <p class="atl-cover-num mb-5" data-reveal data-display aria-hidden="true">05</p>
      <T
        as="p"
        en="The plan"
        it="Il piano"
        fr="Le plan"
        class="atl-cover-kicker mb-5"
        data-reveal
        data-reveal-delay="0.08"
      />
      <T
        as="h1"
        en="Nine months, three milestones."
        it="Nove mesi, tre milestone."
        fr="Neuf mois, trois jalons."
        class="slide-title text-center text-[var(--ink-primary)] mx-auto max-w-5xl mb-5"
        style="font-size: clamp(2.2rem, 4vw, 3.9rem);"
        data-reveal
        data-reveal-delay="0.15"
      />
      <T
        as="p"
        en="Each one ends with a number you can check."
        it="Ognuna si chiude con un numero verificabile."
        fr="Chacun se termine sur un chiffre vérifiable."
        class="atl-lede"
        data-reveal
        data-reveal-delay="0.22"
      />

      <!-- Woven timeline warp: three milestone nodes on a champagne spine -->
      <div class="pln-cover-warp" data-reveal data-reveal-delay="0.3" aria-hidden="true">
        <span class="pln-cover-spine"></span>
        <span class="pln-cover-node"></span>
        <span class="pln-cover-node"></span>
        <span class="pln-cover-node"></span>
      </div>

      <div class="flex items-center justify-center flex-wrap gap-x-4 gap-y-2 mt-4" data-reveal data-reveal-delay="0.34">
        <T
          en="Foundations"
          it="Fondamenta"
          fr="Fondations"
          class="font-semibold tracking-widest uppercase text-[var(--color-sabbia-300)]"
          style="font-size: 0.9rem;"
        />
        <span class="w-1 h-1 rounded-full bg-[var(--accent-primary)]" aria-hidden="true"></span>
        <T
          en="Scale and open"
          it="Scalare e aprire"
          fr="Monter en échelle et ouvrir"
          class="font-semibold tracking-widest uppercase text-[var(--color-sabbia-300)]"
          style="font-size: 0.9rem;"
        />
        <span class="w-1 h-1 rounded-full bg-[var(--accent-primary)]" aria-hidden="true"></span>
        <T
          en="Enterprise and lighthouse"
          it="Enterprise e faro"
          fr="Entreprise et vitrine"
          class="font-semibold tracking-widest uppercase text-[var(--color-sabbia-300)]"
          style="font-size: 0.9rem;"
        />
      </div>

      <T
        as="p"
        en="Plan as of September 2026"
        it="Piano aggiornato a settembre 2026"
        fr="Plan à jour en septembre 2026"
        class="atl-label text-center mt-6"
        data-reveal
        data-reveal-delay="0.4"
      />
    </Slide>

    <!-- ── SLIDE 1: Roadmap — a Gantt over the nine months ─────────── -->
    <Slide id="slide-roadmap" bg="secondary" align="left">
      <div slot="backdrop" class="loom-bg-soft"></div>
      <div class="atl-frame">
        <T
          as="h2"
          en="The roadmap, October 2026 to June 2027"
          it="La roadmap, da ottobre 2026 a giugno 2027"
          fr="La feuille de route, d’octobre 2026 à juin 2027"
          class="slide-title text-[var(--ink-primary)] mb-4"
          style="font-size: clamp(1.6rem, 2.4vw, 2.25rem); max-width: none;"
          data-reveal
        />

        <div class="pln-gantt" data-reveal data-reveal-delay="0.12">
          <!-- Row 1: the month axis -->
          <div class="pln-gantt-months">
            {ganttMonths.map((mo, i) => (
              <T as="p" en={mo.en} it={mo.it} fr={mo.fr} class="pln-gantt-month" style={`grid-column: ${2 + i * 2} / span 2;`} />
            ))}
          </div>
          <!-- Row 2: milestone labels, each right above its line -->
          <div class="pln-gantt-labels">
            {ganttMilestoneLabels.map((l) => (
              <T as="p" en={l.en} it={l.it} fr={l.fr} class="pln-gantt-mlabel" data-align={l.align} style={`grid-column: ${l.col};`} />
            ))}
          </div>
          <!-- Vertical lines (rows 3–7): today/decision, M1, M2, M3 -->
          {ganttMarkers.map((mk) => (
            <span class="pln-gantt-line" data-edge={mk.edge} data-today={mk.today ? 'true' : undefined} style={`grid-column: ${mk.col};`} aria-hidden="true"></span>
          ))}
          <!-- Rows 3–7: workstreams -->
          {ganttRows.map((row, ri) => (
            <div class="pln-gantt-row" data-solution={row.solution}>
              <T en={row.lane.en} it={row.lane.it} fr={row.lane.fr} class="pln-gantt-lane" style={`grid-row: ${3 + ri};`} />
              {row.segs.map((s) => (
                <div class="pln-gantt-seg" style={`grid-column: ${s.col}; grid-row: ${3 + ri};`}>
                  <T en={s.when.en} it={s.when.it} fr={s.when.fr} class="pln-gantt-when" />
                  <T en={s.en} it={s.it} fr={s.fr} class="pln-gantt-seg-t" />
                </div>
              ))}
            </div>
          ))}
          <!-- Row 8: key moments -->
          <T
            en="Key moments"
            it="Momenti chiave"
            fr="Temps forts"
            class="pln-gantt-lane pln-gantt-lane--moments"
            style="grid-row: 8;"
          />
          <ul class="pln-gantt-moments" style="grid-row: 8;">
            {ganttMoments.map((mm) => (
              <li class="pln-gantt-moment">
                <span class="pln-gantt-diamond" aria-hidden="true"></span>
                <T en={mm.name.en} it={mm.name.it} fr={mm.name.fr} class="pln-gantt-moment-t" />
                <T en={mm.date.en} it={mm.date.it} fr={mm.date.fr} class="pln-gantt-moment-d" />
              </li>
            ))}
          </ul>
          <!-- Phones only: the milestones as a list (the axis is hidden there) -->
          <T
            as="p"
            en="Milestones: M1 mid-December 2026 · M2 22–25 March 2027 (Adobe Summit) · M3 end of June 2027"
            it="Milestone: M1 metà dicembre 2026 · M2 22–25 marzo 2027 (Adobe Summit) · M3 fine giugno 2027"
            fr="Jalons&nbsp;: J1 mi-décembre 2026 · J2 22–25 mars 2027 (Adobe Summit) · J3 fin juin 2027"
            class="pln-gantt-mobile-ms"
          />
        </div>

        <T
          as="p"
          en="One view of the nine months. Each milestone is detailed on the next three slides."
          it="I nove mesi in un colpo d'occhio. Ogni milestone è dettagliata nelle tre slide successive."
          fr="Les neuf mois d'un coup d'œil. Chaque jalon est détaillé sur les trois slides suivantes."
          class="mt-4 text-[var(--color-sabbia-300)]"
          style="font-size: 0.9rem; line-height: 1.5; max-width: none;"
          data-reveal
          data-reveal-delay="0.24"
          data-solution="detail"
        />
      </div>
    </Slide>

    <!-- ── SLIDES 2–4: Milestones (detail cut only) ───────────────── -->
    {milestones.map((m, mi) => (
      <Slide id={m.id} bg={m.bg} align="left" data-solution="detail">
        <div slot="backdrop" class="loom-bg"></div>
        <div class="atl-frame">
          <!-- Milestone position on the warp: node mi of 3 lit on the spine -->
          <div class="pln-mstone-warp" data-reveal aria-hidden="true">
            <span class="pln-mstone-spine"></span>
            <span class={`pln-mstone-node ${mi === 0 ? 'is-here' : ''}`}></span>
            <span class={`pln-mstone-node ${mi === 1 ? 'is-here' : ''}`}></span>
            <span class={`pln-mstone-node ${mi === 2 ? 'is-here' : ''}`}></span>
          </div>

          <T
            as="p"
            en={m.kicker.en}
            it={m.kicker.it}
            fr={m.kicker.fr}
            class="slide-eyebrow text-[var(--accent-primary)] mb-2"
            style="max-width: none;"
            data-reveal
          />
          <T
            as="h2"
            en={m.title.en}
            it={m.title.it}
            fr={m.title.fr}
            class="slide-title text-[var(--ink-primary)] mb-1.5"
            style="font-size: clamp(1.7rem, 2.6vw, 2.4rem); max-width: none;"
            data-reveal
            data-reveal-delay="0.08"
          />
          <T
            as="p"
            en={m.intro.en}
            it={m.intro.it}
            fr={m.intro.fr}
            class="text-[var(--color-sabbia-200)] mb-3"
            style="font-size: clamp(1rem, 1.2vw, 1.15rem); line-height: 1.5; max-width: none;"
            data-reveal
            data-reveal-delay="0.14"
          />

          <!-- Work threads woven off the milestone node -->
          <div class="w-full grid md:grid-cols-2 gap-2.5" data-reveal data-reveal-delay="0.2">
            {m.work.map((w, wi) => (
              <div class={`pln-work ${wi === m.work.length - 1 && m.work.length % 2 === 1 ? 'md:col-span-2' : ''}`}>
                <span class="pln-work-knot" aria-hidden="true"></span>
                <T
                  as="p"
                  en={w.en}
                  it={w.it}
                  fr={w.fr}
                  class="text-[var(--color-sabbia-200)] min-w-0"
                  style="font-size: 0.97rem; line-height: 1.5; max-width: none;"
                />
              </div>
            ))}
          </div>

          <div class="loom-quote w-full" data-reveal data-reveal-delay="0.28">
            <T
              as="p"
              en="Targets"
              it="Obiettivi"
              fr="Objectifs"
              class="atl-label mb-1"
              style="color: var(--accent-primary);"
            />
            <T
              as="p"
              en={m.targets.en}
              it={m.targets.it}
              fr={m.targets.fr}
              class="text-[var(--color-avorio)]"
              style="font-size: 0.98rem; line-height: 1.55; max-width: none;"
            />
          </div>
        </div>
      </Slide>
    ))}

    <!-- ── SLIDES 5–6: KPI scorecard, two families per slide ──────── -->
    {kpiSlides.map((ks) => (
      <Slide id={ks.id} bg="primary" align="left">
        <div slot="backdrop" class="loom-bg"></div>
        <div class="atl-frame">
          <T
            as="p"
            en={ks.label.en}
            it={ks.label.it}
            fr={ks.label.fr}
            class="atl-label mb-2"
            style="max-width: none;"
            data-reveal
          />
          <T
            as="h2"
            en={ks.title.en}
            it={ks.title.it}
            fr={ks.title.fr}
            class="slide-title text-[var(--ink-primary)] mb-4"
            style="font-size: clamp(1.6rem, 2.4vw, 2.25rem); max-width: none;"
            data-reveal
            data-reveal-delay="0.08"
          />

          <div class="pln-kpi-stack" data-reveal data-reveal-delay="0.16">
            {ks.families.map((f) => (
              <section class="loom-panel pln-kpi-fam">
                <div class="pln-kpi-head">
                  <T
                    as="h3"
                    en={f.name.en}
                    it={f.name.it}
                    fr={f.name.fr}
                    class="pln-kpi-name"
                  />
                  <T as="p" en={f.owner.en} it={f.owner.it} fr={f.owner.fr} class="atl-label pln-kpi-owner" />
                </div>
                <div class="pln-kpi-table" role="table">
                  <div class="pln-kpi-tr pln-kpi-tr--head" role="row">
                    <span class="pln-kpi-th" role="columnheader"><T en="Metric" it="Metrica" fr="Indicateur" /></span>
                    {kpiCols.map((c) => (
                      <span class="pln-kpi-th" role="columnheader"><T en={c.en} it={c.it} fr={c.fr} /></span>
                    ))}
                  </div>
                  {f.metrics.map((mt) => (
                    <div class="pln-kpi-tr" role="row">
                      <T en={mt.name.en} it={mt.name.it} fr={mt.name.fr} class="pln-kpi-metric" role="rowheader" />
                      {mt.m.map((v, vi) => (
                        <T en={v.en} it={v.it} fr={v.fr} class="pln-kpi-val" role="cell" data-col={`M${vi + 1}`} />
                      ))}
                    </div>
                  ))}
                </div>
              </section>
            ))}
          </div>
        </div>
      </Slide>
    ))}

  </DeckContainer>
</BaseLayout>

<!-- Plan section device: the 9-month plan rendered as a LOOM over time — a
     champagne warp spine through three milestone nodes on the cover, a real Gantt
     on the roadmap (five weft workstreams on a month axis, vertical milestone
     lines), and per-milestone target tables. Explicit rgba() only so the audit
     contrast parser measures real values (never oklab/color-mix). -->
<style>
  /* ── Cover: the warp with three woven milestone nodes ──────────── */
  #slide-cover .pln-cover-warp {
    position: relative;
    width: min(34rem, 68vw);
    height: 2px;
    margin: 2.2rem auto 0;
    display: flex; align-items: center; justify-content: space-between;
  }
  #slide-cover .pln-cover-spine {
    position: absolute; left: 0; right: 0; top: 50%; height: 2px;
    transform: translateY(-50%);
    background: linear-gradient(to right, rgba(201,169,106,0.15), rgba(201,169,106,0.85), rgba(201,169,106,0.15));
    border-radius: 2px;
  }
  #slide-cover .pln-cover-node {
    position: relative; z-index: 1;
    width: 0.85rem; height: 0.85rem; border-radius: 50%;
    background: var(--color-champagne);
    box-shadow: 0 0 0 4px rgba(18,16,12,0.9), 0 0 0 6px rgba(201,169,106,0.35);
  }

  /* ── Roadmap: the Gantt ────────────────────────────────────────────
     Grid = lane column + 18 half-month columns (Oct 2026 → Jun 2027).
     Rows: 1 months · 2 milestone labels · 3–7 workstreams · 8 key moments.
     Row gaps are carried by the items' own margins (not row-gap) so a gated
     row (Boardroom Quest off) collapses to nothing. */
  #slide-roadmap .pln-gantt {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 10.5rem) repeat(18, minmax(0, 1fr));
    grid-template-rows: auto auto repeat(5, auto) auto;
    column-gap: 0; row-gap: 0;
    width: 100%; min-width: 0;
  }
  #slide-roadmap .pln-gantt-months,
  #slide-roadmap .pln-gantt-labels,
  #slide-roadmap .pln-gantt-row { display: contents; }

  /* Row 1: month axis, a hairline under the whole track */
  #slide-roadmap .pln-gantt-month {
    grid-row: 1; min-width: 0;
    font-size: 0.8rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase;
    color: var(--color-sabbia-300); text-align: center; line-height: 1.3; max-width: none;
    padding-bottom: 0.35rem; margin-bottom: 0.45rem;
    border-bottom: 1px solid rgba(201,169,106,0.4);
    white-space: nowrap;
  }
  /* Row 2: milestone labels, each aligned to its line */
  #slide-roadmap .pln-gantt-mlabel {
    grid-row: 2; min-width: 0;
    font-size: 0.8rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase;
    color: var(--accent-primary); line-height: 1.3; max-width: none;
    margin-bottom: 0.3rem; white-space: nowrap;
  }
  #slide-roadmap .pln-gantt-mlabel[data-align="center"] { text-align: center; }
  #slide-roadmap .pln-gantt-mlabel[data-align="right"] { text-align: right; padding-right: 0.5rem; }

  /* Vertical lines: absolutely positioned grid children (they take no cell,
     so they never disturb the placement of the bars). */
  #slide-roadmap .pln-gantt-line {
    position: absolute; grid-row: 3 / 8; top: 0; bottom: 0; width: 2px;
    background: rgba(201,169,106,0.55); pointer-events: none; z-index: 2;
  }
  #slide-roadmap .pln-gantt-line[data-edge="start"] { left: 0; }
  #slide-roadmap .pln-gantt-line[data-edge="end"] { left: calc(100% - 2px); }
  #slide-roadmap .pln-gantt-line[data-today] {
    background: repeating-linear-gradient(to bottom, rgba(201,169,106,0.8) 0 5px, transparent 5px 9px);
  }

  /* Rows 3–7: lane names + bar segments */
  #slide-roadmap .pln-gantt-lane {
    grid-column: 1; min-width: 0;
    display: flex; align-items: center;
    color: var(--ink-primary); font-family: var(--font-display);
    font-weight: 600; font-size: 1rem; line-height: 1.2;
    padding: 0.28rem 0.9rem 0.28rem 0; max-width: none;
  }
  #slide-roadmap .pln-gantt-seg {
    position: relative; z-index: 1; min-width: 0;
    display: flex; align-items: center;
    margin: 0.28rem 2px;
    border: 1px solid rgba(201,169,106,0.35);
    background: rgba(201, 169, 106, 0.12);
    border-radius: 4px; padding: 0.42rem 0.7rem 0.42rem 0.95rem;
  }
  /* the weft thread: a champagne knot at the bar's left edge */
  #slide-roadmap .pln-gantt-seg::before {
    content: ''; position: absolute; left: 0.4rem; top: 50%;
    width: 0.3rem; height: 0.3rem; transform: translateY(-50%);
    border-radius: 50%; background: var(--color-champagne);
  }
  #slide-roadmap .pln-gantt-seg-t {
    color: var(--color-sabbia-200); font-size: 0.95rem; line-height: 1.35; max-width: none; min-width: 0;
  }
  /* Date range of a bar: read by screen readers, shown only on phones */
  #slide-roadmap .pln-gantt-when {
    position: absolute; left: -9999px; top: 0; width: 1px; height: 1px; overflow: hidden; white-space: nowrap;
    font-size: 0.8rem; /* below the audit's 16px text threshold: an off-screen SR label must not skew centre-of-mass */
  }

  /* Row 8: key moments */
  #slide-roadmap .pln-gantt-lane--moments {
    grid-row: 8; margin-top: 0.55rem;
    font-family: var(--font-body); font-size: 0.8rem; font-weight: 600;
    letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-sabbia-300);
  }
  #slide-roadmap .pln-gantt-moments {
    grid-column: 2 / -1; grid-row: 8; min-width: 0;
    display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.4rem 2rem;
    margin-top: 0.55rem; padding-left: 0.5rem; list-style: none;
  }
  #slide-roadmap .pln-gantt-moment { display: flex; align-items: baseline; gap: 0.5rem; min-width: 0; }
  #slide-roadmap .pln-gantt-diamond {
    flex: 0 0 auto; width: 0.5rem; height: 0.5rem; transform: rotate(45deg) translateY(-1px);
    background: var(--color-champagne);
  }
  #slide-roadmap .pln-gantt-moment-t { color: var(--color-avorio); font-size: 0.95rem; line-height: 1.4; font-weight: 600; max-width: none; }
  #slide-roadmap .pln-gantt-moment-d { color: var(--color-sabbia-300); font-size: 0.8rem; letter-spacing: 0.06em; text-transform: uppercase; font-weight: 600; max-width: none; }
  #slide-roadmap .pln-gantt-mobile-ms { display: none; }

  /* Phones and small tablets: the axis goes away; each workstream becomes a
     stack of labelled rows (date range + scope). No horizontal overflow. */
  @media (max-width: 768px) {
    #slide-roadmap .pln-gantt { display: block; }
    #slide-roadmap .pln-gantt-months, #slide-roadmap .pln-gantt-labels, #slide-roadmap .pln-gantt-line { display: none; }
    #slide-roadmap .pln-gantt-row { display: block; margin-bottom: 0.9rem; }
    #slide-roadmap .pln-gantt-lane { padding: 0 0 0.3rem; }
    #slide-roadmap .pln-gantt-seg { margin: 0 0 0.3rem; flex-direction: column; align-items: flex-start; gap: 0.1rem; }
    #slide-roadmap .pln-gantt-when {
      position: static; width: auto; height: auto; overflow: visible; white-space: normal;
      font-size: 0.8rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-sabbia-300);
    }
    #slide-roadmap .pln-gantt-mobile-ms {
      display: block; margin: 0.4rem 0 0.9rem; color: var(--color-sabbia-200);
      font-size: 0.95rem; line-height: 1.5; max-width: none;
    }
    #slide-roadmap .pln-gantt-lane--moments { margin-top: 0; }
    #slide-roadmap .pln-gantt-moments { flex-direction: column; gap: 0.35rem; padding-left: 0; margin-top: 0.2rem; }
  }

  /* ── Milestone slides: position on the warp + woven work threads ── */
  .pln-mstone-warp {
    position: relative; width: min(20rem, 46vw); height: 0.9rem;
    margin-bottom: 1.1rem;
    display: flex; align-items: center; gap: 0;
  }
  .pln-mstone-spine {
    position: absolute; left: 0; right: 0; top: 50%; height: 2px;
    transform: translateY(-50%);
    background: linear-gradient(to right, rgba(201,169,106,0.7), rgba(201,169,106,0.2));
    border-radius: 2px;
  }
  .pln-mstone-node {
    position: relative; z-index: 1;
    width: 0.5rem; height: 0.5rem; border-radius: 50%;
    margin-right: auto;
    background: rgba(201,169,106,0.3);
    box-shadow: 0 0 0 3px rgba(18,16,12,0.9);
  }
  .pln-mstone-node:last-child { margin-right: 0; }
  .pln-mstone-node.is-here {
    width: 0.85rem; height: 0.85rem;
    background: var(--color-champagne);
    box-shadow: 0 0 0 3px rgba(18,16,12,0.9), 0 0 0 5px rgba(201,169,106,0.4);
  }

  .pln-work {
    position: relative; display: flex; align-items: flex-start; gap: 0.7rem;
    min-width: 0;
    border: 1px solid var(--line-subtle);
    background: rgba(27, 24, 19, 0.6);
    border-radius: 6px; padding: 0.7rem 1rem 0.7rem 0.9rem;
  }
  .pln-work-knot {
    flex: 0 0 auto; margin-top: 0.42rem;
    width: 0.5rem; height: 0.5rem; border-radius: 50%;
    background: var(--color-champagne);
    box-shadow: 0 0 0 3px rgba(201,169,106,0.14);
  }

  /* ── KPI scorecard: one full-width panel per family, targets per milestone ── */
  .pln-kpi-stack { display: flex; flex-direction: column; gap: 0.75rem; width: 100%; }
  .pln-kpi-fam { padding: 1.1rem 1.4rem 1rem; }
  .pln-kpi-head {
    display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; flex-wrap: wrap;
    margin-bottom: 0.55rem;
  }
  .pln-kpi-name {
    min-width: 0; color: var(--ink-primary); font-weight: 600;
    font-family: var(--font-display); font-size: 1.15rem; line-height: 1.2; max-width: none;
  }
  .pln-kpi-owner { max-width: none; }
  .pln-kpi-table { display: flex; flex-direction: column; min-width: 0; }
  .pln-kpi-tr {
    display: grid; grid-template-columns: minmax(0, 1.7fr) repeat(3, minmax(0, 1fr));
    column-gap: 1rem; align-items: baseline;
    padding: 0.3rem 0; border-top: 1px solid rgba(201,169,106,0.18);
  }
  .pln-kpi-tr--head { border-top: 0; padding-top: 0; padding-bottom: 0.3rem; }
  .pln-kpi-th {
    min-width: 0; font-size: 0.8rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase;
    color: var(--color-sabbia-300); line-height: 1.3;
  }
  .pln-kpi-metric { min-width: 0; color: var(--color-sabbia-200); font-size: 0.95rem; line-height: 1.45; max-width: none; }
  .pln-kpi-val {
    min-width: 0; color: var(--color-avorio); font-size: 1rem; line-height: 1.45; font-weight: 600;
    font-variant-numeric: tabular-nums; max-width: none;
  }
  @media (max-width: 768px) {
    .pln-kpi-tr { grid-template-columns: minmax(0, 1fr); row-gap: 0.15rem; }
    .pln-kpi-tr--head { display: none; }
    .pln-kpi-val::before { content: attr(data-col) ' · '; color: var(--color-sabbia-300); font-size: 0.8rem; letter-spacing: 0.06em; }
  }
</style>
