---
import BaseLayout from '../layouts/BaseLayout.astro';
import AdminConsole from '@edf/core/blocks/admin/AdminConsole.astro';
import { href } from '@edf/core/utils/url.js';

const base = import.meta.env.BASE_URL;
const SUPABASE_URL = import.meta.env.PUBLIC_SUPABASE_URL ?? '';
const SUPABASE_ANON_KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY ?? '';

interface SlideEntry { id: string; label: string; }
interface PageEntry { slug: string; label: string; slides: SlideEntry[]; }

const PAGE_REGISTRY: PageEntry[] = [
  { slug: 'method', label: 'The method (01)', slides: [
    { id: 'slide-cover',      label: 'Cover — Built in the open' },
    { id: 'slide-genesis',    label: 'Timeline — eight experiences' },
    { id: 'slide-method',     label: 'The working method (4 steps)' },
    { id: 'slide-compliance', label: 'Compliant by construction (evidence)' },
  ]},
  { slug: 'capability', label: 'The capability (02)', slides: [
    { id: 'slide-cover',       label: 'Cover — One engine. Any story.' },
    { id: 'slide-anatomy',     label: 'Anatomy diagram (skins/engine/foundation)' },
    { id: 'slide-adobe-stack', label: 'Made with Adobe (Firefly Image/Video, Photoshop API, credit)' },
    { id: 'slide-toggle-demo', label: 'Live solution-toggle demo' },
    { id: 'slide-console',     label: 'Admin Console features (4 controls)' },
    { id: 'slide-proof-telemetry', label: 'Proof — this deck is watching itself (live telemetry)' },
    { id: 'slide-proof-mcp',       label: 'Proof — the engine from inside Claude (MCP transcript)' },
  ]},
  { slug: 'gap', label: 'The gap (03)', slides: [
    { id: 'slide-cover',     label: 'Cover — What buyers want now (detail cut)' },
    { id: 'slide-buyers',    label: 'Four numbers: what buyers want now (Gartner, 6sense, TrustRadius)' },
    { id: 'slide-market',    label: 'Where the category moved (Consensus, Seismic/Highspot, detail cut)' },
    { id: 'slide-adobe',     label: "Adobe's own move — CX Enterprise agents, skills, MCP endpoints" },
    { id: 'slide-precedent', label: 'Precedents that industrialised the pattern (SAP, Moderna, detail cut)' },
  ]},
  { slug: 'moves', label: 'The three moves (04)', slides: [
    { id: 'slide-cover',      label: 'Cover — From pitch to buying surface (detail cut)' },
    { id: 'slide-move-1',     label: 'Move 01 — Alive between meetings (Brand Concierge, telemetry)' },
    { id: 'slide-move-2',     label: 'Move 02 — One experience per opportunity, in 24 hours' },
    { id: 'slide-move-3',     label: 'Move 03 — Provenance as compliance (C2PA)' },
    { id: 'slide-simulation', label: 'Move 04 — The simulation: buying surface as a boardroom game' },
  ]},
  { slug: 'plan', label: 'The plan (05)', slides: [
    { id: 'slide-cover',   label: 'Cover — Eight months, three milestones' },
    { id: 'slide-roadmap', label: 'Roadmap — Gantt Nov 2026 → Jun 2027 (6 workstreams)' },
    { id: 'slide-m1',      label: 'M1 Foundations (end Jan 2027)' },
    { id: 'slide-m2',      label: 'M2 Scale & open (Adobe Summit, 22–25 Mar 2027)' },
    { id: 'slide-m3',      label: 'M3 Enterprise & lighthouse (end Jun 2027)' },
    { id: 'slide-kpi',     label: 'KPI 1/2 (buying surface, speed)' },
    { id: 'slide-kpi-2',   label: 'KPI 2/2 (trust, people & ecosystem)' },
  ]},
  { slug: 'asks', label: 'What it takes (06)', slides: [
    { id: 'slide-cover',     label: 'Cover — A small stack of asks' },
    { id: 'slide-resources', label: 'Resources (relative envelope)' },
    { id: 'slide-sponsor',   label: 'What we ask you to decide (by 31 Oct 2026)' },
  ]},
  { slug: 'closing', label: 'Closing (07)', slides: [
    { id: 'slide-thesis', label: 'What you saw (callback)' },
    { id: 'slide-next',   label: 'Green-light the pilot + share links' },
  ]},
];

interface SolutionEntry {
  id: string; name: string; shortName: string;
  pillar: string; description: string; appearsIn: string[];
}

const SOLUTIONS: SolutionEntry[] = [
  {
    id: 'asks',
    name: 'What it takes (sponsorship section)',
    shortName: 'Asks',
    pillar: 'audience',
    description: 'The sponsorship section: resources as proportions and the three-item decision. Turn off for audiences that should not see the asks.',
    appearsIn: ['What it takes'],
  },
  {
    id: 'simulation',
    name: 'The simulation (buying surface as a game)',
    shortName: 'Simulation',
    pillar: 'audience',
    description: 'The simulation slide in The three moves and its lane in the Gantt. Turn off for audiences that should see the moves without the game.',
    appearsIn: ['The three moves', 'The plan'],
  },
  {
    id: 'detail',
    name: 'Detail slides (full cut)',
    shortName: 'Detail',
    pillar: 'audience',
    description: 'Section covers, milestone detail, market evidence, compliance and the closing recap. Turn off for the ~16-slide sponsor cut.',
    appearsIn: ['The method', 'The capability', 'The gap', 'The three moves', 'The plan', 'What it takes', 'Closing'],
  },
];

const PILLAR_LABELS: Record<string, string> = {
  audience: 'Audience gating',
};
const PILLAR_ORDER = ['audience'];
const PILLAR_COLORS: Record<string, string> = {
  audience: '#C9A96A',
};

const solutionGroups = PILLAR_ORDER
  .map((pillar) => ({
    pillar,
    label: PILLAR_LABELS[pillar],
    color: PILLAR_COLORS[pillar],
    solutions: SOLUTIONS.filter((s) => s.pillar === pillar),
  }))
  .filter((g) => g.solutions.length > 0);

const allSolutionIds = SOLUTIONS.map((s) => s.id);
const deckHref = href(base, '/');
---
<BaseLayout title="Console — Experience Atelier">
  <AdminConsole
    projectSlug="atelier"
    projectName="Experience Atelier"
    clientLabel="Adobe — internal"
    deckHref={deckHref}
    pages={PAGE_REGISTRY}
    solutionGroups={solutionGroups}
    allSolutionIds={allSolutionIds}
    supabaseUrl={SUPABASE_URL}
    supabaseAnonKey={SUPABASE_ANON_KEY}
  />
</BaseLayout>
