          style="font-size: clamp(1.7rem, 2.8vw, 2.5rem);"
        />
        <T
          as="p"
          en="Every slide activation of this deck writes an anonymous event. Not a promise: the numbers below are from the deck you are looking at."
          it="Ogni slide che si apre in questo deck scrive un evento anonimo. Non è una promessa: i numeri qui sotto arrivano dal deck che state guardando."
          fr="Chaque slide ouverte dans ce deck écrit un événement anonyme. Ce n'est pas une promesse&nbsp;: les chiffres ci-dessous viennent du deck que vous regardez."
          class="proof-lede mb-5"
        />

        <TelemetryPanel url={SUPABASE_URL} anonKey={SUPABASE_ANON_KEY} />
