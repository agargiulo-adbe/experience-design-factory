    </Slide>

    <!-- ── SLIDE 5: Proof — the deck measures itself (live telemetry) ── -->
    <Slide id="slide-proof-telemetry" bg="primary" align="left" data-made-with="">
      <div slot="backdrop" class="loom-bg absolute inset-0" aria-hidden="true"></div>

      <div class="atl-frame">
        <T
          as="p"
          en={PROOF_KICKER.en}
          it={PROOF_KICKER.it}
          fr={PROOF_KICKER.fr}
