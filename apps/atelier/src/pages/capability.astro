    <!-- ── SLIDE 6: Proof — the engine called from inside Claude (MCP) ── -->
    <Slide id="slide-proof-mcp" bg="secondary" align="left" data-made-with="">
      <div slot="backdrop" class="loom-bg-soft absolute inset-0" aria-hidden="true"></div>

      <div class="atl-frame grid grid-cols-1 lg:grid-cols-[1fr_1.15fr] gap-10 items-center">
        <!-- Left: what the three tools do -->
        <div class="min-w-0">
          <T
            as="p"
            en={PROOF_KICKER.en}
            it={PROOF_KICKER.it}
            fr={PROOF_KICKER.fr}
            class="slide-eyebrow text-[var(--accent-primary)] mb-2"
          />
          <T
            as="h2"
            en="The engine, from inside Claude"
            it="Il motore, da dentro Claude"
            fr="Le moteur, depuis Claude"
            class="slide-title text-[var(--ink-primary)] mb-4"
            style="font-size: clamp(1.7rem, 2.8vw, 2.5rem);"
          />
          <T
            as="p"
            en="Three tools, one MCP server. A seller lists the live experiences, opens one in the right cut and language, or reads a client's design system from its production CSS, without leaving the assistant they already use."
            it="Tre strumenti, un server MCP. Un venditore elenca le esperienze online, ne apre una nel taglio e nella lingua giusti, oppure legge il design system di un cliente dal suo CSS di produzione, senza uscire dall'assistente che usa già."
            fr="Trois outils, un serveur MCP. Un vendeur liste les expériences en ligne, en ouvre une dans la coupe et la langue voulues, ou lit le design system d'un client depuis son CSS de production, sans quitter l'assistant qu'il utilise déjà."
            class="proof-lede mb-5"
          />
          <p class="atl-label proof-cmd">claude mcp add atelier <span aria-hidden="true">—</span> packages/mcp-atelier</p>
        </div>

        <!-- Right: the captured session, folded like a terminal folds it -->
        <div class="proof-transcript loom-panel min-w-0">
          <div class="loom-panel-head">
            <p class="loom-tag">Claude Code · MCP «atelier»</p>
            <p class="atl-label">{MCP_TRANSCRIPT_DATE}</p>
          </div>
          <ol class="proof-lines">
            {transcript.map((line) => (
              <li class={`proof-line proof-line--${line.role}`}>
                {line.role === 'tool' && <p class="proof-tool">{line.tool}</p>}
                {line.role === 'tool' ? (
                  <pre class="proof-mono">{line.shown.join('\n')}{line.folded > 0 ? `\n… (+${line.folded})` : ''}</pre>
                ) : (
                  <p class="proof-say">{line.text}</p>
                )}
              </li>
            ))}
          </ol>
        </div>
      </div>
    </Slide>

  </DeckContainer>
</BaseLayout>

<!-- Page-scoped section devices (loom motif for this section) + the live-demo
     styles: global because JS-toggled classes escape Astro scoping, fenced to
     this slide. Explicit rgba only (champagne=201,169,106 · cenere=27,24,19). -->
<style is:global>
  /* Cover: the fan sits centred under the title. */
  #slide-cover .cap-fan { justify-content: center; }

  /* Anatomy: layer labels + the woven weft bands off the one engine warp. */
  #slide-anatomy .cap-layer-label { letter-spacing: 0.16em; text-align: center; }
  #slide-anatomy .cap-wefts {
    display: flex; flex-wrap: wrap; justify-content: center; gap: 0.5rem;
  }
  #slide-anatomy .cap-weft {
    display: inline-flex; align-items: center; gap: 0.65rem;
    padding: 0.4rem 1rem 0.4rem 0.85rem; border-radius: 999px;
    border: 1px solid var(--line-subtle);
    background: rgba(27, 24, 19, 0.85);
    position: relative;
  }
  /* A short champagne "thread" tying each weft down toward the shared engine. */
  #slide-anatomy .cap-weft::after {
    content: ''; position: absolute; left: 50%; bottom: -0.55rem;
    width: 1px; height: 0.45rem; background: rgba(201, 169, 106, 0.5);
  }
  #slide-anatomy .cap-weft-dot {
    width: 0.7rem; height: 0.7rem; border-radius: 999px; flex-shrink: 0;
    background: var(--weft);
  }
  #slide-anatomy .cap-weft-name {
    font-family: var(--font-display); font-weight: 600; font-size: 1.05rem;
    color: var(--color-avorio); white-space: nowrap;
  }
  /* The engine warp reads as the load-bearing band: champagne hairline. */
  #slide-anatomy .cap-engine {
    border-color: rgba(201, 169, 106, 0.55);
    align-items: center;
    padding-top: 1.15rem; padding-bottom: 1.15rem;
  }

  /* Made with Adobe: four product cards, two by two; the product name is the tag. */
  #slide-adobe-stack .cap-stack-grid {
    display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.9rem;
  }
  @media (max-width: 767px) { #slide-adobe-stack .cap-stack-grid { grid-template-columns: 1fr; } }
  #slide-adobe-stack .cap-stack-card { padding: 1.2rem 1.35rem 1.1rem; }
  #slide-adobe-stack .cap-stack-head {
    display: flex; align-items: center; gap: 0.7rem; margin-bottom: 0.75rem;
  }
  #slide-adobe-stack .cap-stack-head .loom-mark { margin-bottom: 0; }
  #slide-adobe-stack .cap-stack-product { font-size: 0.8rem; max-width: none; }
  #slide-adobe-stack .loom-card-title { margin-bottom: 0.45rem; }
  /* 1280×800 leaves 464px: tighten spacing only, never type. */
  @media (max-height: 820px) and (min-width: 768px) {
    #slide-adobe-stack .cap-stack-card { padding: 0.9rem 1.1rem 0.85rem; }
    #slide-adobe-stack .cap-stack-head { margin-bottom: 0.45rem; }
    #slide-adobe-stack .cap-stack-grid { gap: 0.6rem; }
  }

  /* Demo panel: champagne hairline frame so the live area reads as "the tool". */
  #slide-toggle-demo .cap-demo { border-color: rgba(201, 169, 106, 0.45); }
  #slide-toggle-demo .cap-tag { font-size: 0.8rem; }
  #slide-toggle-demo .cap-try { margin-top: 1.25rem; padding-top: 0.9rem; }

  /* Console: plain closing sentence (no pull-quote device on this slide). */
  #slide-console .cap-close {
    font-family: var(--font-display); font-weight: 500;
    font-size: clamp(1.05rem, 1.4vw, 1.3rem); line-height: 1.45; max-width: 60ch;
  }

  /* ── Live gating demo controls ───────────────────────────────── */
  #slide-toggle-demo .atl-switch {
    position: relative;
    width: 46px;
    height: 26px;
    flex-shrink: 0;
    border-radius: 999px;
    background: rgba(201, 169, 106, 1);
    transition: background var(--duration-normal) var(--easing-default);
  }
  #slide-toggle-demo .atl-switch::after {
    content: '';
    position: absolute;
    top: 3px;
    left: 23px;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: rgba(18, 16, 12, 1);
    transition: left var(--duration-normal) var(--easing-default),
                background var(--duration-normal) var(--easing-default);
  }
  #slide-toggle-demo [aria-checked='false'] .atl-switch {
    background: rgba(38, 33, 26, 1);
    box-shadow: inset 0 0 0 1.5px rgba(185, 175, 153, 0.9);
  }
  #slide-toggle-demo [aria-checked='false'] .atl-switch::after {
    left: 3px;
    background: rgba(185, 175, 153, 1);
  }
  #slide-toggle-demo .atl-chip {
    transition: opacity var(--duration-normal) var(--easing-default),
                transform var(--duration-normal) var(--easing-default);
  }
  #slide-toggle-demo .atl-chip.atl-chip-off {
    opacity: 0.18;
    transform: scale(0.96);
  }
  @media (prefers-reduced-motion: reduce) {
    #slide-toggle-demo .atl-switch,
    #slide-toggle-demo .atl-switch::after,
    #slide-toggle-demo .atl-chip {
      transition: none;
    }
  }
</style>

<!-- Self-contained demo runtime — page-scoped, independent from the real gating engine.
     Without JS the panel degrades to a static labeled mock (all switches on, 8 chips). -->
<script is:inline>
(function () {
  if (window.__atlToggleDemo) return;
  window.__atlToggleDemo = true;

  function refresh() {
    var panel = document.querySelector('[data-demo-panel]');
    if (!panel) return;
    var off = {};
    panel.querySelectorAll('[data-demo-toggle]').forEach(function (b) {
      if (b.getAttribute('aria-checked') === 'false') off[b.getAttribute('data-demo-toggle')] = true;
    });
    var visible = 0;
    panel.querySelectorAll('.atl-chip').forEach(function (chip) {
      var gate = chip.getAttribute('data-demo-chip');
      var hidden = !!(gate && off[gate]);
      chip.classList.toggle('atl-chip-off', hidden);
      if (!hidden) visible++;
    });
    panel.querySelectorAll('[data-demo-count]').forEach(function (el) {
      el.textContent = String(visible);
    });
  }

  function flip(btn) {
    btn.setAttribute('aria-checked', btn.getAttribute('aria-checked') === 'false' ? 'true' : 'false');
    refresh();
  }

  document.addEventListener('click', function (e) {
    var t = e.target;
    var btn = t && t.closest ? t.closest('[data-demo-toggle]') : null;
    if (!btn) return;
    e.preventDefault();
    flip(btn);
  });

  // Capture-phase so Space toggles the focused switch instead of advancing the deck
  // (the deck controller listens for Space on window).
  document.addEventListener('keydown', function (e) {
    var t = e.target;
    var btn = t && t.closest ? t.closest('[data-demo-toggle]') : null;
    if (!btn) return;
    if (e.key === ' ' || e.key === 'Spacebar' || e.key === 'Enter') {
      e.preventDefault();
      e.stopPropagation();
      flip(btn);
    }
  }, true);

  document.addEventListener('astro:page-load', refresh);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', refresh);
  } else {
    refresh();
  }
})();
</script>
