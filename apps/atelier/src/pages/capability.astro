---
import BaseLayout from '../layouts/BaseLayout.astro';
import AtelierNavigation from '../components/AtelierNavigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import T from '@edf/core/blocks/i18n/T.astro';
import TelemetryPanel from '../components/TelemetryPanel.astro';
import { MCP_TRANSCRIPT, MCP_TRANSCRIPT_DATE } from '../data/mcp-transcript';
import { href } from '@edf/core/utils/url.js';

const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;
const SUPABASE_URL = import.meta.env.PUBLIC_SUPABASE_URL ?? '';
const SUPABASE_ANON_KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY ?? '';

// Both proofs — the self-measuring deck and the MCP server — were built on
// 2026-09-14, the same day: one day of work, so the kicker says one day.
const PROOF_KICKER = {
  en: 'Proof · v0 built in 1 day',
  it: 'Prova · v0 costruita in 1 giorno',
  fr: 'Preuve · v0 construite en 1 jour',
};

// The transcript is captured verbatim (src/data/mcp-transcript.ts). On a slide it
// is folded the way a terminal folds it — the first lines, clipped to the column
// width, and a count of what is folded away. Nothing is rewritten.
// A one-line payload is NEVER clipped: `open_experience` returns a single line and
// the proof is at its end (`?lang=it`, "Pole Position") — exactly what the copy on
// the left promises. `.proof-mono` wraps it (pre-wrap + overflow-wrap: anywhere).
const FOLD_LINES = 3;
const FOLD_CHARS = 58;
const transcript = MCP_TRANSCRIPT.map((line) => {
  const all = line.text.split('\n');
  const clip = line.role === 'tool' && all.length > 1;
  const shown = (line.role === 'tool' ? all.slice(0, FOLD_LINES) : all).map((l) =>
    clip && l.length > FOLD_CHARS ? l.slice(0, FOLD_CHARS - 1) + '…' : l,
  );
  return { ...line, shown, folded: all.length - shown.length };
});

// The eight skins. Accents are the brand hues lightened for AA (≥4.5:1) on the
// dark loom surface, the same tints the opening wall uses (raw UniCredit /
// Ferrari / FS reds and the MIM institutional blue fall below 4.5:1 on fuliggine).
const skins = [
  { name: 'Max Mara',  accent: '#C9A272' },
  { name: 'UniCredit', accent: '#E8858B' },
  { name: 'Ferrari',   accent: '#FF7A5C' },
  { name: 'FS Group',  accent: '#F2777D' },
  { name: 'Agos',      accent: '#2BC2CE' },
  { name: 'Eni',       accent: '#FFCE00' },
  { name: 'MIM',       accent: '#6FA8FF' },
  { name: 'Isybank',   accent: '#26E5AE' },
];

// «Made with Adobe» — what actually builds the assets of every experience today.
// Counts verified on 2026-09-14 in the provenance files of each app:
//   Firefly Image backdrops: MIM 23 · Isybank 17 · UniCredit 10 · this deck 5 = 55
//   Firefly Video clips: MIM 3 · UniCredit 2 · Isybank 2 · this deck 1 = 8
//   Photoshop API (Remove Background): UniCredit 1 (the only stock portrait in view)
// Card 01 also names Firefly Custom Models: private per-brand model, public beta,
// ~1 hour of training (Adobe Firefly public beta, as stated on 2026-09-14).
const adobeStack = [
  {
    n: '01',
    product: 'Adobe Firefly Image',
    title: { en: 'Backdrops on the brand palette', it: 'Sfondi sulla palette del brand', fr: 'Fonds sur la palette de la marque' },
    body: {
      en: '55 backdrops across four decks, this one included: prompt, model and seed recorded per image, one distinct image per slide. A private Custom Model per client brand is in public beta: about an hour of training.',
      it: '55 sfondi in quattro deck, questo compreso: prompt, modello e seed registrati per ogni immagine, un’immagine diversa per slide. Un Custom Model privato sul brand del cliente è in beta pubblica: circa un’ora di training.',
      fr: '55 fonds sur quatre decks, celui-ci compris&nbsp;: prompt, modèle et seed consignés par image, une image distincte par slide. Un Custom Model privé sur la marque du client est en bêta publique&nbsp;: environ une heure d’entraînement.',
    },
  },
  {
    n: '02',
    product: 'Adobe Firefly Video',
    title: { en: 'Clips that loop without a seam', it: 'Clip che girano senza stacco', fr: 'Des clips qui bouclent sans raccord' },
    body: {
      en: 'Eight five-second clips for covers and closings. A script dissolves the tail into the head and measures the seam in decibels, so the loop never jumps.',
      it: 'Otto clip da cinque secondi per copertine e chiusure. Uno script dissolve la coda sulla testa e misura il giro in decibel: il loop non salta.',
      fr: 'Huit clips de cinq secondes pour couvertures et fins. Un script fond la fin dans le début et mesure le raccord en décibels&nbsp;: la boucle ne saute jamais.',
    },
  },
  {
    n: '03',
    product: 'Adobe Photoshop API',
    title: { en: 'Retouch where it shows', it: 'Ritocco dove si vede', fr: 'Retouche là où ça se voit' },
    body: {
      en: 'Remove Background cut out the one stock portrait that was actually in view and set it on a brand surface; provenance records it as a derivative of a licensed original.',
      it: 'Remove Background ha scontornato l’unico ritratto stock davvero in vista e l’ha posato su una superficie di brand; la provenienza lo registra come derivato di un originale su licenza.',
      fr: 'Remove Background a détouré le seul portrait de stock réellement visible et l’a posé sur une surface de marque&nbsp;; la provenance l’enregistre comme dérivé d’un original sous licence.',
    },
  },
  {
    n: '04',
    product: 'Provenance · Content Credentials',
    title: { en: 'A credit on every slide', it: 'Un credito su ogni slide', fr: 'Un crédit sur chaque slide' },
    body: {
      en: 'Bottom right, each slide names the Adobe product that made its asset, read from provenance, not typed by hand. Firefly signs its output; the build crops and converts, so the shipped file points to the record instead of carrying the signature.',
      it: 'In basso a destra ogni slide dice quale prodotto Adobe ha fatto il suo asset, letto dalla provenienza, non scritto a mano. Firefly firma ciò che genera; la build ritaglia e converte, quindi il file spedito rimanda al registro invece di portare la firma.',
      fr: 'En bas à droite, chaque slide nomme le produit Adobe qui a fait son asset, lu dans la provenance, pas saisi à la main. Firefly signe ce qu’il génère&nbsp;; la build recadre et convertit, le fichier livré renvoie donc au registre au lieu de porter la signature.',
    },
  },
];
// Fan geometry: one warp on the left fanning into one weft per skin.
const fanY = skins.map((_, i) => 8 + i * (84 / (skins.length - 1)));

// Mini deck map for the live gating demo: 8 sections, 6 of them gated in pairs.
const demoChips = [
  { n: '01', en: 'Opening',       it: 'Apertura',       fr: 'Ouverture',     gate: null },
  { n: '02', en: 'Journeys',      it: 'Journey',        fr: 'Parcours',      gate: 'cja' },
  { n: '03', en: 'Insights',      it: 'Insight',        fr: 'Insights',      gate: 'cja' },
  { n: '04', en: 'Creative',      it: 'Creatività',     fr: 'Création',      gate: 'content' },
  { n: '05', en: 'Delivery',      it: 'Delivery',       fr: 'Diffusion',     gate: 'content' },
  { n: '06', en: 'Audiences',     it: 'Audience',       fr: 'Audiences',     gate: 'collab' },
  { n: '07', en: 'Collaboration', it: 'Collaborazione', fr: 'Collaboration', gate: 'collab' },
  { n: '08', en: 'Closing',       it: 'Chiusura',       fr: 'Conclusion',    gate: null },
];

// Product names as verified in 2026 (never the bare short forms).
const demoToggles = [
  { id: 'cja',     en: 'Customer Journey Analytics',          it: 'Customer Journey Analytics',          fr: 'Customer Journey Analytics' },
  { id: 'content', en: 'GenStudio for Performance Marketing', it: 'GenStudio for Performance Marketing', fr: 'GenStudio for Performance Marketing' },
  { id: 'collab',  en: 'Real-Time CDP Collaboration',         it: 'Real-Time CDP Collaboration',         fr: 'Real-Time CDP Collaboration' },
];

// The Admin Console rows — authored as woven "threads": one engine, four controls.
const consoleThreads = [
  {
    en: 'Sections on and off', it: 'Sezioni accese o spente', fr: 'Sections actives ou non',
    body_en: 'One link shares a version of the experience tuned to a specific audience.',
    body_it: "Un link condivide una versione dell'esperienza tarata su un pubblico preciso.",
    body_fr: "Un lien partage une version de l'expérience réglée pour un public précis.",
  },
  {
    en: 'Chapters and single slides', it: 'Capitoli e singole slide', fr: 'Chapitres et slides isolées',
    body_en: 'Switch a whole chapter off and keep one slide of it: arrows and links skip what is hidden.',
    body_it: 'Spegni un intero capitolo e tieni una sua slide: frecce e link scavalcano ciò che è nascosto.',
    body_fr: 'Éteignez un chapitre entier en gardant une de ses slides&nbsp;: flèches et liens sautent ce qui est masqué.',
  },
  {
    en: 'Demo media per slide', it: 'Media demo per slide', fr: 'Médias démo par slide',
    body_en: 'Attach a product demo video or image to any slide, and share it as a link.',
    body_it: "Aggancia un video o un'immagine demo a qualsiasi slide, condivisibile via link.",
    body_fr: 'Ajoutez une vidéo ou une image démo à chaque slide, à partager par lien.',
  },
  {
    en: 'Custom slides', it: 'Slide personalizzate', fr: 'Slides personnalisées',
    body_en: 'Author new, deck-coherent slides with live preview; they ride the same shared links.',
    body_it: 'Crea nuove slide coerenti col deck, con anteprima live; viaggiano sugli stessi link.',
    body_fr: 'Créez des slides cohérentes avec le deck, aperçu live ; elles suivent les mêmes liens.',
  },
];
---
<BaseLayout
  title="The capability"
  description="One engine under every experience: anatomy of the Atelier, live solution gating and the Admin Console that tunes each meeting without code."
>
  <div class="fixed top-0 left-0 right-0 z-50">
    <AtelierNavigation currentPath={currentPath} base={base} />
  </div>

  <DeckContainer
    nextHref={href(base, '/gap')}
    prevHref={href(base, '/method')}
  >

    <!-- ── SLIDE 1: Cover — one warp → many wefts (detail cut) ─────── -->
    <Slide id="slide-cover" bg="primary" align="center" data-solution="detail">
      <div slot="backdrop" class="loom-bg absolute inset-0" aria-hidden="true"></div>

      <div class="atl-frame flex flex-col items-center">
        <p class="atl-cover-num mb-3" aria-hidden="true" data-display>02</p>
        <T
          as="p"
          en="The capability"
          it="La capacità"
          fr="Le socle"
          class="atl-cover-kicker mb-5"
        />
        <T
          as="h1"
          en="One engine. Any story."
          it="Un motore. Ogni storia."
          fr="Un moteur. Chaque récit."
          class="slide-title text-center text-[var(--ink-primary)] mb-7"
          style="font-size: clamp(2.5rem, 5vw, 4.5rem);"
        />

        <!-- One → many device: a single warp fanning into the seven weft threads. -->
        <div class="loom-fan cap-fan w-full max-w-3xl mb-7" aria-hidden="true">
          <span class="loom-fan-cap loom-fan-cap--one">1</span>
          <svg class="loom-fan-svg" viewBox="0 0 320 100" preserveAspectRatio="none" role="presentation">
            {skins.map((s, i) => (
              <line x1="4" y1="50" x2="316" y2={fanY[i]} stroke={s.accent} stroke-width="2" />
            ))}
          </svg>
          <span class="loom-fan-cap loom-fan-cap--many">{skins.length}</span>
        </div>

        <T
          as="p"
          en="Every experience you clicked in the opening wall runs on the same core."
          it="Ogni esperienza aperta dalle card iniziali gira sullo stesso core."
          fr="Chaque expérience ouverte sur le mur d'entrée tourne sur le même cœur."
          class="atl-lede"
        />
      </div>
    </Slide>

    <!-- ── SLIDE 2: Anatomy — one warp (engine) → seven wefts (skins) ── -->
    <Slide id="slide-anatomy" bg="secondary" align="center">
      <div slot="backdrop" class="loom-bg-soft absolute inset-0" aria-hidden="true"></div>

      <div class="atl-frame flex flex-col items-center">
        <T
          as="p"
          en="One core, eight skins"
          it="Un cuore, otto skin"
          fr="Un cœur, huit habillages"
          class="slide-eyebrow text-center text-[var(--accent-primary)] mb-2"
        />
        <T
          as="h2"
          en="Anatomy of the Atelier"
          it="Anatomia dell'Atelier"
          fr="Anatomie de l'Atelier"
          class="slide-title text-center text-[var(--ink-primary)] mb-5"
          style="font-size: clamp(1.7rem, 2.8vw, 2.5rem);"
        />

        <!-- Wefts: the seven brand skins, each a coloured band woven off the one warp -->
        <T
          as="p"
          en="Skins"
          it="Skin"
          fr="Habillages"
          class="atl-label cap-layer-label mb-2"
        />
        <div class="cap-wefts w-full min-w-0 mb-3">
          {skins.map((s) => (
            <span class="cap-weft" style={`--weft:${s.accent}`}>
              <span class="cap-weft-dot" aria-hidden="true"></span>
              <span class="cap-weft-name">{s.name}</span>
            </span>
          ))}
        </div>

        <!-- The warp: one shared engine feeding all seven -->
        <div class="loom-panel cap-engine w-full text-center">
          <T
            as="p"
            en="Experience engine"
            it="Experience engine"
            fr="Experience engine"
            class="loom-figure mb-1.5"
            style="color: var(--accent-primary);"
          />
          <T
            as="p"
            en="Immersive deck, trilingual i18n, quality gates, the Adobe × brand signature and the made-with credit, shared by all eight."
            it="Deck immersivo, i18n trilingue, quality gate, la firma Adobe × brand e il credito «creato con», condivisi da tutte e otto."
            fr="Deck immersif, i18n trilingue, contrôles qualité, la signature Adobe × marque et le crédit «&nbsp;créé avec&nbsp;», partagés par les huit."
            class="loom-panel-body mx-auto mb-0"
            style="text-align: center;"
          />
        </div>

        <!-- The foundation the warp rests on -->
        <T
          as="p"
          en="Foundation"
          it="Fondazioni"
          fr="Fondations"
          class="atl-label cap-layer-label mt-4 mb-2"
        />
        <div class="w-full grid grid-cols-1 md:grid-cols-3 gap-3 min-w-0">
          <div class="loom-panel min-w-0 text-center">
            <T
              as="p"
              en="Callable from Claude and Copilot"
              it="Richiamabile da Claude e Copilot"
              fr="Appelable depuis Claude et Copilot"
              class="loom-card-title mb-1.5"
              style="text-align: center;"
            />
            <T
              as="p"
              en="An MCP server and Agent Skills expose the engine where sellers already work; the Admin Console configures each experience at runtime."
              it="Un server MCP e le Agent Skills espongono il motore dove i venditori già lavorano; l'Admin Console configura ogni esperienza a runtime."
              fr="Un serveur MCP et les Agent Skills exposent le moteur là où les vendeurs travaillent déjà&nbsp;; l'Admin Console configure chaque expérience au runtime."
              class="loom-panel-body mx-auto mb-0"
              style="text-align: center;"
            />
          </div>
          <div class="loom-panel min-w-0 text-center">
            <T
              as="p"
              en="Design tokens, read from the site"
              it="Design token, letti dal sito"
              fr="Tokens de design, lus sur le site"
              class="loom-card-title mb-1.5"
              style="text-align: center;"
            />
            <T
              as="p"
              en="One command reads the client's production CSS and counts: the colours it uses most are its design system."
              it="Un comando legge il CSS di produzione del cliente e conta: i colori più usati sono il suo design system."
              fr="Une commande lit le CSS de production du client et compte&nbsp;: ses couleurs les plus fréquentes sont son design system."
              class="loom-panel-body mx-auto mb-0"
              style="text-align: center;"
            />
          </div>
          <div class="loom-panel min-w-0 text-center">
            <T
              as="p"
              en="Build chain, with provenance"
              it="Catena di build, con provenienza"
              fr="Chaîne de build, avec provenance"
              class="loom-card-title mb-1.5"
              style="text-align: center;"
            />
            <T
              as="p"
              en="Firefly images and clips, licensed stock, Photoshop retouch: every asset lands with its record."
              it="Immagini e clip Firefly, stock su licenza, ritocco Photoshop: ogni asset arriva con il suo registro."
              fr="Images et clips Firefly, stock sous licence, retouche Photoshop&nbsp;: chaque asset arrive avec sa fiche."
              class="loom-panel-body mx-auto mb-0"
              style="text-align: center;"
            />
          </div>
        </div>
      </div>
    </Slide>

    <!-- ── SLIDE 2b: Made with Adobe — the creative chain behind every asset ── -->
    <Slide id="slide-adobe-stack" bg="primary" align="left">
      <div slot="backdrop" class="loom-bg absolute inset-0" aria-hidden="true"></div>

      <div class="atl-frame">
        <T
          as="p"
          en="Made with Adobe"
          it="Fatto con Adobe"
          fr="Fait avec Adobe"
          class="slide-eyebrow text-[var(--accent-primary)] mb-2"
          data-reveal
        />
        <T
          as="h2"
          en="The assets are made with the products the story sells"
          it="Gli asset sono fatti con i prodotti che la storia vende"
          fr="Les assets sont faits avec les produits que le récit vend"
          class="slide-title text-[var(--ink-primary)] mb-5"
          style="font-size: clamp(1.65rem, 2.5vw, 2.3rem); max-width: none;"
          data-reveal
          data-reveal-delay="0.06"
        />

        <div class="cap-stack-grid w-full" data-reveal data-reveal-delay="0.14">
          {adobeStack.map((s) => (
            <article class="loom-card cap-stack-card">
              <div class="cap-stack-head">
                <span class="loom-mark" aria-hidden="true">{s.n}</span>
                <p class="loom-tag cap-stack-product">{s.product}</p>
              </div>
              <T as="h3" en={s.title.en} it={s.title.it} fr={s.title.fr} class="loom-card-title" />
              <T as="p" en={s.body.en} it={s.body.it} fr={s.body.fr} class="loom-card-body" style="margin-bottom: 0;" />
            </article>
          ))}
        </div>
      </div>
    </Slide>

    <!-- ── SLIDE 3: Live solution-gating demo ─────────────────────── -->
    <Slide id="slide-toggle-demo" bg="primary" align="left">
      <div slot="backdrop" class="loom-bg absolute inset-0" aria-hidden="true"></div>

      <div class="atl-frame grid grid-cols-1 lg:grid-cols-[1fr_1.15fr] gap-10 items-center">
        <!-- Left: explanation -->
        <div class="min-w-0">
          <T
            as="h2"
            en="Tailored to one meeting, live"
            it="Su misura per il meeting, live"
            fr="Sur mesure pour une réunion, en direct"
            class="slide-title text-[var(--ink-primary)] mb-5"
            style="font-size: clamp(1.7rem, 2.8vw, 2.5rem);"
          />
          <T
            as="p"
            en="A seller switches a capability off, and the experience reshapes itself: navigation, slides and links follow. No rebuild, no editing."
            it="Un venditore spegne una capability e l'esperienza si riconfigura da sola: navigazione, slide e link seguono. Senza ricompilare, senza modificare nulla."
            fr="Un vendeur désactive une capacité et l'expérience se recompose&nbsp;: navigation, slides et liens suivent. Ni recompilation, ni retouche."
            class="text-[var(--color-sabbia-200)] mb-5"
            style="font-size: clamp(0.95rem, 1.1vw, 1.1rem); line-height: 1.6;"
          />
          <div class="loom-quote cap-try">
            <T
              as="p"
              en="Try it — the switches on this slide are live."
              it="Provala: gli switch su questa slide sono attivi."
              fr="Essayez&nbsp;: les commutateurs de cette slide sont actifs."
              class="loom-quote-text"
              style="font-style: normal; font-size: clamp(1.05rem, 1.5vw, 1.3rem); color: var(--accent-primary);"
            />
          </div>
        </div>

        <!-- Right: framed live panel (clicks here never advance the deck) -->
        <div
          data-demo-panel
          data-deck-nochrome
          class="loom-panel cap-demo min-w-0"
        >
          <div class="loom-panel-head">
            <T
              as="p"
              en="Live demo: click the switches"
              it="Demo live: clicca gli switch"
              fr="Démo live&nbsp;: actionnez les commutateurs"
              class="loom-tag cap-tag"
            />
          </div>

          <div class="flex flex-col gap-2 mb-4" role="group" aria-label="Solutions">
            {demoToggles.map((t) => (
              <button
                type="button"
                role="switch"
                aria-checked="true"
                data-demo-toggle={t.id}
                class="atl-toggle flex items-center justify-between gap-4 w-full min-h-[44px] px-4 py-2 rounded-sm border border-[var(--line-subtle)] bg-[rgba(38,33,26,1)] cursor-pointer transition-colors hover:border-[var(--color-sabbia-400)]"
              >
                <T en={t.en} it={t.it} fr={t.fr} class="text-[1rem] font-medium text-[var(--ink-primary)] text-left" />
                <span class="atl-switch" aria-hidden="true"></span>
              </button>
            ))}
          </div>

          <T
            as="p"
            en="Deck map"
            it="Mappa del deck"
            fr="Plan du deck"
            class="atl-label mb-2"
          />
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-1.5 mb-3 min-w-0">
            {demoChips.map((c) => (
              <div
                data-demo-chip={c.gate ?? undefined}
                class="atl-chip min-w-0 px-2 py-2 rounded-sm border border-[var(--line-subtle)] bg-[rgba(18,16,12,1)] text-center"
              >
                <p class="text-[0.8rem] tabular-nums text-[var(--color-sabbia-300)] leading-none mb-1">{c.n}</p>
                <T en={c.en} it={c.it} fr={c.fr} as="p" class="text-[0.8rem] font-medium text-[var(--color-sabbia-200)] leading-tight break-words" />
              </div>
            ))}
          </div>

          <p class="text-[0.95rem] text-[var(--color-sabbia-200)]" aria-live="polite" aria-atomic="true" style="line-height: 1.5;">
            8 <T en="sections" it="sezioni" fr="sections" />
            <span class="text-[var(--color-sabbia-300)] mx-1" aria-hidden="true">→</span>
            <strong data-demo-count class="font-semibold text-[var(--accent-primary)] tabular-nums">8</strong>
            <T en="sections" it="sezioni" fr="sections" />
          </p>
        </div>
      </div>
    </Slide>

    <!-- ── SLIDE 4: Admin Console — one engine, three woven controls (detail cut) ── -->
    <Slide id="slide-console" bg="secondary" align="left" data-solution="detail">
      <div slot="backdrop" class="loom-bg-soft absolute inset-0" aria-hidden="true"></div>

      <div class="atl-frame">
        <T
          as="h2"
          en="The Admin Console does the rest"
          it="L'Admin Console fa il resto"
          fr="L'Admin Console fait le reste"
          class="slide-title text-[var(--ink-primary)] mb-6"
          style="font-size: clamp(1.7rem, 2.8vw, 2.5rem);"
        />

        <div class="loom-weave mb-6">
          {consoleThreads.map((row, i) => (
            <div class="loom-thread" style={`--thread:${i}`}>
              <div class="loom-thread-rail">
                <span class="loom-thread-num">{i + 1}</span>
              </div>
              <div class="loom-thread-copy">
                <T
                  as="p"
                  en={row.en}
                  it={row.it}
                  fr={row.fr}
                  class="loom-thread-title"
                />
                <T
                  as="p"
                  en={row.body_en}
                  it={row.body_it}
                  fr={row.body_fr}
                  class="loom-thread-body"
                />
              </div>
            </div>
          ))}
        </div>

        <T
          as="p"
          en="The person running the meeting controls the experience, without touching code."
          it="Chi guida il meeting governa l'esperienza, senza toccare il codice."
