---
/**
 * «Il registro» — lo strato che cresce.
 * Una riga per voce, con la data e il livello di fonte. Nessuna narrazione:
 * si legge come un log perché è un log. La copia sta in src/data/registro.ts.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import T from '@edf/core/blocks/i18n/T.astro';
import { href } from '@edf/core/utils/url.js';
import { CHAPTERS, prevSlug, nextSlug } from '../data/chapters';
import { REGISTRO, STATI, LIVELLI_REG } from '../data/registro';

const SLUG = 'registro';
const ch = CHAPTERS.find((c) => c.slug === SLUG)!;
const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;

const risposte = REGISTRO.filter((v) => v.stato === 'risposto').length;
const aperti = REGISTRO.filter((v) => v.stato !== 'risposto').length;
/* Tre voci per slide: a cinque il blocco sfondava la safe-area a 1280 (check c e j).
   La regola è tagliare o spezzare, mai rimpicciolire il tipo.

   E si raggruppa per STATO, non si impagina alla cieca. Prima erano fette da tre
   nell'ordine dell'array, intitolate «Le voci aperte, 2 di 4»: mancava la 1 di 4,
   e dentro «le voci aperte» finivano voci marcate «Risposto». Il titolo di una
   slide è il suo punto: qui il punto è lo stato, e il conteggio deve tornare con
   quello che la copertina del capitolo dichiara. */
const GRUPPI = [
  { stato: 'risposto' as const, titolo: { it: 'Quello che si è chiuso', en: 'What has closed' } },
  { stato: 'verificare' as const, titolo: { it: 'Quello che resta da verificare', en: 'What is left to verify' } },
  { stato: 'aperto' as const, titolo: { it: 'Quello che resta aperto', en: 'What is still open' } },
];
const pagine = GRUPPI.flatMap((g) => {
  const voci = REGISTRO.filter((v) => v.stato === g.stato);
  const fette: typeof REGISTRO[] = [];
  for (let i = 0; i < voci.length; i += 3) fette.push(voci.slice(i, i + 3));
  return fette.map((voci, i) => ({
    voci,
    titolo: {
      it: fette.length > 1 ? `${g.titolo.it}, ${i + 1} di ${fette.length}` : g.titolo.it,
      en: fette.length > 1 ? `${g.titolo.en}, ${i + 1} of ${fette.length}` : g.titolo.en,
    },
  }));
});
---
<BaseLayout title={ch.title.it}>
  <div class="fixed top-0 left-0 right-0 z-50">
    <Navigation currentPath={currentPath} base={base} />
  </div>

  <DeckContainer nextHref={href(base, nextSlug(SLUG))} prevHref={href(base, prevSlug(SLUG))}>

    <Slide id="slide-cover" bg="inverse" align="center">
      <div slot="backdrop" class="ex-bg-night"></div>
      <div class="ex-ch" data-reveal>
        <p class="ex-ch-num"><span data-lang-it>Capitolo {ch.num}</span><span data-lang-en>Chapter {ch.num}</span></p>
        <T as="h2" class="ex-ch-title" it="Il registro" en="The log" data-reveal data-reveal-delay="0.08" />
        <T
          as="p"
          class="ex-ch-lead"
          it={`Per ogni voce: stato, chi la chiude, entro quando. ${risposte} risposte, ${aperti} aperte.`}
          en={`For each item: its state, who closes it, by when. ${risposte} answered, ${aperti} open.`}
          data-reveal
          data-reveal-delay="0.15"
        />
      </div>
    </Slide>

    {pagine.map((pagina, pi) => (
      <Slide id={`slide-reg-${pi + 1}`} bg={pi % 2 === 0 ? 'primary' : 'secondary'} align="left">
        {pi % 2 === 0 && <div slot="backdrop" class="ex-bg-paper"></div>}
        <div class="ex-content" data-reveal>
          <div class="ex-head">
            <T as="p" class="slide-eyebrow" it="Il registro" en="The log" />
            <T as="h2" class="ex-head-title" it={pagina.titolo.it} en={pagina.titolo.en} />
          </div>
          <div class="ex-reg" data-reveal data-reveal-delay="0.12">
            {pagina.voci.map((v) => (
              <div class="ex-reg-row">
                <p class="ex-reg-meta">
                  <span class="ex-reg-data">{v.data}</span>
                  <span class={`ex-reg-stato ex-reg-stato--${v.stato}`}>
                    <span data-lang-it>{STATI[v.stato].it}</span><span data-lang-en>{STATI[v.stato].en}</span>
                  </span>
                  <span class="ex-reg-liv">
                    <span data-lang-it>{LIVELLI_REG[v.livello].it}</span><span data-lang-en>{LIVELLI_REG[v.livello].en}</span>
                  </span>
                  <span class="ex-reg-chi"><span data-lang-it>{v.chi.it}</span><span data-lang-en>{v.chi.en}</span></span>
                  <span class="ex-reg-entro">
                    {v.stato === 'risposto'
                      ? null
                      : v.entro
                        ? <><span data-lang-it>Entro: {v.entro.it}</span><span data-lang-en>By: {v.entro.en}</span></>
                        : <><span data-lang-it>Entro: da assegnare</span><span data-lang-en>By: to be assigned</span></>}
                  </span>
                </p>
                <T as="p" class="ex-reg-tema" it={v.tema.it} en={v.tema.en} />
                <T as="p" class="ex-reg-esito" it={v.esito.it} en={v.esito.en} />
                {v.fonte && (
                  <p class="ex-reg-fonte">
                    <a href={v.fonte.url} target="_blank" rel="noopener">{v.fonte.label}</a>
                  </p>
                )}
              </div>
            ))}
          </div>
        </div>
      </Slide>
    ))}

  </DeckContainer>
</BaseLayout>
