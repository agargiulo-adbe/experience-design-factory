---
/**
 * Capitolo 07 — «Cosa vi portate a casa».
 * Le cinque risposte in una riga ciascuna, poi l'ask. In un Playbook l'ask sta
 * in un posto solo: due versioni della richiesta sono il modo più rapido di
 * sembrare confusi davanti a un cliente.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import CoBrand from '../components/CoBrand.astro';
import T from '@edf/core/blocks/i18n/T.astro';
import { href } from '@edf/core/utils/url.js';
import { CHAPTERS, prevSlug } from '../data/chapters';
import { DOMANDE } from '../data/domande';

const SLUG = 'casa';
const ch = CHAPTERS.find((c) => c.slug === SLUG)!;
const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;
---
<BaseLayout title={ch.title.it}>
  <div class="fixed top-0 left-0 right-0 z-50">
    <Navigation currentPath={currentPath} base={base} />
  </div>

  <DeckContainer nextHref={href(base, '/registro')} prevHref={href(base, prevSlug(SLUG))}>

    <Slide id="slide-cover" bg="inverse" align="center">
      <div slot="backdrop" class="ex-bg-night"></div>
      <div class="ex-ch" data-reveal>
        <p class="ex-ch-num"><span data-lang-it>Capitolo {ch.num}</span><span data-lang-en>Chapter {ch.num}</span></p>
        <T as="h2" class="ex-ch-title" it="Cosa vi portate a casa" en="What you take home" data-reveal data-reveal-delay="0.08" />
        <T as="p" class="ex-ch-lead" it="Cinque risposte, e una cosa da decidere." en="Five answers, and one thing to decide." data-reveal data-reveal-delay="0.15" />
      </div>
    </Slide>

    <Slide id="slide-cinque-risposte" bg="primary" align="left">
      <div slot="backdrop" class="ex-bg-paper"></div>
      <div class="ex-content" data-reveal>
        <div class="ex-head">
          <T as="p" class="slide-eyebrow" it="Le cinque risposte" en="The five answers" />
          <T as="h2" class="ex-head-title" it="Tutte e cinque hanno una risposta documentata" en="All five have a documented answer" />
          <T as="p" class="ex-head-lead" it="Su una, gli alert, il perimetro va provato sui vostri." en="On one, the alerts, the scope has to be tried on yours." />
        </div>
        <div class="ex-cards" data-reveal data-reveal-delay="0.14">
          {DOMANDE.map((d) => (
            <div class="ex-card">
              <p class="ex-card-k">{d.num}</p>
              <T as="p" class="ex-card-t" it={d.punto.it} en={d.punto.en} />
              <T as="p" class="ex-card-b" it={d.lead.it} en={d.lead.en} />
            </div>
          ))}
        </div>
      </div>
    </Slide>

    <Slide id="slide-ask" bg="secondary" align="left">
      <div class="ex-content" data-reveal>
        <div class="ex-head">
          <T as="p" class="slide-eyebrow" it="Quello che chiediamo" en="What we are asking" />
          <T as="h2" class="ex-head-title" it="Due casi d’uso e tre date, prima che il programma chiuda" en="Two use cases and three dates, before the programme closes" />
          <T as="p" class="ex-head-lead" it="Non una scelta definitiva: un punto da cui misurare." en="Not a final choice: a point from which to measure." />
        </div>
        <!-- Ogni blocco porta il suo fatto: i due casi hanno un nome, le tre date
             sono una proposta nostra. Tre ancore senza contenuto, qui, erano il
             rilievo su cui il panel del 29 ott 2026 è stato unanime. -->
        <div class="ex-ask" data-reveal data-reveal-delay="0.14">
          <div class="ex-ask-b">
            <T as="p" class="ex-ask-k" it="Su Target: chiudere un test" en="On Target: closing a test" />
            <T as="p" class="ex-ask-t" it="Il caso che avete scelto il 15 ottobre, portato dall’esempio al vostro primo test vero." en="The case you chose on 15 October, taken from the example to your first real test." />
          </div>
          <div class="ex-ask-b">
            <T as="p" class="ex-ask-k" it="Su CJA: il triage degli alert" en="On CJA: alert triage" />
            <T as="p" class="ex-ask-t" it="Quello che già fate incollando la mail in chat, misurato prima e dopo." en="What you already do by pasting the email into chat, measured before and after." />
          </div>
          <div class="ex-ask-b">
            <T as="p" class="ex-ask-k" it="Le date che proponiamo" en="The dates we propose" />
            <T as="p" class="ex-ask-t" it="5 novembre si prova il primo, 12 novembre si guarda a metà, a fine novembre il programma chiude." en="5 November we try the first, 12 November we look at the halfway point, end of November the programme closes." />
          </div>
        </div>
        <T as="p" class="ex-frase" it="Due numeri presi adesso, per rileggerli a fine novembre: quanto passa dalla domanda al verdetto su un test, e quanti alert arrivano in una settimana." en="Two numbers taken now, to read again at the end of November. How long from question to verdict on a test, and how many alerts arrive in a week." data-reveal data-reveal-delay="0.22" />
        <T as="p" class="ex-src" it="Le voci ancora aperte, con la data e chi le chiude, stanno nel capitolo successivo." en="The items still open, with their date and who closes them, are in the next chapter." data-reveal data-reveal-delay="0.3" />
      </div>
    </Slide>

    <Slide id="slide-firma" bg="inverse" align="center">
      <div slot="backdrop" class="ex-bg-night"></div>
      <div class="ex-cover-lockup" data-reveal>
        <CoBrand variant="hero" />
      </div>
      <T as="p" class="ex-sig-line" it="Cinque domande, e sono le vostre." en="Five questions, and they are yours." data-reveal data-reveal-delay="0.12" />
      <a class="ex-cta" href={href(base, '/')}>
        <span data-lang-it>Torna all'inizio</span><span data-lang-en>Back to the start</span>
      </a>
    </Slide>

  </DeckContainer>
</BaseLayout>
