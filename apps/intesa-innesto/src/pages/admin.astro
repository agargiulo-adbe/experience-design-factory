---
import BaseLayout from '../layouts/BaseLayout.astro';
import AdminConsole from '@edf/core/blocks/admin/AdminConsole.astro';
import { href } from '@edf/core/utils/url.js';
import { SITE } from '../data/site';

const base = import.meta.env.BASE_URL;
const SUPABASE_URL = import.meta.env.PUBLIC_SUPABASE_URL ?? '';
const SUPABASE_ANON_KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY ?? '';

interface SlideEntry { id: string; label: string; }
interface PageEntry { slug: string; label: string; slides: SlideEntry[]; }

// Ogni slide del deck, pagina per pagina: è ciò che il tab «Capitoli e slide»
// accende e spegne. Ogni <Slide id> nuova va registrata qui.
const PAGE_REGISTRY: PageEntry[] = [
  { slug: 'index', label: 'Dove ci innestiamo (00)', slides: [
    { id: 'slide-cover',    label: 'Cover — Dove ci innestiamo' },
    { id: 'slide-percorso', label: 'Il percorso — 6 capitoli' },
  ]},
  { slug: 'scenario', label: 'Quello che abbiamo capito di voi (01)', slides: [
    { id: 'slide-cover',      label: 'Cover — Quello che abbiamo capito di voi' },
    { id: 'slide-impianto',   label: 'L’impianto — tre mestieri, tre sistemi' },
    { id: 'slide-dove-siete', label: 'Il punto di partenza — le quattro cifre pubbliche' },
  ]},
  { slug: 'fondamenta', label: 'L’architettura (02)', slides: [
    { id: 'slide-cover',        label: 'Cover — L’architettura' },
    { id: 'slide-architettura', label: 'I tre strati — dove ci innestiamo' },
    { id: 'slide-arbitro',      label: 'Di chi è l’arbitro — le tre incognite' },
  ]},
  { slug: 'use-case', label: 'Audience e target (03)', slides: [
    { id: 'slide-cover',    label: 'Cover — Audience e target' },
    { id: 'slide-mestiere', label: 'Dove si sposta la decisione' },
    { id: 'slide-mutuo',    label: 'Il caso — la richiesta di mutuo che si ferma' },
  ]},
  { slug: 'convergenza', label: 'Oltre l’analisi (04)', slides: [
    { id: 'slide-cover',      label: 'Cover — Oltre l’analisi' },
    { id: 'slide-tre',        label: 'I tre pezzi che contano' },
    { id: 'slide-passaggio',  label: 'Il passaggio — cosa resta e cosa si rifà' },
    { id: 'slide-referenza',  label: 'Le referenze — Unipol e Santander Brasil' },
  ]},
  { slug: 'valore', label: 'Gli acceleratori (05)', slides: [
    { id: 'slide-cover',       label: 'Cover — Gli acceleratori' },
    { id: 'slide-decisioning', label: 'Decisioning — con riquadro demo' },
    { id: 'slide-coworker',    label: 'CX Enterprise Coworker — con riquadro demo' },
  ]},
  { slug: 'rotta', label: 'La rotta (06)', slides: [
    { id: 'slide-cover',     label: 'Cover — La rotta' },
    { id: 'slide-passi',     label: 'Tre cose che chiediamo, e una data' },
    { id: 'slide-signature', label: 'La firma — Adobe × Intesa Sanpaolo' },
  ]},
];

interface SolutionEntry {
  id: string; name: string; shortName: string;
  pillar: string; description: string; appearsIn: string[];
}

// I tre prodotti che il deck propone davvero, col nome per esteso e verificato.
// Marketing Campaign Analytics è FUORI per decisione del 24 ott 2026: non è di
// interesse dei due interlocutori del 5 novembre.
const SOLUTIONS: SolutionEntry[] = [
  { id: 'cja', name: 'Adobe Customer Journey Analytics', shortName: 'CJA', pillar: 'dato',
    description: 'Cuce digitale e offline sullo stesso cliente, porta fuori le audience e dà un peso ai passaggi.',
    appearsIn: ['L’architettura', 'Oltre l’analisi'] },
  { id: 'decisioning', name: 'Decisioning (add-on AJO)', shortName: 'Decisioning', pillar: 'decisione',
    description: 'L’anello che sceglie quale proposta esce adesso, dentro il percorso già deciso a monte.',
    appearsIn: ['L’architettura', 'Audience e target', 'Gli acceleratori'] },
  { id: 'coworker', name: 'Adobe CX Enterprise Coworker', shortName: 'Coworker', pillar: 'adozione',
    description: 'La domanda fatta a parole sull’istanza di Adobe Analytics già in uso, senza migrare nulla.',
    appearsIn: ['L’architettura', 'Gli acceleratori'] },
];

const PILLAR_LABELS: Record<string, string> = { piattaforma: 'Piattaforma' };
const PILLAR_ORDER = ['piattaforma'];
const PILLAR_COLORS: Record<string, string> = { piattaforma: '#258900' };

const solutionGroups = PILLAR_ORDER
  .map((pillar) => ({ pillar, label: PILLAR_LABELS[pillar], color: PILLAR_COLORS[pillar], solutions: SOLUTIONS.filter((s) => s.pillar === pillar) }))
  .filter((g) => g.solutions.length > 0);

const allSolutionIds = SOLUTIONS.map((s) => s.id);
const deckHref = href(base, '/');
// I dossier interni di questa experience, se ne ha: la console è il posto dove
// chi presenta trova il deck e il documento che prepara la stanza. Quando nasce
// un `dossier.astro`, si aggiunge qui — restano gated, il link non li apre.
const DOSSIERS: { href: string; label?: string }[] = [
  // { href: href(base, '/dossier'), label: 'Dossier interno' },
];
---
<BaseLayout title={`Console — ${SITE.name} · ${SITE.client}`}>
  <AdminConsole
    projectSlug={SITE.slug}
    projectName={SITE.name}
    clientLabel={`Adobe × ${SITE.client}`}
    deckHref={deckHref}
    dossiers={DOSSIERS}
    pages={PAGE_REGISTRY}
    solutionGroups={solutionGroups}
    allSolutionIds={allSolutionIds}
    supabaseUrl={SUPABASE_URL}
    supabaseAnonKey={SUPABASE_ANON_KEY}
  />
</BaseLayout>
