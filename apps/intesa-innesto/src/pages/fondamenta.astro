---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import T from '@edf/core/blocks/i18n/T.astro';
import { href } from '@edf/core/utils/url.js';
import { CHAPTERS, prevSlug, nextSlug } from '../data/chapters';
import { STRATI } from '../data/impianto';

const SLUG = 'fondamenta';
const ch = CHAPTERS.find((c) => c.slug === SLUG)!;
const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;

// Le tre incognite sull'arbitro. Le portiamo noi, dichiarate come nostre:
// subirle è peggio che proporle.
const INCOGNITE = [
  {
    t: { it: 'Chi lo governa', en: 'Who governs it' },
    b: {
      it: 'L’arbitro non è un secondo motore di propensione. Le regole, i tetti di contatto e le priorità restano una scelta vostra, e vanno scritte da qualcuno con un nome.',
      en: 'The arbiter is not a second propensity engine. Rules, contact caps and priorities stay your decision, and someone with a name has to write them.',
    },
  },
  {
    t: { it: 'Chi ne cambia le regole', en: 'Who changes its rules' },
    b: {
      it: 'Una regola che si cambia solo con un rilascio non serve. Serve capire chi la tocca, con quale approvazione e in quanto tempo.',
      en: 'A rule you can only change with a release is useless. What matters is who touches it, with whose sign-off, and how fast.',
    },
  },
  {
    t: { it: 'Chi risponde di cosa decide', en: 'Who answers for its decisions' },
    b: {
      it: 'Su una banca questa è la domanda vera, e non ha una risposta di prodotto. Va messa sul tavolo prima di accendere qualunque cosa.',
      en: 'In a bank this is the real question, and it has no product answer. It belongs on the table before anything is switched on.',
    },
  },
];
---
<BaseLayout title={ch.title.it}>
  <div class="fixed top-0 left-0 right-0 z-50">
    <Navigation currentPath={currentPath} base={base} />
  </div>

  <DeckContainer nextHref={href(base, nextSlug(SLUG))} prevHref={href(base, prevSlug(SLUG))}>

    <!-- ── Cover del capitolo ────────────────────────────────────────────── -->
    <Slide id="slide-cover" bg="inverse" align="center">
      <div slot="backdrop" class="ex-bg-night"></div>
      <div class="ex-ch" data-reveal>
        <p class="ex-ch-num"><span data-lang-it>Capitolo {ch.num}</span><span data-lang-en>Chapter {ch.num}</span></p>
        <T as="h2" class="ex-ch-title" it={ch.title.it} en={ch.title.en} data-reveal data-reveal-delay="0.08" />
        <T
          as="p"
          class="ex-ch-lead"
          it="Tre strati, dal basso. Il primo e il secondo sono vostri e restano vostri. Il terzo è quello che proponiamo, e sono componenti con un nome, non una direzione di marcia."
          en="Three layers, from the bottom up. The first two are yours and stay yours. The third is what we propose, and they are named components, not a direction of travel."
          data-reveal data-reveal-delay="0.15"
        />
        <div class="ex-ch-agenda" data-reveal data-reveal-delay="0.22">
          <T as="p" class="ex-ch-agenda-k" it="In questo capitolo" en="In this chapter" />
          <ul role="list">
            <li><span class="ex-ch-agenda-n" aria-hidden="true">1</span><T as="span" it="I tre strati, e dove ci attacchiamo" en="The three layers, and where we attach" /></li>
            <li><span class="ex-ch-agenda-n" aria-hidden="true">2</span><T as="span" it="Di chi è l’arbitro" en="Whose arbiter is it" /></li>
          </ul>
        </div>
      </div>
    </Slide>

    <!-- ── L'architettura ───────────────────────────────────────────────────
         ⚠️ BOZZA: da far validare all'architetto prima del 5 novembre.
         Diventerà il blocco `Blueprint` a fasi del motore (vedi la spec
         docs/superpowers/specs/2026-10-23-blueprint-animato-design.md): per
         questo gli strati arrivano già dai dati e non dal markup. -->
    <Slide id="slide-architettura" bg="primary" align="left">
      <div slot="backdrop" class="ex-bg-paper"></div>
      <div class="ex-content" data-reveal>
        <div class="ex-head">
          <T as="p" class="slide-eyebrow" it="L’architettura" en="The architecture" />
          <T as="h2" class="ex-head-title" it="Un anello in più, in cima a quello che gira già" en="One more link, on top of what already runs" />
        </div>
        <div class="ii-strati" data-reveal data-reveal-delay="0.12">
          {STRATI.map((s) => (
            <div class={`ii-strato${s.id === 'innesto' ? ' ii-strato--nostro' : ''}${s.id === 'vuoto' ? ' ii-strato--vuoto' : ''}`}>
              <div class="ii-strato-testa">
                <T as="p" class="ii-strato-k" it={s.k.it} en={s.k.en} />
                <T as="p" class="ii-strato-t" it={s.t.it} en={s.t.en} />
              </div>
              <div class="ii-pezzi">
                {s.pezzi.map((p) => (
                  <div class={`ii-pezzo${p.nostro ? ' ii-pezzo--nostro' : ''}`}>
                    <p class="ii-pezzo-n">{p.nome}</p>
                    <T as="p" class="ii-pezzo-b" it={p.nota.it} en={p.nota.en} />
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>
        <T
          as="p" class="ii-chiedi"
          it="La domanda di questo capitolo: questa lettura regge, vista da dentro? Dove è sbagliata, è lì che conviene fermarsi."
          en="The question of this chapter: does this reading hold up, seen from inside? Where it is wrong is where it pays to stop."
          data-reveal data-reveal-delay="0.26"
        />
      </div>
    </Slide>

    <!-- ── Di chi è l'arbitro ────────────────────────────────────────────── -->
    <Slide id="slide-arbitro" bg="secondary" align="left">
      <div slot="backdrop" class="ex-bg-paper"></div>
      <div class="ex-content" data-reveal>
        <div class="ex-head">
          <T as="p" class="slide-eyebrow" it="L’incognita" en="The open question" />
          <T as="h2" class="ex-head-title" it="Di chi è l’arbitro" en="Whose arbiter is it" />
          <T
            as="p"
            class="ex-head-lead"
            it="Un anello che sceglie fra più proposte concentra potere, e questa è l’obiezione che arriverebbe comunque. La portiamo noi, con le tre cose che non abbiamo ancora risolto."
            en="A link that picks between competing offers concentrates power, and that objection would land anyway. We bring it ourselves, with the three things we have not settled yet."
          />
        </div>
        <div class="ex-cards" data-reveal data-reveal-delay="0.14">
          {INCOGNITE.map((x) => (
            <div class="ex-card">
              <T as="p" class="ex-card-t" it={x.t.it} en={x.t.en} />
              <T as="p" class="ex-card-b" it={x.b.it} en={x.b.en} />
            </div>
          ))}
        </div>
        <T
          as="p" class="ex-src"
          it="I modelli di propensione restano i vostri e continuano a scegliere che cosa proporre. L’anello in più decide quale delle proposte esce adesso, su quel canale."
          en="Your propensity models stay yours and keep choosing what to propose. The extra link decides which of those proposals goes out now, on that channel."
          data-reveal data-reveal-delay="0.24"
        />
      </div>
    </Slide>

  </DeckContainer>
</BaseLayout>
