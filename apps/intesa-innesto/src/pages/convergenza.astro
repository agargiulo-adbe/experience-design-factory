---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import HowItWorks from '@edf/core/blocks/HowItWorks.astro';
import Dettaglio from '@edf/core/blocks/Dettaglio.astro';
import DettaglioVoce from '@edf/core/blocks/DettaglioVoce.astro';
import Figura from '../components/Figura.astro';
 import Motivo from '../components/Motivo.astro';
import sfondoCap from '../assets/generated/bg/cap-04.webp';
import T from '@edf/core/blocks/i18n/T.astro';
import { href } from '@edf/core/utils/url.js';
import { CHAPTERS, prevSlug, nextSlug } from '../data/chapters';

const SLUG = 'convergenza';
const ch = CHAPTERS.find((c) => c.slug === SLUG)!;
const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;
---
<BaseLayout title={ch.title.it}>
  <div class="fixed top-0 left-0 right-0 z-50">
    <Navigation currentPath={currentPath} base={base} />
  </div>

  <DeckContainer wallScale nextHref={href(base, nextSlug(SLUG))} prevHref={href(base, prevSlug(SLUG))}>

    <Slide id="slide-cover" bg="inverse" align="center" data-made-with="Adobe Firefly" data-made-with-for="sfondo">
      <Motivo capitolo="cucitura" sfondo={sfondoCap.src} slot="backdrop" />
      <div class="ex-ch" data-reveal>
        <p class="ex-ch-num"><span data-lang-it>Capitolo {ch.num}</span><span data-lang-en>Chapter {ch.num}</span></p>
        <T as="h2" class="ex-ch-title" it={ch.title.it} en={ch.title.en} data-reveal data-reveal-delay="0.08" />
        <p class="ex-ch-lead" data-reveal data-reveal-delay="0.15">
          <T as="span" class="ex-frase" it="Come strumento di analisi somiglia a quello che avete." en="As an analysis tool it resembles what you have." />{' '}
          <T as="span" class="ex-frase" it="La differenza è in tre cose." en="The difference is in three things." />
        </p>
      </div>
    </Slide>

    <Slide id="slide-tre" bg="primary" align="left">
      <div slot="backdrop" class="ex-bg-paper"></div>
      <div class="ex-content" data-reveal>
        <div class="ex-head">
          <T as="p" class="slide-eyebrow" it="Oltre l’analisi" en="Beyond analysis" />
          <T as="h2" class="ex-head-title" it="Tre cose che un rapporto non sa fare" en="Three things a report cannot do" />
        </div>
        <!-- Scena `datalake` del motore: i punti sparsi convergono e diventano
             profili. È «cucire la stessa persona», mostrato invece che detto. -->
        <figure class="ii-fig">
          <div class="ii-lago" data-datalake>
            <div class="ii-dots">
              <span class="data-dot ii-dot" data-dx="-57" data-dy="48" aria-hidden="true"></span>
              <span class="data-dot ii-dot" data-dx="-63" data-dy="-37" aria-hidden="true"></span>
              <span class="data-dot ii-dot" data-dx="-177" data-dy="-17" aria-hidden="true"></span>
              <span class="data-dot ii-dot" data-dx="203" data-dy="32" aria-hidden="true"></span>
              <span class="data-dot ii-dot" data-dx="193" data-dy="19" aria-hidden="true"></span>
              <span class="data-dot ii-dot" data-dx="102" data-dy="20" aria-hidden="true"></span>
              <span class="data-dot ii-dot" data-dx="-264" data-dy="57" aria-hidden="true"></span>
              <span class="data-dot ii-dot" data-dx="104" data-dy="43" aria-hidden="true"></span>
              <span class="data-dot ii-dot" data-dx="-228" data-dy="-99" aria-hidden="true"></span>
              <span class="data-dot ii-dot" data-dx="-167" data-dy="-37" aria-hidden="true"></span>
              <span class="data-dot ii-dot" data-dx="101" data-dy="-6" aria-hidden="true"></span>
              <span class="data-dot ii-dot" data-dx="102" data-dy="-53" aria-hidden="true"></span>
              <span class="data-dot ii-dot" data-dx="74" data-dy="39" aria-hidden="true"></span>
              <span class="data-dot ii-dot" data-dx="-106" data-dy="115" aria-hidden="true"></span>
              <span class="data-dot ii-dot" data-dx="99" data-dy="90" aria-hidden="true"></span>
              <span class="data-dot ii-dot" data-dx="-118" data-dy="-59" aria-hidden="true"></span>
              <span class="data-dot ii-dot" data-dx="-101" data-dy="-13" aria-hidden="true"></span>
              <span class="data-dot ii-dot" data-dx="132" data-dy="22" aria-hidden="true"></span>
              <span class="data-dot ii-dot" data-dx="-83" data-dy="-75" aria-hidden="true"></span>
              <span class="data-dot ii-dot" data-dx="-93" data-dy="91" aria-hidden="true"></span>
              <span class="data-dot ii-dot" data-dx="-158" data-dy="20" aria-hidden="true"></span>
              <span class="data-dot ii-dot" data-dx="73" data-dy="-107" aria-hidden="true"></span>
              <span class="data-dot ii-dot" data-dx="9" data-dy="98" aria-hidden="true"></span>
              <span class="data-dot ii-dot" data-dx="-305" data-dy="-20" aria-hidden="true"></span>
              <span class="data-dot ii-dot" data-dx="-21" data-dy="-67" aria-hidden="true"></span>
              <span class="data-dot ii-dot" data-dx="119" data-dy="-6" aria-hidden="true"></span>
              <span class="data-dot ii-dot" data-dx="-243" data-dy="58" aria-hidden="true"></span>
              <span class="data-dot ii-dot" data-dx="123" data-dy="73" aria-hidden="true"></span>
              <span class="data-dot ii-dot" data-dx="249" data-dy="26" aria-hidden="true"></span>
              <span class="data-dot ii-dot" data-dx="21" data-dy="-98" aria-hidden="true"></span>
              <span class="data-dot ii-dot" data-dx="119" data-dy="-50" aria-hidden="true"></span>
              <span class="data-dot ii-dot" data-dx="-80" data-dy="-94" aria-hidden="true"></span>
              <span class="data-dot ii-dot" data-dx="-179" data-dy="-41" aria-hidden="true"></span>
              <span class="data-dot ii-dot" data-dx="175" data-dy="-116" aria-hidden="true"></span>
            </div>
            <div class="ii-profili">
              <T as="p" class="profile-circle ii-profilo" it="Un cliente" en="One customer" />
              <T as="p" class="profile-circle ii-profilo" it="Un secondo" en="A second" />
              <T as="p" class="profile-circle ii-profilo" it="Un terzo" en="A third" />
            </div>
          </div>
          <figcaption class="ii-figcap">
            <span data-lang-it>Digitale, filiale e contatto assistito smettono di essere tre tracce e diventano una persona.</span>
            <span data-lang-en>Digital, branch and assisted contact stop being three trails and become one person.</span>
          </figcaption>
        </figure>
        <div class="ii-domande ii-domande--basse" data-stagger>
          <T as="p" class="ii-domanda" it="Cucire la stessa persona" en="Stitch the same person" />
          <T as="p" class="ii-domanda" it="Portare fuori le audience" en="Take audiences out" />
          <T as="p" class="ii-domanda" it="Dare un peso ai passaggi" en="Weight the steps" />
        </div>
        <div class="ii-dett" data-reveal data-reveal-delay="0.22">
          <HowItWorks title="Che cosa vuol dire, una per una" tone="onLight">
          <Dettaglio>
            <DettaglioVoce>
              <Figura k="a-ritroso" />
              <T slot="ancora" as="p" it="La storia ricostruita a ritroso" en="The story rebuilt backwards" />
              <T slot="riga" as="p" it="All’accensione si recuperano 13 o 25 mesi di storico secondo il pacchetto; a regime la finestra arriva a 30 giorni." en="Switching it on recovers 13 or 25 months of history depending on the package; in steady state the window reaches 30 days." />
            </DettaglioVoce>
            <DettaglioVoce>
              <Figura k="esce-dal-rapporto" />
              <T slot="ancora" as="p" it="Il segmento esce dal rapporto" en="The segment leaves the report" />
              <T slot="riga" as="p" it="Un’audience costruita sul comportamento omnicanale va verso i sistemi che fanno il contatto." en="An audience built on omnichannel behaviour goes out to the systems that make contact." />
            </DettaglioVoce>
            <DettaglioVoce>
              <Figura k="merito-distribuito" />
              <T slot="ancora" as="p" it="Il merito si distribuisce" en="Credit gets distributed" />
              <T slot="riga" as="p" it="Col solo digitale l’ultimo clic prende tutto. Sommando filiale e contatto assistito si vede quanto ha pesato ciascun passaggio." en="With digital alone the last click takes everything. Adding branch and assisted contact shows how much each step weighed." />
            </DettaglioVoce>
          </Dettaglio>
          </HowItWorks>
        </div>
        <p class="ex-src" data-reveal data-reveal-delay="0.3">
          <span data-lang-it>Prodotto: Adobe Customer Journey Analytics, </span>
          <span data-lang-en>Product: Adobe Customer Journey Analytics, </span>
          <a href="https://experienceleague.adobe.com/en/docs/analytics-platform/using/compare-aa-cja/upgrade-to-cja/cja-upgrade-recommendations" target="_blank" rel="noopener">experienceleague.adobe.com</a>
        </p>
      </div>
    </Slide>

    <Slide id="slide-passaggio" bg="secondary" align="left">
      <div slot="backdrop" class="ex-bg-paper"></div>
      <div class="ex-content" data-reveal>
        <div class="ex-head">
          <T as="p" class="slide-eyebrow" it="Il passaggio" en="The move" />
          <T as="h2" class="ex-head-title" it="Non è un rifacimento. Non è nemmeno gratis." en="Not a rebuild. Not free either." />
          <T as="p" class="ex-head-lead" it="Lo diciamo prima che lo chieda l’IT." en="We say it before IT asks." />
        </div>
        <div class="ii-due" data-reveal data-reveal-delay="0.14">
          <div class="ii-due-col ii-due-col--nostro">
            <T as="p" class="ii-due-k" it="Resta" en="Survives" />
            <ul role="list">
              <li><T as="span" it="Lo storico del tracciamento" en="Tracking history" /></li>
              <li><T as="span" it="Le stesse persone, lo stesso ambiente" en="Same people, same environment" /></li>
              <li><T as="span" it="La raccolta di oggi, col connettore Analytics" en="Today’s collection, via the Analytics connector" /></li>
            </ul>
          </div>
          <div class="ii-due-col">
            <T as="p" class="ii-due-k" it="Si rifà" en="Gets rebuilt" />
            <ul role="list">
              <li><T as="span" it="Segmenti e calcoli" en="Segments and calculations" /></li>
              <li><T as="span" it="L’arrivo dei dati offline" en="Bringing offline data in" /></li>
              <li><T as="span" it="Due ambienti, per il tempo del confronto" en="Two environments, while they run side by side" /></li>
              <li><T as="span" it="Una base Experience Platform sotto i due innesti" en="An Experience Platform foundation under both grafts" /></li>
            </ul>
          </div>
        </div>
        <div class="ii-dett" data-reveal data-reveal-delay="0.22">
          <HowItWorks title="Che cosa serve davvero, e a chi" tone="onLight">
          <Dettaglio>
            <DettaglioVoce>
              <Figura k="portato-e-rifatto" />
              <T slot="ancora" as="p" it="Lo storico si porta, i segmenti si rifanno" en="History travels, segments are rebuilt" />
              <T slot="riga" as="p" it="Chi lavora oggi in Workspace ritrova lo stesso ambiente. Segmenti e calcoli vanno ricostruiti nel nuovo modello di dati." en="Whoever works in Workspace today finds the same environment. Segments and calculations are rebuilt in the new data model." />
            </DettaglioVoce>
            <DettaglioVoce>
              <Figura k="dati-offline" />
              <T slot="ancora" as="p" it="La parte che chiede il vostro IT" en="The part that needs your IT" />
              <T slot="riga" as="p" it="Portare dentro i dati offline. È l’unico pezzo che non possiamo fare da soli." en="Bringing the offline data in. It is the one piece we cannot do on our own." />
            </DettaglioVoce>
            <DettaglioVoce>
              <Figura k="periodo-doppio" />
              <T slot="ancora" as="p" it="La finestra di sovrapposizione" en="The overlap window" />
              <T slot="riga" as="p" it="Per il tempo del confronto i due ambienti convivono. È una fase da mettere in conto, e si pianifica insieme." en="For the length of the comparison the two environments coexist. It is a phase to account for, and we plan it together." />
            </DettaglioVoce>
          </Dettaglio>
          </HowItWorks>
        </div>
      </div>
    </Slide>

    <!-- ⚠️ INTERNO: la referenza Unipol va concordata con quell'account prima
         di promettere documentazione condivisibile. In pagina solo il pubblico. -->
    <Slide id="slide-referenza" bg="primary" align="left">
      <div slot="backdrop" class="ex-bg-paper"></div>
      <div class="ex-content" data-reveal>
        <div class="ex-head">
          <T as="p" class="slide-eyebrow" it="Le referenze" en="References" />
          <T as="h2" class="ex-head-title" it="Due che hanno fatto questo passaggio" en="Two who have made this move" />
        </div>
        <div class="ii-ref" data-reveal data-reveal-delay="0.14">
          <div class="ii-ref-b">
            <p class="ii-ref-n">Gruppo Unipol</p>
            <T as="p" class="ii-ref-f" it="Da Adobe Analytics a CJA, con il CRM di un altro fornitore." en="From Adobe Analytics to CJA, with the CRM on another vendor." />
          </div>
          <div class="ii-ref-b">
            <p class="ii-ref-n">Santander Brasil</p>
            <T as="p" class="ii-ref-f" it="Oltre 100 milioni di profili in una vista sola, con Real-Time CDP e Customer Journey Analytics." en="Over 100 million profiles in a single view, with Real-Time CDP and Customer Journey Analytics." />
          </div>
        </div>
        <p class="ex-src" data-reveal data-reveal-delay="0.24">
          <span data-lang-it>Caso pubblicato da Adobe, </span><span data-lang-en>Case published by Adobe, </span>
          <a href="https://business.adobe.com/br/customer-success-stories/santander-case-study.html" target="_blank" rel="noopener">business.adobe.com</a>
          <span data-lang-it> · per Unipol stiamo verificando cosa è condivisibile.</span>
          <span data-lang-en> · for Unipol we are checking what can be shared.</span>
        </p>
      </div>
    </Slide>

  </DeckContainer>
</BaseLayout>
