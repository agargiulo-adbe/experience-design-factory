---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import T from '@edf/core/blocks/i18n/T.astro';
import { href } from '@edf/core/utils/url.js';
import { CHAPTERS, prevSlug, nextSlug } from '../data/chapters';
import { IMPIANTO, CIFRE } from '../data/impianto';

const SLUG = 'scenario';
const ch = CHAPTERS.find((c) => c.slug === SLUG)!;
const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;
---
<BaseLayout title={ch.title.it}>
  <div class="fixed top-0 left-0 right-0 z-50">
    <Navigation currentPath={currentPath} base={base} />
  </div>

  <DeckContainer nextHref={href(base, nextSlug(SLUG))} prevHref={href(base, prevSlug(SLUG))}>

    <!-- ── Cover del capitolo ────────────────────────────────────────────── -->
    <Slide id="slide-cover" bg="inverse" align="center">
      <div slot="backdrop" class="ex-bg-night"></div>
      <div class="ex-ch" data-reveal>
        <p class="ex-ch-num"><span data-lang-it>Capitolo {ch.num}</span><span data-lang-en>Chapter {ch.num}</span></p>
        <T as="h2" class="ex-ch-title" it={ch.title.it} en={ch.title.en} data-reveal data-reveal-delay="0.08" />
        <T
          as="p"
          class="ex-ch-lead"
          it="Lo diciamo noi per primi, con i vostri nomi e senza aggettivi. Se la lettura è sbagliata in un punto, quel punto è il più utile dell’ora."
          en="We say it first, using your own names and no adjectives. If this reading is wrong somewhere, that is the most useful minute of the hour."
          data-reveal data-reveal-delay="0.15"
        />
        <div class="ex-ch-agenda" data-reveal data-reveal-delay="0.22">
          <T as="p" class="ex-ch-agenda-k" it="In questo capitolo" en="In this chapter" />
          <ul role="list">
            <li><span class="ex-ch-agenda-n" aria-hidden="true">1</span><T as="span" it="L’impianto come lo vediamo da fuori" en="The stack as we see it from outside" /></li>
            <li><span class="ex-ch-agenda-n" aria-hidden="true">2</span><T as="span" it="Dove siete già arrivati" en="How far you have already come" /></li>
          </ul>
        </div>
      </div>
    </Slide>

    <!-- ── L'impianto ────────────────────────────────────────────────────── -->
    <Slide id="slide-impianto" bg="primary" align="left">
      <div slot="backdrop" class="ex-bg-paper"></div>
      <div class="ex-content" data-reveal>
        <div class="ex-head">
          <T as="p" class="slide-eyebrow" it="L’impianto" en="The stack" />
          <T as="h2" class="ex-head-title" it="Tre mestieri, tre sistemi, e un confine fra l’uno e l’altro" en="Three jobs, three systems, and a border between each pair" />
          <T
            as="p"
            class="ex-head-lead"
            it="Il dato del comportamento digitale sta in Adobe Analytics. I target si costruiscono nel CRM. I journey girano nei workflow di Salesforce Marketing Cloud. Ogni pezzo fa bene il suo mestiere, e il lavoro interessante è nei punti dove si passano la palla."
            en="Digital behaviour data sits in Adobe Analytics. Targets are built in the CRM. Journeys run inside Salesforce Marketing Cloud workflows. Each part does its own job well, and the interesting work is where they hand over to one another."
          />
        </div>
        <div class="ex-cards" data-reveal data-reveal-delay="0.14">
          {IMPIANTO.map((x) => (
            <div class="ex-card">
              <T as="p" class="ex-card-k" it={x.k.it} en={x.k.en} />
              <T as="p" class="ex-card-t" it={x.t.it} en={x.t.en} />
              <T as="p" class="ex-card-b" it={x.b.it} en={x.b.en} />
            </div>
          ))}
        </div>
        <T
          as="p" class="ex-src"
          it="Lettura nostra, costruita su quanto emerso nell’incontro del 22 ottobre 2026 e sul confronto interno con il team Adobe che segue l’account. Da correggere dove è sbagliata."
          en="Our own reading, built on what emerged in the 22 October 2026 meeting and on internal discussion with the Adobe account team. To be corrected where it is wrong."
          data-reveal data-reveal-delay="0.24"
        />
      </div>
    </Slide>

    <!-- ── Dove siete già arrivati ───────────────────────────────────────── -->
    <Slide id="slide-dove-siete" bg="secondary" align="left">
      <div slot="backdrop" class="ex-bg-paper"></div>
      <div class="ex-content" data-reveal>
        <div class="ex-head">
          <T as="p" class="slide-eyebrow" it="Il punto di partenza" en="The starting point" />
          <T as="h2" class="ex-head-title" it="Nessuno di questi numeri è nostro" en="None of these figures are ours" />
          <T
            as="p"
            class="ex-head-lead"
            it="Sono quattro cifre che il Gruppo ha dichiarato in pubblico. Le mettiamo in pagina perché dicono una cosa precisa: la partita non è più costruire il canale, è decidere che cosa farci passare."
            en="These are four figures the Group has stated publicly. They are on the page because they say something precise: the job is no longer building the channel, it is deciding what goes through it."
          />
        </div>
        <div class="ii-cifre" data-reveal data-reveal-delay="0.14">
          {CIFRE.map((c) => (
            <div class="ii-cifra">
              <p class="ii-cifra-n" data-display>{c.n}</p>
              <T as="p" class="ii-cifra-l" it={c.l.it} en={c.l.en} />
            </div>
          ))}
        </div>
        <p class="ex-src" data-reveal data-reveal-delay="0.24">
          <span data-lang-it>Fonte: Intesa Sanpaolo, piano d’impresa 2026-2029, </span>
          <span data-lang-en>Source: Intesa Sanpaolo, 2026-2029 business plan, </span>
          <a href="https://group.intesasanpaolo.com/en/newsroom/all-news/news/2026/business-plan-2026-2029-growth-strategy" target="_blank" rel="noopener">group.intesasanpaolo.com</a>
        </p>
      </div>
    </Slide>

  </DeckContainer>
</BaseLayout>
