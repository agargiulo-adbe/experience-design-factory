---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import MediaDemoSlot from '@edf/core/blocks/immersive/MediaDemoSlot.astro';
import HowItWorks from '@edf/core/blocks/HowItWorks.astro';
import Dettaglio from '@edf/core/blocks/Dettaglio.astro';
import DettaglioVoce from '@edf/core/blocks/DettaglioVoce.astro';
import Figura from '../components/Figura.astro';
import Motivo from '../components/Motivo.astro';
import sfondoCap from '../assets/generated/bg/cap-05.webp';
import T from '@edf/core/blocks/i18n/T.astro';
import { href } from '@edf/core/utils/url.js';
import { CHAPTERS, prevSlug, nextSlug } from '../data/chapters';

const SLUG = 'valore';
const ch = CHAPTERS.find((c) => c.slug === SLUG)!;
const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;

// I riquadri video si riempiono da /admin/ e viaggiano col link condivisibile.
// Finché sono vuoti restano segnaposto dichiarati, non buchi in pagina.
---
<BaseLayout title={ch.title.it}>
  <div class="fixed top-0 left-0 right-0 z-50">
    <Navigation currentPath={currentPath} base={base} />
  </div>

  <DeckContainer wallScale nextHref={href(base, nextSlug(SLUG))} prevHref={href(base, prevSlug(SLUG))}>

    <Slide id="slide-cover" bg="inverse" align="center" data-made-with="Adobe Firefly" data-made-with-for="sfondo">
      <Motivo capitolo="scelta" sfondo={sfondoCap.src} slot="backdrop" />
      <div class="ex-ch" data-reveal>
        <p class="ex-ch-num"><span data-lang-it>Capitolo {ch.num}</span><span data-lang-en>Chapter {ch.num}</span></p>
        <T as="h2" class="ex-ch-title" it={ch.title.it} en={ch.title.en} data-reveal data-reveal-delay="0.08" />
        <T as="p" class="ex-ch-lead"
          it="Due componenti, e nessuno dei due è il titolo di questo incontro."
          en="Two components, and neither of them is the headline of this meeting."
          data-reveal data-reveal-delay="0.15" />
      </div>
    </Slide>

    <Slide id="slide-decisioning" bg="primary" align="left">
      <div slot="backdrop" class="ex-bg-paper"></div>
      <div data-demo-flex class="ii-demo">
        <div class="ii-demo-testo" data-reveal>
          <T as="p" class="slide-eyebrow" it="L’anello" en="The link" />
          <T as="h2" class="ex-head-title" it="Decisioning" en="Decisioning" />
          <T as="p" class="ex-head-lead" it="Un add-on di Adobe Journey Optimizer: sceglie quale proposta esce adesso, dentro il ramo che avete già deciso." en="An Adobe Journey Optimizer add-on: it picks which proposal goes out now, inside the branch you already decided." />
          <!-- Scena `personalize` del motore (nativa nel deck, vedi playSlide):
               le proposte candidate compaiono tutte, poi tutte si attenuano
               tranne quella scelta. È l'argomento del prodotto, mostrato. -->
          <div class="ii-perso" data-personalize>
            <T as="p" class="perso-item ii-perso-i" it="Surroga" en="Remortgage" />
            <T as="p" class="perso-item ii-perso-i" it="Polizza casa" en="Home cover" />
            <T as="p" class="perso-item ii-perso-i ii-perso-i--match" data-match it="Richiamo entro oggi" en="Call back today" />
            <T as="p" class="perso-item ii-perso-i" it="Conto deposito" en="Savings account" />
            <T as="p" class="perso-item ii-perso-i" it="Carta" en="Card" />
            <T as="p" class="perso-item ii-perso-i" it="Nessun contatto" en="No contact" />
          </div>
          <T as="p" class="ii-perso-cap" it="Sei proposte dai vostri modelli. Ne esce una, e i tetti di contatto restano i vostri." en="Six proposals from your models. One goes out, and the contact caps stay yours." />
          <div class="ii-dett">
            <HowItWorks title="Dove vale e dove no" tone="onLight">
            <Dettaglio>
              <DettaglioVoce>
                <Figura k="dentro-e-fuori" />
                <T slot="ancora" as="p" it="Dentro la piattaforma, e fuori" en="Inside the platform, and outside" />
                <T slot="riga" as="p" it="Sportello, sportello automatico e contatti dovuti restano fuori. Il tetto di contatto che conta li somma comunque." en="Counter, ATM and mandatory contacts stay outside. The contact cap that matters adds them up anyway." />
              </DettaglioVoce>
            </Dettaglio>
            </HowItWorks>
          </div>
          <p class="ex-src">
            <span data-lang-it>Prodotto: </span><span data-lang-en>Product: </span>
            <a href="https://experienceleague.adobe.com/en/docs/journey-optimizer/using/decisioning/experience-decisioning/gs-experience-decisioning" target="_blank" rel="noopener">experienceleague.adobe.com</a>
          </p>
        </div>
        <MediaDemoSlot id="demo-ai-decisioning" label="Decisioning — la scelta dell’offerta al momento del contatto" placeholder />
      </div>
    </Slide>

    <Slide id="slide-coworker" bg="secondary" align="left">
      <div slot="backdrop" class="ex-bg-paper"></div>
      <div data-demo-flex class="ii-demo">
        <div class="ii-demo-testo" data-reveal>
          <T as="p" class="slide-eyebrow" it="Senza passare da nessuna parte" en="With nothing to migrate" />
          <T as="h2" class="ex-head-title" it="CX Enterprise Coworker" en="CX Enterprise Coworker" />
          <T as="p" class="ex-head-lead" it="Una domanda fatta a parole, sull’Adobe Analytics che avete oggi." en="A question asked in plain words, on the Adobe Analytics you have today." />
          <!-- Scena `converse` del motore: le battute compaiono una per volta,
               alternate. Coworker È una chat — mostrarla come elenco puntato
               era descrivere invece di far vedere. Dati dichiarati illustrativi. -->
          <div class="ii-chat" data-converse>
            <T as="p" class="chat-bubble ii-bolla ii-bolla--in" data-side="in"
              it="Quante richieste di mutuo si sono fermate al terzo passo la settimana scorsa?"
              en="How many mortgage applications stopped at step three last week?" />
            <T as="p" class="chat-bubble ii-bolla ii-bolla--out" data-side="out"
              it="1.284, in calo del 6% sulla settimana prima. Il 38% arriva dalla campagna di settembre."
              en="1,284, down 6% on the previous week. 38% come from the September campaign." />
            <T as="p" class="chat-bubble ii-bolla ii-bolla--in" data-side="in"
              it="Fammi il segmento di quelle con potenziale alto."
              en="Build me the segment of those with high potential." />
          </div>
          <T as="p" class="ii-chat-cap"
            it="Esempio illustrativo, su un’istanza dimostrativa. Non sono vostri dati."
            en="Illustrative example, on a demo instance. These are not your figures." />
          <div class="ii-dett">
            <HowItWorks title="A che punto è la distribuzione" tone="onLight">
            <Dettaglio>
              <DettaglioVoce>
                <Figura k="in-corso" />
                <T slot="ancora" as="p" it="Distribuzione in corso" en="Rollout under way" />
                <T slot="riga" as="p" it="Le date si confermano caso per caso: da verificare insieme, non da dare per fatta." en="Dates are confirmed case by case: to be checked together, not taken as done." />
              </DettaglioVoce>
              <T slot="nota" as="p" it="Si collega alle report suite di Adobe Analytics e chiede il permesso MCP Access sul profilo prodotto." en="It connects to Adobe Analytics report suites and needs the MCP Access permission on the product profile." />
            </Dettaglio>
            </HowItWorks>
          </div>
          <p class="ex-src">
            <span data-lang-it>Documentazione: </span><span data-lang-en>Documentation: </span>
            <a href="https://experienceleague.adobe.com/en/docs/coworker/content/chat/overview" target="_blank" rel="noopener">experienceleague.adobe.com</a>
          </p>
        </div>
        <MediaDemoSlot id="demo-coworker-analytics" label="CX Enterprise Coworker su Adobe Analytics" placeholder />
      </div>
    </Slide>

  </DeckContainer>
</BaseLayout>
