---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import MediaDemoSlot from '@edf/core/blocks/immersive/MediaDemoSlot.astro';
import HowItWorks from '@edf/core/blocks/HowItWorks.astro';
import T from '@edf/core/blocks/i18n/T.astro';
import { href } from '@edf/core/utils/url.js';
import { CHAPTERS, prevSlug, nextSlug } from '../data/chapters';

const SLUG = 'valore';
const ch = CHAPTERS.find((c) => c.slug === SLUG)!;
const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;

// I riquadri video si riempiono da /admin/ e viaggiano col link condivisibile.
// Finché sono vuoti restano segnaposto dichiarati, non buchi in pagina.
---
<BaseLayout title={ch.title.it}>
  <div class="fixed top-0 left-0 right-0 z-50">
    <Navigation currentPath={currentPath} base={base} />
  </div>

  <DeckContainer nextHref={href(base, nextSlug(SLUG))} prevHref={href(base, prevSlug(SLUG))}>

    <Slide id="slide-cover" bg="inverse" align="center">
      <div slot="backdrop" class="ex-bg-night"></div>
      <div class="ex-ch" data-reveal>
        <p class="ex-ch-num"><span data-lang-it>Capitolo {ch.num}</span><span data-lang-en>Chapter {ch.num}</span></p>
        <T as="h2" class="ex-ch-title" it={ch.title.it} en={ch.title.en} data-reveal data-reveal-delay="0.08" />
        <T as="p" class="ex-ch-lead"
          it="Due componenti, e nessuno dei due è il titolo di questo incontro."
          en="Two components, and neither of them is the headline of this meeting."
          data-reveal data-reveal-delay="0.15" />
      </div>
    </Slide>

    <Slide id="slide-decisioning" bg="primary" align="left">
      <div slot="backdrop" class="ex-bg-paper"></div>
      <div data-demo-flex class="ii-demo">
        <div class="ii-demo-testo" data-reveal>
          <T as="p" class="slide-eyebrow" it="L’anello" en="The link" />
          <T as="h2" class="ex-head-title" it="Adobe AI Decisioning" en="Adobe AI Decisioning" />
          <T as="p" class="ex-head-lead" it="Sceglie quale proposta esce adesso, dentro il ramo che avete già deciso." en="It picks which proposal goes out now, inside the branch you already decided." />
          <ul class="ii-lista" role="list">
            <li><T as="span" it="Non costruisce audience: le ordina" en="It does not build audiences: it ranks them" /></li>
            <li><T as="span" it="Rispetta i tetti di contatto che gli scrivete" en="It honours the contact caps you write for it" /></li>
            <li><T as="span" it="Restituisce l’esito per attributo" en="It returns results by attribute" /></li>
          </ul>
          <div class="ii-dett">
            <HowItWorks title="Dove vale e dove no" tone="onLight">
              <T as="p" it="Vale sui canali che passano dalla piattaforma. Sportello, sportello automatico e contatti dovuti restano fuori, e il tetto di contatto che conta li somma comunque." en="It applies to the channels that run through the platform. Counter, ATM and mandatory contacts stay outside, and the contact cap that matters adds them up anyway." />
            </HowItWorks>
          </div>
          <p class="ex-src">
            <span data-lang-it>Prodotto: </span><span data-lang-en>Product: </span>
            <a href="https://business.adobe.com/products/journey-optimizer/ai-decisioning.html" target="_blank" rel="noopener">business.adobe.com</a>
          </p>
        </div>
        <MediaDemoSlot id="demo-ai-decisioning" label="AI Decisioning — la scelta dell’offerta al momento del contatto" placeholder />
      </div>
    </Slide>

    <Slide id="slide-coworker" bg="secondary" align="left">
      <div slot="backdrop" class="ex-bg-paper"></div>
      <div data-demo-flex class="ii-demo">
        <div class="ii-demo-testo" data-reveal>
          <T as="p" class="slide-eyebrow" it="Senza passare da nessuna parte" en="With nothing to migrate" />
          <T as="h2" class="ex-head-title" it="CX Enterprise Coworker" en="CX Enterprise Coworker" />
          <T as="p" class="ex-head-lead" it="Una domanda fatta a parole, sull’Adobe Analytics che avete oggi." en="A question asked in plain words, on the Adobe Analytics you have today." />
          <ul class="ii-lista" role="list">
            <li><T as="span" it="Niente da migrare" en="Nothing to migrate" /></li>
            <li><T as="span" it="Chi fa i target smette di aspettare un rapporto" en="Whoever builds targets stops waiting for a report" /></li>
            <li><T as="span" it="La risposta porta la strada per rifarla in Workspace" en="The answer carries the path to rebuild it in Workspace" /></li>
          </ul>
          <div class="ii-dett">
            <HowItWorks title="A che punto è la distribuzione" tone="onLight">
              <T as="p" it="La distribuzione su Adobe Analytics è in corso e le date vanno confermate caso per caso: è una cosa da verificare insieme, non da dare per fatta." en="Rollout on Adobe Analytics is under way and dates are to be confirmed case by case: something to check together, not to take as done." />
            </HowItWorks>
          </div>
          <p class="ex-src">
            <span data-lang-it>Documentazione: </span><span data-lang-en>Documentation: </span>
            <a href="https://experienceleague.adobe.com/en/docs/coworker/content/chat/overview" target="_blank" rel="noopener">experienceleague.adobe.com</a>
          </p>
        </div>
        <MediaDemoSlot id="demo-coworker-analytics" label="CX Enterprise Coworker su Adobe Analytics" placeholder />
      </div>
    </Slide>

  </DeckContainer>
</BaseLayout>
