---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import T from '@edf/core/blocks/i18n/T.astro';
import { href } from '@edf/core/utils/url.js';
import { CHAPTERS, prevSlug, nextSlug } from '../data/chapters';
import CoBrand from '../components/CoBrand.astro';
import { EXPERIENCE_TYPES } from '@edf/core/data/experienceTypes';
import { SITE } from '../data/site';
const type = EXPERIENCE_TYPES[SITE.type];
const lcFirst = (s: string) => s.charAt(0).toLowerCase() + s.slice(1);
const SLUG = 'rotta';
const ch = CHAPTERS.find((c) => c.slug === SLUG)!;
const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;

// In pagina c'è solo quello che portiamo NOI. Nessun effort, nessuna giornata,
// nessun listino: decisione presa in sessione di lavoro il 21 ott 2026. Se la
// domanda arriva si risponde a voce, senza improvvisare un numero.
const PASSI = [
  {
    k: { it: 'Oggi, in questa stanza', en: 'Today, in this room' },
    t: { it: 'L’architettura validata o corretta', en: 'The architecture confirmed or corrected' },
    b: {
      it: 'I tre strati sono quelli giusti? Il punto di innesto è dove pensiamo? Un «no, funziona diversamente» detto qui vale più di un sì generico fra un mese.',
      en: 'Are the three layers right? Is the graft point where we think it is? A «no, it works differently» said here is worth more than a vague yes in a month.',
    },
  },
  {
    k: { it: 'Un percorso, non il tracciato', en: 'One journey, not the whole estate' },
    t: { it: 'Il mutuo, dalla prima visita alla pratica', en: 'The mortgage, from first visit to filed application' },
    b: {
      it: 'Un solo percorso su cui provare la cucitura del dato e la scelta dell’offerta. È abbastanza stretto da finirlo e abbastanza largo da attraversare tutti e tre gli strati.',
      en: 'One journey on which to test data stitching and offer selection. Narrow enough to finish, wide enough to cross all three layers.',
    },
  },
  {
    k: { it: 'Due nomi', en: 'Two names' },
    t: { it: 'Chi tiene il dato, chi tiene il targeting', en: 'Who owns the data, who owns the targeting' },
    b: {
      it: 'Mezza giornata tecnica con chi governa l’ingestione e con chi costruisce le audience. Da parte nostra ci sono l’architetto e il team che segue l’account.',
      en: 'Half a day of technical work with whoever governs ingestion and whoever builds the audiences. On our side, the architect and the account team.',
    },
  },
];
---
<BaseLayout title={ch.title.it}>
  <div class="fixed top-0 left-0 right-0 z-50">
    <Navigation currentPath={currentPath} base={base} />
  </div>

  <DeckContainer nextHref={href(base, nextSlug(SLUG))} prevHref={href(base, prevSlug(SLUG))}>

    <!-- ── Cover del capitolo ────────────────────────────────────────────── -->
    <Slide id="slide-cover" bg="inverse" align="center">
      <div slot="backdrop" class="ex-bg-night"></div>
      <div class="ex-ch" data-reveal>
        <p class="ex-ch-num"><span data-lang-it>Capitolo {ch.num}</span><span data-lang-en>Chapter {ch.num}</span></p>
        <T as="h2" class="ex-ch-title" it={ch.title.it} en={ch.title.en} data-reveal data-reveal-delay="0.08" />
        <T
          as="p"
          class="ex-ch-lead"
          it="Quello che chiediamo è piccolo di proposito: perimetrare una fase, su un percorso solo. Una fase portata a termine vale più di un programma annunciato."
          en="What we ask for is deliberately small: scope one phase, on one journey. A phase brought to a close is worth more than a programme announced."
          data-reveal data-reveal-delay="0.15"
        />
        <div class="ex-ch-agenda" data-reveal data-reveal-delay="0.22">
          <T as="p" class="ex-ch-agenda-k" it="In questo capitolo" en="In this chapter" />
          <ul role="list">
            <li><span class="ex-ch-agenda-n" aria-hidden="true">1</span><T as="span" it="Tre cose, e una data" en="Three things, and a date" /></li>
          </ul>
        </div>
      </div>
    </Slide>

    <!-- ── I passi ───────────────────────────────────────────────────────── -->
    <Slide id="slide-passi" bg="primary" align="left">
      <div slot="backdrop" class="ex-bg-paper"></div>
      <div class="ex-content" data-reveal>
        <div class="ex-head">
          <T as="p" class="slide-eyebrow" it="La rotta" en="The route" />
          <T as="h2" class="ex-head-title" it="Tre cose che chiediamo, e una data" en="Three things we ask for, and a date" />
          <T
            as="p"
            class="ex-head-lead"
            it="Nessun impegno da firmare e nessun programma da approvare. Tre cose concrete, e un ritrovo per dire cosa è stato fatto e quali risultati ha portato."
            en="Nothing to sign and no programme to approve. Three concrete things, and a date to come back and say what was done and what it produced."
          />
        </div>
        <div class="ex-cards" data-reveal data-reveal-delay="0.14">
          {PASSI.map((x) => (
            <div class="ex-card">
              <T as="p" class="ex-card-k" it={x.k.it} en={x.k.en} />
              <T as="p" class="ex-card-t" it={x.t.it} en={x.t.en} />
              <T as="p" class="ex-card-b" it={x.b.it} en={x.b.en} />
            </div>
          ))}
        </div>
        <T
          as="p" class="ii-chiedi"
          it="Se l’architettura regge, il resto è una mezza giornata di lavoro tecnico. Se non regge, l’ora di oggi è servita più di quanto ci aspettassimo."
          en="If the architecture holds, the rest is half a day of technical work. If it does not, this hour was worth more than we hoped."
          data-reveal data-reveal-delay="0.26"
        />
      </div>
    </Slide>

    <!-- ── Firma ─────────────────────────────────────────────────────────────
         Slide a sé per contratto co-brand; fallisce il check SOFT `i` di proposito
         (il lockup è un SVG, il parser non lo conta): non si aggiusta rimpicciolendo. -->
    <Slide id="slide-signature" bg="inverse" align="center">
      <div slot="backdrop" class="ex-bg-night"></div>
      <CoBrand variant="hero" data-reveal />
      <T
        as="p"
        class="ex-sig-line"
        it={`${SITE.name}. Il passo dopo: ${lcFirst(type.nextStep.it)}.`}
        en={`${SITE.name}. The next step: ${lcFirst(type.nextStep.en)}.`}
        data-reveal data-reveal-delay="0.1"
      />
      <a href={href(base, '/')} class="edf-sig-cta" data-reveal data-reveal-delay="0.18"><span data-lang-it>Torna all’inizio →</span><span data-lang-en>Back to the start →</span></a>
    </Slide>

  </DeckContainer>
</BaseLayout>
