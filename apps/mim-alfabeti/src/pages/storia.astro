<script is:inline>
  // Play-once backdrop videos (.alf-video--once): restart when their slide
  // becomes active, pause when leaving. One document-level listener that
  // survives ClientRouter swaps; identical in storia.astro and rotta.astro.
  (function () {
    if (window.__alfVideoOnceBound) return;
    window.__alfVideoOnceBound = true;
    function sync(activeId) {
      document.querySelectorAll('.alf-video--once').forEach(function (v) {
        var slide = v.closest('[data-slide]');
        var active = !!(slide && activeId && slide.id === activeId);
        if (active) {
          try { v.currentTime = 0; } catch (e) {}
          var p = v.play();
          if (p && p.catch) p.catch(function () {});
        } else if (!v.paused) {
          v.pause();
        }
      });
    }
    document.addEventListener('deck:change', function (e) {
      sync(e && e.detail ? e.detail.id : '');
    });
    document.addEventListener('astro:page-load', function () {
      var deck = window.__edfDeck;
      var s = deck && deck.slides && deck.slides[deck.index];
      if (s && s.id) sync(s.id);
    });
  })();
</script>
