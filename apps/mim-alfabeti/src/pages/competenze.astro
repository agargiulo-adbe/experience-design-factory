---
import BaseLayout from '../layouts/BaseLayout.astro';
import AlfabetiNavigation from '../components/AlfabetiNavigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import T from '@edf/core/blocks/i18n/T.astro';
import { href } from '@edf/core/utils/url.js';
import bgSoft from '../assets/generated/bg/soft-4.webp';
import { PROCESSES, STEPS, AUDIENCES, KPIS, SIMULATOR, processById } from '../data/simulator.config';

const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;

// Progressive enhancement: without JS the slide shows the default process
// journey (Immissioni in ruolo) and the three «—» tiles. JS takes over from there.
const defaultProcess = processById(SIMULATOR.defaultProcess)!;
const dedupIt = String(SIMULATOR.dedupFactor).replace('.', ',');
const dedupEn = String(SIMULATOR.dedupFactor);
---
<BaseLayout title="I processi" preloadImage={bgSoft.src}>
  <div class="fixed top-0 left-0 right-0 z-50">
    <AlfabetiNavigation currentPath={currentPath} base={base} />
  </div>

  <DeckContainer nextHref={href(base, '/accesso')} prevHref={href(base, '/voce')}>

    <Slide id="slide-builder" bg="secondary" align="split">
      <div slot="backdrop" class="alf-bg-soft" style={`--bg-src: url(${bgSoft.src})`}></div>
      <div slot="backdrop" class="alf-watermark" role="note">
        <span data-lang-it>Simulazione · parametri modificabili</span><span data-lang-en>Simulation · adjustable parameters</span>
      </div>

      <!-- min-h-full + shrink-0 (not h-full): on phones the content is taller than
           the split bound; a wrapper that shrinks to the bound would centre its
           overflow and push the head above the reachable scroll. -->
      <div class="w-full max-w-7xl mx-auto min-h-full shrink-0 flex flex-col justify-center">
        <div class="bld-head">
          <T as="p" en="The processes · journey builder · keys 1–5" it="I processi · journey builder · tasti 1–5" class="slide-eyebrow text-[var(--accent-primary)] mb-1" data-reveal />
          <T
            as="h2"
            en="Every process is a journey"
            it="Ogni processo è un journey"
            class="text-[var(--ink-primary)] font-[family-name:var(--font-display)]"
            style="font-size: clamp(1.5rem, 2.3vw, 2.2rem); font-weight: 600; line-height: 1.1; letter-spacing: -0.02em;"
            data-reveal data-reveal-delay="0.06"
          />
        </div>

        <!-- The builder: clicks/keys inside never advance the deck (data-deck-nochrome +
             capture-phase keydown below). ← → stay the presenter's escape hatch. -->
        <div
          class="bld"
          data-builder
          data-deck-nochrome
          data-process=""
          data-audience={SIMULATOR.defaultAudience}
        >
          <!-- Choose: process (keys 1–5) · audience -->
          <div class="bld-choose" data-reveal data-reveal-delay="0.1">
            <div class="alf-sim-chips" role="radiogroup" aria-label="Processo" data-chips="process">
              {PROCESSES.map((p, i) => (
                <button
                  type="button"
                  role="radio"
                  aria-checked="false"
                  data-chip={p.id}
                  tabindex={i === 0 ? 0 : -1}
                >
                  <span class="bld-chip-key" aria-hidden="true">{i + 1}</span>
                  <T en={p.label.en} it={p.label.it} />
                </button>
              ))}
            </div>
            <div class="bld-choose-aud">
              <p class="alf-sim-label" id="bld-aud-label">
                <span data-lang-it>Destinatari</span><span data-lang-en>Audience</span>
              </p>
              <div class="alf-sim-chips" role="radiogroup" aria-labelledby="bld-aud-label" data-chips="audience">
                {AUDIENCES.map((a) => (
                  <button
                    type="button"
                    role="radio"
                    aria-checked={a.id === SIMULATOR.defaultAudience ? 'true' : 'false'}
                    data-chip={a.id}
                    tabindex={a.id === SIMULATOR.defaultAudience ? 0 : -1}
                  >
                    <T en={a.label.en} it={a.label.it} />
                  </button>
                ))}
              </div>
            </div>
          </div>

          <div class="alf-sim">
            <!-- The journey -->
            <div class="alf-sim-panel" data-reveal data-reveal-delay="0.14">
              <p class="alf-sim-label" data-out-title>
                <span data-lang-it>Anteprima · {defaultProcess.label.it}</span><span data-lang-en>Preview · {defaultProcess.label.en}</span>
              </p>
              <ol class="alf-sim-timeline">
                {STEPS.map((s) => (
                  <li>
                    <span class="bld-step">
                      <span data-lang-it><b>{s.label.it}</b> · <span data-step-it={s.id}>{defaultProcess.steps[s.id].it}</span></span>
                      <span data-lang-en><b>{s.label.en}</b> · <span data-step-en={s.id}>{defaultProcess.steps[s.id].en}</span></span>
                    </span>
                  </li>
                ))}
              </ol>
            </div>

            <!-- The measure: reach → questions avoided · KPIs -->
            <div class="alf-sim-panel" data-reveal data-reveal-delay="0.18">
              <div>
                <div class="bld-reach-head">
                  <label for="bld-reach" class="bld-reach-label">
                    <span data-lang-it>Quota raggiunta sul canale istituzionale</span><span data-lang-en>Share reached on the institutional channel</span>
                  </label>
                  <output for="bld-reach" class="bld-reach-value" data-reach-out>{SIMULATOR.defaultReachPct}%</output>
                </div>
                <input
                  type="range"
                  class="alf-sim-range"
                  id="bld-reach"
                  min="0"
                  max="100"
                  step="5"
                  value={SIMULATOR.defaultReachPct}
                  aria-valuetext={`${SIMULATOR.defaultReachPct}%`}
                  data-reach
                />
              </div>

              <div class="bld-out" aria-live="polite">
                <p class="bld-out-value" data-out-value><span data-lang-it>—</span><span data-lang-en>—</span></p>
                <p class="bld-out-label">
                  <span data-lang-it>Domande ripetute evitate al help-desk · esempio</span><span data-lang-en>Repeated help-desk questions avoided · example</span>
                </p>
                <p class="bld-out-formula" data-out-formula>
                  <span data-lang-it>= base × quota × {dedupIt}</span><span data-lang-en>= baseline × share × {dedupEn}</span>
                </p>
              </div>

              <div class="alf-sim-kpis" aria-live="polite">
                {KPIS.map((k) => (
                  <div class="alf-sim-kpi">
                    <p class="alf-sim-kpi-value" data-kpi={k.id}>—</p>
                    <p class="alf-sim-kpi-label">
                      <span data-lang-it>{k.label.it}</span><span data-lang-en>{k.label.en}</span>
                      <span class="bld-kpi-note" data-kpi-note={k.id}><span data-lang-it>non misurato</span><span data-lang-en>not measured</span></span>
                    </p>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
    </Slide>

  </DeckContainer>
</BaseLayout>

<style is:global>
  /* ── slide-builder: journey builder (page-level tuning of the .alf-sim contract) ── */
  #slide-builder .bld-head { margin-bottom: 0.5rem; flex: 0 0 auto; }
  #slide-builder .bld { display: flex; flex-direction: column; gap: 0.6rem; min-width: 0; flex: 0 0 auto; }
  #slide-builder .bld-choose {
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.5rem 1.25rem; min-width: 0;
  }
  #slide-builder .bld-choose-aud { display: flex; align-items: center; flex-wrap: wrap; gap: 0.5rem 0.7rem; }
  #slide-builder .alf-sim { grid-template-columns: minmax(0, 1fr) minmax(0, 26rem); gap: 1.1rem; }
  @media (max-width: 1023px) { #slide-builder .alf-sim { grid-template-columns: 1fr; } }
  #slide-builder .alf-sim-panel { gap: 0.8rem; justify-content: flex-start; }
  #slide-builder .alf-sim-chips { gap: 0.4rem; }
  #slide-builder .alf-sim-chips [role="radio"] {
    display: inline-flex; align-items: center; gap: 0.4rem; min-height: 2.2rem; padding-inline: 0.7rem; white-space: nowrap;
  }
  #slide-builder .bld-chip-key {
    display: none; align-items: center; justify-content: center;
    width: 1.2rem; height: 1.2rem; border-radius: 4px; font-size: 0.72rem; font-weight: 700; line-height: 1;
    background: rgba(10, 26, 51, 0.08); color: var(--color-ardesia-700);
  }
  @media (min-width: 1440px) { #slide-builder .bld-chip-key { display: inline-flex; } }
  #slide-builder .alf-sim-chips [role="radio"][aria-checked="true"] .bld-chip-key { background: rgba(255, 255, 255, 0.22); color: #FFFFFF; }
  #slide-builder .alf-sim-chips [role="radio"]:focus-visible { outline: 3px solid var(--color-blu); outline-offset: 2px; }
  #slide-builder .bld-reach-head { display: flex; align-items: baseline; justify-content: space-between; gap: 0.8rem; margin-bottom: 0.55rem; }
  #slide-builder .bld-reach-label { font-size: 0.88rem; font-weight: 600; line-height: 1.35; color: var(--color-ardesia-700); }
  #slide-builder .bld-reach-value {
    font-family: var(--font-display); font-weight: 700; font-size: 1.05rem; line-height: 1; color: var(--color-blu);
    font-feature-settings: 'tnum' 1, 'lnum' 1; white-space: nowrap;
  }
  #slide-builder .bld-out { border-top: 1px solid rgba(10, 26, 51, 0.14); padding-top: 0.7rem; }
  #slide-builder .bld-out-value {
    font-family: var(--font-display); font-weight: 700; font-size: 1.9rem; line-height: 1; letter-spacing: -0.02em;
    color: var(--color-blu); font-feature-settings: 'tnum' 1, 'lnum' 1; max-width: none;
  }
  #slide-builder .bld-out-label { font-size: 0.85rem; line-height: 1.4; color: var(--color-ardesia-700); margin-top: 0.35rem; max-width: none; }
  #slide-builder .bld-out-formula {
    font-size: 0.85rem; line-height: 1.4; color: var(--color-ardesia-500); margin-top: 0.15rem; max-width: none;
    font-feature-settings: 'tnum' 1, 'lnum' 1;
  }
  /* The journey panel stretches to the measure panel's height: spread the four
     steps across it instead of leaving a hollow bottom at 1920. */
  #slide-builder .alf-sim-timeline { gap: 0.55rem; flex: 1 1 auto; justify-content: space-evenly; }
  #slide-builder .bld-step { display: block; min-width: 0; }
  #slide-builder .bld-step b { font-weight: 700; color: var(--color-inchiostro); }
  #slide-builder .alf-sim-kpis { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.55rem; }
  #slide-builder .alf-sim-kpi { padding: 0.6rem 0.7rem; }
  #slide-builder .bld-kpi-note { display: block; color: var(--color-ardesia-500); font-size: 0.78rem; }
  #slide-builder .alf-sim-label { max-width: none; }
  @media (max-width: 640px) {
    /* Phone: keep the watermark clear of the deck controls (bottom) and the
       scrolling panels: a small un-rotated tag under the nav, top-right. */
    #slide-builder .alf-watermark {
      right: 0.75rem; bottom: auto; top: 4.4rem; transform: none;
      font-size: 0.7rem; padding: 0.2rem 0.45rem; letter-spacing: 0.08em;
    }
    #slide-builder .alf-sim-chips [role="radio"] { white-space: normal; }
    #slide-builder .bld-head { padding-top: 1.7rem; }
  }
</style>

<script>
  import { PROCESSES, STEPS, KPIS, SIMULATOR, avoidedTickets, processById } from '../data/simulator.config';
  import type { AudienceId } from '../data/simulator.config';

  type Bilingual = { it: string; en: string };
  type Kind = 'process' | 'audience';

  // Thousands grouping by hand: ICU's it-IT skips the separator on 4-digit
  // numbers («6300»), and the formula must read the same way on every machine.
  const group = (n: number, sep: string) => String(Math.round(n)).replace(/\B(?=(\d{3})+(?!\d))/g, sep);
  const fmtIt = { format: (n: number) => group(n, '.') };
  const fmtEn = { format: (n: number) => group(n, ',') };
  const dedupIt = String(SIMULATOR.dedupFactor).replace('.', ',');
  const dedupEn = String(SIMULATOR.dedupFactor);

  function setLang(el: Element | null, text: Bilingual) {
    if (!el) return;
    const it = el.querySelector<HTMLElement>(':scope > [data-lang-it]');
    const en = el.querySelector<HTMLElement>(':scope > [data-lang-en]');
    if (it) it.textContent = text.it;
    if (en) en.textContent = text.en;
  }

  function syncGroup(builder: HTMLElement, kind: Kind, selected: string, fallbackTab: string) {
    builder.querySelectorAll<HTMLButtonElement>(`[data-chips="${kind}"] [role="radio"]`).forEach((chip) => {
      const id = chip.dataset.chip || '';
      const on = id === selected;
      chip.setAttribute('aria-checked', on ? 'true' : 'false');
      chip.tabIndex = on || (!selected && id === fallbackTab) ? 0 : -1;
    });
  }

  function render(builder: HTMLElement) {
    const pid = builder.dataset.process || '';
    const aid = (builder.dataset.audience || SIMULATOR.defaultAudience) as AudienceId;
    const chosen = pid !== '';
    const p = processById(pid) || processById(SIMULATOR.defaultProcess)!;

    syncGroup(builder, 'process', pid, SIMULATOR.defaultProcess);
    syncGroup(builder, 'audience', aid, SIMULATOR.defaultAudience);

    setLang(builder.querySelector('[data-out-title]'), chosen
      ? { it: `Journey · ${p.label.it}`, en: `Journey · ${p.label.en}` }
      : { it: `Anteprima · ${p.label.it}`, en: `Preview · ${p.label.en}` });
    STEPS.forEach((s) => {
      const it = builder.querySelector<HTMLElement>(`[data-step-it="${s.id}"]`);
      const en = builder.querySelector<HTMLElement>(`[data-step-en="${s.id}"]`);
      if (it) it.textContent = p.steps[s.id].it;
      if (en) en.textContent = p.steps[s.id].en;
    });

    KPIS.forEach((k) => {
      const v = builder.querySelector<HTMLElement>(`[data-kpi="${k.id}"]`);
      if (v) v.textContent = chosen ? `${p.kpi[k.id]}%` : '—';
      setLang(builder.querySelector(`[data-kpi-note="${k.id}"]`), chosen
        ? { it: 'esempio', en: 'example' }
        : { it: 'non misurato', en: 'not measured' });
    });

    const range = builder.querySelector<HTMLInputElement>('[data-reach]');
    const reach = range ? Number(range.value) : SIMULATOR.defaultReachPct;
    if (range) range.setAttribute('aria-valuetext', `${reach}%`);
    const reachOut = builder.querySelector<HTMLElement>('[data-reach-out]');
    if (reachOut) reachOut.textContent = `${reach}%`;

    if (chosen) {
      const baseline = p.baselineTickets[aid];
      const n = avoidedTickets(baseline, reach);
      setLang(builder.querySelector('[data-out-value]'), { it: fmtIt.format(n), en: fmtEn.format(n) });
      setLang(builder.querySelector('[data-out-formula]'), {
        it: `= ${fmtIt.format(baseline)} × ${reach}% × ${dedupIt}`,
        en: `= ${fmtEn.format(baseline)} × ${reach}% × ${dedupEn}`,
      });
    } else {
      setLang(builder.querySelector('[data-out-value]'), { it: '—', en: '—' });
      setLang(builder.querySelector('[data-out-formula]'), { it: `= base × quota × ${dedupIt}`, en: `= baseline × share × ${dedupEn}` });
    }
  }

  function select(builder: HTMLElement, kind: Kind, id: string, focus: boolean) {
    if (kind === 'process') builder.dataset.process = id; else builder.dataset.audience = id;
    render(builder);
    if (focus) builder.querySelector<HTMLButtonElement>(`[data-chips="${kind}"] [data-chip="${id}"]`)?.focus();
  }

  function moveInGroup(chip: HTMLButtonElement, delta: number) {
    const group = chip.closest<HTMLElement>('[data-chips]');
    const builder = chip.closest<HTMLElement>('[data-builder]');
    if (!group || !builder) return;
    const chips = Array.from(group.querySelectorAll<HTMLButtonElement>('[role="radio"]'));
    const i = chips.indexOf(chip);
    const next = chips[(i + delta + chips.length) % chips.length];
    select(builder, group.dataset.chips as Kind, next.dataset.chip || '', true);
  }

  function init() {
    document.querySelectorAll<HTMLElement>('[data-builder]').forEach((builder) => {
      render(builder);
      if (builder.dataset.bound) return;
      builder.dataset.bound = '1';
      // Touch inside the builder (dragging the slider) must not swipe the deck.
      const stop = (e: Event) => e.stopPropagation();
      builder.addEventListener('touchstart', stop, { passive: true });
      builder.addEventListener('touchend', stop, { passive: true });
    });
  }

  const w = window as Window & { __alfBuilderBound?: boolean };
  if (!w.__alfBuilderBound) {
    w.__alfBuilderBound = true;

    document.addEventListener('click', (e) => {
      const t = e.target as Element | null;
      const chip = t?.closest<HTMLButtonElement>('[data-builder] [role="radio"]');
      if (!chip) return;
      const group = chip.closest<HTMLElement>('[data-chips]');
      const builder = chip.closest<HTMLElement>('[data-builder]');
      if (!group || !builder) return;
      e.preventDefault();
      select(builder, group.dataset.chips as Kind, chip.dataset.chip || '', false);
    });

    document.addEventListener('input', (e) => {
      const t = e.target as Element | null;
      if (!t?.matches('[data-builder] [data-reach]')) return;
      const builder = t.closest<HTMLElement>('[data-builder]');
      if (builder) render(builder);
    });

    // Capture phase: keys handled inside the builder never reach the deck
    // controller (it listens on window). ← → are deliberately NOT intercepted:
    // they remain the presenter's slide keys everywhere.
    document.addEventListener('keydown', (e) => {
      const t = e.target as Element | null;
      const builder = t?.closest<HTMLElement>('[data-builder]');
      if (!builder || !t) return;

      if (/^[1-5]$/.test(e.key)) {
        const p = PROCESSES[Number(e.key) - 1];
        if (p) { e.preventDefault(); e.stopPropagation(); select(builder, 'process', p.id, true); }
        return;
      }

      const chip = t.closest<HTMLButtonElement>('[role="radio"]');
      if (chip) {
        if (e.key === 'ArrowDown') { e.preventDefault(); e.stopPropagation(); moveInGroup(chip, 1); return; }
        if (e.key === 'ArrowUp') { e.preventDefault(); e.stopPropagation(); moveInGroup(chip, -1); return; }
        if (e.key === ' ' || e.key === 'Spacebar' || e.key === 'Enter') {
          e.preventDefault(); e.stopPropagation();
          const group = chip.closest<HTMLElement>('[data-chips]');
          if (group) select(builder, group.dataset.chips as Kind, chip.dataset.chip || '', false);
          return;
        }
      }

      if (t.matches('[data-reach]')) {
        // ↑ ↓ PageUp PageDown: the native range handles them; keep them from the deck.
        if (e.key === 'ArrowUp' || e.key === 'ArrowDown' || e.key === 'PageUp' || e.key === 'PageDown') { e.stopPropagation(); return; }
        if (e.key === ' ' || e.key === 'Spacebar') { e.preventDefault(); e.stopPropagation(); return; }
      }
    }, true);

    document.addEventListener('astro:page-load', init);
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
  else init();
</script>
