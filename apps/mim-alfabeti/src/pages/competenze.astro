---
import BaseLayout from '../layouts/BaseLayout.astro';
import AlfabetiNavigation from '../components/AlfabetiNavigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import T from '@edf/core/blocks/i18n/T.astro';
import { href } from '@edf/core/utils/url.js';
import bgCarta from '../assets/generated/bg/carta-4.webp';
import bgSoft from '../assets/generated/bg/soft-4.webp';
import bgNavy from '../assets/generated/bg/navy-4.webp';

const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;

const journeys = [
  {
    label: { en: 'Tenure appointments', it: 'Immissioni in ruolo' },
    en: 'Trigger on the updated ranking; personalize by role and region; confirm the assignment — and know who was actually reached.',
    it: 'Si attiva sulla graduatoria aggiornata; personalizza per ruolo e regione; conferma la sede — e sa chi è stato davvero raggiunto.',
  },
  {
    label: { en: 'Mobility & transfers', it: 'Mobilità e cambio sede' },
    en: 'Window opening, deadline reminders, outcome: a time-boxed journey where a missed message is a missed year.',
    it: 'Apertura finestra, promemoria scadenze, esito: un journey a tempo dove un messaggio perso è un anno perso.',
  },
  {
    label: { en: 'Substitute assignments', it: 'Supplenze' },
    en: 'The highest-frequency, most error-prone communication the system runs — the one that gains most from automation and measurement.',
    it: 'La comunicazione più frequente e più esposta a errori di tutto il sistema — quella che guadagna di più da automazione e misura.',
  },
  {
    label: { en: 'GPS / GaE rankings', it: 'Graduatorie GPS/GaE' },
    en: 'Updates, corrections, standing changes — reaching the right person at the moment their position moves.',
    it: 'Aggiornamenti, rettifiche, variazioni di posizione — raggiungere la persona giusta nel momento in cui la sua posizione cambia.',
  },
  {
    label: { en: 'Training & duties', it: 'Formazione e adempimenti' },
    en: 'Deadlines, entitlements, mandatory steps — nudged in time, tracked to completion.',
    it: 'Scadenze, titoli, adempimenti obbligatori — sollecitati per tempo, tracciati fino al completamento.',
  },
];

const steps = [
  { n: '1', label: { en: 'Trigger', it: 'Innesco' }, en: 'The ranking is published or updated.', it: 'La graduatoria è pubblicata o aggiornata.' },
  { n: '2', label: { en: 'Journey', it: 'Journey' }, en: 'A personalized notice, a deadline reminder, the assignment confirmation — by role and region.', it: 'Un avviso personalizzato, un promemoria scadenza, la conferma della sede — per ruolo e regione.' },
  { n: '3', label: { en: 'Outcome', it: 'Esito' }, en: 'Delivered, opened, understood, acted on — measured, not assumed.', it: 'Recapitato, aperto, capito, seguito da un’azione — misurato, non supposto.' },
];
---
<BaseLayout title="I processi">
  <div class="fixed top-0 left-0 right-0 z-50">
    <AlfabetiNavigation currentPath={currentPath} base={base} />
  </div>

  <DeckContainer nextHref={href(base, '/storia')} prevHref={href(base, '/voce')}>

    <Slide id="slide-cover" bg="primary" align="center">
      <div slot="backdrop" class="alf-bg" style={`--bg-src: url(${bgCarta.src})`}></div>
      <div class="mx-auto w-full max-w-4xl flex flex-col items-center">
        <T as="p" en="The processes" it="I processi" class="slide-eyebrow text-center text-[var(--accent-primary)] mb-6" data-reveal />
        <T
          as="h1"
          en="Every process is a journey"
          it="Ogni processo è un journey"
          class="slide-title text-center text-[var(--ink-primary)] mb-6"
          style="font-size: clamp(2rem, 3.6vw, 3.4rem);"
          data-reveal data-reveal-delay="0.08"
        />
        <T
          as="p"
          en="The moments that decide a professional life — made personal, timely and measurable, one process at a time."
          it="I momenti che decidono una vita professionale — resi personali, tempestivi e misurabili, un processo alla volta."
          class="text-center text-[var(--ink-secondary)] mx-auto max-w-3xl"
          style="font-size: clamp(1.05rem, 1.35vw, 1.3rem); line-height: 1.55;"
          data-reveal data-reveal-delay="0.16"
        />
      </div>
    </Slide>

    <Slide id="slide-journeys" bg="secondary" align="left">
      <div slot="backdrop" class="alf-bg-soft" style={`--bg-src: url(${bgSoft.src})`}></div>
      <div class="w-full max-w-6xl mx-auto">
        <T as="p" en="Five processes, one model" it="Cinque processi, un modello" class="slide-eyebrow text-[var(--accent-primary)] mb-2" data-reveal />
        <T
          as="h2"
          en="The staff processes that most need a governed voice"
          it="I processi del personale che più hanno bisogno di una voce governata"
          class="text-[var(--ink-primary)] mb-6 font-[family-name:var(--font-display)]"
          style="font-size: clamp(1.6rem, 2.5vw, 2.3rem); font-weight: 600; line-height: 1.1; letter-spacing: -0.02em;"
          data-reveal data-reveal-delay="0.08"
        />
        <div class="alf-rows" data-stagger="0.09">
          {journeys.map((j) => (
            <div class="alf-row">
              <T as="p" en={j.label.en} it={j.label.it} class="alf-row-label" />
              <T as="p" en={j.en} it={j.it} class="alf-row-body" />
            </div>
          ))}
        </div>
      </div>
    </Slide>

    <Slide id="slide-example" bg="inverse" align="left">
      <div slot="backdrop" class="alf-bg-navy" style={`--bg-src: url(${bgNavy.src})`}></div>
      <div class="w-full max-w-6xl mx-auto">
        <T as="p" en="A worked journey — tenure appointment" it="Un journey concreto — immissione in ruolo" class="slide-eyebrow text-[var(--color-azzurro-chiaro)] mb-2" data-reveal />
        <T
          as="h2"
          en="From a ranking update to a confirmed seat"
          it="Dalla graduatoria aggiornata alla sede confermata"
          class="text-[var(--color-carta)] mb-6 font-[family-name:var(--font-display)]"
          style="font-size: clamp(1.6rem, 2.5vw, 2.3rem); font-weight: 600; line-height: 1.1; letter-spacing: -0.02em;"
          data-reveal data-reveal-delay="0.08"
        />
        <div class="grid grid-cols-1 md:grid-cols-3 gap-[clamp(0.8rem,1.1vw,1.1rem)]" data-stagger="0.1">
          {steps.map((s) => (
            <article class="alf-card">
              <span class="alf-mark">{s.n}</span>
              <T as="h3" en={s.label.en} it={s.label.it} class="alf-card-title" />
              <T as="p" en={s.en} it={s.it} class="alf-card-body" />
            </article>
          ))}
        </div>
        <div class="alf-quote alf-quote-navy mt-6" data-reveal data-reveal-delay="0.24">
          <T
            as="p"
            en="Same engine, every process. Build the journey once; reuse it across mobility, substitutes, rankings and training."
            it="Stesso motore, ogni processo. Il journey si costruisce una volta; si riusa su mobilità, supplenze, graduatorie e formazione."
            class="alf-quote-text"
            style="font-size: clamp(1rem, 1.3vw, 1.2rem); font-weight: 500;"
          />
        </div>
      </div>
    </Slide>

  </DeckContainer>
</BaseLayout>
