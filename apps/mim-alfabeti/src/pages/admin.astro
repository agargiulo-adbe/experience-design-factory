---
import BaseLayout from '../layouts/BaseLayout.astro';
import AdminConsole from '@edf/core/blocks/admin/AdminConsole.astro';
import { href } from '@edf/core/utils/url.js';

const base = import.meta.env.BASE_URL;
const SUPABASE_URL = import.meta.env.PUBLIC_SUPABASE_URL ?? '';
const SUPABASE_ANON_KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY ?? '';

interface SlideEntry { id: string; label: string; }
interface PageEntry { slug: string; label: string; slides: SlideEntry[]; }

const PAGE_REGISTRY: PageEntry[] = [
  { slug: 'mim-alfabeti', label: 'Apertura (00)', slides: [
    { id: 'slide-cover',  label: 'Cover — La voce del Ministero (video Firefly)' },
    { id: 'slide-thesis', label: 'La tesi + Orchestrare · Misurare · Governare' },
  ]},
  { slug: 'domanda', label: 'La domanda (01)', slides: [
    { id: 'slide-processes', label: 'I momenti che muovono una carriera (3 processi)' },
    { id: 'slide-scala',     label: 'La scala — 665.000 / 234.576 / 41.901 (grafico)' },
    { id: 'slide-questions', label: 'Tre domande, tre numeri che chiediamo (passi ↓)' },
  ]},
  { slug: 'storia', label: 'La storia di Giulia (02)', slides: [
    { id: 'slide-ponte',    label: 'Ponte — video, una docente tra 234.576' },
    { id: 'slide-ritratto', label: 'Giulia oggi — docente precaria di sostegno' },
    { id: 'slide-notte',    label: 'La notte di luglio — 3 battute sul telefono (passi ↓)' },
    { id: 'slide-evolve',   label: 'Come cambia — profilo governato + journey (passi ↓)' },
  ]},
  { slug: 'voce', label: 'La proposta (03)', slides: [
    { id: 'slide-why',   label: 'Lo spazio è libero, lo stack è pronto (ha già / manca)' },
    { id: 'slide-unica', label: 'Accanto a Piattaforma Unica, non al posto' },
  ]},
  { slug: 'competenze', label: 'I processi (04)', slides: [
    { id: 'slide-builder', label: 'Journey builder interattivo (5 processi × 3 audience, simulatore)' },
  ]},
  { slug: 'accesso', label: 'Governance (05)', slides: [
    { id: 'slide-procurement', label: 'Già acquistabile — ACN SA-3795/3799/3973/3798 + Consip' },
    { id: 'slide-trust',       label: 'Tre garanzie sul dato del personale (passi ↓)' },
  ]},
  { slug: 'persone', label: 'La misura (06)', slides: [
    { id: 'slide-metrics',  label: 'Cinque misure con CJA' },
    { id: 'slide-segments', label: 'Le persone dietro i profili + schede dato' },
  ]},
  { slug: 'rotta', label: 'La rotta (07)', slides: [
    { id: 'slide-route', label: 'Un percorso, quattro passi + prossimo passo' },
    { id: 'slide-close', label: 'In un respiro (video, tricolore)' },
  ]},
];

interface SolutionEntry {
  id: string; name: string; shortName: string;
  pillar: string; description: string; appearsIn: string[];
}

// L'esperienza customer-facing non ha gating pubblico di sezioni: il materiale
// interno vive nel dossier riservato (/dossier/?t=<token>), non nel deck.
const SOLUTIONS: SolutionEntry[] = [];

const PILLAR_LABELS: Record<string, string> = {
  audience: 'Gating pubblico',
};
const PILLAR_ORDER = ['audience'];
const PILLAR_COLORS: Record<string, string> = {
  audience: '#0B4DA2',
};

const solutionGroups = PILLAR_ORDER
  .map((pillar) => ({
    pillar,
    label: PILLAR_LABELS[pillar],
    color: PILLAR_COLORS[pillar],
    solutions: SOLUTIONS.filter((s) => s.pillar === pillar),
  }))
  .filter((g) => g.solutions.length > 0);

const allSolutionIds = SOLUTIONS.map((s) => s.id);
const deckHref = href(base, '/');
---
<BaseLayout title="Console — Alfabeti">
  <AdminConsole
    projectSlug="mim-alfabeti"
    projectName="Alfabeti — MIM × Adobe"
    clientLabel="Adobe — interno"
    deckHref={deckHref}
    pages={PAGE_REGISTRY}
    solutionGroups={solutionGroups}
    allSolutionIds={allSolutionIds}
    supabaseUrl={SUPABASE_URL}
    supabaseAnonKey={SUPABASE_ANON_KEY}
  />
</BaseLayout>
