---
import BaseLayout from '../layouts/BaseLayout.astro';
import AdminConsole from '@edf/core/blocks/admin/AdminConsole.astro';
import { href } from '@edf/core/utils/url.js';

const base = import.meta.env.BASE_URL;
const SUPABASE_URL = import.meta.env.PUBLIC_SUPABASE_URL ?? '';
const SUPABASE_ANON_KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY ?? '';

interface SlideEntry { id: string; label: string; }
interface PageEntry { slug: string; label: string; slides: SlideEntry[]; }

const PAGE_REGISTRY: PageEntry[] = [
  { slug: 'mim-alfabeti', label: 'Apertura (00)', slides: [
    { id: 'slide-cover',   label: 'Cover — La voce del Ministero' },
    { id: 'slide-thesis',  label: 'La tesi (la prima porta non è la classe)' },
    { id: 'slide-pillars', label: 'Orchestrare · Misurare · Governare' },
  ]},
  { slug: 'domanda', label: 'La domanda (01)', slides: [
    { id: 'slide-cover',     label: 'Cover — Come parla il Ministero al personale' },
    { id: 'slide-processes', label: 'Tre processi, un problema' },
    { id: 'slide-questions', label: 'Tre domande sulla misura' },
  ]},
  { slug: 'voce', label: 'La proposta (02)', slides: [
    { id: 'slide-cover', label: 'Cover — Lo spazio è libero, lo stack è pronto' },
    { id: 'slide-why',   label: 'Perché funziona qui (ACN, spazio libero, coesistenza)' },
    { id: 'slide-how',   label: 'Come funziona (CDP → AJO → CJA)' },
  ]},
  { slug: 'competenze', label: 'I processi (03)', slides: [
    { id: 'slide-cover',    label: 'Cover — Ogni processo è un journey' },
    { id: 'slide-journeys', label: 'Cinque processi (immissioni, mobilità, supplenze, GPS/GaE, formazione)' },
    { id: 'slide-example',  label: 'Journey concreto — immissione in ruolo' },
  ]},
  { slug: 'accesso', label: 'Governance (04)', slides: [
    { id: 'slide-cover',        label: 'Cover — Già acquistabile, governato per costruzione' },
    { id: 'slide-procurement',  label: 'Stack ACN-qualificato + veicoli d’acquisto' },
    { id: 'slide-trust',        label: 'Perimetro-dati, uso istituzionale, privacy by design' },
  ]},
  { slug: 'persone', label: 'La misura (05)', slides: [
    { id: 'slide-cover',     label: 'Cover — Ciò che non si è mai misurato' },
    { id: 'slide-metrics',   label: 'Cinque misure con CJA' },
    { id: 'slide-segments',  label: 'Docenti · Dirigenti · ATA (audience RT-CDP)' },
  ]},
  { slug: 'rotta', label: 'La rotta (06)', slides: [
    { id: 'slide-route', label: 'Un percorso, quattro passi' },
    { id: 'slide-close', label: 'In un respiro' },
  ]},
];

interface SolutionEntry {
  id: string; name: string; shortName: string;
  pillar: string; description: string; appearsIn: string[];
}

// L'esperienza customer-facing non ha gating pubblico di sezioni: il materiale
// interno vive nel dossier riservato (/dossier/?t=<token>), non nel deck.
const SOLUTIONS: SolutionEntry[] = [];

const PILLAR_LABELS: Record<string, string> = {
  audience: 'Gating pubblico',
};
const PILLAR_ORDER = ['audience'];
const PILLAR_COLORS: Record<string, string> = {
  audience: '#0B4DA2',
};

const solutionGroups = PILLAR_ORDER
  .map((pillar) => ({
    pillar,
    label: PILLAR_LABELS[pillar],
    color: PILLAR_COLORS[pillar],
    solutions: SOLUTIONS.filter((s) => s.pillar === pillar),
  }))
  .filter((g) => g.solutions.length > 0);

const allSolutionIds = SOLUTIONS.map((s) => s.id);
const deckHref = href(base, '/');
---
<BaseLayout title="Console — Alfabeti">
  <AdminConsole
    projectSlug="mim-alfabeti"
    projectName="Alfabeti — MIM × Adobe"
    clientLabel="Adobe — interno"
    deckHref={deckHref}
    pages={PAGE_REGISTRY}
    solutionGroups={solutionGroups}
    allSolutionIds={allSolutionIds}
    supabaseUrl={SUPABASE_URL}
    supabaseAnonKey={SUPABASE_ANON_KEY}
  />
</BaseLayout>
