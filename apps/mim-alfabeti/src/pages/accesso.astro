---
import BaseLayout from '../layouts/BaseLayout.astro';
import AlfabetiNavigation from '../components/AlfabetiNavigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import T from '@edf/core/blocks/i18n/T.astro';
import { href } from '@edf/core/utils/url.js';

const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;
---
<BaseLayout title="Accesso e documenti">
  <div class="fixed top-0 left-0 right-0 z-50">
    <AlfabetiNavigation currentPath={currentPath} base={base} />
  </div>

  <DeckContainer nextHref={href(base, '/persone')} prevHref={href(base, '/competenze')}>

    <Slide id="slide-cover" bg="primary" align="center">
      <div slot="backdrop" class="alf-bg"></div>
      <div class="mx-auto w-full max-w-4xl flex flex-col items-center">
        <T as="p" en="Ideas 3-4 · Access and documents" it="Idee 3-4 · Accesso e documenti" class="slide-eyebrow text-center text-[var(--accent-primary)] mb-6" data-reveal />
        <T
          as="h1"
          en="Where the law is the buyer"
          it="Dove la norma è il committente"
          class="slide-title text-center text-[var(--ink-primary)] mb-6"
          style="font-size: clamp(2rem, 3.6vw, 3.4rem);"
          data-reveal data-reveal-delay="0.08"
        />
        <T
          as="p"
          en="An honest read of two ideas: one carried by a compliance duty, two that must be repositioned to survive PA procurement."
          it="Una lettura onesta di due idee: una spinta da un obbligo di conformità, due che vanno riposizionate per superare il procurement PA."
          class="text-center text-[var(--ink-secondary)] mx-auto max-w-3xl"
          style="font-size: clamp(1.05rem, 1.35vw, 1.3rem); line-height: 1.55;"
          data-reveal data-reveal-delay="0.16"
        />
      </div>
    </Slide>

    <Slide id="slide-accessibility" bg="secondary" align="left">
      <div slot="backdrop" class="alf-bg-soft"></div>
      <div class="w-full max-w-6xl mx-auto">
        <T as="p" en="A4 · Accessible by duty" it="A4 · Accessibili per obbligo" class="slide-eyebrow text-[var(--accent-primary)] mb-2" data-reveal />
        <T
          as="h2"
          en="Acrobat & Sign for accessible administrative documents"
          it="Acrobat e Sign per i documenti amministrativi accessibili"
          class="text-[var(--ink-primary)] mb-6 font-[family-name:var(--font-display)]"
          style="font-size: clamp(1.7rem, 2.6vw, 2.4rem); font-weight: 600; line-height: 1.1; letter-spacing: -0.02em;"
          data-reveal data-reveal-delay="0.08"
        />
        <div class="grid grid-cols-1 md:grid-cols-2 gap-[clamp(0.8rem,1.1vw,1.1rem)]" data-reveal data-reveal-delay="0.16">
          <article class="alf-panel">
            <p class="alf-tag mb-2"><T en="The lever" it="La leva" /></p>
            <T as="p" en="The European Accessibility Act carries obligations and sanctions from 28 Jun 2025. School PA must produce accessible PDFs — remediation, signing, document workflows across offices, USR and leadership." it="L'European Accessibility Act porta obblighi e sanzioni dal 28 giu 2025. La PA scuola deve produrre PDF accessibili — remediation, firma, workflow documentali di segreterie, USR e dirigenza." class="alf-panel-body" style="margin-bottom:0;" />
          </article>
          <article class="alf-panel">
            <p class="alf-tag mb-2"><T en="The tool" it="Lo strumento" /></p>
            <T as="p" en="Acrobat — now Acrobat Studio + PDF Spaces (Aug 2025) — and Adobe Sign fit the workflow directly. A compliance duty, not a nice-to-have." it="Acrobat — oggi Acrobat Studio + PDF Spaces (ago 2025) — e Adobe Sign si innestano direttamente nel workflow. Un obbligo di conformità, non un di più." class="alf-panel-body" style="margin-bottom:0;" />
          </article>
        </div>
        <p class="alf-src mt-4" data-reveal data-reveal-delay="0.24">
          Fonti · agid.gov.it (EAA/accessibilità) · agendadigitale.eu (obblighi e sanzioni dal 28/06/2025) · news.adobe.com (Acrobat Studio)
        </p>
      </div>
    </Slide>

    <Slide id="slide-reposition" bg="primary" align="left">
      <div slot="backdrop" class="alf-bg"></div>
      <div class="w-full max-w-6xl mx-auto">
        <T as="p" en="B2-B3 · Reposition, don't sell head-on" it="B2-B3 · Riposizionare, non vendere frontalmente" class="slide-eyebrow text-[var(--accent-primary)] mb-2" data-reveal />
        <T
          as="h2"
          en="Websites and LMS meet free public assets"
          it="Siti web e LMS incontrano asset pubblici gratuiti"
          class="text-[var(--ink-primary)] mb-6 font-[family-name:var(--font-display)]"
          style="font-size: clamp(1.7rem, 2.6vw, 2.4rem); font-weight: 600; line-height: 1.1; letter-spacing: -0.02em;"
          data-reveal data-reveal-delay="0.08"
        />
        <div class="alf-rows" data-reveal data-reveal-delay="0.16">
          <div class="alf-row">
            <T as="p" en="AEM · websites" it="AEM · siti web" class="alf-row-label" />
            <T as="p" en="Against the free open-source “Modello Scuole” and art. 68 CAD (reuse/open-source first), AEM can't win the base site. Sell only what the free model can't do: central DAM, personalization, multi-site analytics, a governed central hub." it="Contro il «Modello Scuole» gratuito open-source e l'art. 68 CAD (prima riuso/open-source), AEM non vince sul sito base. Vendere solo ciò che il modello gratuito non copre: DAM centrale, personalizzazione, analytics multi-sito, un hub centrale governato." class="alf-row-body" />
          </div>
          <div class="alf-row">
            <T as="p" en="Learning Manager · LMS" it="Learning Manager · LMS" class="alf-row-label" />
            <T as="p" en="S.O.F.I.A. gatekeeps who delivers teacher training — but it governs providers/content, not the tool. Position Adobe Learning Manager under an already-accredited body (INDIRE or an accredited SI), never as a direct provider." it="S.O.F.I.A. controlla chi eroga formazione docenti — ma regola provider/contenuti, non lo strumento. Posizionare Adobe Learning Manager sotto un ente già accreditato (INDIRE o un SI accreditato), mai come erogatore diretto." class="alf-row-body" />
          </div>
        </div>
        <p class="alf-src mt-4" data-reveal data-reveal-delay="0.24">
          Fonti · designers.italia.it/modelli/scuole · docs.italia.it (art.68 CAD) · sofia.istruzione.it · <span class="alf-chip alf-chip--inf">INF</span> riposizionamento
        </p>
      </div>
    </Slide>

  </DeckContainer>
</BaseLayout>
