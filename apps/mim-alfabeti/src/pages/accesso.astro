---
import BaseLayout from '../layouts/BaseLayout.astro';
import AlfabetiNavigation from '../components/AlfabetiNavigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import T from '@edf/core/blocks/i18n/T.astro';
import { href } from '@edf/core/utils/url.js';
import bgCarta from '../assets/generated/bg/carta-6.webp';
import bgSoft from '../assets/generated/bg/soft-6.webp';
import bgNavy from '../assets/generated/bg/navy-6.webp';

const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;

const stack = [
  { name: 'Journey Optimizer', sa: 'SA-3795' },
  { name: 'Customer Journey Analytics', sa: 'SA-3799' },
  { name: 'Real-Time CDP', sa: 'SA-3973' },
  { name: 'Adobe Target', sa: 'SA-3798' },
];

const routes = [
  {
    label: { en: 'Cloud services', it: 'Servizi cloud' },
    en: 'AEP / AJO / CJA / RT-CDP route through Cloud-PA, the ACN-qualified catalog / MEPA, or PNRR M4C1 tenders.',
    it: 'AEP / AJO / CJA / RT-CDP passano da Cloud-PA, dal catalogo ACN-qualificato / MEPA, oppure dalle gare PNRR M4C1.',
  },
  {
    label: { en: 'Licenses', it: 'Licenze' },
    en: 'Creative Cloud / Acrobat / Express via the Consip multibrand ed.7 agreement, Lot 7 “Adobe products and related services” (€30M).',
    it: 'Creative Cloud / Acrobat / Express via la Convenzione Consip multibrand ed.7, Lotto 7 «Prodotti Adobe e servizi connessi» (€30M).',
  },
];

const trust = [
  {
    label: { en: 'Data perimeter', it: 'Perimetro dati' },
    en: 'Perimeter and legal basis defined up front. The ACN qualification covers ordinary data; for sensitive staff data the perimeter is agreed before any journey goes live.',
    it: 'Perimetro e base giuridica definiti a monte. La qualificazione ACN copre i dati ordinari; per i dati sensibili del personale il perimetro è concordato prima di attivare qualsiasi journey.',
  },
  {
    label: { en: 'Institutional use', it: 'Uso istituzionale' },
    en: 'Institutional communication, not marketing. The same orchestration engine serving administrative purposes — on a clear legal basis, with staff privacy at the centre.',
    it: 'Comunicazione istituzionale, non marketing. Lo stesso motore di orchestrazione al servizio di finalità amministrative, su base giuridica e con la privacy del personale al centro.',
  },
  {
    label: { en: 'Privacy by design', it: 'Privacy by design' },
    en: '“Your data is your data”: role-based profiles, and the institution in control of what is sent and measured — aligned with GDPR, the Garante and the EU AI Act.',
    it: '«I tuoi dati sono i tuoi dati»: profili basati sul ruolo, e l’istituzione in controllo di ciò che si invia e si misura — in linea con GDPR, Garante ed EU AI Act.',
  },
];
---
<BaseLayout title="Governance e acquisto">
  <div class="fixed top-0 left-0 right-0 z-50">
    <AlfabetiNavigation currentPath={currentPath} base={base} />
  </div>

  <DeckContainer nextHref={href(base, '/persone')} prevHref={href(base, '/storia')}>

    <Slide id="slide-cover" bg="primary" align="center">
      <div slot="backdrop" class="alf-bg" style={`--bg-src: url(${bgCarta.src})`}></div>
      <div class="mx-auto w-full max-w-4xl flex flex-col items-center">
        <T as="p" en="Governance & procurement" it="Governance e acquisto" class="slide-eyebrow text-center text-[var(--accent-primary)] mb-6" data-reveal />
        <T
          as="h1"
          en="Already procurable, governed by design"
          it="Già acquistabile, governato per costruzione"
          class="slide-title text-center text-[var(--ink-primary)] mb-6"
          style="font-size: clamp(2rem, 3.6vw, 3.4rem);"
          data-reveal data-reveal-delay="0.08"
        />
        <T
          as="p"
          en="The two questions a digital-and-data owner asks first: can we buy it through the right vehicle, and can we trust it with staff data?"
          it="Le due domande che l’owner del digitale e dei dati fa per prime: possiamo acquistarlo con il veicolo giusto, e possiamo affidargli i dati del personale?"
          class="text-center text-[var(--ink-secondary)] mx-auto max-w-3xl"
          style="font-size: clamp(1.05rem, 1.35vw, 1.3rem); line-height: 1.55;"
          data-reveal data-reveal-delay="0.16"
        />
      </div>
    </Slide>

    <Slide id="slide-procurement" bg="secondary" align="left">
      <div slot="backdrop" class="alf-bg-soft" style={`--bg-src: url(${bgSoft.src})`}></div>
      <div class="w-full max-w-6xl mx-auto">
        <T as="p" en="Procurable today" it="Acquistabile oggi" class="slide-eyebrow text-[var(--accent-primary)] mb-2" data-reveal />
        <T
          as="h2"
          en="The whole stack is ACN-qualified for Italian PA"
          it="L’intero stack è qualificato ACN per la PA italiana"
          class="text-[var(--ink-primary)] mb-6 font-[family-name:var(--font-display)]"
          style="font-size: clamp(1.5rem, 2.4vw, 2.2rem); font-weight: 600; line-height: 1.1; letter-spacing: -0.02em;"
          data-reveal data-reveal-delay="0.08"
        />
        <div class="grid grid-cols-2 md:grid-cols-4 gap-[clamp(0.7rem,1vw,1rem)] mb-5" data-stagger="0.08">
          {stack.map((s) => (
            <article class="alf-card" style="padding:1.1rem 1.1rem 1rem;">
              <h3 class="alf-card-title" style="font-size:1.02rem;margin-bottom:0.5rem;">{s.name}</h3>
              <p class="alf-card-body" style="font-size:0.9rem;"><span class="alf-chip alf-chip--ver">ACN</span> <span class="tabular-nums">{s.sa}</span></p>
            </article>
          ))}
        </div>
        <div class="alf-rows" data-reveal data-reveal-delay="0.2">
          {routes.map((r) => (
            <div class="alf-row">
              <T as="p" en={r.label.en} it={r.label.it} class="alf-row-label" />
              <T as="p" en={r.en} it={r.it} class="alf-row-body" />
            </div>
          ))}
        </div>
        <p class="alf-src mt-4" data-reveal data-reveal-delay="0.26">
          Fonti · <a href="https://www.acn.gov.it" target="_blank" rel="noopener noreferrer">acn.gov.it</a> (SA-3795 · SA-3799 · SA-3973 · SA-3798, validi al 22/08/2028) · <a href="https://www.consip.it" target="_blank" rel="noopener noreferrer">consip.it</a> (multibrand ed.7, Lotto 7). <T en="The ACN cards are vendor-submitted, not an independent ACN security assessment." it="Le schede ACN sono vendor-submitted, non un assessment di sicurezza indipendente ACN." />
        </p>
      </div>
    </Slide>

    <Slide id="slide-trust" bg="inverse" align="left">
      <div slot="backdrop" class="alf-bg-navy" style={`--bg-src: url(${bgNavy.src})`}></div>
      <div class="w-full max-w-6xl mx-auto">
        <T as="p" en="Trust, by design" it="La fiducia, per costruzione" class="slide-eyebrow text-[var(--color-azzurro-chiaro)] mb-2" data-reveal />
        <T
          as="h2"
          en="Three assurances on staff data"
          it="Tre garanzie sul dato del personale"
          class="text-[var(--color-carta)] mb-6 font-[family-name:var(--font-display)]"
          style="font-size: clamp(1.5rem, 2.4vw, 2.2rem); font-weight: 600; line-height: 1.1; letter-spacing: -0.02em;"
          data-reveal data-reveal-delay="0.08"
        />
        <div class="grid grid-cols-1 md:grid-cols-3 gap-[clamp(0.8rem,1.1vw,1.1rem)]" data-stagger="0.09">
          {trust.map((t) => (
            <article class="alf-card">
              <T as="h3" en={t.label.en} it={t.label.it} class="alf-card-title" />
              <T as="p" en={t.en} it={t.it} class="alf-card-body" />
            </article>
          ))}
        </div>
      </div>
    </Slide>

  </DeckContainer>
</BaseLayout>
