---
import BaseLayout from '../layouts/BaseLayout.astro';
import AlfabetiNavigation from '../components/AlfabetiNavigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import T from '@edf/core/blocks/i18n/T.astro';
import { href } from '@edf/core/utils/url.js';

const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;

// Internal appendix — gated by the 'interno' solution (see admin console).
// Client-facing runs skip this section; it appears only when 'interno' is on.
const notToSay = [
  { en: 'The PNRR Mission Unit “four-office / Andrea Bollini Coordination Office” structure.', it: 'La struttura «quattro uffici / Ufficio di Coordinamento Andrea Bollini» dell’Unità di Missione PNRR.' },
  { en: '“Marco Bruschi” heading the education-system Department (DPIT.segreteria contact).', it: '«Marco Bruschi» a capo del Dipartimento sistema educativo (contatto DPIT.segreteria).' },
  { en: '“Nando Minnella replacing Jacopo Greco” at the digital-innovation Department.', it: '«Nando Minnella al posto di Jacopo Greco» al Dipartimento innovazione digitale.' },
  { en: 'The ACN catalog cards as an “independent ACN security validation” (they are vendor-submitted).', it: 'Le schede ACN come «validazione di sicurezza indipendente ACN» (sono vendor-submitted).' },
];
---
<BaseLayout title="Realtà — uso interno" pageSolutions={['interno']}>
  <div class="fixed top-0 left-0 right-0 z-50">
    <AlfabetiNavigation currentPath={currentPath} base={base} />
  </div>

  <DeckContainer nextHref={href(base, '/rotta')} prevHref={href(base, '/persone')}>

    <Slide id="slide-cover" bg="inverse" align="center" data-solution="interno">
      <div slot="backdrop" class="alf-bg-navy"></div>
      <div class="mx-auto w-full max-w-4xl flex flex-col items-center">
        <span class="badge mb-6" style="background:rgba(166,90,0,0.22);color:#F0C48A;">
          <T en="Internal only" it="Solo uso interno" />
        </span>
        <T
          as="h1"
          en="Reality"
          it="Realtà"
          class="slide-title text-center text-[var(--color-carta)] mb-6"
          style="font-size: clamp(2.6rem, 5vw, 4.6rem);"
          data-reveal data-reveal-delay="0.08"
        />
        <T
          as="p"
          en="What the client deck leaves out: who is already inside, the procurement obstacles, and the names not to use. Toggle this section off for client audiences."
          it="Ciò che il deck client lascia fuori: chi è già dentro, gli ostacoli di procurement e i nomi da non usare. Spegni questa sezione per il pubblico client."
          class="text-center text-[var(--color-carta-tenue)] mx-auto max-w-3xl"
          style="font-size: clamp(1.05rem, 1.4vw, 1.35rem); line-height: 1.55;"
          data-reveal data-reveal-delay="0.16"
        />
      </div>
    </Slide>

    <Slide id="slide-competitors" bg="primary" align="left" data-solution="interno">
      <div slot="backdrop" class="alf-bg"></div>
      <div class="w-full max-w-6xl mx-auto">
        <T as="p" en="Who is already inside" it="Chi è già dentro" class="slide-eyebrow text-[var(--accent-primary)] mb-2" data-reveal />
        <T
          as="h2"
          en="The schools channel is being taken"
          it="Il canale scuola si sta occupando"
          class="text-[var(--ink-primary)] mb-6 font-[family-name:var(--font-display)]"
          style="font-size: clamp(1.7rem, 2.6vw, 2.4rem); font-weight: 600; line-height: 1.1; letter-spacing: -0.02em;"
          data-reveal data-reveal-delay="0.08"
        />
        <div class="alf-rows" data-reveal data-reveal-delay="0.16">
          <div class="alf-row">
            <T as="p" en="Microsoft" it="Microsoft" class="alf-row-label" />
            <T as="p" en="A three-year deal with Fondazione ANP (school principals, 2023) plus “Elevate for Educators” (May 2026, AI-centric). It bought the leadership channel." it="Accordo triennale con Fondazione ANP (dirigenti, 2023) più «Elevate for Educators» (mag 2026, IA-centrico). Ha comprato il canale della dirigenza." class="alf-row-body" />
          </div>
          <div class="alf-row">
            <T as="p" en="Google" it="Google" class="alf-row-label" />
            <T as="p" en="Google for Education entering Italian schools for 2026/27 (Gemini Academy, AI Pro accounts, regional deals). The AI-in-classroom front is widening." it="Google for Education entra nelle scuole italiane per il 2026/27 (Gemini Academy, account AI Pro, intese regionali). Il fronte IA-in-classe si allarga." class="alf-row-body" />
          </div>
          <div class="alf-row">
            <T as="p" en="Adobe" it="Adobe" class="alf-row-label" />
            <T as="p" en="No schools deal yet. The differentiated play is creativity + classroom-safe AI + certified skills — but a channel (ANP and/or a vertical SI) must be secured." it="Nessun accordo-scuole. La carta differenziante è creatività + IA sicura + competenze certificate — ma serve procurarsi un canale (ANP e/o un SI verticale)." class="alf-row-body" />
          </div>
        </div>
      </div>
    </Slide>

    <Slide id="slide-notsay" bg="secondary" align="left" data-solution="interno">
      <div slot="backdrop" class="alf-bg-soft"></div>
      <div class="w-full max-w-6xl mx-auto">
        <T as="p" en="Do not say" it="Cose da non dire" class="slide-eyebrow text-[var(--accent-primary)] mb-2" data-reveal />
        <T
          as="h2"
          en="Claims refuted in verification — never reuse"
          it="Claim smentiti in verifica — non riusare mai"
          class="text-[var(--ink-primary)] mb-6 font-[family-name:var(--font-display)]"
          style="font-size: clamp(1.7rem, 2.6vw, 2.4rem); font-weight: 600; line-height: 1.1; letter-spacing: -0.02em;"
          data-reveal data-reveal-delay="0.08"
        />
        <ul class="flex flex-col gap-3" data-reveal data-reveal-delay="0.16">
          {notToSay.map((n) => (
            <li class="alf-panel" style="flex-direction:row;gap:0.8rem;align-items:flex-start;padding:0.9rem 1.2rem;">
              <span aria-hidden="true" style="color:var(--color-ocra);font-weight:700;font-size:1.1rem;line-height:1.4;flex-shrink:0;">✕</span>
              <T as="p" en={n.en} it={n.it} class="alf-panel-body" style="margin-bottom:0;" />
            </li>
          ))}
        </ul>
        <p class="alf-src mt-4" data-reveal data-reveal-delay="0.24">
          <span class="alf-chip alf-chip--ver">VER</span> anche AEM è qualificato ACN (SA-3789 + Azure/AWS). <span class="alf-chip alf-chip--tbc">TBC</span> vertice Dip. innovazione digitale (successione Greco→Minnella→Montesarchio da confermare via decreto).
        </p>
      </div>
    </Slide>

  </DeckContainer>
</BaseLayout>
