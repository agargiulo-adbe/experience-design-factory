---
import BaseLayout from '../layouts/BaseLayout.astro';
import AlfabetiNavigation from '../components/AlfabetiNavigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import T from '@edf/core/blocks/i18n/T.astro';
import { href } from '@edf/core/utils/url.js';

const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;

const moment = [
  {
    figure: '€17,06 mld',
    en: 'PNRR funds the Ministry manages across 16 measures: the largest education-transformation budget Italy has ever put in play.',
    it: 'Fondi PNRR gestiti dal Ministero su 16 misure: il più grande budget di trasformazione della scuola mai messo in campo in Italia.',
  },
  {
    figure: 'Scuola 4.0',
    en: '€2.1bn and 100,000 classrooms, now in the final phase (completion 31 Aug 2026, reporting 15 Oct 2026). The rooms are equipped; the next step is content, software and training.',
    it: '€2,1 mld e 100.000 aule, ora in fase finale (completamento 31 ago 2026, rendicontazione 15 ott 2026). Le aule sono attrezzate; adesso servono contenuti, software e formazione.',
  },
  {
    figure: '€100 mln',
    en: 'The new AI decree (Council of Ministers, 4 Aug 2026) dedicates funding to teacher AI training, aligned to the EU AI Act.',
    it: "Il nuovo decreto IA (CdM, 4 ago 2026) dedica fondi alla formazione dei docenti sull'IA, in linea con l'EU AI Act.",
  },
  {
    figure: 'Priorità 8',
    en: "The 2026 policy directive introduces AI in schools under the DM 166/2025 guidelines — a governance-gated door, opening now.",
    it: "L'Atto di indirizzo 2026 introduce l'IA a scuola con le linee guida DM 166/2025 — una porta governata, che si apre adesso.",
  },
];
---
<BaseLayout title="Apertura">
  <div class="fixed top-0 left-0 right-0 z-50">
    <AlfabetiNavigation currentPath={currentPath} base={base} />
  </div>

  <DeckContainer nextHref={href(base, '/domanda')}>

    <!-- ── SLIDE 0: Cover ─────────────────────────────────────────── -->
    <Slide id="slide-cover" bg="inverse" align="center">
      <div slot="backdrop" class="alf-bg-navy"></div>
      <div class="mx-auto w-full max-w-5xl flex flex-col items-center" data-reveal>
        <T
          as="p"
          en="Adobe × Ministry of Education and Merit"
          it="Adobe × Ministero dell'Istruzione e del Merito"
          class="slide-eyebrow text-center text-[var(--color-azzurro-chiaro)] mb-6"
        />
        <T
          as="h1"
          en="Alfabeti"
          it="Alfabeti"
          data-display
          class="slide-title text-center text-[var(--color-carta)] mb-6"
          style="font-size: clamp(3.4rem, 7vw, 6.4rem);"
        />
        <T
          as="p"
          en="Communication to school staff, digital skills and classroom-safe AI — as one institutional experience, governed at the centre."
          it="La comunicazione al personale, le competenze digitali e l'IA sicura in classe — come un'unica esperienza istituzionale, governata al centro."
          class="text-center text-[var(--color-carta-tenue)] mx-auto max-w-3xl"
          style="font-size: clamp(1.1rem, 1.45vw, 1.4rem); line-height: 1.55;"
          data-reveal
          data-reveal-delay="0.16"
        />
        <div class="mt-10 flex flex-col items-center gap-3" data-reveal data-reveal-delay="0.28">
          <div class="w-10 h-px bg-[var(--color-azzurro-chiaro)]" aria-hidden="true"></div>
          <T
            as="p"
            en="Use ← → to move. IT and EN in the toggle above."
            it="Frecce ← → per muoversi. IT ed EN nel selettore in alto."
            class="text-center text-[var(--color-carta-tenue)]"
            style="font-size: 0.85rem; letter-spacing: 0.02em;"
          />
        </div>
      </div>
    </Slide>

    <!-- ── SLIDE 1: The moment ────────────────────────────────────── -->
    <Slide id="slide-moment" bg="primary" align="left">
      <div slot="backdrop" class="alf-bg"></div>
      <div class="w-full max-w-6xl mx-auto">
        <T
          as="p"
          en="The moment"
          it="Il momento"
          class="slide-eyebrow text-[var(--accent-primary)] mb-2"
          data-reveal
        />
        <T
          as="h2"
          en="The resources are here, and so is the policy framing"
          it="Le risorse ci sono, e la cornice normativa le accompagna"
          class="text-[var(--ink-primary)] mb-6 font-[family-name:var(--font-display)]"
          style="font-size: clamp(1.8rem, 2.8vw, 2.6rem); font-weight: 600; line-height: 1.1; letter-spacing: -0.02em;"
          data-reveal
          data-reveal-delay="0.08"
        />
        <div class="grid grid-cols-1 md:grid-cols-2 gap-[clamp(0.8rem,1.1vw,1.1rem)]" data-reveal data-reveal-delay="0.16">
          {moment.map((m) => (
            <article class="alf-panel">
              <p class="alf-figure mb-2">{m.figure}</p>
              <T as="p" en={m.en} it={m.it} class="alf-panel-body" style="margin-bottom:0;" />
            </article>
          ))}
        </div>
        <p class="alf-src mt-4" data-reveal data-reveal-delay="0.24">
          Fonti · pnrr.istruzione.it · mim.gov.it (Atto di indirizzo 2026, decreto IA) · openpnrr.it
        </p>
      </div>
    </Slide>

    <!-- ── SLIDE 2: Thesis ────────────────────────────────────────── -->
    <Slide id="slide-thesis" bg="secondary" align="center">
      <div slot="backdrop" class="alf-bg-soft"></div>
      <div class="w-full max-w-4xl mx-auto flex flex-col items-center">
        <T
          as="p"
          en="The thesis"
          it="La tesi"
          class="slide-eyebrow text-center text-[var(--accent-primary)] mb-6"
          data-reveal
        />
        <T
          as="h2"
          en="The first door isn't the classroom. It's how the Ministry speaks to the people who make the schools run."
          it="La prima porta non è la classe. È come il Ministero parla alle persone che fanno funzionare le scuole."
          class="slide-title text-center text-[var(--ink-primary)] max-w-4xl mx-auto mb-8"
          style="font-size: clamp(1.7rem, 2.9vw, 2.8rem); line-height: 1.2;"
          data-reveal
          data-reveal-delay="0.08"
        />
        <div class="alf-quote w-full max-w-3xl" data-reveal data-reveal-delay="0.16">
          <T
            as="p"
            en="Docenti, dirigenti, ATA: hundreds of thousands of people, moved by immissioni, mobility and rankings — reached today with fragmented tools."
            it="Docenti, dirigenti, ATA: centinaia di migliaia di persone, mosse da immissioni, mobilità e graduatorie — raggiunte oggi con strumenti frammentati."
            class="alf-quote-text text-center mx-auto"
          />
        </div>
      </div>
    </Slide>

  </DeckContainer>
</BaseLayout>
