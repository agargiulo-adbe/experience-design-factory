---
import BaseLayout from '../layouts/BaseLayout.astro';
import AlfabetiNavigation from '../components/AlfabetiNavigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import T from '@edf/core/blocks/i18n/T.astro';
import { href } from '@edf/core/utils/url.js';
import bgNavy from '../assets/generated/bg/navy-1.webp';
import bgCarta from '../assets/generated/bg/carta-1.webp';
import bgSoft from '../assets/generated/bg/soft-1.webp';

const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;

const pillars = [
  {
    word: { en: 'Orchestrate', it: 'Orchestrare' },
    en: 'The right message, at the right moment, on the right channel — across the processes that move a career.',
    it: 'Il messaggio giusto, al momento giusto, sul canale giusto — lungo i processi che muovono una carriera.',
  },
  {
    word: { en: 'Measure', it: 'Misurare' },
    en: 'Delivered, opened, understood, acted on. For the first time the staff channel produces evidence, not guesswork.',
    it: 'Recapitato, aperto, capito, seguito da un’azione. Per la prima volta il canale del personale produce evidenze, non stime.',
  },
  {
    word: { en: 'Govern', it: 'Governare' },
    en: 'Every journey runs on a role-based, privacy-first staff profile — with the institution in control of what is sent and what is measured.',
    it: 'Ogni journey poggia su un profilo del personale basato sul ruolo e privacy-first — con l’istituzione che controlla cosa si invia e cosa si misura.',
  },
];
---
<BaseLayout title="La voce del Ministero">
  <div class="fixed top-0 left-0 right-0 z-50">
    <AlfabetiNavigation currentPath={currentPath} base={base} />
  </div>

  <DeckContainer nextHref={href(base, '/domanda')}>

    <!-- ── SLIDE 0: Cover ─────────────────────────────────────────── -->
    <Slide id="slide-cover" bg="inverse" align="center">
      <div slot="backdrop" class="alf-bg-navy" style={`--bg-src: url(${bgNavy.src})`}></div>
      <div class="mx-auto w-full max-w-5xl flex flex-col items-center" data-reveal>
        <T
          as="p"
          en="Adobe × Ministry of Education and Merit"
          it="Adobe × Ministero dell'Istruzione e del Merito"
          class="slide-eyebrow text-center text-[var(--color-azzurro-chiaro)] mb-6"
        />
        <T
          as="h1"
          en="The Ministry's voice"
          it="La voce del Ministero"
          data-display
          class="slide-title text-center text-[var(--color-carta)] mb-6"
          style="font-size: clamp(2.8rem, 6vw, 5.6rem); line-height: 1.02;"
        />
        <T
          as="p"
          en="Orchestrate and measure how the Ministry speaks to the people who make the schools run — teachers, principals and administrative staff."
          it="Orchestrare e misurare come il Ministero parla alle persone che fanno funzionare la scuola — docenti, dirigenti e personale ATA."
          class="text-center text-[var(--color-carta-tenue)] mx-auto max-w-3xl"
          style="font-size: clamp(1.1rem, 1.45vw, 1.4rem); line-height: 1.55;"
          data-reveal
          data-reveal-delay="0.16"
        />
        <div class="mt-10 flex flex-col items-center gap-3" data-reveal data-reveal-delay="0.28">
          <div class="w-10 h-px bg-[var(--color-azzurro-chiaro)]" aria-hidden="true"></div>
          <T
            as="p"
            en="Use ← → to move. IT and EN in the toggle above."
            it="Frecce ← → per muoversi. IT ed EN nel selettore in alto."
            class="text-center text-[var(--color-carta-tenue)]"
            style="font-size: 0.85rem; letter-spacing: 0.02em;"
          />
          <T
            as="p"
            en="Imagery generated with Adobe Firefly — signed with Content Credentials (C2PA)."
            it="Immagini generate con Adobe Firefly — firmate con Content Credentials (C2PA)."
            class="text-center text-[var(--color-azzurro-chiaro)]"
            style="font-size: 0.75rem; letter-spacing: 0.08em; text-transform: uppercase;"
          />
        </div>
      </div>
    </Slide>

    <!-- ── SLIDE 1: Thesis ────────────────────────────────────────── -->
    <Slide id="slide-thesis" bg="primary" align="center">
      <div slot="backdrop" class="alf-bg" style={`--bg-src: url(${bgCarta.src})`}></div>
      <div class="w-full max-w-4xl mx-auto flex flex-col items-center">
        <T
          as="p"
          en="The thesis"
          it="La tesi"
          class="slide-eyebrow text-center text-[var(--accent-primary)] mb-6"
          data-reveal
        />
        <T
          as="h2"
          en="The first door isn't the classroom. It's how the Ministry speaks to the people who make the schools run."
          it="La prima porta non è la classe. È come il Ministero parla alle persone che fanno funzionare le scuole."
          class="slide-title text-center text-[var(--ink-primary)] max-w-4xl mx-auto mb-8"
          style="font-size: clamp(1.7rem, 2.9vw, 2.8rem); line-height: 1.2;"
          data-reveal
          data-reveal-delay="0.08"
        />
        <div class="alf-quote w-full max-w-3xl" data-reveal data-reveal-delay="0.16">
          <T
            as="p"
            en="Teachers, principals, ATA: hundreds of thousands of people, moved by tenure appointments, mobility and rankings — reached today with fragmented tools, and measured by no one."
            it="Docenti, dirigenti, ATA: centinaia di migliaia di persone, mosse da immissioni, mobilità e graduatorie — raggiunte oggi con strumenti frammentati, e misurate da nessuno."
            class="alf-quote-text text-center mx-auto"
          />
        </div>
      </div>
    </Slide>

    <!-- ── SLIDE 2: Three words ───────────────────────────────────── -->
    <Slide id="slide-pillars" bg="secondary" align="left">
      <div slot="backdrop" class="alf-bg-soft" style={`--bg-src: url(${bgSoft.src})`}></div>
      <div class="w-full max-w-6xl mx-auto">
        <T as="p" en="One voice, in three words" it="Una voce sola, in tre parole" class="slide-eyebrow text-[var(--accent-primary)] mb-2" data-reveal />
        <T
          as="h2"
          en="Orchestrate, measure, govern"
          it="Orchestrare, misurare, governare"
          class="text-[var(--ink-primary)] mb-6 font-[family-name:var(--font-display)]"
          style="font-size: clamp(1.8rem, 2.8vw, 2.6rem); font-weight: 600; line-height: 1.1; letter-spacing: -0.02em;"
          data-reveal data-reveal-delay="0.08"
        />
        <div class="grid grid-cols-1 md:grid-cols-3 gap-[clamp(0.8rem,1.1vw,1.1rem)]" data-stagger="0.09">
          {pillars.map((p) => (
            <article class="alf-card">
              <T as="h3" en={p.word.en} it={p.word.it} class="alf-card-title" />
              <T as="p" en={p.en} it={p.it} class="alf-card-body" />
            </article>
          ))}
        </div>
        <p class="alf-src mt-4" data-reveal data-reveal-delay="0.24">
          <T en="Adobe Experience Platform · Real-Time CDP · Journey Optimizer · Customer Journey Analytics" it="Adobe Experience Platform · Real-Time CDP · Journey Optimizer · Customer Journey Analytics" />
        </p>
      </div>
    </Slide>

  </DeckContainer>
</BaseLayout>
