---
import BaseLayout from '../layouts/BaseLayout.astro';
import AlfabetiNavigation from '../components/AlfabetiNavigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import T from '@edf/core/blocks/i18n/T.astro';
import { href } from '@edf/core/utils/url.js';
import bgNavy from '../assets/generated/bg/navy-3.webp';
import bgCarta from '../assets/generated/bg/carta-3.webp';
import bgSoft from '../assets/generated/bg/soft-3.webp';

const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;

const why = [
  {
    tag: { en: 'Already procurable', it: 'Già acquistabile' },
    title: { en: 'Qualified in the ACN cloud catalog', it: 'Qualificati nel catalogo cloud ACN' },
    en: 'Journey Optimizer (SA-3795), Customer Journey Analytics (SA-3799), Real-Time CDP (SA-3973) and Target (SA-3798) are all qualified for Italian PA in the ACN cloud catalog — valid to Aug 2028. The enabling prerequisite is already met.',
    it: 'Journey Optimizer (SA-3795), Customer Journey Analytics (SA-3799), Real-Time CDP (SA-3973) e Target (SA-3798) sono tutti qualificati per la PA italiana nel catalogo cloud ACN — validi fino ad ago 2028. Il prerequisito abilitante è già soddisfatto.',
  },
  {
    tag: { en: 'Open space', it: 'Spazio libero' },
    title: { en: 'No one covers the staff channel', it: 'Nessuno presidia il canale del personale' },
    en: 'ComUnica (Piattaforma Unica) is school-to-family. SEND (PagoPA) is legal notifications. Neither reaches teachers, principals and ATA on process communication.',
    it: "ComUnica (Piattaforma Unica) è scuola-famiglia. SEND (PagoPA) sono notifiche legali. Nessuno raggiunge docenti, dirigenti e ATA sulla comunicazione di processo.",
  },
  {
    tag: { en: 'Coexistence', it: 'Coesistenza' },
    title: { en: 'Alongside Unica, not instead of it', it: 'Accanto a Unica, non al posto' },
    en: 'Adobe sits as an orchestration and analytics layer next to Piattaforma Unica: it adds measurement and personalization to the staff channel without replacing what already works.',
    it: "Adobe è un layer di orchestrazione e analytics accanto a Piattaforma Unica: aggiunge misura e personalizzazione al canale del personale senza sostituire ciò che già funziona.",
  },
];

const flow = [
  { n: 'CDP', en: 'Staff profiles unified — role, region, standing, entitlements.', it: 'Profili del personale unificati — ruolo, regione, posizione, titoli.' },
  { n: 'AJO', en: 'Personalized journeys on tenure, mobility, substitutes, deadlines.', it: 'Journey personalizzati su immissioni, mobilità, supplenze, scadenze.' },
  { n: 'CJA', en: 'Measure the outcome: delivered, opened, understood, acted on.', it: "Misura dell'esito: recapitato, aperto, capito, seguito da un'azione." },
];
---
<BaseLayout title="La voce del Ministero">
  <div class="fixed top-0 left-0 right-0 z-50">
    <AlfabetiNavigation currentPath={currentPath} base={base} />
  </div>

  <DeckContainer nextHref={href(base, '/competenze')} prevHref={href(base, '/domanda')}>

    <Slide id="slide-cover" bg="inverse" align="center">
      <div slot="backdrop" class="alf-bg-navy" style={`--bg-src: url(${bgNavy.src})`}></div>
      <div class="mx-auto w-full max-w-4xl flex flex-col items-center">
        <T as="p" en="The proposal" it="La proposta" class="slide-eyebrow text-center text-[var(--color-azzurro-chiaro)] mb-6" data-reveal />
        <T
          as="h1"
          en="The space is open, the stack is ready"
          it="Lo spazio è libero, lo stack è pronto"
          class="slide-title text-center text-[var(--color-carta)] mb-6"
          style="font-size: clamp(2.1rem, 4vw, 3.8rem); line-height: 1.05;"
          data-reveal data-reveal-delay="0.08"
        />
        <T
          as="p"
          en="An orchestration and analytics layer for the staff channel — Adobe Experience Platform, Journey Optimizer and Customer Journey Analytics, alongside Piattaforma Unica."
          it="Un layer di orchestrazione e analytics per il canale del personale — Adobe Experience Platform, Journey Optimizer e Customer Journey Analytics, accanto a Piattaforma Unica."
          class="text-center text-[var(--color-carta-tenue)] mx-auto max-w-3xl"
          style="font-size: clamp(1.05rem, 1.4vw, 1.35rem); line-height: 1.55;"
          data-reveal data-reveal-delay="0.16"
        />
      </div>
    </Slide>

    <Slide id="slide-why" bg="primary" align="left">
      <div slot="backdrop" class="alf-bg" style={`--bg-src: url(${bgCarta.src})`}></div>
      <div class="w-full max-w-6xl mx-auto">
        <T as="p" en="Why it fits here" it="Perché funziona qui" class="slide-eyebrow text-[var(--accent-primary)] mb-2" data-reveal />
        <T
          as="h2"
          en="Ready to build on what the Ministry already has"
          it="Pronto, sopra ciò che il Ministero ha già"
          class="text-[var(--ink-primary)] mb-6 font-[family-name:var(--font-display)]"
          style="font-size: clamp(1.7rem, 2.6vw, 2.4rem); font-weight: 600; line-height: 1.1; letter-spacing: -0.02em;"
          data-reveal data-reveal-delay="0.08"
        />
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-[clamp(0.8rem,1.1vw,1.1rem)]" data-stagger="0.09">
          {why.map((w) => (
            <article class="alf-card">
              <p class="alf-tag mb-2"><T en={w.tag.en} it={w.tag.it} /></p>
              <T as="h3" en={w.title.en} it={w.title.it} class="alf-card-title" />
              <T as="p" en={w.en} it={w.it} class="alf-card-body" />
            </article>
          ))}
        </div>
        <p class="alf-src mt-4" data-reveal data-reveal-delay="0.24">
          <T en="Sources · ACN cloud catalog (SA-3795 · SA-3799 · SA-3973 · SA-3798) · Unica/ComUnica serves families, not staff · SEND (PagoPA): " it="Fonti · catalogo cloud ACN (SA-3795 · SA-3799 · SA-3973 · SA-3798) · Unica/ComUnica serve le famiglie, non il personale · SEND (PagoPA): " /><a href="https://www.acn.gov.it" target="_blank" rel="noopener noreferrer">ACN</a> · <a href="https://www.mim.gov.it/en/-/piattaforma-unica-disponibilita-del-servizio-comunica-per-l-avvio-dell-anno-scolastico-2025-2026" target="_blank" rel="noopener noreferrer">MIM&nbsp;·&nbsp;Unica</a> · <a href="https://www.pagopa.it" target="_blank" rel="noopener noreferrer">PagoPA</a>
        </p>
      </div>
    </Slide>

    <Slide id="slide-how" bg="secondary" align="left">
      <div slot="backdrop" class="alf-bg-soft" style={`--bg-src: url(${bgSoft.src})`}></div>
      <div class="w-full max-w-6xl mx-auto">
        <T as="p" en="How it works" it="Come funziona" class="slide-eyebrow text-[var(--accent-primary)] mb-2" data-reveal />
        <T
          as="h2"
          en="From staff data to a measured outcome"
          it="Dal dato del personale a un esito misurato"
          class="text-[var(--ink-primary)] mb-6 font-[family-name:var(--font-display)]"
          style="font-size: clamp(1.7rem, 2.6vw, 2.4rem); font-weight: 600; line-height: 1.1; letter-spacing: -0.02em;"
          data-reveal data-reveal-delay="0.08"
        />
        <div class="grid grid-cols-1 md:grid-cols-3 gap-[clamp(0.8rem,1.1vw,1.1rem)]" data-stagger="0.09">
          {flow.map((f) => (
            <article class="alf-card">
              <span class="alf-mark">{f.n}</span>
              <T as="p" en={f.en} it={f.it} class="alf-card-body" />
            </article>
          ))}
        </div>
        <div class="alf-quote mt-6" data-reveal data-reveal-delay="0.24">
          <T
            as="p"
            en="Every journey runs on a governed profile: role-based, privacy-first, with the institution in control of what is sent and what is measured."
            it="Ogni journey poggia su un profilo governato: basato sul ruolo, privacy-first, con l'istituzione che controlla cosa viene inviato e cosa viene misurato."
            class="alf-quote-text"
            style="font-size: clamp(1rem, 1.3vw, 1.2rem); font-weight: 500;"
          />
        </div>
      </div>
    </Slide>

  </DeckContainer>
</BaseLayout>
