---
import BaseLayout from '../layouts/BaseLayout.astro';
import AlfabetiNavigation from '../components/AlfabetiNavigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import T from '@edf/core/blocks/i18n/T.astro';
import { href } from '@edf/core/utils/url.js';

const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;

const moves = [
  { en: 'Start where it is ready: one measured voice on the staff channel, on tools already procurable through ACN — alongside Piattaforma Unica, not instead of it.', it: 'Partire da dove è pronto: una voce unica e misurata sul canale del personale, su strumenti già acquistabili via ACN — accanto a Piattaforma Unica, non al posto.' },
  { en: 'Settle governance first: define the data perimeter and legal basis for staff data, with privacy and the Garante in the room from day one.', it: 'Chiudere prima la governance: definire il perimetro-dati e la base giuridica per i dati del personale, con privacy e Garante al tavolo dal primo giorno.' },
  { en: 'Run one pilot journey — tenure appointments, end to end: built once, measured against a clear outcome.', it: 'Un journey pilota su un processo — le immissioni in ruolo, dall’inizio alla fine: costruito una volta, misurato su un esito chiaro.' },
  { en: 'Measure, then scale: extend the same engine to mobility, substitutes, rankings and training — and read the reach across every region.', it: 'Misurare, poi scalare: estendere lo stesso motore a mobilità, supplenze, graduatorie e formazione — e leggere il recapito su ogni territorio.' },
];
---
<BaseLayout title="La rotta">
  <div class="fixed top-0 left-0 right-0 z-50">
    <AlfabetiNavigation currentPath={currentPath} base={base} />
  </div>

  <DeckContainer nextHref={href(base, '/')} prevHref={href(base, '/persone')}>

    <Slide id="slide-route" bg="primary" align="left">
      <div slot="backdrop" class="alf-bg"></div>
      <div class="w-full max-w-6xl mx-auto">
        <T as="p" en="The path" it="La rotta" class="slide-eyebrow text-[var(--accent-primary)] mb-2" data-reveal />
        <T
          as="h2"
          en="One path, four steps"
          it="Un percorso, quattro passi"
          class="text-[var(--ink-primary)] mb-6 font-[family-name:var(--font-display)]"
          style="font-size: clamp(1.8rem, 2.8vw, 2.6rem); font-weight: 600; line-height: 1.1; letter-spacing: -0.02em;"
          data-reveal data-reveal-delay="0.08"
        />
        <ol class="flex flex-col gap-3" data-reveal data-reveal-delay="0.16">
          {moves.map((m, i) => (
            <li class="alf-row" style="grid-template-columns: 2.5rem minmax(0,1fr); gap:1.2rem;">
              <span class="alf-mark" style="margin-bottom:0;">{i + 1}</span>
              <T as="p" en={m.en} it={m.it} class="alf-row-body" style="font-size:1.02rem;" />
            </li>
          ))}
        </ol>
      </div>
    </Slide>

    <Slide id="slide-close" bg="inverse" align="center">
      <div slot="backdrop" class="alf-bg-navy"></div>
      <div class="w-full max-w-4xl mx-auto flex flex-col items-center">
        <T as="p" en="In one breath" it="In un respiro" class="slide-eyebrow text-center text-[var(--color-azzurro-chiaro)] mb-6" data-reveal />
        <T
          as="h2"
          en="Give the Ministry a voice to its own people — measured, governed, and safe by design. Everything else follows from there."
          it="Dare al Ministero una voce verso le sue persone — misurata, governata e sicura per costruzione. Tutto il resto viene da lì."
          class="slide-title text-center text-[var(--color-carta)] max-w-4xl mx-auto"
          style="font-size: clamp(1.8rem, 3.1vw, 3rem); line-height: 1.22;"
          data-reveal data-reveal-delay="0.08"
        />
        <a
          href={href(base, '/trasformazione')}
          class="mt-10 inline-flex items-center gap-2 rounded-full px-6 py-3 font-semibold no-underline transition-colors"
          style="background: rgba(46,111,214,0.95); color: var(--color-carta);"
          data-reveal data-reveal-delay="0.16"
        >
          <T en="See the transformation" it="Guarda la trasformazione" />
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </Slide>

  </DeckContainer>
</BaseLayout>
