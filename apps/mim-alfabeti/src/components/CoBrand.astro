---
/**
 * CoBrand (MIM) — wrapper sottile sul componente condiviso.
 *
 * Il motore (`@edf/core/blocks/CoBrand.astro`) porta la regola: ordine Adobe ×
 * Brand non invertibile, firma fissa su ogni slide, lockup grande su prima e
 * ultima slide. Qui si dichiara solo CHI è il brand.
 *
 * Senza SVG ufficiale del cliente il motore ripiega sul nome in carattere
 * display. Quando il marchio ufficiale arriva, si aggiunge un `<BrandMark
 * slot="brand" />` qui dentro e cambia in tutta l'experience (vedi UniCredit).
 */
import Core from '@edf/core/blocks/CoBrand.astro';

interface Props {
  variant?: 'chrome' | 'hero';
  class?: string;
  [key: string]: unknown;
}
const props = Astro.props as Props;
---
<!-- «MIM» è l'abbreviazione ufficiale con cui il Ministero si firma (mim.gov.it):
     nel lockup il nome per esteso non starebbe su una riga. -->
<Core brand="MIM" {...props} />
