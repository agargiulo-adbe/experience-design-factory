# Build-time asset generation keys for `pnpm --filter mim-alfabeti assets:build`.
# Copy to `.env` (gitignored) and fill in. These are BUILD-TIME ONLY — they are
# never bundled into the static site and never uploaded to CI.

# Pexels (legacy `stock` slots). https://www.pexels.com/api/
PEXELS_API_KEY=

# Adobe Firefly Services (server-to-server). Required for `firefly` slots.
# From your Adobe Developer Console project (OAuth Server-to-Server credential).
FIREFLY_CLIENT_ID=
FIREFLY_CLIENT_SECRET=

# Adobe Firefly — Audio & Video API (separate credential/project from images).
# Used by `video:build`. Falls back to FIREFLY_CLIENT_ID/SECRET if unset.
FIREFLY_VIDEO_AUDIO_CLIENT_ID=
FIREFLY_VIDEO_AUDIO_CLIENT_SECRET=

# Optional overrides (defaults shown) — set only if your account differs.
# FIREFLY_IMS_URL=https://ims-na1.adobelogin.com/ims/token/v3
# FIREFLY_API_URL=https://firefly-api.adobe.io
# FIREFLY_SCOPES=openid,AdobeID,firefly_api,ff_apis
# FIREFLY_VIDEO_PATH=/v3/videos/generate
