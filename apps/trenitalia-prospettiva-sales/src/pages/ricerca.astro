---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import Divisore from '../components/Divisore.astro';
import SlideIdea from '../components/SlideIdea.astro';
import Fascia from '../components/Fascia.astro';
import { href } from '@edf/core/utils/url.js';
import bg_sole from '../assets/generated/sole/sole-ricerca.webp';
import { CHAPTERS, prevSlug, nextSlug } from '../data/chapters';
import { DOMANDE, KPI } from '../data/contenuti';
import { pezziDi } from '../data/idee';
import { SOURCES } from '../data/sources';

/**
 * Capitolo 03 — Quando un viaggio si cerca con l'intelligenza artificiale.
 *
 * È il capitolo che porta una misura NOSTRA, come la lettura delle superfici nel
 * dossier: le stesse otto domande di viaggio, nessuna di marca, poste a DUE assistenti
 * — ChatGPT il 12 ottobre e la risposta generata di Google l'11. Il limite del campione
 * (due assistenti, otto domande) sta scritto in slide; il PERCHÉ gli altri due sono
 * fuori — un account gratuito che si esaurisce, una sessione che non parte — è un
 * dettaglio operativo che a un direttore commerciale non dice niente e sposta
 * l'attenzione sulla nostra attrezzatura invece che sul suo mercato: sta nel
 * documento di metodo, non in slide.
 * Dati grezzi, metodo e limiti in
 * docs/Ferrovie/MISURA-visibilita-risposte-generate-2026-10-11.md.
 *
 * Il secondo giro ha cambiato la tesi, non solo i numeri. Con un motore solo la slide
 * diceva «non vi citano»; con due si vede che **dipende da quale assistente**: Google
 * costruisce la risposta sui rivenditori e sbaglia due volte su otto di chi sono le
 * Frecce, ChatGPT va sui siti ufficiali e non sbaglia mai. Attribuire l'errore a «gli
 * assistenti» sarebbe stato falso, e su una slide che accusa qualcuno di sbagliare un
 * fatto, sbagliare un fatto è fatale.
 *
 * Regola rispettata alla lettera: si dice «la fotografia che abbiamo scattato noi
 * l'11 e il 12 ottobre, otto domande, due assistenti», mai «il 75% delle risposte vi
 * ignora». Il limite del campione è dichiarato IN SLIDE: se lo trova il cliente per
 * primo, cade tutto il resto.
 */
const SLUG = 'ricerca';
const ch = CHAPTERS.find((c) => c.slug === SLUG)!;
const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;


---
<BaseLayout title={ch.title.it}>
  <div class="fixed top-0 left-0 right-0 z-50">
    <Navigation currentPath={currentPath} base={base} />
  </div>

  <DeckContainer wallScale nextHref={href(base, nextSlug(SLUG))} prevHref={href(base, prevSlug(SLUG))}>

    <!-- ── Divisore di capitolo ─────────────────────────────────────────
         La forma XD: titolo grande, fotografia, pannello di colore. Sostituisce
         la vecchia cover a testo centrato — con l'agenda, il lead e il blocco
         del metodo impilati, era una slide di contenuto travestita da respiro.
         Titolo, punto e fotografia vengono da `chapters.ts`: una fonte sola.
         ⚠️ Il fondo sta QUI e non dentro `Divisore.astro`: Astro non propaga
         `slot="backdrop"` attraverso un componente. -->
    <Slide id="slide-cover" bg="primary" align="left" data-made-with="Adobe Firefly" data-made-with-for="sfondo">
      <div slot="backdrop" class="xd-div-bg" style={`--foto: url(${bg_sole.src})`}></div>
      <Divisore num={ch.num} titolo={ch.title.it} punto={ch.punto} tavolo={ch.tavolo} slug="ricerca" bussola />
    </Slide>

    <!-- ── Il campione ────────────────────────────────────────────────────
         9 nov 2026, review: si parlava di «7 su 8» prima di dire quali fossero
         le otto, e chi guardava non capiva a che cosa legare i numeri. L'unica
         eccezione alla forma comune delle idee: prima dell'idea va il campione. -->
    <Slide id="slide-campione" bg="primary" align="left">
      <div slot="backdrop" class="xd-bg-piano"></div>
      <div class="xd-sl" data-reveal>
        <div class="xd-sl-head">
          <p class="xd-n">Il campione</p>
          <h2 class="xd-h2">Otto domande di viaggio, due&nbsp;assistenti</h2>
          <p class="xd-sub">
            Nessuna nomina un marchio. Le abbiamo poste a ChatGPT e alla ricerca Google, leggendo la&nbsp;risposta generata dall’AI: da qui vengono i&nbsp;numeri che seguono.
          </p>
        </div>
        <ol class="tp-dom" data-stagger="0.05">
          {DOMANDE.map((d) => (
            <li><span class="tp-dom-n">{d.n}</span><span class="tp-dom-t">{d.t}</span><span class="tp-dom-l">{d.lang}</span></li>
          ))}
        </ol>
        <p class="xd-fonte" data-reveal data-reveal-delay="0.2">
          {SOURCES.misura.label}, dall’Italia, una&nbsp;conversazione nuova per&nbsp;domanda.
        </p>
      </div>
    </Slide>

    <!-- ── L'idea, nel registro XD ───────────────────────────────────────
         Una slide, un'idea: il mockup grande, una cifra, la referenza.
         È quello che si proietta. Il meccanismo resta nelle slide che
         seguono e dietro «Scopri come» — due registri, non uno.
         Forma e contenuto stanno in `components/SlideIdea.astro` e
         `data/idee.ts`: una sola fonte per tutte e quattro. -->
    <SlideIdea slug="ricerca" />

    <!-- ── Che cosa abbiamo osservato, che cosa si misura ───────────────────
         10 nov 2026: il referto e «che cosa si misura» diventano una slide sola.
         Il pop-in di Brand Visibility ripeteva gli stessi numeri e le tre misure
         sono le stesse tre colonne: una misura, la sua finestra, un ↓ a testa.
         ⚠️ Google 6 e 2, ChatGPT 7 e 7: dalla tabella del documento di misura.
         L'errore è di UN assistente: «gli assistenti sbagliano» sarebbe falso. -->
    <Slide id="slide-leva" data-stretto bg="primary" align="left">
      <div slot="backdrop" class="xd-bg-piano"></div>
      <div class="xd-sl" data-reveal>
        <div class="xd-sl-head">
          <p class="xd-n">Che cosa abbiamo osservato</p>
          <h2 class="xd-h2">Presenza, fonti e traffico dicono se&nbsp;la&nbsp;risposta sta cambiando</h2>
          <p class="xd-sub">
            <strong>Dalla risposta si passa ai siti citati come fonte: se&nbsp;fra quelli non c’è trenitalia.com, la&nbsp;vendita parte altrove.</strong>
          </p>
        </div>
        <div class="tp-ancore tp-trittico">
          {KPI.map((x, n) => (
            <div class="tp-mom">
              <div class="tp-fin" data-substep aria-hidden="true">
                <p class="tp-fin-b">{['Trenitalia nominata', 'trenitalia.com fra le fonti', 'Visite dagli assistenti AI · esempio'][n]}</p>
                {n < 2 ? (
                  <div class="tp-fin-num">
                    <div><small>ChatGPT</small><strong>7<span> su 8</span></strong></div>
                    <div data-acceso={n === 1 ? '' : undefined}><small>Google</small><strong>{n === 0 ? '6' : '2'}<span> su 8</span></strong></div>
                  </div>
                ) : (
                  <div class="tp-fin-barre"><i></i><i></i><i></i><i></i><i></i><i></i></div>
                )}
              </div>
              <div class="tp-anc">
                <p class="tp-anc-k">{x.k}</p>
                <p class="tp-anc-n">{x.t}</p>
                <p class="tp-anc-b">{x.bSlide}</p>
              </div>
            </div>
          ))}
        </div>
        <Fascia pezzi={pezziDi('ricerca')} />
        <p class="xd-fonte" data-reveal data-reveal-delay="0.26">
          {SOURCES.misura.label}. Il traffico è un esempio. LLM Apps è annunciata e non ancora disponibile: <a href={SOURCES.llmApps.url} target="_blank" rel="noopener noreferrer">{SOURCES.llmApps.label}</a>
        </p>
      </div>
    </Slide>

  </DeckContainer>
</BaseLayout>
