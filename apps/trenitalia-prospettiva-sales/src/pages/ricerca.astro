---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import Divisore from '../components/Divisore.astro';
import SlideIdea from '../components/SlideIdea.astro';
import HowItWorks from '@edf/core/blocks/HowItWorks.astro';
import CheServe from '../components/CheServe.astro';
import Dettaglio from '@edf/core/blocks/Dettaglio.astro';
import DettaglioVoce from '@edf/core/blocks/DettaglioVoce.astro';
import Figura from '../components/Figura.astro';
import { href } from '@edf/core/utils/url.js';
import { CHAPTERS, prevSlug, nextSlug } from '../data/chapters';
import { CANALE, REFERTO, REFERTO_INTERO, DOMANDE, KPI, SERVE } from '../data/contenuti';
import { SOURCES } from '../data/sources';
import bg_paper_lines from '../assets/generated/bg/bg-paper-lines.webp';
import bg_search from '../assets/generated/bg/bg-search.webp';

/**
 * Capitolo 03 — Quando un viaggio si cerca con l'intelligenza artificiale.
 *
 * È il capitolo che porta una misura NOSTRA, come la lettura delle superfici nel
 * dossier: le stesse otto domande di viaggio, nessuna di marca, poste a DUE assistenti
 * — ChatGPT il 12 ottobre e la risposta generata di Google l'11. Il limite del campione
 * (due assistenti, otto domande) sta scritto in slide; il PERCHÉ gli altri due sono
 * fuori — un account gratuito che si esaurisce, una sessione che non parte — è un
 * dettaglio operativo che a un direttore commerciale non dice niente e sposta
 * l'attenzione sulla nostra attrezzatura invece che sul suo mercato: sta nel
 * documento di metodo, non in slide.
 * Dati grezzi, metodo e limiti in
 * docs/Ferrovie/MISURA-visibilita-risposte-generate-2026-10-11.md.
 *
 * Il secondo giro ha cambiato la tesi, non solo i numeri. Con un motore solo la slide
 * diceva «non vi citano»; con due si vede che **dipende da quale assistente**: Google
 * costruisce la risposta sui rivenditori e sbaglia due volte su otto di chi sono le
 * Frecce, ChatGPT va sui siti ufficiali e non sbaglia mai. Attribuire l'errore a «gli
 * assistenti» sarebbe stato falso, e su una slide che accusa qualcuno di sbagliare un
 * fatto, sbagliare un fatto è fatale.
 *
 * Regola rispettata alla lettera: si dice «la fotografia che abbiamo scattato noi
 * l'11 e il 12 ottobre, otto domande, due assistenti», mai «il 75% delle risposte vi
 * ignora». Il limite del campione è dichiarato IN SLIDE: se lo trova il cliente per
 * primo, cade tutto il resto.
 */
const SLUG = 'ricerca';
const ch = CHAPTERS.find((c) => c.slug === SLUG)!;
const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;
/** La domanda citata su `slide-frecce` viene DALLA FONTE UNICA, non riscritta a
 *  mano: era copiata, e `audit:taglio` la segnava c1 (HARD). Una domanda della
 *  misura trascritta a mano è anche il modo di far divergere il verbatim dal
 *  grezzo — ed è un verbatim, minuscole e assenza di punto interrogativo comprese. */
const domandaCitata = DOMANDE.find((d) => d.n === 8)!;


---
<BaseLayout title={ch.title.it}>
  <div class="fixed top-0 left-0 right-0 z-50">
    <Navigation currentPath={currentPath} base={base} />
  </div>

  <DeckContainer wallScale nextHref={href(base, nextSlug(SLUG))} prevHref={href(base, prevSlug(SLUG))}>

    <!-- ── Divisore di capitolo ─────────────────────────────────────────
         La forma XD: titolo grande, fotografia, pannello di colore. Sostituisce
         la vecchia cover a testo centrato — con l'agenda, il lead e il blocco
         del metodo impilati, era una slide di contenuto travestita da respiro.
         Titolo, punto e fotografia vengono da `chapters.ts`: una fonte sola.
         ⚠️ Il fondo sta QUI e non dentro `Divisore.astro`: Astro non propaga
         `slot="backdrop"` attraverso un componente. -->
    <Slide id="slide-cover" bg="primary" align="left" data-made-with="Adobe Firefly" data-made-with-for="sfondo">
      <div slot="backdrop" class="xd-div-bg" style={`--foto: url(${bg_search.src})`}></div>
      <Divisore num={ch.num} titolo={ch.title.it} punto={ch.punto} slug="ricerca" bussola />
    </Slide>

    <!-- ── L'idea, nel registro XD ───────────────────────────────────────
         Una slide, un'idea: il mockup grande, una cifra, la referenza.
         È quello che si proietta. Il meccanismo resta nelle slide che
         seguono e dietro «Scopri come» — due registri, non uno.
         Forma e contenuto stanno in `components/SlideIdea.astro` e
         `data/idee.ts`: una sola fonte per tutte e quattro. -->
    <SlideIdea slug="ricerca" />

    <!-- ── Il referto ────────────────────────────────────────────────────── -->
    <Slide id="slide-referto" data-stretto bg="primary" align="left" data-made-with="Adobe Firefly" data-made-with-for="sfondo">
      <div slot="backdrop" class="ex-bg-night" style={`--bg-src: url(${bg_search.src})`} data-parallax></div>
      <div class="xd-sl" data-reveal>
        <div class="xd-sl-head">
          <p class="xd-n">Una misura, non una teoria</p>
          <h2 class="xd-h2">Le stesse otto domande, due assistenti, due risposte diverse</h2>
          <!-- Lead accorciato quando è arrivato il blocco sul metodo: diceva le stesse
               cose, e una slide che ripete sé stessa due centimetri più sotto non è
               densa, è ridondante. Qui resta il fatto; il come sta nel blocco. -->
          {/* ⚠️ NIENTE <strong> QUI. Due <strong> che vanno a capo dentro lo
              stesso paragrafo hanno riquadri che si intersecano, e il check
              `e` li legge come testo sopra testo: è HARD, ed è la stessa
              trappola già annotata sulla slide d'apertura. */}
          {/* Il lead dice UNA cosa; il resto — che Trenitalia è quasi sempre
              nominata su entrambi — sta nelle cifre qui sotto e nel referto
              per intero, dove si verifica invece di essere raccontato. */}
          <p class="xd-sub">
            Nominati quasi sempre. La differenza è da quale sito i due assistenti vanno a
            prendere la risposta.
          </p>
        </div>
        <div class="tp-stats" data-stagger="0.1" data-reveal data-reveal-delay="0.14">
          {REFERTO.map((r) => (
            <div class="tp-stat">
              <!-- NIENTE conteggio animato su questi numeri, ed è una decisione, non una
             dimenticanza: mentre contava, la slide diceva «0 su 8 risposte nominano
             Trenitalia» — l'esatto contrario del fatto — e il 70.000 passava da
             «0.000». Su un capitolo che porta una misura, due secondi di numero
             falso costano più di quanto renda l'effetto. Il movimento resta dove
             non afferma niente: rivelazione, scaglionamento, parallasse, clip. -->
        <p class="tp-stat-v" data-display>{r.v}<span class="tp-stat-su">{r.su}</span></p>
              <p class="tp-stat-l">{r.l}</p>
              <p class="tp-stat-s">{r.s}</p>
            </div>
          ))}
        </div>
        {/* Le quattro cifre sopra sono una selezione: chi chiede «e il resto?»
            lo vede qui, dalla stessa misura, senza aprire un allegato. */}
        {/* Le quattro cifre sopra sono una selezione: chi chiede «e il resto?»
            lo vede qui, dalla stessa misura e senza aprire un allegato.
            L'elenco delle otto domande sta sulla copertina del capitolo: insieme,
            elenco e tabella sbordano (check `exp`, HARD). */}
        <HowItWorks title="Il referto per intero" label="Il referto per intero" tone="onLight" data-reveal data-reveal-delay="0.24">
          <table class="tp-ref-tab">
            <thead><tr><th>Che cosa abbiamo contato</th><th>Google · risposta generata</th><th>ChatGPT</th></tr></thead>
            <tbody>
              {REFERTO_INTERO.map((r) => (
                <tr><td>{r.m}</td><td>{r.g}</td><td>{r.c}</td></tr>
              ))}
            </tbody>
          </table>
        </HowItWorks>
        {/* La chiusa stava qui e diceva «non è un problema degli assistenti,
            è un problema di quale assistente». È vera e sta bene — ma con il
            referto aperto costava i 52 px che facevano sforare la slide a
            1280×800. Fra una frase e il campione verificabile vince il
            campione: la frase la dice chi presenta, il referto no. */}
        <p class="xd-fonte" data-reveal data-reveal-delay="0.32">
          {SOURCES.misura.label}, su 8 domande: contato il dominio trenitalia.com fra le fonti
          citate, non l’applicazione di acquisto. Un giro solo, a mano. Possiamo ripeterla insieme.
        </p>
      </div>
    </Slide>

    <!-- ── L'errore sul marchio, e di chi è ────────────────────────────── -->
    <Slide id="slide-frecce" bg="inverse" align="center" data-made-with="Adobe Firefly" data-made-with-for="sfondo">
      <div slot="backdrop" class="ex-bg-paper" style={`--bg-src: url(${bg_paper_lines.src})`} data-parallax></div>
      <div class="tp-quote" data-reveal>
        <p class="xd-n">Domanda {domandaCitata.n} delle otto: «{domandaCitata.t}», posta a due assistenti</p>
        <p class="tp-quote-big" data-display data-reveal data-reveal-delay="0.08">
          «Le principali compagnie che operano su questa tratta sono <strong>Frecciarossa,
          Italo, Trenitalia e Intercity</strong>.»
        </p>
        <p class="tp-quote-after" data-reveal data-reveal-delay="0.18">
          Quattro nomi sullo stesso piano, come fossero quattro aziende in concorrenza. Due
          sono vostri prodotti, e lo dice <strong>la risposta generata dentro la ricerca
          Google</strong>. <!-- copy-audit-ignore · citazione verbatim di ChatGPT: il trattino è suo -->
          Sulla stessa domanda ChatGPT scrive «Trenitalia — ricerca biglietti:
          confronta Frecciarossa, Intercity e regionali», e sulle stesse otto domande
          non sbaglia mai.
        </p>
        {/* ⚠️ IL CAMPIONE STA SULLA SLIDE CHE CITA UNA DELLE OTTO.
            Il rilievo del 3 novembre: il deck contava otto domande senza
            mostrarle mai, e qui cita una risposta — Torino-Bologna — che chi
            guarda non poteva ricollegare alla misura. Ora la domanda citata ha
            il suo numero nell'occhiello, e l'elenco intero si apre qui sotto.
            ⚠️ Elenco e tabella sono DIVISI, per misura e non per gusto: insieme
            non entrano in nessuna disclosure di questo capitolo, e sulla
            copertina nemmeno l'elenco da solo ci sta a 1280×800 (agenda a cinque
            voci più titolo di capitolo). La tabella sta sulla slide dei numeri.
            Il check è `exp`, ed è HARD su tutti e tre i viewport. */}
        <HowItWorks title="Le otto domande, una per conversazione nuova" label="Le otto domande, una per conversazione nuova" tone="onLight" data-reveal data-reveal-delay="0.3">
          <ol class="tp-dom">
            {DOMANDE.map((d) => (
              <li><span class="tp-dom-n">{d.n}</span><span class="tp-dom-t">{d.t}</span><span class="tp-dom-l">{d.lang}</span></li>
            ))}
          </ol>
        </HowItWorks>
        <p class="xd-fonte" data-reveal data-reveal-delay="0.26">
          {SOURCES.misura.label}: l’errore si ripete su un’altra delle otto domande.
        </p>
      </div>
    </Slide>

    <!-- ── Che cosa si misura, che cosa si cambia ────────────────────────── -->
    <Slide id="slide-leva" bg="primary" align="left" data-made-with="Adobe Firefly" data-made-with-for="sfondo">
      <div slot="backdrop" class="ex-bg-night" style={`--bg-src: url(${bg_search.src})`} data-parallax></div>
      <div class="xd-sl" data-reveal>
        <div class="xd-sl-head">
          <p class="xd-n">Che cosa si misura</p>
          <h2 class="xd-h2">Si cambia la pagina, e si vede se la risposta cambia</h2>
          {/* Il lead è UNA riga: il punto della slide, non il paragrafo che lo spiega.
              La prova — la risposta sulla Puglia che è quasi un testo loro — sta
              nella riga sotto le ancore, dove chi presenta la può indicare. */}
          <p class="xd-sub">
            <strong>Quando la pagina giusta esiste, la risposta la usa.</strong>
          </p>
        </div>
        <div class="tp-ancore" data-stagger>
          {KPI.map((x) => (
            <div class="tp-anc">
              <p class="tp-anc-k">{x.k}</p>
              <p class="tp-anc-n">{x.t}</p>
            </div>
          ))}
        </div>
        <p class="tp-ancore-dopo" data-reveal data-reveal-delay="0.2">
          Alla domanda sulla Puglia la risposta è quasi un vostro testo: «parti dal sito o
          dall’app di Trenitalia», su entrambi gli assistenti.
        </p>
        <!-- `tone` sembra invertito e non lo è: il componente assume una dominante chiara,
             dove `onLight` significa «inchiostro --ink-secondary». Qui la dominante è scura,
             quindi --ink-secondary È l'inchiostro chiaro, cioè quello che serve su questa
             slide. Si sceglie il tono che rende giusto, non quello che suona giusto. -->
        {/* 26 ott: il dettaglio si apre su FIGURE, non su paragrafi. In sala questo
            blocco si apre per rispondere a una domanda, e nessuno legge due
            paragrafi davanti a un cliente che aspetta: ogni voce è un meccanismo
            che si vede, l'ancora lo nomina, la riga porta il fatto che sopravvive
            all'inoltro. I pezzi restano sotto — li ha chiesti il cliente il 20. */}
        <HowItWorks title="Che cosa serve, concretamente" label="Che cosa serve, concretamente" tone="onLight" data-reveal data-reveal-delay="0.2">
          <Dettaglio>
            {KPI.map((x, i) => (
              <DettaglioVoce>
                <Figura k={(['risposta-citata', 'pagina-che-manca', 'pubblicare-dove-si-pubblica'] as const)[i]} />
                <p slot="ancora">{x.anc ?? x.t}</p>
                <p slot="riga">{x.b}</p>
              </DettaglioVoce>
            ))}
            <CheServe slot="nota" pezzi={SERVE.visibilita} />
          </Dettaglio>
        </HowItWorks>
      </div>
    </Slide>

    <!-- ── Il secondo tempo dello stesso canale ───────────────────────────
         16 ott. Chiude il capitolo: le tre slide prima dicono che su quel
         canale vi citano male, questa dice che su quello stesso canale, fra
         poco, si comprerà. Il perché sta qui e non nel capitolo del viaggio è
         scritto per esteso in `contenuti.ts`, insieme ai vincoli sul prodotto:
         annunciato sì, disponibile no, e nessun cliente da nominare. -->
    <Slide id="slide-canale" data-stretto bg="primary" align="left" data-made-with="Adobe Firefly" data-made-with-for="sfondo">
      <div slot="backdrop" class="ex-bg-night" style={`--bg-src: url(${bg_search.src})`} data-parallax></div>
      <div class="xd-sl" data-reveal>
        <div class="xd-sl-head">
          <p class="xd-n">Il secondo tempo dello stesso canale</p>
          <h2 class="xd-h2">Dove oggi vi citano, domani si comprerà</h2>
          <p class="xd-sub">
            <strong>Oggi la risposta manda altrove a comprare. Domani il banco sarà lì.</strong>
          </p>
        </div>
        {/* 26 ott: ancore, non card. L'occhiello e il nome restano in pagina; il
            paragrafo di ciascuna passa nel dettaglio qui sotto, dove si apre per
            rispondere a una domanda invece di stare addosso a chi parla. */}
        <div class="tp-ancore" data-stagger>
          {CANALE.map((x) => (
            <div class="tp-anc">
              <p class="tp-anc-k">{x.k}</p>
              <p class="tp-anc-n">{x.t}</p>
            </div>
          ))}
        </div>
        <p class="tp-ancore-dopo" data-reveal data-reveal-delay="0.2">
          Su WhatsApp un assistente vostro informa e rimanda al sito: lì chi scrive vi ha già scelti.
        </p>
        <HowItWorks title="Che cosa serve, concretamente" label="Che cosa serve, concretamente" tone="onLight" data-reveal data-reveal-delay="0.2">
          <Dettaglio>
            {CANALE.map((x, i) => (
              <DettaglioVoce>
                <Figura k={(['richiamata-dal-viaggiatore', 'offerta-nella-conversazione', 'pubblicare-dove-si-pubblica'] as const)[i]} />
                <p slot="ancora">{x.anc ?? x.t}</p>
                <p slot="riga">{x.b}</p>
              </DettaglioVoce>
            ))}
            <CheServe slot="nota" pezzi={SERVE.canale} />
          </Dettaglio>
        </HowItWorks>
        {/* Gli assistenti non scoprono da soli questi collegamenti — esporsi non
            basta, ed è il motivo per cui la visibilità resta il primo passo. Sta
            nel dettaglio, non qui: la riga delle fonti porta le fonti. */}
        <p class="xd-fonte" data-reveal data-reveal-delay="0.26">
          Il canale su messaggistica: <a href={SOURCES.whatsappTrenitalia.url} target="_blank" rel="noopener noreferrer">{SOURCES.whatsappTrenitalia.label}</a> ·
          su LLM Apps: <a href={SOURCES.llmApps.url} target="_blank" rel="noopener noreferrer">{SOURCES.llmApps.label}</a>
        </p>
      </div>
    </Slide>

  </DeckContainer>
</BaseLayout>
