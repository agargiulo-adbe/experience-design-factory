---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import HowItWorks from '@edf/core/blocks/HowItWorks.astro';
import { href } from '@edf/core/utils/url.js';
import { CHAPTERS, prevSlug, nextSlug } from '../data/chapters';
import { REFERTO, KPI } from '../data/contenuti';
import { SOURCES } from '../data/sources';
import bg_chapter from '../assets/generated/bg/bg-chapter.webp';
import bg_paper_lines from '../assets/generated/bg/bg-paper-lines.webp';
import bg_search from '../assets/generated/bg/bg-search.webp';

/**
 * Capitolo 03 — Quando un viaggio si cerca con l'intelligenza artificiale.
 *
 * È il capitolo che porta una misura NOSTRA, come la lettura delle superfici nel
 * dossier: le stesse otto domande di viaggio, nessuna di marca, poste a DUE assistenti
 * — ChatGPT il 12 ottobre e la risposta generata di Google l'11. Il limite del campione
 * (due assistenti, otto domande) sta scritto in slide; il PERCHÉ gli altri due sono
 * fuori — un account gratuito che si esaurisce, una sessione che non parte — è un
 * dettaglio operativo che a un direttore commerciale non dice niente e sposta
 * l'attenzione sulla nostra attrezzatura invece che sul suo mercato: sta nel
 * documento di metodo, non in slide.
 * Dati grezzi, metodo e limiti in
 * docs/Ferrovie/MISURA-visibilita-risposte-generate-2026-10-11.md.
 *
 * Il secondo giro ha cambiato la tesi, non solo i numeri. Con un motore solo la slide
 * diceva «non vi citano»; con due si vede che **dipende da quale assistente**: Google
 * costruisce la risposta sui rivenditori e sbaglia due volte su otto di chi sono le
 * Frecce, ChatGPT va sui siti ufficiali e non sbaglia mai. Attribuire l'errore a «gli
 * assistenti» sarebbe stato falso, e su una slide che accusa qualcuno di sbagliare un
 * fatto, sbagliare un fatto è fatale.
 *
 * Regola rispettata alla lettera: si dice «la fotografia che abbiamo scattato noi
 * l'11 e il 12 ottobre, otto domande, due assistenti», mai «il 75% delle risposte vi
 * ignora». Il limite del campione è dichiarato IN SLIDE: se lo trova il cliente per
 * primo, cade tutto il resto.
 */
const SLUG = 'ricerca';
const ch = CHAPTERS.find((c) => c.slug === SLUG)!;
const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;


---
<BaseLayout title={ch.title.it}>
  <div class="fixed top-0 left-0 right-0 z-50">
    <Navigation currentPath={currentPath} base={base} />
  </div>

  <DeckContainer wallScale nextHref={href(base, nextSlug(SLUG))} prevHref={href(base, prevSlug(SLUG))}>

    <!-- ── Cover del capitolo ────────────────────────────────────────────── -->
    <Slide id="slide-cover" bg="primary" align="center" data-made-with="Adobe Firefly" data-made-with-for="sfondo">
      <div slot="backdrop" class="ex-bg-night" style={`--bg-src: url(${bg_chapter.src})`} data-parallax></div>
      <div class="ex-ch" data-reveal>
        <p class="ex-ch-num">Capitolo {ch.num}</p>
        <h2 class="ex-ch-title" data-reveal data-reveal-delay="0.08">{ch.title.it}</h2>
        <p class="ex-ch-lead" data-reveal data-reveal-delay="0.15">
          Il primo punto del percorso, prima di ogni vostra pagina. Non una teoria:
          una misura, su due assistenti.
        </p>
        <div class="ex-ch-agenda" data-reveal data-reveal-delay="0.22">
          <p class="ex-ch-agenda-k">In questo capitolo</p>
          <ul role="list">
            <li><span class="ex-ch-agenda-n" aria-hidden="true">1</span><span>Otto domande, nessuna di marca</span></li>
            <li><span class="ex-ch-agenda-n" aria-hidden="true">2</span><span>Di chi sono le Frecce</span></li>
            <li><span class="ex-ch-agenda-n" aria-hidden="true">3</span><span>Che cosa si misura, e che cosa si cambia</span></li>
          </ul>
        </div>
        <!-- Il metodo sta sulla COPERTINA del capitolo, non in un allegato e non sulla
             slide dei numeri. Non in allegato perché la prima domanda che arriva su un
             dato è «da dove viene?», e una slide che manda a cercare la risposta altrove
             l'ha già persa. Non sulla slide dei numeri perché lì, espanso, sfondava la
             safe-area a 1280 — e il contratto dice di tagliare o dividere, mai di
             rimpicciolire. Qui la frase sopra lo annuncia già («con il metodo in
             chiaro»), e si dichiara come si è misurato PRIMA di mostrare il risultato,
             che è anche l'ordine giusto. I limiti stanno dentro: dichiararli noi vale,
             farseli trovare dal cliente no. -->
        <HowItWorks title="Come l’abbiamo misurato" label="Come l’abbiamo misurato" tone="onLight" data-reveal data-reveal-delay="0.3">
          <p>
            <strong>Chi, e con che cosa.</strong> <strong>ChatGPT</strong> e la <strong>risposta
            generata di Google</strong>, stesse otto domande, una per conversazione nuova.
            Nessuna domanda contiene un nome di marca.
          </p>
          <p>
            <strong>Che cosa abbiamo registrato, e i limiti.</strong> Chi è nominato, quali siti
            sono citati come fonte, se i prodotti sono attribuiti a chi li fa. Quattro domande in
            italiano e quattro in inglese. Due assistenti e otto domande: è una fotografia, va
            riscattata prima di usarla.
          </p>
        </HowItWorks>
      </div>
    </Slide>

    <!-- ── Il referto ────────────────────────────────────────────────────── -->
    <Slide id="slide-referto" bg="primary" align="left" data-made-with="Adobe Firefly" data-made-with-for="sfondo">
      <div slot="backdrop" class="ex-bg-night" style={`--bg-src: url(${bg_search.src})`} data-parallax></div>
      <div class="ex-content" data-reveal>
        <div class="ex-head">
          <p class="slide-eyebrow">Una misura, non una teoria</p>
          <h2 class="ex-head-title">Le stesse otto domande, due assistenti, due risposte diverse</h2>
          <!-- Lead accorciato quando è arrivato il blocco sul metodo: diceva le stesse
               cose, e una slide che ripete sé stessa due centimetri più sotto non è
               densa, è ridondante. Qui resta il fatto; il come sta nel blocco. -->
          <p class="ex-head-lead">
            Abbiamo chiesto a <strong>ChatGPT</strong> e alla <strong>risposta generata di Google</strong>
            come si arriva a Matera, alle Cinque Terre, in Puglia, da Torino a Bologna: otto
            domande, quattro in italiano e quattro in inglese.
            Nessuna contiene un nome di marca. <strong>Nominata</strong> nel testo della risposta,
            Trenitalia c’è quasi sempre su entrambi. Il problema non è la menzione: è <strong>da
            quale sito</strong> i due vanno a prendere quello che dicono.
          </p>
        </div>
        <div class="tp-stats" data-stagger="0.1" data-reveal data-reveal-delay="0.14">
          {REFERTO.map((r) => (
            <div class="tp-stat">
              <!-- NIENTE conteggio animato su questi numeri, ed è una decisione, non una
             dimenticanza: mentre contava, la slide diceva «0 su 8 risposte nominano
             Trenitalia» — l'esatto contrario del fatto — e il 70.000 passava da
             «0.000». Su un capitolo che porta una misura, due secondi di numero
             falso costano più di quanto renda l'effetto. Il movimento resta dove
             non afferma niente: rivelazione, scaglionamento, parallasse, clip. -->
        <p class="tp-stat-v" data-display>{r.v}<span class="tp-stat-su">{r.su}</span></p>
              <p class="tp-stat-l">{r.l}</p>
              <p class="tp-stat-s">{r.s}</p>
            </div>
          ))}
        </div>
        <p class="ex-src" data-reveal data-reveal-delay="0.3">
          {SOURCES.misura.label}: contato il dominio trenitalia.com fra le fonti citate, non
          l’applicazione di acquisto. Un giro solo, a mano: una fotografia nostra, non una
          statistica — e la rifacciamo davanti a voi quando volete.
        </p>
      </div>
    </Slide>

    <!-- ── L'errore sul marchio, e di chi è ────────────────────────────── -->
    <Slide id="slide-frecce" bg="inverse" align="center" data-made-with="Adobe Firefly" data-made-with-for="sfondo">
      <div slot="backdrop" class="ex-bg-paper" style={`--bg-src: url(${bg_paper_lines.src})`} data-parallax></div>
      <div class="tp-quote" data-reveal>
        <p class="slide-eyebrow">«Come andare da Torino a Bologna in giornata senza auto», la stessa domanda a due assistenti</p>
        <p class="tp-quote-big" data-display data-reveal data-reveal-delay="0.08">
          «Le principali compagnie che operano su questa tratta sono <strong>Frecciarossa,
          Italo, Trenitalia e Intercity</strong>.»
        </p>
        <p class="tp-quote-after" data-reveal data-reveal-delay="0.18">
          Quattro nomi sullo stesso piano, come fossero quattro aziende in concorrenza. Due
          sono vostri prodotti, e lo dice <strong>la risposta generata dentro la ricerca
          Google</strong>. Sulla stessa domanda ChatGPT scrive «Trenitalia — ricerca biglietti:
          confronta Frecciarossa, Intercity e regionali», e non sbaglia in nessuna delle otto.
          <strong>Non è un problema degli assistenti: è un problema di quale assistente.</strong>
        </p>
        <p class="ex-src" data-reveal data-reveal-delay="0.26">
          {SOURCES.misura.label}: l’errore si ripete su un’altra delle otto domande.
        </p>
      </div>
    </Slide>

    <!-- ── Che cosa si misura, che cosa si cambia ────────────────────────── -->
    <Slide id="slide-leva" bg="primary" align="left" data-made-with="Adobe Firefly" data-made-with-for="sfondo">
      <div slot="backdrop" class="ex-bg-night" style={`--bg-src: url(${bg_search.src})`} data-parallax></div>
      <div class="ex-content" data-reveal>
        <div class="ex-head">
          <p class="slide-eyebrow">Che cosa si misura, e che cosa si cambia</p>
          <h2 class="ex-head-title">Si può intervenire, e si vede se ha funzionato</h2>
          <p class="ex-head-lead">
            Alla domanda sulla Puglia la risposta è quasi un vostro testo: Trenitalia protagonista
            e «parti dal sito o dall’app di Trenitalia», su entrambi gli assistenti.
            <strong>Quando la pagina giusta esiste, la risposta la usa.</strong>
          </p>
        </div>
        <div class="ex-cards" data-reveal data-reveal-delay="0.14">
          {KPI.map((x) => (
            <div class="ex-card">
              <p class="ex-card-k">{x.k}</p>
              <p class="ex-card-t">{x.t}</p>
              <p class="ex-card-b">{x.b}</p>
            </div>
          ))}
        </div>
        <!-- `tone` sembra invertito e non lo è: il componente assume una dominante chiara,
             dove `onLight` significa «inchiostro --ink-secondary». Qui la dominante è scura,
             quindi --ink-secondary È l'inchiostro chiaro, cioè quello che serve su questa
             slide. Si sceglie il tono che rende giusto, non quello che suona giusto. -->
        <HowItWorks title="Come si interviene" label="Come si interviene" tone="onLight" data-reveal data-reveal-delay="0.2">
          <p>
            Si parte dalle domande vere dei vostri mercati, non da parole chiave: per ciascuna
            si vede chi è nominato, e da dove.
          </p>
          <p>
            Lo strumento è <strong><a href={SOURCES.brandVisibility.url} target="_blank" rel="noopener noreferrer">{SOURCES.brandVisibility.label}</a></strong>:
            misura la presenza del marchio nelle risposte
            generate e propone i pezzi che mancano. <strong>La pubblicazione resta nel vostro
            flusso</strong>: gestionale, approvazione, rilascio. La via al bordo della rete
            esiste, ed è un requisito di architettura da discutere, non una scorciatoia.
          </p>
        </HowItWorks>
      </div>
    </Slide>

  </DeckContainer>
</BaseLayout>
