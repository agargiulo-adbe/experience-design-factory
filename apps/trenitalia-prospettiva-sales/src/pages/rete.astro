---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import Divisore from '../components/Divisore.astro';
import SlideIdea from '../components/SlideIdea.astro';
import HowItWorks from '@edf/core/blocks/HowItWorks.astro';
import CheServe from '../components/CheServe.astro';
import { href } from '@edf/core/utils/url.js';
import { CHAPTERS, prevSlug, nextSlug } from '../data/chapters';
import { RETE, SAPERE, SERVE } from '../data/contenuti';
import { SOURCES } from '../data/sources';
import bg_network from '../assets/generated/bg/bg-network.webp';
import bg_paper_lines from '../assets/generated/bg/bg-paper-lines.webp';
import Dettaglio from '@edf/core/blocks/Dettaglio.astro';
import DettaglioVoce from '@edf/core/blocks/DettaglioVoce.astro';
import Figura from '../components/Figura.astro';

/**
 * Capitolo 06 — Il canale delle agenzie.
 *
 * L'unico capitolo che cade INTERAMENTE nel perimetro dell'interlocutore: non
 * deve chiedere il permesso a nessuno per volerlo. È anche il primo a cadere se
 * l'ora si accorcia — e in quel caso il suo contenuto diventa il passo finale,
 * non sparisce. Il gating capitoli della console lo spegne in una riga.
 *
 * Il numero grande era «70.000 punti vendita raggiunti attraverso la piattaforma
 * con cui le agenzie vi vendono»: sono due cose diverse messe insieme. I 70.000
 * sono la rete di terzi che vende il REGIONALE (numero del 2014, ingresso delle
 * ricevitorie Sisal); le agenzie di viaggio sono 12.400 e sono il suo canale,
 * contate da lui al TTG dell'ottobre 2025. E il rifacimento della piattaforma,
 * che prima era affermato, non ha una fonte pubblica: adesso è una domanda —
 * che in una Prospettiva vale più di un'asserzione, e non si può smentire.
 */
const SLUG = 'rete';
const ch = CHAPTERS.find((c) => c.slug === SLUG)!;
const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;
---
<BaseLayout title={ch.title.it}>
  <div class="fixed top-0 left-0 right-0 z-50">
    <Navigation currentPath={currentPath} base={base} />
  </div>

  <DeckContainer wallScale nextHref={href(base, nextSlug(SLUG))} prevHref={href(base, prevSlug(SLUG))}>

    <!-- ── Divisore di capitolo ─────────────────────────────────────────
         La forma XD: titolo grande, fotografia, pannello di colore. Sostituisce
         la vecchia cover a testo centrato — con l'agenda, il lead e il blocco
         del metodo impilati, era una slide di contenuto travestita da respiro.
         Titolo, punto e fotografia vengono da `chapters.ts`: una fonte sola.
         ⚠️ Il fondo sta QUI e non dentro `Divisore.astro`: Astro non propaga
         `slot="backdrop"` attraverso un componente. -->
    <Slide id="slide-cover" bg="primary" align="left" data-made-with="Adobe Firefly" data-made-with-for="sfondo">
      <div slot="backdrop" class="xd-div-bg" style={`--foto: url(${bg_network.src})`}></div>
      <Divisore num={ch.num} titolo={ch.title.it} punto={ch.punto} tavolo={ch.tavolo} slug="rete" bussola />
    </Slide>

    <!-- ── L'idea, nel registro XD ───────────────────────────────────────
         Una slide, un'idea: il mockup grande, una cifra, la referenza.
         È quello che si proietta. Il meccanismo resta nelle slide che
         seguono e dietro «Scopri come» — due registri, non uno.
         Forma e contenuto stanno in `components/SlideIdea.astro` e
         `data/idee.ts`: una sola fonte per tutte e quattro. -->
    <SlideIdea slug="rete" />

    <!-- ── Il numero, e la domanda sulla finestra ────────────────────────── -->
    <Slide id="slide-settantamila" bg="primary" align="center" data-made-with="Adobe Firefly" data-made-with-for="sfondo">
      <div slot="backdrop" class="ex-bg-night" style={`--bg-src: url(${bg_network.src})`} data-parallax></div>
      <div class="tp-quote" data-reveal>
        <p class="xd-n">Nel canale che è vostro</p>
        <p class="tp-big-number" data-display data-reveal data-reveal-delay="0.06">{RETE.numero}</p>
        <p class="tp-quote-after" data-reveal data-reveal-delay="0.16" set:html={RETE.dopo} />
        <p class="xd-fonte" data-reveal data-reveal-delay="0.24">
          <a href={SOURCES.ttg96.url} target="_blank" rel="noopener noreferrer">{SOURCES.ttg96.label}</a> ·
          <a href={SOURCES.retePunti.url} target="_blank" rel="noopener noreferrer">{SOURCES.retePunti.label}</a> ·
          <a href={SOURCES.agenzie.url} target="_blank" rel="noopener noreferrer">{SOURCES.agenzie.label}</a>
        </p>
      </div>
    </Slide>

    <!-- ── Che cosa si potrebbe sapere ───────────────────────────────────── -->
    <Slide id="slide-sapere" bg="inverse" align="left" data-made-with="Adobe Firefly" data-made-with-for="sfondo">
      <div slot="backdrop" class="ex-bg-paper" style={`--bg-src: url(${bg_paper_lines.src})`} data-parallax></div>
      <div class="xd-sl" data-reveal>
        <div class="xd-sl-head">
          <p class="xd-n">La domanda</p>
          <h2 class="xd-h2">Che cosa sapreste, se guardaste la rete come guardate un sito</h2>
          {/* ⚠️ 4 nov: diceva «sapete tutto… quasi nulla» e «manca la strumentazione».
              Di che cosa vedano della rete non esiste fonte, e un'affermazione di assenza
              su un cliente si verifica sulle sue pagine prima di scriverla — è la stessa
              correzione già fatta alla chiusa dell'idea. Qui resta l'osservazione, e la
              domanda. «Le convenzioni con le agenzie» non è una parola nostra: la slide
              che chiude il capitolo la usa già. */}
          <p class="xd-sub">
            Di un canale digitale si sa chi entra e che cosa funziona. Di un canale intermediato
            questo si ricostruisce: <strong>quanto ne arriva fino a voi?</strong>
          </p>
        </div>
        <div class="tp-ancore" data-stagger>
          {SAPERE.map((x) => (
            <div class="tp-anc">
              <p class="tp-anc-k">{x.k}</p>
              <p class="tp-anc-n">{x.t}</p>
            </div>
          ))}
        </div>
        <HowItWorks title="Che cosa si vedrebbe" label="Che cosa si vedrebbe" tone="onLight" data-reveal data-reveal-delay="0.2">
          <Dettaglio>
            {SAPERE.map((x, i) => (
              <DettaglioVoce>
                <Figura k={(['venduto-per-agenzia', 'materiale-che-converte', 'prova-su-una-parte'] as const)[i]} />
                <p slot="ancora">{x.anc ?? x.t}</p>
                <p slot="riga">{x.b}</p>
              </DettaglioVoce>
            ))}
            {/* ⚠️ 6 nov 2026, panel: la leva è a due mani, e dirlo noi toglie
                dal tavolo l'obiezione più grossa del capitolo — «un'agenzia
                vende ciò che le rende di più». Sta qui e non nel lead perché
                a 1280×800, col blocco aperto, una riga in più spingeva il
                titolo fuori dalla safe-area (check `c` dentro `exp`, HARD).
                La domanda che ne discende è fra quelle aperte del capitolo 07. */}
            <p slot="nota">La misura prima, la prova dopo. E la leva è a due mani: questa dice quale rete vende che cosa, il venduto lo muovono le convenzioni, e restano vostre.</p>
          </Dettaglio>
        </HowItWorks>
      </div>
    </Slide>

    <!-- ── La domanda, e con che cosa si risponde ─────────────────────────
         20 ott: questo capitolo era l'unico senza il «che cosa serve» — detto
         in riunione, ed era vero: si chiedeva al cliente di immaginare una
         misura senza dire con che cosa si fa. Sta su una slide SUA e non in
         fondo alla precedente: provata lì, col blocco aperto la slide sforava
         la safe-area di 122px a 1280, e il contratto dice di dividere, non di
         rimpicciolire. Così la domanda resta sola, che è anche meglio.

         La riga che qui nominava Adobe Target «fra i requisiti della nuova
         piattaforma» era uscita il 15 ott: un fornitore che si autonomina
         dentro i requisiti di una gara è un tema di procurement prima che di
         merito. Nel blocco qui sotto il prodotto torna, ma in un'altra veste —
         che cosa serve alla NOSTRA proposta, non che cosa deve chiedere il loro
         capitolato. -->
    <Slide id="slide-serve" bg="primary" align="left" data-made-with="Adobe Firefly" data-made-with-for="sfondo">
      <div slot="backdrop" class="ex-bg-night" style={`--bg-src: url(${bg_network.src})`} data-parallax></div>
      <div class="xd-sl" data-reveal>
        <div class="xd-sl-head">
          <p class="xd-n">Nel canale che è vostro</p>
          {/* ⚠️ 6 nov 2026, panel: il titolo diceva «costa poco adesso, dopo è
              un progetto a sé», e dava per aperto un cantiere di cui non
              esiste fonte pubblica — è la formula dell'urgenza commerciale, e
              chi fa i sistemi la riconosce. Il 15 ottobre PICO era uscito dal
              deck per la stessa ragione, e la frase se l'era riportata dentro
              dalla finestra. Ora il presupposto è la prima domanda della
              sessione, e sta nel lead (`RETE.domanda`). */}
          <h2 class="xd-h2">Quando conviene misurare un canale che sta per cambiare</h2>
          <p class="xd-sub">{RETE.domanda}</p>
        </div>
        <HowItWorks title="Che cosa serve, concretamente" label="Che cosa serve, concretamente" tone="onLight" data-reveal data-reveal-delay="0.16">
          <Dettaglio>
            <DettaglioVoce>
              <Figura k="rete-muta" />
              <p slot="ancora">Il collegamento che manca</p>
              <p slot="riga">Non è uno strumento: quei dati non arrivano dove arriva il resto.</p>
            </DettaglioVoce>
            <DettaglioVoce>
              <Figura k="venduto-per-agenzia" />
              <p slot="ancora">Il venduto, per rete e per prodotto</p>
              <p slot="riga">Il venduto deve uscire dal sistema con cui le agenzie vendono: in che stato è oggi?</p>
            </DettaglioVoce>
            <DettaglioVoce>
              <Figura k="prova-su-una-parte" />
              <p slot="ancora">La prova prima di estenderla</p>
              <p slot="riga">Una proposta diversa su una parte della rete, misurata prima di portarla a tutte.</p>
            </DettaglioVoce>
            <CheServe slot="nota" pezzi={SERVE.rete} />
          </Dettaglio>
        </HowItWorks>
      </div>
    </Slide>

  </DeckContainer>
</BaseLayout>
