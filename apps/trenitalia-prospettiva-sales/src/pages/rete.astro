---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import ChapterPoint from '@edf/core/blocks/immersive/ChapterPoint.astro';
import { href } from '@edf/core/utils/url.js';
import { CHAPTERS, prevSlug, nextSlug } from '../data/chapters';
import { RETE, SAPERE } from '../data/contenuti';
import { SOURCES } from '../data/sources';
import bg_chapter from '../assets/generated/bg/bg-chapter.webp';
import bg_network from '../assets/generated/bg/bg-network.webp';
import bg_paper_lines from '../assets/generated/bg/bg-paper-lines.webp';

/**
 * Capitolo 06 — Il canale delle agenzie.
 *
 * L'unico capitolo che cade INTERAMENTE nel perimetro dell'interlocutore: non
 * deve chiedere il permesso a nessuno per volerlo. È anche il primo a cadere se
 * l'ora si accorcia — e in quel caso il suo contenuto diventa il passo finale,
 * non sparisce. Il gating capitoli della console lo spegne in una riga.
 *
 * Il numero grande era «70.000 punti vendita raggiunti attraverso la piattaforma
 * con cui le agenzie vi vendono»: sono due cose diverse messe insieme. I 70.000
 * sono la rete di terzi che vende il REGIONALE (numero del 2014, ingresso delle
 * ricevitorie Sisal); le agenzie di viaggio sono 12.400 e sono il suo canale,
 * contate da lui al TTG dell'ottobre 2025. E il rifacimento della piattaforma,
 * che prima era affermato, non ha una fonte pubblica: adesso è una domanda —
 * che in una Prospettiva vale più di un'asserzione, e non si può smentire.
 */
const SLUG = 'rete';
const ch = CHAPTERS.find((c) => c.slug === SLUG)!;
const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;
---
<BaseLayout title={ch.title.it}>
  <div class="fixed top-0 left-0 right-0 z-50">
    <Navigation currentPath={currentPath} base={base} />
  </div>

  <DeckContainer wallScale nextHref={href(base, nextSlug(SLUG))} prevHref={href(base, prevSlug(SLUG))}>

    <!-- ── Cover del capitolo ────────────────────────────────────────────── -->
    <Slide id="slide-cover" bg="primary" align="center" data-made-with="Adobe Firefly" data-made-with-for="sfondo">
      <div slot="backdrop" class="ex-bg-night" style={`--bg-src: url(${bg_chapter.src})`} data-parallax></div>
      <div class="ex-ch" data-reveal>
        <p class="ex-ch-num">Capitolo {ch.num}</p>
        <h2 class="ex-ch-title" data-reveal data-reveal-delay="0.08">{ch.title.it}</h2>
        <p class="ex-ch-lead" data-reveal data-reveal-delay="0.15">
          L’ultimo punto del percorso, e il più vicino a casa: un canale vostro, che vende ogni giorno e non vi racconta quasi niente.
        </p>
      </div>
    </Slide>

    <!-- ── Il numero, e la domanda sulla finestra ────────────────────────── -->
    <Slide id="slide-settantamila" bg="primary" align="center" data-made-with="Adobe Firefly" data-made-with-for="sfondo">
      <div slot="backdrop" class="ex-bg-night" style={`--bg-src: url(${bg_network.src})`} data-parallax></div>
      <div class="tp-quote" data-reveal>
        <p class="slide-eyebrow">Nel canale che è vostro</p>
        <p class="tp-big-number" data-display data-reveal data-reveal-delay="0.06">{RETE.numero}</p>
        <p class="tp-quote-after" data-reveal data-reveal-delay="0.16" set:html={RETE.dopo} />
        <p class="ex-src" data-reveal data-reveal-delay="0.24">
          <a href={SOURCES.ttg96.url} target="_blank" rel="noopener noreferrer">{SOURCES.ttg96.label}</a> ·
          <a href={SOURCES.retePunti.url} target="_blank" rel="noopener noreferrer">{SOURCES.retePunti.label}</a> ·
          <a href={SOURCES.agenzie.url} target="_blank" rel="noopener noreferrer">{SOURCES.agenzie.label}</a> ·
          <a href={SOURCES.pico.url} target="_blank" rel="noopener noreferrer">{SOURCES.pico.label}</a>
        </p>
      </div>
    </Slide>

    <!-- ── Che cosa si potrebbe sapere ───────────────────────────────────── -->
    <Slide id="slide-sapere" bg="inverse" align="left" data-made-with="Adobe Firefly" data-made-with-for="sfondo">
      <div slot="backdrop" class="ex-bg-paper" style={`--bg-src: url(${bg_paper_lines.src})`} data-parallax></div>
      <div class="ex-content" data-reveal>
        <div class="ex-head">
          <p class="slide-eyebrow">La domanda</p>
          <h2 class="ex-head-title">Che cosa sapreste, se guardaste la rete come guardate un sito</h2>
          <p class="ex-head-lead">
            Di un canale digitale sapete tutto: chi entra, dove si ferma, che cosa funziona. Di un
            canale intermediato, quasi nulla. <strong>In parte manca la strumentazione, in parte manca il diritto di
            guardare</strong>: la prima cosa da vedere insieme è che cosa le convenzioni con le
            agenzie permettono di osservare.
          </p>
        </div>
        <div class="ex-cards" data-reveal data-reveal-delay="0.14">
          {SAPERE.map((x) => (
            <div class="ex-card">
              <p class="ex-card-k">{x.k}</p>
              <p class="ex-card-t">{x.t}</p>
              <p class="ex-card-b">{x.b}</p>
            </div>
          ))}
        </div>
      </div>
    </Slide>

    <!-- ── La domanda su PICO ─────────────────────────────────────────────
         Stava in fondo alla slide precedente, sotto tre carte e una testa: 248
         parole in una schermata, e la domanda che chiede la riunione era l'ultima
         riga. Divisa, non accorciata: nessuna parola è stata tolta, e la domanda
         adesso ha il suo tempo. La riga dei due requisiti non ripete più le carte
         accanto — ne nomina lo strumento, che è l'unica cosa che le carte non
         dicono. -->
    <Slide id="slide-pico" bg="inverse" align="left" data-made-with="Adobe Firefly" data-made-with-for="sfondo">
      <div slot="backdrop" class="ex-bg-paper" style={`--bg-src: url(${bg_paper_lines.src})`} data-parallax></div>
      <div class="ex-content" data-reveal>
        <div class="tp-ask tp-ask--solo" data-reveal data-reveal-delay="0.08">
          <p class="tp-ask-k">La domanda che vi facciamo</p>
          <p class="tp-ask-t">{RETE.domanda}</p>
        </div>
        <p class="ex-src" data-reveal data-reveal-delay="0.18">
          Lo strumento per provare una variante su una parte della rete, misurandone l’effetto, è
          <strong><a href={SOURCES.target.url} target="_blank" rel="noopener noreferrer">{SOURCES.target.label}</a></strong>,
          o quello che sceglierete.
        </p>
      </div>
    </Slide>

    <!-- ── Il punto: la frase con cui il capitolo si chiude ───────────────── -->
    <ChapterPoint messaggio={ch.messaggio} data-made-with="" />

  </DeckContainer>
</BaseLayout>
