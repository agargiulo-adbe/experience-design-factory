---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import HowItWorks from '@edf/core/blocks/HowItWorks.astro';
import Figura from '../components/Figura.astro';
import DettaglioVoce from '@edf/core/blocks/DettaglioVoce.astro';
import Dettaglio from '@edf/core/blocks/Dettaglio.astro';
import MappaPunti from '../components/MappaPunti.astro';
import Divisore from '../components/Divisore.astro';
import AgendaCapitolo from '../components/AgendaCapitolo.astro';
import { href } from '@edf/core/utils/url.js';
import { CHAPTERS, prevSlug, nextSlug } from '../data/chapters';
import { DOMANDA, PUNTI, TESTE } from '../data/contenuti';
import { SOURCES } from '../data/sources';
import bg_close from '../assets/generated/bg/bg-close.webp';
import bg_chapter from '../assets/generated/bg/bg-chapter.webp';
import bg_journey from '../assets/generated/bg/bg-journey.webp';

/**
 * Capitolo 02 — La domanda.
 *
 * Il capitolo-cerniera: trasforma il contesto in una domanda sola, e la domanda
 * nella mappa del resto del deck. I quattro punti SONO i quattro capitoli che
 * seguono, nello stesso ordine: chi ha visto questa slide sa già dove stiamo
 * andando, e può fermarci sul punto che gli interessa.
 *
 * La domanda e i quattro punti stanno in `src/data/contenuti.ts` perché vivono
 * anche nel taglio «In dieci minuti»: due copie a mano divergono, e la domanda
 * è l'ultima cosa che può permettersi di cambiare parola fra due versioni.
 */
const SLUG = 'domanda';
const ch = CHAPTERS.find((c) => c.slug === SLUG)!;
const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;

---
<BaseLayout title={ch.title.it}>
  <div class="fixed top-0 left-0 right-0 z-50">
    <Navigation currentPath={currentPath} base={base} />
  </div>

  <DeckContainer wallScale nextHref={href(base, nextSlug(SLUG))} prevHref={href(base, prevSlug(SLUG))}>

    <!-- ── Divisore di capitolo ─────────────────────────────────────────
         La forma XD: titolo grande, fotografia, pannello di colore. Sostituisce
         la vecchia cover a testo centrato — con l'agenda, il lead e il blocco
         del metodo impilati, era una slide di contenuto travestita da respiro.
         Titolo, punto e fotografia vengono da `chapters.ts`: una fonte sola.
         ⚠️ Il fondo sta QUI e non dentro `Divisore.astro`: Astro non propaga
         `slot="backdrop"` attraverso un componente. -->
    <Slide id="slide-cover" bg="primary" align="left" data-made-with="Adobe Firefly" data-made-with-for="sfondo">
      <div slot="backdrop" class="xd-div-bg" style={`--foto: url(${bg_close.src})`}></div>
      <Divisore num={ch.num} titolo={ch.title.it} punto={ch.punto} slug="domanda" />
    </Slide>

    <!-- ── La domanda, grande e sola ─────────────────────────────────────── -->
    <Slide id="slide-domanda" bg="brand" align="center">
      <div class="tp-quote" data-reveal>
        <p class="xd-n" data-reveal>{DOMANDA.eyebrow}</p>
        <h2 class="tp-domanda" data-display data-reveal data-reveal-delay="0.06" set:html={DOMANDA.titolo} />
        <p class="tp-domanda-sub" data-reveal data-reveal-delay="0.18">{DOMANDA.sub}</p>
                <p class="tp-domanda-peri" data-reveal data-reveal-delay="0.26">{DOMANDA.perimetri}</p>
        <p class="xd-fonte" data-reveal data-reveal-delay="0.32">
          <a href={SOURCES.riorgCommerciale.url} target="_blank" rel="noopener noreferrer">{SOURCES.riorgCommerciale.label}</a>
        </p>
      </div>
    </Slide>

    <!-- ── I quattro punti = i quattro capitoli che seguono ───────────────── -->
    <Slide id="slide-mappa" data-stretto bg="primary" align="left" data-made-with="Adobe Firefly" data-made-with-for="sfondo">
      <div slot="backdrop" class="ex-bg-night" style={`--bg-src: url(${bg_journey.src})`} data-parallax></div>
      <div class="xd-sl" data-reveal>
        <div class="xd-sl-head">
          <p class="xd-n">{TESTE.mappa.eyebrow}</p>
          <h2 class="xd-h2">{TESTE.mappa.titolo}</h2>
          <p class="xd-sub">{TESTE.mappa.lead}</p>
        </div>
        {/* ⚠️ ERA QUATTRO CARD DI PROSA: 207 parole visibili, la slide più
            pesante del percorso — e proprio quella su cui chi parla deve
            essere ascoltato, perché è la mappa di tutto il resto. In video
            le slide si leggono invece di ascoltarle.
            Ora la mappa è un filo con quattro fermate e un'ancora ciascuna;
            i paragrafi stanno dietro «Scopri come», dalla stessa fonte. */}
        <MappaPunti punti={PUNTI} />
        {/* ⚠️ DENTRO UN «SCOPRI COME» VANNO FIGURE, NON PARAGRAFI. Quattro
            paragrafi qui dentro sono lo stesso muro di testo, soltanto
            nascosto — e aperto in sala sfondavano la safe-area (check `exp`,
            HARD). La forma è `Dettaglio` + `DettaglioVoce`: un micro-diagramma
            che si muove, l'ancora che lo nomina, una riga che sopravvive
            all'inoltro. La riga breve viene dalla stessa fonte dei punti. */}
        <HowItWorks title="Che cosa succede in ciascuno" label="Che cosa succede in ciascuno" tone="onLight" data-reveal data-reveal-delay="0.24">
          <Dettaglio>
            {PUNTI.map((p, i) => (
              <DettaglioVoce>
                <Figura k={(['risposta-citata', 'indistinguibile', 'materiale-che-si-moltiplica', 'rete-muta'] as const)[i]} />
                <p slot="ancora">{p.dove}</p>
                <p slot="riga">{p.bRiga ?? p.bBreve ?? p.b}</p>
              </DettaglioVoce>
            ))}
          </Dettaglio>
        </HowItWorks>
      </div>
    </Slide>

  </DeckContainer>
</BaseLayout>
