---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import MappaIdee from '../components/MappaIdee.astro';
import { href } from '@edf/core/utils/url.js';
import { CHAPTERS, prevSlug, nextSlug } from '../data/chapters';
import { DOMANDA, INNESTO, TESTE } from '../data/contenuti';
import { SOURCES } from '../data/sources';

/**
 * Capitolo 02 — La domanda.
 *
 * Il capitolo-cerniera: trasforma il contesto in una domanda sola, e la domanda
 * nella mappa del resto del deck. I quattro punti SONO i quattro capitoli che
 * seguono, nello stesso ordine: chi ha visto questa slide sa già dove stiamo
 * andando, e può fermarci sul punto che gli interessa.
 *
 * La domanda e i quattro punti stanno in `src/data/contenuti.ts` perché vivono
 * anche nel taglio «In dieci minuti»: due copie a mano divergono, e la domanda
 * è l'ultima cosa che può permettersi di cambiare parola fra due versioni.
 */
const SLUG = 'domanda';
const ch = CHAPTERS.find((c) => c.slug === SLUG)!;
const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;
/* 9 nov 2026: «Dove ci innestiamo» disattivata su richiesta dell'owner. Per riaccenderla:
   `true` qui, e la voce in `slides.ts`. */
const MOSTRA_INNESTO = false;

---
<BaseLayout title={ch.title.it}>
  <div class="fixed top-0 left-0 right-0 z-50">
    <Navigation currentPath={currentPath} base={base} />
  </div>

  <DeckContainer wallScale nextHref={href(base, nextSlug(SLUG))} prevHref={href(base, prevSlug(SLUG))}>

    <!-- ── La domanda, grande e sola ─────────────────────────────────────── -->
    <Slide id="slide-domanda" bg="brand" align="center">
      <div class="tp-quote" data-reveal>
        <p class="xd-n" data-reveal><span class="tp-gancio-a">{DOMANDA.eyebrow.split(', e ')[0]},</span> <span class="tp-gancio-b">e {DOMANDA.eyebrow.split(', e ')[1]}</span></p>
        <h2 class="tp-domanda" data-display data-reveal data-reveal-delay="0.06" set:html={DOMANDA.titolo} />
        <p class="tp-domanda-sub" data-reveal data-reveal-delay="0.18">{DOMANDA.sub}</p>
        <p class="xd-fonte" data-reveal data-reveal-delay="0.32">
          {DOMANDA.fonte.prezzo} <a href={SOURCES.pricing.url} target="_blank" rel="noopener noreferrer">{SOURCES.pricing.label}</a>.
        </p>
      </div>
    </Slide>

    <!-- ── Dove ci innestiamo ─────────────────────────────────────────────
         6 nov 2026, panel: è la slide che mancava di più. La mappa che segue
         elenca «già vostro / si aggiunge», e senza questa prima dice a un
         direttore che ha appena firmato una scelta di piattaforma che il
         campo è libero. Qui si nomina quella scelta, citando il LORO
         comunicato, si dice che non la tocchiamo, e la cucitura resta una
         domanda. Non si giudica e non si propone di sostituirla.
         ⚠️ Per toglierla basta cancellare questa slide: la voce vive in
         `INNESTO` e non è usata altrove. -->
    {MOSTRA_INNESTO && (
    <Slide id="slide-innesto" bg="primary" align="left">
      <div slot="backdrop" class="xd-bg-piano"></div>
      <div class="xd-sl" data-reveal>
        <div class="xd-sl-head">
          <p class="xd-n">{INNESTO.eyebrow}</p>
          <h2 class="xd-h2">{INNESTO.titolo}</h2>
          <p class="xd-sub">{INNESTO.lead}</p>
        </div>
        <div class="tp-ancore" data-stagger data-reveal data-reveal-delay="0.14">
          {INNESTO.voci.map((v) => (
            <div class="tp-anc">
              <p class="tp-anc-k">{v.k}</p>
              <p class="tp-anc-n">{v.t}</p>
              <p class="tp-anc-b">{v.b}</p>
            </div>
          ))}
        </div>
        <p class="xd-chiusa" data-reveal data-reveal-delay="0.24">{INNESTO.chiusa}</p>
        <p class="xd-fonte" data-reveal data-reveal-delay="0.3">
          Fonte: <a href={SOURCES.foundation.url} target="_blank" rel="noopener noreferrer">{SOURCES.foundation.label}</a>.
        </p>
      </div>
    </Slide>
    )}

    <!-- ── I quattro punti = i quattro capitoli che seguono ───────────────── -->
    <Slide id="slide-mappa" data-stretto bg="primary" align="left">
      <div slot="backdrop" class="xd-bg-piano"></div>
      <div class="xd-sl" data-reveal>
        <div class="xd-sl-head">
          <p class="xd-n">{TESTE.mappa.eyebrow}</p>
          <h2 class="xd-h2">{TESTE.mappa.titolo}</h2>
          <p class="xd-sub">{TESTE.mappa.lead}</p>
        </div>
        {/* 9 nov 2026: la tabella idee-prodotti si proietta, non sta più dietro un
            «Scopri come». Il cliente: «dite pure che avete una serie di prodotti».
            A drill-down aperto cede il posto: mai rimpicciolire. */}
        <div class="tp-cede" data-reveal data-reveal-delay="0.12"><MappaIdee soloPezzi /></div>

      </div>
    </Slide>



  </DeckContainer>
  <script is:inline data-astro-rerun>
    try {
      var g = (sessionStorage.getItem('tp-gancio') || '').split(' ');
      if (g.length === 4) ['t', 'r', 'b', 'l'].forEach(function (k, i) { document.documentElement.style.setProperty('--tp-g-' + k, g[i]); });
    } catch (e) {}
  </script>
</BaseLayout>
