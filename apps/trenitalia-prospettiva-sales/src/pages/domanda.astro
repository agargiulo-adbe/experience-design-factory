---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import { href } from '@edf/core/utils/url.js';
import { CHAPTERS, prevSlug, nextSlug } from '../data/chapters';
import { DOMANDA, PUNTI, TESTE } from '../data/contenuti';
import bg_chapter from '../assets/generated/bg/bg-chapter.webp';
import bg_journey from '../assets/generated/bg/bg-journey.webp';

/**
 * Capitolo 02 — La domanda.
 *
 * Il capitolo-cerniera: trasforma il contesto in una domanda sola, e la domanda
 * nella mappa del resto del deck. I quattro punti SONO i quattro capitoli che
 * seguono, nello stesso ordine: chi ha visto questa slide sa già dove stiamo
 * andando, e può fermarci sul punto che gli interessa.
 *
 * La domanda e i quattro punti stanno in `src/data/contenuti.ts` perché vivono
 * anche nel taglio «In dieci minuti»: due copie a mano divergono, e la domanda
 * è l'ultima cosa che può permettersi di cambiare parola fra due versioni.
 */
const SLUG = 'domanda';
const ch = CHAPTERS.find((c) => c.slug === SLUG)!;
const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;

---
<BaseLayout title={ch.title.it}>
  <div class="fixed top-0 left-0 right-0 z-50">
    <Navigation currentPath={currentPath} base={base} />
  </div>

  <DeckContainer wallScale nextHref={href(base, nextSlug(SLUG))} prevHref={href(base, prevSlug(SLUG))}>

    <!-- ── Cover del capitolo ────────────────────────────────────────────── -->
    <Slide id="slide-cover" bg="primary" align="center" data-made-with="Adobe Firefly" data-made-with-for="sfondo">
      <div slot="backdrop" class="ex-bg-night" style={`--bg-src: url(${bg_chapter.src})`} data-parallax></div>
      <div class="ex-ch" data-reveal>
        <p class="ex-ch-num">Capitolo {ch.num}</p>
        <h2 class="ex-ch-title" data-reveal data-reveal-delay="0.08">{ch.title.it}</h2>
        <p class="ex-ch-lead" data-reveal data-reveal-delay="0.15">
          Una sola. Tutto il resto del documento prova a risponderle.
        </p>
      </div>
    </Slide>

    <!-- ── La domanda, grande e sola ─────────────────────────────────────── -->
    <Slide id="slide-domanda" bg="brand" align="center">
      <div class="tp-quote" data-reveal>
        <h2 class="tp-domanda" data-display data-reveal data-reveal-delay="0.06" set:html={DOMANDA.titolo} />
        <p class="tp-domanda-sub" data-reveal data-reveal-delay="0.18">{DOMANDA.sub}</p>
        <p class="tp-domanda-peri" data-reveal data-reveal-delay="0.26">{DOMANDA.perimetri}</p>
      </div>
    </Slide>

    <!-- ── I quattro punti = i quattro capitoli che seguono ───────────────── -->
    <Slide id="slide-mappa" bg="primary" align="left" data-made-with="Adobe Firefly" data-made-with-for="sfondo">
      <div slot="backdrop" class="ex-bg-night" style={`--bg-src: url(${bg_journey.src})`} data-parallax></div>
      <div class="ex-content" data-reveal>
        <div class="ex-head">
          <p class="slide-eyebrow">La mappa</p>
          <h2 class="ex-head-title">Quattro punti, in ordine di percorso</h2>
          <p class="ex-head-lead">
            Sono anche i quattro capitoli che seguono. Se uno solo vi interessa, si va diretti lì:
            il resto si legge dopo, o non si legge.
          </p>
        </div>
        <ul class="tp-mappa" role="list" data-stagger="0.12" data-reveal data-reveal-delay="0.12">
          {PUNTI.map((p) => (
            <li class="tp-mappa-row">
              <span class="tp-mappa-n" aria-hidden="true">{p.n}</span>
              <span class="tp-mappa-body">
                <span class="tp-mappa-dove">{p.dove}</span>
                <span class="tp-mappa-t">{p.t}</span>
                <span class="tp-mappa-b">{p.b}</span>
              </span>
            </li>
          ))}
        </ul>
      </div>
    </Slide>

  </DeckContainer>
</BaseLayout>
