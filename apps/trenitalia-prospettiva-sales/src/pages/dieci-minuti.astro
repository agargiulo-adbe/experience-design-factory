---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import CoBrand from '../components/CoBrand.astro';
import LoopVideo from '@edf/core/blocks/immersive/LoopVideo.astro';
import { href } from '@edf/core/utils/url.js';
import { EXPERIENCE_TYPES } from '@edf/core/data/experienceTypes';
import { SITE, media } from '../data/site';
import MappaIdee from '../components/MappaIdee.astro';
import { CHAPTERS } from '../data/chapters';
import { COVER, CRONOLOGIA, DOMANDA, INNESTO, PROBLEMI, PUNTI, ASK, TEMPI, TESTE, fontiDi } from '../data/contenuti';
import Cronologia from '../components/Cronologia.astro';
import ProblemiAncore from '../components/ProblemiAncore.astro';
import Tempi from '../components/Tempi.astro';
import { SOURCES } from '../data/sources';
import bg_close from '../assets/generated/bg/bg-close.webp';

/**
 * «In dieci minuti» — il taglio corto.
 *
 * NON è il percorso intero accorciato, e non è un documento suo: è la STESSA
 * FONTE, più corta. Ogni blocco arriva da `src/data/contenuti.ts` e ogni link da
 * `src/data/sources.ts`: se i due percorsi divergono, non è una possibilità ma
 * una certezza, e diverge sempre il corto, perché le correzioni arrivano sul
 * lungo. Qui non c'è una stringa di contenuto scritta a mano, e il gate lo
 * verifica: `DECK_URL=… pnpm audit:taglio --app trenitalia-prospettiva-sales`.
 *
 * PERCHÉ ESISTE. Un'ora concessa diventa venti minuti più spesso di quanto si
 * ammetta, e in quel momento chi presenta salta slide a caso: il percorso che
 * resta non è quello costruito, è quello sopravvissuto. Questo taglio è la
 * scelta fatta prima. Ed è anche la versione che l'interlocutore gira al suo
 * capo — un Direttore Generale che arriva da un operatore sfidante e che leggerà
 * senza nessuno a spiegare.
 *
 * CHE COSA RESTA FUORI: il metodo della misura (resta il risultato), le quattro
 * domande aperte (vivono in sala, a voce), i capitoli di dettaglio. Quello che
 * NON si taglia mai: l'apertura con le sue parole e il passo che chiediamo.
 *
 * Un taglio corto è una versione breve, non una versione spenta: stesse clip in
 * loop di copertina e chiusura, stessa firma co-brand, stesso guscio.
 */
const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;
/* 9 nov 2026: «Quello che vi chiediamo» disattivata su richiesta dell'owner. Per
   riaccenderla: `true` qui, e la voce in `slides.ts`. */
const MOSTRA_PASSO = false;
const type = EXPERIENCE_TYPES[SITE.type];
const first = CHAPTERS[0];
const fontiProblemi = [...new Map(PROBLEMI.flatMap((c) => fontiDi(c)).map((f) => [f.label, f])).values()];
const CLIP_COVER = media('trenitalia-prospettiva-cover.loop.mp4');
const CLIP_CHIUSURA = media('trenitalia-prospettiva-close.loop.mp4');
---
<BaseLayout title="In dieci minuti">
  <div class="fixed top-0 left-0 right-0 z-50">
    <Navigation currentPath={currentPath} base={base} />
  </div>

  <DeckContainer wallScale nextHref={href(base, '/')} prevHref={href(base, '/')}>

    <!-- ── 1 · Copertina ─────────────────────────────────────────────────── -->
    <Slide id="slide-cover" data-audio="loud" bg="primary" align="center" data-made-with="Adobe Firefly" data-made-with-for="clip">
      <LoopVideo
        slot="backdrop"
        src={CLIP_COVER}
        poster={`${base}media/cover-loop.poster.jpg`}
        scrim="absolute inset-0 bg-[rgba(27,34,48,0.72)]"
        opacity={0.85}
      />
      <div class="ex-cover" data-reveal>
        <CoBrand variant="hero" class="ex-cover-lockup" data-reveal />
        <h1 class="ex-cover-title" data-reveal data-reveal-delay="0.1">{SITE.name}</h1>
        <p class="ex-cover-tag" data-reveal data-reveal-delay="0.16">{COVER.tag}</p>
        <p class="ex-cover-lead" data-reveal data-reveal-delay="0.22">
          <span class="ex-frase">In dieci minuti: il&nbsp;vostro anno, la&nbsp;domanda, le&nbsp;quattro idee e&nbsp;una&nbsp;possibile sequenza.</span> <span class="ex-frase">Il percorso intero è nel menu, se il tempo c’è.</span>
        </p>
        <p class="ex-cover-note" data-reveal data-reveal-delay="0.3">
          {type.coverLine.it} · fonti dichiarate slide per slide
        </p>
      </div>
    </Slide>

    <!-- ── 2 · I problemi chiave: stessa fonte del percorso intero ───────── -->
    <Slide id="slide-problemi" bg="primary" align="left">
      <div slot="backdrop" class="xd-bg-piano"></div>
      <div class="xd-sl" data-reveal>
        <div class="xd-sl-head">
          <p class="xd-n">{CHAPTERS[0].title.it}</p>
          <h2 class="xd-h2">{TESTE.contesto.titolo}</h2>
        </div>
        <Cronologia tappe={CRONOLOGIA} />
        <ProblemiAncore />
        <p class="xd-fonte" data-reveal data-reveal-delay="0.24">
          Fonti: {fontiProblemi.map((f, i) => (
            <>{i > 0 ? ' · ' : ''}<a href={f.url} target="_blank" rel="noopener noreferrer">{f.label}</a></>
          ))}.
        </p>
      </div>
    </Slide>

    <!-- ── 4 · La domanda, e i quattro punti sotto ───────────────────────── -->
    <Slide id="slide-domanda" bg="brand" align="center">
      <div class="tp-quote" data-reveal>
        <p class="xd-n" data-reveal><span class="tp-gancio-a">{DOMANDA.eyebrow.split(', e ')[0]},</span> <span class="tp-gancio-b">e {DOMANDA.eyebrow.split(', e ')[1]}</span></p>
        <h2 class="tp-domanda" data-display data-reveal data-reveal-delay="0.06" set:html={DOMANDA.titolo} />
        <p class="tp-domanda-sub" data-reveal data-reveal-delay="0.18">{DOMANDA.subBreve}</p>
        <p class="xd-fonte" data-reveal data-reveal-delay="0.32">
          {DOMANDA.fonte.prezzo} <a href={SOURCES.pricing.url} target="_blank" rel="noopener noreferrer">{SOURCES.pricing.label}</a>.
        </p>
      </div>
    </Slide>

    <!-- ── 5 · I quattro punti, in forma breve ───────────────────────────── -->
    <Slide id="slide-mappa" bg="primary" align="left">
      <div slot="backdrop" class="xd-bg-piano"></div>
      <div class="xd-sl" data-reveal>
        <div class="xd-sl-head">
          <p class="xd-n">{TESTE.mappa.eyebrow}</p>
          <h2 class="xd-h2">{TESTE.mappa.titolo}</h2>
          <p class="xd-sub">{TESTE.mappa.leadBreve}</p>
        </div>
        <ul class="tp-mappa" role="list" data-stagger="0.1" data-reveal data-reveal-delay="0.12">
          {PUNTI.map((p) => (
            <li class="tp-mappa-row">
              <span class="tp-mappa-n" aria-hidden="true">{p.n}</span>
              <span class="tp-mappa-body">
                <span class="tp-mappa-dove">{p.dove}</span>
                <span class="tp-mappa-t">{p.t}</span>
                <span class="tp-mappa-b">{p.bBreve}</span>
              </span>
            </li>
          ))}
        </ul>
        {/* Di chi è il tavolo. Qui UNA riga per la lista e non una per punto:
            quattro righe in più spingevano il titolo fuori dalla safe-area a
            1280×800, ed è un HARD. Questa è la pagina che gira senza nessuno
            accanto, quindi il marcatore non può mancare del tutto. */}
        <p class="xd-fonte" data-reveal data-reveal-delay="0.2">
          Alcuni di questi punti si decidono anche altrove: lì portiamo domande. Sulle agenzie
          è tutto da approfondire insieme.
        </p>
      </div>
    </Slide>

    <!-- ── 5-bis · Con che cosa si fanno ────────────────────────────────
         ⚠️ IL TAGLIO NON È UNA VERSIONE SPENTA, e qui è anche più importante
         che nel lungo: questa è la versione che l'interlocutore gira al suo
         capo, e la domanda «e voi che cosa ci mettete» la fa chi non era in
         sala. Nel percorso intero questo strato sta dietro «Scopri come»,
         perché lì c'è chi lo apre a voce; qui si proietta.
         Misurato il 6 novembre: come drill-down su `slide-mappa` del taglio
         non entrava — quelle righe portano già il «che cosa succede», e il
         blocco aperto usciva dalla safe-area a tutti e tre i viewport
         (check `j` e `c` dentro `exp`, HARD). Stesso componente e stessa
         fonte del lungo: se i prodotti cambiano, cambiano in un posto solo. -->
    <Slide id="slide-contributi" data-stretto bg="primary" align="left">
      <div slot="backdrop" class="xd-bg-piano"></div>
      <div class="xd-sl xd-sl--fig" data-reveal>
        <div class="xd-sl-head">
          <p class="xd-n">E che cosa ci mettiamo noi</p>
          <h2 class="xd-h2">Quattro idee, e sotto ognuna qualcosa da saper fare</h2>
          {/* ⚠️ 6 nov 2026, SECONDO GIRO: cinque personas su sei. Questa è la
              pagina che gira di più e che viene letta senza nessuno accanto,
              e qui sotto c'è un elenco di tredici nomi di prodotto: senza la
              riga del confine si legge come una proposta di piattaforma sopra
              quella che il Gruppo ha annunciato a marzo. La riga è la STESSA
              di `domanda/slide-innesto`, dalla stessa fonte: nel percorso
              intero quel confine è una slide, qui è una riga — ma c'è. */}
          <p class="xd-sub">
            Sotto ogni punto c’è qualcosa da saper fare, e la tecnologia per farlo.
            <strong>{INNESTO.lead}</strong>
          </p>
        </div>
        <MappaIdee soloCapability />
      </div>
    </Slide>

    <!-- ── La macro timeline: stessa fonte del percorso intero ──────────── -->
    <Slide id="slide-tempi" bg="primary" align="left">
      <div slot="backdrop" class="xd-bg-piano"></div>
      <div class="xd-sl xd-sl--fig" data-reveal>
        <div class="xd-sl-head">
          <p class="xd-n">{TEMPI.eyebrow}</p>
          <h2 class="xd-h2">{TEMPI.titolo}</h2>
          <p class="xd-sub">{TEMPI.sub}</p>
        </div>
        <Tempi />
      </div>
    </Slide>

    <!-- ── 6 · Il passo, parola per parola come nel percorso intero ─────── -->
    {MOSTRA_PASSO && (
    <Slide id="slide-passo" bg="primary" align="left" data-made-with="Adobe Firefly" data-made-with-for="clip">
      <LoopVideo
        slot="backdrop"
        src={CLIP_CHIUSURA}
        poster={`${base}media/close-loop.poster.jpg`}
        scrim="absolute inset-0 bg-[rgba(27,34,48,0.78)]"
        opacity={0.8}
      />
      {/* Stessa fonte del percorso intero, stessa forma: l'ask è uno solo, e
          qui non si riscrive. Sul fondo resta la clip, che è il respiro con
          cui il taglio corto chiude. */}
      <div class="xd-sl" data-reveal>
        <div class="xd-sl-head">
          <p class="xd-n">{ASK.eyebrow}</p>
          <h2 class="xd-h2" set:html={ASK.titolo} />
          <p class="xd-sub">{ASK.sub}</p>
        </div>
        <div class="tp-ancore" data-stagger data-reveal data-reveal-delay="0.14">
          {ASK.punti.map((v) => (
            <div class="tp-anc">
              <p class="tp-anc-k">{v.k}</p>
              <p class="tp-anc-n">{v.t}</p>
              <p class="tp-anc-b">{v.b}</p>
            </div>
          ))}
        </div>
        <p class="xd-chiusa" data-reveal data-reveal-delay="0.26">{ASK.chiusa}</p>
      </div>
    </Slide>
    )}

    <!-- ── 7 · Slide-firma ───────────────────────────────────────────────── -->
    <Slide id="slide-signature" data-audio="loud" bg="primary" align="center" data-made-with="Adobe Firefly" data-made-with-for="sfondo">
      <div slot="backdrop" class="ex-bg-night" style={`--bg-src: url(${bg_close.src})`} data-parallax></div>
      <CoBrand variant="hero" data-reveal />
      <p class="ex-sig-line" data-reveal data-reveal-delay="0.1">
        {COVER.firma}
      </p>
      <a href={href(base, '/' + first.slug)} class="edf-sig-cta" data-reveal data-reveal-delay="0.18">Il percorso intero, sette fermate →</a>
    </Slide>

  </DeckContainer>
</BaseLayout>
