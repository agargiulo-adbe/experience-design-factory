---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import Divisore from '../components/Divisore.astro';
import SlideIdea from '../components/SlideIdea.astro';
import Fascia from '../components/Fascia.astro';
import { href } from '@edf/core/utils/url.js';
import bg_sole from '../assets/generated/sole/sole-viaggio.webp';
import { CHAPTERS, prevSlug, nextSlug } from '../data/chapters';
import { PRIMA, SERVE } from '../data/contenuti';
import { SOURCES } from '../data/sources';

/**
 * Capitolo 04 — La personalizzazione su larga scala (fino al 9 nov 2026: il viaggio).
 *
 * Il capitolo in cui si parla poco e si ascolta: è il suo mestiere, viene
 * dall'intermodale. Si apre con una DOMANDA sul laboratorio con ITA Airways,
 * perché la fonte ha mesi e perché se è già coperto è una buona notizia. La
 * compagnia aerea si NOMINA: il protocollo è pubblico e l'ha firmato il loro
 * Amministratore Delegato — chiamarla «la compagnia aerea» davanti a chi c'era
 * suona evasivo. Copia e fonti in `src/data/`.
 * Prudenza dichiarata sull'orchestrazione dei messaggi: confina con un perimetro
 * già assegnato e non si va oltre il nominarla.
 */
const SLUG = 'viaggio';
const ch = CHAPTERS.find((c) => c.slug === SLUG)!;
const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;
/* 10 nov 2026: la data collaboration si racconta dal pop-in, partendo dalla slide su Costa.
   La slide resta qui, spenta: si riaccende cambiando questa riga. */
const MOSTRA_COLLAB = false;

---
<BaseLayout title={ch.title.it}>
  <div class="fixed top-0 left-0 right-0 z-50">
    <Navigation currentPath={currentPath} base={base} />
  </div>

  <DeckContainer wallScale nextHref={href(base, nextSlug(SLUG))} prevHref={href(base, prevSlug(SLUG))}>

    <!-- ── Divisore di capitolo ─────────────────────────────────────────
         La forma XD: titolo grande, fotografia, pannello di colore. Sostituisce
         la vecchia cover a testo centrato — con l'agenda, il lead e il blocco
         del metodo impilati, era una slide di contenuto travestita da respiro.
         Titolo, punto e fotografia vengono da `chapters.ts`: una fonte sola.
         ⚠️ Il fondo sta QUI e non dentro `Divisore.astro`: Astro non propaga
         `slot="backdrop"` attraverso un componente. -->
    <Slide id="slide-cover" bg="primary" align="left" data-made-with="Adobe Firefly" data-made-with-for="sfondo">
      <div slot="backdrop" class="xd-div-bg" style={`--foto: url(${bg_sole.src})`}></div>
      <Divisore num={ch.num} titolo={ch.title.it} punto={ch.punto} tavolo={ch.tavolo} slug="viaggio" bussola />
    </Slide>

    <!-- ── L'idea, nel registro XD ───────────────────────────────────────
         Una slide, un'idea: il mockup grande, una cifra, la referenza.
         È quello che si proietta. Il meccanismo resta nelle slide che
         seguono e dietro «Scopri come» — due registri, non uno.
         Forma e contenuto stanno in `components/SlideIdea.astro` e
         `data/idee.ts`: una sola fonte per tutte e quattro. -->
    <SlideIdea slug="viaggio" />

    <!-- ── Prima chi non è registrato, poi chi lo è ────────────────────────
         9 nov 2026, allineamento con il cliente: la priorità è la profilazione,
         e l'intermodale regge solo se quello che si racconta si può comprare.
         Roma-Caserta e Matera restano come esempio, dentro le finestre.
         CartaFreccia è nominata su richiesta dell'owner: il sito ne dava la chiusura a fine 2026. -->
    <Slide id="slide-momenti" bg="primary" align="left">
      <div slot="backdrop" class="xd-bg-piano"></div>
      <div class="xd-sl" data-reveal>
        <div class="xd-sl-head">
          <p class="xd-n">Su larga scala, un passo alla volta</p>
          <h2 class="xd-h2">Prima chi non è registrato, poi chi&nbsp;lo&nbsp;è</h2>
          <p class="xd-sub">
            <strong>Si può partire subito con gli strumenti che avete.<br />Con il nuovo CRM la proposta diventa più precisa.</strong>
          </p>
        </div>
        {/* 10 nov 2026: la stessa homepage vista da tre persone, una figura sola in tre
            stati. Lo scheletro è uguale e grigio, cambia solo l'etichetta rossa: la
            differenza si vede senza leggere. Ogni ↓ fa entrare una finestra. */}
        <div class="tp-ancore tp-trittico">
          <div class="tp-mom">
            <div class="tp-fin" data-substep aria-hidden="true">
              <p class="tp-fin-b">trenitalia.com</p>
              <div class="tp-fin-s"><i></i><i></i><i></i></div>
              <div class="tp-fin-c"><span class="tp-fin-chip">Da Bari</span><p class="tp-fin-h">Le offerte da Bari</p></div>
            </div>
            <div class="tp-anc">
              <p class="tp-anc-k">Subito</p>
              <p class="tp-anc-n">Chi non è registrato</p>
              <p class="tp-anc-b">Posizione, pagine viste e&nbsp;cookie, dove c’è il&nbsp;consenso, per&nbsp;un&nbsp;primo segmento.</p>
            </div>
          </div>
          <div class="tp-mom">
            <div class="tp-fin" data-substep aria-hidden="true">
              <p class="tp-fin-b">trenitalia.com</p>
              <div class="tp-fin-s"><i></i><i></i><i></i></div>
              <div class="tp-fin-c"><span class="tp-fin-chip">CartaFreccia Oro</span><p class="tp-fin-h">Matera, la prossima meta</p></div>
            </div>
            <div class="tp-anc">
              <p class="tp-anc-k">Con il nuovo CRM</p>
              <p class="tp-anc-n">Chi è registrato</p>
              <p class="tp-anc-b">Storico, preferenze e livello CartaFreccia cambiano la&nbsp;proposta.</p>
            </div>
          </div>
          <div class="tp-mom">
            <div class="tp-fin" data-substep aria-hidden="true">
              <p class="tp-fin-b">trenitalia.com</p>
              <div class="tp-fin-s"><i></i><i></i><i></i></div>
              <div class="tp-fin-c"><span class="tp-fin-chip">Già comprato</span><p class="tp-fin-h"><s>Roma-Caserta</s> non si ripropone</p></div>
            </div>
            <div class="tp-anc">
              <p class="tp-anc-k">Sempre</p>
              <p class="tp-anc-n">Una proposta che&nbsp;sa quando fermarsi</p>
              <p class="tp-anc-b">Chi ha già fatto un&nbsp;viaggio non lo&nbsp;rivede a&nbsp;ogni&nbsp;visita.</p>
            </div>
          </div>
        </div>
        <Fascia pezzi={SERVE.acquisto} />
      </div>
    </Slide>

    <!-- ── Chi incontra il viaggiatore prima di voi ───────────────────────── -->
    <Slide id="slide-prima" data-stretto bg="primary" align="left">
      <div slot="backdrop" class="xd-bg-piano"></div>
      <div class="xd-sl" data-reveal>
        <div class="xd-sl-head">
          <p class="xd-n">Prima ancora della scelta del treno</p>
          <h2 class="xd-h2">La personalizzazione comincia prima, e altrove</h2>
          <p class="xd-sub">
            Chi programma dieci giorni in Italia di solito sceglie volo o pacchetto mesi prima
            del treno. <strong>E su quei viaggiatori si può lavorare in due senza scambiarsi i
            dati.</strong>
          </p>
        </div>
        {/* 10 nov 2026: come sulla slide precedente, un ↓ per punto e la sua finestra. */}
        <div class="tp-ancore tp-trittico">
          {PRIMA.map((x, n) => (
            <div class="tp-mom">
              <div class="tp-fin" data-substep aria-hidden="true">
                <p class="tp-fin-b">{n === 0 ? 'Il protocollo con Costa' : 'Una proposta · esempio'}</p>
                <div class="tp-fin-s"><i></i><i></i><i></i></div>
                <div class="tp-fin-c">
                  <span class="tp-fin-chip">{n === 0 ? 'Da gennaio 2027' : 'Crociera da Genova'}</span>
                  <p class="tp-fin-h">{n === 0 ? 'I due sistemi di prenotazione collegati' : 'Il treno fino al porto'}</p>
                </div>
              </div>
              <div class="tp-anc">
                <p class="tp-anc-k">{x.k}</p>
                <p class="tp-anc-n">{x.t}</p>
                <p class="tp-anc-b">{x.bBreve ?? x.b}</p>
              </div>
            </div>
          ))}
        </div>
        {/* 17 ott: nel deck non va nessuna referenza di un altro cliente
            (decisione d'account). Il precedente ferroviario o crocieristico non
            esiste — verificato — e un caso preso da un altro settore apre la
            domanda «e nel nostro?» invece di chiuderla: si dice che è un'ipotesi
            e si chiude lì. */}
        <Fascia pezzi={SERVE.collaborazione} />
        <p class="xd-fonte" data-reveal data-reveal-delay="0.26">
          Il protocollo con Costa: <a href={SOURCES.costaTtg.url} target="_blank" rel="noopener noreferrer">{SOURCES.costaTtg.label}</a>.
        </p>
      </div>
    </Slide>


    <!-- ── Dove si innesta la collaborazione sui dati ─────────────────────
         20 ott: «non è chiaro dove si innesta la data collaboration» — detto in
         riunione, e aveva ragione: lo strumento stava in una riga di fonte, in
         fondo, dopo i link. Qui ha una slide sua, che risponde alle due domande
         che uno si fa: dove si innesta nel PERCORSO e dove nei SISTEMI. Sta a
         parte e non in fondo alla precedente perché lì, col blocco aperto, la
         slide usciva dalla safe-area a tutti e tre i viewport: il contratto dice
         di dividere, non di rimpicciolire. -->
    {MOSTRA_COLLAB && (
    <Slide id="slide-collab" bg="primary" align="left">
      <div slot="backdrop" class="xd-bg-piano"></div>
      <div class="xd-sl" data-reveal>
        <div class="xd-sl-head">
          <p class="xd-n">Lavorare in due sugli stessi viaggiatori</p>
          {/* ⚠️ 6 nov 2026, panel, cinque personas su sei. Due difetti
              sovrapposti. (1) Il titolo diceva «ciascuno tiene i suoi dati
              dove sono», e la documentazione del prodotto parla di un
              ambiente centralizzato e attento alla riservatezza: una cosa
              diversa, descritta meglio di com'è. (2) Dicendo «nessuno
              consegna il proprio elenco» la slide affermava che il problema
              di governo del dato non esiste — «è una frase che in questa
              azienda apre un fascicolo, non un progetto». Ora il meccanismo
              dice quello che il prodotto dichiara, e la domanda di titolarità
              sta in pagina, non dietro il drill-down. */}
          <h2 class="xd-h2">Si incrociano solo i&nbsp;clienti che&nbsp;interessano a&nbsp;entrambi i&nbsp;partner</h2>
          <p class="xd-sub">Si parte dall’accordo con&nbsp;Costa Crociere, per&nbsp;raggiungere i viaggiatori prima che&nbsp;scelgano il&nbsp;treno.</p>
        </div>
        <div class="tp-inc" data-reveal data-reveal-delay="0.12">
          <div class="tp-inc-fig">
            <svg viewBox="100 10 440 280" aria-hidden="true">
              <circle cx="250" cy="150" r="138" /><circle cx="390" cy="150" r="138" />
              <path d="M320 30.5 A138 138 0 0 1 320 269.5 A138 138 0 0 1 320 30.5 Z" />
            </svg>
            <p style="left:17%">I vostri clienti</p>
            <p style="left:50%" data-on>Solo i clienti in&nbsp;comune</p>
            <p style="left:83%">I clienti di&nbsp;Costa</p>
          </div>
          <div class="tp-inc-v">
            <div class="tp-anc"><p class="tp-anc-k">Il luogo</p><p class="tp-anc-n">Un ambiente neutro di collaborazione</p><p class="tp-anc-b">Gli elenchi si incrociano lì, con i suoi controlli di accesso. Nell’acquisto non entra nessun sistema nuovo.</p></div>
            <div class="tp-anc"><p class="tp-anc-k">I dati</p><p class="tp-anc-n">Nel confronto nessuna delle due vede i dati dell’altra</p><p class="tp-anc-b">L’attivazione ha regole sue. Titolarità, base giuridica, contratto e&nbsp;valutazione d’impatto si definiscono prima di qualunque prova.</p></div>
          </div>
        </div>
        <Fascia pezzi={SERVE.collaborazione} />
      </div>
    </Slide>
    )}

  </DeckContainer>
</BaseLayout>
