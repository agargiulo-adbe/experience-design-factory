---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import HowItWorks from '@edf/core/blocks/HowItWorks.astro';
import { href } from '@edf/core/utils/url.js';
import { CHAPTERS, prevSlug, nextSlug } from '../data/chapters';
import { GIA, PRIMA, fontiDi } from '../data/contenuti';
import { SOURCES } from '../data/sources';
import bg_chapter from '../assets/generated/bg/bg-chapter.webp';
import bg_journey from '../assets/generated/bg/bg-journey.webp';
import bg_paper_grid from '../assets/generated/bg/bg-paper-grid.webp';
import bg_paper_lines from '../assets/generated/bg/bg-paper-lines.webp';

/**
 * Capitolo 04 — Un viaggio, non più prodotti.
 *
 * Il capitolo in cui si parla poco e si ascolta: è il suo mestiere, viene
 * dall'intermodale. Si apre con una DOMANDA sul laboratorio con ITA Airways,
 * perché la fonte ha mesi e perché se è già coperto è una buona notizia. La
 * compagnia aerea si NOMINA: il protocollo è pubblico e l'ha firmato il loro
 * Amministratore Delegato — chiamarla «la compagnia aerea» davanti a chi c'era
 * suona evasivo. Copia e fonti in `src/data/`.
 * Prudenza dichiarata sull'orchestrazione dei messaggi: confina con un perimetro
 * già assegnato e non si va oltre il nominarla.
 */
const SLUG = 'viaggio';
const ch = CHAPTERS.find((c) => c.slug === SLUG)!;
const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;

// Una fonte per fatto, dedotta dalle carte: la pagina non scrive indirizzi.
const fontiGia = [...new Map(GIA.flatMap((c) => fontiDi(c)).map((f) => [f.label, f])).values()];

---
<BaseLayout title={ch.title.it}>
  <div class="fixed top-0 left-0 right-0 z-50">
    <Navigation currentPath={currentPath} base={base} />
  </div>

  <DeckContainer wallScale nextHref={href(base, nextSlug(SLUG))} prevHref={href(base, prevSlug(SLUG))}>

    <!-- ── Cover del capitolo ────────────────────────────────────────────── -->
    <Slide id="slide-cover" bg="primary" align="center" data-made-with="Adobe Firefly" data-made-with-for="sfondo">
      <div slot="backdrop" class="ex-bg-night" style={`--bg-src: url(${bg_chapter.src})`} data-parallax></div>
      <div class="ex-ch" data-reveal>
        <p class="ex-ch-num">Capitolo {ch.num}</p>
        <h2 class="ex-ch-title" data-reveal data-reveal-delay="0.08">{ch.title.it}</h2>
        <p class="ex-ch-lead" data-reveal data-reveal-delay="0.15">
          Qui abbiamo più domande che risposte: l’intermodale è il vostro mestiere,
          non il nostro.
        </p>
        <div class="ex-ch-agenda" data-reveal data-reveal-delay="0.22">
          <p class="ex-ch-agenda-k">In questo capitolo</p>
          <ul role="list">
            <li><span class="ex-ch-agenda-n" aria-hidden="true">1</span><span>Quello che è già partito</span></li>
            <li><span class="ex-ch-agenda-n" aria-hidden="true">2</span><span>Dove il viaggio torna un biglietto</span></li>
            <li><span class="ex-ch-agenda-n" aria-hidden="true">3</span><span>Chi incontra il viaggiatore prima di voi</span></li>
          </ul>
        </div>
      </div>
    </Slide>

    <!-- ── Quello che è già partito ──────────────────────────────────────── -->
    <Slide id="slide-gia" bg="primary" align="left" data-made-with="Adobe Firefly" data-made-with-for="sfondo">
      <div slot="backdrop" class="ex-bg-night" style={`--bg-src: url(${bg_journey.src})`} data-parallax></div>
      <div class="ex-content" data-reveal>
        <div class="ex-head">
          <p class="slide-eyebrow">Il punto di partenza è vostro</p>
          <h2 class="ex-head-title">L’intermodale è già nel vostro perimetro</h2>
          <p class="ex-head-lead">
            Treno, gomma, sosta e aria sono già nel perimetro. Quello che manca non è un pezzo
            di offerta: è il momento dell’acquisto visto come un viaggio solo.
          </p>
        </div>
        <div class="ex-cards" data-reveal data-reveal-delay="0.14">
          {GIA.map((x) => (
            <div class="ex-card">
              <p class="ex-card-k">{x.k}</p>
              <p class="ex-card-t">{x.t}</p>
              <p class="ex-card-b">{x.b}</p>
            </div>
          ))}
        </div>
        <p class="ex-src" data-reveal data-reveal-delay="0.24">
          Fonti: {fontiGia.map((f, i) => (
            <>{i > 0 ? ' · ' : ''}<a href={f.url} target="_blank" rel="noopener noreferrer">{f.label}</a></>
          ))}.
        </p>
      </div>
    </Slide>

    <!-- ── Il caso Roma-Matera: la prova che viene dalla misura ──────────── -->
    <Slide id="slide-matera" bg="inverse" align="center" data-made-with="Adobe Firefly" data-made-with-for="sfondo">
      <div slot="backdrop" class="ex-bg-paper" style={`--bg-src: url(${bg_paper_lines.src})`} data-parallax></div>
      <div class="tp-quote" data-reveal>
        <p class="slide-eyebrow">«Come arrivo da Roma a Matera senza auto», chiesto a due assistenti</p>
        <p class="tp-quote-big" data-display data-reveal data-reveal-delay="0.08">
          Tutti e due aprono con gli <strong>operatori di autobus</strong>. E il biglietto
          combinato treno più autobus, tutti e due lo attribuiscono prima al
          <strong>concorrente</strong>.
        </p>
        <p class="tp-quote-after" data-reveal data-reveal-delay="0.18">
          <strong>Busitalia non è nominata da nessuno dei due.</strong> È la tratta che senza
          intermodalità non esiste, ed è la domanda in cui partite avvantaggiati: la gomma è
          vostra, le destinazioni sono vostre. La risposta, no.
        </p>
        <p class="ex-src" data-reveal data-reveal-delay="0.26">
          Fra le otto domande del capitolo precedente: {SOURCES.misura.label}, non una fonte pubblica.
        </p>
      </div>
    </Slide>

    <!-- ── Che cosa cambia nell'acquisto ─────────────────────────────────── -->
    <Slide id="slide-acquisto" bg="primary" align="left" data-made-with="Adobe Firefly" data-made-with-for="sfondo">
      <div slot="backdrop" class="ex-bg-night" style={`--bg-src: url(${bg_journey.src})`} data-parallax></div>
      <div class="ex-content" data-reveal>
        <div class="ex-head">
          <p class="slide-eyebrow">Dentro l’offerta</p>
          <h2 class="ex-head-title">Riconoscere chi sta componendo un viaggio</h2>
          <p class="ex-head-lead">
            Una persona che cerca un treno per Bari a luglio, con due bagagli e un ritorno aperto,
            sta costruendo una vacanza. La pianificazione porta-a-porta esiste già, su alcune destinazioni. Nel momento
            dell’acquisto, però, quella persona è indistinguibile da chi va a Bari per lavoro il
            martedì mattina. <strong>Distinguerli
            cambia che cosa si propone</strong>, e cambia il valore di quel viaggio.
          </p>
        </div>
        <div class="tp-ask" data-reveal data-reveal-delay="0.16">
          <p class="tp-ask-k">La domanda che vi facciamo</p>
          <p class="tp-ask-t">
            Il laboratorio con ITA Airways quanto di questo copre già? Se copre anche
            l’acquisto, è una buona notizia e passiamo oltre. Se riguarda i flussi, lo spazio è nel momento in cui si compra.
          </p>
        </div>
        <HowItWorks title="Che cosa serve, concretamente" label="Che cosa serve, concretamente" tone="onLight" data-reveal data-reveal-delay="0.22">
          <p>
            Servono due cose. La prima: leggere il percorso di acquisto per intero, treno e gomma e sosta insieme: è il mestiere di
            <strong><a href={SOURCES.cja.url} target="_blank" rel="noopener noreferrer">Customer Journey Analytics</a></strong>,
            che gira su Adobe Experience Platform.
            La seconda: poter provare una proposta diversa su una parte del traffico e misurarne
            l’effetto con <strong><a href={SOURCES.target.url} target="_blank" rel="noopener noreferrer">Adobe Target</a></strong>,
            che avete già scelto.
          </p>
          <p>
            L’orchestrazione dei messaggi lungo il viaggio è il passo successivo, e qui lo
            nominiamo soltanto. Vendita diretta e assistenza stanno in un’altra direzione: non è
            questa la stanza per decidere al posto loro.
          </p>
          </HowItWorks>
      </div>
    </Slide>

    <!-- ── Chi incontra il viaggiatore prima di voi ───────────────────────── -->
    <Slide id="slide-prima" bg="inverse" align="left" data-made-with="Adobe Firefly" data-made-with-for="sfondo">
      <div slot="backdrop" class="ex-bg-paper" style={`--bg-src: url(${bg_paper_grid.src})`} data-parallax></div>
      <div class="ex-content" data-reveal>
        <div class="ex-head">
          <p class="slide-eyebrow">Prima ancora della scelta del treno</p>
          <h2 class="ex-head-title">Il viaggio si decide prima, e altrove</h2>
          <p class="ex-head-lead">
            Chi decide dieci giorni in Italia lo decide davanti a una compagnia aerea o a un
            operatore turistico, mesi prima di scegliere il treno. <strong>Si può lavorare sugli stessi viaggiatori senza che nessuna
            delle due aziende consegni all’altra i propri dati</strong>: ciascuno tiene i suoi,
            e si incrocia solo quello che serve a capire chi interessa a entrambi. Un accordo che
            collega due sistemi di prenotazione apre la porta; questo decide che cosa ci passa.
          </p>
        </div>
        <div class="ex-cards" data-reveal data-reveal-delay="0.14">
          {PRIMA.map((x) => (
            <div class="ex-card">
              <p class="ex-card-k">{x.k}</p>
              <p class="ex-card-t">{x.t}</p>
              <p class="ex-card-b">{x.b}</p>
            </div>
          ))}
        </div>
        {/* 17 ott: nel deck non va nessuna referenza di un altro cliente
            (decisione d'account). Il precedente ferroviario o crocieristico non
            esiste — verificato — e un caso preso da un altro settore apre la
            domanda «e nel nostro?» invece di chiuderla: si dice che è un'ipotesi
            e si chiude lì. */}
        <p class="ex-src" data-reveal data-reveal-delay="0.24">
          Il canale cinese: <a href={SOURCES.trenitaliaCinese.url} target="_blank" rel="noopener noreferrer">{SOURCES.trenitaliaCinese.label}</a> ·
          <a href={SOURCES.fsCina.url} target="_blank" rel="noopener noreferrer">{SOURCES.fsCina.label}</a>.
          Il protocollo con Costa: <a href={SOURCES.costaTtg.url} target="_blank" rel="noopener noreferrer">{SOURCES.costaTtg.label}</a>.
          Lo strumento è <strong><a href={SOURCES.rtcdpCollab.url} target="_blank" rel="noopener noreferrer">{SOURCES.rtcdpCollab.label}</a></strong>,
          oggi in disponibilità limitata, Europa compresa. Fra operatori di trasporto e crociere
          un caso pubblico non c’è ancora, e quindi questa resta un’ipotesi da provare insieme.
        </p>
      </div>
    </Slide>

  </DeckContainer>
</BaseLayout>
