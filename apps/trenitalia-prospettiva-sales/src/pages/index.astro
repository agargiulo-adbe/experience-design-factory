---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import CoBrand from '../components/CoBrand.astro';
import { href } from '@edf/core/utils/url.js';
import { EXPERIENCE_TYPES } from '@edf/core/data/experienceTypes';
import { SITE } from '../data/site';
import { CHAPTERS } from '../data/chapters';
import { COVER } from '../data/contenuti';
import LoopVideo from '@edf/core/blocks/immersive/LoopVideo.astro';

/**
 * Copertina e agenda, su una pagina sola.
 *
 * Prima erano due slide: la copertina con la clip, e «Il percorso» con sette
 * fermate su una linea. Due slide per dire una cosa, e la seconda arrivava
 * quando in sala si sta ancora sistemando. Ora l'agenda sta DENTRO la
 * copertina, nella colonna di destra, nella forma XD del motore — ed è
 * **generata da `CHAPTERS`**, così non può divergere da quello che si
 * proietta: si aggiunge un capitolo e l'agenda lo sa.
 *
 * ⚠️ L'agenda legge `title.it`, non una lista scritta a mano. Una seconda
 * copia dei titoli è il modo più rapido di presentare un'agenda che non
 * corrisponde alle slide.
 *
 * Il lockup co-brand `hero` sta sulla PRIMA e sull'ULTIMA slide del percorso:
 * regola del motore, e dove c'è un hero la firma fissa si spegne da sola.
 */
const type = EXPERIENCE_TYPES[SITE.type];
// Le clip NON stanno nel repo: `apps/*/public/media/*.mp4` è git-ignorato, quindi
// un file locale non arriverebbe mai al sito pubblicato. Vivono sulla Release
// `media` e si referenziano per URL assoluto, come fanno le altre experience.
// Il poster invece è un .jpg leggero e viaggia col repo: regge il primo paint e
// «Riduci movimento», dove la clip non parte.
const CLIP = 'https://github.com/agargiulo-adbe/experience-design-factory/releases/download/media/trenitalia-prospettiva-cover.loop.mp4';
const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;
const first = CHAPTERS[0];
const last = CHAPTERS[CHAPTERS.length - 1];
---
<BaseLayout title={SITE.name}>
  <div class="fixed top-0 left-0 right-0 z-50">
    <Navigation currentPath={currentPath} base={base} />
  </div>

  <DeckContainer wallScale nextHref={href(base, '/' + first.slug)} prevHref={href(base, '/' + last.slug)}>

    <!-- ── 0 · Copertina e agenda ───────────────────────────────────────── -->
    <Slide id="slide-cover" bg="primary" align="left" data-made-with="Adobe Firefly" data-made-with-for="clip">
      {/* ⚠️ IL VELO È STATO RICALIBRATO quando l'agenda è entrata in copertina:
          prima sotto la clip c'erano cinque righe centrate, ora ci sono anche
          sette voci cliccabili, e il check `h` misura ogni link come CTA.
          Il velo si calibra sulla misura, non sulla presenza del video. */}
      <LoopVideo
        slot="backdrop"
        src={CLIP}
        poster={`${import.meta.env.BASE_URL}media/cover-loop.poster.jpg`}
        scrim="absolute inset-0 bg-[rgba(27,34,48,0.80)]"
        opacity={0.8}
      />

      <div class="xd-cop" data-reveal>
        <div class="xd-cop-sx">
          <CoBrand variant="hero" class="xd-cop-lockup" data-reveal />
          <p class="xd-cop-occ" data-reveal data-reveal-delay="0.06">Incontro del 10 novembre 2026 · Roma</p>
          <h1 class="xd-cop-t" data-reveal data-reveal-delay="0.1">{SITE.name}</h1>
          <p class="xd-cop-l" data-reveal data-reveal-delay="0.16">{COVER.tag}</p>
          <p class="xd-cop-tipo" data-reveal data-reveal-delay="0.22">{type.coverLine.it}</p>
          <p class="xd-cop-cred" data-reveal data-reveal-delay="0.26">
            Le fonti sono dichiarate slide per slide. La misura sulla visibilità nelle risposte
            generate è nostra, fatta l’11 ottobre.
          </p>
        </div>

        <nav class="xd-cop-dx" data-reveal data-reveal-delay="0.2" aria-label="L’agenda della sessione">
          <p class="xd-cop-occ">L’ora, come la spendiamo</p>
          <ol class="xd-cop-indice" data-stagger>
            {CHAPTERS.map((c) => (
              <li>
                <a href={href(base, '/' + c.slug)} class="xd-cop-cap">
                  <span class="xd-cop-n">{c.num}</span>
                  <span class="xd-cop-tit">{c.title.it}</span>
                </a>
              </li>
            ))}
          </ol>
          <p class="xd-cop-dom">Trenta minuti di racconto, trenta di domande. Si può salire e scendere a ogni fermata.</p>
        </nav>
      </div>
    </Slide>

  </DeckContainer>
</BaseLayout>
