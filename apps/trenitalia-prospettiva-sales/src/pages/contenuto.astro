---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import Divisore from '../components/Divisore.astro';
import SlideIdea from '../components/SlideIdea.astro';
import Fascia from '../components/Fascia.astro';
import { href } from '@edf/core/utils/url.js';
import bg_sole from '../assets/generated/sole/sole-contenuto.webp';
import { CHAPTERS, prevSlug, nextSlug } from '../data/chapters';
import { MOLTIPLICATORI, UNPOSTO, SERVE } from '../data/contenuti';
import { SOURCES } from '../data/sources';

/**
 * Capitolo 05 — Il contenuto che l'offerta richiede.
 *
 * Terreno libero: non sfiora nessuna scelta già fatta dal cliente. Parte da una
 * conseguenza aritmetica della SUA riorganizzazione, non da un nostro prodotto.
 * I numeri sono i suoi, dichiarati al TTG dell'ottobre 2025, e stanno in
 * `src/data/contenuti.ts` con la loro fonte. Il «4 mercati esteri» che c'era
 * prima non ha nessuna fonte pubblica: un numero senza fonte, su una slide di
 * numeri, è il primo che qualcuno chiede.
 * È anche l'unico posto dove entra il collega digitale, e con una distinzione che
 * va detta per intero: lavora accanto alle persone dell'azienda, non parla ai loro
 * clienti. Quella distinzione è ciò che tiene la proposta fuori da perimetri altrui.
 */
const SLUG = 'contenuto';
const ch = CHAPTERS.find((c) => c.slug === SLUG)!;
const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;
/* 9 nov 2026: «Una squadra commerciale unica» disattivata su richiesta dell'owner. Per
   riaccenderla: `true` qui, e la voce in `slides.ts`. */
const MOSTRA_ARITMETICA = false;

---
<BaseLayout title={ch.title.it}>
  <div class="fixed top-0 left-0 right-0 z-50">
    <Navigation currentPath={currentPath} base={base} />
  </div>

  <DeckContainer wallScale nextHref={href(base, nextSlug(SLUG))} prevHref={href(base, prevSlug(SLUG))}>

    <!-- ── Divisore di capitolo ─────────────────────────────────────────
         La forma XD: titolo grande, fotografia, pannello di colore. Sostituisce
         la vecchia cover a testo centrato — con l'agenda, il lead e il blocco
         del metodo impilati, era una slide di contenuto travestita da respiro.
         Titolo, punto e fotografia vengono da `chapters.ts`: una fonte sola.
         ⚠️ Il fondo sta QUI e non dentro `Divisore.astro`: Astro non propaga
         `slot="backdrop"` attraverso un componente. -->
    <Slide id="slide-cover" bg="primary" align="left" data-made-with="Adobe Firefly" data-made-with-for="sfondo">
      <div slot="backdrop" class="xd-div-bg" style={`--foto: url(${bg_sole.src})`}></div>
      <Divisore num={ch.num} titolo={ch.title.it} punto={ch.punto} tavolo={ch.tavolo} slug="contenuto" bussola />
    </Slide>

    <!-- ── L'idea, nel registro XD ───────────────────────────────────────
         Una slide, un'idea: il mockup grande, una cifra, la referenza.
         È quello che si proietta. Il meccanismo resta nelle slide che
         seguono e dietro «Scopri come» — due registri, non uno.
         Forma e contenuto stanno in `components/SlideIdea.astro` e
         `data/idee.ts`: una sola fonte per tutte e quattro. -->
    <SlideIdea slug="contenuto" />

    <!-- ── L'aritmetica ──────────────────────────────────────────────────── -->
    {MOSTRA_ARITMETICA && (
    <Slide id="slide-aritmetica" data-stretto bg="primary" align="left">
      <div slot="backdrop" class="xd-bg-piano"></div>
      <div class="xd-sl" data-reveal>
        <div class="xd-sl-head">
          <p class="xd-n">A valle</p>
          <h2 class="xd-h2">Una squadra commerciale unica: chi vendeva un prodotto oggi ne vende tre, più i servizi</h2>
          {/* ⚠️ IL LEAD ERA CINQUE RIGHE, e il punto è uno solo. Il resto —
              perché le squadre sono state unite, e che i mercati crescono —
              è contesto: sta dietro «Scopri come», dove risponde a chi lo
              chiede invece di occupare la slide. */}
          <p class="xd-sub">
            Ogni prodotto, per ogni mercato, su ogni canale e in ogni formato. Le varianti si
            moltiplicano fra loro.
          </p>
        </div>
        <div class="tp-stats tp-stats--due" data-stagger="0.1" data-reveal data-reveal-delay="0.14">
          {MOLTIPLICATORI.map((m) => (
            <div class="tp-stat">
              <p class="tp-stat-v" data-display>{m.v}</p>
              <p class="tp-stat-l">{m.l}</p>
              <p class="tp-stat-s">{m.s}</p>
            </div>
          ))}
        </div>
        <p class="xd-chiusa" data-reveal data-reveal-delay="0.2">
          Con queste moltiplicazioni il lavoro manuale ha un limite: o si fanno meno versioni, o si cambia il modo di farle.
        </p>
        {/* ⚠️ QUI NON C'È UN «SCOPRI COME», ed è una scelta. Ne avevo messo
            uno con i due fatti di contorno — la squadra unica, la Cina — ma
            il primo è già nel titolo della slide e il secondo è nella slide
            dell'idea e nella riga di fonte. Aperto costava 253 px e faceva
            sforare la safe-area a 1280×800 (check `exp`, HARD): un blocco
            che ripete quello che la slide dice già non vale quel prezzo. */}
        <p class="xd-fonte" data-reveal data-reveal-delay="0.28">
          Numeri vostri: <a href={SOURCES.ttg96.url} target="_blank" rel="noopener noreferrer">{SOURCES.ttg96.label}</a> ·
          <a href={SOURCES.ttgSales2026.url} target="_blank" rel="noopener noreferrer">{SOURCES.ttgSales2026.label}</a>.
        </p>
      </div>
    </Slide>
    )}

    <!-- ── Un posto solo ─────────────────────────────────────────────────── -->
    <Slide id="slide-unposto" data-stretto bg="primary" align="left">
      <div slot="backdrop" class="xd-bg-piano"></div>
      <div class="xd-sl" data-reveal>
        <div class="xd-sl-head">
          <p class="xd-n">Come produrre tutte le versioni di una campagna</p>
          <h2 class="xd-h2">Ogni campagna si crea, si approva, si adatta e si misura nello stesso strumento</h2>
          <p class="xd-sub">
            Team interni e agenzie creative lavorano sullo stesso strumento, e ogni contenuto porta con sé i suoi risultati. Le approvazioni restano a voi.
          </p>
        </div>
        <div class="tp-ancore" data-stagger>
          {UNPOSTO.map((x) => (
            <div class="tp-anc">
              <p class="tp-anc-k">{x.k}</p>
              <p class="tp-anc-n">{x.t}</p>
            </div>
          ))}
        </div>
        <Fascia pezzi={SERVE.contenuto} />
      </div>
    </Slide>

  </DeckContainer>
</BaseLayout>
