---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import HowItWorks from '@edf/core/blocks/HowItWorks.astro';
import CheServe from '../components/CheServe.astro';
import { href } from '@edf/core/utils/url.js';
import { CHAPTERS, prevSlug, nextSlug } from '../data/chapters';
import { MOLTIPLICATORI, UNPOSTO, SERVE } from '../data/contenuti';
import { SOURCES } from '../data/sources';
import bg_chapter from '../assets/generated/bg/bg-chapter.webp';
import bg_network from '../assets/generated/bg/bg-network.webp';
import bg_paper_grid from '../assets/generated/bg/bg-paper-grid.webp';

/**
 * Capitolo 05 — Il contenuto che l'offerta richiede.
 *
 * Terreno libero: non sfiora nessuna scelta già fatta dal cliente. Parte da una
 * conseguenza aritmetica della SUA riorganizzazione, non da un nostro prodotto.
 * I numeri sono i suoi, dichiarati al TTG dell'ottobre 2025, e stanno in
 * `src/data/contenuti.ts` con la loro fonte. Il «4 mercati esteri» che c'era
 * prima non ha nessuna fonte pubblica: un numero senza fonte, su una slide di
 * numeri, è il primo che qualcuno chiede.
 * È anche l'unico posto dove entra il collega digitale, e con una distinzione che
 * va detta per intero: lavora accanto alle persone dell'azienda, non parla ai loro
 * clienti. Quella distinzione è ciò che tiene la proposta fuori da perimetri altrui.
 */
const SLUG = 'contenuto';
const ch = CHAPTERS.find((c) => c.slug === SLUG)!;
const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;

---
<BaseLayout title={ch.title.it}>
  <div class="fixed top-0 left-0 right-0 z-50">
    <Navigation currentPath={currentPath} base={base} />
  </div>

  <DeckContainer wallScale nextHref={href(base, nextSlug(SLUG))} prevHref={href(base, prevSlug(SLUG))}>

    <!-- ── Cover del capitolo ────────────────────────────────────────────── -->
    <Slide id="slide-cover" bg="primary" align="center" data-made-with="Adobe Firefly" data-made-with-for="sfondo">
      <div slot="backdrop" class="ex-bg-night" style={`--bg-src: url(${bg_chapter.src})`} data-parallax></div>
      <div class="ex-ch" data-reveal>
        <p class="ex-ch-num">Capitolo {ch.num}</p>
        <h2 class="ex-ch-title" data-reveal data-reveal-delay="0.08">{ch.title.it}</h2>
        <p class="ex-ch-lead" data-reveal data-reveal-delay="0.15">
          Un problema nato con la squadra commerciale unica, e che non si risolve aggiungendo
          persone. La domanda che vi facciamo: è già coperto da uno dei cantieri aperti?
        </p>
        <div class="ex-ch-agenda" data-reveal data-reveal-delay="0.22">
          <p class="ex-ch-agenda-k">In questo capitolo</p>
          <ul role="list">
            <li><span class="ex-ch-agenda-n" aria-hidden="true">1</span><span>L’aritmetica della squadra unica</span></li>
            <li><span class="ex-ch-agenda-n" aria-hidden="true">2</span><span>Un posto solo, dalle agenzie ai mercati</span></li>
          </ul>
        </div>
      </div>
    </Slide>

    <!-- ── L'aritmetica ──────────────────────────────────────────────────── -->
    <Slide id="slide-aritmetica" bg="primary" align="left" data-made-with="Adobe Firefly" data-made-with-for="sfondo">
      <div slot="backdrop" class="ex-bg-night" style={`--bg-src: url(${bg_network.src})`} data-parallax></div>
      <div class="ex-content" data-reveal>
        <div class="ex-head">
          <p class="slide-eyebrow">A valle</p>
          <h2 class="ex-head-title">Un venditore che conosceva un prodotto oggi ne vende tre, più i servizi</h2>
          <p class="ex-head-lead">
            Unire le tre squadre commerciali è stata una scelta di mercato, non di
            comunicazione. Ma ha una conseguenza aritmetica: ogni prodotto, per ogni mercato,
            in ogni lingua, su ogni canale e per ogni intermediario vuole il suo materiale.
            <strong>Il numero di varianti cresce moltiplicando, non sommando.</strong>
            E i mercati crescono: in Cina le vendite sono raddoppiate nel 2025.
          </p>
        </div>
        <div class="tp-stats" data-stagger="0.1" data-reveal data-reveal-delay="0.14">
          {MOLTIPLICATORI.map((m) => (
            <div class="tp-stat">
              <p class="tp-stat-v" data-display>{m.v}</p>
              <p class="tp-stat-l">{m.l}</p>
              <p class="tp-stat-s">{m.s}</p>
            </div>
          ))}
        </div>
        <p class="ex-src" data-reveal data-reveal-delay="0.26">
          Numeri vostri: <a href={SOURCES.ttg96.url} target="_blank" rel="noopener noreferrer">{SOURCES.ttg96.label}</a> ·
          <a href={SOURCES.retePunti.url} target="_blank" rel="noopener noreferrer">{SOURCES.retePunti.label}</a>.
          Nessuna struttura creativa produce a mano quel numero di versioni: si fa una scelta,
          produrne meno o produrle in un altro modo.
        </p>
      </div>
    </Slide>

    <!-- ── Un posto solo ─────────────────────────────────────────────────── -->
    <Slide id="slide-unposto" bg="inverse" align="left" data-made-with="Adobe Firefly" data-made-with-for="sfondo">
      <div slot="backdrop" class="ex-bg-paper" style={`--bg-src: url(${bg_paper_grid.src})`} data-parallax></div>
      <div class="ex-content" data-reveal>
        <div class="ex-head">
          <p class="slide-eyebrow">Come si produce, oggi, quel numero di varianti</p>
          <h2 class="ex-head-title">Nasce, si approva, si traduce e si misura nello stesso posto</h2>
          <p class="ex-head-lead">
            Con le agenzie dentro lo stesso flusso, non in fondo a una catena di allegati. La
            misura sta attaccata al pezzo: si sa quale versione ha venduto. Chi approva resta chi
            approva oggi.
          </p>
        </div>
        <div class="ex-cards" data-reveal data-reveal-delay="0.14">
          {UNPOSTO.map((x) => (
            <div class="ex-card">
              <p class="ex-card-k">{x.k}</p>
              <p class="ex-card-t">{x.t}</p>
              <p class="ex-card-b">{x.b}</p>
            </div>
          ))}
        </div>
        {/* 20 ott: il titolo è lo stesso su ogni idea del deck — «Che cosa serve,
            concretamente» — perché un lettore impari dove guardare una volta sola.
            `tone` qui è `onDark` e non è un errore: il componente assume una
            dominante chiara, e in questa skin la dominante è scura; su una slide
            che rende CHIARA serve l'inchiostro dell'altro verso. */}
        <HowItWorks title="Che cosa serve, concretamente" label="Che cosa serve, concretamente" tone="onDark" data-reveal data-reveal-delay="0.2">
          <p>
            <strong>Automazione sul lavoro dei vostri, non sulla conversazione con i viaggiatori.</strong>
          </p>
          <CheServe pezzi={SERVE.contenuto} />
        </HowItWorks>
      </div>
    </Slide>

  </DeckContainer>
</BaseLayout>
