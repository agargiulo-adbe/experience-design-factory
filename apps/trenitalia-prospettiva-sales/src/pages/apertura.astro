---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import { href } from '@edf/core/utils/url.js';
import { CHAPTERS, prevSlug, nextSlug } from '../data/chapters';
import { APERTURA, CONTESTO, TESTE, fontiDi } from '../data/contenuti';
import { SOURCES } from '../data/sources';
import bg_chapter from '../assets/generated/bg/bg-chapter.webp';
import bg_close from '../assets/generated/bg/bg-close.webp';
import bg_paper_grid from '../assets/generated/bg/bg-paper-grid.webp';

/**
 * Capitolo 01 — Il vostro anno, visto da fuori.
 *
 * Experience in UNA lingua (vedi SITE.langs): il copy sta in `src/data/contenuti.ts`,
 * senza `<T>`. Se un giorno diventasse bilingue, ogni campo di quel file diventa
 * `{it, en}` — e le pagine non cambiano.
 *
 * Si apre con una frase SUA, non con Adobe: è la regola del dossier. Il 96% è sua,
 * verbatim; il 75% e il 4% sono un dato di contesto che circola al TTG e NON una
 * sua citazione — per questo stanno fuori dalle virgolette, con la loro fonte.
 * Nessun logo in questo capitolo.
 */
const SLUG = 'apertura';
const ch = CHAPTERS.find((c) => c.slug === SLUG)!;
const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;

// Le fonti della slide del contesto: una per fatto, dedotte dalle carte, senza
// ripetere la stessa pagina due volte.
const fontiContesto = [...new Map(CONTESTO.flatMap((c) => fontiDi(c)).map((f) => [f.label, f])).values()];
---
<BaseLayout title={ch.title.it}>
  <div class="fixed top-0 left-0 right-0 z-50">
    <Navigation currentPath={currentPath} base={base} />
  </div>

  <DeckContainer wallScale nextHref={href(base, nextSlug(SLUG))} prevHref={href(base, prevSlug(SLUG))}>

    <!-- ── Cover del capitolo ────────────────────────────────────────────── -->
    <Slide id="slide-cover" bg="primary" align="center" data-made-with="Adobe Firefly" data-made-with-for="sfondo">
      <div slot="backdrop" class="ex-bg-night" style={`--bg-src: url(${bg_chapter.src})`} data-parallax></div>
      <div class="ex-ch" data-reveal>
        <p class="ex-ch-num">Capitolo {ch.num}</p>
        <h2 class="ex-ch-title" data-reveal data-reveal-delay="0.08">{ch.title.it}</h2>
        <p class="ex-ch-lead" data-reveal data-reveal-delay="0.15">
          Prima di parlare di noi, quello che riguarda voi e che non abbiamo scoperto noi:
          le avete dette, annunciate o decise voi.
        </p>
        <div class="ex-ch-agenda" data-reveal data-reveal-delay="0.22">
          <p class="ex-ch-agenda-k">In questo capitolo</p>
          <ul role="list">
            <li><span class="ex-ch-agenda-n" aria-hidden="true">1</span><span>Il 96% che resta</span></li>
            <li><span class="ex-ch-agenda-n" aria-hidden="true">2</span><span>Il mercato, il prezzo, il momento</span></li>
          </ul>
        </div>
      </div>
    </Slide>

    <!-- ── Il 96% — il dato, poi le sue parole ───────────────────────────── -->
    <Slide id="slide-novantasei" bg="primary" align="center" data-made-with="Adobe Firefly" data-made-with-for="sfondo">
      <div slot="backdrop" class="ex-bg-night" style={`--bg-src: url(${bg_close.src})`} data-parallax></div>
      <div class="tp-quote" data-reveal>
        <p class="slide-eyebrow">{APERTURA.eyebrow}</p>
        <p class="tp-quote-big" data-display data-reveal data-reveal-delay="0.08" set:html={APERTURA.dato} />
        <p class="tp-quote-after" data-reveal data-reveal-delay="0.18">
          <span set:html={APERTURA.citazione} /> {APERTURA.lettura}
        </p>
        <p class="ex-src" data-reveal data-reveal-delay="0.26">
          Il dato come circola al TTG: <a href={SOURCES.turismo75.url} target="_blank" rel="noopener noreferrer">{SOURCES.turismo75.label}</a>.
          Le sue parole: <a href={SOURCES.ttg96.url} target="_blank" rel="noopener noreferrer">{SOURCES.ttg96.label}</a> e <a href={SOURCES.ttgAnsa.url} target="_blank" rel="noopener noreferrer">{SOURCES.ttgAnsa.label}</a>.
        </p>
      </div>
    </Slide>

    <!-- ── Il contesto: suo, non nostro ──────────────────────────────────── -->
    <Slide id="slide-contesto" bg="inverse" align="left" data-made-with="Adobe Firefly" data-made-with-for="sfondo">
      <div slot="backdrop" class="ex-bg-paper" style={`--bg-src: url(${bg_paper_grid.src})`} data-parallax></div>
      <div class="ex-content" data-reveal>
        <div class="ex-head">
          <p class="slide-eyebrow">{ch.title.it}</p>
          <h2 class="ex-head-title">{TESTE.contesto.titolo}</h2>
          <p class="ex-head-lead">{TESTE.contesto.lead}</p>
        </div>
        <div class="ex-cards" data-reveal data-reveal-delay="0.14">
          {CONTESTO.map((x) => (
            <div class="ex-card">
              <p class="ex-card-k">{x.k}</p>
              <p class="ex-card-t">{x.t}</p>
              <p class="ex-card-b">{x.b}</p>
            </div>
          ))}
        </div>
        <p class="ex-src" data-reveal data-reveal-delay="0.24">
          Fonti: {fontiContesto.map((f, i) => (
            <>{i > 0 ? ' · ' : ''}<a href={f.url} target="_blank" rel="noopener noreferrer">{f.label}</a></>
          ))}.
        </p>
      </div>
    </Slide>

  </DeckContainer>
</BaseLayout>
