---
import BaseLayout from '../layouts/BaseLayout.astro';
import AdminConsole from '@edf/core/blocks/admin/AdminConsole.astro';
import { href } from '@edf/core/utils/url.js';
import { SITE } from '../data/site';

const base = import.meta.env.BASE_URL;
const SUPABASE_URL = import.meta.env.PUBLIC_SUPABASE_URL ?? '';
const SUPABASE_ANON_KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY ?? '';

interface SlideEntry { id: string; label: string; }
interface PageEntry { slug: string; label: string; slides: SlideEntry[]; }

// Ogni slide del deck, pagina per pagina: è ciò che il tab «Capitoli e slide»
// accende e spegne. Ogni <Slide id> nuova va registrata qui.
const PAGE_REGISTRY: PageEntry[] = [
  { slug: 'index', label: 'Dove può arrivare il viaggio (00)', slides: [
    { id: 'slide-cover', label: 'Cover del capitolo' },
    { id: 'slide-percorso', label: 'Il percorso — sette fermate' },
  ]},
  { slug: 'apertura', label: 'Il vostro anno, visto da fuori (01)', slides: [
    { id: 'slide-cover', label: 'Cover del capitolo' },
    { id: 'slide-novantasei', label: 'La sua frase — il 96% del territorio' },
    { id: 'slide-contesto', label: 'Tre cose nello stesso anno' },
    { id: 'slide-punto', label: 'Il punto — la frase di chiusura' },
  ]},
  { slug: 'domanda', label: 'La domanda (02)', slides: [
    { id: 'slide-cover', label: 'Cover del capitolo' },
    { id: 'slide-domanda', label: 'La domanda — dove si perdono le vendite, e i perimetri' },
    { id: 'slide-mappa', label: 'La mappa — quattro punti' },
    { id: 'slide-punto', label: 'Il punto — la frase di chiusura' },
  ]},
  { slug: 'ricerca', label: 'Quando un viaggio si cerca con l\'intelligenza artificiale (03)', slides: [
    { id: 'slide-cover', label: 'Cover del capitolo' },
    { id: 'slide-referto', label: 'Il referto — otto domande, due assistenti' },
    { id: 'slide-frecce', label: 'Di chi sono le Frecce' },
    { id: 'slide-leva', label: 'Che cosa si misura, che cosa si cambia' },
    { id: 'slide-punto', label: 'Il punto — la frase di chiusura' },
  ]},
  { slug: 'viaggio', label: 'Un viaggio, non più prodotti (04)', slides: [
    { id: 'slide-cover', label: 'Cover del capitolo' },
    { id: 'slide-gia', label: 'Quello che è già partito' },
    { id: 'slide-matera', label: 'Il caso Roma-Matera' },
    { id: 'slide-acquisto', label: 'Riconoscere chi compone un viaggio' },
    { id: 'slide-prima', label: 'Il viaggio comincia altrove' },
    { id: 'slide-punto', label: 'Il punto — la frase di chiusura' },
  ]},
  { slug: 'contenuto', label: 'Il contenuto che l\'offerta richiede (05)', slides: [
    { id: 'slide-cover', label: 'Cover del capitolo' },
    { id: 'slide-aritmetica', label: 'L\'aritmetica della squadra unica' },
    { id: 'slide-unposto', label: 'Un posto solo' },
    { id: 'slide-punto', label: 'Il punto — la frase di chiusura' },
  ]},
  { slug: 'rete', label: 'Il canale delle agenzie (06)', slides: [
    { id: 'slide-cover', label: 'Cover del capitolo' },
    { id: 'slide-settantamila', label: 'Settantamila punti vendita' },
    { id: 'slide-sapere', label: 'Che cosa sapreste' },
    { id: 'slide-pico', label: 'La domanda su PICO, e lo strumento' },
    { id: 'slide-punto', label: 'Il punto — la frase di chiusura' },
  ]},
  { slug: 'dieci-minuti', label: 'In dieci minuti — il taglio corto', slides: [
    { id: 'slide-cover', label: 'Copertina' },
    { id: 'slide-novantasei', label: 'Il dato, e le sue parole sul 96%' },
    { id: 'slide-contesto', label: 'Tre cose nello stesso anno' },
    { id: 'slide-domanda', label: 'La domanda' },
    { id: 'slide-mappa', label: 'I quattro punti, in breve' },
    { id: 'slide-passo', label: 'Il passo che chiediamo' },
    { id: 'slide-signature', label: 'Slide-firma — Adobe × Trenitalia' },
  ]},
  { slug: 'rotta', label: 'La rotta (07)', slides: [
    { id: 'slide-cover', label: 'Cover del capitolo' },
    { id: 'slide-passo', label: 'Il passo che chiediamo' },
    { id: 'slide-domande', label: 'Le quattro domande aperte' },
    { id: 'slide-punto', label: 'Il punto — la frase di chiusura' },
    { id: 'slide-signature', label: 'Slide-firma — Adobe × Trenitalia' },
  ]},
];

interface SolutionEntry {
  id: string; name: string; shortName: string;
  pillar: string; description: string; appearsIn: string[];
}

// Segnaposto: il deck generato non ha slide gated. Sostituire con le soluzioni
// Adobe che l'experience propone davvero (nomi verificati, vedi memoria
// adobe-product-naming-2026) e marcare le slide con `data-solution="<id>"`.
const SOLUTIONS: SolutionEntry[] = [
  { id: 'piattaforma', name: 'Adobe Experience Cloud — segnaposto', shortName: 'Adobe', pillar: 'piattaforma',
    description: 'Sostituire con i prodotti Adobe che il deck propone, uno per voce, con il nome per esteso.', appearsIn: ['Il vostro anno, visto da fuori', 'La domanda', 'Quando il viaggio si cerca con un assistente', 'Un viaggio, non più prodotti', 'Il contenuto che l\'offerta richiede', 'Il canale delle agenzie', 'La rotta'] },
];

const PILLAR_LABELS: Record<string, string> = { piattaforma: 'Piattaforma' };
const PILLAR_ORDER = ['piattaforma'];
const PILLAR_COLORS: Record<string, string> = { piattaforma: '#d91835' };

const solutionGroups = PILLAR_ORDER
  .map((pillar) => ({ pillar, label: PILLAR_LABELS[pillar], color: PILLAR_COLORS[pillar], solutions: SOLUTIONS.filter((s) => s.pillar === pillar) }))
  .filter((g) => g.solutions.length > 0);

const allSolutionIds = SOLUTIONS.map((s) => s.id);
const deckHref = href(base, '/');
---
<BaseLayout title={`Console — ${SITE.name} · ${SITE.client}`}>
  <AdminConsole
    projectSlug={SITE.slug}
    projectName={SITE.name}
    clientLabel={`Adobe × ${SITE.client}`}
    deckHref={deckHref}
    pages={PAGE_REGISTRY}
    solutionGroups={solutionGroups}
    allSolutionIds={allSolutionIds}
    supabaseUrl={SUPABASE_URL}
    supabaseAnonKey={SUPABASE_ANON_KEY}
  />
</BaseLayout>
