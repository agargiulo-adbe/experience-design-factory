---
import BaseLayout from '../layouts/BaseLayout.astro';
import AdminConsole from '@edf/core/blocks/admin/AdminConsole.astro';
import { href } from '@edf/core/utils/url.js';
import { SITE } from '../data/site';

const base = import.meta.env.BASE_URL;
const SUPABASE_URL = import.meta.env.PUBLIC_SUPABASE_URL ?? '';
const SUPABASE_ANON_KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY ?? '';

// ⚠️ IL REGISTRO NON VIVE PIÙ QUI. Sta in `src/data/slides.ts`, perché lo
// usano in due: questa console per accendere e spegnere, e la copertina di
// ogni capitolo per rendere la propria agenda. Due liste a mano divergono —
// è già successo, e l'ha trovato una persona, non un gate.
import { PAGE_REGISTRY } from '../data/slides';

interface SolutionEntry {
  id: string; name: string; shortName: string;
  pillar: string; description: string; appearsIn: string[];
}

// Segnaposto: il deck generato non ha slide gated. Sostituire con le soluzioni
// Adobe che l'experience propone davvero (nomi verificati, vedi memoria
// adobe-product-naming-2026) e marcare le slide con `data-solution="<id>"`.
const SOLUTIONS: SolutionEntry[] = [
  { id: 'piattaforma', name: 'Adobe Experience Cloud — segnaposto', shortName: 'Adobe', pillar: 'piattaforma',
    description: 'Sostituire con i prodotti Adobe che il deck propone, uno per voce, con il nome per esteso.', appearsIn: ['Il vostro anno, visto da fuori', 'Come ottimizzare le vendite?', 'Quando il viaggio si cerca con un assistente', 'Personalizzare su larga scala', 'Il contenuto che l\'offerta richiede', 'Il canale delle agenzie', 'La Roadmap'] },
];

const PILLAR_LABELS: Record<string, string> = { piattaforma: 'Piattaforma' };
const PILLAR_ORDER = ['piattaforma'];
const PILLAR_COLORS: Record<string, string> = { piattaforma: '#d91835' };

const solutionGroups = PILLAR_ORDER
  .map((pillar) => ({ pillar, label: PILLAR_LABELS[pillar], color: PILLAR_COLORS[pillar], solutions: SOLUTIONS.filter((s) => s.pillar === pillar) }))
  .filter((g) => g.solutions.length > 0);

const allSolutionIds = SOLUTIONS.map((s) => s.id);
const deckHref = href(base, '/');
// Il dossier della Direzione Sales e' nato l'8 ott nell'app `trenitalia-connessioni`,
// prima che questa experience esistesse: il link e' cross-app e si costruisce dalla
// radice del sito, non dal base di questa app.
const siteRoot = base.replace(/[^/]+\/?$/, '');
// Le note per chi presenta vivono in questa app e sono pubbliche come il deck:
// stanno accanto al dossier perché è lì che chi apre la console va a cercare
// «che cosa mi serve prima di entrare in sala».
const DOSSIERS = [
  { href: href(base, '/relatore'), label: 'Note per chi presenta' },
  { href: href(siteRoot, '/trenitalia-connessioni/dossier-sales'), label: 'Dossier Direzione Sales' },
];
---
<BaseLayout title={`Console — ${SITE.name} · ${SITE.client}`}>
  <AdminConsole
    projectSlug={SITE.slug}
    projectName={SITE.name}
    clientLabel={`Adobe × ${SITE.client}`}
    deckHref={deckHref}
    dossiers={DOSSIERS}
    pages={PAGE_REGISTRY}
    solutionGroups={solutionGroups}
    allSolutionIds={allSolutionIds}
    supabaseUrl={SUPABASE_URL}
    supabaseAnonKey={SUPABASE_ANON_KEY}
  />
</BaseLayout>
