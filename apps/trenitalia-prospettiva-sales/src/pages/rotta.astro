---
import BaseLayout from '../layouts/BaseLayout.astro';
import { media } from '../data/site';
import Navigation from '../components/Navigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import Divisore from '../components/Divisore.astro';
import CoBrand from '../components/CoBrand.astro';
import { href } from '@edf/core/utils/url.js';
import bg_sole from '../assets/generated/sole/sole-rotta.webp';
import { CHAPTERS, prevSlug } from '../data/chapters';
import MappaIdee from '../components/MappaIdee.astro';
import Tempi from '../components/Tempi.astro';
import { ASK, COVER, TEMPI } from '../data/contenuti';
import LoopVideo from '@edf/core/blocks/immersive/LoopVideo.astro';

/**
 * Capitolo 07 — La rotta.
 *
 * Una Prospettiva non chiede un programma: chiede UN passo, piccolo e reversibile,
 * che il nostro interlocutore possa decidere da solo. Qui il passo è una sessione
 * sui loro dati della rete agenzie — la cosa più piccola che fa succedere la
 * seconda riunione.
 *
 * Il passo sta in `src/data/contenuti.ts`: l'ask vive
 * anche nel taglio «In dieci minuti», e due versioni della richiesta sono il
 * modo più rapido di sembrare confusi davanti a un cliente.
 *
 * L'ultima slide è la slide-firma: lockup grande, una riga, la via di ritorno.
 * Dove c'è un `hero` la firma fissa si spegne da sola (runtime del DeckContainer).
 */
const SLUG = 'rotta';
const ch = CHAPTERS.find((c) => c.slug === SLUG)!;
// Le clip NON stanno nel repo: `apps/*/public/media/*.mp4` è git-ignorato, quindi
// un file locale non arriverebbe mai al sito pubblicato. Vivono sulla Release
// `media` e si referenziano per URL assoluto, come fanno le altre experience.
// Il poster invece è un .jpg leggero e viaggia col repo: regge il primo paint e
// «Riduci movimento», dove la clip non parte.
const CLIP = media('trenitalia-prospettiva-close.loop.mp4');
const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;
/* 9 nov 2026: «Quello che vi chiediamo» disattivata su richiesta dell'owner. Per
   riaccenderla: `true` qui, e la voce in `slides.ts`. */
const MOSTRA_PASSO = false;
const first = CHAPTERS[0];

---
<BaseLayout title={ch.title.it}>
  <div class="fixed top-0 left-0 right-0 z-50">
    <Navigation currentPath={currentPath} base={base} />
  </div>

  <!-- Avanti oltre l'ultima slide → si torna alla copertina: il deck è un anello. -->
  <DeckContainer wallScale nextHref={href(base, '/')} prevHref={href(base, prevSlug(SLUG))}>

    <!-- ── Divisore di capitolo ─────────────────────────────────────────
         La forma XD: titolo grande, fotografia, pannello di colore. Sostituisce
         la vecchia cover a testo centrato — con l'agenda, il lead e il blocco
         del metodo impilati, era una slide di contenuto travestita da respiro.
         Titolo, punto e fotografia vengono da `chapters.ts`: una fonte sola.
         ⚠️ Il fondo sta QUI e non dentro `Divisore.astro`: Astro non propaga
         `slot="backdrop"` attraverso un componente. -->
    <Slide id="slide-cover" bg="primary" align="left" data-made-with="Adobe Firefly" data-made-with-for="sfondo">
      <div slot="backdrop" class="xd-div-bg" style={`--foto: url(${bg_sole.src})`}></div>
      <Divisore num={ch.num} titolo={ch.title.it} punto={ch.punto} tavolo={ch.tavolo} slug="rotta" />
    </Slide>

    <!-- ── Il passo ──────────────────────────────────────────────────────── -->
    <!-- ── La ripresa: le quattro idee tornano, ma qui chiedono ────────
         Chiesta al dry run del 5 novembre, insieme al cappello in apertura:
         «ci vuole una slide finale che faccia un recap di quanto presentato
         nelle idee — può essere anche la stessa slide idee-capability».
         ⚠️ Stessa geometria, testo diverso. Una ripetizione identica rende
         meno di una ripresa: è la regola che il deck applica già altrove, e
         qui il cambio è il mestiere della slide — non annuncia, chiede.
         «Non voglio andare lì a fare la presentazione»: la domanda sulle
         priorità è il punto d'uscita dell'ora. -->
    <Slide id="slide-ripresa" data-stretto bg="primary" align="left">
      <div slot="backdrop" class="xd-bg-piano"></div>
      <div class="xd-sl xd-sl--fig" data-reveal>
        <div class="xd-sl-head">
          <p class="xd-n">Le quattro idee, in una pagina</p>
          <h2 class="xd-h2">Quale di queste quattro vale la pena aprire per prima?</h2>
          {/* ⚠️ 6 nov 2026, panel: sei nomi marcati «si aggiunge» arrivavano
              senza una riga che dicesse dove finiscono rispetto a quello che
              il Gruppo ha già scelto. Qui la riga c'è, e richiude il cerchio
              aperto dalla slide «Dove ci innestiamo» del capitolo 02. */}
          <p class="xd-sub">
            Su tre delle quattro una parte della tecnologia è già nel Gruppo, per&nbsp;lavorare insieme
            alla&nbsp;piattaforma del dato di&nbsp;cliente annunciata a&nbsp;marzo.
          </p>
        </div>
        <MappaIdee />
      </div>
    </Slide>

    <!-- ── La macro timeline, chiesta dal cliente il 9 novembre ──────────── -->
    <Slide id="slide-tempi" bg="primary" align="left">
      <div slot="backdrop" class="xd-bg-piano"></div>
      <div class="xd-sl xd-sl--fig" data-reveal>
        <div class="xd-sl-head">
          <p class="xd-n">{TEMPI.eyebrow}</p>
          <h2 class="xd-h2">{TEMPI.titolo}</h2>
          <p class="xd-sub">{TEMPI.sub}</p>
        </div>
        <Tempi />
      </div>
    </Slide>

    <!-- ── Quello che chiediamo ───────────────────────────────────────────
         ⚠️ 6 nov 2026, sera: la richiesta non è più una sessione sui dati. Il
         perché sta sul blocco `ASK` in `src/data/contenuti.ts`, ed è una
         decisione di chi conosce la stanza, presa contro il verdetto del
         panel: va letta lì prima di rimetterci mano.
         La slide passa da citazione centrata a tre ancore, perché l'ask non è
         più una frase sola: sono tre cose, e in sala si indicano una per una. -->
    {MOSTRA_PASSO && (
    <Slide id="slide-passo" bg="primary" align="left">
      <div slot="backdrop" class="xd-bg-piano"></div>
      <div class="xd-sl" data-reveal>
        <div class="xd-sl-head">
          <p class="xd-n">{ASK.eyebrow}</p>
          <h2 class="xd-h2" set:html={ASK.titolo} />
          <p class="xd-sub">{ASK.sub}</p>
        </div>
        <div class="tp-ancore" data-stagger data-reveal data-reveal-delay="0.14">
          {ASK.punti.map((v) => (
            <div class="tp-anc">
              <p class="tp-anc-k">{v.k}</p>
              <p class="tp-anc-n">{v.t}</p>
              <p class="tp-anc-b">{v.b}</p>
            </div>
          ))}
        </div>
        <p class="xd-chiusa" data-reveal data-reveal-delay="0.26">{ASK.chiusa}</p>
      </div>
    </Slide>
    )}


    <!-- ── Slide-firma ───────────────────────────────────────────────────── -->
    <Slide id="slide-signature" data-audio="loud" bg="primary" align="center" data-made-with="Adobe Firefly" data-made-with-for="clip">
      <LoopVideo
        slot="backdrop"
        src={CLIP}
        poster={`${import.meta.env.BASE_URL}media/close-loop.poster.jpg`}
        scrim="absolute inset-0 bg-[rgba(27,34,48,0.72)]"
        opacity={0.85}
      />
      <CoBrand variant="hero" data-reveal />
      <p class="ex-sig-line" data-reveal data-reveal-delay="0.1">
        {COVER.firma}
      </p>
      <a href={href(base, '/' + first.slug)} class="edf-sig-cta" data-reveal data-reveal-delay="0.18">Ricomincia dal primo capitolo →</a>
    </Slide>

  </DeckContainer>
</BaseLayout>
