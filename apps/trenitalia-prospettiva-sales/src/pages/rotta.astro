---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import CoBrand from '../components/CoBrand.astro';
import { href } from '@edf/core/utils/url.js';
import { SITE } from '../data/site';
import { CHAPTERS, prevSlug } from '../data/chapters';
import { ASK, COVER, DOMANDE_APERTE } from '../data/contenuti';
import bg_chapter from '../assets/generated/bg/bg-chapter.webp';
import bg_close from '../assets/generated/bg/bg-close.webp';
import bg_paper_lines from '../assets/generated/bg/bg-paper-lines.webp';
import LoopVideo from '@edf/core/blocks/immersive/LoopVideo.astro';

/**
 * Capitolo 07 — La rotta.
 *
 * Una Prospettiva non chiede un programma: chiede UN passo, piccolo e reversibile,
 * che il nostro interlocutore possa decidere da solo. Qui il passo è una sessione
 * sui loro dati della rete agenzie — la cosa più piccola che fa succedere la
 * seconda riunione.
 *
 * Il passo e le domande aperte stanno in `src/data/contenuti.ts`: l'ask vive
 * anche nel taglio «In dieci minuti», e due versioni della richiesta sono il
 * modo più rapido di sembrare confusi davanti a un cliente.
 *
 * Le domande aperte stanno in slide per scelta: sono il modo di dire che non siamo
 * venuti con una risposta preconfezionata, e sono anche il contenuto del tavolo di
 * lavoro che il tipo «Prospettiva» chiede come passo successivo.
 *
 * L'ultima slide è la slide-firma: lockup grande, una riga, la via di ritorno.
 * Dove c'è un `hero` la firma fissa si spegne da sola (runtime del DeckContainer).
 */
const SLUG = 'rotta';
const ch = CHAPTERS.find((c) => c.slug === SLUG)!;
// Le clip NON stanno nel repo: `apps/*/public/media/*.mp4` è git-ignorato, quindi
// un file locale non arriverebbe mai al sito pubblicato. Vivono sulla Release
// `media` e si referenziano per URL assoluto, come fanno le altre experience.
// Il poster invece è un .jpg leggero e viaggia col repo: regge il primo paint e
// «Riduci movimento», dove la clip non parte.
const CLIP = 'https://github.com/agargiulo-adbe/experience-design-factory/releases/download/media/trenitalia-prospettiva-close.loop.mp4';
const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;
const first = CHAPTERS[0];

---
<BaseLayout title={ch.title.it}>
  <div class="fixed top-0 left-0 right-0 z-50">
    <Navigation currentPath={currentPath} base={base} />
  </div>

  <!-- Avanti oltre l'ultima slide → si torna alla copertina: il deck è un anello. -->
  <DeckContainer wallScale nextHref={href(base, '/')} prevHref={href(base, prevSlug(SLUG))}>

    <!-- ── Cover del capitolo ────────────────────────────────────────────── -->
    <Slide id="slide-cover" bg="primary" align="center" data-made-with="Adobe Firefly" data-made-with-for="sfondo">
      <div slot="backdrop" class="ex-bg-night" style={`--bg-src: url(${bg_chapter.src})`} data-parallax></div>
      <div class="ex-ch" data-reveal>
        <p class="ex-ch-num">Capitolo {ch.num}</p>
        <h2 class="ex-ch-title" data-reveal data-reveal-delay="0.08">{ch.title.it}</h2>
        <p class="ex-ch-lead" data-reveal data-reveal-delay="0.15">
          Quattro punti sono troppi per cominciare da tutti. Ne proponiamo uno,
          ed è quello che potete decidere senza chiedere niente a nessuno.
        </p>
      </div>
    </Slide>

    <!-- ── Il passo ──────────────────────────────────────────────────────── -->
    <Slide id="slide-passo" bg="primary" align="center" data-made-with="Adobe Firefly" data-made-with-for="sfondo">
      <div slot="backdrop" class="ex-bg-night" style={`--bg-src: url(${bg_close.src})`} data-parallax></div>
      <div class="tp-quote" data-reveal>
        <p class="slide-eyebrow">{ASK.eyebrow}</p>
        <h2 class="tp-domanda" data-display data-reveal data-reveal-delay="0.06" set:html={ASK.titolo} />
        <p class="tp-domanda-sub" data-reveal data-reveal-delay="0.18" set:html={ASK.sub} />
        <p class="ex-src" data-reveal data-reveal-delay="0.26" set:html={ASK.servono} />
      </div>
    </Slide>

    <!-- ── Le domande aperte ─────────────────────────────────────────────── -->
    <Slide id="slide-domande" bg="inverse" align="left" data-made-with="Adobe Firefly" data-made-with-for="sfondo">
      <div slot="backdrop" class="ex-bg-paper" style={`--bg-src: url(${bg_paper_lines.src})`} data-parallax></div>
      <div class="ex-content" data-reveal>
        <div class="ex-head">
          <p class="slide-eyebrow">Quello che non sappiamo</p>
          <h2 class="ex-head-title">Quattro cose che possiamo imparare solo da voi</h2>
          <p class="ex-head-lead">
            Questo documento è costruito su fonti pubbliche e su una misura nostra. Quattro cose
            importanti ci mancano, e nessuna si indovina.
          </p>
        </div>
        <ul class="tp-domande" role="list" data-stagger="0.1" data-reveal data-reveal-delay="0.14">
          {DOMANDE_APERTE.map((d) => <li class="tp-domande-row">{d}</li>)}
        </ul>
        <p class="ex-src" data-reveal data-reveal-delay="0.26">
          Le prime due sono l’ordine del giorno della mezza giornata sulle agenzie. Le altre due
          sono tavoli separati, con altre persone: non le mettiamo nello stesso invito.
        </p>
      </div>
    </Slide>

    <!-- ── Slide-firma ───────────────────────────────────────────────────── -->
    <Slide id="slide-signature" bg="primary" align="center" data-made-with="Adobe Firefly" data-made-with-for="clip">
      <LoopVideo
        slot="backdrop"
        src={CLIP}
        poster={`${import.meta.env.BASE_URL}media/close-loop.poster.jpg`}
        scrim="absolute inset-0 bg-[rgba(27,34,48,0.72)]"
        opacity={0.85}
      />
      <CoBrand variant="hero" data-reveal />
      <p class="ex-sig-line" data-reveal data-reveal-delay="0.1">
        {SITE.name}. {COVER.firma}
      </p>
      <a href={href(base, '/' + first.slug)} class="edf-sig-cta" data-reveal data-reveal-delay="0.18">Ricomincia dal primo capitolo →</a>
    </Slide>

  </DeckContainer>
</BaseLayout>
