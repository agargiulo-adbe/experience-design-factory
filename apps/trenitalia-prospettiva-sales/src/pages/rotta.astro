---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import Divisore from '../components/Divisore.astro';
import CoBrand from '../components/CoBrand.astro';
import { href } from '@edf/core/utils/url.js';
import { CHAPTERS, prevSlug } from '../data/chapters';
import MappaIdee from '../components/MappaIdee.astro';
import { ASK, COVER, DOMANDE_APERTE, ESITO } from '../data/contenuti';
import bg_alba_aperta from '../assets/generated/bg/bg-alba-aperta.webp';
import bg_chapter from '../assets/generated/bg/bg-chapter.webp';
import bg_close from '../assets/generated/bg/bg-close.webp';
import bg_paper_lines from '../assets/generated/bg/bg-paper-lines.webp';
import LoopVideo from '@edf/core/blocks/immersive/LoopVideo.astro';

/**
 * Capitolo 07 — La rotta.
 *
 * Una Prospettiva non chiede un programma: chiede UN passo, piccolo e reversibile,
 * che il nostro interlocutore possa decidere da solo. Qui il passo è una sessione
 * sui loro dati della rete agenzie — la cosa più piccola che fa succedere la
 * seconda riunione.
 *
 * Il passo e le domande aperte stanno in `src/data/contenuti.ts`: l'ask vive
 * anche nel taglio «In dieci minuti», e due versioni della richiesta sono il
 * modo più rapido di sembrare confusi davanti a un cliente.
 *
 * Le domande aperte stanno in slide per scelta: sono il modo di dire che non siamo
 * venuti con una risposta preconfezionata, e sono anche il contenuto del tavolo di
 * lavoro che il tipo «Prospettiva» chiede come passo successivo.
 *
 * L'ultima slide è la slide-firma: lockup grande, una riga, la via di ritorno.
 * Dove c'è un `hero` la firma fissa si spegne da sola (runtime del DeckContainer).
 */
const SLUG = 'rotta';
const ch = CHAPTERS.find((c) => c.slug === SLUG)!;
// Le clip NON stanno nel repo: `apps/*/public/media/*.mp4` è git-ignorato, quindi
// un file locale non arriverebbe mai al sito pubblicato. Vivono sulla Release
// `media` e si referenziano per URL assoluto, come fanno le altre experience.
// Il poster invece è un .jpg leggero e viaggia col repo: regge il primo paint e
// «Riduci movimento», dove la clip non parte.
const CLIP = 'https://github.com/agargiulo-adbe/experience-design-factory/releases/download/media/trenitalia-prospettiva-close.loop.mp4';
const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;
const first = CHAPTERS[0];

---
<BaseLayout title={ch.title.it}>
  <div class="fixed top-0 left-0 right-0 z-50">
    <Navigation currentPath={currentPath} base={base} />
  </div>

  <!-- Avanti oltre l'ultima slide → si torna alla copertina: il deck è un anello. -->
  <DeckContainer wallScale nextHref={href(base, '/')} prevHref={href(base, prevSlug(SLUG))}>

    <!-- ── Divisore di capitolo ─────────────────────────────────────────
         La forma XD: titolo grande, fotografia, pannello di colore. Sostituisce
         la vecchia cover a testo centrato — con l'agenda, il lead e il blocco
         del metodo impilati, era una slide di contenuto travestita da respiro.
         Titolo, punto e fotografia vengono da `chapters.ts`: una fonte sola.
         ⚠️ Il fondo sta QUI e non dentro `Divisore.astro`: Astro non propaga
         `slot="backdrop"` attraverso un componente. -->
    <Slide id="slide-cover" bg="primary" align="left" data-made-with="Adobe Firefly" data-made-with-for="sfondo">
      <div slot="backdrop" class="xd-div-bg" style={`--foto: url(${bg_alba_aperta.src})`}></div>
      <Divisore num={ch.num} titolo={ch.title.it} punto={ch.punto} tavolo={ch.tavolo} slug="rotta" />
    </Slide>

    <!-- ── Il passo ──────────────────────────────────────────────────────── -->
    <!-- ── La ripresa: le quattro idee tornano, ma qui chiedono ────────
         Chiesta al dry run del 5 novembre, insieme al cappello in apertura:
         «ci vuole una slide finale che faccia un recap di quanto presentato
         nelle idee — può essere anche la stessa slide idee-capability».
         ⚠️ Stessa geometria, testo diverso. Una ripetizione identica rende
         meno di una ripresa: è la regola che il deck applica già altrove, e
         qui il cambio è il mestiere della slide — non annuncia, chiede.
         «Non voglio andare lì a fare la presentazione»: la domanda sulle
         priorità è il punto d'uscita dell'ora. -->
    <Slide id="slide-ripresa" data-stretto bg="inverse" align="left" data-made-with="Adobe Firefly" data-made-with-for="sfondo">
      <div slot="backdrop" class="ex-bg-paper" style={`--bg-src: url(${bg_paper_lines.src})`} data-parallax></div>
      <div class="xd-sl xd-sl--fig" data-reveal>
        <div class="xd-sl-head">
          <p class="xd-n">Le quattro idee, in una pagina</p>
          <h2 class="xd-h2">Quale di queste quattro vale la pena aprire per prima?</h2>
          {/* ⚠️ 6 nov 2026, panel: sei nomi marcati «si aggiunge» arrivavano
              senza una riga che dicesse dove finiscono rispetto a quello che
              il Gruppo ha già scelto. Qui la riga c'è, e richiude il cerchio
              aperto dalla slide «Dove ci innestiamo» del capitolo 02. */}
          <p class="xd-sub">
            Su tutte e quattro una parte della tecnologia è già in casa vostra. Nessuna sostituisce
            la piattaforma del dato di cliente scelta a marzo: si appoggiano a quello che gira già.
            Da dove conviene cominciare lo sapete voi meglio di noi, ed è la domanda con cui
            chiudiamo.
          </p>
        </div>
        <MappaIdee />
      </div>
    </Slide>

    <!-- ── Quello che chiediamo ───────────────────────────────────────────
         ⚠️ 6 nov 2026, sera: la richiesta non è più una sessione sui dati. Il
         perché sta sul blocco `ASK` in `src/data/contenuti.ts`, ed è una
         decisione di chi conosce la stanza, presa contro il verdetto del
         panel: va letta lì prima di rimetterci mano.
         La slide passa da citazione centrata a tre ancore, perché l'ask non è
         più una frase sola: sono tre cose, e in sala si indicano una per una. -->
    <Slide id="slide-passo" bg="primary" align="left" data-made-with="Adobe Firefly" data-made-with-for="sfondo">
      <div slot="backdrop" class="ex-bg-night" style={`--bg-src: url(${bg_close.src})`} data-parallax></div>
      <div class="xd-sl" data-reveal>
        <div class="xd-sl-head">
          <p class="xd-n">{ASK.eyebrow}</p>
          <h2 class="xd-h2" set:html={ASK.titolo} />
          <p class="xd-sub">{ASK.sub}</p>
        </div>
        <div class="tp-ancore" data-stagger data-reveal data-reveal-delay="0.14">
          {ASK.punti.map((v) => (
            <div class="tp-anc">
              <p class="tp-anc-k">{v.k}</p>
              <p class="tp-anc-n">{v.t}</p>
              <p class="tp-anc-b">{v.b}</p>
            </div>
          ))}
        </div>
        <p class="xd-chiusa" data-reveal data-reveal-delay="0.26">{ASK.chiusa}</p>
      </div>
    </Slide>


    <!-- ── Che cosa va previsto ───────────────────────────────────────────
         Nasce dal panel (la Direzione Generale chiedeva una taglia e un
         indicatore: «senza unità di misura non entra nel piano») e la sera
         del 6 novembre cambia soggetto insieme all'ask: non più che cosa
         esce da una sessione, ma che cosa va messo nel piano perché una
         direzione confermata diventi un programma. -->
    <Slide id="slide-esito" bg="inverse" align="left" data-made-with="Adobe Firefly" data-made-with-for="sfondo">
      <div slot="backdrop" class="ex-bg-paper" style={`--bg-src: url(${bg_paper_lines.src})`} data-parallax></div>
      <div class="xd-sl" data-reveal>
        <div class="xd-sl-head">
          <p class="xd-n">{ESITO.eyebrow}</p>
          <h2 class="xd-h2">{ESITO.titolo}</h2>
          <p class="xd-sub">{ESITO.sub}</p>
        </div>
        {/* ⚠️ 6 nov 2026, Giro 2 di `/umanizza`: guardando le due slide di fila
            a 1920 avevano la STESSA forma — occhiello, titolo, tre ancore,
            barra di chiusa — e sono consecutive. Il gate del ritmo lo conferma
            di sbieco: quattro slide di fila nel capitolo senza un elemento
            visivo. Qui le tre voci NON sono parallele come quelle dell'ask:
            sono una progressione (la base, quello che si aggiunge, dove si
            vede l'effetto), e il filo a tre fermate è la loro forma. */}
        <div class="tp-filo" data-reveal data-reveal-delay="0.12">
          <svg class="tp-filo-fig" viewBox="0 0 1000 64" preserveAspectRatio="none" role="img"
               aria-label={ESITO.figura}>
            <line class="tp-filo-l" x1="166" y1="32" x2="834" y2="32" />
          </svg>
          {/* `--cols` va dichiarato: la griglia del filo nasce a quattro
              colonne, e con tre fermate si ammassavano a sinistra lasciando
              mezza pagina vuota. Si vede solo guardando la slide. */}
          <ol class="tp-filo-eti" style="--cols: 3" data-stagger="0.1">
            {ESITO.voci.map((v, i) => (
              <li>
                <span class="tp-filo-num">{String(i + 1).padStart(2, '0')}</span>
                <span class="tp-filo-dove">{v.k}</span>
                <span class="tp-filo-t">{v.t}</span>
                <span class="tp-filo-b">{v.b}</span>
              </li>
            ))}
          </ol>
        </div>
        <p class="xd-chiusa" data-reveal data-reveal-delay="0.24">{ESITO.chiusa}</p>
      </div>
    </Slide>

    <!-- ── Le domande aperte ─────────────────────────────────────────────── -->
    <Slide id="slide-domande" bg="inverse" align="left" data-made-with="Adobe Firefly" data-made-with-for="sfondo">
      <div slot="backdrop" class="ex-bg-paper" style={`--bg-src: url(${bg_paper_lines.src})`} data-parallax></div>
      <div class="xd-sl" data-reveal>
        <div class="xd-sl-head">
          <p class="xd-n">Quello che non sappiamo</p>
          <h2 class="xd-h2">Sei cose che possiamo imparare solo da voi</h2>
          <p class="xd-sub">
            Questo documento è costruito su fonti pubbliche e su una misura nostra. Sei cose
            importanti ci mancano, e nessuna si indovina.
          </p>
        </div>
        <ul class="tp-domande" role="list" data-stagger="0.1" data-reveal data-reveal-delay="0.14">
          {DOMANDE_APERTE.map((d) => <li class="tp-domande-row">{d}</li>)}
        </ul>
        <p class="xd-fonte" data-reveal data-reveal-delay="0.26">
          Le prime due le porteremmo volentieri a chi tiene quel dato. Le altre quattro sono
          tavoli separati, con altre persone: non le mettiamo nello stesso invito.
        </p>
      </div>
    </Slide>

    <!-- ── Slide-firma ───────────────────────────────────────────────────── -->
    <Slide id="slide-signature" bg="primary" align="center" data-made-with="Adobe Firefly" data-made-with-for="clip">
      <LoopVideo
        slot="backdrop"
        src={CLIP}
        poster={`${import.meta.env.BASE_URL}media/close-loop.poster.jpg`}
        scrim="absolute inset-0 bg-[rgba(27,34,48,0.72)]"
        opacity={0.85}
      />
      <CoBrand variant="hero" data-reveal />
      <p class="ex-sig-line" data-reveal data-reveal-delay="0.1">
        {COVER.firma}
      </p>
      <a href={href(base, '/' + first.slug)} class="edf-sig-cta" data-reveal data-reveal-delay="0.18">Ricomincia dal primo capitolo →</a>
    </Slide>

  </DeckContainer>
</BaseLayout>
