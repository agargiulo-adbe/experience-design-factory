---
/**
 * Il mockup di un'idea — lo strato XD, non il micro-diagramma.
 *
 * ⚠️ LA DIFFERENZA È IL REGISTRO, e vale per ogni deck (vedi
 * `skills/experience-design/references/xd.md`). Qui si proietta: una schermata
 * grande, riconoscibile come Trenitalia, che si capisce in tre secondi da otto
 * metri. I micro-diagrammi — piccoli e molti — stanno dietro «Scopri come» e
 * rispondono a una domanda: non sono questi, e non li sostituiscono.
 *
 * 9 nov 2026, notte: erano quattro elenchi sotto una barra rossa, tutti uguali.
 * Ora ogni idea ha la sua schermata, e il prima/dopo c'è solo dove è onesto:
 * · viaggio e contenuto: ↓ passa dalla schermata di partenza a quella nuova;
 * · ricerca: NESSUN dopo. Una risposta in cui Trenitalia esce prima sarebbe
 *   inventata, ed è il difetto tolto la mattina stessa. ↓ segna dove arriva;
 * · rete: è un'ipotesi, quindi si disegna il percorso e non un risultato.
 *
 * ⚠️ STATO DI BASE = IL DOPO. Con «Riduci movimento» i sotto-passi sono tutti
 * visibili, e due schermate impilate sarebbero testo su testo. La fase «prima»
 * esiste solo a sotto-passo zero con il movimento acceso (regole `.mk-fase`).
 *
 * ⚠️ Niente testo sopra le immagini e niente testo dentro un SVG: il testo qui
 * è HTML, così cresce con la radice e su una parete di sala si legge ancora.
 */
import { Image } from 'astro:assets';
import fotoPromo from '../assets/generated/mock/mock-promo.webp';
import fotoMatera from '../assets/generated/sole/sole-ricerca.webp';
import fotoPuglia from '../assets/generated/sole/sole-contenuto.webp';
import fotoFamiglia from '../assets/generated/puglia/puglia-famiglia.webp';
import fotoCoppia from '../assets/generated/puglia/puglia-coppia.webp';
import fotoBici from '../assets/generated/puglia/puglia-bici.webp';

interface Props { variante: 'ricerca' | 'viaggio' | 'contenuto' | 'rete' | 'citta'; }
const { variante } = Astro.props as Props;
---
<div class="mk" data-variante={variante} aria-hidden="true">

  {/* Riscritto il 9 nov 2026 sull'esito registrato nella misura, domanda 1 su
      ChatGPT. L'ordine è quello della risposta: non si abbellisce. */}
  {variante === 'ricerca' && (
    <div class="mk-schermo mk-schermo--chat">
      <div class="mk-barra"><span class="mk-barra-t">ChatGPT · sintesi della risposta</span></div>
      <div class="mk-corpo mk-corpo--piena">
        <p class="mk-bolla">Come arrivo da Roma a Matera senza auto?</p>
        <ol class="mk-ordine">
          <li><span class="mk-ordine-n">1</span><span class="mk-ordine-t"><strong>In apertura</strong>Gli operatori di autobus</span></li>
          <li><span class="mk-ordine-n">2</span><span class="mk-ordine-t"><strong>Treno più autobus</strong>Prima il concorrente</span></li>
          <li data-trenitalia>
            <span class="mk-ordine-n">3</span>
            <span class="mk-ordine-t"><strong>Solo dopo</strong>Freccialink di Trenitalia</span>
            {/* Con ↓ la riga si accende e basta: la scritta ripeteva «Freccialink di Trenitalia». */}
            <span class="mk-evidenza" data-substep></span>
          </li>
        </ol>
      </div>
    </div>
  )}

  {variante === 'citta' && (
    <div class="mk-schermo mk-schermo--app">
      <div class="mk-barra"><span class="mk-barra-t">Homepage · esempio</span></div>
      <div class="mk-corpo">
        <p class="mk-occ">Una proposta per città</p>
        <ol class="mk-tratte" data-stagger="0.13">
          <li><span class="mk-tratta-m">A chi</span><span class="mk-tratta-d">Chi entra da una città scelta</span></li>
          <li><span class="mk-tratta-m">Che cosa</span><span class="mk-tratta-d">Un’offerta sulla tratta che parte da lì</span></li>
          <li data-ultimo><span class="mk-tratta-m">Confronto</span><span class="mk-tratta-d">Con la proposta e&nbsp;senza</span></li>
        </ol>
        <div class="mk-totale"><span>Stesso modello</span><strong>Altre città</strong></div>
      </div>
    </div>
  )}

  {/* Nessuna tariffa e nessun vantaggio specifico: sono dettagli che il cliente
      conosce a memoria, e sbagliarne uno costa la slide.
      La struttura è quella della homepage vera, letta il 9 nov 2026: il modulo di
      ricerca in testa e sotto la promozione del momento, uguale per tutti.
      ⚠️ «Perché qui» cita solo ciò che Trenitalia può sapere: un biglietto comprato.
      Che il viaggiatore sia andato alla Reggia non lo sa nessuno. */}
  {variante === 'viaggio' && (
    <div class="mk-fasi">
      <div class="mk-schermo mk-fase mk-fase--prima">
        <div class="mk-barra"><span class="mk-barra-t">Prima · la stessa homepage per tutti</span></div>
        <div class="mk-corpo mk-corpo--piena">
          <div class="mk-ricerca">
            <span class="mk-campo"><small>Partenza da</small>Inserisci stazione</span>
            <span class="mk-campo"><small>Arrivo a</small>Inserisci stazione</span>
            <span class="mk-cta">Cerca</span>
          </div>
          <div class="mk-promo">
            <div class="mk-foto"><Image src={fotoPromo} alt="" widths={[640, 1100]} sizes="30vw" /></div>
            <div class="mk-home-t">
              <small class="mk-promo-k">L’offerta del momento</small>
              <p class="mk-home-h">Le feste si raggiungono in treno</p>
            </div>
          </div>
        </div>
      </div>

      <div class="mk-schermo mk-fase mk-fase--dopo" data-substep>
        <div class="mk-barra"><span class="mk-barra-t">Dopo · homepage personalizzata</span></div>
        <div class="mk-corpo mk-corpo--piena">
          <div class="mk-ricerca">
            <span class="mk-campo"><small>Partenza da</small>Roma Termini</span>
            <span class="mk-campo"><small>Arrivo a</small>Matera</span>
            <span class="mk-cta">Scegli il treno</span>
          </div>
          <div class="mk-promo">
            <div class="mk-foto"><Image src={fotoMatera} alt="" widths={[640, 1100]} sizes="30vw" /></div>
            <div class="mk-home-t">
              <span class="mk-chip mk-chip--on">CartaFreccia Oro</span>
              <p class="mk-home-h">Matera, la prossima meta</p>
            </div>
          </div>
          <ul class="mk-tessere">
            <li data-on><strong>Il tuo vantaggio</strong><span>Riservato al livello Oro</span></li>
            <li><strong>Il viaggio</strong><span>Frecciarossa + Freccialink</span></li>
            <li><strong>Perché qui</strong><span>Dopo il tuo Roma-Caserta</span></li>{/* copy-audit-ignore · testo d'interfaccia dentro il mockup: è il sito che parla a chi naviga */}
          </ul>
        </div>
      </div>
    </div>
  )}

  {/* Per pubblico, non per lingua: «la mia priorità non è tradurre le pagine»
      (responsabile dei canali digitali, 9 nov 2026). Il contenuto segue la
      personalizzazione: più segmenti, più versioni. Tre immagini diverse apposta. */}
  {variante === 'contenuto' && (
    <div class="mk-fasi">
      <div class="mk-schermo mk-fase mk-fase--prima">
        <div class="mk-barra"><span class="mk-barra-t">Prima · una sola versione, uguale per tutti</span></div>
        <div class="mk-corpo mk-corpo--piena">
          <div class="mk-master">
            <div class="mk-foto"><Image src={fotoPuglia} alt="" widths={[640, 1100]} sizes="30vw" /></div>
            <div class="mk-master-t">
              <span class="mk-chip">Approvata</span>
              <p class="mk-home-h">Estate in Puglia</p>
            </div>
          </div>
        </div>
      </div>

      <div class="mk-schermo mk-fase mk-fase--dopo" data-substep>
        <div class="mk-barra"><span class="mk-barra-t">Dopo · la stessa campagna, per ogni pubblico</span></div>
        <div class="mk-corpo mk-corpo--piena">
          <ul class="mk-mercati">
            <li>
              <div class="mk-foto"><Image src={fotoFamiglia} alt="" widths={[480, 800]} sizes="18vw" /></div>
              <div class="mk-mercato-t">
                <small>Famiglie · sito</small>
                <strong>Tutti al mare</strong>
              </div>
            </li>
            <li>
              <div class="mk-foto"><Image src={fotoCoppia} alt="" widths={[480, 800]} sizes="18vw" /></div>
              <div class="mk-mercato-t">
                <small>Coppie · social</small>
                <strong>Due giorni nei borghi</strong>
              </div>
            </li>
            <li>
              <div class="mk-foto"><Image src={fotoBici} alt="" widths={[480, 800]} sizes="18vw" /></div>
              <div class="mk-mercato-t">
                <small>Da soli · email</small>
                <strong>In bici fra gli ulivi</strong>
              </div>
            </li>
          </ul>
        </div>
      </div>
    </div>
  )}

  {/* Un'ipotesi, e si vede: un percorso senza numeri (richiesta del cliente).
      Il codice è DI CAMPAGNA, non della persona: Customer Journey Analytics lega
      i dataset solo su un identificativo di persona comune, quindi qui si leggono
      totali per codice. E una locandina non genera eventi: si misura solo dando
      un codice a ogni scheda o locandina. Verificato su Experience League, 9 nov 2026. */}
  {variante === 'rete' && (
    <div class="mk-schermo mk-schermo--rete">
      <div class="mk-barra"><span class="mk-barra-t">Dal digitale al banco · ipotesi da verificare</span></div>
      <div class="mk-corpo mk-corpo--piena">
        <ol class="mk-percorso" data-stagger="0.12">
          <li><small>Online</small><strong>Un’offerta con un codice di campagna</strong></li>
          <li><small>Al banco</small><strong>Il cliente lo mostra, l’agenzia lo registra</strong></li>
          <li data-on><small>In Customer Journey Analytics</small><strong>Quante vendite per codice</strong></li>
        </ol>
        <ul class="mk-poi">
          <li><small>I contenuti</small><span>Un codice per ogni scheda: quali vengono usate di più</span></li>
          <li><small>Le prove</small><span>Una proposta su poche agenzie</span></li>
        </ul>
      </div>
    </div>
  )}

</div>
