---
/**
 * Il mockup di un'idea — lo strato XD, non il micro-diagramma.
 *
 * ⚠️ LA DIFFERENZA È IL REGISTRO, e vale per ogni deck (vedi
 * `skills/experience-design/references/xd.md`). Qui si proietta: una schermata
 * grande, riconoscibile come Trenitalia, che si capisce in tre secondi da otto
 * metri. I micro-diagrammi — piccoli e molti — stanno dietro «Scopri come» e
 * rispondono a una domanda: non sono questi, e non li sostituiscono.
 *
 * Quattro varianti, una per idea del percorso. La pelle richiama il vero
 * trenitalia.com: barra rossa di marchio, superficie chiara, Poppins.
 *
 * ⚠️ Niente testo dentro un SVG: il testo qui è HTML, così cresce con la
 * radice e su una parete di sala si legge ancora.
 */
interface Props { variante: 'ricerca' | 'viaggio' | 'contenuto' | 'rete'; }
const { variante } = Astro.props as Props;
---
<div class="mk" data-variante={variante} aria-hidden="true">

  {variante === 'ricerca' && (
    <div class="mk-schermo mk-schermo--chat">
      <div class="mk-barra"><span class="mk-barra-t">Risposta generata · esempio</span></div>
      <div class="mk-corpo">
        <p class="mk-dom">«Come arrivo a Matera senza auto?»</p>
        <div class="mk-risposta" data-stagger="0.12">
          <p>La tratta si copre in treno fino a Ferrandina e poi con il collegamento
             su gomma. L’orario e l’acquisto stanno sul sito dell’operatore.</p>
          <div class="mk-card">
            <span class="mk-card-m">Frecciarossa</span>
            <span class="mk-card-o">un prodotto Trenitalia</span>
          </div>
        </div>
        <p class="mk-fonti-k">Fonti citate</p>
        <ul class="mk-fonti" data-stagger="0.09">
          <li class="mk-chip mk-chip--on">trenitalia.com</li>
          <li class="mk-chip">un portale di viaggi</li>
          <li class="mk-chip">un blog</li>
        </ul>
      </div>
    </div>
  )}

  {variante === 'viaggio' && (
    <div class="mk-schermo mk-schermo--app">
      <div class="mk-barra"><span class="mk-barra-t">Roma → Matera</span></div>
      <div class="mk-corpo">
        <p class="mk-occ">Una soluzione, un prezzo</p>
        <ol class="mk-tratte" data-stagger="0.13">
          <li><span class="mk-tratta-m">Frecciarossa</span><span class="mk-tratta-d">Roma T.ni → Salerno</span><span class="mk-tratta-o">2h 05</span></li>
          <li><span class="mk-tratta-m">Intercity</span><span class="mk-tratta-d">Salerno → Ferrandina</span><span class="mk-tratta-o">1h 40</span></li>
          <li data-ultimo><span class="mk-tratta-m">Collegamento su gomma</span><span class="mk-tratta-d">Ferrandina → Matera</span><span class="mk-tratta-o">0h 45</span></li>
        </ol>
        {/* ⚠️ NESSUNA TARIFFA INVENTATA. Qui c'era «€ 61,90»: una cifra nostra, su
            una relazione vera, davanti a chi i prezzi li conosce a memoria. La riga
            di fonte della slide dichiara che l'itinerario è un esempio nostro, ma un
            prezzo preciso e sbagliato è il dettaglio che viene corretto a voce e fa
            rileggere con sospetto tutto il resto. Il mock dice la cosa che deve dire
            — tre tratte, un acquisto solo — senza affermare quanto costa. */}
        <div class="mk-totale"><span>Tre tratte, un biglietto</span><strong>Un prezzo</strong></div>
      </div>
    </div>
  )}

  {variante === 'contenuto' && (
    <div class="mk-schermo mk-schermo--studio">
      <div class="mk-barra"><span class="mk-barra-t">Campagna · Estate in Puglia</span></div>
      <div class="mk-corpo">
        <div class="mk-master"><span class="mk-master-k">Master approvato</span><span class="mk-master-t">Estate in Puglia</span></div>
        <ul class="mk-varianti" data-stagger="0.1">
          <li><span class="mk-var-l">IT</span><span class="mk-var-d">sito e app</span></li>
          <li><span class="mk-var-l">EN</span><span class="mk-var-d">mercati esteri</span></li>
          <li><span class="mk-var-l">DE</span><span class="mk-var-d">Germania</span></li>
          <li data-attesa><span class="mk-var-l">中文</span><span class="mk-var-d">Cina</span></li>
        </ul>
        <p class="mk-nota">Stesso master, quattro mercati. La revisione umana resta.</p>
      </div>
    </div>
  )}

  {variante === 'rete' && (
    <div class="mk-schermo mk-schermo--rete">
      <div class="mk-barra"><span class="mk-barra-t">Punto vendita · agenzia convenzionata</span></div>
      <div class="mk-corpo">
        <div class="mk-rete-griglia" data-stagger="0.12">
          <div class="mk-rete-b"><span class="mk-rete-k">Richiesta</span><span class="mk-rete-v">Gruppo, 18 persone, Puglia</span></div>
          <div class="mk-rete-b" data-on><span class="mk-rete-k">Proposta pronta</span><span class="mk-rete-v">Frecciarossa + collegamento, tariffa gruppi</span></div>
          <div class="mk-rete-b"><span class="mk-rete-k">Materiale</span><span class="mk-rete-v">Scheda e locandina, già di marchio</span></div>
        </div>
        <p class="mk-nota">Quello che l’agenzia chiede al telefono, davanti al cliente.</p>
      </div>
    </div>
  )}

</div>
