---
/**
 * LA ROADMAP — la stessa nel percorso intero e nel taglio corto.
 * Una fonte sola (`TEMPI` in `contenuti.ts`).
 *
 * Il disegno dice la cosa che la slide afferma: un binario in posa. Dove il tratto
 * dipende solo da quello che c'è, il binario è posato e rosso; dove dipende da altri
 * sistemi è tratteggiato, ancora da costruire. I numeri servono: sono una sequenza.
 * Il binario è CSS e il testo è HTML, così crescono con la radice sulla parete.
 */
import { TEMPI } from '../data/contenuti';
---
<ol class="tp-rm" aria-label={TEMPI.figura} data-reveal data-reveal-delay="0.12" data-stagger="0.1">
  {TEMPI.voci.map((v, i) => (
    <li data-tratto={i === 0 ? 'posato' : i === 1 ? 'pronto' : 'da-posare'}>
      <span class="tp-rm-n">{i + 1}</span>
      <p class="tp-rm-q">{v.k}</p>
      <p class="tp-rm-t">{v.t}</p>
      <p class="tp-rm-b">{v.b}</p>
      <p class="tp-rm-d">{v.dip}</p>
    </li>
  ))}
</ol>
<div class="tp-rm-strato" data-reveal data-reveal-delay="0.24">
  <strong>{TEMPI.strato.t}</strong>
  <span>{TEMPI.strato.b}</span>
</div>
