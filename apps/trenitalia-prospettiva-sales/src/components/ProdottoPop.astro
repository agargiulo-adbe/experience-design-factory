                <span class="pp-giu"></span>
                <div class="pp-riga" data-spento><strong>I due Analytics</strong><span>spenti</span></div>
                <span class="pp-giu"></span>
                <div class="pp-riga"><strong>Storico e progetti</strong><span>si portano dietro</span></div>
              </li>
