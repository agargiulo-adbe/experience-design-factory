---
/**
 * IL POP-IN DI UN PRODOTTO CHE SI AGGIUNGE — un mockup semplificato, per scena.
 *
 * Forma: `<dialog>` nativo. Sta nel top layer, quindi non risente di trasformazioni
 * e `overflow` della slide; Esc e la trappola del fuoco arrivano gratis.
 * Da chiuso è `display: none`, quindi i gate di layout non lo misurano: si misura a
 * parte, aprendolo.
 *
 * Un elemento entra al passo `data-da` e, se c'è, esce dopo `data-a`. Niente testo
 * dentro un SVG: tutto HTML, così cresce con la radice e si legge su una parete.
 * `data-audit-skip`: la stessa striscia sta su due slide di una pagina, quindi lo
 * stesso pop-in compare due volte nel DOM. Sta dentro la slide perché fuori da
 * quella attiva erediterebbe `visibility: hidden`. Non è prosa ripetuta a schermo.
 * I testi di ogni passo stanno in `data/pop.ts`; qui c'è solo la scena.
 */
import { Image } from 'astro:assets';
import { SCENE, type ScenaId } from '../data/pop';
import '../styles/pop.css';
import fotoPuglia from '../assets/generated/sole/sole-contenuto.webp';
import fotoFamiglia from '../assets/generated/puglia/puglia-famiglia.webp';
import fotoCoppia from '../assets/generated/puglia/puglia-coppia.webp';
import fotoBici from '../assets/generated/puglia/puglia-bici.webp';

interface Props { scena: ScenaId; }
const { scena } = Astro.props as Props;
const s = SCENE[scena];
const AGENZIE = Array.from({ length: 12 }, (_, i) => i);
---
<dialog class="pp" data-pp data-deck-nochrome data-audit-skip data-tot={s.passi.length} data-scena={scena} aria-label={`${s.prodotto}: ${s.caso}`}>
  <div class="pp-in">
    <header class="pp-testa">
      <div class="pp-testa-t">
        <p class="pp-k">Si aggiunge · {s.caso}</p>
        <h3 class="pp-h">{s.prodotto}</h3>
      </div>
      <p class="pp-cosa">{s.cosa}</p>
      <button type="button" class="pp-x" data-pp-chiudi aria-label="Chiudi">×</button>
    </header>

    <div class="pp-scena">

      {scena === 'cja-acquisto' && (
        <div class="pp-pila">
          <div class="pp-cja" data-a="5">
            <div class="pp-strato" data-da="2">
              <div class="pp-strato-t"><strong>Customer Journey Analytics</strong><span>Lo strato che legge tutti i canali insieme</span></div>
              <ol class="pp-viaggio" data-da="5">
                <li><small>trenitalia.com</small><strong>Cerca Matera</strong></li>
                <li><small>lefrecce.it</small><strong>Sceglie il treno</strong></li>
                <li><small>CRM</small><strong>CartaFreccia Oro</strong></li>
                <li data-on><small>Un percorso solo</small><strong>La prossima meta</strong></li>
              </ol>
            </div>
            <div class="pp-fili">
              <span class="pp-filo" data-da="2"></span>
              <span class="pp-filo" data-da="2"></span>
              <span class="pp-filo" data-da="3"></span>
              <span class="pp-filo pp-filo--poi" data-da="4"></span>
              <span class="pp-filo pp-filo--poi" data-da="4"></span>
              <span class="pp-filo pp-filo--poi" data-da="4"></span>
            </div>
            <ul class="pp-fonti">
              <li class="pp-f" data-gia><small>Analytics</small><strong>trenitalia.com</strong></li>
              <li class="pp-f" data-gia><small>Analytics</small><strong>lefrecce.it</strong></li>
              <li class="pp-f" data-da="3"><small>Con il nuovo CRM</small><strong>CartaFreccia</strong></li>
              <li class="pp-f pp-f--poi" data-da="4"><small>Domani</small><strong>App</strong></li>
              <li class="pp-f pp-f--poi" data-da="4"><small>Domani</small><strong>Agenzie</strong></li>
              <li class="pp-f pp-f--poi" data-da="4"><small>Domani</small><strong>Partner</strong></li>
            </ul>
          </div>

          <div class="pp-dup" data-da="6">
            <p class="pp-dup-h">Una raccolta sola, in ogni fase</p>
            <ol class="pp-tappe">
              <li class="pp-tappa">
                <p class="pp-tappa-k">Da subito</p>
                <div class="pp-riga" data-on><strong>Customer Journey Analytics</strong><span>legge</span></div>
                <span class="pp-giu"></span>
                <div class="pp-riga" data-gia><strong>I due Analytics</strong><span>raccolgono, come oggi</span></div>
                <span class="pp-giu"></span>
                <div class="pp-riga"><strong>trenitalia.com · lefrecce.it</strong><span>nessun tag nuovo</span></div>
              </li>
              <li class="pp-tappa" data-da="7">
                <p class="pp-tappa-k">Con il nuovo sito</p>
                <div class="pp-riga" data-on><strong>Customer Journey Analytics</strong><span>riceve direttamente</span></div>
                <span class="pp-giu"></span>
                <div class="pp-riga" data-off><strong>I due Analytics</strong><span>restano per lo storico</span></div>
                <span class="pp-giu"></span>
                <div class="pp-riga"><strong>Il nuovo sito</strong><span>una sola raccolta, Web SDK</span></div>
              </li>
