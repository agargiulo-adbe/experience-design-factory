              <li><Image src={fotoCoppia} alt="" widths={[240, 400]} sizes="10vw" /><span>Coppie</span><em data-da="4">✓</em></li>
              <li><Image src={fotoBici} alt="" widths={[240, 400]} sizes="10vw" /><span>Da soli</span><em data-da="4">✓</em></li>
            </ul>
            <div class="pp-c pp-c--ok" data-da="5"><small>Decide il team</small><strong>In approvazione, nel vostro flusso</strong></div>
          </div>
