      {scena === 'cja-rete' && (
        <div class="pp-rete">
          <div class="pp-sch">
            <div class="pp-c"><small>Scheda</small><strong>Matera</strong></div>
            <div class="pp-c"><small>Locandina</small><strong>Puglia in treno</strong></div>
            <div class="pp-c"><small>Scheda</small><strong>Frecce estate</strong></div>
          </div>
          <div class="pp-ag">
            <p class="pp-col-t">Le agenzie</p>
            <ul class="pp-ag-g">
              {AGENZIE.map((i) => (
                <li data-con={i % 2 === 0 ? 'si' : 'no'}>
                  <span class="pp-ag-d"></span>
                  <i class="pp-ag-b" data-da="2" style={`--v:${(i % 2 === 0 ? 62 : 38) + (i * 13) % 28}%`}></i>
                </li>
              ))}
            </ul>
            <p class="pp-leg"><span data-con="si"></span>con la scheda<span data-con="no"></span>senza</p>
          </div>
          <div class="pp-ris">
            <div class="pp-strato pp-strato--p" data-da="3"><div class="pp-strato-t"><strong>Customer Journey Analytics</strong><span>Per agenzia, senza dati di persona</span></div></div>
            <div class="pp-ris-pila">
            <div class="pp-c" data-da="4" data-a="4">
              <small>Stessa tratta, stesso periodo</small>
              <div class="pp-barre">
                <p data-on><span>Con la scheda</span><i style="--v:78%"></i></p>
                <p><span>Senza</span><i style="--v:54%"></i></p>
              </div>
            </div>
            <div class="pp-c" data-da="5">
              <small>Quale fa vendere di più</small>
              <div class="pp-barre">
                <p data-on><span>Scheda Matera</span><i style="--v:84%"></i></p>
                <p><span>Frecce estate</span><i style="--v:56%"></i></p>
                <p data-spento><span>Puglia in treno</span><i style="--v:22%"></i></p>
