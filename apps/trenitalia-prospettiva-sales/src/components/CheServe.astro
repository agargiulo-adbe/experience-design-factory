---
/**
 * CheServe — i pezzi che occorrono, in UNA riga.
 *
 * PERCHÉ ESISTE
 * Chiesto in riunione il 20 ott 2026: un'idea senza i suoi pezzi lascia la
 * stanza con l'impressione che si debba comprare tutto da capo. La pastiglia
 * dice quali sono già loro e quali si aggiungono.
 *
 * PERCHÉ È UNA RIGA E NON PIÙ UN ELENCO
 * Il 26 ott il dettaglio è diventato una griglia di FIGURE («ancore, non
 * prosa»): il meccanismo lo mostra il disegno, e la riga sotto porta il fatto.
 * L'elenco a tre colonne ripeteva in parole quello che la figura mostra, e le
 * due cose insieme portavano la slide aperta fuori dalla safe-area a 1280 —
 * check `c` dentro `exp`, che è HARD, misurato. Qui resta solo quello che la
 * figura NON può dire: il nome del prodotto e il suo stato.
 *
 * Vive nello slot `nota` del `Dettaglio`: è la provenienza dei pezzi, non una
 * quarta voce. La pastiglia porta la PAROLA oltre al colore — un colore da solo
 * non è un'informazione — e sta in un `::before`, così nella riga c'è un solo
 * elemento di testo e il check `e` non ha niente da intersecare.
 */
import { LEGENDA, type Pezzo } from '../data/contenuti';
import { SOURCES, type ChiaveFonte, type Fonte } from '../data/sources';

interface Props {
  pezzi: Pezzo[];
}
const { pezzi } = Astro.props;

// Una fonte senza `url` è interna: si nomina senza finto link (regola del repo).
// Il link si risolve qui, dove il tipo `Fonte` dice che `url` è facoltativo.
const linkDi = (k?: ChiaveFonte): string | undefined => {
  if (!k) return undefined;
  const f: Fonte = SOURCES[k];
  return f.url;
};
const righe = pezzi.map((x) => ({ ...x, url: linkDi(x.fonte) }));

// La legenda scioglie solo gli stati che questa slide usa davvero.
const statiUsati = [...new Set(pezzi.map((p) => p.stato))];
const legenda = statiUsati.map((st) => `${LEGENDA[st].eti}, ${LEGENDA[st].spiega}`).join(' · ');
---
<p class="tp-serve">
  {righe.map((x, i) => (
    <>{i > 0 ? <span class="tp-serve-sep" aria-hidden="true"> · </span> : ''}<span class="tp-serve-n" data-stato={x.stato} data-eti={LEGENDA[x.stato].eti}>{x.url
      ? <a href={x.url} target="_blank" rel="noopener noreferrer">{x.nome}</a>
      : x.nome}</span></>
  ))}
  <span class="tp-serve-leg">{legenda}</span>
</p>
