---
/**
 * LA STRISCIA ADOBE — con che cosa si fa, proiettata e sempre visibile.
 *
 * 9 nov 2026: il feedback diffuso era che i prodotti Adobe non si vedevano.
 * Stavano al terzo livello di un riquadro piccolo, entravano all'ultimo ↓ e il
 * marchio non compariva. Qui il marchio Adobe apre la riga e ogni prodotto ha una
 * tessera: nome grande e una riga su che cosa fa in QUESTA idea. Niente listino.
 *
 * Lo stato si legge due volte, a parole e dalla forma: tessera piena = si aggiunge,
 * tessera chiara = già nel Gruppo. Il peso va su ciò che si propone.
 *
 * ⚠️ MARCHIO, letto su Brand Center il 9 nov 2026 (Brand Guidelines, giugno 2026):
 * una comunicazione con più prodotti apre con il lockup della Cloud; i loghi dei
 * prodotti di Experience Cloud sono RITIRATI, i nomi stanno in testo. Il wordmark
 * non si ricompone con il testo e i lockup non si costruiscono né si ritoccano: il
 * file è quello ufficiale, stacked perché la colonna è stretta.
 *
 * 10 nov 2026: una tessera «si aggiunge» è un bottone e apre il pop-in del prodotto
 * in QUESTO caso d'uso (campo `pop` in `SERVE`). Il link alla fonte sta nel pop-in.
 *
 * ⚠️ Fondo bianco e inchiostri espliciti: la striscia sta su slide scure e chiare,
 * e `.tp-pz` eredita.
 * Dove si apre un drill-down cede il posto (`cede`): mai rimpicciolire.
 */
import { LEGENDA, nomeBreve, type Pezzo, type Stato } from '../data/contenuti';
import { SOURCES } from '../data/sources';
import lockup from '../assets/brand/adobe-cx-enterprise-stacked.svg';
import ProdottoPop from './ProdottoPop.astro';
interface Props { pezzi: Pezzo[]; cede?: boolean; }
const { pezzi, cede = true } = Astro.props as Props;
/* Il prefisso «Adobe» lo dice già il marchio che apre la riga. */
const breve = nomeBreve;
const gruppi = (['avete', 'nuovo'] as Stato[])
  .map((stato) => ({ stato, voci: pezzi.filter((p) => p.stato === stato) }))
  .filter((g) => g.voci.length > 0);
const colonne = `minmax(0, 8rem) ${gruppi.map((g) => `minmax(0, ${g.voci.length}fr)`).join(' ')}`;
---
<div class:list={['tp-adobe', cede && 'tp-cede']} style={`grid-template-columns: ${colonne}`} data-reveal data-reveal-delay="0.18">
  <div class="tp-adobe-m">
    <img src={lockup.src} width={lockup.width} height={lockup.height} alt="Adobe CX Enterprise" />
  </div>
  {gruppi.map((g) => (
    <div class="tp-adobe-g">
      <p class="tp-adobe-k">{LEGENDA[g.stato].eti}</p>
      <ul class="tp-adobe-l" style={`--c:${g.voci.length}`}>
        {g.voci.map((p) => {
          const url = p.fonte ? (SOURCES[p.fonte] as { url?: string }).url : undefined;
          return (
            p.pop ? (
              <li class="tp-adobe-t" data-stato={g.stato} data-pop>
                <button type="button" class="tp-adobe-o" data-pp-open aria-haspopup="dialog" aria-label={`${breve(p.nome)}: guarda come funziona`}>
                  <span class="tp-adobe-p">{breve(p.nome)}</span>
                  <span class="tp-adobe-a">{p.a}</span>
                </button>
                <ProdottoPop scena={p.pop} />
              </li>
            ) : (
              <li class="tp-adobe-t" data-stato={g.stato}>
                <span class="tp-adobe-p">{url ? <a href={url} target="_blank" rel="noopener noreferrer">{breve(p.nome)}</a> : breve(p.nome)}</span>
                <span class="tp-adobe-a">{p.a}</span>
              </li>
            )
          );
        })}
      </ul>
    </div>
  ))}
</div>
