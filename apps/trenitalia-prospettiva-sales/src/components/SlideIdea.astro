---
/**
 * LA SLIDE DELL'IDEA — una per capitolo, nel registro XD.
 *
 * Una sola forma per tutte e quattro: il mockup a sinistra, a destra la
 * frase, la cifra e la referenza. Scritta una volta qui, così le quattro
 * non divergono — e quando la forma migliora, migliorano insieme.
 *
 * ⚠️ Questa slide si PROIETTA. Niente diagrammi piccoli, niente flusso
 * dati: quella è profondità e sta dietro «Scopri
 * come», nelle slide che seguono.
 */
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import MockIdea from './MockIdea.astro';
import { idea as trovaIdea, pezziDi, type Idea } from '../data/idee';
import Fascia from './Fascia.astro';

interface Props { slug: Idea['slug']; }
const { slug } = Astro.props as Props;
const i = trovaIdea(slug);
const pezzi = pezziDi(slug);
---
{/* Il credito è un fatto: solo le due schermate che portano una foto Firefly
    (provenance in `assets/generated/sole/`) lo dichiarano. */}
<Slide id="slide-idea" bg="primary" align="left"
  data-made-with={i.mock === 'viaggio' || i.mock === 'contenuto' ? 'Adobe Firefly' : undefined}
  data-made-with-for={i.mock === 'viaggio' || i.mock === 'contenuto' ? 'immagini' : undefined}>
  <div slot="backdrop" class="xd-bg-piano"></div>

  <div class="xd-sl xd-sl--fig" data-reveal>
    <div class="xd-sl-head">
      <p class="xd-n">{i.occhiello}</p>
      <h2 class="xd-h2">{i.titolo}</h2>
    </div>

    <div class="tp-idea">
      <div class="tp-idea-sx" data-reveal data-reveal-delay="0.1">
        <MockIdea variante={i.mock} />
      </div>

      {/* ⚠️ 9 nov 2026: la colonna destra si scopre a mano. Ogni box è un
          `data-substep`: ↓ ne fa entrare uno, ↑ lo ritira, → passa alla slide
          dopo. Chi parla decide quando si legge. Con «Riduci movimento» sono
          tutti visibili, ed è lo stato che i gate misurano. */}
      <div class="tp-idea-dx">
        <div class="tp-box" data-substep>
          <p class="tp-box-k">L’idea</p>
          <p class="tp-box-t">{i.chiusa}</p>
        </div>

        {/* Una cifra di norma, DUE quando il punto è il confronto: con una sola
            in evidenza il lato taciuto pesa meno, e su una slide di misura è
            proprio il confronto il fatto. `--cols` segue il numero di voci. */}
        <div class="tp-box" data-substep>
          <ul class="xd-num" style={`--cols:${(i.cifre ?? [i.cifra]).length}`}>
            {(i.cifre ?? [i.cifra]).map((c) => (
              <li class="xd-num-i">
                <span class="xd-num-k" data-display>{c.k}</span>
                <span class="xd-num-v">{c.v}</span>
              </li>
            ))}
          </ul>
        </div>

        {i.prova && (
          <div class="xd-ref" style="--cols:1" data-substep>
            <div class="xd-ref-b">
              <p class="xd-ref-n"><span class="xd-marchio--testo">{i.prova.chi}</span> · <span class="tp-ref-set">{i.prova.settore}</span></p>
              <p class="xd-ref-f">{i.prova.fatto}</p>
            </div>
          </div>
        )}
      </div>
    </div>

    {/* 9 nov 2026: i prodotti escono dal riquadro della colonna destra e diventano
        la striscia sotto l'idea, sempre visibile. Le capability restano sulla
        mappa di chiusura. */}
    <Fascia pezzi={pezzi} cede={false} />

    <p class="xd-fonte" data-reveal data-reveal-delay="0.34">
      {i.fonte}
      {i.prova && !i.prova.senzaRigaFonte && <> Fonte: <a href={i.prova.fonte.url} target="_blank" rel="noopener noreferrer">{i.prova.fonte.label}</a>, {i.prova.fonte.data.replace(/ /g, "\u00a0")}.</>}
    </p>
  </div>
</Slide>
