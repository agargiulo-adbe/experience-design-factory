---
/**
 * LA MAPPA DELLE QUATTRO IDEE — idea → capability → prodotti, su una pagina.
 *
 * PERCHÉ ESISTE. Dal dry run del 5 novembre 2026, ed è il rilievo che la
 * riunione ha ripetuto tre volte: «parliamo tantissimo e bene di quello che
 * loro hanno dichiarato, ma parliamo poco di noi — dove sta Adobe? Non l'ho
 * vista, siamo troppo sullo sfondo». La richiesta è un cappello che si vede
 * all'inizio e si richiude alla fine: queste sono le idee, queste le cose che
 * bisogna saper fare, questi i prodotti — e quali di quei prodotti sono già
 * loro.
 *
 * ⚠️ NON è un listino. I prodotti arrivano da `SERVE` in `contenuti.ts`, cioè
 * dalla lettura del contratto, e la pastiglia dice soltanto `già vostro` o
 * `si aggiunge`: nessun importo, nessuna quantità, nessuna scadenza. Il terzo
 * stato — «prezzo già fissato» — è uscito il 5 novembre perché l'accordo si
 * rinegozia e un prezzo di oggi non è un impegno per domani.
 *
 * In chiusura la stessa mappa torna con una TESTA diversa — annuncia la prima
 * volta, chiede la seconda. La differenza sta nella pagina, non qui: una
 * ripetizione identica rende meno di una ripresa.
 */
import { href } from '@edf/core/utils/url.js';
import { IDEE, pezziDi } from '../data/idee';
import { CHAPTERS } from '../data/chapters';
import PezziPerStato from './PezziPerStato.astro';
import { SOURCES } from '../data/sources';
import type { Pezzo } from '../data/contenuti';

interface Props {
  /** ⚠️ 6 nov 2026, SECONDO GIRO DEL PANEL, ed è l'obiezione che per
   *  l'arbitro affondava il documento: nel taglio corto — «quello che gira di
   *  più», letto senza nessuno accanto — questa mappa rendeva una griglia di
   *  TREDICI nomi di prodotto Adobe, con «Real-Time Collaboration» sotto
   *  «si aggiunge», subito prima della richiesta. Cinque personas su sei: così
   *  si legge come un catalogo, e come uno strato di dato cliente proposto
   *  sopra quello che il Gruppo ha annunciato a marzo.
   *  Con `soloCapability` restano le quattro idee e che cosa bisogna saper
   *  fare. L'elenco dei prodotti sta nel percorso intero, dove c'è chi lo
   *  apre e lo spiega. */
  soloCapability?: boolean;
  /** Senza le capability: dentro il drill-down della mappa lo strato risponde
   *  a «con che cosa si fanno», e le capability sono già dette sulla slide di
   *  ciascuna idea. Tenerle qui costava tre righe per colonna e a 1280×800
   *  portava il blocco aperto fuori dalla safe-area — check `c` dentro `exp`,
   *  che è HARD, misurato il 6 novembre 2026. */
  soloPezzi?: boolean;
}
const { soloPezzi = false, soloCapability = false } = Astro.props as Props;
const corto = (slug: string) => CHAPTERS.find((c) => c.slug === slug)!;

/* 9 nov 2026, review: quattro colonne di elenchi facevano muro. In tabella ogni
   idea è una riga e i prodotti stanno su due sole colonne. Il prefisso «Adobe»
   si toglie perché lo dice già l'intestazione. */
const breve = (n: string) => n === 'LLM Apps, dentro Adobe Experience Manager' ? 'LLM Apps' : n.replace(/^Adobe /, '').replace(/,\s*con\s+/, ' con ');
const link = (p: Pezzo) => (p.fonte ? SOURCES[p.fonte].url : undefined);
---
{/* 9 nov 2026: niente più tabella su pannello bianco, che sembrava incollata. Le quattro
    idee sono un percorso: lo stesso binario numerato della roadmap. */}
{!soloCapability && (
  <div class="tp-rt-w">
    <ol class="tp-rt" data-capability={soloPezzi ? undefined : ''}>
      {IDEE.map((i, n) => (
        <li>
          <span class="tp-rt-n" aria-hidden="true">{n + 1}</span>
          <a class="tp-rt-t" href={href(import.meta.env.BASE_URL, '/' + i.slug)}>{corto(i.slug).short}</a>
          {!soloPezzi && <p class="tp-rt-c">{i.capability.map((c, k) => (k ? c[0].toLowerCase() + c.slice(1) : c)).join('; ')}</p>}
          {(['avete', 'nuovo'] as const).map((st) => (
            <ul class="tp-rt-g" data-stato={st} aria-label={st === 'avete' ? 'Già vostri' : 'Da aggiungere'}>
              {pezziDi(i.slug).filter((p) => p.stato === st).map((p) => (
                <li>{link(p) ? <a href={link(p)} target="_blank" rel="noopener noreferrer">{breve(p.nome)}</a> : breve(p.nome)}</li>
              ))}
            </ul>
          ))}
        </li>
      ))}
    </ol>
    <p class="tp-rt-leg"><span data-stato="avete">Prodotti Adobe già vostri</span><span data-stato="nuovo">Prodotti Adobe da aggiungere</span></p>
  </div>
)}
{soloCapability && (
<ol class="tp-mi" data-stagger="0.08">
  {IDEE.map((i) => {
    const ch = corto(i.slug);
    return (
      <li class="tp-mi-i">
        <p class="tp-mi-n">{ch.num}</p>
        <p class="tp-mi-t">{ch.short}</p>
        {!soloPezzi && (
          <ul class="tp-mi-cap">
            {i.capability.map((c) => <li>{c}</li>)}
          </ul>
        )}
        {/* Il numero che guarderemmo insieme: solo dove la mappa si proietta,
            cioè in chiusura. Dentro il drill-down della slide della mappa
            costerebbe altezza a un blocco che a 1280×800 è già al limite
            (check `c` dentro `exp`, HARD). */}
        {!soloPezzi && <p class="tp-mi-mis">{i.misura}</p>}
        {!soloCapability && <PezziPerStato pezzi={pezziDi(i.slug)} />}
      </li>
    );
  })}
</ol>
)}
