---
import BaseLayout from '../layouts/BaseLayout.astro';
import EniNavigation from '../components/EniNavigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import { href } from '@edf/core/utils/url.js';

const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;

type Mossa = 'espandere' | 'consolidare' | 'entrare' | 'presidiare';

interface Orbita {
  nome: string;
  ambito: string;
  mossa: Mossa;
  play: string;
}

const cuore: Orbita[] = [
  {
    nome: 'Eni SpA',
    ambito: 'capogruppo · Eni.com',
    mossa: 'consolidare',
    play: 'La casa dei tre cantieri aperti: voce nei motori AI, concierge, fondazione tecnica del portale. Da qui si governa il resto.',
  },
  {
    nome: 'Plenitude',
    ambito: 'energia retail · B2C',
    mossa: 'espandere',
    play: 'La società più avanti sull\'esperienza digitale: il passo naturale è misurare e orchestrare i journey sopra ciò che già usa.',
  },
  {
    nome: 'Enilive',
    ambito: 'mobilità · B2C',
    mossa: 'entrare',
    play: 'L\'ingresso passa dal programma fedeltà di famiglia e dall\'Account Unico, in convivenza con lo stack che la società ha scelto.',
  },
];

const altre: Orbita[] = [
  {
    nome: 'Versalis',
    ambito: 'chimica · B2B',
    mossa: 'entrare',
    play: 'Cataloghi prodotto, schede tecniche, concierge per i buyer: l\'esperienza B2B dove il sito istituzionale già c\'è.',
  },
  {
    nome: 'Global Energy Markets · Trade & Biofuels',
    ambito: 'trading · B2B',
    mossa: 'entrare',
    play: 'Onboarding controparti e documenti: firme e moduli intelligenti prima ancora del marketing.',
  },
  {
    nome: 'AGI',
    ambito: 'agenzia di stampa',
    mossa: 'entrare',
    play: 'Credenziali di provenienza sui contenuti e strumenti di creazione per la redazione: il caso di punta della fiducia verificabile.',
  },
  {
    nome: 'Corporate University · eniservizi · Banque Eni',
    ambito: 'servizi interni e regolati',
    mossa: 'entrare',
    play: 'Creatività diffusa e documenti: bisogni concreti, ingressi rapidi, nessun grande progetto da giustificare.',
  },
  {
    nome: 'Vår Energi · Azule · Ithaca',
    ambito: 'partecipate internazionali',
    mossa: 'presidiare',
    play: 'Comunicazione corporate e strumenti comuni quando servono: nessuna forzatura, la porta resta aperta.',
  },
];
---
<BaseLayout
  title="La mappa"
  description="Tutte le società del gruppo Eni, ognuna con la propria mossa: espandere, consolidare, entrare, presidiare. Eni × Adobe."
>
  <div class="fixed top-0 left-0 right-0 z-50">
    <EniNavigation currentPath={currentPath} base={base} />
  </div>

  <DeckContainer nextHref={href(base, '/persone')} prevHref={href(base, '/traiettorie')}>

    <!-- ── SLIDE 0: Cover ─────────────────────────────────────────── -->
    <Slide id="slide-cover" bg="primary" align="center">
      <div slot="backdrop" class="eo-bg"></div>
      <p class="slide-eyebrow text-center text-[var(--accent-primary)] mb-4" data-reveal>
        CAPITOLO 04 · LA MAPPA
      </p>
      <h2
        class="text-[var(--ink-primary)] mb-4 font-[family-name:var(--font-display)] text-center mx-auto"
        style="font-size: clamp(2.1rem, 3.8vw, 3.6rem); font-weight: 600; line-height: 1.06; letter-spacing: -0.02em; max-width: 18ch;"
        data-reveal
        data-reveal-delay="0.08"
      >
        Un gruppo, tante orbite
      </h2>
      <p
        class="text-[var(--ink-secondary)] leading-normal max-w-2xl mx-auto text-center mb-6"
        style="font-size: clamp(1.05rem, 1.3vw, 1.3rem);"
        data-reveal
        data-reveal-delay="0.15"
      >
        Il perimetro è tutto il gruppo, ma non con la stessa mossa ovunque. Ogni società ha la
        sua: quattro verbi, scelti in base a cosa c'è già e a cosa manca.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-3" data-reveal data-reveal-delay="0.22">
        <span class="eo-move eo-move--espandere">Espandere</span>
        <span class="eo-move eo-move--consolidare">Consolidare</span>
        <span class="eo-move eo-move--entrare">Entrare</span>
        <span class="eo-move eo-move--presidiare">Presidiare</span>
      </div>
    </Slide>

    <!-- ── SLIDE 1: Il cuore ──────────────────────────────────────── -->
    <Slide id="slide-cuore" bg="primary" align="center">
      <div slot="backdrop" class="eo-bg-soft"></div>
      <p class="slide-eyebrow text-center text-[var(--accent-primary)] mb-4" data-reveal>
        LE ORBITE INTERNE
      </p>
      <h2
        class="text-[var(--ink-primary)] mb-4 font-[family-name:var(--font-display)] text-center mx-auto"
        style="font-size: clamp(1.9rem, 3vw, 2.8rem); font-weight: 600; line-height: 1.07; letter-spacing: -0.02em; max-width: 26ch;"
        data-reveal
        data-reveal-delay="0.08"
      >
        Capogruppo e brand consumer
      </h2>

      <div class="w-full max-w-5xl mx-auto flex flex-col" data-reveal data-reveal-delay="0.16">
        {cuore.map((o) => (
          <div class="eo-row" style="grid-template-columns: 16rem 1fr;">
            <div>
              <p class="eo-row-label">{o.nome}</p>
              <p class="eo-row-sub">{o.ambito}</p>
              <span class={`eo-move eo-move--${o.mossa} mt-2`}>{o.mossa}</span>
            </div>
            <p class="eo-row-body self-center">{o.play}</p>
          </div>
        ))}
      </div>
    </Slide>

    <!-- ── SLIDE 2: Le altre orbite ───────────────────────────────── -->
    <Slide id="slide-altre" bg="primary" align="center">
      <div slot="backdrop" class="eo-bg-soft"></div>
      <p class="slide-eyebrow text-center text-[var(--accent-primary)] mb-4" data-reveal>
        LE ORBITE ESTERNE
      </p>
      <h2
        class="text-[var(--ink-primary)] mb-4 font-[family-name:var(--font-display)] text-center mx-auto"
        style="font-size: clamp(1.9rem, 3vw, 2.8rem); font-weight: 600; line-height: 1.07; letter-spacing: -0.02em; max-width: 26ch;"
        data-reveal
        data-reveal-delay="0.08"
      >
        Dove nessuno è mai entrato
      </h2>

      <div class="w-full max-w-6xl mx-auto grid md:grid-cols-2 gap-3" data-reveal data-reveal-delay="0.16">
        {altre.map((o) => (
          <div class="eo-card" style="padding: 1rem 1.25rem 0.95rem;">
            <div class="flex items-baseline justify-between gap-3 mb-0.5 min-w-0">
              <p class="eo-card-title" style="margin-bottom: 0;">{o.nome}</p>
              <span class={`eo-move eo-move--${o.mossa}`}>{o.mossa}</span>
            </div>
            <p class="eo-row-sub mb-1.5">{o.ambito}</p>
            <p class="eo-card-body">{o.play}</p>
          </div>
        ))}
        <div class="eo-card justify-center" style="padding: 1rem 1.25rem 0.95rem; background: rgba(255,206,0,0.07); border-color: rgba(255,206,0,0.35);">
          <p class="eo-card-body" style="color: var(--color-grigio-100);">
            Per molte di queste società il primo passo è piccolo: creatività o documenti, con
            la capogruppo a fare da garante e da catalogo.
          </p>
        </div>
      </div>
    </Slide>

  </DeckContainer>
</BaseLayout>
