---
import BaseLayout from '../layouts/BaseLayout.astro';
import EniNavigation from '../components/EniNavigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import T from '@edf/core/blocks/i18n/T.astro';
import { href } from '@edf/core/utils/url.js';

const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;

const catalogo = [
  { tIt: 'Contenuti',      tEn: 'Content',           bIt: 'Siti e portali veloci, un patrimonio di asset unico e riusabile da ogni società.', bEn: 'Fast sites and portals, one asset estate every company can reuse.' },
  { tIt: 'Creatività',     tEn: 'Creativity',        bIt: 'Produzione visiva on-brand, dalla creatività professionale a quella diffusa nei team.', bEn: 'On-brand visual production, from professional creative work to everyday team creation.' },
  { tIt: 'Journey e dati', tEn: 'Journeys and data', bIt: 'Identità del cliente, segmenti e orchestrazione dei percorsi su tutti i canali.', bEn: 'Customer identity, segments and journey orchestration across every channel.' },
  { tIt: 'Intelligenza',   tEn: 'Intelligence',      bIt: 'Misura di cosa funziona: contenuti, journey, presenza nelle risposte dei motori AI.', bEn: 'Measuring what works: content, journeys, presence in AI-engine answers.' },
  { tIt: 'Documenti',      tEn: 'Documents',         bIt: 'Contratti, moduli e firme: il lato documentale dell\'esperienza, spesso dimenticato.', bEn: 'Contracts, forms and signatures: the document side of experience, often forgotten.' },
  { tIt: 'Agenti',         tEn: 'Agents',            bIt: 'Assistenti conversazionali on-brand e agenti che eseguono lavoro operativo.', bEn: 'On-brand conversational assistants and agents that carry out operational work.' },
];

const principio = [
  { num: '1', tIt: 'Il centro definisce i guardrail', tEn: 'The centre sets the guardrails', bIt: 'Brand, compliance, dati e identità vivono in un solo posto. Chi governa decide una volta, per tutti.', bEn: 'Brand, compliance, data and identity live in one place. Whoever governs decides once, for everyone.' },
  { num: '2', tIt: 'Le società consumano a catalogo', tEn: 'Companies consume from a catalogue', bIt: 'Ogni satellite prende i servizi che gli servono, con i suoi tempi e dentro i binari del gruppo.', bEn: 'Each satellite takes the services it needs, at its own pace and inside the group\'s rails.' },
  { num: '3', tIt: 'Il gruppo impara da ogni orbita', tEn: 'The group learns from every orbit', bIt: 'Quello che una società misura e scopre torna al centro, e migliora il servizio per tutte le altre.', bEn: 'What one company measures and discovers flows back to the centre, and improves the service for all the others.' },
];
---
<BaseLayout
  title="La piattaforma"
  description="L'esperienza e i contenuti come servizio di gruppo, sul modello del Green Data Center. Eni × Adobe."
>
  <div class="fixed top-0 left-0 right-0 z-50">
    <EniNavigation currentPath={currentPath} base={base} />
  </div>

  <DeckContainer nextHref={href(base, '/traiettorie')} prevHref={href(base, '/domanda')}>

    <!-- ── SLIDE 0: Cover ─────────────────────────────────────────── -->
    <Slide id="slide-cover" bg="primary" align="center">
      <div slot="backdrop" class="eo-bg"></div>
      <T
        as="p"
        class="slide-eyebrow text-center text-[var(--accent-primary)] mb-4 block"
        data-reveal
        it="CAPITOLO 02 · LA PIATTAFORMA"
        en="CHAPTER 02 · THE PLATFORM"
      />
      <T
        as="h2"
        class="text-[var(--ink-primary)] mb-4 font-[family-name:var(--font-display)] text-center mx-auto block"
        style="font-size: clamp(2.1rem, 3.8vw, 3.6rem); font-weight: 600; line-height: 1.06; letter-spacing: -0.02em; max-width: 20ch;"
        data-reveal
        data-reveal-delay="0.08"
        it="Avete fatto del calcolo un servizio"
        en="You turned compute into a service"
      />
      <T
        as="p"
        class="text-[var(--ink-secondary)] leading-normal max-w-2xl mx-auto text-center block"
        style="font-size: clamp(1.05rem, 1.3vw, 1.3rem);"
        data-reveal
        data-reveal-delay="0.15"
        it="A luglio il Green Data Center ha aperto le porte: capacità, competenze e strumenti AI erogati a imprese e centri di ricerca su progetti condivisi. La proposta di oggi applica lo stesso schema a un altro asset del gruppo: l'esperienza di chi entra in contatto con i vostri brand."
        en="In July the Green Data Center opened its doors: compute, skills and AI tools delivered to companies and research centres on shared projects. Today's proposal applies the same scheme to another group asset: the experience of everyone who comes into contact with your brands."
      />
    </Slide>

    <!-- ── SLIDE 1: Lo specchio ───────────────────────────────────── -->
    <Slide id="slide-specchio" bg="primary" align="center">
      <div slot="backdrop" class="eo-bg-soft"></div>
      <T
        as="p"
        class="slide-eyebrow text-center text-[var(--accent-primary)] mb-4 block"
        data-reveal
        it="LO STESSO SCHEMA, UN ALTRO ASSET"
        en="THE SAME SCHEME, ANOTHER ASSET"
      />
      <h2
        class="text-[var(--ink-primary)] mb-4 font-[family-name:var(--font-display)] text-center mx-auto"
        style="font-size: clamp(1.9rem, 3vw, 2.8rem); font-weight: 600; line-height: 1.07; letter-spacing: -0.02em; max-width: 26ch;"
        data-reveal
        data-reveal-delay="0.08"
      >
        Experience &amp; Content as a Service
      </h2>

      <div class="w-full max-w-5xl mx-auto grid md:grid-cols-2 gap-5" data-reveal data-reveal-delay="0.18">
        <div class="eo-panel eo-panel--giallo">
          <div class="eo-panel-head">
            <T as="span" class="eo-tag" it="Già fatto · il calcolo" en="Done · compute" />
          </div>
          <T
            as="p"
            class="eo-panel-body mb-3 block"
            it="Il Green Data Center eroga supercalcolo, competenze e servizi AI. Non vende ore macchina: costruisce progetti di comune interesse con chi bussa."
            en="The Green Data Center delivers supercomputing, skills and AI services. It doesn't sell machine hours: it builds projects of shared interest with whoever knocks."
          />
          <T as="p" class="eo-src block" it="Eni, comunicato 28 luglio 2026" en="Eni, press release July 28, 2026" />
        </div>
        <div class="eo-panel eo-panel--orbita">
          <div class="eo-panel-head">
            <T as="span" class="eo-tag eo-tag--orbita" it="Da fare · l'esperienza" en="To do · experience" />
          </div>
          <T
            as="p"
            class="eo-panel-body mb-3 block"
            it="Il Digital &amp; IT eroga alle società del gruppo un catalogo di servizi di esperienza e contenuti: governati al centro, consumati da ogni orbita con i propri tempi. Stessa logica, rivolta all'interno."
            en="Digital &amp; IT delivers the group companies a catalogue of experience and content services: governed at the centre, consumed by each orbit at its own pace. The same logic, turned inwards."
          />
          <T as="p" class="eo-src block" it="La proposta di questo incontro" en="The proposal of this meeting" />
        </div>
      </div>

      <T
        as="p"
        class="mt-6 text-center text-[var(--ink-secondary)] max-w-2xl mx-auto block"
        style="font-size: clamp(0.95rem, 1.1vw, 1.1rem);"
        data-reveal
        data-reveal-delay="0.28"
        it="Chi sa erogare il calcolo come servizio ha già la cultura per erogare così anche l'esperienza. Manca solo il catalogo."
        en="Whoever can deliver compute as a service already has the culture to deliver experience the same way. Only the catalogue is missing."
      />
    </Slide>

    <!-- ── SLIDE 2: Il catalogo ───────────────────────────────────── -->
    <Slide id="slide-catalogo" bg="primary" align="center">
      <div slot="backdrop" class="eo-bg"></div>
      <T
        as="p"
        class="slide-eyebrow text-center text-[var(--accent-primary)] mb-4 block"
        data-reveal
        it="UNA SOLA ADOBE"
        en="ONE ADOBE"
      />
      <T
        as="h2"
        class="text-[var(--ink-primary)] mb-4 font-[family-name:var(--font-display)] text-center mx-auto block"
        style="font-size: clamp(1.9rem, 3vw, 2.8rem); font-weight: 600; line-height: 1.07; letter-spacing: -0.02em; max-width: 24ch;"
        data-reveal
        data-reveal-delay="0.08"
        it="Sei famiglie di servizi, un catalogo"
        en="Six service families, one catalogue"
      />
      <T
        as="p"
        class="text-[var(--ink-secondary)] max-w-2xl mx-auto mb-6 text-center block"
        style="font-size: clamp(0.95rem, 1.1vw, 1.1rem);"
        data-reveal
        data-reveal-delay="0.14"
        it="Esperienza digitale e creatività di solito arrivano da fornitori diversi. Qui arrivano insieme, perché nel lavoro vero sono la stessa catena: chi crea un contenuto è a tre passi da chi lo pubblica e da chi ne misura l'effetto."
        en="Digital experience and creativity usually come from different vendors. Here they come together, because in real work they are one chain: whoever creates a piece of content sits three steps from whoever publishes it and whoever measures its effect."
      />

      <div class="w-full max-w-6xl mx-auto grid grid-cols-2 md:grid-cols-3 gap-4" data-reveal data-reveal-delay="0.2">
        {catalogo.map((c, i) => (
          <div class="eo-card">
            <span class={`eo-mark ${i % 2 === 1 ? 'eo-mark--orbita' : ''}`} aria-hidden="true">{i + 1}</span>
            <T as="p" class="eo-card-title block" it={c.tIt} en={c.tEn} />
            <T as="p" class="eo-card-body block" it={c.bIt} en={c.bEn} />
          </div>
        ))}
      </div>
    </Slide>

    <!-- ── SLIDE 3: Il principio ──────────────────────────────────── -->
    <Slide id="slide-principio" bg="primary" align="center">
      <div slot="backdrop" class="eo-bg-soft"></div>
      <T
        as="p"
        class="slide-eyebrow text-center text-[var(--accent-primary)] mb-4 block"
        data-reveal
        it="COME FUNZIONA"
        en="HOW IT WORKS"
      />
      <T
        as="h2"
        class="text-[var(--ink-primary)] mb-4 font-[family-name:var(--font-display)] text-center mx-auto block"
        style="font-size: clamp(1.9rem, 3vw, 2.8rem); font-weight: 600; line-height: 1.07; letter-spacing: -0.02em; max-width: 24ch;"
        data-reveal
        data-reveal-delay="0.08"
        it="Governo al centro, consumo in orbita"
        en="Governed at the centre, consumed in orbit"
      />

      <div class="w-full max-w-4xl mx-auto flex flex-col" data-reveal data-reveal-delay="0.18">
        {principio.map((p) => (
          <div class="eo-row">
            <div>
              <span class="eo-mark" aria-hidden="true">{p.num}</span>
            </div>
            <div class="eo-row-body">
              <T
                as="p"
                class="font-[family-name:var(--font-display)] font-semibold text-[var(--ink-primary)] mb-1 block"
                style="font-size: clamp(1.1rem, 1.5vw, 1.4rem); line-height: 1.25;"
                it={p.tIt}
                en={p.tEn}
              />
              <T as="p" class="text-[0.98rem] leading-normal text-[var(--color-grigio-200)] block" it={p.bIt} en={p.bEn} />
            </div>
          </div>
        ))}
      </div>

      <T
        as="p"
        class="mt-6 text-center text-[var(--ink-secondary)] max-w-2xl mx-auto block"
        style="font-size: clamp(0.95rem, 1.1vw, 1.1rem);"
        data-reveal
        data-reveal-delay="0.28"
        it="Nessuna società deve rifare da capo ciò che un'altra ha già pagato con tempo ed errori. È questo il rendimento di una piattaforma di gruppo."
        en="No company should redo from scratch what another has already paid for in time and mistakes. That is the return on a group platform."
      />
    </Slide>

  </DeckContainer>
</BaseLayout>
