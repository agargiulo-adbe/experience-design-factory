---
import BaseLayout from '../layouts/BaseLayout.astro';
import EniNavigation from '../components/EniNavigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import { href } from '@edf/core/utils/url.js';

const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;

const catalogo = [
  { title: 'Contenuti',        body: 'Siti e portali veloci, un patrimonio di asset unico e riusabile da ogni società.' },
  { title: 'Creatività',       body: 'Produzione visiva on-brand, dalla creatività professionale a quella diffusa nei team.' },
  { title: 'Journey e dati',   body: 'Identità del cliente, segmenti e orchestrazione dei percorsi su tutti i canali.' },
  { title: 'Intelligenza',     body: 'Misura di cosa funziona: contenuti, journey, presenza nelle risposte dei motori AI.' },
  { title: 'Documenti',        body: 'Contratti, moduli e firme: il lato documentale dell\'esperienza, spesso dimenticato.' },
  { title: 'Agenti',           body: 'Assistenti conversazionali on-brand e agenti che eseguono lavoro operativo.' },
];

const principio = [
  { num: '1', title: 'Il centro definisce i guardrail', body: 'Brand, compliance, dati e identità vivono in un solo posto. Chi governa decide una volta, per tutti.' },
  { num: '2', title: 'Le società consumano a catalogo', body: 'Ogni satellite prende i servizi che gli servono, con i suoi tempi e dentro i binari del gruppo.' },
  { num: '3', title: 'Il gruppo impara da ogni orbita', body: 'Quello che una società misura e scopre torna al centro, e migliora il servizio per tutte le altre.' },
];
---
<BaseLayout
  title="La piattaforma"
  description="L'esperienza e i contenuti come servizio di gruppo, sul modello del Green Data Center. Eni × Adobe."
>
  <div class="fixed top-0 left-0 right-0 z-50">
    <EniNavigation currentPath={currentPath} base={base} />
  </div>

  <DeckContainer nextHref={href(base, '/traiettorie')} prevHref={href(base, '/domanda')}>

    <!-- ── SLIDE 0: Cover ─────────────────────────────────────────── -->
    <Slide id="slide-cover" bg="primary" align="center">
      <div slot="backdrop" class="eo-bg"></div>
      <p class="slide-eyebrow text-center text-[var(--accent-primary)] mb-4" data-reveal>
        CAPITOLO 02 · LA PIATTAFORMA
      </p>
      <h2
        class="text-[var(--ink-primary)] mb-4 font-[family-name:var(--font-display)] text-center mx-auto"
        style="font-size: clamp(2.1rem, 3.8vw, 3.6rem); font-weight: 600; line-height: 1.06; letter-spacing: -0.02em; max-width: 20ch;"
        data-reveal
        data-reveal-delay="0.08"
      >
        Avete fatto del calcolo un servizio
      </h2>
      <p
        class="text-[var(--ink-secondary)] leading-normal max-w-2xl mx-auto text-center"
        style="font-size: clamp(1.05rem, 1.3vw, 1.3rem);"
        data-reveal
        data-reveal-delay="0.15"
      >
        A luglio il Green Data Center ha aperto le porte: capacità, competenze e strumenti AI
        erogati a imprese e centri di ricerca su progetti condivisi. La proposta di oggi applica
        lo stesso schema a un altro asset del gruppo: l'esperienza di chi entra in contatto con
        i vostri brand.
      </p>
    </Slide>

    <!-- ── SLIDE 1: Lo specchio ───────────────────────────────────── -->
    <Slide id="slide-specchio" bg="primary" align="center">
      <div slot="backdrop" class="eo-bg-soft"></div>
      <p class="slide-eyebrow text-center text-[var(--accent-primary)] mb-4" data-reveal>
        LO STESSO SCHEMA, UN ALTRO ASSET
      </p>
      <h2
        class="text-[var(--ink-primary)] mb-4 font-[family-name:var(--font-display)] text-center mx-auto"
        style="font-size: clamp(1.9rem, 3vw, 2.8rem); font-weight: 600; line-height: 1.07; letter-spacing: -0.02em; max-width: 26ch;"
        data-reveal
        data-reveal-delay="0.08"
      >
        Experience &amp; Content as a Service
      </h2>

      <div class="w-full max-w-5xl mx-auto grid md:grid-cols-2 gap-5" data-reveal data-reveal-delay="0.18">
        <div class="eo-panel eo-panel--giallo">
          <div class="eo-panel-head">
            <span class="eo-tag">Già fatto · il calcolo</span>
          </div>
          <p class="eo-panel-body mb-3">
            Il Green Data Center eroga supercalcolo, competenze e servizi AI. Non vende ore
            macchina: costruisce progetti di comune interesse con chi bussa.
          </p>
          <p class="eo-src">Eni, comunicato 28 luglio 2026</p>
        </div>
        <div class="eo-panel eo-panel--orbita">
          <div class="eo-panel-head">
            <span class="eo-tag eo-tag--orbita">Da fare · l'esperienza</span>
          </div>
          <p class="eo-panel-body mb-3">
            Il Digital &amp; IT eroga alle società del gruppo un catalogo di servizi di
            esperienza e contenuti: governati al centro, consumati da ogni orbita con i propri
            tempi. Stessa logica, rivolta all'interno.
          </p>
          <p class="eo-src">La proposta di questo incontro</p>
        </div>
      </div>

      <p
        class="mt-6 text-center text-[var(--ink-secondary)] max-w-2xl mx-auto"
        style="font-size: clamp(0.95rem, 1.1vw, 1.1rem);"
        data-reveal
        data-reveal-delay="0.28"
      >
        Chi sa erogare il calcolo come servizio ha già la cultura per erogare così anche
        l'esperienza. Manca solo il catalogo.
      </p>
    </Slide>

    <!-- ── SLIDE 2: Il catalogo ───────────────────────────────────── -->
    <Slide id="slide-catalogo" bg="primary" align="center">
      <div slot="backdrop" class="eo-bg"></div>
      <p class="slide-eyebrow text-center text-[var(--accent-primary)] mb-4" data-reveal>
        UNA SOLA ADOBE
      </p>
      <h2
        class="text-[var(--ink-primary)] mb-4 font-[family-name:var(--font-display)] text-center mx-auto"
        style="font-size: clamp(1.9rem, 3vw, 2.8rem); font-weight: 600; line-height: 1.07; letter-spacing: -0.02em; max-width: 24ch;"
        data-reveal
        data-reveal-delay="0.08"
      >
        Sei famiglie di servizi, un catalogo
      </h2>
      <p
        class="text-[var(--ink-secondary)] max-w-2xl mx-auto mb-6 text-center"
        style="font-size: clamp(0.95rem, 1.1vw, 1.1rem);"
        data-reveal
        data-reveal-delay="0.14"
      >
        Esperienza digitale e creatività di solito arrivano da fornitori diversi. Qui arrivano
        insieme, perché nel lavoro vero sono la stessa catena: chi crea un contenuto è a tre
        passi da chi lo pubblica e da chi ne misura l'effetto.
      </p>

      <div class="w-full max-w-6xl mx-auto grid grid-cols-2 md:grid-cols-3 gap-4" data-reveal data-reveal-delay="0.2">
        {catalogo.map((c, i) => (
          <div class="eo-card">
            <span class={`eo-mark ${i % 2 === 1 ? 'eo-mark--orbita' : ''}`} aria-hidden="true">{i + 1}</span>
            <p class="eo-card-title">{c.title}</p>
            <p class="eo-card-body">{c.body}</p>
          </div>
        ))}
      </div>
    </Slide>

    <!-- ── SLIDE 3: Il principio ──────────────────────────────────── -->
    <Slide id="slide-principio" bg="primary" align="center">
      <div slot="backdrop" class="eo-bg-soft"></div>
      <p class="slide-eyebrow text-center text-[var(--accent-primary)] mb-4" data-reveal>
        COME FUNZIONA
      </p>
      <h2
        class="text-[var(--ink-primary)] mb-4 font-[family-name:var(--font-display)] text-center mx-auto"
        style="font-size: clamp(1.9rem, 3vw, 2.8rem); font-weight: 600; line-height: 1.07; letter-spacing: -0.02em; max-width: 24ch;"
        data-reveal
        data-reveal-delay="0.08"
      >
        Governo al centro, consumo in orbita
      </h2>

      <div class="w-full max-w-4xl mx-auto flex flex-col" data-reveal data-reveal-delay="0.18">
        {principio.map((p) => (
          <div class="eo-row">
            <div>
              <span class="eo-mark" aria-hidden="true">{p.num}</span>
            </div>
            <div class="eo-row-body">
              <p class="font-[family-name:var(--font-display)] font-semibold text-[var(--ink-primary)] mb-1" style="font-size: clamp(1.1rem, 1.5vw, 1.4rem); line-height: 1.25;">
                {p.title}
              </p>
              <p class="text-[0.98rem] leading-normal text-[var(--color-grigio-200)]">{p.body}</p>
            </div>
          </div>
        ))}
      </div>

      <p
        class="mt-6 text-center text-[var(--ink-secondary)] max-w-2xl mx-auto"
        style="font-size: clamp(0.95rem, 1.1vw, 1.1rem);"
        data-reveal
        data-reveal-delay="0.28"
      >
        Nessuna società deve rifare da capo ciò che un'altra ha già pagato con tempo ed errori.
        È questo il rendimento di una piattaforma di gruppo.
      </p>
    </Slide>

  </DeckContainer>
</BaseLayout>
