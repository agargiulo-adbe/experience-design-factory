---
import BaseLayout from '../layouts/BaseLayout.astro';
import EniNavigation from '../components/EniNavigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import { href } from '@edf/core/utils/url.js';

const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;

const modello = [
  {
    num: '1',
    title: 'Competenze prima delle licenze',
    body: 'Ogni servizio del catalogo arriva con un percorso di abilitazione per chi lo userà: formazione sul caso reale, non sul manuale. L\'obiettivo è che i team del gruppo sappiano fare da soli.',
  },
  {
    num: '2',
    title: 'Operating model prima della tecnologia',
    body: 'Chi approva cosa, chi crea cosa, chi misura cosa: le regole del gioco tra centro e società si disegnano prima di accendere gli strumenti. È lavoro di organizzazione, e lo trattiamo come tale.',
  },
  {
    num: '3',
    title: 'Valore misurato, sempre',
    body: 'Ogni cantiere parte con un numero di riferimento e una data di verifica. Quello che non si riesce a misurare non si propone.',
  },
];
---
<BaseLayout
  title="Le persone"
  description="Competenze prima degli strumenti: il modello di adozione per il gruppo. Eni × Adobe."
>
  <div class="fixed top-0 left-0 right-0 z-50">
    <EniNavigation currentPath={currentPath} base={base} />
  </div>

  <DeckContainer nextHref={href(base, '/rotta')} prevHref={href(base, '/mappa')}>

    <!-- ── SLIDE 0: Cover — la citazione ──────────────────────────── -->
    <Slide id="slide-cover" bg="primary" align="center" data-display>
      <div slot="backdrop" class="eo-bg"></div>
      <p class="slide-eyebrow text-center text-[var(--accent-primary)] mb-6" data-reveal>
        CAPITOLO 05 · LE PERSONE
      </p>
      <blockquote class="max-w-4xl mx-auto text-center" data-reveal data-reveal-delay="0.08">
        <p
          class="font-[family-name:var(--font-display)] text-[var(--ink-primary)]"
          style="font-size: clamp(1.6rem, 2.8vw, 2.6rem); font-weight: 600; line-height: 1.22; letter-spacing: -0.015em;"
        >
          «Il vantaggio nasce dall'investimento nelle competenze delle nostre persone,
          non solo negli strumenti tecnologici.»
        </p>
        <footer class="mt-5 text-[0.85rem] tracking-widest uppercase text-[var(--color-grigio-300)]">
          Costantino Chessa · Head of Global Digital &amp; IT, Eni · PoliS-Lombardia, aprile 2026
        </footer>
      </blockquote>
      <p
        class="mt-7 text-center text-[var(--ink-secondary)] max-w-2xl mx-auto"
        style="font-size: clamp(1rem, 1.2vw, 1.2rem);"
        data-reveal
        data-reveal-delay="0.18"
      >
        Siamo d'accordo. E vogliamo essere giudicati su questo, prima che sulla tecnologia.
      </p>
    </Slide>

    <!-- ── SLIDE 1: Il modello ────────────────────────────────────── -->
    <Slide id="slide-modello" bg="primary" align="center">
      <div slot="backdrop" class="eo-bg-soft"></div>
      <p class="slide-eyebrow text-center text-[var(--accent-primary)] mb-4" data-reveal>
        IL MODELLO DI ADOZIONE
      </p>
      <h2
        class="text-[var(--ink-primary)] mb-4 font-[family-name:var(--font-display)] text-center mx-auto"
        style="font-size: clamp(1.9rem, 3vw, 2.8rem); font-weight: 600; line-height: 1.07; letter-spacing: -0.02em; max-width: 24ch;"
        data-reveal
        data-reveal-delay="0.08"
      >
        Tre impegni, presi adesso
      </h2>

      <div class="w-full max-w-4xl mx-auto flex flex-col" data-reveal data-reveal-delay="0.16">
        {modello.map((m) => (
          <div class="eo-row">
            <div>
              <span class="eo-mark" aria-hidden="true">{m.num}</span>
            </div>
            <div class="eo-row-body">
              <p class="font-[family-name:var(--font-display)] font-semibold text-[var(--ink-primary)] mb-1" style="font-size: clamp(1.1rem, 1.5vw, 1.4rem); line-height: 1.25;">
                {m.title}
              </p>
              <p class="text-[0.98rem] leading-normal text-[var(--color-grigio-200)]">{m.body}</p>
            </div>
          </div>
        ))}
      </div>
    </Slide>

    <!-- ── SLIDE 2: La community ──────────────────────────────────── -->
    <Slide id="slide-community" bg="primary" align="center">
      <div slot="backdrop" class="eo-bg"></div>
      <p class="slide-eyebrow text-center text-[var(--accent-primary)] mb-4" data-reveal>
        UNA RICCHEZZA GIÀ IN CASA
      </p>
      <h2
        class="text-[var(--ink-primary)] mb-4 font-[family-name:var(--font-display)] text-center mx-auto"
        style="font-size: clamp(1.9rem, 3vw, 2.8rem); font-weight: 600; line-height: 1.07; letter-spacing: -0.02em; max-width: 24ch;"
        data-reveal
        data-reveal-delay="0.08"
      >
        I team che sanno già fare esistono. Non si parlano.
      </h2>
      <p
        class="text-[var(--ink-secondary)] leading-normal max-w-2xl mx-auto text-center mb-6"
        style="font-size: clamp(1rem, 1.2vw, 1.2rem);"
        data-reveal
        data-reveal-delay="0.15"
      >
        In diverse società del gruppo lavorano persone che usano gli stessi strumenti, risolvono
        gli stessi problemi e non si sono mai incontrate. Una community di pratica del gruppo
        costa poco e rende molto: chi ha già sbagliato una volta insegna agli altri a non
        sbagliare.
      </p>

      <div class="w-full max-w-4xl mx-auto grid md:grid-cols-3 gap-4" data-reveal data-reveal-delay="0.22">
        <div class="eo-card">
          <p class="eo-card-title">Un rito trimestrale</p>
          <p class="eo-card-body">Mezza giornata, i team digitali delle società insieme: cosa ha funzionato, cosa no, cosa si riusa.</p>
        </div>
        <div class="eo-card">
          <p class="eo-card-title">Un catalogo di casi interni</p>
          <p class="eo-card-body">Ogni progetto chiuso lascia una scheda: contesto, numeri, contatto. La conoscenza smette di evaporare.</p>
        </div>
        <div class="eo-card">
          <p class="eo-card-title">Adobe come faculty</p>
          <p class="eo-card-body">I nostri specialisti a disposizione della community, con la Corporate University come casa naturale.</p>
        </div>
      </div>
    </Slide>

  </DeckContainer>
</BaseLayout>
