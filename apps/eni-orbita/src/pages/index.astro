---
import BaseLayout from '../layouts/BaseLayout.astro';
import EniNavigation from '../components/EniNavigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import T from '@edf/core/blocks/i18n/T.astro';
import { href } from '@edf/core/utils/url.js';

const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;

const journey = [
  { num: '01', it: 'La domanda',     en: 'The question',     subIt: 'Governance al centro, velocità in orbita',  subEn: 'Governance at the centre, speed in orbit',  href: '/domanda',     solution: null },
  { num: '02', it: 'La piattaforma', en: 'The platform',     subIt: "L'esperienza come servizio di gruppo",      subEn: 'Experience as a group service',             href: '/piattaforma', solution: null },
  { num: '03', it: 'Le traiettorie', en: 'The trajectories', subIt: 'Da ciò che è in corso al nuovo',            subEn: "From what's underway to what's new",        href: '/traiettorie', solution: 'visibility,journeys,concierge,creativity,documents,authenticity' },
  { num: '04', it: 'La mappa',       en: 'The map',          subIt: 'Tutte le società, ognuna con la sua mossa', subEn: 'Every company, each with its own move',     href: '/mappa',       solution: null },
  { num: '05', it: 'Le persone',     en: 'The people',       subIt: 'Competenze prima degli strumenti',          subEn: 'Skills before tools',                       href: '/persone',     solution: null },
  { num: '06', it: 'La rotta',       en: 'The route',        subIt: 'Tre orizzonti, quattro passi concreti',     subEn: 'Three horizons, four concrete steps',       href: '/rotta',       solution: null },
];

const momento = [
  { vIt: '6°', vEn: '6th', lIt: 'HPC7 nella TOP500 mondiale', lEn: 'HPC7 in the global TOP500', sIt: 'il supercomputer industriale più potente al mondo · giu 2026', sEn: "the world's most powerful industrial supercomputer · Jun 2026" },
  { vIt: 'lug ’26', vEn: 'Jul ’26', lIt: 'il Green Data Center apre a terzi', lEn: 'the Green Data Center opens to third parties', sIt: 'capacità, competenze e servizi AI a imprese e ricerca', sEn: 'compute, skills and AI services for companies and research' },
  { vIt: '500 MW', vEn: '500 MW', lIt: 'AI campus Eni–Khazna', lEn: 'Eni–Khazna AI campus', sIt: 'Ferrera Erbognone · via libera UE, ago 2026', sEn: 'Ferrera Erbognone · EU clearance, Aug 2026' },
];
---
<BaseLayout
  title="Orbita"
  description="Un gruppo, tante realtà, una sola identità: l'esperienza come infrastruttura di gruppo. Eni × Adobe."
>
  <div class="fixed top-0 left-0 right-0 z-50">
    <EniNavigation currentPath={currentPath} base={base} />
  </div>

  <DeckContainer nextHref={href(base, '/domanda')}>

    <!-- ── SLIDE 0: Cover ─────────────────────────────────────────── -->
    <Slide id="slide-cover" bg="primary" align="center">
      <div slot="backdrop" class="eo-bg"></div>

      <div class="eo-cover" data-reveal>
        <T
          as="p"
          class="eo-cover-eyebrow"
          it="Un gruppo · tante realtà · una sola identità"
          en="One group · many realities · one identity"
        />

        <!-- Orbita: nucleo giallo (la bussola) + satelliti in orbita -->
        <div class="eo-orbit" aria-hidden="true" data-reveal data-reveal-delay="0.12">
          <svg viewBox="0 0 320 120" preserveAspectRatio="xMidYMid meet" class="eo-orbit-svg">
            <ellipse cx="160" cy="60" rx="150" ry="44" stroke="rgba(90,200,225,0.5)" stroke-width="1.2" fill="none"/>
            <ellipse cx="160" cy="60" rx="104" ry="30" stroke="rgba(90,200,225,0.35)" stroke-width="1.2" fill="none"/>
            <circle cx="160" cy="60" r="13" fill="#FFCE00"/>
            <circle cx="160" cy="60" r="20" stroke="rgba(255,206,0,0.35)" stroke-width="1" fill="none"/>
            <circle cx="58" cy="82" r="5" fill="#5AC8E1"/>
            <circle cx="262" cy="38" r="5" fill="#5AC8E1"/>
            <circle cx="230" cy="86" r="4" fill="rgba(90,200,225,0.7)"/>
            <circle cx="92" cy="34" r="4" fill="rgba(90,200,225,0.7)"/>
            <circle cx="304" cy="66" r="3" fill="rgba(90,200,225,0.5)"/>
          </svg>
        </div>

        <h1 class="eo-cover-title" data-reveal data-reveal-delay="0.18">Orbita</h1>

        <T
          as="p"
          class="eo-cover-lead"
          data-reveal
          data-reveal-delay="0.24"
          it="Ogni società del gruppo corre sulla propria traiettoria, con i suoi clienti e i suoi mercati. La capogruppo tiene la rotta di tutti. Qui parliamo dell'infrastruttura che permette le due cose insieme: governo dell'esperienza al centro, velocità di esecuzione nei satelliti."
          en="Every company in the group runs on its own trajectory, with its own customers and markets. The parent company keeps everyone on course. This is a conversation about the infrastructure that allows both at once: experience governed at the centre, execution at speed in the satellites."
        />

        <div class="eo-cobrand" data-reveal data-reveal-delay="0.3">
          <span class="eo-cobrand-a">Eni</span>
          <span class="eo-cobrand-x">×</span>
          <span class="eo-cobrand-b">Adobe</span>
        </div>

        <T
          as="p"
          class="eo-cover-note"
          data-reveal
          data-reveal-delay="0.34"
          it="Conversazione preparata dal team Adobe Italia · dati pubblici citati alle fonti"
          en="Prepared by the Adobe Italy team · public data cited to source"
        />
      </div>
    </Slide>

    <!-- ── SLIDE 1: Il momento ────────────────────────────────────── -->
    <Slide id="slide-momento" bg="primary" align="center">
      <div slot="backdrop" class="eo-bg-soft"></div>
      <T
        as="p"
        class="slide-eyebrow text-center text-[var(--accent-primary)] mb-4"
        data-reveal
        it="IL VOSTRO 2026, VISTO DA FUORI"
        en="YOUR 2026, SEEN FROM OUTSIDE"
      />
      <T
        as="h2"
        class="text-[var(--ink-primary)] mb-4 font-[family-name:var(--font-display)] text-center mx-auto"
        style="font-size: clamp(2rem, 3.6vw, 3.4rem); font-weight: 600; line-height: 1.06; letter-spacing: -0.02em; max-width: 22ch;"
        data-reveal
        data-reveal-delay="0.08"
        it="Il calcolo è diventato un servizio"
        en="Compute has become a service"
      />
      <T
        as="p"
        class="text-[var(--ink-secondary)] leading-snug max-w-2xl mx-auto mb-6"
        style="font-size: clamp(1rem, 1.25vw, 1.25rem);"
        data-reveal
        data-reveal-delay="0.15"
        it="In un'estate il vostro Digital &amp; IT ha cambiato mestiere: da funzione interna a fornitore di infrastruttura AI per il Paese. Intanto, sul fronte clienti, Più Insieme e l'Account Unico hanno dato alla famiglia Eni una identità condivisa tra Enilive e Plenitude. Sono i due fatti da cui parte tutto quello che segue."
        en="In a single summer your Digital &amp; IT changed trade: from internal function to AI infrastructure provider for the country. Meanwhile, on the customer side, Più Insieme and the Single Account gave the Eni family one shared identity across Enilive and Plenitude. These two facts are where everything that follows begins."
      />

      <div
        class="w-full max-w-5xl mx-auto grid grid-cols-3 gap-5"
        data-reveal
        data-reveal-delay="0.22"
      >
        {momento.map((m) => (
          <div class="text-center p-4 bg-[var(--surface-secondary)] border border-[var(--line-subtle)] rounded-sm">
            <T
              as="p"
              class="font-[family-name:var(--font-display)] font-bold text-[var(--accent-primary)] leading-none mb-2"
              style="font-size: clamp(1.7rem, 3.2vw, 2.7rem);"
              it={m.vIt}
              en={m.vEn}
            />
            <T as="p" class="text-[1rem] font-medium text-[var(--ink-primary)] mb-1" it={m.lIt} en={m.lEn} />
            <T as="p" class="text-[0.82rem] text-[var(--color-grigio-300)]" it={m.sIt} en={m.sEn} />
          </div>
        ))}
      </div>
      <p class="mt-5 text-center text-[0.75rem] tracking-widest uppercase text-[var(--color-grigio-300)]">
        <T it="Fonti:" en="Sources:" />&nbsp;
        <a href="https://www.eni.com/en-IT/media/press-release/2026/06/eni-ranks-as-world-s-leading-company-top500-global-ranking.html" target="_blank" rel="noopener noreferrer" class="underline underline-offset-2">
          <T it="Eni, TOP500 (giu 2026)" en="Eni, TOP500 (Jun 2026)" />
        </a>
        &nbsp;·&nbsp;
        <a href="https://www.eni.com/en-IT/media/press-release/2026/07/pr-eni-opens-supercomputing-capabilities-innovation-ecosystem.html" target="_blank" rel="noopener noreferrer" class="underline underline-offset-2">
          <T it="Eni, apertura del supercalcolo (lug 2026)" en="Eni, supercomputing opened up (Jul 2026)" />
        </a>
        &nbsp;·&nbsp;
        <a href="https://en.ilsole24ore.com/art/data-centre-eu-gives-green-light-to-eni-khazna-joint-venture-lombardy-hub-to-be-accelerated-AJl2Zcj" target="_blank" rel="noopener noreferrer" class="underline underline-offset-2">
          <T it="Il Sole 24 Ore, JV Eni–Khazna (ago 2026)" en="Il Sole 24 Ore, Eni–Khazna JV (Aug 2026)" />
        </a>
      </p>
    </Slide>

    <!-- ── SLIDE 2: Il percorso ───────────────────────────────────── -->
    <Slide id="slide-percorso" bg="primary" align="center">
      <div slot="backdrop" class="eo-bg"></div>
      <T
        as="p"
        class="slide-eyebrow text-center text-[var(--accent-primary)] mb-4"
        data-reveal
        it="IL PERCORSO"
        en="THE JOURNEY"
      />
      <T
        as="h2"
        class="font-[family-name:var(--font-display)] text-[var(--ink-primary)] mb-4 max-w-3xl mx-auto text-center block"
        style="font-size: clamp(1.9rem, 3vw, 2.6rem); font-weight: 600; line-height: 1.08; letter-spacing: -0.02em;"
        data-reveal
        data-reveal-delay="0.08"
        it="Sei capitoli. Una bussola. Tante orbite."
        en="Six chapters. One compass. Many orbits."
      />
      <T
        as="p"
        class="text-[clamp(0.9rem,1.05vw,1.05rem)] text-[var(--ink-secondary)] max-w-2xl mx-auto mb-4 text-center"
        data-reveal
        data-reveal-delay="0.15"
        it="Quarantacinque minuti pensati per ascoltare prima e proporre poi. Ogni capitolo regge da solo: si può saltare, tagliare, approfondire."
        en="Forty-five minutes built to listen first and propose after. Each chapter stands on its own: skip it, trim it, or go deeper."
      />

      <div
        class="w-full max-w-5xl mx-auto grid grid-cols-2 md:grid-cols-3 gap-2 mb-3"
        data-reveal
        data-reveal-delay="0.22"
      >
        {journey.map((step) => (
          <a
            href={href(base, step.href)}
            data-nav-solution={step.solution ?? undefined}
            data-edf-journey-card
            class="journey-card px-4 py-2 border border-[var(--line-subtle)] rounded-sm text-left transition-colors no-underline group"
          >
            <p class="text-xs font-semibold text-[var(--color-grigio-400)] mb-0.5 font-[family-name:var(--font-display)] tabular-nums" data-edf-cardnum>
              {step.num}
            </p>
            <T as="p" class="text-[1.02rem] font-semibold text-[var(--ink-primary)] mb-0.5 font-[family-name:var(--font-display)] block" it={step.it} en={step.en} />
            <T as="p" class="text-[0.84rem] text-[var(--color-grigio-300)] block" it={step.subIt} en={step.subEn} />
          </a>
        ))}
      </div>

      <div data-reveal data-reveal-delay="0.35" class="text-center">
        <a
          href={href(base, '/domanda')}
          class="inline-flex items-center gap-3 px-9 py-2 text-[clamp(1rem,1.2vw,1.15rem)] font-semibold tracking-wide bg-[var(--accent-primary)] text-[var(--color-notte)] hover:bg-[var(--color-giallo-caldo)] transition-colors duration-300 focus-visible:outline-2 focus-visible:outline-[var(--accent-primary)] focus-visible:outline-offset-4 font-[family-name:var(--font-display)] no-underline"
        >
          <T it="Inizia il percorso" en="Start the journey" />
          <svg width="20" height="20" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>
    </Slide>

  </DeckContainer>

  <style>
    .eo-cover {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 1.15rem;
      width: 100%;
      max-width: 60rem;
      margin-inline: auto;
    }
    .eo-cover :global(.eo-cover-eyebrow) {
      font-family: var(--font-body);
      font-weight: 600;
      font-size: clamp(0.75rem, 0.9vw, 0.9rem);
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--color-giallo);
      margin: 0;
    }
    .eo-orbit {
      width: min(22rem, 60vw);
    }
    .eo-orbit-svg { width: 100%; height: auto; display: block; }
    .eo-cover-title {
      font-family: var(--font-display);
      font-weight: 600;
      font-size: clamp(3rem, 7vw, 6rem);
      line-height: 1;
      letter-spacing: -0.03em;
      color: var(--ink-primary);
      margin: 0.1rem 0 0;
    }
    .eo-cover :global(.eo-cover-lead) {
      font-size: clamp(1rem, 1.25vw, 1.2rem);
      line-height: 1.55;
      color: var(--color-grigio-200);
      max-width: 46rem;
      margin: 0 auto;
      display: block;
    }
    .eo-cobrand {
      display: inline-flex;
      align-items: center;
      gap: 0.7rem;
      font-family: var(--font-display);
      font-weight: 600;
      font-size: clamp(1.05rem, 1.4vw, 1.3rem);
      letter-spacing: 0.02em;
      margin-top: 0.1rem;
    }
    .eo-cobrand-a { color: var(--ink-primary); }
    .eo-cobrand-x { color: var(--color-giallo); font-weight: 400; }
    .eo-cobrand-b { color: var(--ink-primary); }
    .eo-cover :global(.eo-cover-note) {
      font-size: 0.75rem;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--color-grigio-300);
      max-width: 42rem;
      margin: 0 auto;
      display: block;
    }
  </style>
</BaseLayout>
