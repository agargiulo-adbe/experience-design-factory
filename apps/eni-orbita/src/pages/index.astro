---
import BaseLayout from '../layouts/BaseLayout.astro';
import EniNavigation from '../components/EniNavigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import { href } from '@edf/core/utils/url.js';

const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;

const journey = [
  { num: '01', label: 'La domanda',     sub: 'Governance al centro, velocità in orbita',  href: '/domanda',     solution: null },
  { num: '02', label: 'La piattaforma', sub: "L'esperienza come servizio di gruppo",      href: '/piattaforma', solution: null },
  { num: '03', label: 'Le traiettorie', sub: 'Da ciò che è in corso al nuovo',            href: '/traiettorie', solution: 'visibility,journeys,concierge,creativity,documents,authenticity' },
  { num: '04', label: 'La mappa',       sub: 'Tutte le società, ognuna con la sua mossa', href: '/mappa',       solution: null },
  { num: '05', label: 'Le persone',     sub: 'Competenze prima degli strumenti',          href: '/persone',     solution: null },
  { num: '06', label: 'La rotta',       sub: 'Tre orizzonti, quattro passi concreti',     href: '/rotta',       solution: null },
];

const momento = [
  { value: '6°',      label: 'HPC7 nella TOP500 mondiale',        sub: 'il supercomputer industriale più potente al mondo · giu 2026' },
  { value: 'lug ’26', label: 'il Green Data Center apre a terzi', sub: 'capacità, competenze e servizi AI a imprese e ricerca' },
  { value: '500 MW',  label: 'AI campus Eni–Khazna',              sub: 'Ferrera Erbognone · via libera UE, ago 2026' },
];
---
<BaseLayout
  title="Orbita"
  description="Un gruppo, tante realtà, una sola identità: l'esperienza come infrastruttura di gruppo. Eni × Adobe."
>
  <div class="fixed top-0 left-0 right-0 z-50">
    <EniNavigation currentPath={currentPath} base={base} />
  </div>

  <DeckContainer nextHref={href(base, '/domanda')}>

    <!-- ── SLIDE 0: Cover ─────────────────────────────────────────── -->
    <Slide id="slide-cover" bg="primary" align="center">
      <div slot="backdrop" class="eo-bg"></div>

      <div class="eo-cover" data-reveal>
        <p class="eo-cover-eyebrow">Un gruppo · tante realtà · una sola identità</p>

        <!-- Orbita: nucleo giallo (la bussola) + satelliti in orbita -->
        <div class="eo-orbit" aria-hidden="true" data-reveal data-reveal-delay="0.12">
          <svg viewBox="0 0 320 120" preserveAspectRatio="xMidYMid meet" class="eo-orbit-svg">
            <ellipse cx="160" cy="60" rx="150" ry="44" stroke="rgba(90,200,225,0.5)" stroke-width="1.2" fill="none"/>
            <ellipse cx="160" cy="60" rx="104" ry="30" stroke="rgba(90,200,225,0.35)" stroke-width="1.2" fill="none"/>
            <circle cx="160" cy="60" r="13" fill="#FFCE00"/>
            <circle cx="160" cy="60" r="20" stroke="rgba(255,206,0,0.35)" stroke-width="1" fill="none"/>
            <circle cx="58" cy="82" r="5" fill="#5AC8E1"/>
            <circle cx="262" cy="38" r="5" fill="#5AC8E1"/>
            <circle cx="230" cy="86" r="4" fill="rgba(90,200,225,0.7)"/>
            <circle cx="92" cy="34" r="4" fill="rgba(90,200,225,0.7)"/>
            <circle cx="304" cy="66" r="3" fill="rgba(90,200,225,0.5)"/>
          </svg>
        </div>

        <h1 class="eo-cover-title" data-reveal data-reveal-delay="0.18">Orbita</h1>

        <p class="eo-cover-lead" data-reveal data-reveal-delay="0.24">
          Ogni società del gruppo corre sulla propria traiettoria, con i suoi clienti e i suoi
          mercati. La capogruppo tiene la rotta di tutti. Qui parliamo dell'infrastruttura che
          permette le due cose insieme: governo dell'esperienza al centro, velocità di
          esecuzione nei satelliti.
        </p>

        <div class="eo-cobrand" data-reveal data-reveal-delay="0.3">
          <span class="eo-cobrand-a">Eni</span>
          <span class="eo-cobrand-x">×</span>
          <span class="eo-cobrand-b">Adobe</span>
        </div>

        <p class="eo-cover-note" data-reveal data-reveal-delay="0.34">
          Conversazione preparata dal team Adobe Italia · dati pubblici citati alle fonti
        </p>
      </div>
    </Slide>

    <!-- ── SLIDE 1: Il momento ────────────────────────────────────── -->
    <Slide id="slide-momento" bg="primary" align="center">
      <div slot="backdrop" class="eo-bg-soft"></div>
      <p class="slide-eyebrow text-center text-[var(--accent-primary)] mb-4" data-reveal>
        IL VOSTRO 2026, VISTO DA FUORI
      </p>
      <h2
        class="text-[var(--ink-primary)] mb-4 font-[family-name:var(--font-display)] text-center mx-auto"
        style="font-size: clamp(2rem, 3.6vw, 3.4rem); font-weight: 600; line-height: 1.06; letter-spacing: -0.02em; max-width: 22ch;"
        data-reveal
        data-reveal-delay="0.08"
      >
        Il calcolo è diventato un servizio
      </h2>
      <p
        class="text-[var(--ink-secondary)] leading-snug max-w-2xl mx-auto mb-6"
        style="font-size: clamp(1rem, 1.25vw, 1.25rem);"
        data-reveal
        data-reveal-delay="0.15"
      >
        In un'estate il vostro Digital &amp; IT ha cambiato mestiere: da funzione interna a
        fornitore di infrastruttura AI per il Paese. Intanto, sul fronte clienti, Più Insieme e
        l'Account Unico hanno dato alla famiglia Eni una identità condivisa tra Enilive e
        Plenitude. Sono i due fatti da cui parte tutto quello che segue.
      </p>

      <div
        class="w-full max-w-5xl mx-auto grid grid-cols-3 gap-5"
        data-reveal
        data-reveal-delay="0.22"
      >
        {momento.map((m) => (
          <div class="text-center p-4 bg-[var(--surface-secondary)] border border-[var(--line-subtle)] rounded-sm">
            <p
              class="font-[family-name:var(--font-display)] font-bold text-[var(--accent-primary)] leading-none mb-2"
              style="font-size: clamp(1.7rem, 3.2vw, 2.7rem);"
            >
              {m.value}
            </p>
            <p class="text-[1rem] font-medium text-[var(--ink-primary)] mb-1">{m.label}</p>
            <p class="text-[0.82rem] text-[var(--color-grigio-300)]">{m.sub}</p>
          </div>
        ))}
      </div>
      <p class="mt-5 text-center text-[0.75rem] tracking-widest uppercase text-[var(--color-grigio-300)]">
        Fonti:&nbsp;
        <a href="https://www.eni.com/en-IT/media/press-release/2026/06/eni-ranks-as-world-s-leading-company-top500-global-ranking.html" target="_blank" rel="noopener noreferrer" class="underline underline-offset-2">
          Eni, TOP500 (giu 2026)
        </a>
        &nbsp;·&nbsp;
        <a href="https://www.eni.com/en-IT/media/press-release/2026/07/pr-eni-opens-supercomputing-capabilities-innovation-ecosystem.html" target="_blank" rel="noopener noreferrer" class="underline underline-offset-2">
          Eni, apertura del supercalcolo (lug 2026)
        </a>
        &nbsp;·&nbsp;
        <a href="https://en.ilsole24ore.com/art/data-centre-eu-gives-green-light-to-eni-khazna-joint-venture-lombardy-hub-to-be-accelerated-AJl2Zcj" target="_blank" rel="noopener noreferrer" class="underline underline-offset-2">
          Il Sole 24 Ore, JV Eni–Khazna (ago 2026)
        </a>
      </p>
    </Slide>

    <!-- ── SLIDE 2: Il percorso ───────────────────────────────────── -->
    <Slide id="slide-percorso" bg="primary" align="center">
      <div slot="backdrop" class="eo-bg"></div>
      <p class="slide-eyebrow text-center text-[var(--accent-primary)] mb-4" data-reveal>
        IL PERCORSO
      </p>
      <h2
        class="font-[family-name:var(--font-display)] text-[var(--ink-primary)] mb-4 max-w-3xl mx-auto text-center"
        style="font-size: clamp(1.9rem, 3vw, 2.6rem); font-weight: 600; line-height: 1.08; letter-spacing: -0.02em;"
        data-reveal
        data-reveal-delay="0.08"
        data-edf-chapters
      >
        Sei capitoli. Una bussola. Tante orbite.
      </h2>
      <p
        class="text-[clamp(0.9rem,1.05vw,1.05rem)] text-[var(--ink-secondary)] max-w-2xl mx-auto mb-4 text-center"
        data-reveal
        data-reveal-delay="0.15"
      >
        Quarantacinque minuti pensati per ascoltare prima e proporre poi. Ogni capitolo regge da
        solo: si può saltare, tagliare, approfondire.
      </p>

      <div
        class="w-full max-w-5xl mx-auto grid grid-cols-2 md:grid-cols-3 gap-2 mb-3"
        data-reveal
        data-reveal-delay="0.22"
      >
        {journey.map((step) => (
          <a
            href={href(base, step.href)}
            data-nav-solution={step.solution ?? undefined}
            data-edf-journey-card
            class="journey-card px-4 py-2 border border-[var(--line-subtle)] rounded-sm text-left transition-colors no-underline group"
          >
            <p class="text-xs font-semibold text-[var(--color-grigio-400)] mb-0.5 font-[family-name:var(--font-display)] tabular-nums" data-edf-cardnum>
              {step.num}
            </p>
            <p class="text-[1.02rem] font-semibold text-[var(--ink-primary)] mb-0.5 font-[family-name:var(--font-display)]">
              {step.label}
            </p>
            <p class="text-[0.84rem] text-[var(--color-grigio-300)]">{step.sub}</p>
          </a>
        ))}
      </div>

      <div data-reveal data-reveal-delay="0.35" class="text-center">
        <a
          href={href(base, '/domanda')}
          class="inline-flex items-center gap-3 px-9 py-2 text-[clamp(1rem,1.2vw,1.15rem)] font-semibold tracking-wide bg-[var(--accent-primary)] text-[var(--color-notte)] hover:bg-[var(--color-giallo-caldo)] transition-colors duration-300 focus-visible:outline-2 focus-visible:outline-[var(--accent-primary)] focus-visible:outline-offset-4 font-[family-name:var(--font-display)] no-underline"
        >
          Inizia il percorso
          <svg width="20" height="20" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>
    </Slide>

  </DeckContainer>

  <style>
    .eo-cover {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 1.15rem;
      width: 100%;
      max-width: 60rem;
      margin-inline: auto;
    }
    .eo-cover-eyebrow {
      font-family: var(--font-body);
      font-weight: 600;
      font-size: clamp(0.75rem, 0.9vw, 0.9rem);
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--color-giallo);
      margin: 0;
    }
    .eo-orbit {
      width: min(22rem, 60vw);
    }
    .eo-orbit-svg { width: 100%; height: auto; display: block; }
    .eo-cover-title {
      font-family: var(--font-display);
      font-weight: 600;
      font-size: clamp(3rem, 7vw, 6rem);
      line-height: 1;
      letter-spacing: -0.03em;
      color: var(--ink-primary);
      margin: 0.1rem 0 0;
    }
    .eo-cover-lead {
      font-size: clamp(1rem, 1.25vw, 1.2rem);
      line-height: 1.55;
      color: var(--color-grigio-200);
      max-width: 46rem;
      margin: 0 auto;
    }
    .eo-cobrand {
      display: inline-flex;
      align-items: center;
      gap: 0.7rem;
      font-family: var(--font-display);
      font-weight: 600;
      font-size: clamp(1.05rem, 1.4vw, 1.3rem);
      letter-spacing: 0.02em;
      margin-top: 0.1rem;
    }
    .eo-cobrand-a { color: var(--ink-primary); }
    .eo-cobrand-x { color: var(--color-giallo); font-weight: 400; }
    .eo-cobrand-b { color: var(--ink-primary); }
    .eo-cover-note {
      font-size: 0.75rem;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--color-grigio-300);
      max-width: 42rem;
      margin: 0 auto;
    }
  </style>
</BaseLayout>
