---
import BaseLayout from '../layouts/BaseLayout.astro';
import T from '@edf/core/blocks/i18n/T.astro';
import LangToggle from '@edf/core/blocks/i18n/LangToggle.astro';
import { href } from '@edf/core/utils/url.js';

const base = import.meta.env.BASE_URL;

type Tri = { en: string; it: string; fr: string };

const summary: Tri[] = [
  {
    it: '<strong>Il meeting:</strong> 10 settembre 2026, 45 minuti con Costantino Chessa, Head of Global Digital & IT del gruppo Eni (in carica da gennaio 2026). Ex Head of Procurement per sette anni: un trasformatore di organizzazioni, non un tecnologo. Nessun partner esterno in stanza.',
    en: '<strong>The meeting:</strong> September 10, 2026, 45 minutes with Costantino Chessa, Head of Global Digital & IT of the Eni group (in role since January 2026). Former Head of Procurement for seven years: an organisation transformer, not a technologist. No external partners in the room.',
    fr: '<strong>La réunion :</strong> 10 septembre 2026, 45 minutes avec Costantino Chessa, Head of Global Digital & IT du groupe Eni (en poste depuis janvier 2026). Ancien directeur des achats pendant sept ans : un transformateur d\'organisations, pas un technologue. Aucun partenaire externe dans la salle.',
  },
  {
    it: '<strong>La tesi:</strong> Eni ha appena trasformato il calcolo in un servizio (Green Data Center aperto a terzi, luglio 2026). Proponiamo lo stesso modello per esperienza e contenuti: un catalogo governato dal centro, consumato dalle società del gruppo.',
    en: '<strong>The thesis:</strong> Eni has just turned compute into a service (Green Data Center opened to third parties, July 2026). We propose the same model for experience and content: a catalogue governed at the centre, consumed by the group companies.',
    fr: '<strong>La thèse :</strong> Eni vient de transformer le calcul en service (Green Data Center ouvert aux tiers, juillet 2026). Nous proposons le même modèle pour l\'expérience et les contenus : un catalogue gouverné au centre, consommé par les sociétés du groupe.',
  },
  {
    it: '<strong>Le idee:</strong> i tre cantieri già avviati (visibilità nei motori AI, journey, brand concierge) sono punti di partenza di sei traiettorie di gruppo. L\'offerta è UNA: experience, creatività e documenti insieme.',
    en: '<strong>The ideas:</strong> the three streams already in flight (AI-engine visibility, journeys, brand concierge) are the starting points of six group-wide trajectories. The offer is ONE: experience, creativity and documents together.',
    fr: '<strong>Les idées :</strong> les trois chantiers déjà lancés (visibilité dans les moteurs IA, journeys, brand concierge) sont les points de départ de six trajectoires de groupe. L\'offre est UNE : expérience, créativité et documents ensemble.',
  },
  {
    it: '<strong>Il perimetro:</strong> tutto il gruppo. Espandere su Plenitude, consolidare su Eni SpA, entrare in Enilive, Versalis, trading, AGI e società di servizi; presidiare le partecipate internazionali.',
    en: '<strong>The perimeter:</strong> the whole group. Expand on Plenitude, consolidate on Eni SpA, enter Enilive, Versalis, trading, AGI and the service companies; keep watch on the international affiliates.',
    fr: '<strong>Le périmètre :</strong> tout le groupe. S\'étendre sur Plenitude, consolider Eni SpA, entrer chez Enilive, Versalis, le trading, AGI et les sociétés de services ; veiller sur les participations internationales.',
  },
  {
    it: '<strong>Il regalo finale:</strong> «da megawatt a esperienze» — i servizi di esperienza Adobe nel catalogo AI del Green Data Center. Nessuno al mondo lo ha fatto; da esplorare con Adobe corporate, senza promesse in stanza.',
    en: '<strong>The closing gift:</strong> "from megawatts to experiences" — Adobe experience services inside the Green Data Center\'s AI catalogue. No one in the world has done it; to be explored with Adobe corporate, no promises in the room.',
    fr: '<strong>Le cadeau final :</strong> « des mégawatts aux expériences » — les services d\'expérience Adobe dans le catalogue IA du Green Data Center. Personne au monde ne l\'a fait ; à explorer avec Adobe corporate, sans promesses en salle.',
  },
];

const missione = {
  obiettivi: [
    {
      it: '<strong>Obiettivo minimo:</strong> uscire con le priorità di Chessa sulle sei traiettorie e almeno una presentazione promessa (il decision maker digitale di Enilive).',
      en: '<strong>Minimum objective:</strong> leave with Chessa\'s priorities across the six trajectories and at least one promised introduction (Enilive\'s digital decision maker).',
      fr: '<strong>Objectif minimum :</strong> repartir avec les priorités de Chessa sur les six trajectoires et au moins une mise en relation promise (le décideur digital d\'Enilive).',
    },
    {
      it: '<strong>Obiettivo pieno:</strong> un working group su un caso concreto con data e KPI entro fine 2026, un tavolo con la Comunicazione sulla visibilità AI, e il mandato a costruire la vista "catalogo di gruppo".',
      en: '<strong>Full objective:</strong> a working group on one concrete case with a date and KPI by end of 2026, a table with Communication on AI visibility, and the mandate to build the "group catalogue" view.',
      fr: '<strong>Objectif complet :</strong> un groupe de travail sur un cas concret avec date et KPI d\'ici fin 2026, une table avec la Communication sur la visibilité IA, et le mandat de construire la vue « catalogue de groupe ».',
    },
    {
      it: '<strong>Postura:</strong> ascoltare prima (capitolo 1 è fatto di domande), proporre poi. Chessa è in ruolo da otto mesi: cerca alleati che gli semplifichino il gruppo, non fornitori che gli vendano licenze.',
      en: '<strong>Posture:</strong> listen first (chapter 1 is made of questions), propose after. Chessa is eight months into the role: he is looking for allies who simplify the group for him, not vendors selling licences.',
      fr: '<strong>Posture :</strong> écouter d\'abord (le chapitre 1 est fait de questions), proposer ensuite. Chessa est en poste depuis huit mois : il cherche des alliés qui lui simplifient le groupe, pas des fournisseurs de licences.',
    },
  ] as Tri[],
};

const carriera = [
  { anni: '1995–1999', ruolo: { it: 'Banco Ambrosiano Veneto — middle office, bond trading', en: 'Banco Ambrosiano Veneto — middle office, bond trading', fr: 'Banco Ambrosiano Veneto — middle office, trading obligataire' } },
  { anni: '1996–2007', ruolo: { it: 'Saipem — 11 anni tra HR, organizzazione e change management post-merger', en: 'Saipem — 11 years across HR, organisation and post-merger change management', fr: 'Saipem — 11 ans entre RH, organisation et conduite du changement post-fusion' } },
  { anni: '2008–2018', ruolo: { it: 'Eni — Organization SVP, poi Continuous Improvement SVP', en: 'Eni — Organization SVP, then Continuous Improvement SVP', fr: 'Eni — SVP Organisation, puis SVP Amélioration continue' } },
  { anni: '2018–2025', ruolo: { it: 'Eni — Head of Procurement: sette anni a integrare procurement, business e filiera dell\'energia', en: 'Eni — Head of Procurement: seven years integrating procurement, business and the energy supply chain', fr: 'Eni — Directeur des achats : sept ans à intégrer achats, métiers et filière de l\'énergie' } },
  { anni: 'gen 2026 →', ruolo: { it: 'Eni — Head of Global Digital & IT (succede a Dario Pagani, oggi CEO di Eniquantic)', en: 'Eni — Head of Global Digital & IT (succeeding Dario Pagani, now CEO of Eniquantic)', fr: 'Eni — Head of Global Digital & IT (succède à Dario Pagani, aujourd\'hui CEO d\'Eniquantic)' } },
];

const chessaCome = [
  {
    it: '<strong>Come pensa:</strong> in pubblico definisce l\'AI «un\'infrastruttura decisionale», non un fine. Attribuisce il vantaggio di Eni «all\'investimento nelle competenze delle persone, non solo negli strumenti tecnologici» (PoliS-Lombardia, aprile 2026, verificato sul video).',
    en: '<strong>How he thinks:</strong> in public he calls AI "a decision-making infrastructure", not an end in itself. He credits Eni\'s edge to "investing in people\'s skills, not just in technology tools" (PoliS-Lombardia, April 2026, verified on video).',
    fr: '<strong>Comment il pense :</strong> en public, il définit l\'IA comme « une infrastructure décisionnelle », pas une fin. Il attribue l\'avantage d\'Eni à « l\'investissement dans les compétences des personnes, pas seulement dans les outils » (PoliS-Lombardia, avril 2026, vérifié sur la vidéo).',
  },
  {
    it: '<strong>Come parlargli:</strong> processi, governance, valore misurabile, competenze. Sette anni da capo del procurement: riconosce al volo il valore del consolidamento e diffida delle promesse senza numeri. Ogni proposta nel deck chiude con una misura e una data.',
    en: '<strong>How to talk to him:</strong> processes, governance, measurable value, skills. Seven years as head of procurement: he instantly recognises the value of consolidation and distrusts promises without numbers. Every proposal in the deck closes with a measure and a date.',
    fr: '<strong>Comment lui parler :</strong> processus, gouvernance, valeur mesurable, compétences. Sept ans à la tête des achats : il reconnaît d\'emblée la valeur de la consolidation et se méfie des promesses sans chiffres. Chaque proposition du deck se termine par une mesure et une date.',
  },
  {
    it: '<strong>Cosa lo accende:</strong> il riposizionamento del suo Digital & IT da funzione interna a provider di infrastruttura AI (Green Data Center aperto, JV Khazna). L\'orizzonte 3 del deck («da megawatt a esperienze») è costruito per parlare a questa ambizione.',
    en: '<strong>What lights him up:</strong> repositioning his Digital & IT from internal function to AI infrastructure provider (Green Data Center opened, Khazna JV). Horizon 3 of the deck ("from megawatts to experiences") is built to speak to that ambition.',
    fr: '<strong>Ce qui l\'enthousiasme :</strong> le repositionnement de son Digital & IT de fonction interne à fournisseur d\'infrastructure IA (Green Data Center ouvert, JV Khazna). L\'horizon 3 du deck (« des mégawatts aux expériences ») est construit pour parler à cette ambition.',
  },
];

const fatti = [
  {
    badge: 'verificato 3-0',
    it: '<strong>HPC7</strong> è 6° nella TOP500 mondiale e 2° in Europa (giugno 2026). HPC6+HPC7 superano la soglia Exascale: Eni si dichiara la prima organizzazione industriale al mondo per capacità di calcolo.',
