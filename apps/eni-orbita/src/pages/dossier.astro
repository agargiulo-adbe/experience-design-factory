---
import DocLayout from '../layouts/DocLayout.astro';
import DossierPage from '@edf/core/blocks/doc/DossierPage.astro';

// ── Pagina RISERVATA (Adobe internal) ──────────────────────────────────────
// Dossier di preparazione per l'incontro Eni del 10 settembre 2026.
//
// Fino al 9 ottobre 2026 questa pagina aveva il renderer copiato dentro l'app
// e il contenuto scritto qui dentro: compilato nel bundle statico e quindi
// PUBBLICATO su GitHub Pages. Chi apriva l'URL leggeva tutto senza password —
// nome e lettura del referente del cliente, la mappa delle persone, le leve,
// il minutaggio e il piano B. Il badge «Adobe internal» era una scritta, non
// un lucchetto, e `noindex` tiene fuori i motori di ricerca, non chi ha il
// link. Il contenuto adesso vive in Supabase (tabella restricted_docs, RLS) e
// si carica solo
//   1) dopo login (super admin o utente con accesso a eni-orbita), o
//   2) via secret-link ?t=<uuid> (RPC get_shared_doc di 0009, senza login).
// L'URL non è cambiato. Seed (git-ignorato):
// docs/Eni/0028_seed_eni_orbita_dossier.sql.
//
// Resta TRILINGUE IT/EN/FR: il motore condiviso ricava le lingue dal
// contenuto invece di tenerne due fisse nel markup, quindi il francese
// sopravvive alla migrazione.
//
// Il rendering è del motore condiviso `@edf/core/blocks/doc/DossierPage.astro`:
// qui restano solo lo slug e il guscio. La palette sta nel DocLayout.
---
<DocLayout
  title="Dossier — Eni, 10 settembre"
  description="Adobe internal — dossier di preparazione riservato (accesso ristretto)."
  noindex={true}
>
  <DossierPage
    docSlug="eni-orbita"
    title="Dossier — Eni, 10 settembre"
    base={import.meta.env.BASE_URL}
    supabaseUrl={import.meta.env.PUBLIC_SUPABASE_URL ?? ''}
    supabaseAnon={import.meta.env.PUBLIC_SUPABASE_ANON_KEY ?? ''}
    deckHref="/experience-design-factory/eni-orbita/"
    deckLabel="Apri l'esperienza ↗"
  />
</DocLayout>
