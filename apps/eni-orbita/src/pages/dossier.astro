  { min: '0–5',   fase: { it: 'Apertura e specchio: il loro 2026 (cap. 0). Guadagnare credibilità in due slide.', en: 'Opening and mirror: their 2026 (ch. 0). Earn credibility in two slides.', fr: 'Ouverture et miroir : leur 2026 (chap. 0). Gagner en crédibilité en deux slides.' } },
  { min: '5–15',  fase: { it: 'Ascolto guidato: le tre domande (cap. 1). Lasciarlo parlare; prendere appunti visibili.', en: 'Guided listening: the three questions (ch. 1). Let him talk; take visible notes.', fr: 'Écoute guidée : les trois questions (chap. 1). Le laisser parler ; prendre des notes visibles.' } },
  { min: '15–30', fase: { it: 'La piattaforma e le traiettorie che il dialogo tocca (cap. 2–3). Non percorrerle tutte: il gating nasconde quelle non richieste.', en: 'The platform and the trajectories the dialogue touches (ch. 2–3). Do not walk through all of them: gating hides the ones not requested.', fr: 'La plateforme et les trajectoires que le dialogue touche (chap. 2–3). Ne pas toutes les parcourir : le gating masque celles non demandées.' } },
  { min: '30–38', fase: { it: 'La mappa del gruppo e le persone (cap. 4–5). Qui vive la citazione: il momento personale.', en: 'The group map and people (ch. 4–5). The quote lives here: the personal moment.', fr: 'La carte du groupe et les personnes (chap. 4–5). La citation vit ici : le moment personnel.' } },
  { min: '38–45', fase: { it: 'La rotta, «da megawatt a esperienze», le quattro richieste (cap. 6). Chiudere sulle richieste, non sulla visione.', en: 'The route, "from megawatts to experiences", the four asks (ch. 6). Close on the asks, not on the vision.', fr: 'La route, « des mégawatts aux expériences », les quatre demandes (chap. 6). Conclure sur les demandes, pas sur la vision.' } },
];

const pianoB = [
  { it: '<strong>Se porta il discorso su contratti o rinnovi:</strong> «tema che sta già camminando sui tavoli giusti; oggi vorremmo usare i 45 minuti sulla rotta». Non aprire il tema, mai numeri.', en: '<strong>If he steers to contracts or renewals:</strong> "that is already moving on the right tables; today we would like to spend the 45 minutes on the route". Do not open the topic, never numbers.', fr: '<strong>S\'il oriente vers les contrats ou renouvellements :</strong> « le sujet avance déjà sur les bonnes tables ; aujourd\'hui nous voudrions consacrer les 45 minutes à la route ». Ne pas ouvrir le sujet, jamais de chiffres.' },
  { it: '<strong>Se vuole parlare solo di infrastruttura AI:</strong> assecondarlo e saltare all\'orizzonte 3 (cap. 6, slide «da megawatt a esperienze»), poi tornare indietro: «per vendere esperienze fuori, servono governate dentro».', en: '<strong>If he only wants to talk AI infrastructure:</strong> go with it and jump to horizon 3 (ch. 6, "from megawatts to experiences" slide), then loop back: "to sell experiences outside, they must be governed inside".', fr: '<strong>S\'il ne veut parler que d\'infrastructure IA :</strong> le suivre et sauter à l\'horizon 3 (chap. 6, slide « des mégawatts aux expériences »), puis revenir : « pour vendre des expériences dehors, il faut les gouverner dedans ».' },
  { it: '<strong>Se il tempo si dimezza:</strong> percorso minimo = cap. 0 (1 slide) → cap. 1 (domande) → cap. 6 (richieste). La mappa e le traiettorie si mandano dopo, come follow-up.', en: '<strong>If time is halved:</strong> minimum path = ch. 0 (1 slide) → ch. 1 (questions) → ch. 6 (asks). Map and trajectories go afterwards as follow-up.', fr: '<strong>Si le temps est réduit de moitié :</strong> parcours minimal = chap. 0 (1 slide) → chap. 1 (questions) → chap. 6 (demandes). La carte et les trajectoires partent ensuite en follow-up.' },
];

const biblioteca = [
  { label: 'Eni — apertura del supercalcolo all\'ecosistema (PR, 28 lug 2026)', url: 'https://www.eni.com/en-IT/media/press-release/2026/07/pr-eni-opens-supercomputing-capabilities-innovation-ecosystem.html', tipo: 'primaria' },
  { label: 'Eni — HPC7, scheda ufficiale', url: 'https://www.eni.com/en-IT/actions/energy-transition-technologies/supercomputing-artificial-intelligence/supercomputer.html', tipo: 'primaria' },
  { label: 'Eni — TOP500, prima azienda al mondo (PR, giu 2026)', url: 'https://www.eni.com/en-IT/media/press-release/2026/06/eni-ranks-as-world-s-leading-company-top500-global-ranking.html', tipo: 'primaria' },
  { label: 'Eni — JV Khazna, Heads of Terms (PR, 14 lug 2025)', url: 'https://www.eni.com/en-IT/media/press-release/2025/07/pr-khazna-data-centers-eni-partner-develop-i-data-center-campus.html', tipo: 'primaria' },
  { label: 'Il Sole 24 Ore — via libera UE alla JV Eni–Khazna (10 ago 2026)', url: 'https://en.ilsole24ore.com/art/data-centre-eu-gives-green-light-to-eni-khazna-joint-venture-lombardy-hub-to-be-accelerated-AJl2Zcj', tipo: 'stampa' },
  { label: 'Linkiesta — sovranità digitale e apertura del supercalcolo (lug 2026)', url: 'https://www.linkiesta.it/2026/07/eni-supercomputer-imprese-ricerca/', tipo: 'stampa' },
  { label: 'HPCwire — HPC7 debuts at No. 6, exascale combinato (giu 2026)', url: 'https://www.hpcwire.com/off-the-wire/enis-hpc7-debuts-at-no-6-on-top500-as-hpc6-and-hpc7-combined-surpass-exascale/', tipo: 'stampa' },
  { label: 'Video — Chessa a PoliS-Lombardia (apr 2026): «infrastruttura decisionale» ~07:10', url: 'https://www.youtube.com/watch?v=2qyIQJMpml0', tipo: 'video' },
  { label: 'Più Insieme — sito ufficiale del programma', url: 'https://piuinsieme.eni.com/home.html', tipo: 'primaria' },
  { label: 'Enilive — Account Unico Eni', url: 'https://www.enilive.it/app-enilive/cliente-unico', tipo: 'primaria' },
  { label: 'Eni — bio ufficiale Erika Mandraffino', url: 'https://www.eni.com/en-IT/company/biographies/erika-mandraffino.html', tipo: 'primaria' },
  { label: 'Plenitude — management (Goberti, Marino, Molajoni)', url: 'https://corporate.eniplenitude.com/en/about/management', tipo: 'primaria' },
  { label: 'LinkedIn — Elvira Fabrizio, Head of Digital & IT Enilive', url: 'https://it.linkedin.com/in/elvira-fabrizio-609b787', tipo: 'profilo' },
  { label: 'The Innovation Group — bio Elvira Fabrizio (25+ anni ICT, board EGEM dal 2020)', url: 'https://www.theinnovationgroup.it/speakers/elvira-fabrizio/?lang=it', tipo: 'profilo' },
  { label: 'Eni — piano strategico 2026–2030 (target Enilive e Plenitude)', url: 'https://www.eni.com/en-IT/investors/strategy/strategic-plan.html', tipo: 'primaria' },
  { label: 'LinkedIn — Costantino Chessa', url: 'https://it.linkedin.com/in/costantino-chessa-324bb822', tipo: 'profilo' },
];
---
<BaseLayout
  title="Dossier — War Room"
  description="Adobe internal — meeting preparation dossier."
  noindex={true}
>
  <div class="dw-shell">
    <header class="dw-header">
      <div class="dw-header-inner">
        <div class="dw-header-left">
          <span class="dw-badge">Adobe internal</span>
          <h1 class="dw-title">
            <T en="War Room — Eni, September 10" it="War Room — Eni, 10 settembre" fr="War Room — Eni, 10 septembre" as="span" />
          </h1>
        </div>
        <div class="dw-header-right">
          <LangToggle langs={['en', 'it', 'fr']} />
          <a class="dw-deck-link" href={href(base, '/')}>
            <T en="Open the deck →" it="Apri il deck →" fr="Ouvrir le deck →" as="span" />
          </a>
        </div>
      </div>
      <p class="dw-disclaimer">
        <T
          en="Working document for the Adobe team. Public sources cited throughout; no contractual or financial data. Please do not circulate outside Adobe."
          it="Documento di lavoro per il team Adobe. Fonti pubbliche citate; nessun dato contrattuale o economico. Da non far circolare fuori da Adobe."
          fr="Document de travail pour l'équipe Adobe. Sources publiques citées ; aucune donnée contractuelle ou financière. À ne pas diffuser hors d'Adobe."
          as="span"
        />
      </p>
    </header>

    <main class="dw-main">

      <!-- 1 · Executive summary -->
      <section class="dw-section" aria-labelledby="dw-h-summary">
        <h2 class="dw-h" id="dw-h-summary">
          <span class="dw-h-num">01</span>
          <T en="Executive summary" it="Executive summary" fr="Résumé exécutif" as="span" />
        </h2>
        <ul class="dw-list">
          {summary.map((s) => (
            <li class="dw-li"><T en={s.en} it={s.it} fr={s.fr} as="span" /></li>
          ))}
        </ul>
      </section>

      <!-- 2 · Mission brief -->
      <section class="dw-section" aria-labelledby="dw-h-missione">
        <h2 class="dw-h" id="dw-h-missione">
          <span class="dw-h-num">02</span>
          <T en="Mission brief" it="Mission brief" fr="Brief de mission" as="span" />
        </h2>
        <ul class="dw-list">
          {missione.obiettivi.map((o) => (
            <li class="dw-li"><T en={o.en} it={o.it} fr={o.fr} as="span" /></li>
          ))}
        </ul>
      </section>

      <!-- 3 · Chessa -->
      <section class="dw-section" aria-labelledby="dw-h-chessa">
        <h2 class="dw-h" id="dw-h-chessa">
          <span class="dw-h-num">03</span>
          <T en="Who is Costantino Chessa" it="Chi è Costantino Chessa" fr="Qui est Costantino Chessa" as="span" />
        </h2>
        <div class="dw-timeline">
          {carriera.map((c) => (
            <div class="dw-tl-row">
              <span class="dw-tl-years">{c.anni}</span>
              <span class="dw-tl-role"><T en={c.ruolo.en} it={c.ruolo.it} fr={c.ruolo.fr} as="span" /></span>
            </div>
          ))}
        </div>
        <ul class="dw-list">
          {chessaCome.map((c) => (
            <li class="dw-li"><T en={c.en} it={c.it} fr={c.fr} as="span" /></li>
          ))}
        </ul>
        <div class="dw-video">
          <iframe
            src="https://www.youtube.com/embed/2qyIQJMpml0?start=420&rel=0"
            title="Costantino Chessa — PoliS-Lombardia, aprile 2026"
            allow="encrypted-media; picture-in-picture"
            allowfullscreen
            loading="lazy"
          ></iframe>
          <p class="dw-caption">
            <T
              en="PoliS-Lombardia, April 29, 2026 — cued to ~07:00, just before the 'decision-making infrastructure' passage."
              it="PoliS-Lombardia, 29 aprile 2026 — posizionato a ~07:00, poco prima del passaggio su «infrastruttura decisionale»."
              fr="PoliS-Lombardia, 29 avril 2026 — calé à ~07:00, juste avant le passage sur « l'infrastructure décisionnelle »."
              as="span"
            />
          </p>
        </div>
      </section>

      <!-- 4 · I fatti -->
      <section class="dw-section" aria-labelledby="dw-h-fatti">
        <h2 class="dw-h" id="dw-h-fatti">
          <span class="dw-h-num">04</span>
          <T en="The verified facts" it="I fatti verificati" fr="Les faits vérifiés" as="span" />
        </h2>
        <p class="dw-note">
          <T
            en="Every claim below survived a 3-vote adversarial check against primary sources (research run: August 27, 2026). Refresh sources on September 8–9."
            it="Ogni affermazione qui sotto ha superato una verifica adversariale a 3 voti su fonti primarie (ricerca del 27 agosto 2026). Rinfrescare le fonti l'8–9 settembre."
            fr="Chaque affirmation ci-dessous a passé une vérification contradictoire à 3 votes sur sources primaires (recherche du 27 août 2026). Rafraîchir les sources les 8–9 septembre."
            as="span"
          />
        </p>
        <ul class="dw-list">
          {fatti.map((f) => (
            <li class="dw-li">
              <span class="dw-chip">{f.badge}</span>
              <T en={f.en} it={f.it} fr={f.fr} as="span" />
            </li>
          ))}
        </ul>
      </section>

      <!-- 5 · Dire / non dire -->
      <section class="dw-section" aria-labelledby="dw-h-dire">
        <h2 class="dw-h" id="dw-h-dire">
          <span class="dw-h-num">05</span>
          <T en="Say / don't say" it="Da dire / da non dire" fr="À dire / à ne pas dire" as="span" />
        </h2>
        <div class="dw-cols">
          <div class="dw-col dw-col--ok">
            <h3 class="dw-col-h"><T en="✓ Say" it="✓ Da dire" fr="✓ À dire" as="span" /></h3>
            <ul class="dw-list">
              {dire.map((d) => (
                <li class="dw-li dw-li--tight"><T en={d.en} it={d.it} fr={d.fr} as="span" /></li>
              ))}
            </ul>
          </div>
          <div class="dw-col dw-col--no">
            <h3 class="dw-col-h"><T en="✗ Don't say" it="✗ Da non dire" fr="✗ À ne pas dire" as="span" /></h3>
            <ul class="dw-list">
              {nonDire.map((d) => (
                <li class="dw-li dw-li--tight"><T en={d.en} it={d.it} fr={d.fr} as="span" /></li>
              ))}
            </ul>
          </div>
        </div>
      </section>

      <!-- 6 · Le persone -->
      <section class="dw-section" aria-labelledby="dw-h-persone">
        <h2 class="dw-h" id="dw-h-persone">
          <span class="dw-h-num">06</span>
          <T en="People map" it="La mappa delle persone" fr="La carte des personnes" as="span" />
        </h2>
        <div class="dw-people">
          {persone.map((p) => (
            <div class="dw-person">
              <p class="dw-person-name">{p.nome}</p>
              <p class="dw-person-role"><T en={p.ruolo.en} it={p.ruolo.it} fr={p.ruolo.fr} as="span" /></p>
              <p class="dw-person-note"><T en={p.nota.en} it={p.nota.it} fr={p.nota.fr} as="span" /></p>
            </div>
          ))}
        </div>
        <p class="dw-note">
          <T
            en="Operational contacts at Eni.com, Plenitude and Enilive are known to the account team from prior workshops; names stay off this page by design."
            it="I referenti operativi di Eni.com, Plenitude ed Enilive sono noti al team account dai workshop precedenti; i nomi restano fuori da questa pagina, per scelta."
            fr="Les contacts opérationnels d'Eni.com, Plenitude et Enilive sont connus de l'équipe compte via les ateliers précédents ; leurs noms restent hors de cette page, par choix."
            as="span"
          />
        </p>
      </section>

      <!-- 7 · Leve e obiezioni -->
      <section class="dw-section" aria-labelledby="dw-h-leve">
        <h2 class="dw-h" id="dw-h-leve">
          <span class="dw-h-num">07</span>
          <T en="Levers, weaknesses, objections" it="Leve, debolezze, obiezioni" fr="Leviers, faiblesses, objections" as="span" />
        </h2>
        <ul class="dw-list">
          {leve.map((l) => (
            <li class="dw-li"><T en={l.en} it={l.it} fr={l.fr} as="span" /></li>
          ))}
        </ul>
      </section>

      <!-- 8 · Run of show -->
      <section class="dw-section" aria-labelledby="dw-h-run">
        <h2 class="dw-h" id="dw-h-run">
          <span class="dw-h-num">08</span>
          <T en="Run of show — 45 minutes" it="Run of show — 45 minuti" fr="Déroulé — 45 minutes" as="span" />
        </h2>
        <div class="dw-timeline">
          {runOfShow.map((r) => (
            <div class="dw-tl-row">
              <span class="dw-tl-years">{r.min}′</span>
              <span class="dw-tl-role"><T en={r.fase.en} it={r.fase.it} fr={r.fase.fr} as="span" /></span>
            </div>
          ))}
        </div>
        <h3 class="dw-sub"><T en="Plan B" it="Piano B" fr="Plan B" as="span" /></h3>
        <ul class="dw-list">
          {pianoB.map((p) => (
            <li class="dw-li"><T en={p.en} it={p.it} fr={p.fr} as="span" /></li>
          ))}
        </ul>
      </section>

      <!-- 9 · Biblioteca -->
      <section class="dw-section" aria-labelledby="dw-h-fonti">
        <h2 class="dw-h" id="dw-h-fonti">
          <span class="dw-h-num">09</span>
          <T en="Library — sources & links" it="Biblioteca — fonti e link" fr="Bibliothèque — sources et liens" as="span" />
        </h2>
        <ul class="dw-sources">
          {biblioteca.map((b) => (
            <li class="dw-source">
              <span class={`dw-chip dw-chip--${b.tipo}`}>{b.tipo}</span>
              <a href={b.url} target="_blank" rel="noopener noreferrer">{b.label}</a>
            </li>
          ))}
        </ul>
      </section>

      <footer class="dw-footer">
        <T
          en="Prepared by the Adobe Italy team with verified public sources · last updated August 28, 2026"
          it="Preparato dal team Adobe Italia su fonti pubbliche verificate · ultimo aggiornamento 28 agosto 2026"
          fr="Préparé par l'équipe Adobe Italie sur sources publiques vérifiées · dernière mise à jour le 28 août 2026"
          as="span"
        />
      </footer>
    </main>
  </div>

  <style>
    .dw-shell {
      min-height: 100dvh;
      background:
        radial-gradient(110% 60% at 20% 0%, rgba(255,206,0,0.07), transparent 55%),
        var(--color-notte);
    }
    .dw-header {
      position: sticky; top: 0; z-index: 40;
      background: rgba(10, 11, 13, 0.94);
      backdrop-filter: blur(8px);
      border-bottom: 1px solid var(--color-carbone);
      padding: 0.9rem clamp(1.25rem, 4vw, 3rem) 0.8rem;
    }
    .dw-header-inner {
      display: flex; align-items: center; justify-content: space-between; gap: 1rem;
      max-width: 62rem; margin-inline: auto; flex-wrap: wrap;
    }
    .dw-header-left { display: flex; align-items: center; gap: 0.9rem; min-width: 0; }
    .dw-badge {
      flex-shrink: 0;
      font-size: 0.68rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase;
      color: var(--color-notte); background: var(--color-giallo);
      padding: 0.25rem 0.6rem; border-radius: 3px;
    }
    .dw-title {
      font-family: var(--font-display); font-weight: 600; letter-spacing: -0.01em;
      font-size: clamp(1.05rem, 2vw, 1.35rem); color: var(--color-avorio); line-height: 1.2;
    }
    .dw-header-right { display: flex; align-items: center; gap: 1.1rem; flex-shrink: 0; }
    .dw-deck-link {
      font-size: 0.8rem; font-weight: 600; color: var(--color-orbita-chiara);
      text-decoration: none; white-space: nowrap;
    }
    .dw-deck-link:hover { text-decoration: underline; }
    .dw-disclaimer {
      max-width: 62rem; margin: 0.45rem auto 0;
      font-size: 0.78rem; line-height: 1.45; color: var(--color-grigio-400);
    }

    .dw-main {
      max-width: 62rem; margin-inline: auto;
      padding: clamp(1.5rem, 4vw, 3rem) clamp(1.25rem, 4vw, 3rem) 4rem;
      display: flex; flex-direction: column; gap: clamp(2rem, 4vw, 3rem);
    }
    .dw-section {
      border-top: 1px solid var(--color-carbone);
      padding-top: clamp(1.25rem, 2.5vw, 2rem);
    }
    .dw-h {
      display: flex; align-items: baseline; gap: 0.8rem;
      font-family: var(--font-display); font-weight: 600; letter-spacing: -0.015em;
      font-size: clamp(1.3rem, 2.4vw, 1.75rem); color: var(--color-avorio);
      margin-bottom: 1.1rem;
    }
    .dw-h-num {
      font-size: 0.8rem; font-weight: 700; letter-spacing: 0.1em;
      color: var(--color-giallo); font-family: var(--font-body);
    }
    .dw-sub {
      font-family: var(--font-display); font-weight: 600; font-size: 1.05rem;
      color: var(--color-avorio); margin: 1.4rem 0 0.7rem;
    }
    .dw-note { font-size: 0.85rem; line-height: 1.5; color: var(--color-grigio-400); margin-bottom: 0.9rem; max-width: none; }

    .dw-list { list-style: none; display: flex; flex-direction: column; gap: 0.8rem; }
    .dw-li {
      position: relative; padding-left: 1.15rem;
      font-size: 0.95rem; line-height: 1.6; color: var(--color-grigio-200);
    }
    .dw-li::before {
      content: ''; position: absolute; left: 0; top: 0.62em;
      width: 7px; height: 7px; border-radius: 50%; background: var(--color-giallo);
    }
    .dw-li--tight { font-size: 0.9rem; }
    .dw-li :global(strong) { color: var(--color-avorio); font-weight: 600; }

    .dw-chip {
      display: inline-flex; margin-right: 0.5rem; padding: 0.12rem 0.5rem; border-radius: 999px;
      font-size: 0.66rem; font-weight: 700; letter-spacing: 0.09em; text-transform: uppercase;
      color: var(--color-notte); background: var(--color-orbita); vertical-align: middle;
    }
    .dw-chip--primaria { background: var(--color-giallo); }
    .dw-chip--stampa   { background: var(--color-orbita); }
    .dw-chip--video    { background: var(--color-ambra); }
    .dw-chip--profilo  { background: var(--color-grigio-300); }

    .dw-timeline { display: flex; flex-direction: column; margin-bottom: 1.1rem; }
    .dw-tl-row {
      display: grid; grid-template-columns: 7.5rem 1fr; gap: 1rem;
      padding: 0.55rem 0; border-top: 1px solid var(--color-carbone);
    }
    .dw-tl-years {
      font-family: var(--font-display); font-weight: 700; font-size: 0.85rem;
      color: var(--color-giallo); letter-spacing: 0.02em; white-space: nowrap;
    }
    .dw-tl-role { font-size: 0.92rem; line-height: 1.5; color: var(--color-grigio-200); }

    .dw-video { margin-top: 1.3rem; }
    .dw-video iframe {
      width: 100%; aspect-ratio: 16 / 9; border: 1px solid var(--color-carbone);
      border-radius: 8px; display: block; background: var(--color-fumo);
    }
    .dw-caption { font-size: 0.8rem; color: var(--color-grigio-400); margin-top: 0.5rem; }

    .dw-cols { display: grid; gap: 1.25rem; grid-template-columns: 1fr; }
    @media (min-width: 760px) { .dw-cols { grid-template-columns: 1fr 1fr; } }
    .dw-col { border: 1px solid var(--color-carbone); border-radius: 8px; padding: 1.1rem 1.2rem; background: rgba(16,17,20,0.6); }
    .dw-col--ok { box-shadow: inset 0 2px 0 0 rgba(255,206,0,0.8); }
    .dw-col--no { box-shadow: inset 0 2px 0 0 rgba(255,120,90,0.75); }
    .dw-col-h { font-family: var(--font-display); font-weight: 600; font-size: 0.98rem; color: var(--color-avorio); margin-bottom: 0.8rem; }
    .dw-col--no .dw-li::before { background: #FF785A; }

    .dw-people { display: grid; gap: 1rem; grid-template-columns: 1fr; margin-bottom: 0.9rem; }
