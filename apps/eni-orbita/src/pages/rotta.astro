---
import BaseLayout from '../layouts/BaseLayout.astro';
import EniNavigation from '../components/EniNavigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import { href } from '@edf/core/utils/url.js';

const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;

const orizzonti = [
  {
    num: 'O1',
    title: 'Dentro Eni SpA',
    quando: 'adesso → fine 2026',
    body: 'I tre cantieri aperti portati a risultato misurabile: voce nei motori AI, journey orchestrati, concierge. Ogni cantiere chiude con un numero.',
  },
  {
    num: 'O2',
    title: 'Il gruppo',
    quando: '2027',
    body: 'Il catalogo di servizi si apre alle società: ognuna con la sua mossa, secondo la mappa. La capogruppo governa, le orbite consumano.',
  },
  {
    num: 'O3',
    title: 'Oltre Eni',
    quando: 'da esplorare insieme',
    body: 'Il Green Data Center vende già servizi AI. Il prossimo scaffale del catalogo possono essere i servizi di esperienza e contenuto: da megawatt a esperienze.',
  },
];

const tappe = [
  {
    tag: 'Si può fare subito',
    body: 'Servizi creativi e di contenuto Adobe dentro le proposte progettuali del Green Data Center, con l\'ecosistema di partner che già le costruisce.',
  },
  {
    tag: 'Con la sovranità',
    body: 'Le opzioni sovereign dei servizi Adobe già esistono sui cloud europei. Un campus AI alimentato a energia decarbonizzata le renderebbe uniche al mondo.',
  },
  {
    tag: 'La visione',
    body: 'Modelli creativi custom addestrati e serviti su calcolo italiano, per le imprese che non possono far uscire il proprio patrimonio visivo. Nessuno lo offre, oggi.',
  },
];

const richieste = [
  {
    num: '1',
    title: 'Le vostre priorità sulla mappa',
    body: 'Sei traiettorie e una mappa delle società: ci basta sapere quali tre contano di più per voi nei prossimi sei mesi.',
  },
  {
    num: '2',
    title: 'Un referente per ogni orbita',
    body: 'Per le società dove non siamo mai entrati chiediamo un nome e una presentazione. Una in particolare: la società della mobilità.',
  },
  {
    num: '3',
    title: 'Un tavolo con la Comunicazione',
    body: 'La voce del gruppo nei motori AI è un tema di reputazione prima che di tecnologia: vorremmo lavorarci con chi la reputazione la custodisce.',
  },
  {
    num: '4',
    title: 'Un caso concreto entro fine anno',
    body: 'Un working group su un solo caso, con una data e un numero da raggiungere. Il resto della relazione si costruisce su quello.',
  },
];
---
<BaseLayout
  title="La rotta"
  description="Tre orizzonti e quattro richieste concrete: dentro Eni, il gruppo, oltre Eni. Eni × Adobe."
>
  <div class="fixed top-0 left-0 right-0 z-50">
    <EniNavigation currentPath={currentPath} base={base} />
  </div>

  <DeckContainer nextHref={href(base, '/')} prevHref={href(base, '/persone')}>

    <!-- ── SLIDE 0: Cover ─────────────────────────────────────────── -->
    <Slide id="slide-cover" bg="primary" align="center">
      <div slot="backdrop" class="eo-bg"></div>
      <p class="slide-eyebrow text-center text-[var(--accent-primary)] mb-4" data-reveal>
        CAPITOLO 06 · LA ROTTA
      </p>
      <h2
        class="text-[var(--ink-primary)] mb-4 font-[family-name:var(--font-display)] text-center mx-auto"
        style="font-size: clamp(2.2rem, 4vw, 3.8rem); font-weight: 600; line-height: 1.05; letter-spacing: -0.02em; max-width: 16ch;"
        data-reveal
        data-reveal-delay="0.08"
      >
        Tre orizzonti
      </h2>
      <p
        class="text-[var(--ink-secondary)] leading-normal max-w-2xl mx-auto text-center"
        style="font-size: clamp(1.05rem, 1.3vw, 1.3rem);"
        data-reveal
        data-reveal-delay="0.15"
      >
        Una rotta si giudica da dove porta e da quanto è verificabile ogni tappa. La nostra ha
        tre orizzonti: il primo chiude cantieri, il secondo apre il gruppo, il terzo guarda
        fuori. E finisce con quattro richieste precise.
      </p>
    </Slide>

    <!-- ── SLIDE 1: Gli orizzonti ─────────────────────────────────── -->
    <Slide id="slide-orizzonti" bg="primary" align="center">
      <div slot="backdrop" class="eo-bg-soft"></div>
      <p class="slide-eyebrow text-center text-[var(--accent-primary)] mb-4" data-reveal>
        LA SEQUENZA
      </p>
      <h2
        class="text-[var(--ink-primary)] mb-4 font-[family-name:var(--font-display)] text-center mx-auto"
        style="font-size: clamp(1.9rem, 3vw, 2.8rem); font-weight: 600; line-height: 1.07; letter-spacing: -0.02em; max-width: 24ch;"
        data-reveal
        data-reveal-delay="0.08"
      >
        Ogni orizzonte prepara il successivo
      </h2>

      <div class="w-full max-w-6xl mx-auto grid md:grid-cols-3 gap-4" data-reveal data-reveal-delay="0.16">
        {orizzonti.map((o) => (
          <div class="eo-card">
            <div class="flex items-baseline justify-between gap-3 mb-2">
              <span class="font-[family-name:var(--font-display)] font-bold text-[var(--accent-primary)]" style="font-size: 1.5rem;">{o.num}</span>
              <span class="text-[0.75rem] tracking-widest uppercase text-[var(--color-grigio-300)]">{o.quando}</span>
            </div>
            <p class="eo-card-title" style="font-size: 1.25rem;">{o.title}</p>
            <p class="eo-card-body">{o.body}</p>
          </div>
        ))}
      </div>

      <p
        class="mt-6 text-center text-[var(--ink-secondary)] max-w-2xl mx-auto"
        style="font-size: clamp(0.95rem, 1.1vw, 1.1rem);"
        data-reveal
        data-reveal-delay="0.26"
      >
        Il primo orizzonte non chiede nuove decisioni: chiede di portare a valore ciò che è già
        partito. Le decisioni vere riguardano il secondo e il terzo.
      </p>
    </Slide>

    <!-- ── SLIDE 2: Da megawatt a esperienze ──────────────────────── -->
    <Slide id="slide-megawatt" bg="primary" align="center">
      <div slot="backdrop" class="eo-bg"></div>
      <p class="slide-eyebrow text-center text-[var(--accent-primary)] mb-4" data-reveal>
        ORIZZONTE 3 · L'IDEA CHE PORTIAMO IN DONO
      </p>
      <h2
        class="text-[var(--ink-primary)] mb-4 font-[family-name:var(--font-display)] text-center mx-auto"
        style="font-size: clamp(2rem, 3.4vw, 3.2rem); font-weight: 600; line-height: 1.06; letter-spacing: -0.02em; max-width: 18ch;"
        data-reveal
        data-reveal-delay="0.08"
      >
        Da megawatt a esperienze
      </h2>
      <p
        class="text-[var(--ink-secondary)] max-w-2xl mx-auto mb-6 text-center"
        style="font-size: clamp(0.98rem, 1.15vw, 1.15rem);"
        data-reveal
        data-reveal-delay="0.14"
      >
        Vendere servizi applicativi rende più che affittare calcolo, e distingue più di
        qualunque classifica. Chi vi somiglia nel mondo vende potenza o modelli. Il livello
        dell'esperienza non lo presidia nessuno: i mattoni esistono tutti, la combinazione non
        l'ha ancora costruita nessuno.
      </p>

      <div class="w-full max-w-6xl mx-auto grid md:grid-cols-3 gap-4" data-reveal data-reveal-delay="0.2">
        {tappe.map((t, i) => (
          <div class={`eo-panel ${i === 2 ? 'eo-panel--giallo' : 'eo-panel--orbita'}`}>
            <div class="eo-panel-head">
              <span class={`eo-tag ${i === 2 ? '' : 'eo-tag--orbita'}`}>{t.tag}</span>
            </div>
            <p class="eo-panel-body">{t.body}</p>
          </div>
        ))}
      </div>

      <p class="mt-5 text-center text-[0.78rem] tracking-widest uppercase text-[var(--color-grigio-300)]" data-reveal data-reveal-delay="0.28">
        Da esplorare con Adobe corporate · nessuna promessa oggi, un tavolo sì
      </p>
    </Slide>

    <!-- ── SLIDE 3: Le richieste ──────────────────────────────────── -->
    <Slide id="slide-richieste" bg="primary" align="center">
      <div slot="backdrop" class="eo-bg-soft"></div>
      <p class="slide-eyebrow text-center text-[var(--accent-primary)] mb-4" data-reveal>
        PER COMINCIARE
      </p>
      <h2
        class="text-[var(--ink-primary)] mb-4 font-[family-name:var(--font-display)] text-center mx-auto"
        style="font-size: clamp(1.9rem, 3vw, 2.8rem); font-weight: 600; line-height: 1.07; letter-spacing: -0.02em; max-width: 22ch;"
        data-reveal
        data-reveal-delay="0.08"
      >
        Quattro richieste, nessuna firma
      </h2>

      <div class="w-full max-w-5xl mx-auto grid md:grid-cols-2 gap-4" data-reveal data-reveal-delay="0.16">
        {richieste.map((r) => (
          <div class="eo-card">
            <span class="eo-mark" aria-hidden="true">{r.num}</span>
            <p class="eo-card-title">{r.title}</p>
            <p class="eo-card-body">{r.body}</p>
          </div>
        ))}
      </div>

      <p
        class="mt-6 text-center text-[var(--ink-primary)] max-w-2xl mx-auto font-medium"
        style="font-size: clamp(1rem, 1.2vw, 1.2rem);"
        data-reveal
        data-reveal-delay="0.26"
      >
        Una sola identità. Tante orbite. Una piattaforma che le tiene insieme.
      </p>
    </Slide>

  </DeckContainer>
</BaseLayout>
