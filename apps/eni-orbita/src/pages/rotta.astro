---
import BaseLayout from '../layouts/BaseLayout.astro';
import EniNavigation from '../components/EniNavigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import T from '@edf/core/blocks/i18n/T.astro';
import { href } from '@edf/core/utils/url.js';

const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;

const orizzonti = [
  {
    num: 'O1',
    tIt: 'Dentro Eni SpA', tEn: 'Inside Eni SpA',
    qIt: 'adesso → fine 2026', qEn: 'now → end of 2026',
    bIt: 'I tre cantieri aperti portati a risultato misurabile: voce nei motori AI, journey orchestrati, concierge. Ogni cantiere chiude con un numero.',
    bEn: 'The three open streams brought to a measurable result: voice in the AI engines, orchestrated journeys, concierge. Each stream closes with a number.',
  },
  {
    num: 'O2',
    tIt: 'Il gruppo', tEn: 'The group',
    qIt: '2027', qEn: '2027',
    bIt: 'Il catalogo di servizi si apre alle società: ognuna con la sua mossa, secondo la mappa. La capogruppo governa, le orbite consumano.',
    bEn: 'The service catalogue opens up to the companies: each with its own move, following the map. The parent governs, the orbits consume.',
  },
  {
    num: 'O3',
    tIt: 'Oltre Eni', tEn: 'Beyond Eni',
    qIt: 'da esplorare insieme', qEn: 'to explore together',
    bIt: 'Il Green Data Center vende già servizi AI. Il prossimo scaffale del catalogo possono essere i servizi di esperienza e contenuto: da megawatt a esperienze.',
    bEn: 'The Green Data Center already sells AI services. The next shelf in the catalogue can be experience and content services: from megawatts to experiences.',
  },
];

const tappe = [
  {
    tagIt: 'Si può fare subito', tagEn: 'Doable now',
    bIt: 'Servizi creativi e di contenuto Adobe dentro le proposte progettuali del Green Data Center, con l\'ecosistema di partner che già le costruisce.',
    bEn: 'Adobe creative and content services inside the Green Data Center\'s project proposals, with the partner ecosystem that already builds them.',
  },
  {
    tagIt: 'Con la sovranità', tagEn: 'With sovereignty',
    bIt: 'Le opzioni sovereign dei servizi Adobe già esistono sui cloud europei. Un campus AI alimentato a energia decarbonizzata le renderebbe uniche al mondo.',
    bEn: 'Sovereign options for Adobe services already exist on European clouds. An AI campus running on decarbonised energy would make them unique in the world.',
  },
  {
    tagIt: 'La visione', tagEn: 'The vision',
    bIt: 'Modelli creativi custom addestrati e serviti su calcolo italiano, per le imprese che non possono far uscire il proprio patrimonio visivo. Nessuno lo offre, oggi.',
    bEn: 'Custom creative models trained and served on Italian compute, for companies that cannot let their visual estate leave the country. No one offers it today.',
  },
];

const richieste = [
  {
    num: '1',
    tIt: 'Le vostre priorità sulla mappa', tEn: 'Your priorities on the map',
    bIt: 'Sei traiettorie e una mappa delle società: ci basta sapere quali tre contano di più per voi nei prossimi sei mesi.',
    bEn: 'Six trajectories and a map of the companies: we just need to know which three matter most to you over the next six months.',
  },
  {
    num: '2',
    tIt: 'Un referente per ogni orbita', tEn: 'A counterpart for every orbit',
    bIt: 'Per le società dove non siamo mai entrati chiediamo un nome e una presentazione. Una in particolare: la società della mobilità.',
    bEn: 'For the companies we have never entered, we ask for a name and an introduction. One above all: the mobility company.',
  },
  {
    num: '3',
    tIt: 'Un tavolo con la Comunicazione', tEn: 'A table with Communication',
    bIt: 'La voce del gruppo nei motori AI è un tema di reputazione prima che di tecnologia: vorremmo lavorarci con chi la reputazione la custodisce.',
    bEn: 'The group\'s voice in the AI engines is a reputation matter before a technology one: we would like to work on it with the people who guard that reputation.',
  },
  {
    num: '4',
    tIt: 'Un caso concreto entro fine anno', tEn: 'One concrete case by year end',
    bIt: 'Un working group su un solo caso, con una data e un numero da raggiungere. Il resto della relazione si costruisce su quello.',
    bEn: 'A working group on a single case, with a date and a number to hit. The rest of the relationship gets built on that.',
  },
];
---
<BaseLayout
  title="La rotta"
  description="Tre orizzonti e quattro richieste concrete: dentro Eni, il gruppo, oltre Eni. Eni × Adobe."
>
  <div class="fixed top-0 left-0 right-0 z-50">
    <EniNavigation currentPath={currentPath} base={base} />
  </div>

  <DeckContainer nextHref={href(base, '/')} prevHref={href(base, '/persone')}>

    <!-- ── SLIDE 0: Cover ─────────────────────────────────────────── -->
    <Slide id="slide-cover" bg="primary" align="center">
      <div slot="backdrop" class="eo-bg"></div>
      <T
        as="p"
        class="slide-eyebrow text-center text-[var(--accent-primary)] mb-4 block"
        data-reveal
        it="CAPITOLO 06 · LA ROTTA"
        en="CHAPTER 06 · THE ROUTE"
      />
      <T
        as="h2"
        class="text-[var(--ink-primary)] mb-5 font-[family-name:var(--font-display)] text-center mx-auto block"
        style="font-size: clamp(2.2rem, 4vw, 3.8rem); font-weight: 600; line-height: 1.05; letter-spacing: -0.02em; max-width: 16ch;"
        data-reveal
        data-reveal-delay="0.08"
        it="Tre orizzonti"
        en="Three horizons"
      />
      <T
        as="p"
        class="text-[var(--ink-secondary)] leading-normal max-w-2xl mx-auto text-center block"
        style="font-size: clamp(1.05rem, 1.3vw, 1.3rem);"
        data-reveal
        data-reveal-delay="0.15"
        it="Una rotta si giudica da dove porta e da quanto è verificabile ogni tappa. La nostra ha tre orizzonti: il primo chiude cantieri, il secondo apre il gruppo, il terzo guarda fuori. E finisce con quattro richieste precise."
        en="A route is judged by where it leads and how verifiable each leg is. Ours has three horizons: the first closes streams, the second opens the group, the third looks outward. And it ends with four precise asks."
      />
    </Slide>

    <!-- ── SLIDE 1: Gli orizzonti ─────────────────────────────────── -->
    <Slide id="slide-orizzonti" bg="primary" align="center">
      <div slot="backdrop" class="eo-bg-soft"></div>
      <T
        as="p"
        class="slide-eyebrow text-center text-[var(--accent-primary)] mb-4 block"
        data-reveal
        it="LA SEQUENZA"
        en="THE SEQUENCE"
      />
      <T
        as="h2"
        class="text-[var(--ink-primary)] mb-4 font-[family-name:var(--font-display)] text-center mx-auto block"
        style="font-size: clamp(1.9rem, 3vw, 2.8rem); font-weight: 600; line-height: 1.07; letter-spacing: -0.02em; max-width: 24ch;"
        data-reveal
        data-reveal-delay="0.08"
        it="Ogni orizzonte prepara il successivo"
        en="Each horizon prepares the next"
      />

      <div class="w-full max-w-6xl mx-auto grid md:grid-cols-3 gap-4" data-reveal data-reveal-delay="0.16">
        {orizzonti.map((o) => (
          <div class="eo-card">
            <div class="flex items-baseline justify-between gap-3 mb-2">
              <span class="font-[family-name:var(--font-display)] font-bold text-[var(--accent-primary)]" style="font-size: 1.5rem;">{o.num}</span>
              <T as="span" class="text-[0.75rem] tracking-widest uppercase text-[var(--color-grigio-300)]" it={o.qIt} en={o.qEn} />
            </div>
            <T as="p" class="eo-card-title block" style="font-size: 1.25rem;" it={o.tIt} en={o.tEn} />
            <T as="p" class="eo-card-body block" it={o.bIt} en={o.bEn} />
          </div>
        ))}
      </div>

      <T
        as="p"
        class="mt-6 text-center text-[var(--ink-secondary)] max-w-2xl mx-auto block"
        style="font-size: clamp(0.95rem, 1.1vw, 1.1rem);"
        data-reveal
        data-reveal-delay="0.26"
        it="Il primo orizzonte non chiede nuove decisioni: chiede di portare a valore ciò che è già partito. Le decisioni vere riguardano il secondo e il terzo."
        en="The first horizon asks for no new decisions: it asks to bring to value what has already started. The real decisions concern the second and the third."
      />
    </Slide>

    <!-- ── SLIDE 2: Da megawatt a esperienze ──────────────────────── -->
    <Slide id="slide-megawatt" bg="primary" align="center">
      <div slot="backdrop" class="eo-bg"></div>
      <T
        as="p"
        class="slide-eyebrow text-center text-[var(--accent-primary)] mb-4 block"
        data-reveal
        it="ORIZZONTE 3 · L'IDEA CHE PORTIAMO IN DONO"
        en="HORIZON 3 · THE IDEA WE BRING AS A GIFT"
      />
      <T
        as="h2"
        class="text-[var(--ink-primary)] mb-4 font-[family-name:var(--font-display)] text-center mx-auto block"
        style="font-size: clamp(2rem, 3.4vw, 3.2rem); font-weight: 600; line-height: 1.06; letter-spacing: -0.02em; max-width: 18ch;"
        data-reveal
        data-reveal-delay="0.08"
        it="Da megawatt a esperienze"
        en="From megawatts to experiences"
      />
      <T
        as="p"
        class="text-[var(--ink-secondary)] max-w-2xl mx-auto mb-6 text-center block"
        style="font-size: clamp(0.98rem, 1.15vw, 1.15rem);"
        data-reveal
        data-reveal-delay="0.14"
        it="Vendere servizi applicativi rende più che affittare calcolo, e distingue più di qualunque classifica. Chi vi somiglia nel mondo vende potenza o modelli. Il livello dell'esperienza non lo presidia nessuno: i mattoni esistono tutti, la combinazione non l'ha ancora costruita nessuno."
        en="Selling application services returns more than renting compute, and distinguishes more than any ranking. Whoever resembles you in the world sells power or models. No one holds the experience layer: all the bricks exist, no one has built the combination yet."
      />

      <div class="w-full max-w-6xl mx-auto grid md:grid-cols-3 gap-4" data-reveal data-reveal-delay="0.2">
        {tappe.map((t, i) => (
          <div class={`eo-panel ${i === 2 ? 'eo-panel--giallo' : 'eo-panel--orbita'}`}>
            <div class="eo-panel-head">
              <T as="span" class={`eo-tag ${i === 2 ? '' : 'eo-tag--orbita'}`} it={t.tagIt} en={t.tagEn} />
            </div>
            <T as="p" class="eo-panel-body block" it={t.bIt} en={t.bEn} />
          </div>
        ))}
      </div>

      <T
        as="p"
        class="mt-5 text-center text-[0.78rem] tracking-widest uppercase text-[var(--color-grigio-300)] block"
        data-reveal
        data-reveal-delay="0.28"
        it="Da esplorare con Adobe corporate · nessuna promessa oggi, un tavolo sì"
        en="To explore with Adobe corporate · no promise today, a table yes"
      />
    </Slide>

    <!-- ── SLIDE 3: Le richieste ──────────────────────────────────── -->
    <Slide id="slide-richieste" bg="primary" align="center">
      <div slot="backdrop" class="eo-bg-soft"></div>
      <T
        as="p"
        class="slide-eyebrow text-center text-[var(--accent-primary)] mb-4 block"
        data-reveal
        it="PER COMINCIARE"
        en="TO BEGIN"
      />
      <T
        as="h2"
        class="text-[var(--ink-primary)] mb-4 font-[family-name:var(--font-display)] text-center mx-auto block"
        style="font-size: clamp(1.9rem, 3vw, 2.8rem); font-weight: 600; line-height: 1.07; letter-spacing: -0.02em; max-width: 22ch;"
        data-reveal
        data-reveal-delay="0.08"
        it="Quattro richieste, nessuna firma"
        en="Four asks, no signature"
      />

      <div class="w-full max-w-5xl mx-auto grid md:grid-cols-2 gap-4" data-reveal data-reveal-delay="0.16">
        {richieste.map((r) => (
          <div class="eo-card">
            <span class="eo-mark" aria-hidden="true">{r.num}</span>
            <T as="p" class="eo-card-title block" it={r.tIt} en={r.tEn} />
            <T as="p" class="eo-card-body block" it={r.bIt} en={r.bEn} />
          </div>
        ))}
      </div>

      <T
        as="p"
        class="mt-6 text-center text-[var(--ink-primary)] max-w-2xl mx-auto font-medium block"
        style="font-size: clamp(1rem, 1.2vw, 1.2rem);"
        data-reveal
        data-reveal-delay="0.26"
        it="Una sola identità. Tante orbite. Una piattaforma che le tiene insieme."
        en="One identity. Many orbits. One platform holding them together."
      />
    </Slide>

  </DeckContainer>
</BaseLayout>
