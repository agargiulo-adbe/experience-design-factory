---
import BaseLayout from '../layouts/BaseLayout.astro';
import EniNavigation from '../components/EniNavigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import T from '@edf/core/blocks/i18n/T.astro';
import { href } from '@edf/core/utils/url.js';

const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;

const bussola = [
  { it: 'Messaggi e posizionamento del gruppo', en: 'Group messages and positioning' },
  { it: 'Brand, compliance e sicurezza', en: 'Brand, compliance and security' },
  { it: 'Dati, identità e consenso', en: 'Data, identity and consent' },
  { it: 'Un patrimonio di contenuti condiviso', en: 'A shared content estate' },
];

const satelliti = [
  { it: 'Mercati e clienti diversi per ogni società', en: 'Different markets and customers per company' },
  { it: 'Stack tecnologici scelti in autonomia', en: 'Tech stacks chosen autonomously' },
  { it: 'Campagne e offerte con tempi propri', en: 'Campaigns and offers on their own clock' },
  { it: 'Team piccoli che devono correre', en: 'Small teams that need to run' },
];

const domande = [
  {
    num: '1',
    qIt: 'Dove serve più governo, oggi?',
    qEn: 'Where is more governance needed, today?',
    sIt: 'Su quali messaggi, dati o contenuti la capogruppo deve poter dire l\'ultima parola, e dove invece oggi non riesce a dirla?',
    sEn: 'On which messages, data or content should the parent company have the final word, and where is it unable to say it today?',
  },
  {
    num: '2',
    qIt: 'Dove i satelliti devono correre di più?',
    qEn: 'Where should the satellites run faster?',
    sIt: 'Quali società frenano perché aspettano il centro, e quali invece corrono così da sole che il gruppo fatica a riconoscersi?',
    sEn: 'Which companies brake because they wait for the centre, and which run so fast on their own that the group struggles to recognise itself?',
  },
  {
    num: '3',
    qIt: 'Cosa vorrete misurare a fine 2027?',
    qEn: 'What will you want to measure by the end of 2027?',
    sIt: 'Se tra sedici mesi questo lavoro avesse funzionato, da quale numero — o da quale fatto — ve ne accorgereste?',
    sEn: 'If sixteen months from now this work had succeeded, which number, or which fact, would tell you?',
  },
];
---
<BaseLayout
  title="La domanda"
  description="Governance centrale e velocità dei satelliti: la tensione che ogni gruppo deve risolvere. Eni × Adobe."
>
  <div class="fixed top-0 left-0 right-0 z-50">
    <EniNavigation currentPath={currentPath} base={base} />
  </div>

  <DeckContainer nextHref={href(base, '/piattaforma')} prevHref={href(base, '/')}>

    <!-- ── SLIDE 0: Cover ─────────────────────────────────────────── -->
    <Slide id="slide-cover" bg="primary" align="center">
      <div slot="backdrop" class="eo-bg"></div>
      <T
        as="p"
        class="slide-eyebrow text-center text-[var(--accent-primary)] mb-4 block"
        data-reveal
        it="CAPITOLO 01 · LA DOMANDA"
        en="CHAPTER 01 · THE QUESTION"
      />
      <T
        as="h2"
        class="text-[var(--ink-primary)] mb-5 font-[family-name:var(--font-display)] text-center mx-auto block"
        style="font-size: clamp(2.2rem, 4vw, 3.8rem); font-weight: 600; line-height: 1.05; letter-spacing: -0.02em; max-width: 18ch;"
        data-reveal
        data-reveal-delay="0.08"
        it="Prima di proporre, ascoltare"
        en="Listen before proposing"
      />
      <T
        as="p"
        class="text-[var(--ink-secondary)] leading-normal max-w-2xl mx-auto text-center block"
        style="font-size: clamp(1.05rem, 1.3vw, 1.3rem);"
        data-reveal
        data-reveal-delay="0.15"
        it="Ogni gruppo con società forti vive la stessa tensione: il centro vuole coerenza, le società vogliono velocità. Non è un problema da risolvere una volta per tutte. È un equilibrio da regolare, e ognuno lo regola a modo suo. Ci interessa capire il vostro."
        en="Every group with strong companies lives the same tension: the centre wants coherence, the companies want speed. It is not a problem you solve once and for all. It is a balance you keep tuning, and everyone tunes it their own way. We want to understand yours."
      />
    </Slide>

    <!-- ── SLIDE 1: La tensione ───────────────────────────────────── -->
    <Slide id="slide-tensione" bg="primary" align="center">
      <div slot="backdrop" class="eo-bg-soft"></div>
      <T
        as="p"
        class="slide-eyebrow text-center text-[var(--accent-primary)] mb-4 block"
        data-reveal
        it="LA TENSIONE DA REGOLARE"
        en="THE TENSION TO TUNE"
      />
      <T
        as="h2"
        class="text-[var(--ink-primary)] mb-4 font-[family-name:var(--font-display)] text-center mx-auto block"
        style="font-size: clamp(1.9rem, 3vw, 2.8rem); font-weight: 600; line-height: 1.07; letter-spacing: -0.02em; max-width: 24ch;"
        data-reveal
        data-reveal-delay="0.08"
        it="La bussola chiede coerenza. Le orbite chiedono spazio."
        en="The compass asks for coherence. The orbits ask for room."
      />

      <div class="w-full max-w-5xl mx-auto grid md:grid-cols-2 gap-5" data-reveal data-reveal-delay="0.18">
        <div class="eo-panel eo-panel--giallo">
          <div class="eo-panel-head">
            <T as="span" class="eo-tag" it="La bussola · capogruppo" en="The compass · parent company" />
          </div>
          <ul class="flex flex-col gap-2.5">
            {bussola.map((item) => (
              <li class="flex items-start gap-3">
                <span class="eo-node mt-2"></span>
                <T as="span" class="text-[0.98rem] leading-normal text-[var(--color-grigio-200)]" it={item.it} en={item.en} />
              </li>
            ))}
          </ul>
        </div>
        <div class="eo-panel eo-panel--orbita">
          <div class="eo-panel-head">
            <T as="span" class="eo-tag eo-tag--orbita" it="Le orbite · società del gruppo" en="The orbits · group companies" />
          </div>
          <ul class="flex flex-col gap-2.5">
            {satelliti.map((item) => (
              <li class="flex items-start gap-3">
                <span class="eo-node eo-node--orbita mt-2"></span>
                <T as="span" class="text-[0.98rem] leading-normal text-[var(--color-grigio-200)]" it={item.it} en={item.en} />
              </li>
            ))}
          </ul>
        </div>
      </div>

      <T
        as="p"
        class="mt-6 text-center text-[var(--ink-secondary)] max-w-2xl mx-auto block"
        style="font-size: clamp(0.95rem, 1.1vw, 1.1rem);"
        data-reveal
        data-reveal-delay="0.28"
        it="Chi la risolve scegliendo un solo lato perde qualcosa: o l'identità o il mercato. L'infrastruttura giusta permette di non scegliere."
        en="Solve it by picking one side and you lose something: either the identity or the market. The right infrastructure means you don't have to pick."
      />
    </Slide>

    <!-- ── SLIDE 2: Le tre domande ────────────────────────────────── -->
    <Slide id="slide-domande" bg="primary" align="center">
      <div slot="backdrop" class="eo-bg"></div>
      <T
        as="p"
        class="slide-eyebrow text-center text-[var(--accent-primary)] mb-4 block"
        data-reveal
        it="TRE DOMANDE APERTE"
        en="THREE OPEN QUESTIONS"
      />
      <T
        as="h2"
        class="text-[var(--ink-primary)] mb-4 font-[family-name:var(--font-display)] text-center mx-auto block"
        style="font-size: clamp(1.9rem, 3vw, 2.8rem); font-weight: 600; line-height: 1.07; letter-spacing: -0.02em; max-width: 22ch;"
        data-reveal
        data-reveal-delay="0.08"
        it="Quello che vorremmo capire da voi"
        en="What we would like to learn from you"
      />

      <div class="w-full max-w-4xl mx-auto flex flex-col" data-reveal data-reveal-delay="0.18">
        {domande.map((d) => (
          <div class="eo-row">
            <div>
              <span class="eo-mark" aria-hidden="true">{d.num}</span>
            </div>
            <div class="eo-row-body">
              <T
                as="p"
                class="font-[family-name:var(--font-display)] font-semibold text-[var(--ink-primary)] mb-1 block"
                style="font-size: clamp(1.15rem, 1.6vw, 1.5rem); line-height: 1.25;"
                it={d.qIt}
                en={d.qEn}
              />
              <T as="p" class="text-[0.98rem] leading-normal text-[var(--color-grigio-200)] block" it={d.sIt} en={d.sEn} />
            </div>
          </div>
        ))}
      </div>

      <T
        as="p"
        class="mt-6 text-center text-[0.8rem] tracking-widest uppercase text-[var(--color-grigio-300)] block"
        data-reveal
        data-reveal-delay="0.28"
        it="Il resto del percorso cambia forma a seconda delle risposte"
        en="The rest of the journey reshapes around the answers"
      />
    </Slide>

  </DeckContainer>
</BaseLayout>
