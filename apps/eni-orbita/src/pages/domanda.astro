---
import BaseLayout from '../layouts/BaseLayout.astro';
import EniNavigation from '../components/EniNavigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import { href } from '@edf/core/utils/url.js';

const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;

const bussola = [
  'Messaggi e posizionamento del gruppo',
  'Brand, compliance e sicurezza',
  'Dati, identità e consenso',
  'Un patrimonio di contenuti condiviso',
];

const satelliti = [
  'Mercati e clienti diversi per ogni società',
  'Stack tecnologici scelti in autonomia',
  'Campagne e offerte con tempi propri',
  'Team piccoli che devono correre',
];

const domande = [
  {
    num: '1',
    q: 'Dove serve più governo, oggi?',
    sub: 'Su quali messaggi, dati o contenuti la capogruppo deve poter dire l\'ultima parola, e dove invece oggi non riesce a dirla?',
  },
  {
    num: '2',
    q: 'Dove i satelliti devono correre di più?',
    sub: 'Quali società frenano perché aspettano il centro, e quali invece corrono così da sole che il gruppo fatica a riconoscersi?',
  },
  {
    num: '3',
    q: 'Cosa vorrete misurare a fine 2027?',
    sub: 'Se tra sedici mesi questo lavoro avesse funzionato, da quale numero — o da quale fatto — ve ne accorgereste?',
  },
];
---
<BaseLayout
  title="La domanda"
  description="Governance centrale e velocità dei satelliti: la tensione che ogni gruppo deve risolvere. Eni × Adobe."
>
  <div class="fixed top-0 left-0 right-0 z-50">
    <EniNavigation currentPath={currentPath} base={base} />
  </div>

  <DeckContainer nextHref={href(base, '/piattaforma')} prevHref={href(base, '/')}>

    <!-- ── SLIDE 0: Cover ─────────────────────────────────────────── -->
    <Slide id="slide-cover" bg="primary" align="center">
      <div slot="backdrop" class="eo-bg"></div>
      <p class="slide-eyebrow text-center text-[var(--accent-primary)] mb-4" data-reveal>
        CAPITOLO 01 · LA DOMANDA
      </p>
      <h2
        class="text-[var(--ink-primary)] mb-4 font-[family-name:var(--font-display)] text-center mx-auto"
        style="font-size: clamp(2.2rem, 4vw, 3.8rem); font-weight: 600; line-height: 1.05; letter-spacing: -0.02em; max-width: 18ch;"
        data-reveal
        data-reveal-delay="0.08"
      >
        Prima di proporre, ascoltare
      </h2>
      <p
        class="text-[var(--ink-secondary)] leading-normal max-w-2xl mx-auto text-center"
        style="font-size: clamp(1.05rem, 1.3vw, 1.3rem);"
        data-reveal
        data-reveal-delay="0.15"
      >
        Ogni gruppo con società forti vive la stessa tensione: il centro vuole coerenza, le
        società vogliono velocità. Non è un problema da risolvere una volta per tutte. È un
        equilibrio da regolare, e ognuno lo regola a modo suo. Ci interessa capire il vostro.
      </p>
    </Slide>

    <!-- ── SLIDE 1: La tensione ───────────────────────────────────── -->
    <Slide id="slide-tensione" bg="primary" align="center">
      <div slot="backdrop" class="eo-bg-soft"></div>
      <p class="slide-eyebrow text-center text-[var(--accent-primary)] mb-4" data-reveal>
        LA TENSIONE DA REGOLARE
      </p>
      <h2
        class="text-[var(--ink-primary)] mb-4 font-[family-name:var(--font-display)] text-center mx-auto"
        style="font-size: clamp(1.9rem, 3vw, 2.8rem); font-weight: 600; line-height: 1.07; letter-spacing: -0.02em; max-width: 24ch;"
        data-reveal
        data-reveal-delay="0.08"
      >
        La bussola chiede coerenza. Le orbite chiedono spazio.
      </h2>

      <div class="w-full max-w-5xl mx-auto grid md:grid-cols-2 gap-5" data-reveal data-reveal-delay="0.18">
        <div class="eo-panel eo-panel--giallo">
          <div class="eo-panel-head">
            <span class="eo-tag">La bussola · capogruppo</span>
          </div>
          <ul class="flex flex-col gap-2.5">
            {bussola.map((item) => (
              <li class="flex items-start gap-3">
                <span class="eo-node mt-2"></span>
                <span class="text-[0.98rem] leading-normal text-[var(--color-grigio-200)]">{item}</span>
              </li>
            ))}
          </ul>
        </div>
        <div class="eo-panel eo-panel--orbita">
          <div class="eo-panel-head">
            <span class="eo-tag eo-tag--orbita">Le orbite · società del gruppo</span>
          </div>
          <ul class="flex flex-col gap-2.5">
            {satelliti.map((item) => (
              <li class="flex items-start gap-3">
                <span class="eo-node eo-node--orbita mt-2"></span>
                <span class="text-[0.98rem] leading-normal text-[var(--color-grigio-200)]">{item}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <p
        class="mt-6 text-center text-[var(--ink-secondary)] max-w-2xl mx-auto"
        style="font-size: clamp(0.95rem, 1.1vw, 1.1rem);"
        data-reveal
        data-reveal-delay="0.28"
      >
        Chi la risolve scegliendo un solo lato perde qualcosa: o l'identità o il mercato.
        L'infrastruttura giusta permette di non scegliere.
      </p>
    </Slide>

    <!-- ── SLIDE 2: Le tre domande ────────────────────────────────── -->
    <Slide id="slide-domande" bg="primary" align="center">
      <div slot="backdrop" class="eo-bg"></div>
      <p class="slide-eyebrow text-center text-[var(--accent-primary)] mb-4" data-reveal>
        TRE DOMANDE APERTE
      </p>
      <h2
        class="text-[var(--ink-primary)] mb-4 font-[family-name:var(--font-display)] text-center mx-auto"
        style="font-size: clamp(1.9rem, 3vw, 2.8rem); font-weight: 600; line-height: 1.07; letter-spacing: -0.02em; max-width: 22ch;"
        data-reveal
        data-reveal-delay="0.08"
      >
        Quello che vorremmo capire da voi
      </h2>

      <div class="w-full max-w-4xl mx-auto flex flex-col" data-reveal data-reveal-delay="0.18">
        {domande.map((d) => (
          <div class="eo-row">
            <div>
              <span class="eo-mark" aria-hidden="true">{d.num}</span>
            </div>
            <div class="eo-row-body">
              <p class="font-[family-name:var(--font-display)] font-semibold text-[var(--ink-primary)] mb-1" style="font-size: clamp(1.15rem, 1.6vw, 1.5rem); line-height: 1.25;">
                {d.q}
              </p>
              <p class="text-[0.98rem] leading-normal text-[var(--color-grigio-200)]">{d.sub}</p>
            </div>
          </div>
        ))}
      </div>

      <p class="mt-6 text-center text-[0.8rem] tracking-widest uppercase text-[var(--color-grigio-300)]" data-reveal data-reveal-delay="0.28">
        Il resto del percorso cambia forma a seconda delle risposte
      </p>
    </Slide>

  </DeckContainer>
</BaseLayout>
