---
import { href } from '@edf/core/utils/url.js';

interface Props {
  currentPath: string;
  base: string;
}

const { currentPath, base } = Astro.props;

const sections = [
  { slug: 'domanda', label: 'La domanda', solution: null },
  { slug: 'idee',    label: 'Le idee',    solution: 'onboarding,gestore,momento,premialita,journey,contenuti' },
  { slug: 'rotta',   label: 'La rotta',   solution: null },
];

function isActive(slug: string) {
  const norm = currentPath.replace(/\/+$/, '');
  if (slug === '') return norm.endsWith('/isybank-momento') || norm.endsWith('/index');
  return norm.endsWith('/' + slug);
}
---
<nav
  class="flex items-center justify-between px-6 py-3 bg-[var(--color-notte)]/95 backdrop-blur-sm border-b border-[var(--color-carbone)]"
  aria-label="Navigazione esperienza"
>
  <a
    href={href(base, '/')}
    class="flex items-center gap-2.5 no-underline group flex-shrink-0"
    aria-label="Home — Il momento giusto"
  >
    <span class="inline-flex items-center justify-center w-7 h-7 rounded bg-[var(--color-grafite)] flex-shrink-0" aria-hidden="true">
      <svg width="18" height="18" viewBox="0 0 32 32" fill="none">
        <circle cx="11" cy="16" r="6" fill="#1B99FB"/>
        <circle cx="21" cy="16" r="6" fill="#26E5AE"/>
        <circle cx="16" cy="16" r="2.6" fill="#FF6200"/>
      </svg>
    </span>
    <span class="text-sm font-semibold text-white group-hover:text-[var(--color-menta)] transition-colors font-[family-name:var(--font-display)] whitespace-nowrap">
      Il momento giusto
    </span>
    <span class="hidden 2xl:inline text-[0.6rem] font-bold tracking-widest uppercase text-[var(--color-grigio-400)] ml-1 whitespace-nowrap">
      Adobe × Isybank
    </span>
  </a>

  <ol class="hidden md:flex flex-nowrap items-center gap-0.5 min-w-0 overflow-x-auto [scrollbar-width:none] [-ms-overflow-style:none] [&::-webkit-scrollbar]:hidden" role="list">
    {sections.map((s, i) => (
      <li data-nav-solution={s.solution ?? undefined} role="listitem" class="flex-shrink-0">
        <a
          href={href(base, '/' + s.slug)}
          class={[
            'block whitespace-nowrap px-2.5 py-1.5 text-xs font-medium rounded-sm transition-colors no-underline',
            isActive(s.slug)
              ? 'bg-[var(--accent-primary)]/15 text-[var(--color-blu-chiaro)] border border-[var(--accent-primary)]/30'
              : 'text-[var(--color-grigio-300)] hover:text-white hover:bg-[var(--color-carbone)]',
          ].join(' ')}
          aria-current={isActive(s.slug) ? 'page' : undefined}
        >
          <span class="text-[var(--color-grigio-500)] mr-1 tabular-nums">{String(i + 1).padStart(2, '0')}</span>
          {s.label}
        </a>
      </li>
    ))}
  </ol>

  <div class="flex items-center gap-3 flex-shrink-0">
    <a
      href={href(base, '/admin')}
      class="text-[0.7rem] font-semibold tracking-wider uppercase px-3 py-1.5 border border-[var(--color-carbone)] text-[var(--color-grigio-400)] hover:text-white hover:border-[var(--color-grigio-500)] rounded-sm transition-colors no-underline"
      data-admin-only
    >
      Admin
    </a>
  </div>
</nav>
