---
import BaseLayout from '../layouts/BaseLayout.astro';
import IsyNavigation from '../components/IsyNavigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import { href } from '@edf/core/utils/url.js';

const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;

const journey = [
  { num: '01', label: 'La domanda', sub: 'Semplice da aprire. E dopo?', href: '/domanda', solution: null },
  { num: '02', label: 'Le idee',    sub: 'Sei idee, una regola: la semplicità non si tocca', href: '/idee', solution: 'onboarding,gestore,momento,premialita,journey,contenuti' },
  { num: '03', label: 'La rotta',   sub: 'Tre orizzonti, misurati sul 2029', href: '/rotta', solution: null },
];

const momento = [
  { v: '1,2 mln', l: 'clienti', s: 'tre su quattro sotto i 35 anni · lug 2026', tone: 'menta' },
  { v: '€3 mld', l: 'di giacenze', s: '170 mila stipendi accreditati · ago 2026', tone: 'blu' },
  { v: '2 mln', l: 'clienti entro il 2029', s: 'Piano di Impresa 2026-2029 · €100 mln di utile', tone: 'arancio' },
];
---
<BaseLayout
  title="Il momento giusto"
  description="Quello che ti serve, quando ti serve: la relazione con un milione di clienti digitali, letta e orchestrata un momento alla volta. Isybank × Adobe."
>
  <div class="fixed top-0 left-0 right-0 z-50">
    <IsyNavigation currentPath={currentPath} base={base} />
  </div>

  <DeckContainer nextHref={href(base, '/domanda')}>

    <!-- ── SLIDE 0: Cover ─────────────────────────────────────────── -->
    <Slide id="slide-cover" bg="primary" align="center">
      <div slot="backdrop" class="im-bg"></div>

      <div class="im-cover" data-reveal>
        <p class="im-cover-eyebrow">Quello che ti serve · quando ti serve · per un milione di persone</p>

        <div class="im-orbs" aria-hidden="true" data-reveal data-reveal-delay="0.12">
          <svg viewBox="0 0 320 110" preserveAspectRatio="xMidYMid meet" class="im-orbs-svg">
            <circle cx="118" cy="55" r="38" fill="rgba(27,153,251,0.85)"/>
            <circle cx="202" cy="55" r="38" fill="rgba(38,229,174,0.85)"/>
            <circle cx="160" cy="55" r="11" fill="#FF6200"/>
            <circle cx="160" cy="55" r="19" stroke="rgba(255,98,0,0.45)" stroke-width="1.2" fill="none"/>
          </svg>
        </div>

        <h1 class="im-cover-title" data-reveal data-reveal-delay="0.18">Il momento giusto</h1>

        <p class="im-cover-lead" data-reveal data-reveal-delay="0.24">
          Avete costruito la banca che dà quello che serve, quando serve, e più di un milione di persone l'hanno scelta. La prossima sfida non è aprire il conto in pochi minuti: quello è risolto. È restare la banca giusta nei mille momenti che vengono dopo. Qui parliamo di come leggere quei momenti e rispondere, uno alla volta, senza perdere la semplicità.
        </p>

        <div class="im-cobrand" data-reveal data-reveal-delay="0.3">
          <span class="im-cobrand-a">Isybank</span>
          <span class="im-cobrand-x">×</span>
          <span class="im-cobrand-b">Adobe</span>
        </div>

        <p class="im-cover-note" data-reveal data-reveal-delay="0.34">
          Conversazione preparata dal team Adobe Italia · dati pubblici citati alle fonti
        </p>
      </div>
    </Slide>

    <!-- ── SLIDE 1: Il momento ────────────────────────────────────── -->
    <Slide id="slide-momento" bg="primary" align="center">
      <div slot="backdrop" class="im-bg-soft"></div>
      <p class="slide-eyebrow text-center text-[var(--color-menta)] mb-4" data-reveal>Il vostro 2026, visto da fuori</p>
      <h2
        class="text-[var(--ink-primary)] mb-4 font-[family-name:var(--font-display)] text-center mx-auto"
        style="font-size: clamp(2rem, 3.6vw, 3.4rem); font-weight: 700; line-height: 1.06; letter-spacing: -0.02em; max-width: 22ch;"
        data-reveal
        data-reveal-delay="0.08"
      >
        Un milione di persone ha scelto la semplicità
      </h2>
      <p
        class="text-[var(--ink-secondary)] leading-snug max-w-2xl mx-auto mb-6 text-center"
        style="font-size: clamp(1rem, 1.25vw, 1.25rem);"
        data-reveal
        data-reveal-delay="0.15"
      >
        In tre anni Isybank è arrivata a 1,2 milioni di clienti e oltre tre miliardi di giacenze, con tre clienti su quattro sotto i 35 anni. L'iF Design Award ha premiato proprio il gesto più semplice, aprire il conto. Il Piano di Impresa 2026-2029 alza l'asticella: due milioni di clienti e cento milioni di utile entro il 2029. Da qui parte tutto quello che segue.
      </p>

      <div class="w-full max-w-5xl mx-auto grid grid-cols-3 gap-5" data-reveal data-reveal-delay="0.22">
        {momento.map((m) => (
          <div class="text-center p-4 bg-[var(--surface-secondary)] border border-[var(--line-subtle)] rounded-lg">
            <p class={`font-[family-name:var(--font-display)] font-extrabold leading-none mb-2 ${m.tone === 'menta' ? 'text-[var(--color-menta)]' : m.tone === 'blu' ? 'text-[var(--color-blu-chiaro)]' : 'text-[var(--color-arancio-chiaro)]'}`} style="font-size: clamp(1.7rem, 3.2vw, 2.7rem);">{m.v}</p>
            <p class="text-[1rem] font-medium text-[var(--ink-primary)] mb-1">{m.l}</p>
            <p class="text-[0.82rem] text-[var(--color-grigio-300)]">{m.s}</p>
          </div>
        ))}
      </div>
      <p class="mt-5 text-center text-[0.75rem] tracking-widest uppercase text-[var(--color-grigio-300)]">
        Fonti:&nbsp;
        <a href="https://group.intesasanpaolo.com/en/investor-relations/press-releases/2026/07/20260729-ris-1h26-uk" target="_blank" rel="noopener noreferrer" class="underline underline-offset-2">Intesa Sanpaolo, 1H26 (29 lug 2026)</a>
        &nbsp;·&nbsp;
        <a href="https://www.isybank.com/it/news-e-media/news/isybank-3miliardi-giacenze-finanza-giovani.html" target="_blank" rel="noopener noreferrer" class="underline underline-offset-2">isybank.com, 3 ago 2026</a>
        &nbsp;·&nbsp;
        <a href="https://www.isybank.com/it/news-e-media/news/isybank-vince-if-design-award-2026.html" target="_blank" rel="noopener noreferrer" class="underline underline-offset-2">iF Design Award, 5 mag 2026</a>
      </p>
    </Slide>

    <!-- ── SLIDE 2: Il percorso ───────────────────────────────────── -->
    <Slide id="slide-percorso" bg="primary" align="center">
      <div slot="backdrop" class="im-bg"></div>
      <p class="slide-eyebrow text-center text-[var(--color-menta)] mb-4" data-reveal>Il percorso</p>
      <h2
        class="font-[family-name:var(--font-display)] text-[var(--ink-primary)] mb-4 max-w-3xl mx-auto text-center block"
        style="font-size: clamp(1.9rem, 3vw, 2.6rem); font-weight: 700; line-height: 1.08; letter-spacing: -0.02em;"
        data-reveal
        data-reveal-delay="0.08"
      >
        Tre capitoli, un'ora scarsa
      </h2>
      <p
        class="text-[clamp(0.9rem,1.05vw,1.05rem)] text-[var(--ink-secondary)] max-w-2xl mx-auto mb-4 text-center"
        data-reveal
        data-reveal-delay="0.15"
      >
        Prima ascoltiamo, poi proponiamo. Ogni capitolo regge da solo e si può saltare o approfondire. Le idee non sono un catalogo: si aprono solo quelle che il dialogo tocca.
      </p>

      <div class="w-full max-w-5xl mx-auto grid grid-cols-3 auto-rows-fr gap-3 mb-4" data-reveal data-reveal-delay="0.22">
        {journey.map((step) => (
          <a
            href={href(base, step.href)}
            data-nav-solution={step.solution ?? undefined}
            data-edf-journey-card
            class="journey-card h-full px-5 py-4 border border-[var(--line-subtle)] rounded-lg text-left transition-colors no-underline group"
          >
            <p class="text-xs font-semibold text-[var(--color-grigio-400)] mb-1 font-[family-name:var(--font-display)] tabular-nums" data-edf-cardnum>{step.num}</p>
            <p class="text-[1.1rem] font-bold text-[var(--ink-primary)] mb-1 font-[family-name:var(--font-display)] block">{step.label}</p>
            <p class="text-[0.9rem] text-[var(--color-grigio-300)] block">{step.sub}</p>
          </a>
        ))}
      </div>

      <div data-reveal data-reveal-delay="0.35" class="text-center">
        <a
          href={href(base, '/domanda')}
          class="inline-flex items-center gap-3 px-9 py-2.5 text-[clamp(1rem,1.2vw,1.15rem)] font-semibold tracking-wide bg-[var(--color-menta)] text-[var(--color-notte)] hover:bg-[var(--color-menta-chiara)] transition-colors duration-300 rounded-md focus-visible:outline-2 focus-visible:outline-[var(--color-menta)] focus-visible:outline-offset-4 font-[family-name:var(--font-display)] no-underline"
        >
          Inizia il percorso
          <svg width="20" height="20" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>
    </Slide>

  </DeckContainer>

  <style>
    .im-cover {
      display: flex; flex-direction: column; align-items: center; text-align: center;
      gap: 1.1rem; width: 100%; max-width: 60rem; margin-inline: auto;
    }
    .im-cover-eyebrow {
      font-family: var(--font-body); font-weight: 600; font-size: clamp(0.75rem, 0.9vw, 0.9rem);
      letter-spacing: 0.16em; text-transform: uppercase; color: var(--color-menta); margin: 0;
    }
    .im-orbs { width: min(18rem, 50vw); }
    .im-orbs-svg { width: 100%; height: auto; display: block; }
    .im-cover-title {
      font-family: var(--font-display); font-weight: 800; font-size: clamp(3rem, 7vw, 6rem);
      line-height: 1; letter-spacing: -0.035em; color: var(--ink-primary); margin: 0.1rem 0 0;
    }
    .im-cover-lead {
      font-size: clamp(1rem, 1.25vw, 1.2rem); line-height: 1.55; color: var(--color-grigio-200);
      max-width: 46rem; margin: 0 auto; display: block;
    }
    .im-cobrand {
      display: inline-flex; align-items: center; gap: 0.7rem; font-family: var(--font-display);
      font-weight: 700; font-size: clamp(1.05rem, 1.4vw, 1.3rem); letter-spacing: 0.02em; margin-top: 0.1rem;
    }
    .im-cobrand-a, .im-cobrand-b { color: var(--ink-primary); }
    .im-cobrand-x { color: var(--color-arancio); font-weight: 400; }
    .im-cover-note {
      font-size: 0.75rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--color-grigio-300);
      max-width: 42rem; margin: 0 auto; display: block;
    }
  </style>
</BaseLayout>
