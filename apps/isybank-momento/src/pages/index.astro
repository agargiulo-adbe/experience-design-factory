---
import BaseLayout from '../layouts/BaseLayout.astro';
import IsyNavigation from '../components/IsyNavigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import CoBrand from '../components/CoBrand.astro';
import LoopVideo from '@edf/core/blocks/immersive/LoopVideo.astro';
import { href } from '@edf/core/utils/url.js';
import bgMomento from '../assets/generated/bg/soft-1.webp';
import bgPercorso from '../assets/generated/bg/ink-2.webp';

// Clip Firefly (GitHub Release `media`, git-ignored in locale) + poster in /public/media.
const COVER_VIDEO = 'https://github.com/agargiulo-adbe/experience-design-factory/releases/download/media/momento-cover.loop.mp4';

const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;
const coverPoster = `${base.replace(/\/?$/, '/')}media/momento-cover.poster.jpg`;

const journey = [
  { num: '01', label: 'La domanda', sub: 'Semplice da aprire. E dopo?', href: '/domanda', solution: null },
  { num: '02', label: 'Le idee',    sub: 'Sei idee, una regola: la semplicità non si tocca', href: '/idee', solution: 'onboarding,gestore,momento,premialita,journey,contenuti' },
  { num: '03', label: 'La rotta',   sub: 'Tre orizzonti, misurati sul 2029', href: '/rotta', solution: null },
];

const momento = [
  { v: '1,2 mln', l: 'clienti', s: 'tre su quattro sotto i 35 anni · lug-ago 2026', tone: 'menta' },
  { v: '€3 mld', l: 'di giacenze', s: '170 mila stipendi accreditati · ago 2026', tone: 'blu' },
  { v: '2 mln', l: 'clienti entro il 2029', s: 'Piano di Impresa 2026-2029 · €100 mln di utile', tone: 'arancio' },
];
---
<BaseLayout
  title="Il momento giusto"
  description="Quello che ti serve, quando ti serve: la relazione con un milione di clienti digitali, letta e orchestrata un momento alla volta. Adobe × Isybank."
>
  <div class="fixed top-0 left-0 right-0 z-50">
    <IsyNavigation currentPath={currentPath} base={base} />
  </div>

  <DeckContainer nextHref={href(base, '/domanda')}>

    <!-- ── SLIDE 0: Cover ─────────────────────────────────────────── -->
    <Slide id="slide-cover" bg="primary" align="center">
      <LoopVideo slot="backdrop" src={COVER_VIDEO} poster={coverPoster} scrim="im-cover-bg" opacity={1} />

      <div class="im-cover" data-reveal>
        <CoBrand variant="hero" class="im-cover-lockup" data-reveal />

        <h1 class="im-cover-title" data-reveal data-reveal-delay="0.1">Il momento giusto</h1>

        <p class="im-cover-tag" data-reveal data-reveal-delay="0.16">
          Quello che ti serve, quando ti serve, per un milione di persone.
        </p>

        <p class="im-cover-lead" data-reveal data-reveal-delay="0.22">
          Avete costruito la banca che dà quello che serve, quando serve, e più di un milione di persone l'hanno scelta. Aprire il conto in pochi minuti è un problema risolto. La sfida che viene dopo è restare la banca giusta nei mille momenti successivi: leggerli, e rispondere uno alla volta, senza perdere la semplicità.
        </p>

        <p class="im-cover-note" data-reveal data-reveal-delay="0.3">
          Conversazione preparata dal team Adobe Italia · dati pubblici citati alle fonti · sfondi e video generati con Adobe Firefly, firmati con Content Credentials
        </p>
      </div>
    </Slide>

    <!-- ── SLIDE 1: Il momento ────────────────────────────────────── -->
    <Slide id="slide-momento" bg="primary" align="center">
      <div slot="backdrop" class="im-bg-soft" style={`--bg-src: url(${bgMomento.src})`}></div>
      <div class="im-figures-head" data-reveal>
        <h2 class="im-figures-title">Un milione di persone<br />ha scelto la semplicità</h2>
        <p class="im-figures-lead">
          In tre anni Isybank è arrivata a 1,2 milioni di clienti e oltre tre miliardi di giacenze, con tre clienti su quattro sotto i 35 anni. L'iF Design Award 2026 ha premiato l'intero ecosistema digitale, dall'app al sito. Il Piano di Impresa 2026-2029 alza l'asticella. Da qui parte tutto quello che segue.
        </p>
      </div>

      <!-- I numeri non stanno in tre scatole uguali: stanno su una riga, separati
           da un filo, come tre momenti sulla stessa linea. -->
      <div class="im-figures" data-reveal data-reveal-delay="0.18">
        {momento.map((m) => (
          <div class="im-figure">
            <p class={`im-figure-v im-figure-v--${m.tone}`}>{m.v}</p>
            <p class="im-figure-l">{m.l}</p>
            <p class="im-figure-s">{m.s}</p>
          </div>
        ))}
      </div>

      <p class="im-figures-fonti" data-reveal data-reveal-delay="0.28">
        Fonti:&nbsp;
        <a href="https://group.intesasanpaolo.com/en/investor-relations/press-releases/2026/07/20260729-ris-1h26-uk" target="_blank" rel="noopener noreferrer">Intesa Sanpaolo, 1H26 (29 lug 2026)</a>&nbsp;·&nbsp;<a href="https://www.isybank.com/it/news-e-media/news/isybank-3miliardi-giacenze-finanza-giovani.html" target="_blank" rel="noopener noreferrer">isybank.com, 3 ago 2026</a>&nbsp;·&nbsp;<a href="https://www.isybank.com/it/news-e-media/news/isybank-vince-if-design-award-2026.html" target="_blank" rel="noopener noreferrer">iF Design Award, 5 mag 2026</a>&nbsp;·&nbsp;<a href="https://group.intesasanpaolo.com/en/investor-relations/press-releases/2026/02/20260202-business-plan-uk" target="_blank" rel="noopener noreferrer">Piano di Impresa 2026-2029 (2 feb 2026)</a>
      </p>
    </Slide>

    <!-- ── SLIDE 2: Il percorso ───────────────────────────────────── -->
    <Slide id="slide-percorso" bg="primary" align="center">
      <div slot="backdrop" class="im-bg" style={`--bg-src: url(${bgPercorso.src})`}></div>
      <p class="slide-eyebrow text-center text-[var(--color-menta)] mb-4" data-reveal>Il percorso</p>
      <h2
        class="font-[family-name:var(--font-display)] text-[var(--ink-primary)] mb-4 max-w-3xl mx-auto text-center block"
        style="font-size: clamp(1.9rem, 3vw, 2.6rem); font-weight: 700; line-height: 1.08; letter-spacing: -0.02em;"
        data-reveal
        data-reveal-delay="0.08"
      >
        Tre capitoli, da percorrere insieme
      </h2>
      <p
        class="text-[clamp(0.9rem,1.05vw,1.05rem)] text-[var(--ink-secondary)] max-w-2xl mx-auto mb-4 text-center"
        data-reveal
        data-reveal-delay="0.15"
      >
        Cominciamo ascoltando voi. Poi la domanda che ci ha portati qui, le idee che ne nascono e la rotta per provarle. Si entra dove porta la conversazione e ci si ferma dove vale la pena.
      </p>

      <div class="w-full max-w-5xl mx-auto grid grid-cols-3 auto-rows-fr gap-3 mb-4" data-reveal data-reveal-delay="0.22">
        {journey.map((step) => (
          <a
            href={href(base, step.href)}
            data-nav-solution={step.solution ?? undefined}
            data-edf-journey-card
            class="journey-card h-full px-5 py-4 border border-[var(--line-subtle)] rounded-lg text-left transition-colors no-underline group"
          >
            <p class="text-xs font-semibold text-[var(--color-grigio-400)] mb-1 font-[family-name:var(--font-display)] tabular-nums" data-edf-cardnum>{step.num}</p>
            <p class="text-[1.1rem] font-bold text-[var(--ink-primary)] mb-1 font-[family-name:var(--font-display)] block">{step.label}</p>
            <p class="text-[0.9rem] text-[var(--color-grigio-300)] block">{step.sub}</p>
          </a>
        ))}
      </div>

      <div data-reveal data-reveal-delay="0.35" class="text-center">
        <a
          href={href(base, '/domanda')}
          class="inline-flex items-center gap-3 px-9 py-2.5 text-[clamp(1rem,1.2vw,1.15rem)] font-semibold tracking-wide bg-[var(--color-menta)] text-[var(--color-notte)] hover:bg-[var(--color-menta-chiara)] transition-colors duration-300 rounded-md focus-visible:outline-2 focus-visible:outline-[var(--color-menta)] focus-visible:outline-offset-4 font-[family-name:var(--font-display)] no-underline"
        >
          Inizia il percorso
          <svg width="20" height="20" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>
    </Slide>

  </DeckContainer>

  <style>
    .im-cover {
      display: flex; flex-direction: column; align-items: center; text-align: center;
      gap: 1.1rem; width: 100%; max-width: 60rem; margin-inline: auto;
    }
    /* Il marchio è il lockup: gli respira intorno, non ha bisogno di un segno in più. */
    .im-cover-lockup { margin-bottom: clamp(1.6rem, 3.4vh, 2.8rem); }
    /* La promessa della banca, detta come si direbbe a voce: non un occhiello
       maiuscolo in più. Il verde la lega alla palette senza gridare. */
    .im-cover-tag {
      font-family: var(--font-display);
      font-weight: 500;
      font-size: clamp(1.15rem, 1.65vw, 1.6rem);
      line-height: 1.35;
      letter-spacing: -0.005em;
      color: var(--color-menta);
      max-width: 34ch; margin: 0 auto; display: block;
    }
    .im-cover-title {
      font-family: var(--font-display); font-weight: 800; font-size: clamp(3rem, 7vw, 6rem);
      line-height: 1; letter-spacing: -0.035em; color: var(--ink-primary); margin: 0.1rem 0 0;
    }
    .im-cover-lead {
      font-size: clamp(1rem, 1.2vw, 1.15rem); line-height: 1.6; color: var(--color-grigio-200);
      max-width: 62ch; margin: 0 auto; display: block;
    }
    /* La nota stava su un fondo che il video schiarisce: a grigio-300 spariva.
       Grigio-200 pieno, tracking più corto, e lo scrim sotto fa il resto. */
    .im-cover-note {
      font-size: 0.76rem; letter-spacing: 0.1em; text-transform: uppercase; line-height: 1.7;
      color: var(--color-grigio-200);
      max-width: 64ch; margin: 0 auto; display: block;
    }
  </style>
</BaseLayout>
