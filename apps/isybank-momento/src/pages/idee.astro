---
import BaseLayout from '../layouts/BaseLayout.astro';
import IsyNavigation from '../components/IsyNavigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import { href } from '@edf/core/utils/url.js';
import bgCover from '../assets/generated/bg/ink-4.webp';
import bgOnboarding from '../assets/generated/bg/soft-4.webp';
import bgGestore from '../assets/generated/bg/soft-5.webp';
import bgMomento from '../assets/generated/bg/soft-6.webp';
import bgPremialita from '../assets/generated/bg/soft-7.webp';
import bgJourney from '../assets/generated/bg/soft-8.webp';
import bgContenuti from '../assets/generated/bg/soft-9.webp';
const BG: Record<string, string> = { onboarding: bgOnboarding.src, gestore: bgGestore.src, momento: bgMomento.src, premialita: bgPremialita.src, journey: bgJourney.src, contenuti: bgContenuti.src };

const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;

const ALL_IDS = ['onboarding', 'gestore', 'momento', 'premialita', 'journey', 'contenuti'];

interface Idea {
  id: string;
  stato: 'estende' | 'nuovo';
  ey: string;
  t: string;
  da: string;
  a: string;
  mossa: string;
  adobe: string;
  fonti: { l: string; u: string }[];
}

const idee: Idea[] = [
  {
    id: 'onboarding',
    stato: 'estende',
    ey: 'Idea 1 · I primi novanta giorni',
    t: 'I primi novanta giorni decidono la banca principale',
    da: 'L\'esperienza digitale di Isybank, apertura del conto compresa, ha vinto l\'iF Design Award. Poi il cliente resta solo: la carta arriva, le notifiche sono uguali per tutti, e lo stipendio si accredita o no nelle prime settimane, senza che nessuno accompagni la scelta.',
    a: 'Un percorso di novanta giorni che legge i segnali reali (prima spesa con la carta, primo bonifico, utenza domiciliata, app aperta tre volte in una settimana) e propone il passo giusto: in app, con una notifica, o per mano di un gestore. Misurato sulla primacy, non sui click.',
    mossa: 'Prima mossa: disegnare insieme il journey dei primi novanta giorni su una coorte di nuovi clienti, con un solo indicatore: quanti accreditano lo stipendio entro tre mesi.',
    adobe: 'Adobe Real-Time CDP · Adobe Journey Optimizer',
    fonti: [
      { l: 'iF Design Award, 5 mag 2026', u: 'https://www.isybank.com/it/news-e-media/news/isybank-vince-if-design-award-2026.html' },
      { l: 'isybank.com, 3 ago 2026', u: 'https://www.isybank.com/it/news-e-media/news/isybank-3miliardi-giacenze-finanza-giovani.html' },
    ],
  },
  {
    id: 'gestore',
    stato: 'estende',
    ey: 'Idea 2 · Il gestore che sa già',
    t: 'Il gestore che sa già cosa è successo',
    da: 'Il modello unisce app e tocco umano: oltre 2.300 gestori della Filiale Digitale, anche nel weekend. Il Piano vuole l\'80% delle richieste risolte in automatico nel 2029, dal 30% di oggi. Il rischio è che l\'automatico diventi un muro: il cliente racconta due volte la stessa cosa, e un blocco arriva senza spiegazione.',
    a: 'Un assistente in app, con il tono di Isybank, che risolve le richieste semplici e passa al gestore quelle complesse con il contesto: cosa ha fatto il cliente, cosa ha provato, dove si è fermato. Il gestore parte dal punto giusto, e l\'80% automatico diventa un\'esperienza invece che un filtro.',
    mossa: 'Prima mossa: un caso d\'uso solo, la richiesta di carta di credito che si interrompe. Assistente in app, poi consegna al gestore con il contesto.',
    adobe: 'Adobe Brand Concierge · Adobe Experience Platform · Adobe Journey Optimizer',
    fonti: [
      { l: 'isybank.com, 3 ago 2026', u: 'https://www.isybank.com/it/news-e-media/news/isybank-3miliardi-giacenze-finanza-giovani.html' },
      { l: 'Piano di Impresa 2026-2029 (2 feb 2026)', u: 'https://group.intesasanpaolo.com/en/investor-relations/press-releases/2026/02/20260202-business-plan-uk' },
      { l: 'Trustpilot, set 2026', u: 'https://it.trustpilot.com/review/isybank.com' },
    ],
  },
  {
    id: 'momento',
    stato: 'nuovo',
    ey: 'Idea 3 · I momenti che cambiano il conto',
    t: 'Il compleanno dei 35 anni, e gli altri momenti che contano',
    da: 'L\'offerta è già disegnata sui momenti di vita: isyPrime a canone zero fino ai 35 anni, SpensieRata per rateizzare, isyProtezione, i fondi sostenibili, isySalvadanaio. Ma arriva quando il cliente la cerca, non quando la vive. E dal provvedimento del Garante di marzo deve poggiare su un consenso che ricorda di aver dato.',
    a: 'Contenuti di app e sito che cambiano col momento: chi si avvicina ai 35 anni vede per tempo cosa cambia e perché restare; chi riceve il primo stipendio trova il risparmio a obiettivi; chi fa una spesa grande trova SpensieRata prima di cercarla. Due limiti: una proposta alla volta, dentro le preferenze che ha scelto.',
    mossa: 'Prima mossa: tre momenti, tre varianti ciascuno, un test controllato su sito e app. Si misura cosa cambia davvero prima di estendere.',
    adobe: 'Adobe Target · Adobe Journey Optimizer (decisioning) · Real-Time CDP con consenso e governance del dato',
    fonti: [
      { l: 'Intesa Sanpaolo, 22 lug 2026', u: 'https://group.intesasanpaolo.com/it/newsroom/comunicati-stampa/2026/07/isybank--le-giacenze-superano-3-miliardi-di-euro--la-banca-digit' },
      { l: 'Garante Privacy, provv. 163 del 12 mar 2026', u: 'https://www.gpdp.it/web/guest/home/docweb/-/docweb-display/docweb/10230412' },
    ],
  },
  {
    id: 'premialita',
    stato: 'estende',
    ey: 'Idea 4 · Premiare i comportamenti',
    t: 'Premiare i comportamenti, non i click',
    da: 'isyToken premia i clienti più attivi, isyReward apre esperienze come gli I-Days o il pranzo con Pogačar, Porta un Amico porta clienti nuovi. I vostri dati raccontano giovani attenti al risparmio e alla sostenibilità. La premialità esiste, ma vive a campagne, una alla volta.',
    a: 'Un programma che riconosce i comportamenti che contano (stipendio accreditato, obiettivo di risparmio raggiunto, utenza domiciliata, fondo sostenibile scelto) e li premia nel momento in cui accadono, nella lingua della community. E impara: chi risponde a cosa, e cosa non serve più mandare.',
    mossa: 'Prima mossa: prendere due comportamenti che già premiate e trasformarli in un journey continuo, con la misura dell\'effetto sulla retention a sei mesi.',
    adobe: 'Adobe Journey Optimizer · Real-Time CDP · Customer Journey Analytics',
    fonti: [
      { l: 'isybank.com, 3 ago 2026', u: 'https://www.isybank.com/it/news-e-media/news/isybank-3miliardi-giacenze-finanza-giovani.html' },
      { l: 'isybank.com, isyReward', u: 'https://www.isybank.com/it/isyreward.html' },
    ],
  },
  {
    id: 'journey',
    stato: 'estende',
    ey: 'Idea 5 · Vedere il viaggio intero',
    t: 'Vedere il viaggio intero, da un canale all\'altro',
    da: 'isytech permette di iniziare un\'operazione su un canale e finirla su un altro: app, sito, gestore. Il web analytics in uso racconta bene ogni canale da solo. Manca la vista del viaggio completo per cliente, con dentro il passaggio all\'umano.',
    a: 'Un\'analisi che unisce app, sito, Filiale Digitale e contact center in una sola sequenza per cliente: dove si interrompe la richiesta di carta, quanto pesa un gestore sulla conversione, quali momenti anticipano l\'abbandono. Le risposte alimentano le idee precedenti e i numeri del Piano.',
    mossa: 'Prima mossa: un\'analisi guidata su un solo journey, con i dati che avete già. La richiesta di carta di credito, dall\'app alla consegna.',
    adobe: 'Adobe Customer Journey Analytics, sopra il web analytics già in uso',
    fonti: [
      { l: 'Italpress, 9 giu 2025', u: 'https://www.italpress.com/isybank-valitutti-canale-di-sviluppo-e-cuore-tecnologico-del-gruppo-2/' },
      { l: 'isybank.com, 3 ago 2026', u: 'https://www.isybank.com/it/news-e-media/news/isybank-3miliardi-giacenze-finanza-giovani.html' },
    ],
  },
  {
    id: 'contenuti',
    stato: 'estende',
    ey: 'Idea 6 · Contenuti alla velocità delle promo',
    t: 'Contenuti alla velocità delle promo, visibili anche ai motori AI',
    da: 'Il sito vive su Adobe Experience Manager e le promo cambiano ogni mese: canone azzerato, carta di credito, I-Days, i nuovi atleti. In home lo dichiarate già: uno sfondo generato con l\'AI. Intanto un ventenne chiede a ChatGPT quale banca aprire, e la risposta la scrive qualcun altro.',
    a: 'Una filiera che produce le varianti di ogni promo per segmento e canale, con i guardrail di brand, e un osservatorio su come i motori AI raccontano Isybank rispetto a Revolut, HYPE o BBVA, con le correzioni da fare sul sito.',
    mossa: 'Prima mossa: una baseline di visibilità AI su dieci domande tipiche di un under 35, e una promo prodotta in varianti con approvazione di brand.',
    adobe: 'Adobe GenStudio for Performance Marketing · Adobe Firefly · Adobe Experience Manager (già in casa) · Adobe Brand Visibility',
    fonti: [
      { l: 'isybank.com, home (set 2026)', u: 'https://www.isybank.com/' },
      { l: 'Milano Finanza, 28 mag 2026', u: 'https://www.milanofinanza.it/news/revolut-supera-i-5-milioni-di-clienti-in-italia-e-diventa-la-quinta-banca-del-paese-202605281412375471' },
    ],
  },
];
---
<BaseLayout
  title="Le idee"
  description="Sei idee per diventare la banca del momento giusto: dai primi novanta giorni al viaggio intero. Adobe × Isybank."
  pageSolutions={ALL_IDS}
>
  <div class="fixed top-0 left-0 right-0 z-50">
    <IsyNavigation currentPath={currentPath} base={base} />
  </div>

  <DeckContainer nextHref={href(base, '/rotta')} prevHref={href(base, '/domanda')}>

    <!-- ── SLIDE 0: Cover ─────────────────────────────────────────── -->
    <Slide id="slide-cover" bg="primary" align="center">
      <div slot="backdrop" class="im-bg" style={`--bg-src: url(${bgCover.src})`}></div>
      <p class="slide-eyebrow text-center text-[var(--color-menta)] mb-4 block" data-reveal>Capitolo 02 · Le idee</p>
      <h2
        class="text-[var(--ink-primary)] mb-4 font-[family-name:var(--font-display)] text-center mx-auto block"
        style="font-size: clamp(2.1rem, 3.8vw, 3.6rem); font-weight: 700; line-height: 1.06; letter-spacing: -0.02em; max-width: 20ch;"
        data-reveal
        data-reveal-delay="0.08"
      >
        Sei idee, una regola: la semplicità non si tocca
      </h2>
      <p
        class="text-[var(--ink-secondary)] leading-normal max-w-2xl mx-auto text-center mb-4 block"
        style="font-size: clamp(1.05rem, 1.3vw, 1.3rem);"
        data-reveal
        data-reveal-delay="0.15"
      >
        Ogni idea parte da qualcosa che Isybank ha già in casa e la porta al momento in cui serve al cliente. Nessuna aggiunge un passaggio all'esperienza: tutte ne tolgono uno. Ne percorriamo solo quelle che il dialogo tocca.
      </p>
      <p class="text-center text-[0.8rem] tracking-widest uppercase text-[var(--color-grigio-300)] block" data-reveal data-reveal-delay="0.22">
        Per ogni idea: da dove parte, dove può arrivare, la prima mossa
      </p>
    </Slide>

    <!-- ── SLIDE 1..6: le idee (gated) ────────────────────────────── -->
    {idee.map((t, n) => (
      <Slide id={`slide-${t.id}`} bg="primary" align="left" data-solution={t.id}>
        <div slot="backdrop" class="im-bg-soft" style={`--bg-src: url(${BG[t.id]})`}></div>

        <div class="im-idea">
          <!-- Testata: l'ordinale è il segnaposto dell'idea sul filo, non un numero decorativo -->
          <div class="im-idea-head" data-reveal>
            <span class="im-idea-n" aria-hidden="true">{String(n + 1).padStart(2, '0')}</span>
            <span class="im-idea-name">{t.ey.replace(/^Idea \d+ · /, '')}</span>
            <span class={`im-badge ${t.stato === 'nuovo' ? 'im-badge--nuovo' : 'im-badge--estende'}`}>
              {t.stato === 'nuovo' ? 'nuovo' : 'estende l\'esistente'}
            </span>
          </div>

          <h2 class="im-idea-title" data-reveal data-reveal-delay="0.07">{t.t}</h2>

          <!-- Il passaggio: due stati sullo stesso filo, non due scatole affiancate -->
          <div class="im-shift" data-reveal data-reveal-delay="0.14">
            <div class="im-shift-track" aria-hidden="true">
              <span class="im-shift-dot im-shift-dot--oggi"></span>
              <span class="im-shift-line"></span>
              <span class="im-shift-dot im-shift-dot--poi"></span>
            </div>
            <div class="im-shift-cols">
              <div class="im-shift-col">
                <p class="im-shift-label">Oggi</p>
                <p class="im-shift-text">{t.da}</p>
              </div>
              <div class="im-shift-col">
                <p class="im-shift-label im-shift-label--poi">Il momento giusto</p>
                <p class="im-shift-text">{t.a}</p>
              </div>
            </div>
          </div>

          <p class="im-mossa" data-reveal data-reveal-delay="0.24">
            <span class="im-mossa-mark" aria-hidden="true">→</span>
            <span><span class="im-mossa-label">Prima mossa</span>{t.mossa.replace(/^Prima mossa: /, '')}</span>
          </p>

          <p class="im-idea-foot" data-reveal data-reveal-delay="0.3">
            <span class="im-idea-adobe">{t.adobe}</span>
            <span class="im-idea-sep" aria-hidden="true">·</span>
            <span class="im-idea-fonti">Fonti:&nbsp;
              {t.fonti.map((f, i) => (
                <>
                  {i > 0 && <span>&nbsp;·&nbsp;</span>}
                  <a href={f.u} target="_blank" rel="noopener noreferrer">{f.l}</a>
                </>
              ))}
            </span>
          </p>
        </div>
      </Slide>
    ))}

  </DeckContainer>
</BaseLayout>
