---
import BaseLayout from '../layouts/BaseLayout.astro';
import IsyNavigation from '../components/IsyNavigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import CoBrand from '../components/CoBrand.astro';
import { href } from '@edf/core/utils/url.js';
import bgCover from '../assets/generated/bg/warm-1.webp';
import bgOrizzonti from '../assets/generated/bg/soft-10.webp';
import bgRichieste from '../assets/generated/bg/soft-11.webp';

// Clip Firefly di chiusura (GitHub Release `media`) + poster in /public/media.
const CLOSE_VIDEO = 'https://github.com/agargiulo-adbe/experience-design-factory/releases/download/media/momento-close.mp4';

const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;
const closePoster = `${base.replace(/\/?$/, '/')}media/momento-close.poster.jpg`;

const orizzonti = [
  {
    n: 'O1', when: 'Entro fine 2026', t: 'Leggere',
    body: 'Un journey solo, analizzato con i dati che avete già: la richiesta di carta di credito dall\'app alla consegna. In parallelo, il disegno dei primi novanta giorni con il vostro team prodotto. Nessuna piattaforma nuova, nessuna firma.',
    tone: 'blu',
  },
  {
    n: 'O2', when: '2027', t: 'Rispondere',
    body: 'Il pilota dei primi novanta giorni su una coorte di nuovi clienti e il test dei tre momenti sul sito e in app. Un caso di consegna al gestore con il contesto. Ogni pilota con un indicatore solo e una data per leggerlo.',
    tone: 'menta',
  },
  {
    n: 'O3', when: '2028-2029', t: 'Scalare',
    body: 'Il motore di relazione per due milioni di clienti: premialità che impara, contenuti prodotti in filiera, l\'assistente che sa quando fermarsi. Misurato sugli stessi numeri del Piano: clienti, attività finanziarie, utile.',
    tone: 'arancio',
  },
];

const richieste = [
  { k: 'Il primo journey', v: 'Quale viaggio del cliente vi interessa leggere per primo? Mezza giornata con il vostro team prodotto e dati basta per sceglierlo insieme, con il segnale che conta di più nei novanta giorni.' },
  { k: 'Il passaggio al gestore', v: 'Su quale caso reale vorreste vedere il passaggio dall\'assistente al gestore? Ci mettiamo a disposizione della Filiale Digitale per disegnarlo con chi lo vive ogni giorno.' },
  { k: 'I dati che avete già', v: 'Cosa vi aiuterebbe leggere nel web analytics già in uso? Con quello, senza integrazioni nuove, facciamo insieme la prima analisi del viaggio intero.' },
  { k: 'Il momento per rivedersi', v: 'Quando ha senso rivederci con i numeri in mano, invece che con le slide? Proponiamo entro l\'anno; la data la scegliete voi.' },
];
---
<BaseLayout
  title="La rotta"
  description="Tre orizzonti misurati sull'obiettivo 2029 e quattro domande per costruire insieme il primo passo. Adobe × Isybank."
>
  <div class="fixed top-0 left-0 right-0 z-50">
    <IsyNavigation currentPath={currentPath} base={base} />
  </div>

  <DeckContainer nextHref={href(base, '/')} prevHref={href(base, '/idee')}>

    <!-- ── SLIDE 0: Cover ─────────────────────────────────────────── -->
    <Slide id="slide-cover" bg="primary" align="center">
      <div slot="backdrop" class="im-bg-arancio" style={`--bg-src: url(${bgCover.src})`}></div>
      <p class="slide-eyebrow text-center text-[var(--color-menta)] mb-4 block" data-reveal>Capitolo 03 · La rotta</p>
      <h2
        class="text-[var(--ink-primary)] mb-4 font-[family-name:var(--font-display)] text-center mx-auto block"
        style="font-size: clamp(2.1rem, 3.8vw, 3.6rem); font-weight: 700; line-height: 1.06; letter-spacing: -0.02em; max-width: 20ch;"
        data-reveal
        data-reveal-delay="0.08"
      >
        Tre orizzonti, misurati sul 2029
      </h2>
      <p
        class="text-[var(--ink-secondary)] leading-normal max-w-2xl mx-auto text-center mb-4 block"
        style="font-size: clamp(1.05rem, 1.3vw, 1.3rem);"
        data-reveal
        data-reveal-delay="0.15"
      >
        Il Piano fissa i numeri: due milioni di clienti, otto miliardi di attività finanziarie, cento milioni di utile. Le idee servono se spostano quei numeri. Per questo la rotta parte dal leggere, non dal comprare.
      </p>
      <p class="text-center text-[0.75rem] tracking-widest uppercase text-[var(--color-grigio-300)] block" data-reveal data-reveal-delay="0.22">
        Fonte:&nbsp;<a href="https://group.intesasanpaolo.com/en/investor-relations/press-releases/2026/02/20260202-business-plan-uk" target="_blank" rel="noopener noreferrer" class="underline underline-offset-2">Piano di Impresa 2026-2029 (2 feb 2026)</a>
      </p>
    </Slide>

    <!-- ── SLIDE 1: Orizzonti ─────────────────────────────────────── -->
    <Slide id="slide-orizzonti" bg="primary" align="center">
      <div slot="backdrop" class="im-bg-soft" style={`--bg-src: url(${bgOrizzonti.src})`}></div>
      <p class="slide-eyebrow text-center text-[var(--color-menta)] mb-4" data-reveal>La sequenza</p>
      <h2
        class="text-[var(--ink-primary)] mb-5 font-[family-name:var(--font-display)] text-center mx-auto block"
        style="font-size: clamp(1.9rem, 3vw, 2.8rem); font-weight: 700; line-height: 1.07; letter-spacing: -0.02em; max-width: 24ch;"
        data-reveal
        data-reveal-delay="0.08"
      >
        Leggere, rispondere, scalare
      </h2>
      <div class="w-full max-w-6xl mx-auto grid md:grid-cols-3 auto-rows-fr gap-5" data-reveal data-reveal-delay="0.16">
        {orizzonti.map((o) => (
          <div class={`im-card h-full ${o.tone === 'blu' ? 'im-panel--blu' : o.tone === 'menta' ? 'im-panel--menta' : 'im-panel--arancio'}`}>
            <span class={`im-mark ${o.tone === 'blu' ? 'im-mark--blu' : o.tone === 'arancio' ? 'im-mark--arancio' : ''}`}>{o.n}</span>
            <p class="im-tag" style={o.tone === 'menta' ? 'color: var(--color-menta);' : o.tone === 'arancio' ? 'color: var(--color-arancio-chiaro);' : ''}>{o.when}</p>
            <p class="im-card-title mt-1">{o.t}</p>
            <p class="im-card-body">{o.body}</p>
          </div>
        ))}
      </div>
    </Slide>

    <!-- ── SLIDE 2: Richieste ─────────────────────────────────────── -->
    <Slide id="slide-richieste" bg="primary" align="center">
      <div slot="backdrop" class="im-bg-soft" style={`--bg-src: url(${bgRichieste.src})`}></div>
      <p class="slide-eyebrow text-center text-[var(--color-menta)] mb-4" data-reveal>Da costruire insieme</p>
      <h2
        class="text-[var(--ink-primary)] mb-5 font-[family-name:var(--font-display)] text-center mx-auto block"
        style="font-size: clamp(1.9rem, 3vw, 2.8rem); font-weight: 700; line-height: 1.07; letter-spacing: -0.02em; max-width: 24ch;"
        data-reveal
        data-reveal-delay="0.08"
      >
        Come possiamo esservi utili da subito?
      </h2>
      <div class="w-full max-w-5xl mx-auto flex flex-col" data-reveal data-reveal-delay="0.16">
        {richieste.map((r, i) => (
          <div class="im-row">
            <div><p class="im-row-label"><span class="text-[var(--color-arancio)] mr-2 tabular-nums">0{i + 1}</span>{r.k}</p></div>
            <div><p class="im-row-body">{r.v}</p></div>
          </div>
        ))}
      </div>
      <p class="mt-5 text-center text-[var(--ink-secondary)] mx-auto block" style="font-size: clamp(0.95rem, 1.1vw, 1.1rem); line-height: 1.5; max-width: 44rem;" data-reveal data-reveal-delay="0.24">
        Nessuna firma e nessuna piattaforma nuova: solo un po' del vostro tempo e i dati che avete già. Il resto lo mettiamo noi.
      </p>
    </Slide>

    <!-- ── SLIDE 3: Chiusura ──────────────────────────────────────── -->
    <Slide id="slide-chiusura" bg="primary" align="center">
      <Fragment slot="backdrop">
        <div class="absolute inset-0" style={`background: url(${closePoster}) center / cover no-repeat var(--surface-primary);`} aria-hidden="true"></div>
        <video class="im-video" autoplay muted loop playsinline preload="metadata" poster={closePoster} aria-hidden="true">
          <source src={CLOSE_VIDEO} type="video/mp4" />
        </video>
        <div class="im-bg-arancio"></div>
      </Fragment>
      <p class="slide-eyebrow text-center text-[var(--color-menta)] mb-5" data-reveal>Per chiudere</p>
      <blockquote class="text-center mx-auto" style="max-width: 44rem;" data-reveal data-reveal-delay="0.08">
        <p class="text-[var(--ink-primary)] font-[family-name:var(--font-display)]" style="font-size: clamp(1.7rem, 2.8vw, 2.6rem); font-weight: 700; line-height: 1.15; letter-spacing: -0.02em; max-width: none;">
          «Semplificare non è mai facile.»
        </p>
        <footer class="mt-4 text-[0.8rem] tracking-widest uppercase text-[var(--color-grigio-300)]">
          Antonio Valitutti · <a href="https://www.isybank.com/it/news-e-media/news/if-design-award-2026-intervista-a-valitutti.html" target="_blank" rel="noopener noreferrer" class="underline underline-offset-2">isybank.com, 11 giugno 2026</a>
        </footer>
      </blockquote>
      <p
        class="mt-8 text-center text-[var(--ink-secondary)] mx-auto"
        style="font-size: clamp(1.05rem, 1.3vw, 1.3rem); line-height: 1.5; max-width: 40rem;"
        data-reveal
        data-reveal-delay="0.18"
      >
        Nemmeno restare semplici mentre si cresce a due milioni. È il lavoro che vi proponiamo di fare insieme: un momento alla volta, e misurato.
      </p>
      <div class="im-cobrand-close mt-6" data-reveal data-reveal-delay="0.26">
        <span>Isybank</span><span class="text-[var(--color-arancio)] font-normal">×</span><span>Adobe</span>
      </div>
      <p class="im-firefly mt-4" data-reveal data-reveal-delay="0.3">
        <span class="im-firefly-mark" aria-hidden="true"></span>
        Sfondi e video di questo deck generati con Adobe Firefly, firmati con Content Credentials
      </p>
    </Slide>


    <!--
      La firma di chiusura ha una slide sua: sotto una chiusura già densa il
      lockup grande farebbe sbordare la slide, e per contratto si divide, non si
      comprime. Una chiusura quieta — i due marchi e basta — è anche il modo
      giusto di finire un keynote.
    -->
    <!-- experience a dominante scura: qui il fondo scuro è `primary`, non `inverse`. -->
    <Slide id="slide-signature" bg="primary" align="center">
      <CoBrand variant="hero" data-reveal />
      <a href={href(base, '/')} class="edf-sig-cta" data-reveal data-reveal-delay="0.15">Torna all'inizio →</a>
    </Slide>

  </DeckContainer>

  <style>
    .im-cobrand-close {
      display: inline-flex; align-items: center; gap: 0.7rem; margin-inline: auto;
      font-family: var(--font-display); font-weight: 700; font-size: clamp(1.05rem, 1.4vw, 1.3rem);
      color: var(--ink-primary); letter-spacing: 0.02em;
    }
  </style>
</BaseLayout>
