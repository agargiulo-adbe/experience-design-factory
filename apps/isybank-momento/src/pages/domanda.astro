---
import BaseLayout from '../layouts/BaseLayout.astro';
import IsyNavigation from '../components/IsyNavigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import { href } from '@edf/core/utils/url.js';

const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;

const avete = [
  'Una piattaforma cloud-native, isytech, che lascia iniziare un\'operazione su un canale e finirla su un altro.',
  'Oltre 2.300 gestori della Filiale Digitale, anche nel weekend: il tocco umano che una fintech non ha.',
  'L\'offerta di un gruppo: prestiti, SpensieRata, risparmio a obiettivi, fondi sostenibili, protezione.',
  'Una premialità già viva (isyToken, isyReward, Porta un Amico) e i clienti più giovani del mercato.',
];

const manca = [
  'Leggere il momento di ciascun cliente: lo stipendio che arriva, il compleanno dei 35, la prima spesa grande.',
  'Rispondere lì dove il cliente è, nel tempo in cui conta, con la stessa semplicità dell\'apertura del conto.',
  'Farlo con il consenso in mano e la regola chiara, dopo la lezione del 2026 sui dati dei clienti.',
  'Farlo per 1,2 milioni di persone oggi e per due milioni nel 2029, senza aggiungere persone.',
];

const domande = [
  {
    k: 'Primacy',
    q: 'Quanti dei prossimi clienti faranno di Isybank la banca principale, e cosa lo decide nelle prime settimane?',
    n: 'Oggi gli stipendi accreditati sono 170 mila su 1,2 milioni di clienti. La banca principale, per la maggior parte, è ancora un\'altra.',
  },
  {
    k: 'Tocco umano',
    q: 'Quando un cliente passa dall\'app a un gestore, il gestore sa già cosa è successo prima?',
    n: 'Sei risparmiatori su dieci vogliono una banca digitale con un consulente dedicato; le recensioni pubbliche raccontano blocchi senza spiegazione e chat che si chiudono.',
  },
  {
    k: 'Misura',
    q: 'Quanto dell\'obiettivo 2029 viene dai clienti nuovi e quanto da quelli che avete già? Oggi come lo leggete lungo tutto il viaggio?',
    n: 'I nuovi clienti sono passati da 480 mila nel 2024 a 350 mila nel 2025. La crescita si sposta sulla relazione.',
  },
];
---
<BaseLayout
  title="La domanda"
  description="Semplice da aprire. E dopo? La domanda da cui parte la conversazione tra Isybank e Adobe."
>
  <div class="fixed top-0 left-0 right-0 z-50">
    <IsyNavigation currentPath={currentPath} base={base} />
  </div>

  <DeckContainer nextHref={href(base, '/idee')} prevHref={href(base, '/')}>

    <!-- ── SLIDE 0: Cover ─────────────────────────────────────────── -->
    <Slide id="slide-cover" bg="primary" align="center">
      <div slot="backdrop" class="im-bg"></div>
      <p class="slide-eyebrow text-center text-[var(--color-menta)] mb-4 block" data-reveal>Capitolo 01 · La domanda</p>
      <h2
        class="text-[var(--ink-primary)] mb-4 font-[family-name:var(--font-display)] text-center mx-auto block"
        style="font-size: clamp(2.1rem, 3.8vw, 3.6rem); font-weight: 700; line-height: 1.06; letter-spacing: -0.02em; max-width: 20ch;"
        data-reveal
        data-reveal-delay="0.08"
      >
        Semplice da aprire. E dopo?
      </h2>
      <p
        class="text-[var(--ink-secondary)] leading-normal max-w-2xl mx-auto text-center mb-4 block"
        style="font-size: clamp(1.05rem, 1.3vw, 1.3rem);"
        data-reveal
        data-reveal-delay="0.15"
      >
        Il conto si apre in pochi minuti, e questo è risolto. Ma un cliente fintech tende a usare più operatori, lo scrivete voi stessi. La domanda di questo incontro è come si diventa la banca del momento giusto, non solo del primo.
      </p>
      <p class="text-center text-[0.8rem] tracking-widest uppercase text-[var(--color-grigio-300)] block" data-reveal data-reveal-delay="0.22">
        Prima ascoltare, poi proporre
      </p>
    </Slide>

    <!-- ── SLIDE 1: La tensione ───────────────────────────────────── -->
    <Slide id="slide-tensione" bg="primary" align="center">
      <div slot="backdrop" class="im-bg-soft"></div>
      <p class="slide-eyebrow text-center text-[var(--color-menta)] mb-4" data-reveal>Il punto di partenza</p>
      <h2
        class="text-[var(--ink-primary)] mb-5 font-[family-name:var(--font-display)] text-center mx-auto block"
        style="font-size: clamp(1.9rem, 3vw, 2.8rem); font-weight: 700; line-height: 1.07; letter-spacing: -0.02em; max-width: 24ch;"
        data-reveal
        data-reveal-delay="0.08"
      >
        Avete molto in mano. Manca il tempo giusto.
      </h2>

      <div class="w-full max-w-6xl mx-auto grid md:grid-cols-2 gap-5" data-reveal data-reveal-delay="0.16">
        <div class="im-panel im-panel--blu">
          <div class="im-panel-head"><span class="im-tag">Quello che avete già</span></div>
          <ul class="im-ul">
            {avete.map((t) => <li class="im-li"><span class="im-dot im-dot--blu"></span><span>{t}</span></li>)}
          </ul>
        </div>
        <div class="im-panel im-panel--arancio">
          <div class="im-panel-head"><span class="im-tag im-tag--arancio">Quello che manca a scala</span></div>
          <ul class="im-ul">
            {manca.map((t) => <li class="im-li"><span class="im-dot"></span><span>{t}</span></li>)}
          </ul>
        </div>
      </div>

      <p class="mt-5 text-center text-[0.75rem] tracking-widest uppercase text-[var(--color-grigio-300)]">
        Fonti:&nbsp;
        <a href="https://www.isybank.com/it/news-e-media/news/isybank-3miliardi-giacenze-finanza-giovani.html" target="_blank" rel="noopener noreferrer" class="underline underline-offset-2">isybank.com, 3 ago 2026</a>
        &nbsp;·&nbsp;
        <a href="https://www.gpdp.it/web/guest/home/docweb/-/docweb-display/docweb/10230412" target="_blank" rel="noopener noreferrer" class="underline underline-offset-2">Garante Privacy, 12 mar 2026</a>
      </p>
    </Slide>

    <!-- ── SLIDE 2: Le tre domande ────────────────────────────────── -->
    <Slide id="slide-domande" bg="primary" align="center">
      <div slot="backdrop" class="im-bg"></div>
      <p class="slide-eyebrow text-center text-[var(--color-menta)] mb-4" data-reveal>Tre domande aperte</p>
      <h2
        class="text-[var(--ink-primary)] mb-5 font-[family-name:var(--font-display)] text-center mx-auto block"
        style="font-size: clamp(1.9rem, 3vw, 2.8rem); font-weight: 700; line-height: 1.07; letter-spacing: -0.02em; max-width: 24ch;"
        data-reveal
        data-reveal-delay="0.08"
      >
        Le portiamo noi, le risposte sono vostre
      </h2>

      <div class="w-full max-w-6xl mx-auto flex flex-col" data-reveal data-reveal-delay="0.16">
        {domande.map((d, i) => (
          <div class="im-row">
            <div>
              <p class="im-row-label"><span class="text-[var(--color-arancio)] mr-2 tabular-nums">0{i + 1}</span>{d.k}</p>
            </div>
            <div class="im-row-body">
              <p class="text-[var(--ink-primary)] font-medium" style="font-size: 1.05rem; line-height: 1.4; max-width: none;">{d.q}</p>
              <p class="mt-1.5 text-[var(--color-grigio-300)]" style="font-size: 0.95rem; line-height: 1.5; max-width: none;">{d.n}</p>
            </div>
          </div>
        ))}
      </div>

      <p class="mt-5 text-center text-[0.75rem] tracking-widest uppercase text-[var(--color-grigio-300)]">
        Fonti:&nbsp;
        <a href="https://group.intesasanpaolo.com/it/newsroom/comunicati-stampa/2026/07/isybank--le-giacenze-superano-3-miliardi-di-euro--la-banca-digit" target="_blank" rel="noopener noreferrer" class="underline underline-offset-2">Intesa Sanpaolo, 22 lug 2026</a>
        &nbsp;·&nbsp;
        <a href="https://group.intesasanpaolo.com/en/investor-relations/press-releases/2026/02/20260202-ris-fy25-uk" target="_blank" rel="noopener noreferrer" class="underline underline-offset-2">Intesa Sanpaolo, FY25 (2 feb 2026)</a>
        &nbsp;·&nbsp;
        <a href="https://borsaefinanza.it/ricerca-finer-ing-consulenza-finanziaria-multicanale/" target="_blank" rel="noopener noreferrer" class="underline underline-offset-2">FINER per ING, giu 2026</a>
        &nbsp;·&nbsp;
        <a href="https://it.trustpilot.com/review/isybank.com" target="_blank" rel="noopener noreferrer" class="underline underline-offset-2">Trustpilot, set 2026</a>
      </p>
    </Slide>

  </DeckContainer>

</BaseLayout>
