  { label: 'Intesa Sanpaolo — risultati 1H26 (29 lug 2026): ~1,2 mln clienti Isybank', url: 'https://group.intesasanpaolo.com/en/investor-relations/press-releases/2026/07/20260729-ris-1h26-uk', tipo: 'primaria' },
  { label: 'Intesa Sanpaolo — Isybank, giacenze oltre 3 miliardi (22 lug 2026)', url: 'https://group.intesasanpaolo.com/it/newsroom/comunicati-stampa/2026/07/isybank--le-giacenze-superano-3-miliardi-di-euro--la-banca-digit', tipo: 'primaria' },
  { label: 'isybank.com — intervista a Valitutti «Semplificare non è mai facile» (11 giu 2026)', url: 'https://www.isybank.com/it/news-e-media/news/if-design-award-2026-intervista-a-valitutti.html', tipo: 'primaria' },
  { label: 'isybank.com — iF Design Award 2026 (5 mag 2026)', url: 'https://www.isybank.com/it/news-e-media/news/isybank-vince-if-design-award-2026.html', tipo: 'primaria' },
  { label: 'isybank.com — pilota Euro Digitale (16 lug 2026)', url: 'https://www.isybank.com/it/news-e-media/news/isybank-progetto-pilota-euro-digitale.html', tipo: 'primaria' },
  { label: 'isybank.com — governance (CdA, presidente Profumo)', url: 'https://www.isybank.com/it/governance.html', tipo: 'primaria' },
  { label: 'Bilancio Isybank 2025 (PDF, Intesa Sanpaolo)', url: 'https://group.intesasanpaolo.com/content/dam/portalgroup/repository-documenti/investor-relations/Contenuti/RISORSE/Documenti%20PDF/pdf_bilanci_controllate_25/Isybank-Bilancio_31_12_2025.pdf', tipo: 'primaria' },
  { label: 'Garante Privacy — provvedimento su Intesa Sanpaolo / Isybank (12 mar 2026)', url: 'https://www.gpdp.it/web/guest/home/docweb/-/docweb-display/docweb/10230412', tipo: 'primaria' },
  { label: 'AGCM — provvedimento cautelare PS12660 (28 nov 2023)', url: 'https://www.agcm.it/media/comunicati-stampa/2023/11/PS12660-', tipo: 'primaria' },
  { label: 'Milano Finanza — Valitutti su euro digitale, giovani, cost/income (22 lug 2026)', url: 'https://www.milanofinanza.it/news/valitutti-isybank-bene-euro-digitale-e-clienti-giovani-202607220704006550', tipo: 'stampa' },
  { label: 'ANSA — Valitutti: «Isybank laboratorio di innovazione per l\'intero Gruppo» (11 nov 2025)', url: 'https://www.ansa.it/ansacom/notizie/economia/crif/2025/11/11/valitutti-isybank-e-laboratorio-innovazione-per-intero-gruppo_b2bd4eae-382a-4e82-8791-be3f480768c4.html', tipo: 'stampa' },
  { label: 'CEO Insights / Will Media — podcast con Valitutti (5 nov 2025, trascrizione automatica)', url: 'https://www.youtube.com/watch?v=O5fppjz6lUU', tipo: 'profilo' },
  { label: 'Italpress — Valitutti: «canale di sviluppo e cuore tecnologico del Gruppo» (9 giu 2025)', url: 'https://www.italpress.com/isybank-valitutti-canale-di-sviluppo-e-cuore-tecnologico-del-gruppo-2/', tipo: 'stampa' },
  { label: 'Engage — Claudia Vassena su AI, GEO e Digital Retail (3 lug 2026)', url: 'https://www.engage.it/brand-e-aziende/intesa-sanpaolo--ai-e-trasformazione-digitale-nella-direzione-retail-della-banca-dei-territori-secondo-claudia-vassena.aspx', tipo: 'stampa' },
  { label: 'Digital4 — SAS marketing automation in Intesa Sanpaolo (10 nov 2017)', url: 'https://www.digital4.biz/marketing/big-data-e-analytics/intesa-sanpaolo-la-marketing-automation-e-la-base-del-data-driven-customer-journey/', tipo: 'stampa' },
  { label: 'Milano Finanza — Revolut oltre 5 milioni di clienti in Italia (28 mag 2026)', url: 'https://www.milanofinanza.it/news/revolut-supera-i-5-milioni-di-clienti-in-italia-e-diventa-la-quinta-banca-del-paese-202605281412375471', tipo: 'stampa' },
  { label: 'Borsa e Finanza — ricerca FINER per ING: banca digitale + consulente (22 giu 2026)', url: 'https://borsaefinanza.it/ricerca-finer-ing-consulenza-finanziaria-multicanale/', tipo: 'stampa' },
  { label: 'Adobe — Crédit Agricole Italia customer story', url: 'https://business.adobe.com/uk/customer-success-stories/credit-agricole-italia.html', tipo: 'primaria' },
  { label: 'Adobe — TSB customer story', url: 'https://business.adobe.com/customer-success-stories/tsb-case-study.html', tipo: 'primaria' },
  { label: 'Adobe Experience League — Financial Services use cases (21 mag 2026)', url: 'https://experienceleague.adobe.com/en/docs/blueprints-learn/architecture/industry-use-cases/financial-services-overview', tipo: 'primaria' },
  { label: 'Trustpilot — recensioni Isybank (letto 9 set 2026)', url: 'https://it.trustpilot.com/review/isybank.com', tipo: 'profilo' },
  { label: 'LinkedIn — Antonio Valitutti', url: 'https://www.linkedin.com/in/antonio-valitutti-0b84503', tipo: 'profilo' },
];
---
<BaseLayout
  title="Dossier — Isybank · Antonio Valitutti"
  description="Adobe internal — dossier di preparazione riservato."
  noindex={true}
>
  <div class="dw-shell">
    <header class="dw-header">
      <div class="dw-header-inner">
        <div class="dw-header-left">
          <span class="dw-badge">Adobe internal · Riservato</span>
          <h1 class="dw-title">War Room — Isybank · Antonio Valitutti</h1>
        </div>
        <div class="dw-header-right">
          <a class="dw-deck-link" href={href(base, '/')}>Apri l'esperienza →</a>
        </div>
      </div>
      <p class="dw-disclaimer">
        Documento di lavoro per il team Adobe. Fonti pubbliche citate; nessun dato contrattuale o economico
        (cifre e scadenze dell'installato stanno nel brief locale). Referente cliente: Antonio Valitutti
        (Amministratore Delegato Isybank, Responsabile Direzione Isybank in Intesa Sanpaolo). Incontro: 10 settembre 2026.
        Da non far circolare fuori da Adobe.
      </p>
    </header>

    <main class="dw-main">

      <section class="dw-section" aria-labelledby="dw-h-summary">
        <h2 class="dw-h" id="dw-h-summary"><span class="dw-h-num">01</span>Executive summary</h2>
        <ul class="dw-list">{summary.map((s) => <li class="dw-li" set:html={s} />)}</ul>
      </section>

      <section class="dw-section" aria-labelledby="dw-h-missione">
        <h2 class="dw-h" id="dw-h-missione"><span class="dw-h-num">02</span>Mission brief</h2>
        <ul class="dw-list">{missione.map((o) => <li class="dw-li" set:html={o} />)}</ul>
      </section>

      <section class="dw-section" aria-labelledby="dw-h-persona">
        <h2 class="dw-h" id="dw-h-persona"><span class="dw-h-num">03</span>Chi è Antonio Valitutti</h2>
        <h3 class="dw-sub">Percorso</h3>
        <div class="dw-timeline">
          {carriera.map((c) => (
            <div class="dw-tl-row">
              <span class="dw-tl-year">{c.anno}</span>
              <p class="dw-tl-text">{c.t}</p>
            </div>
          ))}
        </div>
        <h3 class="dw-sub">Come pensa, come parlargli</h3>
        <ul class="dw-list">{comePensa.map((c) => <li class="dw-li" set:html={c} />)}</ul>
        <p class="dw-note">Dettagli utili: sveglia alle 5:55, vive a Biella, moglie e figlia Elettra, ama il Giappone per «un design pulito ed essenziale», porta un anello per i pagamenti wearable, dice che lo smartphone «non ha vita troppo lunga». Insegna volentieri: incontra classi e università, e «se uso più di due volte le stesse slide mi annoio».</p>
      </section>

      <section class="dw-section" aria-labelledby="dw-h-numeri">
        <h2 class="dw-h" id="dw-h-numeri"><span class="dw-h-num">04</span>Isybank in numeri</h2>
        <div class="dw-grid dw-grid--4">
          {numeri.map((n) => (
            <div class="dw-card dw-card--stat">
              <p class="dw-stat-v">{n.v}</p>
              <p class="dw-stat-l">{n.l}</p>
              <p class="dw-stat-s">{n.s}</p>
            </div>
          ))}
        </div>
        <p class="dw-note">Lettura: la base cresce ma l'acquisizione rallenta (480k → 350k nuovi clienti l'anno). Il Piano chiede +1 milione entro il 2029: circa 250 mila l'anno. La crescita del valore si sposta sulla relazione con chi c'è già: primacy, attività finanziarie (da 2,9 a 8 miliardi), retention. È esattamente il terreno delle idee.</p>
      </section>

      <section class="dw-section" aria-labelledby="dw-h-persone">
        <h2 class="dw-h" id="dw-h-persone"><span class="dw-h-num">05</span>La mappa delle persone</h2>
        <div class="dw-grid">
          {persone.map((p) => (
            <div class="dw-card">
              <p class="dw-card-name">{p.nome}</p>
              <p class="dw-card-model">{p.ruolo}</p>
              <p class="dw-card-touch">{p.nota}</p>
            </div>
          ))}
        </div>
        <p class="dw-note">Isybank ha 41 dipendenti: IT, Filiale Digitale e back office sono servizi della Capogruppo. Valitutti è lo sponsor e il proprietario dei casi d'uso; la scelta di piattaforma passa da Banca dei Territori (Vassena) e da C-DAITO (Proverbio). Usare l'incontro per farsi aprire quelle porte.</p>
      </section>

      <section class="dw-section" aria-labelledby="dw-h-fatti">
        <h2 class="dw-h" id="dw-h-fatti"><span class="dw-h-num">06</span>I fatti verificati</h2>
        <p class="dw-note">Tre filoni di deep-research (9 set 2026): azienda (30+ ricerche, bilanci 2024-25), persona (sei trascrizioni video 2019-2025), contesto Intesa/mercato/Adobe. Rinfrescare le fonti prima dell'incontro.</p>
        <ul class="dw-list">
          {fatti.map((f) => (
            <li class="dw-li">
              <span class={`dw-chip ${f.badge === 'attenzione' ? 'dw-chip--warn' : f.badge === 'competitivo' ? 'dw-chip--comp' : ''}`}>{f.badge}</span>
              <span set:html={f.t} />
            </li>
          ))}
        </ul>
      </section>

      <section class="dw-section" aria-labelledby="dw-h-installato">
        <h2 class="dw-h" id="dw-h-installato"><span class="dw-h-num">07</span>Adobe nel perimetro (qualitativo)</h2>
        <div class="dw-rows">
          {installato.map((i) => (
            <div class="dw-row">
              <div>
                <p class="dw-row-k">{i.fam}</p>
                <p class="dw-row-sub">{i.dove}</p>
              </div>
              <p class="dw-row-v">{i.nota}</p>
            </div>
          ))}
        </div>
        <p class="dw-note">Il dettaglio economico e le scadenze sono nel brief locale (`docs/Intesa Sanpaolo/`, git-ignorato). Non citare cifre in sala; il rinnovo del perimetro analytics va gestito con l'account team di Intesa Sanpaolo, non con Valitutti.</p>
      </section>

      <section class="dw-section" aria-labelledby="dw-h-idee">
        <h2 class="dw-h" id="dw-h-idee"><span class="dw-h-num">08</span>Le sei idee</h2>
        <div class="dw-ideas">
          {bigIdeas.map((b) => (
            <article class="dw-idea">
              <span class="dw-chip">{b.tag}</span>
              <h4 class="dw-idea-name">{b.nome}</h4>
              <p class="dw-idea-line"><span class="dw-idea-k">Da dove parte</span> {b.parte}</p>
              <p class="dw-idea-line"><span class="dw-idea-k">Cosa mostriamo</span> {b.cosa}</p>
              <p class="dw-idea-adobe">{b.adobe}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="dw-section" aria-labelledby="dw-h-matrice">
        <h2 class="dw-h" id="dw-h-matrice"><span class="dw-h-num">09</span>Matrice di priorità</h2>
        <div class="dw-table" role="table" aria-label="Matrice di priorità delle idee">
          <div class="dw-tr dw-tr--head" role="row">
            <span role="columnheader">Idea</span>
            <span role="columnheader">Impatto</span>
            <span role="columnheader">Overlap incumbent</span>
            <span role="columnheader">Rischio dati</span>
            <span role="columnheader">Riuso Factory</span>
            <span role="columnheader">Priorità</span>
          </div>
          {priorita.map((r) => (
            <div class="dw-tr" role="row">
              <span role="cell" class="dw-td-idea">{r.idea}</span>
              <span role="cell">{r.impatto}</span>
              <span role="cell">{r.overlap}</span>
              <span role="cell">{r.rischio}</span>
              <span role="cell">{r.riuso}</span>
              <span role="cell"><span class={`dw-p dw-p--${r.p.toLowerCase()}`}>{r.p}</span></span>
            </div>
          ))}
        </div>
        <p class="dw-note">Ordine consigliato in sala: #5 (analytics, terreno Adobe, nessun overlap), #1 (primacy, il suo numero), #2 (tocco umano, la sua USP). #6 se emerge il tema acquisizione o GEO. #3 e #4 solo se lui apre sulla personalizzazione, con il consenso in prima riga.</p>
      </section>

      <section class="dw-section" aria-labelledby="dw-h-proof">
        <h2 class="dw-h" id="dw-h-proof"><span class="dw-h-num">10</span>Proof point Adobe da avere in tasca</h2>
        <div class="dw-rows">
          {proof.map((p) => (
            <div class="dw-row">
              <p class="dw-row-k">{p.chi}</p>
              <p class="dw-row-v">{p.cosa}</p>
            </div>
          ))}
        </div>
      </section>

      <section class="dw-section" aria-labelledby="dw-h-dire">
        <h2 class="dw-h" id="dw-h-dire"><span class="dw-h-num">11</span>Da dire / da non dire</h2>
        <div class="dw-cols">
          <div class="dw-col dw-col--ok">
            <h3 class="dw-col-h">✓ Da dire</h3>
            <ul class="dw-list">{dire.map((d) => <li class="dw-li dw-li--tight" set:html={d} />)}</ul>
          </div>
          <div class="dw-col dw-col--no">
            <h3 class="dw-col-h">✗ Da non dire</h3>
            <ul class="dw-list">{nonDire.map((d) => <li class="dw-li dw-li--tight" set:html={d} />)}</ul>
          </div>
        </div>
      </section>

      <section class="dw-section" aria-labelledby="dw-h-domande">
        <h2 class="dw-h" id="dw-h-domande"><span class="dw-h-num">12</span>Cosa chiedere · Caveat</h2>
        <h3 class="dw-sub">Domande per de-rischiare</h3>
        <ul class="dw-list">{domande.map((d) => <li class="dw-li" set:html={d} />)}</ul>
        <h3 class="dw-sub">Caveat e onestà intellettuale</h3>
        <ul class="dw-list">{caveat.map((c) => <li class="dw-li dw-li--tight" set:html={c} />)}</ul>
      </section>

      <section class="dw-section" aria-labelledby="dw-h-run">
        <h2 class="dw-h" id="dw-h-run"><span class="dw-h-num">13</span>Run of show (60 minuti)</h2>
        <div class="dw-rows">
          {runOfShow.map((r) => (
            <div class="dw-row dw-row--run">
              <p class="dw-row-k"><span class="dw-run-t">{r.t}</span>{r.k}</p>
              <p class="dw-row-v">{r.v}</p>
            </div>
          ))}
        </div>
      </section>

      <section class="dw-section" aria-labelledby="dw-h-fonti">
        <h2 class="dw-h" id="dw-h-fonti"><span class="dw-h-num">14</span>Biblioteca — fonti e link</h2>
        <ul class="dw-sources">
          {biblioteca.map((b) => (
            <li class="dw-source">
              <span class={`dw-chip dw-chip--${b.tipo}`}>{b.tipo}</span>
              <a href={b.url} target="_blank" rel="noopener noreferrer">{b.label}</a>
            </li>
          ))}
        </ul>
      </section>

      <footer class="dw-footer">
        Preparato dal team Adobe Italia su fonti pubbliche verificate (tre filoni di deep-research, ~110 fetch, bilanci
        Isybank 2024-25, sei trascrizioni video) · ultimo aggiornamento 9 settembre 2026
      </footer>
    </main>
  </div>

  <style>
    .dw-shell {
      min-height: 100dvh;
      background:
        radial-gradient(120% 60% at 18% 0%, rgba(27, 153, 251, 0.12), transparent 55%),
        var(--color-notte);
    }
    .dw-header {
      position: sticky; top: 0; z-index: 40;
      background: rgba(11, 13, 16, 0.94);
      backdrop-filter: blur(8px);
      border-bottom: 1px solid var(--color-carbone);
      padding: 0.9rem clamp(1.25rem, 4vw, 3rem) 0.8rem;
    }
    .dw-header-inner {
      display: flex; align-items: center; justify-content: space-between; gap: 1rem;
      max-width: 64rem; margin-inline: auto; flex-wrap: wrap;
    }
    .dw-header-left { display: flex; align-items: center; gap: 0.9rem; min-width: 0; flex-wrap: wrap; }
    .dw-badge {
      flex-shrink: 0;
      font-size: 0.68rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase;
      color: #fff; background: var(--color-arancio);
      padding: 0.25rem 0.6rem; border-radius: 3px;
    }
    .dw-title {
      font-family: var(--font-display); font-weight: 700; letter-spacing: -0.01em;
      font-size: clamp(1.05rem, 2vw, 1.35rem); color: #fff; line-height: 1.2;
    }
    .dw-header-right { display: flex; align-items: center; gap: 1.1rem; flex-shrink: 0; }
    .dw-deck-link { font-size: 0.8rem; font-weight: 600; color: var(--color-menta); text-decoration: none; white-space: nowrap; }
    .dw-deck-link:hover { text-decoration: underline; }
    .dw-disclaimer { max-width: 64rem; margin: 0.5rem auto 0; font-size: 0.8rem; line-height: 1.5; color: var(--color-grigio-300); }

    .dw-main {
      max-width: 64rem; margin-inline: auto;
      padding: clamp(1.5rem, 4vw, 3rem) clamp(1.25rem, 4vw, 3rem) 4rem;
      display: flex; flex-direction: column; gap: clamp(2rem, 4vw, 3rem);
    }
    .dw-section { border-top: 1px solid var(--color-carbone); padding-top: clamp(1.25rem, 2.5vw, 2rem); }
    .dw-h {
      display: flex; align-items: baseline; gap: 0.8rem;
      font-family: var(--font-display); font-weight: 700; letter-spacing: -0.015em;
      font-size: clamp(1.3rem, 2.4vw, 1.75rem); color: #fff; margin-bottom: 1.1rem;
    }
    .dw-h-num { font-size: 0.8rem; font-weight: 700; letter-spacing: 0.1em; color: var(--color-menta); font-family: var(--font-body); }
    .dw-sub { font-family: var(--font-display); font-weight: 700; font-size: 1.05rem; color: #fff; margin: 1.6rem 0 0.9rem; }
    .dw-note { font-size: 0.88rem; line-height: 1.55; color: var(--color-grigio-300); margin-top: 0.9rem; max-width: none; }
    .dw-note :global(strong) { color: #fff; font-weight: 600; }

    .dw-list { list-style: none; display: flex; flex-direction: column; gap: 0.8rem; margin: 0; padding: 0; }
    .dw-li { position: relative; padding-left: 1.15rem; font-size: 0.96rem; line-height: 1.6; color: var(--color-grigio-200); }
    .dw-li::before { content: ''; position: absolute; left: 0; top: 0.62em; width: 7px; height: 7px; border-radius: 50%; background: var(--color-menta); }
    .dw-li--tight { font-size: 0.9rem; }
    .dw-li :global(strong) { color: #fff; font-weight: 600; }
    .dw-li :global(em) { color: var(--color-blu-chiaro); font-style: normal; }

    .dw-chip {
      display: inline-flex; margin-right: 0.5rem; padding: 0.14rem 0.5rem; border-radius: 999px;
      font-size: 0.66rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase;
      color: var(--color-notte); background: var(--color-menta); vertical-align: middle;
    }
    .dw-chip--warn { background: var(--color-arancio); color: #fff; }
    .dw-chip--comp { background: var(--color-blu); color: #fff; }
    .dw-chip--primaria { background: var(--color-menta); }
    .dw-chip--stampa { background: var(--color-blu-chiaro); }
    .dw-chip--profilo { background: var(--color-grigio-300); }

    .dw-timeline { display: flex; flex-direction: column; }
    .dw-tl-row { display: grid; grid-template-columns: 7rem 1fr; gap: 1rem; padding: 0.7rem 0; border-top: 1px solid var(--color-carbone); }
    .dw-tl-year { font-family: var(--font-display); font-weight: 700; color: var(--color-menta); font-size: 0.9rem; letter-spacing: 0.02em; }
    .dw-tl-text { font-size: 0.93rem; line-height: 1.55; color: var(--color-grigio-200); max-width: none; }
    @media (max-width: 640px) { .dw-tl-row { grid-template-columns: 1fr; gap: 0.2rem; } }

    .dw-grid { display: grid; gap: 0.9rem; grid-template-columns: 1fr; }
    @media (min-width: 640px) { .dw-grid { grid-template-columns: 1fr 1fr; } }
    @media (min-width: 900px) { .dw-grid--4 { grid-template-columns: repeat(4, 1fr); } }
    .dw-card { border: 1px solid var(--color-carbone); border-radius: 10px; padding: 1rem 1.1rem; background: rgba(23, 27, 33, 0.6); }
    .dw-card-name { font-family: var(--font-display); font-weight: 700; font-size: 1.02rem; color: #fff; }
    .dw-card-model { font-size: 0.85rem; line-height: 1.45; color: var(--color-blu-chiaro); margin-top: 0.25rem; }
    .dw-card-touch { font-size: 0.88rem; line-height: 1.5; color: var(--color-grigio-200); margin-top: 0.5rem; }
    .dw-card--stat { text-align: center; }
    .dw-stat-v { font-family: var(--font-display); font-weight: 800; font-size: 1.35rem; color: var(--color-menta); letter-spacing: -0.02em; line-height: 1.1; }
    .dw-stat-l { font-size: 0.86rem; line-height: 1.4; color: var(--color-grigio-200); margin-top: 0.4rem; }
    .dw-stat-s { font-size: 0.72rem; color: var(--color-grigio-400); margin-top: 0.4rem; letter-spacing: 0.02em; }

    .dw-rows { display: flex; flex-direction: column; }
    .dw-row { display: grid; grid-template-columns: 13rem 1fr; gap: 1rem; padding: 0.75rem 0; border-top: 1px solid var(--color-carbone); align-items: start; }
    .dw-row-k { font-family: var(--font-display); font-weight: 700; font-size: 0.98rem; color: #fff; line-height: 1.3; }
    .dw-row-sub { font-size: 0.78rem; line-height: 1.4; color: var(--color-blu-chiaro); margin-top: 0.2rem; }
