---
import BaseLayout from '../layouts/BaseLayout.astro';
import { href } from '@edf/core/utils/url.js';

const base = import.meta.env.BASE_URL;

// ── Pagina RISERVATA (Adobe internal) ──────────────────────────────────────
// War room per l'incontro con Antonio Valitutti (AD Isybank), 10 set 2026.
// Orfana (fuori nav) + noindex. Fonti pubbliche verificate (tre filoni di
// deep-research, 9 set 2026: azienda, persona, contesto Intesa/mercato/Adobe).
// NESSUN dato contrattuale o economico nel build: l'installato Adobe è citato
// solo per famiglia di prodotto; cifre e scadenze stanno nel brief locale
// (docs/Intesa Sanpaolo/, git-ignorato).

const summary: string[] = [
  '<strong>Chi è.</strong> Antonio Valitutti, ingegnere elettronico salernitano (Politecnico di Torino, MSE University of Illinois Chicago), ha ideato e guidato <strong>HYPE</strong> nel Gruppo Sella dal 2014 al 2022 (oltre 1,5 milioni di clienti) e dal 1° aprile 2022 costruisce <strong>Isybank</strong>, la banca digitale di Intesa Sanpaolo, dentro la <strong>Banca dei Territori</strong> di Stefano Barrese. Confermato AD nel maggio 2024 con Francesco Profumo presidente.',
  '<strong>Dove sta Isybank.</strong> Lanciata il 15 giugno 2023 su core cloud-native Thought Machine (isytech, Google Cloud + TIM). A metà 2026: <strong>~1,2 milioni di clienti</strong>, oltre 3 miliardi di giacenze, 75% under 35, 170 mila stipendi accreditati, cost/income sotto il 30%, utile 2025 di 18,8 milioni. iF Design Award 2026 per la UX. Il <strong>Piano di Impresa 2026-2029</strong> le chiede 2 milioni di clienti, 8 miliardi di attività finanziarie e 100 milioni di utile.',
  '<strong>Il fatto che cambia la conversazione.</strong> Valitutti definisce Isybank «laboratorio di trasformazione per l\'intero Gruppo»: ciò che si prova qui va a scala su Intesa Sanpaolo. È il frame migliore per Adobe: <em>pilota misurato su Isybank, scala su 24 milioni di clienti del Gruppo</em>. Ma i sistemi (IT, Filiale Digitale, back office) sono in outsourcing dalla Capogruppo: <strong>Isybank ha 41 dipendenti</strong>. La decisione su piattaforme passa da Banca dei Territori (Vassena, marketing digitale) e dal Chief Data, AI &amp; Technology Officer (Proverbio).',
  '<strong>Due vincoli da rispettare.</strong> A marzo 2026 il <strong>Garante Privacy ha sanzionato Intesa Sanpaolo (17,6 milioni)</strong> per la profilazione senza base giuridica dei 2,4 milioni di clienti candidati alla migrazione: la parola «profilazione» è bruciata, ogni idea va detta con «consenso» e «governance del dato». E Valitutti è <strong>scettico sull\'AI spinta dall\'alto</strong>: usa l\'agentic AI solo per «cose di basso valore aggiunto», vuole un\'adozione «consapevole». Niente pitch AI-first.',
  '<strong>La mossa.</strong> Portare una domanda (dalla semplicità dell\'apertura conto alla rilevanza nel tempo: primacy, tocco umano, misura) e sei idee che partono da ciò che Isybank ha già: onboarding premiato, Filiale Digitale con 2.300 gestori, premialità isyToken, sito su Experience Manager, web analytics già in uso. Chiudere con tre orizzonti e quattro richieste senza firma. L\'esperienza <em>Il momento giusto</em> è pronta nella Factory.',
];

const missione: string[] = [
  '<strong>Obiettivo minimo:</strong> uscire con la sua lettura delle priorità 2026-2027 (primacy? retention? crescita nuovi clienti? costo del servizio?), con la mappa di chi decide sulle piattaforme di marketing e dati (Isybank vs Banca dei Territori vs C-DAITO) e con il permesso di tornare con un\'analisi su un journey reale.',
  '<strong>Obiettivo pieno:</strong> un working group per l\'analisi del journey «richiesta carta di credito» sui dati di web analytics che esistono già, il disegno congiunto del pilota «primi novanta giorni» e un\'introduzione a Claudia Vassena (marketing digitale Banca dei Territori, consigliera Isybank) per portare il tema anche al livello di Gruppo.',
  '<strong>Postura:</strong> ascoltare prima, proporre dopo. Valitutti «guarda costantemente i dati», premia l\'errore dichiarato, si annoia con le slide riusate. Ragionare con lui per esperimenti misurabili, non per piattaforme. Ogni idea con un indicatore, una coorte e una data.',
];

const carriera = [
  { anno: '2000-2005', t: 'Politecnico di Torino, Ingegneria Elettronica (con lode). Tesi con l\'Agenzia Spaziale Europea su antenne satellitari multi-beam. Poi MSE alla University of Illinois at Chicago: «ho studiato antenne aerospaziali e poi son finito in banca».' },
  { anno: '2005-2014', t: 'Gruppo Banca Sella: analista, poi Operational Risk Manager (mappatura processi e risk assessment Basilea 2), poi Executive Assistant dell\'AD. «Quando sono entrato in banca non sapevo la differenza tra un assegno e un bonifico».' },
  { anno: '2014-2022', t: 'Ideatore e CEO di HYPE, la prima challenger bank italiana: il selfie come identificazione a distanza, modello freemium «tipo Spotify», customer care tenuto in casa, marketing per comportamenti e non per età. JV illimity-Fabrick nel 2020. Oltre 1,5 milioni di clienti alla sua uscita.' },
  { anno: '2022-oggi', t: 'Chiamato da Carlo Messina dopo il Piano 2022-2025 («è squillato il telefono»). Concepisce Isybank in dieci mesi, lancia il 15 giugno 2023, gestisce la polemica sulla migrazione (autunno 2023, AGCM), porta la banca in utile dal primo esercizio e a 1,2 milioni di clienti nel 2026.' },
];

const comePensa = [
  '<strong>Dati prima di tutto.</strong> «I dati non mentono mai»: legge i numeri ogni giorno, e i numeri che cita da solo sono primacy (stipendi, un miliardo transato al mese), attività (oltre il 90% di clienti attivi) e cost/income al 30%. Ogni idea va agganciata a uno di questi.',
  '<strong>Semplicità come identità.</strong> «Semplificare è stata la missione fin dal primo giorno, a partire dal nome». Ama il design essenziale (il Giappone, l\'iF Award). Un\'idea che aggiunge un passaggio all\'esperienza è già bocciata: ogni proposta deve toglierne uno.',
  '<strong>Human touch come USP.</strong> Lo ha scelto come fattore distintivo nel 2023 («il tastino parla con noi») e lo ripete nel 2026. Le due paure del cliente digitale sono «non ho il controllo di quello che spendo» e «se ho un problema con chi parlo?». La Filiale Digitale è la risposta, e il terreno per l\'idea del gestore che sa già.',
  '<strong>AI con prudenza.</strong> Non si fa leggere né scrivere le email dall\'AI, «sto provando a resistere», vuole capire come cambieranno le abitudini dei clienti. Ma sa che «sarà pervasiva» e che l\'adozione «arriva in modo naturale». Con lui l\'AI si mostra dentro un caso concreto e misurato, mai come tema.',
  '<strong>Laboratorio del Gruppo.</strong> «In Isybank testiamo in anteprima le soluzioni che poi portiamo a scala su Intesa Sanpaolo». È la porta per Adobe: piccolo, veloce, misurabile qui; replicabile su 24 milioni di clienti là.',
  '<strong>Leader-allenatore.</strong> «Non quello che prende le decisioni, ma quello che aiuta gli altri a prenderle»; premiava «il miglior errore del mese»; da ingegnere «tendevo a non ascoltare, l\'ho corretto». Apprezza chi porta un\'analisi onesta, anche scomoda.',
];

