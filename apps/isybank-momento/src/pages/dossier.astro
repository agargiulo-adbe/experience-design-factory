---
import BaseLayout from '../layouts/BaseLayout.astro';
import DossierPage from '@edf/core/blocks/doc/DossierPage.astro';

// ── Pagina RISERVATA (Adobe internal) ──────────────────────────────────────
// Orfana (fuori nav) + noindex. Il contenuto confidenziale NON è nel bundle
// statico: vive in Supabase (tabella restricted_docs, RLS) e si carica solo
// dopo login oppure via secret-link ?t=<uuid> (RPC get_shared_doc).
//
// Il rendering è del motore condiviso `@edf/core/blocks/doc/DossierPage.astro`.
// Qui restano lo slug, il guscio dell'app e la mappatura della palette sul
// contratto `--dw-*`. Migliorare il motore migliora tutti i dossier.
const base = import.meta.env.BASE_URL;
---
<BaseLayout
  title="Dossier — Isybank"
  description="Adobe internal — dossier riservato (accesso ristretto)."
  noindex={true}
>
  <DossierPage
    docSlug="isybank-valitutti"
    title="Dossier — Isybank"
    base={base}
    supabaseUrl={import.meta.env.PUBLIC_SUPABASE_URL ?? ''}
    supabaseAnon={import.meta.env.PUBLIC_SUPABASE_ANON_KEY ?? ''}
    deckHref={base}
    deckLabel="Deck →"
  />

  <style is:global>
    /* Palette isybank (global.css, dal logo isybank.png) sul contratto del motore.
         La menta #26E5AE su notte #0B0D10 dà 12,6:1 e regge come inchiostro di
         accento; l'arancio di marchio resta ai pieni e alle avvertenze. */
    :root {
      --dw-bg: var(--color-notte);
      --dw-tint: rgba(27, 153, 251, 0.12);
      --dw-surface: rgba(23, 27, 33, 0.6);
      --dw-surface-2: rgba(27, 153, 251, 0.16);
      --dw-line: var(--color-carbone);
      --dw-ink: var(--color-grigio-200);
      --dw-ink-soft: var(--color-grigio-300);
      --dw-ink-faint: var(--color-grigio-400);
      --dw-ink-strong: #ffffff;
      --dw-accent: var(--color-menta);
      --dw-fill: var(--color-blu);
      --dw-on-fill: #FFFFFF;
      --dw-warn: var(--color-arancio);
      --dw-on-warn: #FFFFFF;
      --dw-alt: var(--color-blu-chiaro);
      --dw-font-display: var(--font-display);
      --dw-font-body: var(--font-body);
    }
  </style>
</BaseLayout>
