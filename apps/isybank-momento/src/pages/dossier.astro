  { v: '~1,2 mln', l: 'clienti al 30 giugno 2026', s: 'Intesa Sanpaolo, 1H26' },
  { v: '€3,07 mld', l: 'raccolta diretta a fine 2025, «oltre 3 mld» a luglio 2026', s: 'Bilancio 2025 · ISP 22 lug 2026' },
  { v: '75%', l: 'clienti under 35 (50% tra 18 e 25 anni)', s: 'ISP 22 lug 2026' },
  { v: '170k / 260k', l: 'stipendi accreditati / domiciliazioni utenze', s: 'ISP 22 lug 2026' },
  { v: '480k → 350k', l: 'nuovi clienti nel 2024 → nel 2025 (150k nel 1H26)', s: 'Bilanci 2024-25 · ISP 1H26' },
  { v: '€18,8 mln', l: 'utile netto 2025 · cost/income 28,6% · 41 dipendenti', s: 'Bilancio 2025' },
  { v: '2 mln · €8 mld · €100 mln', l: 'clienti · attività finanziarie · utile attesi nel 2029', s: 'Piano di Impresa, 2 feb 2026' },
  { v: '4,6 / 5 · 1,8 / 5', l: 'App Store (32k voti) · Trustpilot (814 recensioni, 78% a una stella)', s: 'letti il 9 set 2026' },
];

