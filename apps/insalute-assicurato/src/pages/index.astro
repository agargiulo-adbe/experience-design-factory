---
/**
 * La copertina dell'incontro: titolo, riga del tipo (letta da
 * `EXPERIENCE_TYPES[type].coverLine`, mai a mano) e agenda cliccabile.
 * Il lockup co-brand `hero` sta qui e sulla slide-firma di `confronto`.
 * La fotografia è stock licenziato (Pexels): niente credito Firefly.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import DeckContainer from '@edf/core/blocks/immersive/DeckContainer.astro';
import Slide from '@edf/core/blocks/immersive/Slide.astro';
import CoBrand from '../components/CoBrand.astro';
import T from '@edf/core/blocks/i18n/T.astro';
import { href } from '@edf/core/utils/url.js';
import { EXPERIENCE_TYPES } from '@edf/core/data/experienceTypes';
import { SITE } from '../data/site';
import { CHAPTERS } from '../data/chapters';
import { AGENDA, TITOLO_INCONTRO } from '../data/agenda';
import fotoCopertina from '../assets/generated/div/cover.webp';

const type = EXPERIENCE_TYPES[SITE.type];
const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;
const first = CHAPTERS[0];
const last = CHAPTERS[CHAPTERS.length - 1];
---
<BaseLayout title={SITE.name}>
  <div class="fixed top-0 left-0 right-0 z-50">
    <Navigation currentPath={currentPath} base={base} />
  </div>

  <DeckContainer nextHref={href(base, '/' + first.slug)} prevHref={href(base, '/' + last.slug)}>

    <Slide id="slide-cover" bg="inverse" align="left">
      <div slot="backdrop" class="ins-cop-bg" style={`--foto: url('${fotoCopertina.src}')`}></div>

      <div class="im-cop" data-reveal>
        <div class="im-cop-sx">
          <CoBrand variant="hero" class="im-cop-lockup edf-cobrand--on-dark" data-reveal />
          <T as="p" class="im-cov-occ" it="Incontro del 24 novembre 2026" en="Meeting of 24 November 2026" data-reveal data-reveal-delay="0.06" />
          <T as="h1" class="im-cop-t" it={TITOLO_INCONTRO.t.it} en={TITOLO_INCONTRO.t.en} data-reveal data-reveal-delay="0.1" />
          <T as="p" class="im-cop-sot" it={TITOLO_INCONTRO.s.it} en={TITOLO_INCONTRO.s.en} data-reveal data-reveal-delay="0.16" />
          <T as="p" class="im-cop-tipo" it={type.coverLine.it} en={type.coverLine.en} data-reveal data-reveal-delay="0.22" />
        </div>

        <nav class="im-cop-dx" data-reveal data-reveal-delay="0.2" aria-label="Il percorso">
          <T as="p" class="im-cop-occ" it="Agenda dell’incontro" en="Meeting agenda" />
          <ol class="im-cop-indice" data-stagger>
            {AGENDA.map((v) => (
              <li>
                {v.capitolo ? (
                  <a href={`${href(base, '/' + v.capitolo)}${v.ancora ? `#${v.ancora}` : ''}`} class="im-cop-cap">
                    <span class="im-cop-n">{v.n}</span>
                    <span class="im-cop-tit"><span data-lang-it>{v.titolo.it}</span><span data-lang-en>{v.titolo.en}</span></span>
                  </a>
                ) : (
                  <span class="im-cop-cap" data-futura>
                    <span class="im-cop-n">{v.n}</span>
                    <span class="im-cop-tit"><span data-lang-it>{v.titolo.it}</span><span data-lang-en>{v.titolo.en}</span></span>
                  </span>
                )}
              </li>
            ))}
          </ol>
        </nav>
      </div>

    </Slide>

  </DeckContainer>
</BaseLayout>
