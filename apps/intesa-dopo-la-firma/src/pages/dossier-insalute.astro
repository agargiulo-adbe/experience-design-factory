---
import DocLayout from '../layouts/DocLayout.astro';
import DossierPage from '@edf/core/blocks/doc/DossierPage.astro';

// ── Pagina RISERVATA (Adobe internal) ──────────────────────────────────────
// Secondo dossier della Divisione Insurance di Intesa Sanpaolo: l'incontro con
// InSalute Servizi (il TPA sanitario del gruppo). Sta in questa app perché ne
// condivide il perimetro e la pelle; lo slug in `restricted_docs` è suo
// (`intesa-insalute`) e la FK punta all'experience `intesa-dopo-la-firma`.
// Orfana (fuori nav) + noindex. Il contenuto NON è nel bundle statico: arriva
// da Supabase dopo login oppure via secret-link ?t=<uuid> (RPC get_shared_doc).
// Seed (git-ignorato): docs/Intesa Sanpaolo/InSalute/0037_seed_intesa_insalute_dossier.sql.
---
<DocLayout
  title="Dossier — InSalute Servizi"
  description="Adobe internal — dossier riservato (accesso ristretto)."
  noindex={true}
>
  <DossierPage
    docSlug="intesa-insalute"
    title="Dossier — InSalute Servizi"
    base={import.meta.env.BASE_URL}
    supabaseUrl={import.meta.env.PUBLIC_SUPABASE_URL ?? ''}
    supabaseAnon={import.meta.env.PUBLIC_SUPABASE_ANON_KEY ?? ''}
  />
</DocLayout>
